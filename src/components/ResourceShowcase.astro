---
import { resources } from '../data/resources';
import MathGlyph from './MathGlyph.astro';
---
<section class="showcase section" id="recursos" aria-labelledby="resources-title" data-scroll-section data-section-title="Órbitas">
  <div class="section-label"><span>01 / recursos</span><span>Selecciona una órbita</span></div>
  <div class="showcase-grid" data-showcase>
    <div class="resource-detail" aria-live="polite">
      {resources.map((resource, index) => <article class:list={['detail-card', { active: index === 0 }]} data-detail={resource.id} style={`--accent:${resource.color}`}>
        <div class="detail-icon"><MathGlyph type={resource.icon} /></div>
        <p class="eyebrow">{resource.eyebrow}</p>
        <h2 id={index === 0 ? 'resources-title' : undefined}>{resource.name}</h2>
        <p class="lead">{resource.description}</p>
        <p class="detail-copy">{resource.detail}</p>
        <a class="button button--light" href={resource.href}>Descubrir <span aria-hidden="true">↗</span></a>
        <p class="placeholder">{resource.href === '#' ? 'Destino pendiente de publicar' : 'Versión temporal disponible'}</p>
      </article>)}
    </div>
    <div class="resource-selector" aria-label="Proyectos y recursos">
      <div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="orbit orbit-c"></div>
      <div class="selector-heading"><span>EL MAPA</span><strong>Todo empieza<br/>por una pregunta.</strong></div>
      <div class="resource-list">
        {resources.map((resource, index) => <button class:list={['resource-button', { active: index === 0 }]} type="button" data-resource={resource.id} style={`--accent:${resource.color}`} aria-pressed={index === 0 ? 'true' : 'false'}>
          <span class="resource-number">{resource.number}</span><span class="resource-mini-icon"><MathGlyph type={resource.icon} /></span><span class="resource-name">{resource.name}</span><span class="resource-arrow" aria-hidden="true">↗</span>
        </button>)}
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-resource]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
    let activeId = buttons[0]?.dataset.resource;
    const select = (id: string) => {
      activeId = id;
      buttons.forEach((button) => { const active = button.dataset.resource === id; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); });
      cards.forEach((card) => card.classList.toggle('active', card.dataset.detail === id));
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      const id = button.dataset.resource;
      if (!id) return;
      if (id === activeId) root.querySelector<HTMLAnchorElement>(`[data-detail="${id}"] .button`)?.click();
      else select(id);
    }));
  }
</script>

<style>
  .showcase { padding-top:clamp(1.5rem,3vw,3rem); }
  .section-label { border-bottom:1px solid var(--line); color:var(--muted); display:flex; font:500 .68rem/1 var(--mono); justify-content:space-between; letter-spacing:.12em; padding-bottom:1rem; text-transform:uppercase; }
  .showcase-grid { display:grid; gap:1.5rem; grid-template-columns:minmax(0,.94fr) minmax(360px,1.06fr); padding-top:1.5rem; }
  .resource-detail { min-height:620px; position:relative; }
  .detail-card { display:flex; flex-direction:column; height:100%; left:0; opacity:0; pointer-events:none; position:absolute; top:0; transform:translateY(14px); transition:opacity .4s ease,transform .4s ease; width:100%; }
  .detail-card.active { opacity:1; pointer-events:auto; transform:none; }
  .detail-icon { align-items:center; background:color-mix(in srgb,var(--accent) 12%,transparent); border:1px solid color-mix(in srgb,var(--accent) 60%,transparent); border-radius:50%; color:var(--accent); display:flex; height:clamp(5rem,9vw,7.2rem); justify-content:center; margin-bottom:clamp(3rem,7vw,6rem); width:clamp(5rem,9vw,7.2rem); }
  .detail-icon :global(.math-glyph) { height:54%; width:54%; }
  .eyebrow { color:var(--accent); font:500 .7rem/1 var(--mono); letter-spacing:.13em; margin:0 0 1rem; text-transform:uppercase; }
  h2 { font-size:clamp(3.2rem,6.1vw,7rem); letter-spacing:-.08em; line-height:.88; margin:0; max-width:8ch; }
  .lead { font-size:clamp(1.1rem,1.7vw,1.45rem); line-height:1.35; margin:2rem 0 .7rem; max-width:26rem; }
  .detail-copy { color:var(--muted); line-height:1.5; margin:0 0 2rem; max-width:25rem; }
  .button { align-items:center; border:1px solid currentColor; display:inline-flex; font:600 .73rem/1 var(--mono); gap:2rem; justify-content:space-between; letter-spacing:.1em; padding:1.1rem 1.25rem; text-decoration:none; text-transform:uppercase; width:max-content; }
  .button--light { background:var(--ink); color:var(--bg); }
  .placeholder { color:var(--muted); font-size:.75rem; margin-top:.7rem; }
  .resource-selector { background:#15161b; min-height:620px; overflow:hidden; padding:clamp(1.5rem,3vw,3rem); position:relative; }
  .orbit { border:1px solid; border-radius:50%; left:50%; pointer-events:none; position:absolute; top:50%; transform:translate(-50%,-50%); }
  .orbit-a { border-color:#4245f5; height:112%; width:112%; } .orbit-b { border-color:#b33bff; height:78%; width:78%; transform:translate(-50%,-50%) rotate(43deg); } .orbit-c { border-color:#2dff83; height:43%; width:43%; }
  .selector-heading { position:relative; z-index:1; } .selector-heading span { color:var(--muted); font:.68rem var(--mono); letter-spacing:.12em; } .selector-heading strong { display:block; font-size:clamp(1.7rem,2.8vw,3rem); letter-spacing:-.055em; line-height:.96; margin-top:.5rem; }
  .resource-list { display:grid; gap:.5rem; margin-top:clamp(3rem,7vw,8rem); position:relative; z-index:1; }
  .resource-button { align-items:center; background:#111217c9; border:1px solid #35363d; color:var(--ink); cursor:pointer; display:grid; font:500 .9rem/1 var(--sans); gap:.75rem; grid-template-columns:1.5rem 2.1rem 1fr auto; padding:.55rem .7rem; text-align:left; transition:background .25s,border-color .25s,transform .25s; width:100%; }
  .resource-button:hover,.resource-button.active { background:color-mix(in srgb,var(--accent) 13%,#111217); border-color:var(--accent); transform:translateX(.35rem); }
  .resource-number { color:var(--muted); font:.62rem var(--mono); }.resource-mini-icon { color:var(--accent); height:1.7rem; width:1.7rem; }.resource-name { font-weight:600; }.resource-arrow { color:var(--accent); font-size:1.1rem; opacity:0; transition:opacity .2s; }.resource-button.active .resource-arrow,.resource-button:hover .resource-arrow { opacity:1; }
  @media (max-width:760px) { .showcase-grid { display:flex; flex-direction:column; }.resource-detail { min-height:490px; }.resource-selector { min-height:auto; order:-1; }.resource-list { margin-top:3.5rem; }.detail-icon { margin-bottom:2.5rem; } .detail-card { position:absolute; } h2 { max-width:12ch; } }
  @media (prefers-reduced-motion:reduce) { .detail-card,.resource-button,.resource-arrow { transition:none; } }
</style>
