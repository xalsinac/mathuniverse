---
import { resources } from '../data/resources';
import MathGlyph from './MathGlyph.astro';
---
<div class="hero-orbit" data-orbit-system aria-label="Accesos directos a proyectos">
  <canvas class="orbit-canvas" data-orbit-canvas aria-hidden="true"></canvas>
  <div class="orbit-core" aria-hidden="true"><svg viewBox="0 0 100 100"><path d="M12 69 43 15l12 20 12-20 21 54h-13l-8-21-12 21-12-21-18 31H12Z"/></svg></div>
  <div class="orbit-items">
    {resources.slice(0, 7).map((resource, index) => <a class="orbit-item" href={resource.href} data-orbit-item data-index={index} style={`--accent:${resource.color}`} aria-label={`Abrir ${resource.name}`} title={resource.name}>
      <span class="orbit-item-icon"><MathGlyph type={resource.icon} /></span><span class="orbit-item-name">{resource.name}</span>
    </a>)}
  </div>
</div>

<div class="intro-screen" data-intro aria-hidden="true"><div class="intro-mark"><svg viewBox="0 0 100 100"><path d="M12 69 43 15l12 20 12-20 21 54h-13l-8-21-12 21-12-21-18 31H12Z"/></svg></div><p>Math <span>Universe</span></p></div>

<script>
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const system = document.querySelector<HTMLElement>('[data-orbit-system]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (intro && !reduceMotion) {
    document.documentElement.classList.add('intro-running');
    window.setTimeout(() => intro.classList.add('intro-wordmark'), 430);
    window.setTimeout(() => { intro.classList.add('intro-out'); document.documentElement.classList.remove('intro-running'); document.documentElement.classList.add('hero-ready'); }, 1150);
    window.setTimeout(() => intro.remove(), 1700);
  } else {
    intro?.remove();
    document.documentElement.classList.add('hero-ready');
  }

  if (system) {
    const canvas = system.querySelector<HTMLCanvasElement>('[data-orbit-canvas]');
    const items = [...system.querySelectorAll<HTMLElement>('[data-orbit-item]')];
    const context = canvas?.getContext('2d');
    if (canvas && context) {
      type Orbiter = { element: HTMLElement; angle: number; radius: number; ratio: number; color: string; phase: number; tilt: number; arcOffset: number };
      const orbiters: Orbiter[] = items.map((element, index) => ({
        element, angle: (Math.PI * 2 * index) / items.length - .55, radius: .30 + (index % 3) * .115, ratio: .56 + (index % 2) * .16,
        color: getComputedStyle(element).getPropertyValue('--accent').trim(), phase: index * 1.71, tilt: -.25 + (index % 3) * .14, arcOffset: index * .91,
      }));
      let width = 0, height = 0, dpr = 1, hovered: Orbiter | undefined, last = performance.now(), scrollBoost = 0, previousScrollY = window.scrollY;
      const resize = () => { const box = system.getBoundingClientRect(); width = box.width; height = box.height; dpr = Math.min(window.devicePixelRatio || 1, 2); canvas.width = width * dpr; canvas.height = height * dpr; canvas.style.width = `${width}px`; canvas.style.height = `${height}px`; context.setTransform(dpr, 0, 0, dpr, 0, 0); };
      new ResizeObserver(resize).observe(system); resize();
      const drawOrbitArc = (cx: number, cy: number, orbiter: Orbiter, base: number) => {
        const radius = base * orbiter.radius;
        const start = orbiter.arcOffset;
        const end = start + Math.PI / 3;
        const segments = 14;
        context.save();
        context.translate(cx, cy);
        context.rotate(orbiter.tilt);
        // Varios pequeños trazos permiten que el arco se desvanezca por ambos extremos.
        for (let index = 0; index < segments; index += 1) {
          const progress = (index + .5) / segments;
          const density = Math.pow(Math.sin(Math.PI * progress), 1.55);
          const segmentStart = start + (end - start) * index / segments;
          const segmentEnd = start + (end - start) * (index + 1) / segments;
          context.beginPath();
          context.ellipse(0, 0, radius, radius * orbiter.ratio, 0, segmentStart, segmentEnd);
          context.strokeStyle = orbiter.color;
          context.globalAlpha = .16 * density;
          context.lineWidth = 4;
          context.shadowBlur = 0;
          context.stroke();
          context.beginPath();
          context.ellipse(0, 0, radius, radius * orbiter.ratio, 0, segmentStart, segmentEnd);
          context.globalAlpha = .88 * density;
          context.lineWidth = 1;
          context.shadowBlur = 0;
          context.stroke();
        }
        context.restore();
      };
      const render = (now: number, delta = 0) => {
        // El ángulo disminuye porque el eje Y del lienzo crece hacia abajo: así la órbita es antihoraria en pantalla.
        const restingSpeed = hovered ? .000035 : .000115;
        scrollBoost *= Math.pow(.994, delta / 16);
        const speed = restingSpeed + scrollBoost;
        orbiters.forEach((orbiter, index) => {
          orbiter.angle -= speed * delta * (1 + (index % 3) * .055);
          orbiter.arcOffset -= speed * delta * (1.08 + (index % 2) * .05);
        });
        const cx = width / 2, cy = height / 2, base = Math.min(width, height);
        context.clearRect(0, 0, width, height);
        orbiters.forEach((orbiter) => drawOrbitArc(cx, cy, orbiter, base));
        orbiters.forEach((orbiter) => {
          const wobble = hovered && orbiter !== hovered ? Math.sin(now / 880 + orbiter.phase) * .016 : 0;
          const a = orbiter.angle + wobble;
          const r = base * orbiter.radius;
          const x = cx + Math.cos(a) * r * Math.cos(orbiter.tilt) - Math.sin(a) * r * orbiter.ratio * Math.sin(orbiter.tilt);
          const y = cy + Math.cos(a) * r * Math.sin(orbiter.tilt) + Math.sin(a) * r * orbiter.ratio * Math.cos(orbiter.tilt);
          const scale = orbiter === hovered ? 1.2 : 1 + Math.sin(now / 1700 + orbiter.phase) * .025;
          const outOfView = x < -width * .12 || x > width * 1.12 || y < -height * .14 || y > height * 1.14;
          orbiter.element.style.transform = `translate3d(${x}px,${y}px,0) translate(-50%,-50%) scale(${scale})`;
          orbiter.element.style.opacity = outOfView ? '0' : '1';
          orbiter.element.style.pointerEvents = outOfView ? 'none' : 'auto';
        });
      };
      const frame = (now: number) => {
        const delta = Math.min(now - last, 32); last = now;
        render(now, delta);
        requestAnimationFrame(frame);
      };
      const accelerateOnScroll = () => {
        const movement = window.scrollY - previousScrollY;
        if (movement > 0) scrollBoost = Math.min(.00095, scrollBoost + movement * .0000038);
        previousScrollY = window.scrollY;
      };
      items.forEach((element, index) => { element.addEventListener('pointerenter', () => { hovered = orbiters[index]; system.classList.add('is-paused'); }); element.addEventListener('pointerleave', () => { hovered = undefined; system.classList.remove('is-paused'); }); });
      window.addEventListener('scroll', accelerateOnScroll, { passive: true });
      if (reduceMotion) render(performance.now());
      else requestAnimationFrame(frame);
    }
  }
</script>

<style>
  .hero-orbit { inset:0; overflow:hidden; pointer-events:none; position:absolute; z-index:0; }.orbit-canvas { height:100%; inset:0; pointer-events:none; position:absolute; width:100%; }.orbit-core { color:#f3f2ec; filter:drop-shadow(0 0 1.5rem rgba(255,255,255,.14)); height:clamp(5rem,9vw,8rem); left:50%; position:absolute; top:51%; transform:translate(-50%,-50%); width:clamp(5rem,9vw,8rem); }.orbit-core svg,.intro-mark svg { fill:currentColor; height:100%; width:100%; }.orbit-items { inset:0; pointer-events:none; position:absolute; }.orbit-item { align-items:center; background:rgba(23,24,30,.92); border:1px solid color-mix(in srgb,var(--accent) 56%,#555 44%); border-radius:.85rem; box-shadow:0 0 1.6rem color-mix(in srgb,var(--accent) 27%,transparent); color:var(--accent); cursor:pointer; display:flex; height:clamp(2.9rem,4.5vw,4.2rem); justify-content:center; left:0; pointer-events:auto; position:absolute; text-decoration:none; top:0; transition:box-shadow .35s ease,background .35s ease; width:clamp(2.9rem,4.5vw,4.2rem); will-change:transform,opacity; }.orbit-item:hover,.orbit-item:focus-visible { background:color-mix(in srgb,var(--accent) 15%,#17181e); box-shadow:0 0 2.6rem color-mix(in srgb,var(--accent) 70%,transparent); z-index:2; }.orbit-item-icon { display:block; height:48%; width:48%; }.orbit-item :global(.math-glyph) { height:100%; width:100%; }.orbit-item-name { background:#121319; border:1px solid color-mix(in srgb,var(--accent) 40%,transparent); color:var(--ink); font:500 .62rem/1 var(--mono); left:calc(100% + .55rem); letter-spacing:.04em; opacity:0; padding:.5rem .6rem; pointer-events:none; position:absolute; text-transform:uppercase; transform:translateX(-.4rem); transition:opacity .18s,transform .18s; white-space:nowrap; }.orbit-item:hover .orbit-item-name,.orbit-item:focus-visible .orbit-item-name { opacity:1; transform:none; }.is-paused .orbit-item:not(:hover) { filter:saturate(.8); }
  .intro-screen { align-items:center; background:#101116; color:#f3f2ec; display:flex; flex-direction:column; inset:0; justify-content:center; position:fixed; transition:opacity .55s ease,visibility .55s ease; z-index:20; }.intro-screen.intro-out { opacity:0; visibility:hidden; }.intro-mark { height:clamp(4rem,9vw,7rem); transition:transform .55s cubic-bezier(.16,1,.3,1); width:clamp(4rem,9vw,7rem); }.intro-screen p { font:600 clamp(.9rem,2vw,1.35rem)/1 var(--mono); letter-spacing:.12em; margin:1.4rem 0 0; opacity:0; text-transform:uppercase; transform:translateY(.5rem); transition:opacity .4s ease,transform .4s ease; }.intro-screen p span { color:#8e909a; font-weight:400; }.intro-wordmark .intro-mark { transform:scale(.64); }.intro-wordmark p { opacity:1; transform:none; }
  @media (max-width:760px) { .orbit-core { top:43%; }.orbit-item { border-radius:.7rem; }.orbit-item-name { display:none; }.hero-orbit { opacity:.83; } }
  @media (prefers-reduced-motion:reduce) { .intro-screen { display:none; } }
</style>
