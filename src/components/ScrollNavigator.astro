<nav class="scroll-navigator" data-scroll-navigator aria-label="Progreso de lectura">
  <div class="scroll-trail" data-scroll-trail></div>
  <div class="scroll-rule" aria-hidden="true">
    <span class="rule-line"></span>
    <span class="rule-tick tick-zero">00</span>
    <span class="rule-tick tick-quarter">25</span>
    <span class="rule-tick tick-middle">50</span>
    <span class="rule-tick tick-three-quarters">75</span>
    <span class="rule-tick tick-full">100</span>
    <span class="progress-marker"><i></i><b data-scroll-progress>000%</b></span>
  </div>
</nav>

<script>
  const navigator = document.querySelector<HTMLElement>('[data-scroll-navigator]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (navigator) {
    const trail = navigator.querySelector<HTMLElement>('[data-scroll-trail]');
    const progressLabel = navigator.querySelector<HTMLElement>('[data-scroll-progress]');
    const sections = [...document.querySelectorAll<HTMLElement>('[data-scroll-section]')];
    const anchors = sections.map((section) => ({
      element: section,
      label: section.dataset.sectionTitle ?? 'Sección',
    }));

    if (trail && anchors.length) {
      trail.innerHTML = anchors.map((section, index) => {
        const letters = [...section.label].map((letter, letterIndex) =>
          `<span class="trail-letter" style="--letter:${letterIndex}">${letter === ' ' ? '&nbsp;' : letter}</span>`,
        ).join('');
        return `<button class="trail-item" type="button" data-trail-item="${index}" aria-label="Ir a ${section.label}">${letters}</button>`;
      }).join('');

      const items = [...trail.querySelectorAll<HTMLButtonElement>('[data-trail-item]')];
      let activeIndex = -1;
      let queued = false;
      let scrollingTimer = 0;
      let lastScrollY = window.scrollY;
      let scrollDirection = 1;

      const sectionPosition = (section: HTMLElement) =>
        Math.max(0, section.getBoundingClientRect().top + window.scrollY - window.innerHeight * .12);

      const lettersFor = (item: HTMLButtonElement) =>
        [...item.querySelectorAll<HTMLElement>('.trail-letter')];

      const setSidebarOrigins = (item: HTMLButtonElement) => {
        const rule = navigator.querySelector<HTMLElement>('.scroll-rule');
        if (!rule) return;
        item.classList.add('is-measuring');
        const ruleBox = rule.getBoundingClientRect();
        const sourceX = ruleBox.left + ruleBox.width * .66;
        const letters = lettersFor(item);
        const sourceStartY = ruleBox.top + ruleBox.height * .58 - ((letters.length - 1) * 7.5);
        letters.forEach((letter, index) => {
          const target = letter.getBoundingClientRect();
          letter.style.setProperty('--source-x', `${sourceX - (target.left + target.width / 2)}px`);
          letter.style.setProperty('--source-y', `${sourceStartY + index * 15 - (target.top + target.height / 2)}px`);
        });
        item.classList.remove('is-measuring');
      };

      const showStandby = (index: number) => {
        const item = items[index];
        if (!item) return;
        item.classList.remove('is-entering', 'is-reached', 'is-current');
        item.classList.add('is-standby');
        setSidebarOrigins(item);
      };

      const enterTrail = (index: number) => {
        const item = items[index];
        if (!item) return;
        item.classList.remove('is-standby');
        item.classList.add('is-entering');
        setSidebarOrigins(item);
        requestAnimationFrame(() => {
          item.classList.remove('is-entering');
          item.classList.add('is-reached');
        });
      };

      const resetTrail = (index: number) => {
        const item = items[index];
        if (!item) return;
        setSidebarOrigins(item);
        item.classList.remove('is-current', 'is-reached', 'is-entering');
        item.classList.add('is-standby');
      };

      const syncTrail = (nextActive: number, initial = false) => {
        if (initial) {
          items.forEach((item, index) => item.classList.toggle('is-reached', index <= nextActive));
        } else if (nextActive > activeIndex) {
          for (let index = activeIndex + 1; index <= nextActive; index += 1) enterTrail(index);
        } else {
          for (let index = activeIndex; index > nextActive; index -= 1) resetTrail(index);
        }

        items.forEach((item, index) => {
          if (index > nextActive + 1) item.classList.remove('is-current', 'is-reached', 'is-entering', 'is-standby');
          item.classList.toggle('is-current', index === nextActive);
          item.setAttribute('aria-current', index === nextActive ? 'location' : 'false');
        });
        showStandby(nextActive + 1);
      };

      const update = () => {
        queued = false;
        const documentHeight = document.documentElement.scrollHeight - window.innerHeight;
        const percentage = documentHeight > 0 ? Math.round((window.scrollY / documentHeight) * 100) : 0;
        navigator.style.setProperty('--scroll-progress', String(percentage));
        if (progressLabel) progressLabel.textContent = `${String(percentage).padStart(3, '0')}%`;

        const readingLine = window.scrollY + window.innerHeight * .44;
        let nextActive = 0;
        anchors.forEach((section, index) => {
          if (section.element.getBoundingClientRect().top + window.scrollY <= readingLine) nextActive = index;
        });

        if (nextActive !== activeIndex) {
          syncTrail(nextActive, activeIndex === -1);
          activeIndex = nextActive;
        }
      };

      const snapAfterScroll = () => {
        if (reduceMotion) return;
        const positions = anchors.map(({ element }) => sectionPosition(element));
        const current = window.scrollY;
        const closest = positions.reduce((best, position) =>
          Math.abs(position - current) < Math.abs(best - current) ? position : best,
        positions[0]);
        // Solo completa una transición que ya está cerca de resolverse; no secuestra un scroll normal.
        if (Math.abs(closest - current) < window.innerHeight * .22) {
          const target = scrollDirection >= 0 ? Math.max(closest, current) : Math.min(closest, current);
          if (Math.abs(target - current) > 3) window.scrollTo({ top: target, behavior: 'smooth' });
        }
      };

      const onScroll = () => {
        const currentScrollY = window.scrollY;
        scrollDirection = currentScrollY >= lastScrollY ? 1 : -1;
        lastScrollY = currentScrollY;
        if (!queued) { queued = true; requestAnimationFrame(update); }
        window.clearTimeout(scrollingTimer);
        scrollingTimer = window.setTimeout(snapAfterScroll, 150);
      };

      items.forEach((item, index) => item.addEventListener('click', () => {
        window.scrollTo({ top: sectionPosition(anchors[index].element), behavior: reduceMotion ? 'auto' : 'smooth' });
      }));
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { update(); showStandby(activeIndex + 1); }, { passive: true });
      update();
    }
  }
</script>

<style is:global>
  .scroll-navigator { --scroll-progress:0; bottom:0; display:block; pointer-events:none; position:fixed; right:0; top:0; z-index:12; }
  .scroll-rule { bottom:8vh; position:absolute; right:0; top:8vh; width:clamp(5.5rem,8vw,7.75rem); }
  .rule-line { background:linear-gradient(#4b4d58aa,#4b4d5822); bottom:0; position:absolute; right:1.7rem; top:0; width:1px; }
  .rule-tick { color:#777985; font:.62rem/1 var(--mono); letter-spacing:.04em; position:absolute; right:2.25rem; transform:translateY(-50%); }
  .rule-tick::after { background:#aeb0b8; content:""; height:1px; left:calc(100% + .55rem); position:absolute; top:50%; width:1.25rem; }
  .tick-zero { top:0; }.tick-quarter { top:25%; }.tick-middle { top:50%; }.tick-three-quarters { top:75%; }.tick-full { bottom:0; transform:translateY(50%); }
  .progress-marker { align-items:center; display:flex; gap:.55rem; position:absolute; right:0; top:calc(var(--scroll-progress) * 1%); transform:translateY(-50%); transition:top .15s linear; }
  .progress-marker i { background:linear-gradient(90deg,transparent,#4c94ff 22%,#83c0ff); box-shadow:0 0 .8rem #2d7cff; display:block; height:2px; width:clamp(4rem,7vw,6.5rem); }
  .progress-marker b { color:#82b4ff; font:500 .67rem/1 var(--mono); letter-spacing:.08em; min-width:3rem; }
  .scroll-trail { align-items:flex-end; display:flex; flex-direction:column; gap:.28rem; max-height:58vh; overflow:visible; pointer-events:auto; position:absolute; right:clamp(4.2rem,5.8vw,5.4rem); top:21vh; }
  .trail-item { background:none; border:0; color:#666872; cursor:pointer; display:flex; font:600 clamp(.64rem,1vw,.82rem)/1 var(--mono); justify-content:flex-end; letter-spacing:.12em; max-height:0; opacity:0; overflow:visible; padding:0; pointer-events:none; text-transform:uppercase; transition:max-height .18s ease,opacity .18s ease,color .25s ease; white-space:nowrap; }
  .trail-item.is-reached,.trail-item.is-entering { max-height:1.35rem; opacity:.68; padding:.12rem 0; pointer-events:auto; }
  .trail-item.is-current { color:#f3f2ec; opacity:1; }
  .trail-item.is-standby { opacity:1; pointer-events:none; }
  .trail-letter { --source-x:0px; --source-y:0px; display:inline-block; opacity:0; transform:translate(var(--source-x),var(--source-y)) rotate(90deg); transform-origin:center; transition:transform .72s cubic-bezier(.16,1,.3,1),opacity .22s ease; transition-delay:calc(var(--letter) * 38ms); }
  .trail-item.is-standby .trail-letter,.trail-item.is-entering .trail-letter { color:#585a62; opacity:.82; }
  .trail-item.is-reached .trail-letter { opacity:1; transform:none; }
  .trail-item.is-measuring .trail-letter { opacity:0!important; transform:none!important; transition:none!important; }
  .trail-item:hover,.trail-item:focus-visible { color:#b6ff5c; opacity:1; outline:none; }
  @media (max-width:900px) { .scroll-navigator { display:none; } }
  @media (prefers-reduced-motion:reduce) { .progress-marker,.trail-item,.trail-letter { transition:none; } }
</style>
