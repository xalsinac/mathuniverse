---
// Graficador interactivo 2D de funciones f(x) y g(x) con detección de raíces, extremos, intersecciones y tabla de valores.
---

<div class="grapher-workbench" data-grapher-root>
  <!-- Columna Izquierda: Controles de funciones + Lienzo Cartesiano Interactivo -->
  <div class="grapher-main">
    <div class="grapher-controls">
      <div class="fn-inputs-row">
        <div class="fn-box fn-f">
          <span class="fn-badge">f(x) =</span>
          <input
            type="text"
            value="x^2 - 4x + 3"
            data-fn-f
            placeholder="Ej. x^2 - 4x + 3"
            aria-label="Función principal f(x)"
            spellcheck="false"
          />
        </div>

        <div class="fn-box fn-g">
          <span class="fn-badge">g(x) =</span>
          <input
            type="text"
            value="x - 1"
            data-fn-g
            placeholder="Opcional: ej. x - 1 (deja vacío para ocultar)"
            aria-label=" Segunda función g(x)"
            spellcheck="false"
          />
          <button
            type="button"
            class="fn-clear-btn"
            data-clear-g
            title="Ocultar segunda función g(x)"
          >
            ✕
          </button>
        </div>
      </div>

      <div class="grapher-presets-bar">
        <div class="preset-group">
          <span>Ejemplos:</span>
          <button type="button" data-graph-preset="x^2 - 4x + 3|x - 1">Parábola y recta</button>
          <button type="button" data-graph-preset="x^3 - 3x|">Cúbica (extremos)</button>
          <button type="button" data-graph-preset="(2x + 1)/(x - 1)|2">Racional (asíntota)</button>
          <button type="button" data-graph-preset="2*sin(x)|cos(x)">Trigonométricas</button>
          <button type="button" data-graph-preset="e^x|ln(x)">eˣ y ln(x)</button>
        </div>

        <div class="zoom-controls">
          <button type="button" data-zoom="in" title="Acercar (+)">＋</button>
          <button type="button" data-zoom="out" title="Alejar (−)">−</button>
          <button type="button" data-zoom="reset" title="Centrar en el origen (0,0)">⌂ Origen</button>
        </div>
      </div>
    </div>

    <!-- Lienzo Cartesiano -->
    <div class="canvas-stage" data-graph-stage>
      <canvas class="graph-canvas" data-graph-canvas></canvas>
      <div class="graph-hud-coords" data-graph-coords>
        Pasa el cursor por el plano para inspeccionar (x, y) · Arrastra para mover · Rueda para zoom
      </div>
      <div class="graph-legend">
        <span class="leg-item leg-root">● Raíces f(x)=0</span>
        <span class="leg-item leg-ext">◆ Máx / Mín</span>
        <span class="leg-item leg-int">◎ Intersección f(x)=g(x)</span>
      </div>
    </div>
  </div>

  <!-- Columna Derecha: Análisis Automático de Puntos Notables + Tabla de Valores -->
  <aside class="grapher-sidebar" aria-label="Análisis de la función y tabla de valores">
    <div class="analysis-block">
      <span class="side-eyebrow">ANÁLISIS EN EL INTERVALO VISIBLE</span>
      <h3 class="side-title">Puntos notables</h3>
      <div class="analysis-list" data-graph-analysis></div>
    </div>

    <div class="table-block">
      <div class="table-head">
        <div>
          <span class="side-eyebrow">EVALUACIÓN NUMÉRICA</span>
          <h3 class="side-title">Tabla de valores</h3>
        </div>
        <div class="eval-custom">
          <label for="graph-custom-x">x =</label>
          <input id="graph-custom-x" type="number" value="2" step="0.5" data-custom-x />
        </div>
      </div>
      <div class="custom-eval-res" data-custom-eval-res></div>
      <div class="values-table-wrap" data-values-table></div>
    </div>
  </aside>
</div>

<script>
  import { compileMathFunction } from '../lib/mathEngine';

  const root = document.querySelector<HTMLElement>('[data-grapher-root]');
  if (root) {
    const inputF = root.querySelector<HTMLInputElement>('[data-fn-f]');
    const inputG = root.querySelector<HTMLInputElement>('[data-fn-g]');
    const clearGBtn = root.querySelector<HTMLButtonElement>('[data-clear-g]');
    const stageEl = root.querySelector<HTMLElement>('[data-graph-stage]');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-graph-canvas]');
    const coordsEl = root.querySelector<HTMLElement>('[data-graph-coords]');
    const analysisEl = root.querySelector<HTMLElement>('[data-graph-analysis]');
    const customXInput = root.querySelector<HTMLInputElement>('[data-custom-x]');
    const customEvalEl = root.querySelector<HTMLElement>('[data-custom-eval-res]');
    const tableWrapEl = root.querySelector<HTMLElement>('[data-values-table]');
    const ctx = canvas?.getContext('2d');

    if (canvas && ctx && stageEl) {
      // Vista del plano cartesiano: centro (centerX, centerY) y escala (scale = píxeles por unidad)
      let width = 640;
      let height = 440;
      let centerX = 0;
      let centerY = 0;
      let scale = 42; // px por unidad matemática

      let fnF: ((x: number) => number) | null = null;
      let fnG: ((x: number) => number) | null = null;

      let pointerX: number | null = null;
      let isDragging = false;
      let dragStartX = 0;
      let dragStartY = 0;
      let dragOriginX = 0;
      let dragOriginY = 0;

      const fmt = (n: number): string => {
        if (!Number.isFinite(n)) return 'Indef.';
        if (Math.abs(n) < 1e-10) return '0';
        return Number(n.toFixed(3)).toString();
      };

      const toScreenX = (x: number) => width / 2 + (x - centerX) * scale;
      const toScreenY = (y: number) => height / 2 - (y - centerY) * scale;
      const toMathX = (px: number) => centerX + (px - width / 2) / scale;
      const toMathY = (py: number) => centerY - (py - height / 2) / scale;

      const compileFunctions = () => {
        const rawF = inputF?.value.trim() || '';
        const rawG = inputG?.value.trim() || '';
        const resF = rawF ? compileMathFunction(rawF, 'RAD') : { ok: false, fn: () => NaN };
        const resG = rawG ? compileMathFunction(rawG, 'RAD') : { ok: false, fn: () => NaN };
        fnF = resF.ok ? resF.fn : null;
        fnG = resG.ok ? resG.fn : null;
      };

      interface NotablePoint {
        kind: 'y-int' | 'root' | 'max' | 'min' | 'intersect';
        label: string;
        x: number;
        y: number;
        color: string;
      }

      // Encuentra raíces, corte con eje Y, extremos locales e intersecciones f(x)=g(x) en el rango visible
      const findNotablePoints = (xMin: number, xMax: number): NotablePoint[] => {
        const pts: NotablePoint[] = [];
        if (!fnF) return pts;

        // 1. Corte con el eje Y (x = 0)
        if (xMin <= 0 && xMax >= 0) {
          const y0 = fnF(0);
          if (Number.isFinite(y0)) {
            pts.push({
              kind: 'y-int',
              label: 'Corte eje Y',
              x: 0,
              y: y0,
              color: '#a78bfa',
            });
          }
        }

        const samples = 320;
        const dx = (xMax - xMin) / samples;

        // Bisección rápida para afinar ceros
        const refineZero = (f: (x: number) => number, a: number, b: number): number | null => {
          let lo = a;
          let hi = b;
          let flo = f(lo);
          let fhi = f(hi);
          if (!Number.isFinite(flo) || !Number.isFinite(fhi)) return null;
          for (let iter = 0; iter < 26; iter++) {
            const mid = 0.5 * (lo + hi);
            const fmid = f(mid);
            if (!Number.isFinite(fmid)) return null;
            if (Math.abs(fmid) < 1e-11) return mid;
            if (flo * fmid <= 0) {
              hi = mid;
              fhi = fmid;
            } else {
              lo = mid;
              flo = fmid;
            }
          }
          const finalMid = 0.5 * (lo + hi);
          // Descartar asíntotas verticales donde |f(x)| crece en vez de acercarse a 0
          return Math.abs(f(finalMid)) < 0.05 ? finalMid : null;
        };

        let prevX = xMin;
        let prevY = fnF(prevX);
        let prevSlope = NaN;

        for (let i = 1; i <= samples; i++) {
          const currX = xMin + i * dx;
          const currY = fnF(currX);

          // 2. Raíces f(x) = 0
          if (Number.isFinite(prevY) && Number.isFinite(currY)) {
            if (Math.abs(currY) < 1e-9) {
              pts.push({ kind: 'root', label: 'Raíz f(x)=0', x: currX, y: 0, color: '#38c8ff' });
            } else if (prevY * currY < 0 && Math.abs(currY - prevY) < (xMax - xMin) * 15) {
              const rx = refineZero(fnF, prevX, currX);
              if (rx !== null) {
                pts.push({ kind: 'root', label: 'Raíz f(x)=0', x: rx, y: 0, color: '#38c8ff' });
              }
            }

            // 3. Extremos relativos (cambio de signo en la derivada numérica)
            const slope = (currY - prevY) / dx;
            if (Number.isFinite(prevSlope) && Number.isFinite(slope)) {
              if (prevSlope > 1e-5 && slope < -1e-5 && Math.abs(slope - prevSlope) < 50) {
                const ex = prevX;
                const ey = fnF(ex);
                pts.push({ kind: 'max', label: 'Máximo local', x: ex, y: ey, color: '#ffc14d' });
              } else if (prevSlope < -1e-5 && slope > 1e-5 && Math.abs(slope - prevSlope) < 50) {
                const ex = prevX;
                const ey = fnF(ex);
                pts.push({ kind: 'min', label: 'Mínimo local', x: ex, y: ey, color: '#ffc14d' });
              }
            }
            prevSlope = slope;
          } else {
            prevSlope = NaN;
          }

          // 4. Intersecciones f(x) = g(x)
          if (fnG) {
            const diffPrev = prevY - fnG(prevX);
            const diffCurr = currY - fnG(currX);
            if (
              Number.isFinite(diffPrev) &&
              Number.isFinite(diffCurr) &&
              diffPrev * diffCurr <= 0 &&
              Math.abs(diffCurr - diffPrev) < (xMax - xMin) * 15
            ) {
              const ix = refineZero((x) => fnF!(x) - fnG!(x), prevX, currX);
              if (ix !== null) {
                const iy = fnF(ix);
                if (Number.isFinite(iy)) {
                  pts.push({
                    kind: 'intersect',
                    label: 'Intersección f=g',
                    x: ix,
                    y: iy,
                    color: '#3fe0b5',
                  });
                }
              }
            }
          }

          prevX = currX;
          prevY = currY;
        }

        // Deduplicar puntos muy cercanos
        const unique: NotablePoint[] = [];
        for (const p of pts) {
          if (!unique.some((u) => u.kind === p.kind && Math.abs(u.x - p.x) < (xMax - xMin) * 0.015)) {
            unique.push(p);
          }
        }
        return unique.slice(0, 14);
      };

      const getNiceStep = (pxPerUnit: number): number => {
        const targetPx = 65;
        const rawStep = targetPx / pxPerUnit;
        const mag = Math.pow(10, Math.floor(Math.log10(rawStep)));
        const residual = rawStep / mag;
        if (residual > 5) return 10 * mag;
        if (residual > 2) return 5 * mag;
        if (residual > 1) return 2 * mag;
        return mag;
      };

      const renderGraph = () => {
        ctx.clearRect(0, 0, width, height);
        const isLight = document.documentElement.dataset.theme === 'light';

        const bgCol = isLight ? '#e8e5dd' : '#0b0c10';
        const gridCol = isLight ? 'rgba(20, 21, 26, 0.08)' : 'rgba(255, 255, 255, 0.06)';
        const axisCol = isLight ? 'rgba(20, 21, 26, 0.45)' : 'rgba(255, 255, 255, 0.35)';
        const textCol = isLight ? '#4f5362' : '#8e919e';

        ctx.fillStyle = bgCol;
        ctx.fillRect(0, 0, width, height);

        const xMin = toMathX(0);
        const xMax = toMathX(width);
        const yMin = toMathY(height);
        const yMax = toMathY(0);
        const step = getNiceStep(scale);

        // 1. Cuadrícula cartesiana
        ctx.strokeStyle = gridCol;
        ctx.lineWidth = 1;
        ctx.font = '500 10px "Geist Mono", monospace';
        ctx.fillStyle = textCol;

        const firstX = Math.ceil(xMin / step) * step;
        for (let x = firstX; x <= xMax; x += step) {
          const sx = toScreenX(x);
          ctx.beginPath();
          ctx.moveTo(sx, 0);
          ctx.lineTo(sx, height);
          ctx.stroke();

          if (Math.abs(x) > step * 0.1) {
            const axisY = Math.min(height - 16, Math.max(14, toScreenY(0) + 14));
            ctx.fillText(fmt(x), sx - 8, axisY);
          }
        }

        const firstY = Math.ceil(yMin / step) * step;
        for (let y = firstY; y <= yMax; y += step) {
          const sy = toScreenY(y);
          ctx.beginPath();
          ctx.moveTo(0, sy);
          ctx.lineTo(width, sy);
          ctx.stroke();

          if (Math.abs(y) > step * 0.1) {
            const axisX = Math.min(width - 36, Math.max(6, toScreenX(0) + 6));
            ctx.fillText(fmt(y), axisX, sy + 3);
          }
        }

        // 2. Ejes principales X = 0, Y = 0
        ctx.strokeStyle = axisCol;
        ctx.lineWidth = 1.5;
        const zeroX = toScreenX(0);
        const zeroY = toScreenY(0);

        ctx.beginPath();
        ctx.moveTo(0, zeroY);
        ctx.lineTo(width, zeroY);
        ctx.moveTo(zeroX, 0);
        ctx.lineTo(zeroX, height);
        ctx.stroke();

        // 3. Trazar curvas f(x) y g(x) con corte automático en asíntotas verticales
        const plotCurve = (fn: (x: number) => number, color: string) => {
          ctx.strokeStyle = color;
          ctx.lineWidth = 2.4;
          ctx.beginPath();
          let penDown = false;
          let prevSy = 0;

          for (let px = 0; px <= width; px += 1.5) {
            const x = toMathX(px);
            const y = fn(x);
            if (!Number.isFinite(y)) {
              penDown = false;
              continue;
            }
            const sy = toScreenY(y);
            // Evitar unir saltos bruscos de asíntota vertical
            if (penDown && Math.abs(sy - prevSy) > height * 1.4) {
              penDown = false;
            }
            if (!penDown) {
              ctx.moveTo(px, sy);
              penDown = true;
            } else {
              ctx.lineTo(px, sy);
            }
            prevSy = sy;
          }
          ctx.stroke();
        };

        if (fnG) plotCurve(fnG, '#ff8a5b');
        if (fnF) plotCurve(fnF, '#4d94ff');

        // 4. Puntos notables y panel lateral
        const notables = findNotablePoints(xMin, xMax);
        for (const pt of notables) {
          const sx = toScreenX(pt.x);
          const sy = toScreenY(pt.y);
          if (sx < -10 || sx > width + 10 || sy < -10 || sy > height + 10) continue;
          ctx.fillStyle = pt.color;
          ctx.beginPath();
          ctx.arc(sx, sy, 4.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = bgCol;
          ctx.lineWidth = 1.5;
          ctx.stroke();
        }

        // 5. Mira magnética bajo el cursor
        if (pointerX !== null && fnF) {
          const mx = toMathX(pointerX);
          const yf = fnF(mx);
          ctx.strokeStyle = isLight ? 'rgba(20,21,26,0.22)' : 'rgba(255,255,255,0.22)';
          ctx.lineWidth = 1;
          ctx.setLineDash([4, 4]);
          ctx.beginPath();
          ctx.moveTo(pointerX, 0);
          ctx.lineTo(pointerX, height);
          ctx.stroke();
          ctx.setLineDash([]);

          if (Number.isFinite(yf)) {
            const sy = toScreenY(yf);
            ctx.fillStyle = '#4d94ff';
            ctx.beginPath();
            ctx.arc(pointerX, sy, 5, 0, Math.PI * 2);
            ctx.fill();
          }

          if (coordsEl) {
            const yg = fnG ? fnG(mx) : NaN;
            const gText = fnG && Number.isFinite(yg) ? ` · g(${fmt(mx)}) = ${fmt(yg)}` : '';
            coordsEl.innerHTML = `Cursor: <strong>x = ${fmt(mx)}</strong> · <strong>f(${fmt(mx)}) = ${fmt(yf)}</strong>${gText}`;
          }
        }

        if (analysisEl) {
          if (!notables.length) {
            analysisEl.innerHTML =
              '<p class="empty-note">No se detectan raíces ni extremos en este tramo visible.</p>';
          } else {
            analysisEl.innerHTML = notables
              .map(
                (p) => `
                <div class="notable-row">
                  <span class="notable-tag" style="--pt-col:${p.color}">${p.label}</span>
                  <strong class="notable-coord">(${fmt(p.x)} , ${fmt(p.y)})</strong>
                </div>
              `,
              )
              .join('');
          }
        }
      };

      const renderTable = () => {
        if (!tableWrapEl || !customEvalEl) return;
        const cx = parseFloat(customXInput?.value || '0') || 0;
        const fy = fnF ? fnF(cx) : NaN;
        const gy = fnG ? fnG(cx) : NaN;
        customEvalEl.innerHTML = `
          <span>f(${fmt(cx)}) = <strong>${fmt(fy)}</strong></span>
          ${fnG ? `<span>g(${fmt(cx)}) = <strong>${fmt(gy)}</strong></span>` : ''}
        `;

        const xs = [-3, -2, -1, 0, 1, 2, 3, 4];
        tableWrapEl.innerHTML = `
          <table class="val-table">
            <thead>
              <tr>
                <th>x</th>
                <th>f(x)</th>
                ${fnG ? '<th>g(x)</th>' : ''}
              </tr>
            </thead>
            <tbody>
              ${xs
                .map(
                  (x) => `
                  <tr>
                    <td>${x}</td>
                    <td>${fnF ? fmt(fnF(x)) : '—'}</td>
                    ${fnG ? `<td>${fmt(fnG(x))}</td>` : ''}
                  </tr>
                `,
                )
                .join('')}
            </tbody>
          </table>
        `;
      };

      const updateAll = () => {
        compileFunctions();
        renderGraph();
        renderTable();
      };

      const resizeCanvas = () => {
        const rect = stageEl.getBoundingClientRect();
        if (rect.width < 50) return;
        width = rect.width;
        height = Math.max(380, Math.min(500, rect.width * 0.65));
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        renderGraph();
      };

      new ResizeObserver(resizeCanvas).observe(stageEl);

      // Interacción de arrastrar (Pan) y rueda (Zoom)
      canvas.addEventListener('pointerdown', (ev) => {
        isDragging = true;
        dragStartX = ev.clientX;
        dragStartY = ev.clientY;
        dragOriginX = centerX;
        dragOriginY = centerY;
        canvas.setPointerCapture(ev.pointerId);
      });

      canvas.addEventListener('pointermove', (ev) => {
        const rect = canvas.getBoundingClientRect();
        pointerX = ev.clientX - rect.left;
        if (isDragging) {
          const dx = ev.clientX - dragStartX;
          const dy = ev.clientY - dragStartY;
          centerX = dragOriginX - dx / scale;
          centerY = dragOriginY + dy / scale;
        }
        renderGraph();
      });

      canvas.addEventListener('pointerup', () => {
        isDragging = false;
      });

      canvas.addEventListener('pointerleave', () => {
        isDragging = false;
        pointerX = null;
        renderGraph();
      });

      canvas.addEventListener(
        'wheel',
        (ev) => {
          ev.preventDefault();
          const factor = ev.deltaY < 0 ? 1.15 : 1 / 1.15;
          scale = Math.max(6, Math.min(350, scale * factor));
          renderGraph();
        },
        { passive: false },
      );

      root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const z = btn.dataset.zoom;
          if (z === 'in') scale = Math.min(350, scale * 1.28);
          else if (z === 'out') scale = Math.max(6, scale / 1.28);
          else {
            centerX = 0;
            centerY = 0;
            scale = 42;
          }
          renderGraph();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('[data-graph-preset]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const [fStr, gStr] = (btn.dataset.graphPreset || '').split('|');
          if (inputF) inputF.value = fStr || '';
          if (inputG) inputG.value = gStr || '';
          centerX = 0;
          centerY = 0;
          scale = 42;
          updateAll();
        });
      });

      clearGBtn?.addEventListener('click', () => {
        if (inputG) {
          inputG.value = '';
          updateAll();
        }
      });

      inputF?.addEventListener('input', updateAll);
      inputG?.addEventListener('input', updateAll);
      customXInput?.addEventListener('input', renderTable);
      window.addEventListener('themechange', renderGraph);

      updateAll();
    }
  }
</script>

<style>
  .grapher-workbench {
    align-items: start;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.75fr);
  }

  .grapher-main {
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    display: flex;
    flex-direction: column;
  }

  .grapher-controls {
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
  }

  .fn-inputs-row {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .fn-box {
    align-items: center;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    display: flex;
    gap: 0.6rem;
    padding: 0.6rem 0.85rem;
  }

  .fn-box.fn-f {
    border-left: 3px solid #4d94ff;
  }

  .fn-box.fn-g {
    border-left: 3px solid #ff8a5b;
  }

  .fn-badge {
    font: 700 0.85rem/1 var(--mono);
    white-space: nowrap;
  }

  .fn-f .fn-badge {
    color: #4d94ff;
  }

  .fn-g .fn-badge {
    color: #ff8a5b;
  }

  .fn-box input {
    background: transparent;
    border: 0;
    color: var(--ink-strong);
    flex: 1;
    font: 600 0.95rem/1.2 var(--mono);
    outline: none;
    width: 100%;
  }

  .fn-clear-btn {
    background: transparent;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.8rem;
    padding: 0.2rem 0.4rem;
  }

  .fn-clear-btn:hover {
    color: #f87171;
  }

  .grapher-presets-bar {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
  }

  .preset-group {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font: 500 0.64rem/1 var(--mono);
    gap: 0.35rem;
  }

  .preset-group span {
