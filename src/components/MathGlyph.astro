---
const { type = 'lab' } = Astro.props;
---
<span class={`math-glyph math-glyph--${type}`} aria-hidden="true">
  {type === 'lab' && <svg viewBox="0 0 80 80"><path d="M30 10h20M36 10v22L17 64a5 5 0 0 0 4 7h38a5 5 0 0 0 4-7L44 32V10"/><path d="M25 52h30"/></svg>}
  {type === 'dojo' && <svg viewBox="0 0 80 80"><circle cx="40" cy="40" r="27"/><path d="M40 14v52M14 40h52M21 21l38 38M59 21 21 59"/></svg>}
  {type === 'junior' && <svg viewBox="0 0 80 80"><path d="M40 11c8 15 18 20 29 23-7 9-9 19-7 32-13-2-20 1-22 5-2-4-9-7-22-5 2-13 0-23-7-32 11-3 21-8 29-23Z"/><circle cx="30" cy="41" r="3"/><circle cx="50" cy="41" r="3"/><path d="M31 53c6 4 12 4 18 0"/></svg>}
  {type === 'games' && <svg viewBox="0 0 80 80"><path d="M18 35h44a8 8 0 0 1 8 8v12a8 8 0 0 1-8 8H18a8 8 0 0 1-8-8V43a8 8 0 0 1 8-8Z"/><path d="M23 49h14M30 42v14"/><circle cx="56" cy="47" r="2"/><circle cx="62" cy="54" r="2"/></svg>}
  {type === 'lessons' && <svg viewBox="0 0 80 80"><path d="M19 13h42v54H19z"/><path d="M30 29h20M30 40h20M30 51h12"/></svg>}
  {type === 'exams' && <svg viewBox="0 0 80 80"><path d="M22 10h28l11 11v49H22z"/><path d="M50 10v12h11M31 36l5 5 12-13M31 54h20"/></svg>}
  {type === 'practice' && <svg viewBox="0 0 80 80"><path d="m20 17 20-8 20 8v46L40 71 20 63z"/><path d="M40 9v62M20 17l20 9 20-9"/></svg>}
  {type === 'advanced' && <svg viewBox="0 0 80 80"><path d="M13 58 32 19l13 29 10-18 12 28"/><circle cx="32" cy="19" r="4"/><circle cx="55" cy="30" r="4"/></svg>}
  {type === 'proofs' && <svg viewBox="0 0 80 80"><path d="M15 62 40 14l25 48Z"/><path d="M25 43h30M40 14v48"/></svg>}
</span>

<style>
  .math-glyph { align-items:center; display:inline-flex; justify-content:center; }
  svg { fill:none; height:100%; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; stroke-width:4; width:100%; }
</style>
