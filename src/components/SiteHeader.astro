---
import LogoMark from './LogoMark.astro';
import CommandPalette from './CommandPalette.astro';

interface Props {
  activePage?: 'home' | 'selectividad' | 'herramientas' | 'gym' | 'craft';
  statusText?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  activePage = 'home',
  statusText = 'En construcción',
  ctaHref = '/#recursos',
  ctaLabel = 'Explorar Apps',
} = Astro.props;

const isHome = activePage === 'home';
---

<header class="topbar-shell">
  <div class="topbar">
    <div class="topbar-left">
      <div class="topbar-brand">
        <LogoMark />
      </div>
      <nav class="topbar-nav" aria-label="Navegación principal">
        <a href={isHome ? '#inicio' : '/'} class:list={{ 'is-active': isHome }}>
          <span>{isHome ? 'Inicio' : '← Inicio'}</span>
        </a>
        <a href={isHome ? '#recursos' : '/#recursos'}>
          <span>Recursos</span>
        </a>
        <a href={isHome ? '#universo' : '/#universo'}>
          <span>El proyecto</span>
        </a>
        <a href={isHome ? '#principios' : '/#principios'}>
          <span>Principios</span>
        </a>
      </nav>
    </div>

    <div class="topbar-right">
      <!-- Slot opcional para widgets específicos de página (ej. el cronómetro compacto en Selectividad) -->
      <slot name="right-extra" />

      {
        statusText && (
          <span class="topbar-cell status">
            <i></i>
            <span>{statusText}</span>
          </span>
        )
      }

      <!-- Botón Buscador Global (Command Palette · ⌘K / Ctrl+K) -->
      <button
        type="button"
        class="topbar-cell cmd-trigger"
        data-cmd-open
        aria-label="Abrir buscador rápido (⌘K o Ctrl+K)"
        title="Buscar aplicación, herramienta o examen (⌘K / Ctrl+K)"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="cmd-trigger-text">Buscar</span>
        <kbd class="cmd-kbd" data-cmd-kbd>⌘K</kbd>
      </button>

      <!-- Conmutador de Tema (Oscuro / Claro) -->
      <button
        type="button"
        class="topbar-cell theme-toggle"
        data-theme-toggle
        aria-label="Cambiar entre modo oscuro y modo claro"
        title="Cambiar tema (Oscuro / Claro)"
      >
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
        </svg>
        <span class="theme-toggle-text" data-theme-label>Tema</span>
      </button>

      <!-- Botón Menú Móvil (Hamburguesa / Cerrar) para pantallas táctiles -->
      <button
        type="button"
        class="topbar-cell mobile-menu-btn"
        data-mobile-menu-toggle
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg
          class="icon-menu"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg
          class="icon-close"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      {
        ctaLabel && (
          <a href={ctaHref} class="topbar-cta">
            {ctaLabel}
          </a>
        )
      }
    </div>
  </div>

  <!-- Desplegable de Navegación Móvil -->
  <div id="mobile-nav-drawer" class="mobile-drawer" data-mobile-drawer hidden>
    <nav class="mobile-drawer-nav" aria-label="Navegación móvil">
      <a href={isHome ? '#inicio' : '/'} class:list={{ 'is-active': isHome }}>
        <span>{isHome ? 'Inicio' : '← Ir al Inicio'}</span>
      </a>
      <a href={isHome ? '#recursos' : '/#recursos'}>
        <span>Recursos & Apps</span>
      </a>
      <a href={isHome ? '#universo' : '/#universo'}>
        <span>El proyecto</span>
      </a>
      <a href={isHome ? '#principios' : '/#principios'}>
        <span>Principios</span>
      </a>

      <div class="mobile-drawer-divider" aria-hidden="true"></div>

      <div class="mobile-drawer-direct">
        <a href="/craft" class="mobile-drawer-chip">
          <span class="chip-dot" style="background:#38c8ff;"></span>
          <span>08 · Math Craft</span>
        </a>
        <a href="/gym" class="mobile-drawer-chip">
          <span class="chip-dot" style="background:#ff9838;"></span>
          <span>04 · Math Gym</span>
        </a>
        <a href="/selectividad" class="mobile-drawer-chip">
          <span class="chip-dot" style="background:#b48cff;"></span>
          <span>Selectividad PAU</span>
        </a>
        <a href="/herramientas" class="mobile-drawer-chip">
          <span class="chip-dot" style="background:#3fe0b5;"></span>
          <span>Calculadora & Apps</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<CommandPalette />

<script>
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const labelEl = document.querySelector<HTMLElement>('[data-theme-label]');

  const syncToggleUI = (theme: string) => {
    if (labelEl) {
      labelEl.textContent = theme === 'light' ? 'Claro' : 'Oscuro';
    }
    toggleBtn?.setAttribute(
      'aria-label',
      theme === 'light' ? 'Cambiar a modo oscuro' : 'Cambiar a modo claro',
    );
  };

  const updateCrossLinks = (theme: string) => {
    try {
      document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        const href = a.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('javascript:') || href.startsWith('mailto:')) return;
        try {
          const url = new URL(href, window.location.href);
          if (url.origin === window.location.origin || url.hostname.includes('vercel.app')) {
            url.searchParams.set('theme', theme);
            if (url.origin === window.location.origin && !href.startsWith('http')) {
              const relativePath = href.split('?')[0].split('#')[0];
              const hash = href.includes('#') ? '#' + href.split('#')[1] : '';
              a.setAttribute('href', `${relativePath}?theme=${theme}${hash}`);
            } else {
              a.setAttribute('href', url.toString());
            }
          }
        } catch (_) {}
      });
    } catch (_) {}
  };

  const initialCurrentTheme = document.documentElement.dataset.theme || 'dark';
  syncToggleUI(initialCurrentTheme);
  updateCrossLinks(initialCurrentTheme);

  toggleBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('math-universe-theme', next);
      localStorage.setItem('mathlab_theme', next);
      localStorage.setItem('mathdojo_theme', next);
    } catch {}
    const meta = document.querySelector('[data-theme-meta]');
    if (meta) meta.setAttribute('content', next === 'light' ? '#f2f0ea' : '#101116');
    syncToggleUI(next);
    updateCrossLinks(next);
    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
  });

  window.addEventListener('pageshow', () => {
    try {
      const saved = localStorage.getItem('math-universe-theme') || localStorage.getItem('mathlab_theme') || localStorage.getItem('mathdojo_theme');
      const theme = saved === 'light' || saved === 'dark' ? saved : 'dark';
      document.documentElement.dataset.theme = theme;
      syncToggleUI(theme);
      updateCrossLinks(theme);
    } catch (_) {}
  });

  // Detección de Sistema Operativo para atajo del buscador (⌘K en Mac/Apple vs Ctrl+K en PC/Windows/Linux)
  const isApple =
    typeof navigator !== 'undefined' &&
    /(Mac|iPhone|iPod|iPad)/i.test(
      (navigator as any).userAgentData?.platform || navigator.platform || navigator.userAgent || '',
    );
  const shortcutLabel = isApple ? '⌘K' : 'Ctrl+K';

  document.querySelectorAll<HTMLElement>('[data-cmd-kbd]').forEach((el) => {
    el.textContent = shortcutLabel;
  });

  const cmdTrigger = document.querySelector<HTMLElement>('[data-cmd-open]');
  if (cmdTrigger) {
    cmdTrigger.setAttribute('title', `Buscar aplicación, herramienta o examen (${shortcutLabel})`);
    cmdTrigger.setAttribute('aria-label', `Abrir buscador rápido (${shortcutLabel})`);
  }

  // Control del Menú Móvil Desplegable
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-mobile-drawer]');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    const nextState = !isExpanded;
    menuBtn.setAttribute('aria-expanded', String(nextState));
    menuBtn.classList.toggle('is-active', nextState);
    if (drawer) {
      if (nextState) {
        drawer.removeAttribute('hidden');
        drawer.classList.add('is-open');
      } else {
        drawer.classList.remove('is-open');
        drawer.setAttribute('hidden', '');
      }
    }
  });

  // Cerrar el drawer al pulsar en cualquier enlace de navegación
  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menuBtn?.setAttribute('aria-expanded', 'false');
      menuBtn?.classList.remove('is-active');
      drawer?.classList.remove('is-open');
      drawer?.setAttribute('hidden', '');
    });
  });
</script>

<style>
  .topbar-shell {
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 60;
  }

  .topbar {
    align-items: stretch;
    display: flex;
    justify-content: space-between;
    min-height: 3.4rem;
    width: 100%;
  }

  .topbar-left,
  .topbar-right {
    align-items: stretch;
    display: flex;
  }

  .topbar-brand {
    align-items: center;
    border-right: 1px solid var(--line);
    display: flex;
    padding: 0 1.35rem;
  }

  .topbar-nav {
    align-items: stretch;
    display: flex;
  }

  .topbar-nav a {
    align-items: center;
    color: var(--muted);
    display: flex;
    font: 500 0.68rem/1 var(--mono);
    letter-spacing: 0.13em;
    padding: 0 0.8rem;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .topbar-nav a span {
    padding: 0.28rem 0.48rem;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .topbar-nav a:hover span,
  .topbar-nav a.is-active span {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .topbar-right :global(.topbar-cell),
  .topbar-cell {
    align-items: center;
    border-left: 1px solid var(--line);
    color: var(--muted);
    display: inline-flex;
    font: 500 0.66rem/1 var(--mono);
    gap: 0.45rem;
    letter-spacing: 0.11em;
    padding: 0 1rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .status i {
    background: var(--accent-ink);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent);
    display: inline-block;
    height: 0.4rem;
    width: 0.4rem;
  }

  .cmd-trigger,
  .theme-toggle {
    background: transparent;
    border-bottom: 0;
    border-right: 0;
    border-top: 0;
    color: var(--ink);
    cursor: pointer;
    font-weight: 600;
    transition:
      background 0.16s ease,
      color 0.16s ease;
  }

  .cmd-trigger:hover,
  .cmd-trigger:focus-visible,
  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .cmd-trigger svg,
  .theme-toggle svg {
    height: 0.92rem;
    width: 0.92rem;
  }

  .cmd-kbd {
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    color: var(--accent-ink);
    font: 600 0.56rem/1 var(--mono);
    padding: 0.2rem 0.35rem;
  }

  .cmd-trigger:hover .cmd-kbd {
    background: transparent;
    border-color: currentColor;
    color: inherit;
  }

  .topbar-cta {
    align-items: center;
    background: var(--invert-bg);
    border-left: 1px solid var(--line);
    color: var(--invert-fg);
    display: inline-flex;
    font: 700 0.68rem/1 var(--mono);
    letter-spacing: 0.12em;
    padding: 0 1.35rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.15s ease;
    white-space: nowrap;
  }

  .topbar-cta:hover {
    opacity: 0.85;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }

  /* Botón Menú Móvil */
  .mobile-menu-btn {
    display: none;
    background: transparent;
    border-bottom: 0;
    border-right: 0;
    border-top: 0;
    color: var(--ink);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition:
      background 0.16s ease,
      color 0.16s ease;
  }

  .mobile-menu-btn:hover,
  .mobile-menu-btn:focus-visible,
  .mobile-menu-btn.is-active {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .mobile-menu-btn svg {
    height: 1.05rem;
    width: 1.05rem;
  }

  .mobile-menu-btn .icon-close {
    display: none;
  }

  .mobile-menu-btn.is-active .icon-menu {
    display: none;
  }

  .mobile-menu-btn.is-active .icon-close {
    display: block;
  }

  /* Drawer Desplegable Móvil */
  .mobile-drawer {
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-strong);
    display: block;
    padding: 1rem 1.25rem 1.35rem;
    animation: drawerSlideDown 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-drawer[hidden] {
    display: none;
  }

  @keyframes drawerSlideDown {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-drawer-nav a {
    color: var(--ink);
    font: 600 0.82rem/1.2 var(--mono);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.55rem 0.65rem;
    border-radius: 5px;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .mobile-drawer-nav a:hover,
  .mobile-drawer-nav a.is-active {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .mobile-drawer-divider {
    height: 1px;
    background: var(--line);
    margin: 0.4rem 0;
  }

  .mobile-drawer-direct {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
  }

  .mobile-drawer-chip {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font: 500 0.72rem/1.2 var(--mono);
    color: var(--ink-soft);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.5rem 0.65rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .mobile-drawer-chip:hover {
    border-color: var(--line-strong);
    color: var(--ink-strong);
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  @media (max-width: 1120px) {
    .status {
      display: none;
    }
  }

  @media (max-width: 920px) {
    .topbar-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: inline-flex;
    }
  }

  @media (max-width: 680px) {
    .topbar-cta,
    .cmd-trigger-text,
    .cmd-kbd,
    .theme-toggle-text {
      display: none;
    }

    .topbar-brand {
      padding: 0 0.85rem;
    }

    .topbar-right :global(.topbar-cell),
    .topbar-cell {
      padding: 0 0.7rem;
      gap: 0.35rem;
    }
  }

  @media (max-width: 480px) {
    .topbar-brand {
      padding: 0 0.65rem;
    }

    .topbar-brand :global(.logo-uni) {
      display: none;
    }

    .topbar-right :global(.topbar-cell),
    .topbar-cell {
      padding: 0 0.55rem;
    }

    .mobile-drawer-direct {
      grid-template-columns: 1fr;
    }
  }
</style>
