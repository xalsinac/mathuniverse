---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ScientificCalculator from '../components/ScientificCalculator.astro';
import { ACADEMY_BLOCKS, type AcademyLesson, type AcademyBlock } from '../data/academy';

interface Props {
  lesson: AcademyLesson;
  prevLesson?: AcademyLesson;
  nextLesson?: AcademyLesson;
}

const { lesson, prevLesson, nextLesson } = Astro.props;
const currentBlock = ACADEMY_BLOCKS.find((b) => b.id === lesson.blockId) || ACADEMY_BLOCKS[0];
---

<BaseLayout
  title={`${lesson.title} — Math Academy | Math Universe`}
  description={`${lesson.subtitle}. ${lesson.summary}`}
>
  <!-- Barra superior técnica -->
  <SiteHeader activePage="academy" statusText="07 · Math Academy" ctaHref="/academy" ctaLabel="Índice del Tratado">
    <div slot="right-extra" class="topbar-cell academy-top-actions">
      <button
        type="button"
        class="academy-top-btn"
        data-toggle-floating-calc
        title="Invocar calculadora científica en ventana flotante (Picture-in-Picture)"
      >
        <svg class="btn-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="16" height="20" x="4" y="2" rx="2"></rect>
          <line x1="8" x2="16" y1="6" y2="6"></line>
          <line x1="16" x2="16" y1="14" y2="14"></line>
          <path d="M16 10h.01M12 10h.01M8 10h.01M12 14h.01M8 14h.01M12 18h.01M8 18h.01"></path>
        </svg>
        <span class="btn-text">Calculadora</span>
        <span class="btn-pip-tag" aria-hidden="true">PiP</span>
      </button>
    </div>
  </SiteHeader>

  <!-- Barra de progreso de lectura interactiva -->
  <div class="reading-progress-track" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <main class="lesson-main-wrapper" style={`--block-accent: ${currentBlock.color}; --block-accent-light: ${currentBlock.colorLight || currentBlock.color};`}>
    <!-- Cabecera de la Lección / Hero Académico -->
    <header class="lesson-header-band section-band is-drawn">
      <span class="section-rule" aria-hidden="true"></span>
      <div class="section-frame">
        <span class="tick tick-half tick-left" aria-hidden="true"></span>
        <span class="tick tick-half tick-right" aria-hidden="true"></span>

        <!-- Migas de Pan Técnicas -->
        <nav class="lesson-breadcrumbs" aria-label="Ruta de navegación">
          <a href="/academy" class="crumb-link">
            <span>Math Academy</span>
          </a>
          <span class="crumb-sep">/</span>
          <a href={`/academy#bloque-${currentBlock.id}`} class="crumb-link">
            <span class="crumb-glyph">{currentBlock.glyph}</span>
            <span>{currentBlock.number}. {currentBlock.name}</span>
          </a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current" aria-current="page">{lesson.title}</span>
        </nav>

        <!-- Bloque de Identidad y Metadatos de la Lección -->
        <div class="lesson-hero-card">
          <div class="hero-top-meta">
            <div class="meta-badges-cluster">
              <span class="lesson-level-badge">{lesson.level}</span>
              <span class="lesson-type-badge">{lesson.badge}</span>
              <span class="lesson-diff-badge" title="Nivel de exigencia">{lesson.difficulty}</span>
            </div>
            <div class="reading-duration-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>~{lesson.durationMinutes} min de estudio</span>
            </div>
          </div>

          <h1 class="lesson-title">{lesson.title}</h1>
          <p class="lesson-subtitle">{lesson.subtitle}</p>

          <!-- Eje Riguroso / Fórmula Rectora -->
          <div class="lesson-core-formula-box">
            <span class="core-formula-label">EJE RIGUROSO Y FORMULACIÓN MATEMÁTICA:</span>
            <code class="core-formula-code">{lesson.keyConcept}</code>
          </div>

          <div class="lesson-summary-box">
            <p>{lesson.summary}</p>
          </div>

          <!-- Prerrequisitos Formales -->
          {lesson.prerequisites && lesson.prerequisites.length > 0 && (
            <div class="lesson-prereq-strip">
              <span class="prereq-title">CONOCIMIENTOS PREVIOS REQUERIDOS:</span>
              <div class="prereq-pills">
                {lesson.prerequisites.map((p) => (
                  <span class="prereq-pill">{p}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Cuerpo de la Lección (Contenido y Menú Rápido) -->
    <section class="lesson-content-band section-band is-drawn">
      <span class="section-rule" aria-hidden="true"></span>
      <div class="section-frame lesson-layout-grid">
        <span class="tick tick-half tick-left" aria-hidden="true"></span>
        <span class="tick tick-half tick-right" aria-hidden="true"></span>

        <!-- Contenido Didáctico y Riguroso -->
        <article class="lesson-article-prose">
          <slot />

          <!-- Pie de Lección: Navegación entre lecciones del bloque -->
          <footer class="lesson-footer-nav">
            <div class="footer-nav-grid">
              {prevLesson ? (
                <a href={prevLesson.href || `/academy#bloque-${currentBlock.id}`} class="nav-lesson-card is-prev">
                  <span class="nav-dir">← Lección Anterior</span>
                  <span class="nav-title">{prevLesson.title}</span>
                  <span class="nav-sub">{prevLesson.subtitle}</span>
                </a>
              ) : (
                <a href="/academy" class="nav-lesson-card is-prev">
                  <span class="nav-dir">← Volver al Tratado</span>
                  <span class="nav-title">Índice de Bloques</span>
                  <span class="nav-sub">Explora los 6 bloques fundamentales</span>
                </a>
              )}

              {nextLesson ? (
                <a href={nextLesson.href || `/academy#bloque-${currentBlock.id}`} class="nav-lesson-card is-next">
                  <span class="nav-dir">Siguiente Lección →</span>
                  <span class="nav-title">{nextLesson.title}</span>
                  <span class="nav-sub">{nextLesson.subtitle}</span>
                </a>
              ) : (
                <a href="/academy" class="nav-lesson-card is-next">
                  <span class="nav-dir">Siguiente Paso →</span>
                  <span class="nav-title">Salón de los Grandes Teoremas</span>
                  <span class="nav-sub">Demostraciones icónicas de la historia</span>
                </a>
              )}
            </div>
          </footer>
        </article>
      </div>
    </section>
  </main>

  <!-- Calculadora Científica PiP Integrada -->
  <div class="academy-calc-dock" style="position: fixed; bottom: -9999px; left: -9999px; opacity: 0; pointer-events: none;" aria-hidden="true">
    <ScientificCalculator compact={true} />
  </div>
</BaseLayout>

<script>
  (() => {
    // 1. Invocación de la Calculadora PiP
    const calcTopBtn = document.querySelector<HTMLButtonElement>('[data-toggle-floating-calc]');
    if (calcTopBtn) {
      calcTopBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('request-calc-pip'));
      });
    }

    // 2. Barra de progreso de lectura al hacer scroll
    const progressBar = document.getElementById('reading-progress-bar');
    if (progressBar) {
      const updateReadingProgress = () => {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight <= 0) return;
        const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
        progressBar.style.width = `${progress}%`;
      };
      window.addEventListener('scroll', updateReadingProgress, { passive: true });
      updateReadingProgress();
    }
  })();
</script>

<style>
  /* =========================================================================
     ESTILOS DEL MARCO GENERAL DE LECCIÓN DE MATH ACADEMY
     ========================================================================= */

  /* Barra de progreso de lectura */
  .reading-progress-track {
    position: fixed;
    top: 54px; /* Justo debajo de la barra de navegación */
    left: 0;
    width: 100%;
    height: 3px;
    background: transparent;
    z-index: 99;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--block-accent, #ffc14d), #fbbf24);
    box-shadow: 0 0 8px var(--block-accent, #ffc14d);
    transition: width 0.1s linear;
  }

  :global([data-theme="light"]) .reading-progress-bar {
    background: linear-gradient(90deg, var(--block-accent-light, #d97706), #b45309);
    box-shadow: 0 0 8px var(--block-accent-light, rgba(217, 119, 6, 0.4));
  }

  /* Botones superiores */
  .academy-top-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .academy-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink, #f3f2ec);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);
    border: 1px solid rgba(255, 193, 77, 0.35);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .academy-top-btn .btn-svg {
    opacity: 0.9;
    color: #ffc14d;
  }

  :global([data-theme="light"]) .academy-top-btn .btn-svg {
    color: #d97706;
  }

  .btn-pip-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.65rem;
    font-weight: 800;
    color: #ffc14d;
    background: rgba(255, 193, 77, 0.15);
    border: 1px solid rgba(255, 193, 77, 0.4);
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
  }

  :global([data-theme="light"]) .btn-pip-tag {
    color: #b45309;
    background: rgba(217, 119, 6, 0.12);
    border-color: rgba(217, 119, 6, 0.35);
  }

  .academy-top-btn:hover {
    background: linear-gradient(180deg, rgba(255, 193, 77, 0.2) 0%, rgba(255, 193, 77, 0.08) 100%);
    border-color: #ffc14d;
    color: #ffc14d;
    transform: translateY(-1px);
  }

  :global([data-theme="light"]) .academy-top-btn {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid rgba(217, 119, 6, 0.35);
    color: #0f172a;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06), inset 0 1px 0 #ffffff;
  }

  /* Migas de pan */
  .lesson-breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 0.5rem 0.8rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.06));
    font-size: 0.82rem;
  }

  .crumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted, #94a3b8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .crumb-link:hover {
    color: var(--block-accent, #ffc14d);
  }

  .crumb-glyph {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    color: var(--block-accent, #ffc14d);
  }

  .crumb-sep {
    color: var(--muted, #94a3b8);
    opacity: 0.5;
  }

  .crumb-current {
    color: var(--ink, #f3f2ec);
    font-weight: 700;
  }

  :global([data-theme="light"]) .crumb-current {
    color: #0f172a;
  }

  /* Tarjeta Hero de la Lección */
  .lesson-hero-card {
    padding: 2.4rem;
    border-radius: 20px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.015) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 4px solid var(--block-accent, #ffc14d);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    margin-bottom: 1rem;
  }

  :global([data-theme="light"]) .lesson-hero-card {
    background: linear-gradient(145deg, #ffffff 0%, #fbfbfa 100%);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-top: 4px solid var(--block-accent-light, #d97706);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08), inset 0 1px 2px #ffffff;
  }

  .hero-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }

  .meta-badges-cluster {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .lesson-level-badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: linear-gradient(180deg, rgba(255, 193, 77, 0.25) 0%, rgba(255, 193, 77, 0.12) 100%);
    color: #ffc14d;
    border: 1.5px solid #ffc14d;
    letter-spacing: 0.04em;
  }

  :global([data-theme="light"]) .lesson-level-badge {
    background: linear-gradient(180deg, #fff7ed 0%, #ffedd5 100%);
    color: #9a3412;
    border-color: #d97706;
  }

  .lesson-type-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--muted, #94a3b8);
  }

  :global([data-theme="light"]) .lesson-type-badge {
    background: #f1f5f9;
    border-color: #e2e8f0;
    color: #475569;
  }

  .lesson-diff-badge {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted, #94a3b8);
  }

  .reading-duration-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--muted, #94a3b8);
    font-weight: 600;
  }

  .lesson-title {
    font-size: 2.3rem;
    font-weight: 900;
    margin: 0 0 0.4rem;
    color: var(--ink, #f3f2ec);
    line-height: 1.25;
  }

  .lesson-subtitle {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--block-accent, #ffc14d);
    margin: 0 0 1.4rem;
    line-height: 1.45;
    font-weight: 600;
  }

  :global([data-theme="light"]) .lesson-subtitle {
    color: var(--block-accent-light, #d97706);
  }

  .lesson-core-formula-box {
    margin: 0.8rem 0 1.4rem;
    padding: 0.9rem 1.2rem;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.45);
    border: 1.5px solid rgba(255, 193, 77, 0.3);
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.35);
  }

  :global([data-theme="light"]) .lesson-core-formula-box {
    background: #f8fafc;
    border: 1.5px solid var(--block-accent-light, rgba(217, 119, 6, 0.3));
    box-shadow: inset 0 1px 3px rgba(15, 23, 42, 0.05);
  }

  .core-formula-label {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--muted, #94a3b8);
    margin-bottom: 0.35rem;
  }

  .core-formula-code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 1.12rem;
    font-weight: 800;
    color: var(--block-accent, #ffc14d);
    letter-spacing: 0.02em;
  }

  :global([data-theme="light"]) .core-formula-code {
    color: var(--block-accent-light, #b45309);
  }

  .lesson-summary-box p {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--ink, #f3f2ec);
    margin: 0 0 1.2rem;
  }

  :global([data-theme="light"]) .lesson-summary-box p {
    color: #334155;
  }

  .lesson-prereq-strip {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
    flex-wrap: wrap;
  }

  .prereq-title {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--muted, #94a3b8);
  }

  .prereq-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .prereq-pill {
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--ink, #f3f2ec);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
  }

  :global([data-theme="light"]) .prereq-pill {
    background: #f1f5f9;
    border-color: #e2e8f0;
    color: #1e293b;
  }

  /* Contenedor del Artículo */
  .lesson-article-prose {
    max-width: 880px;
    margin: 0 auto;
    padding: 2rem 0 5rem;
  }

  /* Pie de lección: navegación */
  .lesson-footer-nav {
    margin-top: 5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .nav-lesson-card {
    display: flex;
    flex-direction: column;
    padding: 1.4rem;
    border-radius: 14px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-lesson-card:hover {
    border-color: var(--block-accent, #ffc14d);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  :global([data-theme="light"]) .nav-lesson-card {
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.1);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
  }

  :global([data-theme="light"]) .nav-lesson-card:hover {
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    border-color: var(--block-accent, #d97706);
  }

  .nav-dir {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--block-accent, #ffc14d);
    letter-spacing: 0.06em;
    margin-bottom: 0.35rem;
  }

  :global([data-theme="light"]) .nav-dir {
    color: #d97706;
  }

  .nav-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--ink, #f3f2ec);
    margin-bottom: 0.2rem;
  }

  :global([data-theme="light"]) .nav-title {
    color: #0f172a;
  }

  .nav-sub {
    font-size: 0.82rem;
    color: var(--muted, #94a3b8);
  }

  @media (max-width: 768px) {
    .lesson-hero-card {
      padding: 1.5rem;
    }
    .lesson-title {
      font-size: 1.8rem;
    }
    .hero-top-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
