---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ScientificCalculator from '../components/ScientificCalculator.astro';
import { ACADEMY_BLOCKS, type AcademyLesson, type AcademyBlock } from '../data/academy';

interface Props {
  lesson: AcademyLesson;
  prevLesson?: AcademyLesson;
  nextLesson?: AcademyLesson;
}

const { lesson, prevLesson, nextLesson } = Astro.props;
const currentBlock = ACADEMY_BLOCKS.find((b) => b.id === lesson.blockId) || ACADEMY_BLOCKS[0];
const cleanTitle = lesson.title.replace(/<[^>]*>/g, '');
---

<BaseLayout
  title={`${cleanTitle} — Math Academy | Math Universe`}
  description={`${lesson.subtitle}. ${lesson.summary}`}
>
  <!-- Barra superior técnica -->
  <SiteHeader activePage="academy" statusText="07 · Math Academy" ctaHref="/academy" ctaLabel="Índice del Tratado">
    <div slot="right-extra" class="topbar-cell academy-top-actions">
      <button
        type="button"
        class="academy-top-btn"
        data-toggle-floating-calc
        title="Invocar calculadora científica en ventana flotante (Picture-in-Picture)"
      >
        <svg class="btn-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="16" height="20" x="4" y="2" rx="2"></rect>
          <line x1="8" x2="16" y1="6" y2="6"></line>
          <line x1="16" x2="16" y1="14" y2="14"></line>
          <path d="M16 10h.01M12 10h.01M8 10h.01M12 14h.01M8 14h.01M12 18h.01M8 18h.01"></path>
        </svg>
        <span class="btn-text">Calculadora</span>
        <span class="btn-pip-tag" aria-hidden="true">PiP</span>
      </button>
    </div>
  </SiteHeader>

  <!-- Barra de progreso de lectura interactiva -->
  <div class="reading-progress-track" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <main class="lesson-main-wrapper" style={`--block-accent: ${currentBlock.color}; --block-accent-light: ${currentBlock.colorLight || currentBlock.color};`}>
    <!-- Cabecera de la Lección / Hero Académico -->
    <header class="lesson-header-band section-band is-drawn">
      <span class="section-rule" aria-hidden="true"></span>
      <div class="section-frame">
        <span class="tick tick-half tick-left" aria-hidden="true"></span>
        <span class="tick tick-half tick-right" aria-hidden="true"></span>

        <!-- Migas de Pan Técnicas -->
        <nav class="lesson-breadcrumbs" aria-label="Ruta de navegación">
          <a href="/academy" class="crumb-link">
            <span>Math Academy</span>
          </a>
          <span class="crumb-sep">/</span>
          <a href={`/academy#bloque-${currentBlock.id}`} class="crumb-link">
            <span class="crumb-glyph">{currentBlock.glyph}</span>
            <span>{currentBlock.number}. {currentBlock.name}</span>
          </a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current" aria-current="page" set:html={lesson.title} />
        </nav>

        <!-- Bloque de Identidad y Metadatos de la Lección -->
        <div class="lesson-hero-card">
          <div class="hero-top-meta">
            <div class="meta-badges-cluster">
              <span class="lesson-level-badge">{lesson.level}</span>
              <span class="lesson-type-badge">{lesson.badge}</span>
              <span class="lesson-diff-badge" title="Nivel de exigencia">{lesson.difficulty}</span>
            </div>
            <div class="reading-duration-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 12 16 14"></polyline>
              </svg>
              <span>~{lesson.durationMinutes} min de estudio</span>
            </div>
          </div>

          <h1 class="lesson-title" set:html={lesson.title} />
          <p class="lesson-subtitle">{lesson.subtitle}</p>

          <!-- Eje Riguroso / Fórmula Rectora -->
          <div class="lesson-core-formula-box">
            <span class="core-formula-label">EJE RIGUROSO Y FORMULACIÓN MATEMÁTICA:</span>
            <code class="core-formula-code" set:html={lesson.keyConcept} />
          </div>

          <div class="lesson-summary-box">
            <p>{lesson.summary}</p>
          </div>

          <!-- Prerrequisitos Formales -->
          {lesson.prerequisites && lesson.prerequisites.length > 0 && (
            <div class="lesson-prereq-strip">
              <span class="prereq-title">CONOCIMIENTOS PREVIOS REQUERIDOS:</span>
              <div class="prereq-pills">
                {lesson.prerequisites.map((p) => (
                  <span class="prereq-pill">{p}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Cuerpo de la Lección (Contenido y Menú Rápido) -->
    <section class="lesson-content-band section-band is-drawn">
      <span class="section-rule" aria-hidden="true"></span>
      <div class="section-frame lesson-layout-grid">
        <span class="tick tick-half tick-left" aria-hidden="true"></span>
        <span class="tick tick-half tick-right" aria-hidden="true"></span>

        <!-- Contenido Didáctico y Riguroso -->
        <article class="lesson-article-prose">
          <slot />

          <!-- Pie de Lección: Navegación entre lecciones del bloque -->
          <footer class="lesson-footer-nav">
            <div class="footer-nav-grid">
              {prevLesson ? (
                <a href={prevLesson.href || `/academy#bloque-${currentBlock.id}`} class="nav-lesson-card is-prev">
                  <span class="nav-dir">← Lección Anterior</span>
                  <span class="nav-title" set:html={prevLesson.title} />
                  <span class="nav-sub">{prevLesson.subtitle}</span>
                </a>
              ) : (
                <a href="/academy" class="nav-lesson-card is-prev">
                  <span class="nav-dir">← Volver al Tratado</span>
                  <span class="nav-title">Índice de Bloques</span>
                  <span class="nav-sub">Explora los 6 bloques fundamentales</span>
                </a>
              )}

              {nextLesson ? (
                <a href={nextLesson.href || `/academy#bloque-${currentBlock.id}`} class="nav-lesson-card is-next">
                  <span class="nav-dir">Siguiente Lección →</span>
                  <span class="nav-title" set:html={nextLesson.title} />
                  <span class="nav-sub">{nextLesson.subtitle}</span>
                </a>
              ) : (
                <a href="/academy" class="nav-lesson-card is-next">
                  <span class="nav-dir">Siguiente Paso →</span>
                  <span class="nav-title">Salón de los Grandes Teoremas</span>
                  <span class="nav-sub">Demostraciones icónicas de la historia</span>
                </a>
              )}
            </div>
          </footer>
        </article>

        <!-- Barra lateral vertical: Índice y Progreso de Capítulos (Desktop) -->
        <aside class="lesson-toc-sidebar" id="lesson-toc-sidebar" aria-label="Índice de capítulos de la lección">
          <div class="toc-sticky-container">
            <div class="toc-header">
              <div class="toc-header-left">
                <span class="toc-glyph">§</span>
                <span class="toc-badge">CAPÍTULOS</span>
              </div>
              <span class="toc-progress-val" id="toc-progress-val">0%</span>
            </div>

            <div class="toc-body">
              <div class="toc-rail" aria-hidden="true">
                <div class="toc-rail-fill" id="toc-rail-fill"></div>
              </div>
              <nav class="toc-nav" id="toc-nav-list" aria-label="Navegación de capítulos">
                <!-- Se puebla dinámicamente con JavaScript desde section.lesson-section -->
              </nav>
            </div>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <!-- Calculadora Científica PiP Integrada -->
  <div class="academy-calc-dock" style="position: fixed; bottom: -9999px; left: -9999px; opacity: 0; pointer-events: none;" aria-hidden="true">
    <ScientificCalculator compact={true} />
  </div>
</BaseLayout>

<script>
  (() => {
    // 1. Invocación de la Calculadora PiP
    const calcTopBtn = document.querySelector<HTMLButtonElement>('[data-toggle-floating-calc]');
    if (calcTopBtn) {
      calcTopBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('request-calc-pip'));
      });
    }

    // 2. Generación dinámica del Índice de Capítulos (TOC) y Raíl Vertical
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section.lesson-section[id]'));
    const tocNav = document.getElementById('toc-nav-list');
    const railFill = document.getElementById('toc-rail-fill');
    const progressVal = document.getElementById('toc-progress-val');
    const mobileProgressBar = document.getElementById('reading-progress-bar');

    if (tocNav && sections.length > 0) {
      tocNav.innerHTML = '';
      sections.forEach((sec, idx) => {
        const id = sec.id;
        const marker = sec.querySelector('.marker-num')?.textContent?.trim() || String(idx + 1).padStart(2, '0');
        const h2 = sec.querySelector('h2');
        let titleText = h2?.textContent?.trim() || `Capítulo ${idx + 1}`;
        titleText = titleText.replace(/^(\d+[\.\s\-]+)+/, '').trim();

        const link = document.createElement('a');
        link.href = `#${id}`;
        link.className = 'toc-link';
        link.dataset.targetId = id;
        link.title = titleText;
        link.innerHTML = `
          <span class="toc-link-num">${marker}</span>
          <span class="toc-link-text">${titleText}</span>
        `;

        link.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById(id);
          if (target) {
            const topOffset = 80;
            const targetPos = target.getBoundingClientRect().top + window.scrollY - topOffset;
            window.scrollTo({ top: targetPos, behavior: 'smooth' });
            history.pushState(null, '', `#${id}`);
          }
        });

        tocNav.appendChild(link);
      });
    }

    // 3. Sincronización del scroll con el raíl vertical de la barra lateral y la barra móvil
    const updateScrollState = () => {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollY / docHeight) * 100)) : 0;

      if (mobileProgressBar) {
        mobileProgressBar.style.width = `${pct}%`;
      }
      if (railFill) {
        railFill.style.height = `${pct}%`;
      }
      if (progressVal) {
        progressVal.textContent = `${Math.round(pct)}%`;
      }

      // Detección del capítulo activo
      if (sections.length > 0 && tocNav) {
        const scrollMiddle = scrollY + 180;
        let activeSecId = sections[0].id;
        for (let i = 0; i < sections.length; i++) {
          if (scrollMiddle >= sections[i].offsetTop) {
            activeSecId = sections[i].id;
          }
        }
        const links = tocNav.querySelectorAll<HTMLAnchorElement>('.toc-link');
        links.forEach((l) => {
          if (l.dataset.targetId === activeSecId) {
            l.classList.add('is-active');
          } else {
            l.classList.remove('is-active');
          }
        });
      }
    };

    window.addEventListener('scroll', updateScrollState, { passive: true });
    window.addEventListener('resize', updateScrollState, { passive: true });
    
    if (window.location.hash) {
      const initialTarget = document.querySelector<HTMLElement>(window.location.hash);
      if (initialTarget) {
        initialTarget.scrollIntoView();
      }
    }
    updateScrollState();
  })();
</script>

<style>
  /* =========================================================================
     ESTILOS DEL MARCO GENERAL DE LECCIÓN DE MATH ACADEMY
     ========================================================================= */

  /* Barra de progreso de lectura (Visible únicamente en móviles/tablets; en PC se usa el raíl vertical de capítulos) */
  .reading-progress-track {
    position: fixed;
    top: 54px; /* Justo debajo de la barra de navegación */
    left: 0;
    width: 100%;
    height: 3px;
    background: transparent;
    z-index: 99;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--block-accent, #ffc14d), #fbbf24);
    box-shadow: 0 0 8px var(--block-accent, #ffc14d);
    transition: width 0.1s linear;
  }

  :global([data-theme="light"]) .reading-progress-bar {
    background: linear-gradient(90deg, var(--block-accent-light, #d97706), #b45309);
    box-shadow: 0 0 8px var(--block-accent-light, rgba(217, 119, 6, 0.4));
  }

  /* Distribución de la Cuadrícula y Barra Lateral de Capítulos */
  .lesson-layout-grid {
    position: relative;
    width: 100%;
  }

  @media (min-width: 1100px) {
    .lesson-layout-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 270px;
      gap: 3.5rem;
      align-items: start;
      padding: 0 2rem;
    }

    .lesson-article-prose {
      max-width: 100%;
      margin: 0;
      padding: 1.5rem 0 5rem;
    }

    /* En PC/Desktop, se desactiva la barra horizontal invasiva en favor del raíl lateral */
    .reading-progress-track {
      display: none !important;
    }
  }

  @media (max-width: 1099px) {
    .lesson-toc-sidebar {
      display: none !important;
    }

    .lesson-article-prose {
      max-width: 880px;
      margin: 0 auto;
      padding: 1.5rem 1rem 4rem;
    }
  }

  /* Barra Lateral de Capítulos (Desktop) */
  .lesson-toc-sidebar {
    position: -webkit-sticky;
    position: sticky;
    top: 76px;
    align-self: start;
    height: fit-content;
    margin-top: 1.5rem;
    max-height: calc(100vh - 96px);
    display: flex;
    flex-direction: column;
    z-index: 20;
  }

  .toc-sticky-container {
    padding: 1.25rem 1.15rem;
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25), inset 0 1px 1px rgba(255, 255, 255, 0.1);
  }

  :global([data-theme="light"]) .toc-sticky-container {
    background: linear-gradient(160deg, #ffffff 0%, #fbfbfa 100%);
    border: 1px solid rgba(0, 0, 0, 0.09);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05), inset 0 1px 2px #ffffff;
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.8rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global([data-theme="light"]) .toc-header {
    border-bottom-color: rgba(0, 0, 0, 0.08);
  }

  .toc-header-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .toc-glyph {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 800;
    color: var(--block-accent, #ffc14d);
    font-size: 0.85rem;
  }

  :global([data-theme="light"]) .toc-glyph {
    color: var(--block-accent-light, #d97706);
  }

  .toc-badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--block-accent, #ffc14d);
  }

  :global([data-theme="light"]) .toc-badge {
    color: var(--block-accent-light, #d97706);
  }

  .toc-progress-val {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted, #94a3b8);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global([data-theme="light"]) .toc-progress-val {
    background: #f1f5f9;
    border-color: #e2e8f0;
    color: #475569;
  }

  .toc-body {
    position: relative;
    padding-left: 1.1rem;
    max-height: calc(100vh - 180px);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-rail {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: 2px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
  }

  :global([data-theme="light"]) .toc-rail {
    background: rgba(0, 0, 0, 0.1);
  }

  .toc-rail-fill {
    width: 100%;
    height: 0%;
    background: var(--block-accent, #ffc14d);
    box-shadow: 0 0 8px var(--block-accent, #ffc14d);
    border-radius: 999px;
    transition: height 0.12s ease-out;
  }

  :global([data-theme="light"]) .toc-rail-fill {
    background: var(--block-accent-light, #d97706);
    box-shadow: 0 0 6px rgba(217, 119, 6, 0.4);
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global(.toc-link) {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--muted, #94a3b8);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    border-left: 2px solid transparent;
  }

  :global(.toc-link-num) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    opacity: 0.65;
    flex-shrink: 0;
  }

  :global(.toc-link-text) {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  :global(.toc-link:hover) {
    color: var(--ink, #f3f2ec);
    background: rgba(255, 255, 255, 0.05);
    border-left-color: rgba(255, 255, 255, 0.2);
    transform: translateX(2px);
  }

  :global([data-theme="light"] .toc-link:hover) {
    color: #0f172a;
    background: rgba(0, 0, 0, 0.04);
    border-left-color: rgba(0, 0, 0, 0.2);
  }

  :global(.toc-link.is-active) {
    color: var(--block-accent, #ffc14d);
    font-weight: 700;
    background: rgba(255, 193, 77, 0.09);
    border-left-color: var(--block-accent, #ffc14d);
    transform: translateX(3px);
  }

  :global([data-theme="light"] .toc-link.is-active) {
    color: var(--block-accent-light, #b45309);
    background: rgba(217, 119, 6, 0.08);
    border-left-color: var(--block-accent-light, #d97706);
  }

  :global(.toc-link.is-active .toc-link-num) {
    opacity: 1;
    color: var(--block-accent, #ffc14d);
  }

  :global([data-theme="light"] .toc-link.is-active .toc-link-num) {
    color: var(--block-accent-light, #b45309);
  }

  /* =========================================================================
     TIPOGRAFÍA Y NOTACIÓN MATEMÁTICA RIGUROSA (ACADEMY MATH ENGINE)
     ========================================================================= */

  /* Raíz Cuadrada con Vinculum (barra superior continua que abraza todo el radicando) */
  :global(.math-sqrt) {
    display: inline-flex;
    align-items: baseline;
    vertical-align: baseline;
    white-space: nowrap;
    margin: 0 0.12em;
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  }

  :global(.math-sqrt .sqrt-rad) {
    font-size: 1.18em;
    line-height: 1;
    margin-right: -0.02em;
    transform: translateY(0.06em);
    user-select: none;
    font-weight: 400;
  }

  :global(.math-sqrt .sqrt-body) {
    border-top: 1.6px solid currentColor;
    padding-top: 0.12em;
    padding-left: 0.15em;
    padding-right: 0.22em;
    margin-left: 0;
    display: inline-block;
    line-height: 1.15;
  }

  /* Fracción Vertical de Dos Pisos */
  :global(.math-frac) {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    vertical-align: middle;
    text-align: center;
    padding: 0 0.25em;
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    line-height: 1;
  }

  :global(.math-frac .num) {
    display: block;
    width: 100%;
    font-size: 0.88em;
    line-height: 1.1;
    border-bottom: 1.6px solid currentColor;
    padding-bottom: 0.15em;
    padding-left: 0.25em;
    padding-right: 0.25em;
    box-sizing: border-box;
    text-align: center;
  }

  :global(.math-frac .den) {
    display: block;
    width: 100%;
    font-size: 0.88em;
    line-height: 1.1;
    padding-top: 0.15em;
    padding-left: 0.25em;
    padding-right: 0.25em;
    box-sizing: border-box;
    text-align: center;
  }

  /* Sub-fracción compacta para argumentos y numeradores anidados */
  :global(.math-subfrac) {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    vertical-align: middle;
    font-size: 0.75em;
    line-height: 1;
    padding: 0 0.15em;
  }

  :global(.math-subfrac .num) {
    border-bottom: 1.2px solid currentColor;
    padding-bottom: 0.08em;
  }

  :global(.math-subfrac .den) {
    padding-top: 0.08em;
  }

  /* Operador de límite con subíndice centrado */
  :global(.math-lim) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
    margin: 0 0.22em;
    vertical-align: middle;
  }

  :global(.math-lim sub) {
    font-size: 0.62em;
    font-weight: 700;
    opacity: 0.88;
    margin-top: 0.15em;
    vertical-align: unset !important;
    line-height: 1;
  }

  /* Operador de Integral Definida con Límites Superior e Inferior */
  :global(.math-integral) {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    line-height: 1;
    margin: 0 0.18em;
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  }

  :global(.math-integral .int-symbol) {
    font-size: 1.55em;
    line-height: 0.88;
    font-weight: 300;
    transform: translateY(-0.02em);
    user-select: none;
  }

  :global(.math-integral .int-limits) {
    display: inline-flex;
    flex-direction: column;
    justify-content: space-between;
    height: 1.55em;
    font-size: 0.64em;
    font-weight: 700;
