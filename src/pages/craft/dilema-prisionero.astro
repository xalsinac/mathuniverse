    function initSandbox() {
      stopAutoEvolve();
      generation = 0;
      population = [];
      const totalInitial = 120; // 20 agentes de cada especie
      const perSpecies = Math.floor(totalInitial / SPECIES_CONFIG.length);

      SPECIES_CONFIG.forEach((sp) => {
        for (let i = 0; i < perSpecies; i++) {
          population.push({ speciesId: sp.id });
        }
      });

      renderSandboxUI();
    }

    function runOneGeneration() {
      generation++;
      const speciesMap = new Map(SPECIES_CONFIG.map((s) => [s.id, s]));

      // 1. Cada agente juega con todos los demás un dilema de 10 rondas
      const scores = new Array(population.length).fill(0);
      const roundsPerMatch = 10;

      for (let i = 0; i < population.length; i++) {
        for (let j = i + 1; j < population.length; j++) {
          const spA = speciesMap.get(population[i].speciesId)!;
          const spB = speciesMap.get(population[j].speciesId)!;

          const hA: Action[] = [];
          const hB: Action[] = [];

          for (let r = 0; r < roundsPerMatch; r++) {
            let actA = spA.getAction(hA, hB);
            let actB = spB.getAction(hB, hA);

            // Simular ruido (malentendido en la comunicación)
            if (noisePct > 0) {
              if (Math.random() * 100 < noisePct) actA = actA === 'C' ? 'D' : 'C';
              if (Math.random() * 100 < noisePct) actB = actB === 'C' ? 'D' : 'C';
            }

            hA.push(actA);
            hB.push(actB);

            if (actA === 'C' && actB === 'C') {
              scores[i] += 2;
              scores[j] += 2;
            } else if (actA === 'C' && actB === 'D') {
              scores[i] -= 1;
              scores[j] += 3;
            } else if (actA === 'D' && actB === 'C') {
              scores[i] += 3;
              scores[j] -= 1;
            }
          }
        }
      }

      // 2. Selección natural: se eliminan los 15 con peor puntuación y se reproducen los 15 mejores
      const indexed = population.map((agent, idx) => ({ ...agent, score: scores[idx] }));
      indexed.sort((a, b) => b.score - a.score);

      const turnover = 15;
      const survivors = indexed.slice(0, indexed.length - turnover);
      const topReproducers = indexed.slice(0, turnover);

      // Nueva población
      population = [
        ...survivors.map((a) => ({ speciesId: a.speciesId })),
        ...topReproducers.map((a) => ({ speciesId: a.speciesId })),
      ];

      renderSandboxUI();
    }

    function renderSandboxUI() {
      if (sbGenCount) sbGenCount.textContent = String(generation);
      if (sbPopCount) sbPopCount.textContent = `${population.length} agentes`;

      // Contar especies vivas
      const counts: Record<string, number> = {};
      population.forEach((a) => {
        counts[a.speciesId] = (counts[a.speciesId] || 0) + 1;
      });

      // Actualizar barra proporcional de población
      if (popBarStacked) {
        popBarStacked.innerHTML = '';
        SPECIES_CONFIG.forEach((sp) => {
          const c = counts[sp.id] || 0;
          if (c === 0) return;
          const pct = ((c / population.length) * 100).toFixed(1);
          const seg = document.createElement('div');
          seg.className = 'pop-seg';
          seg.style.width = `${pct}%`;
          seg.style.backgroundColor = sp.color;
          seg.title = `${sp.name}: ${c} agentes (${pct}%)`;
          popBarStacked.appendChild(seg);
        });
      }

      // Rejilla de tarjetas censales
      if (censusGrid) {
        censusGrid.innerHTML = '';
        SPECIES_CONFIG.forEach((sp) => {
          const c = counts[sp.id] || 0;
          const pct = ((c / population.length) * 100).toFixed(1);
          const card = document.createElement('div');
          card.className = `census-card ${c === 0 ? 'is-extinct' : ''}`;
          card.style.borderColor = sp.color;
          card.innerHTML = `
            <div class="c-avatar">${sp.avatar}</div>
            <div class="c-info">
              <span class="c-name" style="color: ${sp.color}">${sp.name}</span>
              <span class="c-count">${c} agentes (${pct}%)</span>
            </div>
            ${c === 0 ? '<span class="extinct-tag">EXTINTO</span>' : ''}
          `;
          censusGrid.appendChild(card);
        });
      }
    }

    function toggleAutoEvolve() {
      if (isAutoEvolving) {
        stopAutoEvolve();
        return;
      }
      isAutoEvolving = true;
      if (sbPlayText) sbPlayText.textContent = 'Pausar Simulación';
      if (btnSbPlay) btnSbPlay.classList.add('is-running');

      function loop() {
        if (!isAutoEvolving) return;
        runOneGeneration();
        autoEvolveTimer = window.setTimeout(loop, 400);
      }
      loop();
    }

    function stopAutoEvolve() {
      isAutoEvolving = false;
      if (autoEvolveTimer !== null) {
        clearTimeout(autoEvolveTimer);
        autoEvolveTimer = null;
      }
      if (sbPlayText) sbPlayText.textContent = 'Auto-Evolución';
      if (btnSbPlay) btnSbPlay.classList.remove('is-running');
    }

    // =========================================================================
    // EVENT LISTENERS
    // =========================================================================
    if (tabBtnAdventure) {
      tabBtnAdventure.addEventListener('click', () => {
        tabBtnAdventure.classList.add('is-active');
        tabBtnAdventure.setAttribute('aria-selected', 'true');
        tabBtnSandbox?.classList.remove('is-active');
        tabBtnSandbox?.setAttribute('aria-selected', 'false');

        const pillAdv = tabBtnAdventure.querySelector('.mhc-status-pill');
        if (pillAdv) {
          pillAdv.textContent = 'JUGANDO AHORA';
          pillAdv.className = 'mhc-status-pill is-current';
        }
        const pillSbx = tabBtnSandbox?.querySelector('.mhc-status-pill');
        if (pillSbx) {
          pillSbx.textContent = 'PROBAR TORNEO';
          pillSbx.className = 'mhc-status-pill is-alt';
        }

        if (viewAdventure) viewAdventure.style.display = 'block';
        if (viewSandbox) viewSandbox.style.display = 'none';
        stopAutoEvolve();
      });
    }

    if (tabBtnSandbox) {
      tabBtnSandbox.addEventListener('click', () => {
        tabBtnSandbox.classList.add('is-active');
        tabBtnSandbox.setAttribute('aria-selected', 'true');
        tabBtnAdventure?.classList.remove('is-active');
        tabBtnAdventure?.setAttribute('aria-selected', 'false');

        const pillAdv = tabBtnAdventure?.querySelector('.mhc-status-pill');
        if (pillAdv) {
          pillAdv.textContent = 'CAMBIAR A AVENTURA';
          pillAdv.className = 'mhc-status-pill is-alt';
        }
        const pillSbx = tabBtnSandbox.querySelector('.mhc-status-pill');
        if (pillSbx) {
          pillSbx.textContent = 'JUGANDO AHORA';
          pillSbx.className = 'mhc-status-pill is-current';
        }

        if (viewAdventure) viewAdventure.style.display = 'none';
        if (viewSandbox) viewSandbox.style.display = 'block';
        initSandbox();
      });
    }

    if (btnCooperate) btnCooperate.addEventListener('click', () => playDuelRound('C'));
    if (btnDefect) btnDefect.addEventListener('click', () => playDuelRound('D'));

    if (btnNextChapter) {
      btnNextChapter.addEventListener('click', () => {
        const nextIdx = (currentChapterIdx + 1) % CHARACTERS.length;
        loadChapter(nextIdx);
      });
    }

    if (btnRetryChapter) {
      btnRetryChapter.addEventListener('click', () => {
        loadChapter(currentChapterIdx);
      });
    }

    if (btnSbStep) btnSbStep.addEventListener('click', runOneGeneration);
    if (btnSbPlay) btnSbPlay.addEventListener('click', toggleAutoEvolve);
    if (btnSbReset) btnSbReset.addEventListener('click', initSandbox);

    if (noiseSlider) {
      noiseSlider.addEventListener('input', () => {
        noisePct = parseInt(noiseSlider.value || '0', 10);
        if (noiseVal) noiseVal.textContent = `${noisePct}%`;
      });
    }

    // Arrancar Capítulo 1 de la Aventura
    loadChapter(0);
  })();
</script>

