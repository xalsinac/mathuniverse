---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---

<BaseLayout
  title="El Dilema del Prisionero & Algoritmos | Math Universe"
  description="Aventura interactiva y simulador evolutivo del Dilema del Prisionero. Explora la Teoría de Juegos, equilibrios de Nash y el torneo de Robert Axelrod."
>
  <SiteHeader activePage="craft" statusText="08 · Math Gaming" ctaHref="/craft" ctaLabel="Catálogo Juegos" />

  <main class="dilemma-page" id="main-content">
    <!-- COCKPIT DEL JUEGO -->
    <section class="game-cockpit" id="escenario">
      <div class="cockpit-container">
        <!-- Barra Superior: Navegación, Título y Selector de Modo -->
        <header class="cockpit-header">
          <div class="header-left">
            <a href="/craft" class="back-pill" title="Volver a Math Gaming">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <span>Math Gaming</span>
            </a>
            <div class="header-titles">
              <h1 class="game-title">El Dilema del Prisionero</h1>
              <span class="badge-pill">Teoría de Juegos · Nash</span>
            </div>
          </div>
        </header>

        <!-- SELECTOR DE MODOS PRINCIPAL (GRAN VISIBILIDAD) -->
        <nav class="mode-selector-hub" aria-label="Seleccionar modalidad de juego" role="tablist">
          <button type="button" class="mode-hub-card is-active" id="tab-btn-adventure" role="tab" aria-selected="true">
            <div class="mhc-badge-row">
              <span class="mhc-mode-tag">MODO 1</span>
              <span class="mhc-status-pill is-current">JUGANDO AHORA</span>
            </div>
            <div class="mhc-body">
              <span class="mhc-icon" aria-hidden="true">🎭</span>
              <div class="mhc-details">
                <strong class="mhc-title">Aventura Interactiva (1 vs 1)</strong>
                <p class="mhc-desc">
                  Duelos narrativos por capítulos contra 6 arquetipos con diálogo reactivo tipo cómic, matriz de pagos y el nuevo rival misterioso.
                </p>
              </div>
            </div>
          </button>

          <button type="button" class="mode-hub-card" id="tab-btn-sandbox" role="tab" aria-selected="false">
            <div class="mhc-badge-row">
              <span class="mhc-mode-tag">MODO 2</span>
              <span class="mhc-status-pill is-alt">PROBAR TORNEO</span>
            </div>
            <div class="mhc-body">
              <span class="mhc-icon" aria-hidden="true">🧬</span>
              <div class="mhc-details">
                <strong class="mhc-title">Torneo Evolutivo de Axelrod</strong>
                <p class="mhc-desc">
                  Simulación de ecosistema con 120 agentes y generaciones. Experimenta con el ruido aleatorio y descubre por qué ganan los generosos.
                </p>
              </div>
            </div>
          </button>
        </nav>

        <!-- ================================================================= -->
        <!-- MODO 1: AVENTURA INTERACTIVA (DUELOS POR CAPÍTULOS DE PERSONAJES) -->
        <!-- ================================================================= -->
        <div class="game-mode-view" id="view-adventure">
          <!-- Barra de Progreso de Capítulos -->
          <div class="chapters-stepper">
            <span class="stepper-label">OPONENTES:</span>
            <div class="stepper-track" id="stepper-track">
              <!-- Se generan dinámicamente: 1. Cooperador, 2. Traidor, 3. Ojo por Ojo, 4. Rencoroso, 5. Detective, 6. Misterioso -->
            </div>
          </div>

          <!-- Escenario de Duelo Interactivo -->
          <div class="stage-arena" id="duel-arena">
            <!-- Canvas de Confetti para Final de Capítulo / Victoria -->
            <canvas id="fx-confetti-canvas" class="fx-confetti-canvas"></canvas>

            <!-- Cabecera del Oponente -->
            <div class="opponent-profile-card" id="opponent-card">
              <div class="opp-avatar-wrap">
                <span class="opp-avatar" id="opp-avatar">😇</span>
              </div>
              <div class="opp-info">
                <div class="opp-title-row">
                  <h2 class="opp-name" id="opp-name">El Cooperador Ingenuo</h2>
                  <span class="opp-badge" id="opp-badge">Capítulo 1 de 6 · Confianza Ciega</span>
                </div>
                <p class="opp-bio" id="opp-bio">
                  Siempre coopera contigo. Cree firmemente en la bondad humana y pondrá una moneda en cada ronda, sin importar si tú le correspondes o lo traicionas.
                </p>
              </div>
            </div>

            <!-- Bocadillo de Diálogo Dinámico del Personaje -->
            <div class="comic-speech-container">
              <div class="comic-speech-bubble" id="duel-dialogue-bubble">
                <span class="bubble-arrow" aria-hidden="true"></span>
                <div class="bubble-content" id="duel-dialogue">
                  "¡Hola! Yo siempre pongo mi moneda para que ambos ganemos. ¡Confío en que tú harás lo mismo!"
                </div>
              </div>
            </div>

            <!-- Zona de Juego Central: Marcador y Matriz en Vivo -->
            <div class="duel-play-cluster">
              <!-- Puntuación Jugador vs Oponente -->
              <div class="score-dock">
                <div class="score-card player-score-card">
                  <span class="sc-label">TUS MONEDAS</span>
                  <span class="sc-val" id="player-score">0</span>
                  <span class="sc-tag">TÚ (Agente)</span>
                </div>

                <div class="versus-tag">VS</div>

                <div class="score-card opp-score-card">
                  <span class="sc-label">MONEDAS OPONENTE</span>
                  <span class="sc-val" id="opp-score">0</span>
                  <span class="sc-tag" id="opp-score-tag">COOPERADOR</span>
                </div>
              </div>

              <!-- Matriz de Pagos Activa (Resalta el resultado en cada ronda) -->
              <div class="payoff-matrix-compact" aria-label="Matriz de Pagos">
                <div class="pm-corner">TÚ \ RIVAL</div>
                <div class="pm-col-head">RIVAL COOPERA</div>
                <div class="pm-col-head">RIVAL DEFRAUDA</div>

                <div class="pm-row-head">COOPERAS</div>
                <div class="pm-cell" id="pm-cell-cc">
                  <span class="pm-title">RECOMPENSA MUTUA</span>
                  <span class="pm-vals">+2 / +2</span>
                </div>
                <div class="pm-cell" id="pm-cell-cd">
                  <span class="pm-title">TIMO DEL INGENUO</span>
                  <span class="pm-vals">-1 / +3</span>
                </div>

                <div class="pm-row-head">DEFRAUDAS</div>
                <div class="pm-cell" id="pm-cell-dc">
                  <span class="pm-title">TENTACIÓN GANADORA</span>
                  <span class="pm-vals">+3 / -1</span>
                </div>
                <div class="pm-cell" id="pm-cell-dd">
                  <span class="pm-title">CASTIGO MUTUO</span>
                  <span class="pm-vals">0 / 0</span>
                </div>
              </div>
            </div>

            <!-- Historial de Rondas Recientes (Tiras de Decisiones) -->
            <div class="rounds-history-strip">
              <span class="rh-label">HISTORIAL DE RONDAS (<span id="rounds-current">0</span> / <span id="rounds-total">5</span>):</span>
              <div class="rh-pills" id="rh-pills">
                <!-- Se inyectan fichas circulares C (verde) o T (rojo) -->
              </div>
            </div>

            <!-- Botonera de Acción del Jugador -->
            <div class="duel-actions-bar" id="duel-actions-bar">
              <button type="button" class="btn-action-duel btn-cooperate" id="btn-cooperate">
                <div class="btn-duel-icon">🤝</div>
                <div class="btn-duel-text">
                  <span class="bdt-main">COOPERAR</span>
                  <span class="bdt-sub">Pones 1 moneda (el rival recibe 3)</span>
                </div>
              </button>

              <button type="button" class="btn-action-duel btn-defect" id="btn-defect">
                <div class="btn-duel-icon">🗡️</div>
                <div class="btn-duel-text">
                  <span class="bdt-main">DEFRAUDAR</span>
                  <span class="bdt-sub">No pones nada (te quedas lo que dé el rival)</span>
                </div>
              </button>
            </div>

            <!-- Panel de Conclusión de Capítulo (Oculto durante el duelo) -->
            <div class="chapter-recap-panel" id="chapter-recap" style="display: none;">
              <h3 class="recap-title" id="recap-title">¡Capítulo Finalizado!</h3>
              <p class="recap-desc" id="recap-desc"></p>
              <div class="recap-stats" id="recap-stats"></div>
              <div class="recap-actions">
                <button type="button" class="btn-recap-next" id="btn-next-chapter">
                  <span>Siguiente Oponente</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
                <button type="button" class="btn-recap-retry" id="btn-retry-chapter">
                  <span>Repetir Capítulo</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- ================================================================= -->
        <!-- MODO 2: SIMULADOR EVOLUTIVO DE ROBERT AXELROD (ECOSISTEMA) -->
        <!-- ================================================================= -->
        <div class="game-mode-view" id="view-sandbox" style="display: none;">
          <!-- BANNER DIDÁCTICO DEL ECOSISTEMA: POR QUÉ GANAN LOS GENEROSOS -->
          <div class="sandbox-insight-banner">
            <div class="sib-icon" aria-hidden="true">💡</div>
            <div class="sib-body">
              <strong class="sib-title">¿Por qué se extinguen los Traidores y ganan los Generosos?</strong>
              <p class="sib-p">
                Al inicio, los <em>Traidores</em> devoran a los <em>Cooperadores Ingenuos</em> y su población se dispara. Pero cuando los ingenuos se extinguen, los traidores solo compiten entre sí y obtienen <strong>0 puntos</strong> (mueren de inanición evolutiva). En cambio, los <strong>Ojo por Ojo y los Generosos</strong> cooperan entre sí acumulando miles de puntos (+2 en cada turno). Y si activas el <strong>Ruido (Glitch)</strong>, los <strong>Generosos</strong> son los únicos que sobreviven porque su perdón ocasional evita quedar atrapados en guerras de venganza infinita.
              </p>
            </div>
          </div>

          <div class="sandbox-controls-bar">
            <div class="sandbox-stat">
              <span class="sb-label">GENERACIÓN</span>
              <span class="sb-val" id="sb-gen-count">0</span>
            </div>
            <div class="sandbox-stat">
              <span class="sb-label">POBLACIÓN TOTAL</span>
              <span class="sb-val" id="sb-pop-count">100 agentes</span>
            </div>
            <div class="sandbox-stat">
              <span class="sb-label">NIVEL DE RUIDO (GLITCH)</span>
              <div class="noise-control">
                <input type="range" id="noise-slider" min="0" max="15" value="0" />
                <span class="noise-val" id="noise-val">0%</span>
              </div>
            </div>

            <div class="sandbox-actions">
              <button type="button" class="btn-sb-action btn-sb-step" id="btn-sb-step">
                <span>+1 Generación</span>
              </button>
              <button type="button" class="btn-sb-action btn-sb-play is-accent" id="btn-sb-play">
                <span id="sb-play-text">Auto-Evolución</span>
              </button>
              <button type="button" class="btn-sb-action btn-sb-reset" id="btn-sb-reset">
                <span>Reiniciar</span>
              </button>
            </div>
          </div>

          <!-- Arena del Ecosistema: Gráfico de Población y Desglose -->
          <div class="stage-arena sandbox-arena">
            <!-- Barra Proporcional de la Población Viva -->
            <div class="pop-bar-stacked" id="pop-bar-stacked">
              <!-- Franjas proporcionales coloreadas dinámicamente -->
            </div>

            <!-- Rejilla de Estrategias y Censo -->
            <div class="census-grid" id="census-grid">
              <!-- Tarjetas de cada una de las 6 especies estratégicas -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DIDÁCTICA Y MATEMÁTICA: ROBERT AXELROD & TEORÍA DE JUEGOS -->
    <section class="dilemma-theory-section" id="teoria">
      <div class="theory-container">
        <header class="theory-header">
          <span class="section-tag">TEORÍA DE JUEGOS & MATEMÁTICAS APLICADAS</span>
          <h2 class="theory-title">La Gran Paradoja Resuelta: ¿Cuál es Realmente la Mejor Estrategia?</h2>
          <p class="theory-subtitle">
            El Dilema del Prisionero esconde una aparente contradicción que desconcierta a estudiantes y economistas: ¿por qué los libros de texto afirman que traicionar es la respuesta racional, pero en las simulaciones evolutivas los traidores se extinguen y solo triunfan los cooperadores generosos?
          </p>
        </header>

        <!-- GRAN BANNER COMPARATIVO: 1 TURNO VS ENCUENTROS REPETIDOS -->
        <div class="theory-confrontation-banner">
          <div class="tcb-header">
            <span class="tcb-pill">LA CLAVE MATEMÁTICA</span>
            <h3 class="tcb-title">El Factor Decisivo: La "Sombra del Futuro" (Partida Única vs Partida Iterada)</h3>
          </div>

          <div class="tcb-columns">
            <!-- Escenario A: 1 Solo Turno -->
            <div class="tcb-col is-single-shot">
              <div class="tcb-col-header">
                <span class="tcb-icon" aria-hidden="true">⚡</span>
                <div>
                  <h4 class="tcb-col-title">1. En un Encuentro Único (1 Solo Turno)</h4>
                  <span class="tcb-subtitle">Interacción anónima sin pasado ni futuro</span>
                </div>
              </div>
              <div class="tcb-verdict is-defect">Ganador Matemático: DEFRAUDAR / TRAICIONAR</div>
              <p class="tcb-desc">
                Si te encuentras con un rival al que <strong>nunca volverás a ver</strong> y no hay leyes, cámaras ni reputación que te juzguen, la fría lógica matemática individual te empuja a traicionar (el <strong>Equilibrio de Nash</strong>):
              </p>
              <ul class="tcb-list">
                <li>Si tu rival coopera: ganas <strong>+3 monedas</strong> defraudando en vez de +2.</li>
                <li>Si tu rival defrauda: evitas perder <strong>-1 moneda</strong> defraudando tú también (0 puntos).</li>
              </ul>
              <div class="tcb-callout is-warning">
                En 1 solo turno, cooperar es de ingenuos porque no existe un "mañana" para castigar la traición ni para cultivar confianza mutua.
              </div>
            </div>

            <!-- Escenario B: Interacciones Repetidas -->
            <div class="tcb-col is-iterated">
              <div class="tcb-col-header">
                <span class="tcb-icon" aria-hidden="true">🌱</span>
                <div>
                  <h4 class="tcb-col-title">2. En Encuentros Repetidos (La Vida Real y el Torneo)</h4>
                  <span class="tcb-subtitle">La "Sombra del Futuro" y Selección Natural</span>
                </div>
              </div>
              <div class="tcb-verdict is-coop">Ganador Evolutivo: COOPERACIÓN RECÍPROCA (Generoso)</div>
              <p class="tcb-desc">
                ¡Las matemáticas se invierten por completo cuando la relación se repite indefinidamente a lo largo del tiempo!
              </p>
              <ul class="tcb-list">
                <li><strong>El flujo continuo de premios aplasta a la traición</strong>: Dos agentes amables ganan <em>+2 monedas en cada turno</em>, acumulando cientos de puntos a lo largo del tiempo.</li>
                <li><strong>La trampa de la extinción de los traidores</strong>: Al principio devoran a los ingenuos. Pero cuando los ingenuos mueren, los traidores solo compiten entre sí y empatan en <strong>0 monedas</strong> (inanición biológica).</li>
                <li><strong>El triunfo de los Generosos ante el Ruido</strong>: Con fallos casuales (ruido del 1% al 5%), el Ojo por Ojo tradicional colapsa en venganzas ciegas; el <em>Ojo por Ojo Generoso</em> perdona estocásticamente y restaura la prosperidad.</li>
              </ul>
              <div class="tcb-callout is-success">
                En el tiempo repetido, la cooperación recíproca y el perdón no son ingenuidad moral: son la estrategia matemática más rentable del universo.
              </div>
            </div>
          </div>
        </div>

        <div class="theory-grid">
          <!-- Tarjeta 1: La Condición Matemática de la Matriz -->
          <article class="theory-card">
            <div class="tcard-icon">⚖️</div>
            <h3 class="tcard-title">La Condición Fundamental del Dilema</h3>
            <p class="tcard-p">
              Sean los pagos: <strong>T</strong> (Tentación por defraudar), <strong>R</strong> (Recompensa por cooperación mutua), <strong>P</strong> (Castigo por deserción mutua) y <strong>S</strong> (El timo del ingenuo).
            </p>
            <div class="math-callout">
              <span class="math-formula"><em>T</em> &gt; <em>R</em> &gt; <em>P</em> &gt; <em>S</em> &emsp;y&emsp; 2<em>R</em> &gt; <em>T</em> + <em>S</em></span>
            </div>
            <p class="tcard-foot">
              La primera desigualdad genera la tentación egoísta. La segunda garantiza que alternar traiciones mutuas no rinda más que cooperar permanentemente.
            </p>
          </article>

          <!-- Tarjeta 2: El Equilibrio de Nash -->
          <article class="theory-card">
            <div class="tcard-icon">🧠</div>
            <h3 class="tcard-title">El Equilibrio de Nash en 1 Turno</h3>
            <p class="tcard-p">
              En una interacción aislada sin memoria ni consecuencias:
            </p>
            <ul class="theory-bullets">
              <li>Si tu rival coopera, ganarás más defraudando (<em>T</em> &gt; <em>R</em>).</li>
              <li>Si tu rival defrauda, evitarás el timo defraudando tú también (<em>P</em> &gt; <em>S</em>).</li>
            </ul>
            <p class="tcard-foot">
              En ambos casos, traicionar es la mejor respuesta unilateral. El estado (Defraudar, Defraudar) es el <strong>Equilibrio de Nash</strong>, a pesar de que el óptimo de Pareto es (Cooperar, Cooperar).
            </p>
          </article>

          <!-- Tarjeta 3: La Dinámica de Poblaciones -->
          <article class="theory-card">
            <div class="tcard-icon">📉</div>
            <h3 class="tcard-title">Por qué se Extinguen los Traidores</h3>
            <p class="tcard-p">
              En el simulador evolutivo, la dinámica sigue tres fases matemáticas inevitables:
            </p>
            <ol class="theory-steps">
              <li><strong>Fase 1 (Auge inicial del Traidor)</strong>: Los tramposos devoran a los cooperadores ingenuos y crecen deprisa.</li>
              <li><strong>Fase 2 (Colapso de Presas)</strong>: Los ingenuos mueren. Los traidores solo se topan entre sí o con Tit-for-Tat, recibiendo 0 puntos.</li>
              <li><strong>Fase 3 (Dominación Recíproca)</strong>: Las estrategias que cooperan entre sí acumulan cientos de monedas y repueblan el sistema.</li>
            </ol>
          </article>

          <!-- Tarjeta 4: La Sombra del Futuro y Robert Axelrod -->
          <article class="theory-card">
            <div class="tcard-icon">🏆</div>
            <h3 class="tcard-title">El Torneo de Robert Axelrod (1984)</h3>
            <p class="tcard-p">
              Axelrod invitó a matemáticos, biólogos y economistas de todo el mundo a programar algoritmos para un torneo iterado. Contra pronóstico, la estrategia ganadora fue la más simple: <strong>Ojo por Ojo (Tit-for-Tat)</strong> de Anatol Rapoport, de solo 4 líneas de código.
            </p>
            <p class="tcard-foot">
              Cuando el futuro es incierto o infinito (factor de descuento <em>δ</em> ≈ 1), el valor de mantener la confianza supera con creces la ganancia puntual de traicionar.
            </p>
          </article>

          <!-- Tarjeta 5: Los 4 Rasgos de las Estrategias Ganadoras -->
          <article class="theory-card">
            <div class="tcard-icon">💡</div>
            <h3 class="tcard-title">Los 4 Mandamientos del Éxito Algorítmico</h3>
            <ol class="theory-steps">
              <li><strong>Ser amable</strong>: Nunca ser el primero en traicionar.</li>
              <li><strong>Ser represivo</strong>: Responder de inmediato a la deserción ajena para evitar abusos.</li>
              <li><strong>Ser perdonador</strong>: Volver a cooperar de inmediato en cuanto el rival se rectifica.</li>
              <li><strong>No ser envidioso</strong>: Buscar maximizar los puntos propios, no preocuparse por superar al rival en cada turno.</li>
            </ol>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  (() => {
    // =========================================================================
    // TIPOS Y PERSONAJES DE LA AVENTURA
    // =========================================================================
    type Action = 'C' | 'D'; // C = Cooperar, D = Defraudar

    interface Character {
      id: string;
      name: string;
      avatar: string;
      badge: string;
      bio: string;
      introDialogue: string;
      roundsCount: number;
      getAction: (historyUser: Action[], historyOpp: Action[]) => Action;
      getDialogueReaction: (userAct: Action, oppAct: Action, roundIdx: number) => string;
      getRecapText: (userScore: number, oppScore: number) => { title: string; desc: string };
    }

    const CHARACTERS: Character[] = [
      // 1. Cooperador Ingenuo
      {
        id: 'cooperator',
        name: 'El Cooperador Ingenuo',
        avatar: '😇',
        badge: 'Capítulo 1 de 6 · Confianza Ciega',
        bio: 'Siempre coopera. Cree que todos los humanos son buenos y pondrá su moneda en cada ronda, sin importar si lo explotas.',
        introDialogue: '¡Hola! Yo siempre pongo mi moneda para que ambos ganemos. ¡Confío en que tú harás lo mismo!',
        roundsCount: 5,
        getAction: () => 'C',
        getDialogueReaction: (userAct) => {
          return userAct === 'C'
            ? '¡Qué alegría! Cooperamos juntos y los dos sumamos 2 monedas. ¡El mundo es maravilloso!'
            : '¡Vaya! Te has llevado 3 monedas y yo he perdido 1... Bueno, seguro que fue un error sin querer. ¡Sigo confiando en ti!';
        },
        getRecapText: (userScore, oppScore) => {
          if (userScore > oppScore) {
            return {
              title: 'Explotación del Ingenuo',
              desc: 'Has ganado más monedas defraudando a quien siempre coopera. Pero en la vida real, si todos fueran tramposos, los cooperadores se extinguirían y nadie ganaría nada.'
            };
          }
          return {
            title: 'Cooperación Pura',
            desc: 'Ambos habéis cooperado en cada ronda. El beneficio mutuo ha sido máximo y armonioso.'
          };
        }
      },

      // 2. Traidor Implacable
      {
        id: 'cheater',
        name: 'El Traidor Implacable',
        avatar: '😈',
        badge: 'Capítulo 2 de 6 · Egoísmo Racional',
        bio: 'Nunca coopera. Sabe que defraudar es la estrategia dominante en un juego sin memoria y se quedará con todo lo que pueda.',
        introDialogue: 'La confianza es para los débiles. Yo nunca regalo una sola moneda. ¡A ver qué haces tú!',
        roundsCount: 5,
        getAction: () => 'D',
        getDialogueReaction: (userAct) => {
          return userAct === 'C'
            ? '¡Jajaja! ¡Pardillo! Tú pones la moneda y yo me quedo con 3 monedas netas. ¡Gracias por el regalo!'
            : 'Empate a cero. Ninguno de los dos gana nada. Es la frialdad del equilibrio de Nash en estado puro.';
        },
        getRecapText: (userScore, oppScore) => {
          if (userScore === oppScore) {
            return {
              title: 'Bloqueo Mutuo',
