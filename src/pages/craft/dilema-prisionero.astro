    function buildStepperUI() {
      if (!stepperTrack) return;
      stepperTrack.innerHTML = '';
      CHARACTERS.forEach((char, idx) => {
        const step = document.createElement('button');
        step.type = 'button';
        step.className = `step-node ${idx === currentChapterIdx ? 'is-active' : ''} ${idx < currentChapterIdx ? 'is-done' : ''}`;
        step.title = `${char.name} (${char.badge})`;
        step.innerHTML = `<span class="step-num">${idx + 1}</span><span class="step-avatar">${char.avatar}</span>`;
        step.addEventListener('click', () => loadChapter(idx));
        stepperTrack.appendChild(step);
      });
    }

    function loadChapter(idx: number) {
      currentChapterIdx = idx;
      roundIndex = 0;
      userScore = 0;
      oppScore = 0;
      userHistory = [];
      oppHistory = [];
      isRoundLocked = false;

      const char = CHARACTERS[idx];
      if (oppAvatar) oppAvatar.textContent = char.avatar;
      if (oppName) oppName.textContent = char.name;
      if (oppBadge) oppBadge.textContent = char.badge;
      if (oppBio) oppBio.textContent = char.bio;
      if (duelDialogue) duelDialogue.textContent = `"${char.introDialogue}"`;

      if (playerScoreEl) playerScoreEl.textContent = '0';
      if (oppScoreEl) oppScoreEl.textContent = '0';
      if (oppScoreTag) oppScoreTag.textContent = char.name.split(' ')[1] || 'RIVAL';

      if (roundsCurrent) roundsCurrent.textContent = '0';
      if (roundsTotal) roundsTotal.textContent = String(char.roundsCount);

      if (rhPills) rhPills.innerHTML = '';
      clearMatrixHighlights();

      if (duelActionsBar) duelActionsBar.style.display = 'flex';
      if (chapterRecap) chapterRecap.style.display = 'none';

      buildStepperUI();
    }

    function clearMatrixHighlights() {
      Object.values(pmCells).forEach((cell) => cell?.classList.remove('is-active-quadrant'));
    }

    function playDuelRound(userAction: Action) {
      if (isRoundLocked) return;
      const char = CHARACTERS[currentChapterIdx];
      if (roundIndex >= char.roundsCount) return;

      isRoundLocked = true;
      const oppAction = char.getAction(userHistory, oppHistory);

      userHistory.push(userAction);
      oppHistory.push(oppAction);

      // Sonido de la acción
      if (userAction === 'C') playCoopSound();
      else playDefectSound();

      // Cálculo de pagos
      let userDelta = 0;
      let oppDelta = 0;
      let activeCellKey: 'cc' | 'cd' | 'dc' | 'dd' = 'cc';

      if (userAction === 'C' && oppAction === 'C') {
        userDelta = 2;
        oppDelta = 2;
        activeCellKey = 'cc';
      } else if (userAction === 'C' && oppAction === 'D') {
        userDelta = -1;
        oppDelta = 3;
        activeCellKey = 'cd';
      } else if (userAction === 'D' && oppAction === 'C') {
        userDelta = 3;
        oppDelta = -1;
        activeCellKey = 'dc';
      } else {
        userDelta = 0;
        oppDelta = 0;
        activeCellKey = 'dd';
      }

      userScore += userDelta;
      oppScore += oppDelta;

      // Actualizar UI
      clearMatrixHighlights();
      pmCells[activeCellKey]?.classList.add('is-active-quadrant');

      if (playerScoreEl) playerScoreEl.textContent = String(userScore);
      if (oppScoreEl) oppScoreEl.textContent = String(oppScore);

      // Reacción de diálogo
      const reaction = char.getDialogueReaction(userAction, oppAction, roundIndex);
      if (duelDialogue) duelDialogue.innerHTML = `"${reaction}"`;

      // Añadir píldora al historial visual
      if (rhPills) {
        const pill = document.createElement('div');
        pill.className = `round-pill act-user-${userAction.toLowerCase()} act-opp-${oppAction.toLowerCase()}`;
        pill.innerHTML = `
          <span class="rp-round">R${roundIndex + 1}</span>
          <span class="rp-badge is-u">${userAction === 'C' ? '🤝 Cooperaste' : '🗡️ Traicionaste'}</span>
          <span class="rp-vs">vs</span>
          <span class="rp-badge is-o">${oppAction === 'C' ? '🤝 Cooperó' : '🗡️ Traicionó'}</span>
          <span class="rp-pts">${userDelta >= 0 ? `+${userDelta}` : userDelta} pts</span>
        `;
        rhPills.appendChild(pill);
      }

      roundIndex++;
      if (roundsCurrent) roundsCurrent.textContent = String(roundIndex);

      // Comprobar fin de capítulo
      if (roundIndex >= char.roundsCount) {
        window.setTimeout(() => {
          finishChapter(char);
        }, 900);
      } else {
        window.setTimeout(() => {
          isRoundLocked = false;
        }, 350);
      }
    }

    function finishChapter(char: Character) {
      if (duelActionsBar) duelActionsBar.style.display = 'none';
      const recap = char.getRecapText(userScore, oppScore);

      if (recapTitle) recapTitle.textContent = recap.title;
      if (recapDesc) recapDesc.textContent = recap.desc;

      playWinFanfare();
      launchConfetti();

      if (chapterRecap) chapterRecap.style.display = 'flex';
      buildStepperUI();
    }

