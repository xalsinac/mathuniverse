---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---

<BaseLayout
  title="Simulador Orbital Kepleriano & Gravitación N-Cuerpos | Math Universe"
  description="Laboratorio interactivo de mecánica celeste y leyes de Kepler. Lanza planetas, observa órbitas elípticas, comprueba la 2.ª ley de las áreas y realiza transferencias de Hohmann."
>
  <SiteHeader activePage="craft" statusText="08 · Math Gaming" ctaHref="/craft" ctaLabel="Catálogo Juegos" />

  <main class="kepler-page" id="main-content">
    <!-- COCKPIT DEL SIMULADOR -->
    <section class="game-cockpit" id="escenario">
      <div class="cockpit-container">
        <!-- Cabecera de Navegación y Título -->
        <header class="cockpit-header">
          <div class="header-left">
            <a href="/craft" class="back-pill" title="Volver a Math Gaming">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <span>Math Gaming</span>
            </a>
            <div class="header-titles">
              <h1 class="game-title">Simulador Orbital Kepleriano</h1>
              <span class="badge-pill">Física & Gravitación · Kepler</span>
            </div>
          </div>
        </header>

        <!-- SELECTOR DE MODOS PRINCIPAL (3 MODOS: TUTORIAL / SANDBOX / MISIONES) -->
        <nav class="mode-selector-hub" aria-label="Seleccionar modalidad de juego" role="tablist">
          <button type="button" class="mode-hub-card" id="tab-btn-tutorial" role="tab" aria-selected="false">
            <div class="mhc-badge-row">
              <span class="mhc-mode-tag">MODO 1</span>
              <span class="mhc-status-pill is-alt">PRINCIPIANTE</span>
            </div>
            <div class="mhc-body">
              <span class="mhc-icon" aria-hidden="true">🎓</span>
              <div class="mhc-details">
                <strong class="mhc-title">Tutorial & Modo Principiante</strong>
                <p class="mhc-desc">
                  Guía paso a paso: comprende el pozo de gravedad, los vectores de velocidad y fuerza, y por qué las áreas de Kepler son iguales.
                </p>
              </div>
            </div>
          </button>

          <button type="button" class="mode-hub-card is-active" id="tab-btn-sandbox" role="tab" aria-selected="true">
            <div class="mhc-badge-row">
              <span class="mhc-mode-tag">MODO 2</span>
              <span class="mhc-status-pill is-current">ACTIVO</span>
            </div>
            <div class="mhc-body">
              <span class="mhc-icon" aria-hidden="true">🪐</span>
              <div class="mhc-details">
                <strong class="mhc-title">Laboratorio Libre (Sandbox)</strong>
                <p class="mhc-desc">
                  Lanza planetas y satélites con click y arrastre. Activa el pozo gravitatorio, las órbitas guía y la comprobación de la 2.ª ley.
                </p>
              </div>
            </div>
          </button>

          <button type="button" class="mode-hub-card" id="tab-btn-missions" role="tab" aria-selected="false">
            <div class="mhc-badge-row">
              <span class="mhc-mode-tag">MODO 3</span>
              <span class="mhc-status-pill is-alt">DESAFÍOS</span>
            </div>
            <div class="mhc-body">
              <span class="mhc-icon" aria-hidden="true">🚀</span>
              <div class="mhc-details">
                <strong class="mhc-title">Misiones Orbitales Guiadas</strong>
                <p class="mhc-desc">
                  Desafíos astronáuticos de cálculo: circularizar una órbita, inyectar impulso para Hohmann o ejecutar un tirachinas gravitatorio.
                </p>
              </div>
            </div>
          </button>
        </nav>

        <!-- ================================================================= -->
        <!-- ZONA DE ESCENARIO Y CANVAS INTERACTIVO -->
        <!-- ================================================================= -->
        <div class="stage-orbital-arena" id="arena-container">
          <!-- Canvas de simulación física 60fps -->
          <canvas id="kepler-canvas" class="kepler-canvas"></canvas>

          <!-- Overlay HUD de Telemetría Superior Izquierda -->
          <div class="hud-telemetry" id="hud-telemetry">
            <div class="hud-item">
              <span class="hud-label">CUERPOS VIVOS</span>
              <span class="hud-val" id="hud-bodies-count">2</span>
            </div>
            <div class="hud-item">
              <span class="hud-label">VELOCIDAD (v)</span>
              <span class="hud-val is-cyan" id="hud-vel">-- km/s</span>
            </div>
            <div class="hud-item">
              <span class="hud-label">RADIO (r)</span>
              <span class="hud-val" id="hud-radius">-- AU</span>
            </div>
            <div class="hud-item">
              <span class="hud-label">EXCENTRICIDAD (e)</span>
              <span class="hud-val is-gold" id="hud-ecc">--</span>
            </div>
            <div class="hud-item">
              <span class="hud-label">TIPO DE CÓNICA</span>
              <span class="hud-conic-pill" id="hud-conic">Elíptica (e &lt; 1)</span>
            </div>
          </div>

          <!-- Overlay Didáctico: Comprobador 2.ª Ley de Kepler -->
          <div class="hud-kepler2-overlay" id="hud-kepler2-overlay" style="display: none;">
            <div class="k2-badge">2.ª LEY DE KEPLER: LEY DE LAS ÁREAS</div>
            <div class="k2-data-row">
              <div class="k2-metric">
                <span class="k2-lbl">Área Sector Actual:</span>
                <span class="k2-val" id="k2-current-area">-- UA²</span>
              </div>
              <div class="k2-metric">
                <span class="k2-lbl">Tiempo Transcurrido (Δt):</span>
                <span class="k2-val" id="k2-current-dt">-- días</span>
              </div>
              <div class="k2-metric">
                <span class="k2-lbl">Tasa Areal (dA/dt):</span>
                <span class="k2-val is-green" id="k2-areal-rate">CONSTANTE</span>
              </div>
            </div>
            <p class="k2-note">
              Los sectores triangulares coloreados demuestran que cerca del periastro (rápido) y en el apoastro (lento), las superficies barridas en tiempos iguales son idénticas.
            </p>
            <div class="k2-actions-row">
              <button type="button" class="btn-k2-clear" id="btn-k2-clear">Borrar Áreas Pintadas</button>
            </div>
          </div>

          <!-- OVERLAY DE TUTORIAL GUIADO / MODO PRINCIPIANTE -->
          <div class="hud-tutorial-dock" id="hud-tutorial-dock" style="display: none;">
            <div class="tutorial-header-bar">
              <span class="tut-step-tag" id="tut-step-tag">PASO 1 DE 5: EL POZO GRAVITATORIO</span>
              <button type="button" class="tut-close-btn" id="btn-tut-close" title="Salir del tutorial">✕</button>
            </div>
            <h3 class="tut-title" id="tut-title">La Curvatura del Espacio y el Sol</h3>
            <p class="tut-body" id="tut-body">
              En el centro se encuentra el <strong>Sol</strong>. Su gran masa no tira con una cuerda mágica: <strong>curva y hunde la malla del espacio circundante</strong>, creando un pozo gravitatorio (observa cómo las líneas de la cuadrícula se hunden hacia el centro). Cuanto más te acercas, más empinada es la pendiente y con más fuerza caes.
            </p>
            <div class="tut-callout" id="tut-callout">
              💡 <em>Principio Físico:</em> La materia le dice al espacio cómo curvarse, y el espacio curvado le dice a la materia cómo moverse (Albert Einstein).
            </div>
            <div class="tut-nav-row">
              <button type="button" class="btn-tut-nav is-prev" id="btn-tut-prev" disabled>Anterior</button>
              <div class="tut-stepper-dots" id="tut-stepper-dots">
                <span class="tut-dot is-active"></span>
                <span class="tut-dot"></span>
                <span class="tut-dot"></span>
                <span class="tut-dot"></span>
                <span class="tut-dot"></span>
              </div>
              <button type="button" class="btn-tut-nav is-next" id="btn-tut-next">Siguiente: Los Vectores →</button>
            </div>
          </div>

          <!-- Misiones HUD Overlay (Sólo activo en Modo 3) -->
          <div class="hud-mission-dock" id="hud-mission-dock" style="display: none;">
            <div class="mission-header-bar">
              <div class="mission-title-group">
                <span class="mission-step-tag" id="mission-step-tag">MISIÓN 1 DE 4</span>
                <h2 class="mission-title" id="mission-title">Circularización Newtoniana</h2>
              </div>
              <div class="mission-status-badge" id="mission-status-badge">EN CURSO</div>
            </div>
            <p class="mission-objective" id="mission-objective">
              Ajusta la velocidad de inyección orbital con el vector para que la excentricidad sea menor a 0.05 (órbita casi circular perfecta: v ≈ √(GM/r)).
            </p>
            <div class="mission-progress-bar">
              <div class="mission-progress-fill" id="mission-progress-fill" style="width: 0%;"></div>
            </div>
            <div class="mission-actions-row">
              <button type="button" class="btn-mission-reset" id="btn-mission-retry">Reiniciar Misión</button>
              <button type="button" class="btn-mission-next" id="btn-mission-next" disabled>Siguiente Misión</button>
            </div>
          </div>

          <!-- Guía Flotante de Controles en Canvas -->
          <div class="canvas-help-tip" id="canvas-help-tip">
            <span>🖱️ <strong>Click + Arrastrar</strong> en el espacio para lanzar un cuerpo con vector de velocidad.</span>
          </div>

          <!-- Controles de Navegación Rápida sobre Canvas (Zoom y Centrado) -->
          <div class="canvas-floating-tools">
            <button type="button" class="tool-btn" id="btn-zoom-in" title="Acercar (+)">+</button>
            <button type="button" class="tool-btn" id="btn-zoom-out" title="Alejar (-)">−</button>
            <button type="button" class="tool-btn" id="btn-recenter" title="Centrar Estrella">🎯</button>
          </div>
        </div>

        <!-- ================================================================= -->
        <!-- BARRA DE CONTROLES INFERIOR Y PRESETS -->
        <!-- ================================================================= -->
        <div class="orbital-dashboard">
          <!-- Fila 1: Presets rápidos de 1 clic -->
          <div class="presets-shelf" id="presets-shelf">
            <span class="shelf-label">SISTEMAS PRECONFIGURADOS:</span>
            <div class="presets-buttons">
              <button type="button" class="btn-preset is-active" data-preset="solar-inner">
                <span>☀️ Sistema Solar Interior</span>
              </button>
              <button type="button" class="btn-preset" data-preset="kepler-pure">
                <span>📐 Órbita Elíptica Pura (Kepler)</span>
              </button>
              <button type="button" class="btn-preset" data-preset="slingshot">
                <span>🚀 Asistencia Gravitatoria (Slingshot)</span>
              </button>
              <button type="button" class="btn-preset" data-preset="figure-eight">
                <span>♾️ 3 Cuerpos en Ocho (Chenciner)</span>
              </button>
              <button type="button" class="btn-preset" data-preset="binary-stars">
                <span>♊ Sistema Binario</span>
              </button>
              <button type="button" class="btn-preset is-reset-btn" id="btn-reset-preset" title="Reiniciar el escenario actual">
                <span>🔄 Reiniciar</span>
              </button>
            </div>
          </div>

          <!-- Fila 2: Parámetros del Nuevo Cuerpo & Interruptores Visuales -->
          <div class="controls-grid">
            <!-- Selector de Masa / Tipo de Cuerpo a Lanzar -->
            <div class="ctrl-card">
              <span class="ctrl-card-title">CUERPO A LANZAR:</span>
              <div class="spawn-type-selector" id="spawn-type-selector">
                <button type="button" class="btn-spawn-type" data-type="probe">
                  <span class="type-dot is-probe"></span>
                  <span>Sonda (Sin Masa)</span>
                </button>
                <button type="button" class="btn-spawn-type is-active" data-type="planet">
                  <span class="type-dot is-planet"></span>
                  <span>Planeta</span>
                </button>
                <button type="button" class="btn-spawn-type" data-type="giant">
                  <span class="type-dot is-giant"></span>
                  <span>Gigante Gaseoso</span>
                </button>
                <button type="button" class="btn-spawn-type" data-type="star">
                  <span class="type-dot is-star"></span>
                  <span>Estrella Masiva</span>
                </button>
              </div>
            </div>

            <!-- Interruptores Didácticos y Vectores -->
            <div class="ctrl-card">
              <span class="ctrl-card-title">CAPAS DIDÁCTICAS:</span>
              <div class="toggles-cluster">
                <label class="toggle-chip">
                  <input type="checkbox" id="chk-gravity-well" checked />
                  <span class="chip-box"></span>
                  <span>Pozo de Gravedad</span>
                </label>
                <label class="toggle-chip">
                  <input type="checkbox" id="chk-orbit-guides" checked />
                  <span class="chip-box"></span>
                  <span>Órbitas en Pantalla</span>
                </label>
                <label class="toggle-chip">
                  <input type="checkbox" id="chk-kepler2" />
                  <span class="chip-box"></span>
                  <span>2.ª Ley (Áreas dA/dt)</span>
                </label>
                <label class="toggle-chip">
                  <input type="checkbox" id="chk-vel-vector" checked />
                  <span class="chip-box"></span>
                  <span>Vector Velocidad (v)</span>
                </label>
                <label class="toggle-chip">
                  <input type="checkbox" id="chk-grav-vector" checked />
                  <span class="chip-box"></span>
                  <span>Vector Gravedad (a)</span>
                </label>
                <label class="toggle-chip">
                  <input type="checkbox" id="chk-orbit-pred" checked />
                  <span class="chip-box"></span>
                  <span>Predictor de Tiro</span>
                </label>
              </div>
            </div>

            <!-- Control de Tiempo & Reproducción -->
            <div class="ctrl-card is-playback">
              <span class="ctrl-card-title">MOTOR TEMPORAL:</span>
              <div class="playback-dock">
                <button type="button" class="btn-play-pause is-playing" id="btn-play-pause" title="Pausar / Reanudar (Espacio)">
                  <span id="play-pause-icon">⏸️</span>
                </button>
                <div class="time-warp-selector">
                  <button type="button" class="btn-warp" data-warp="0.25">0.25x</button>
                  <button type="button" class="btn-warp is-active" data-warp="1">1x</button>
                  <button type="button" class="btn-warp" data-warp="2">2x</button>
                  <button type="button" class="btn-warp" data-warp="5">5x</button>
                </div>
                <button type="button" class="btn-ctrl-clear" id="btn-clear-bodies" title="Eliminar planetas lanzados">
                  <span>Limpiar</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- SECCIÓN DIDÁCTICA MATEMÁTICA: LAS LEYES DE KEPLER Y NEWTON -->
    <!-- ================================================================= -->
    <section class="kepler-theory-section" id="teoria">
      <div class="theory-container">
        <header class="theory-header">
          <span class="section-tag">MECÁNICA CELESTE & GEOMETRÍA CÓNICA</span>
          <h2 class="theory-title">Las 3 Leyes de Johannes Kepler</h2>
          <p class="theory-subtitle">
            Publicadas entre 1609 y 1619 a partir de las minuciosas observaciones astronómicas de Tycho Brahe, las leyes de Kepler rompieron con el dogma de las órbitas circulares y sentaron las bases para la gravitación universal de Isaac Newton.
          </p>
        </header>

        <!-- BANNER DE CONFRONTACIÓN: LAS 3 LEYES FUNDAMENTALES -->
        <div class="laws-triple-grid">
          <!-- 1.ª Ley de Kepler -->
          <article class="law-card">
            <div class="law-card-badge">1.ª LEY (1609)</div>
            <h3 class="law-card-title">Ley de las Órbitas Elípticas</h3>
            <p class="law-desc">
              Todos los planetas se desplazan alrededor del Sol describiendo <strong>órbitas elípticas</strong>, estando el Sol situado en uno de los dos focos de la elipse.
            </p>
            <div class="math-callout">
              <span class="math-formula"><em>r</em>(<em>θ</em>) = <em>p</em> / (1 + <em>e</em> · cos <em>θ</em>)</span>
            </div>
            <p class="law-subdesc">
              La <strong>excentricidad</strong> (<em>e</em>) determina la forma de la cónica: <em>e</em> = 0 es un círculo perfecto; 0 &lt; <em>e</em> &lt; 1 es una elipse cerrada; <em>e</em> = 1 es una parábola de escape; y <em>e</em> &gt; 1 es una hipérbola.
            </p>
          </article>

          <!-- 2.ª Ley de Kepler -->
          <article class="law-card is-highlight">
            <div class="law-card-badge is-accent">2.ª LEY (1609)</div>
            <h3 class="law-card-title">Ley de las Áreas (dA/dt = Cte)</h3>
            <p class="law-desc">
              El radiovector que une el centro del Sol con un planeta <strong>barre áreas iguales en intervalos de tiempo iguales</strong>.
            </p>
            <div class="math-callout">
              <span class="math-formula">d<em>A</em> / d<em>t</em> = <em>L</em> / (2<em>m</em>) = constante</span>
            </div>
            <p class="law-subdesc">
              Es consecuencia directa de la <strong>conservación del momento angular</strong> en fuerzas centrales. Por eso el planeta viaja a máxima velocidad en el perihelio (más cercano) y a mínima velocidad en el afelio (más lejano).
            </p>
          </article>

          <!-- 3.ª Ley de Kepler -->
          <article class="law-card">
            <div class="law-card-badge">3.ª LEY (1619)</div>
            <h3 class="law-card-title">Ley de los Periodos Armónicos</h3>
            <p class="law-desc">
              El cuadrado del periodo orbital (<em>T</em>) de cualquier planeta es proporcional al cubo del semieje mayor (<em>a</em>) de su órbita:
            </p>
            <div class="math-callout">
              <span class="math-formula"><em>T</em><sup>2</sup> / <em>a</em><sup>3</sup> = 4<em>π</em><sup>2</sup> / (<em>G</em> · <em>M</em>)</span>
            </div>
            <p class="law-subdesc">
              Si medimos el tiempo en años terrestres y las distancias en Unidades Astronómicas (UA) para el Sistema Solar, la constante vale exactamente 1: <em>T</em><sup>2</sup> = <em>a</em><sup>3</sup>.
            </p>
          </article>
        </div>

        <!-- REJILLA DE TARJETAS TÉCNICAS APLICADAS -->
        <div class="theory-grid">
          <!-- Tarjeta 1: Velocidades Clave: Circular vs Escape -->
          <article class="theory-card">
            <div class="tcard-icon">⚡</div>
            <h3 class="tcard-title">Velocidad Circular vs Velocidad de Escape</h3>
            <p class="tcard-p">
              Para un cuerpo a distancia <em>r</em> de una masa central <em>M</em>:
            </p>
            <div class="math-callout">
              <span class="math-formula"><em>v</em><sub>circ</sub> = √(<em>GM</em> / <em>r</em>) &emsp;|&emsp; <em>v</em><sub>esc</sub> = √(2) · <em>v</em><sub>circ</sub></span>
            </div>
            <p class="tcard-foot">
              Basta multiplicar la velocidad circular por √2 (un aumento aproximado del 41.4%) para que la energía mecánica total pase de ser negativa (órbita ligada) a cero o positiva (escape hacia el infinito).
            </p>
          </article>

          <!-- Tarjeta 2: La Maniobra de Transferencia de Hohmann -->
          <article class="theory-card">
            <div class="tcard-icon">🛰️</div>
            <h3 class="tcard-title">La Transferencia Orbital de Hohmann (1925)</h3>
            <p class="tcard-p">
              El método energéticamente más eficiente para viajar entre dos órbitas circulares concéntricas (como de la Tierra a Marte) usando una media elipse tangente:
            </p>
            <ol class="theory-steps">
              <li><strong>Primer impulso (Δv₁)</strong>: Se acelera en periastro para entrar en la elipse de transferencia (con semieje <em>a</em> = (<em>r</em>₁ + <em>r</em>₂) / 2).</li>
              <li><strong>Viaje pasivo</strong>: Se recorre media órbita elíptica sin consumir propelente.</li>
              <li><strong>Segundo impulso (Δv₂)</strong>: Al llegar al apoastro, se vuelve a acelerar para circularizar en la órbita de destino.</li>
            </ol>
          </article>

          <!-- Tarjeta 3: Asistencia Gravitatoria (Slingshot Effect) -->
          <article class="theory-card">
            <div class="tcard-icon">🪐</div>
            <h3 class="tcard-title">El Tirachinas Gravitatorio (Slingshot)</h3>
            <p class="tcard-p">
              Las sondas Voyager, Cassini y New Horizons cruzaron el Sistema Solar sin combustible masivo gracias a pasar rozando planetas gigantes en movimiento.
            </p>
            <p class="tcard-p">
              Visto desde el planeta, el choque es elástico y la sonda sale con la misma rapidez que entró. Pero visto desde el Sol, la sonda "roba" una minúscula fracción de la velocidad orbital del planeta, incrementando su velocidad heliocéntrica hasta en 2<em>v</em><sub>planeta</sub>.
            </p>
          </article>

          <!-- Tarjeta 4: El Integrador Numérico Verlet Simpéctico -->
          <article class="theory-card">
            <div class="tcard-icon">⚙️</div>
            <h3 class="tcard-title">Conservación Numérica: Por qué Euler Falla</h3>
            <p class="tcard-p">
              Los simuladores ingenuos usan integración de Euler: <em>x</em>(<em>t</em> + Δ<em>t</em>) = <em>x</em>(<em>t</em>) + <em>v</em> · Δ<em>t</em>. En gravedad, esto añade energía artificial en cada paso, haciendo que los planetas se alejen en espiral hasta escapar.
            </p>
            <p class="tcard-foot">
              Este simulador utiliza el algoritmo <strong>Velocity Verlet</strong> de orden 2, un integrador simpléctico que conserva estrictamente el espacio fásico y la energía orbital en cientos de miles de pasos.
            </p>
          </article>
        </div>

        <!-- CALCULADORA KEPLERIANA INTERACTIVA -->
        <div class="kepler-calculator-box">
          <div class="kcalc-header">
            <span class="kcalc-pill">LABORATORIO DE CÁLCULO</span>
            <h3 class="kcalc-title">Calculadora de Órbitas Planetarias (3.ª Ley)</h3>
            <p class="kcalc-sub">Introduce la distancia media al Sol (semieje mayor <em>a</em>) para predecir el periodo de traslación exacto:</p>
          </div>

          <div class="kcalc-interactive-row">
            <div class="kcalc-input-wrap">
              <label for="calc-semimajor">Semieje mayor <em>a</em> (en Unidades Astronómicas, UA):</label>
              <div class="kcalc-field">
                <input type="number" id="calc-semimajor" min="0.1" max="100" step="0.05" value="1.0" />
                <span class="kcalc-unit">UA</span>
              </div>
              <div class="kcalc-planet-shortcuts">
                <button type="button" class="btn-shortcut" data-a="0.387">Mercurio (0.39 UA)</button>
                <button type="button" class="btn-shortcut" data-a="0.723">Venus (0.72 UA)</button>
                <button type="button" class="btn-shortcut" data-a="1.0">Tierra (1.00 UA)</button>
                <button type="button" class="btn-shortcut" data-a="1.524">Marte (1.52 UA)</button>
                <button type="button" class="btn-shortcut" data-a="5.204">Júpiter (5.20 UA)</button>
              </div>
            </div>

            <div class="kcalc-results-wrap">
              <div class="kcalc-res-item">
                <span class="kc-label">Periodo Orbital Calculado (<em>T</em> = √(<em>a</em>³)):</span>
                <span class="kc-val" id="calc-res-period">1.000 años terrestres (365.25 días)</span>
              </div>
              <div class="kcalc-res-item">
                <span class="kc-label">Velocidad Orbital Media Estimada:</span>
                <span class="kc-val is-cyan" id="calc-res-vel">29.78 km/s</span>
              </div>
              <div class="kcalc-res-item">
                <span class="kc-label">Razón Kepleriana (<em>T</em>² / <em>a</em>³):</span>
                <span class="kc-val is-gold" id="calc-res-ratio">1.0000 (Constante Universal)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  (() => {
    // =========================================================================
    // TIPOS Y MODELO DE FÍSICA KEPLERIANA
    // =========================================================================
    interface CelestialBody {
      id: string;
      name: string;
      x: number;
      y: number;
      vx: number;
      vy: number;
      ax: number;
      ay: number;
      mass: number;
      radius: number;
      color: string;
      isFixed?: boolean;
      trail: { x: number; y: number }[];
      maxTrailLength: number;
      type: 'star' | 'planet' | 'giant' | 'probe';
    }

    interface Mission {
      id: number;
      title: string;
      stepTag: string;
      objective: string;
      setup: () => void;
      checkCondition: (bodies: CelestialBody[]) => boolean;
      hint: string;
    }

    // Constantes físicas del simulador
    const G = 800; // Constante gravitatoria adaptada a la escala visual de píxeles
    const SOFTENING = 12; // Suavizado para evitar singularidades y explosiones numéricas (epsilon^2)
    const MAX_SUBSTEPS = 4; // Subpasos de integración Verlet por frame para alta precisión simpléctica

    // =========================================================================
    // ESTADO DEL SIMULADOR
    // =========================================================================
    let bodies: CelestialBody[] = [];
    let isRunning = true;
    let timeWarp = 1.0;
    let activeMode: 'tutorial' | 'sandbox' | 'missions' = 'sandbox';
    let currentMissionIdx = 0;
    let currentTutorialStep = 0;
    let currentPresetName = 'solar-inner';
    let spawnType: 'probe' | 'planet' | 'giant' | 'star' = 'planet';

    // Opciones visuales
    let showGravityWell = true;
    let showTheoreticalOrbits = true;
    let showKepler2Areas = false;
    let showVelocityVector = true;
    let showGravVector = true;
    let showOrbitPredictor = true;

    // Área de Kepler 2
    let kepler2Sectors: { p1: { x: number; y: number }; p2: { x: number; y: number }; area: number; color: string }[] = [];
    let kepler2LastSamplePos: { x: number; y: number } | null = null;
    let kepler2AccumTime = 0;
    const KEPLER2_SAMPLE_INTERVAL = 1.8; // Segundos entre muestras de sector

    // Cámara (Pan y Zoom)
    let camX = 0;
    let camY = 0;
    let camZoom = 1.0;
    let isPanning = false;
    let panStartX = 0;
    let panStartY = 0;

    // Lanzamiento interactivo (arrastrar vector)
    let isDraggingLaunch = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragCurrentX = 0;
    let dragCurrentY = 0;

    // Elementos DOM
    const canvas = document.getElementById('kepler-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const tabBtnTutorial = document.getElementById('tab-btn-tutorial');
    const tabBtnSandbox = document.getElementById('tab-btn-sandbox');
    const tabBtnMissions = document.getElementById('tab-btn-missions');
    const presetsShelf = document.getElementById('presets-shelf');
    const hudTelemetry = document.getElementById('hud-telemetry');
    const hudKepler2Overlay = document.getElementById('hud-kepler2-overlay');
    const hudMissionDock = document.getElementById('hud-mission-dock');
    const hudTutorialDock = document.getElementById('hud-tutorial-dock');

    // Telemetría DOM
    const hudBodiesCount = document.getElementById('hud-bodies-count');
    const hudVel = document.getElementById('hud-vel');
    const hudRadius = document.getElementById('hud-radius');
    const hudEcc = document.getElementById('hud-ecc');
    const hudConic = document.getElementById('hud-conic');

    // Kepler 2 DOM
    const k2CurrentArea = document.getElementById('k2-current-area');
    const k2CurrentDt = document.getElementById('k2-current-dt');
    const k2ArealRate = document.getElementById('k2-areal-rate');
    const btnK2Clear = document.getElementById('btn-k2-clear');

    // Tutorial DOM
    const tutStepTag = document.getElementById('tut-step-tag');
    const tutTitle = document.getElementById('tut-title');
    const tutBody = document.getElementById('tut-body');
    const tutCallout = document.getElementById('tut-callout');
    const tutStepperDots = document.getElementById('tut-stepper-dots');
    const btnTutPrev = document.getElementById('btn-tut-prev') as HTMLButtonElement | null;
    const btnTutNext = document.getElementById('btn-tut-next') as HTMLButtonElement | null;
    const btnTutClose = document.getElementById('btn-tut-close');

    // Misiones DOM
    const missionStepTag = document.getElementById('mission-step-tag');
    const missionTitle = document.getElementById('mission-title');
    const missionStatusBadge = document.getElementById('mission-status-badge');
    const missionObjective = document.getElementById('mission-objective');
    const missionProgressFill = document.getElementById('mission-progress-fill');
    const btnMissionRetry = document.getElementById('btn-mission-retry') as HTMLButtonElement | null;
    const btnMissionNext = document.getElementById('btn-mission-next') as HTMLButtonElement | null;

    // Controles DOM
    const btnPlayPause = document.getElementById('btn-play-pause');
    const playPauseIcon = document.getElementById('play-pause-icon');
    const btnClearBodies = document.getElementById('btn-clear-bodies');
    const btnResetPreset = document.getElementById('btn-reset-preset');
    const btnZoomIn = document.getElementById('btn-zoom-in');
    const btnZoomOut = document.getElementById('btn-zoom-out');
    const btnRecenter = document.getElementById('btn-recenter');

    // Checkboxes
    const chkGravityWell = document.getElementById('chk-gravity-well') as HTMLInputElement | null;
    const chkOrbitGuides = document.getElementById('chk-orbit-guides') as HTMLInputElement | null;
    const chkKepler2 = document.getElementById('chk-kepler2') as HTMLInputElement | null;
    const chkVelVector = document.getElementById('chk-vel-vector') as HTMLInputElement | null;
    const chkGravVector = document.getElementById('chk-grav-vector') as HTMLInputElement | null;
    const chkOrbitPred = document.getElementById('chk-orbit-pred') as HTMLInputElement | null;

    // =========================================================================
    // AUDIO SYNTHESIS WEB API
    // =========================================================================
    let audioCtx: AudioContext | null = null;
    function getAudioContext(): AudioContext | null {
      try {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
          if (AudioContextClass) audioCtx = new AudioContextClass();
        }
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        return audioCtx;
      } catch {
        return null;
      }
    }

    function playLaunchTone() {
      const actx = getAudioContext();
      if (!actx) return;
      const now = actx.currentTime;
      const osc = actx.createOscillator();
      const gain = actx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(180, now);
      osc.frequency.exponentialRampToValueAtTime(540, now + 0.16);
      gain.gain.setValueAtTime(0.001, now);
      gain.gain.linearRampToValueAtTime(0.2, now + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
      osc.connect(gain);
      gain.connect(actx.destination);
      osc.start(now);
      osc.stop(now + 0.24);
    }

    function playSuccessChime() {
      const actx = getAudioContext();
      if (!actx) return;
      const now = actx.currentTime;
      [440, 554.37, 659.25, 880].forEach((freq, idx) => {
        const osc = actx.createOscillator();
        const gain = actx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, now + idx * 0.08);
        gain.gain.setValueAtTime(0.001, now + idx * 0.08);
        gain.gain.linearRampToValueAtTime(0.18, now + idx * 0.08 + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.35);
        osc.connect(gain);
        gain.connect(actx.destination);
        osc.start(now + idx * 0.08);
        osc.stop(now + idx * 0.08 + 0.36);
      });
    }

    // =========================================================================
    // LIMPIEZA RIGUROSA DE ÁREAS DE LA 2.ª LEY
    // =========================================================================
    function clearKepler2Areas() {
      kepler2Sectors = [];
      kepler2LastSamplePos = null;
      kepler2AccumTime = 0;
      if (k2CurrentArea) k2CurrentArea.textContent = '-- UA²';
      if (k2CurrentDt) k2CurrentDt.textContent = '-- días';
      if (k2ArealRate) k2ArealRate.textContent = 'CONSTANTE';
    }

    // =========================================================================
    // AJUSTE DE TAMAÑO Y REDIMENSIONAMIENTO RESPONSIVE
    // =========================================================================
    function resizeCanvas() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.floor(rect.width * dpr);
      canvas.height = Math.floor(rect.height * dpr);
      ctx?.scale(dpr, dpr);
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // =========================================================================
    // TRANSFORMACIONES DE COORDENADAS (Mundo <-> Pantalla)
    // =========================================================================
    function worldToScreen(wx: number, wy: number) {
      if (!canvas) return { sx: 0, sy: 0 };
      const rect = canvas.getBoundingClientRect();
      const cx = rect.width / 2;
      const cy = rect.height / 2;
      const sx = cx + (wx - camX) * camZoom;
      const sy = cy + (wy - camY) * camZoom;
      return { sx, sy };
    }

    function screenToWorld(sx: number, sy: number) {
      if (!canvas) return { wx: 0, wy: 0 };
      const rect = canvas.getBoundingClientRect();
      const cx = rect.width / 2;
      const cy = rect.height / 2;
      const wx = camX + (sx - cx) / camZoom;
      const wy = camY + (sy - cy) / camZoom;
      return { wx, wy };
    }

    // =========================================================================
    // FÍSICA: CÁLCULO DE ACELERACIONES GRAVITATORIAS N-CUERPOS
    // =========================================================================
    function computeAccelerations(bodyList: CelestialBody[]) {
      for (const b of bodyList) {
        b.ax = 0;
        b.ay = 0;
      }

      const n = bodyList.length;
      for (let i = 0; i < n; i++) {
        const b1 = bodyList[i];
        for (let j = i + 1; j < n; j++) {
          const b2 = bodyList[j];
          const dx = b2.x - b1.x;
          const dy = b2.y - b1.y;
          const distSq = dx * dx + dy * dy + SOFTENING * SOFTENING;
          const dist = Math.sqrt(distSq);
          const forceFactor = G / (distSq * dist);

          if (!b1.isFixed) {
            b1.ax += dx * forceFactor * b2.mass;
            b1.ay += dy * forceFactor * b2.mass;
          }

          if (!b2.isFixed) {
            b2.ax -= dx * forceFactor * b1.mass;
            b2.ay -= dy * forceFactor * b1.mass;
          }
        }
      }
    }

    // =========================================================================
    // INTEGRADOR SIMPLÉCTICO VELOCITY VERLET
    // =========================================================================
    function stepVerlet(dt: number) {
      for (const b of bodies) {
        if (b.isFixed) continue;
        b.x += b.vx * dt + 0.5 * b.ax * dt * dt;
        b.y += b.vy * dt + 0.5 * b.ay * dt * dt;
      }

      const oldAx: number[] = bodies.map((b) => b.ax);
      const oldAy: number[] = bodies.map((b) => b.ay);

      computeAccelerations(bodies);

      for (let i = 0; i < bodies.length; i++) {
        const b = bodies[i];
        if (b.isFixed) continue;
        b.vx += 0.5 * (oldAx[i] + b.ax) * dt;
        b.vy += 0.5 * (oldAy[i] + b.ay) * dt;

        b.trail.push({ x: b.x, y: b.y });
        if (b.trail.length > b.maxTrailLength) b.trail.shift();
      }

      if (showKepler2Areas && bodies.length >= 2) {
        sampleKepler2Area(dt);
      }
    }

    // =========================================================================
    // CÁLCULO DE ÁREAS DE LA 2.ª LEY DE KEPLER (dA/dt)
    // =========================================================================
    const K2_COLORS = [
      'rgba(56, 189, 248, 0.22)', // Cyan tenue
      'rgba(255, 193, 77, 0.22)', // Oro tenue
      'rgba(63, 224, 181, 0.22)', // Esmeralda tenue
      'rgba(244, 63, 94, 0.22)',  // Coral tenue
      'rgba(168, 85, 247, 0.22)', // Púrpura tenue
    ];
    let k2ColorIdx = 0;

    function sampleKepler2Area(dt: number) {
      const star = bodies[0];
      const planet = bodies[1];
      if (!star || !planet) return;

      kepler2AccumTime += dt;

      if (!kepler2LastSamplePos) {
        kepler2LastSamplePos = { x: planet.x, y: planet.y };
        return;
      }

      if (kepler2AccumTime >= KEPLER2_SAMPLE_INTERVAL) {
        const p1 = { x: kepler2LastSamplePos.x - star.x, y: kepler2LastSamplePos.y - star.y };
        const p2 = { x: planet.x - star.x, y: planet.y - star.y };

        const area = 0.5 * Math.abs(p1.x * p2.y - p2.x * p1.y);

        kepler2Sectors.push({
          p1: { x: kepler2LastSamplePos.x, y: kepler2LastSamplePos.y },
          p2: { x: planet.x, y: planet.y },
          area,
          color: K2_COLORS[k2ColorIdx % K2_COLORS.length]
        });
        k2ColorIdx++;

        if (kepler2Sectors.length > 8) kepler2Sectors.shift();

        if (k2CurrentArea) k2CurrentArea.textContent = `${(area / 1000).toFixed(2)} UA²`;
        if (k2CurrentDt) k2CurrentDt.textContent = `${(kepler2AccumTime * 12).toFixed(1)} d`;
        if (k2ArealRate) k2ArealRate.textContent = `${(area / (kepler2AccumTime * 1000)).toFixed(2)} UA²/d (CTE)`;

        kepler2LastSamplePos = { x: planet.x, y: planet.y };
        kepler2AccumTime = 0;
      }
    }

    // =========================================================================
    // DIBUJO DE ÓRBITAS GUÍA TEÓRICAS EN MODO MUY CLARO (RAILS)
    // =========================================================================
    function drawTheoreticalOrbits() {
      if (!ctx || !showTheoreticalOrbits || bodies.length < 2) return;
      const star = bodies[0];
      if (!star || star.mass < 15) return;

      const mu = G * star.mass;

      for (let i = 1; i < bodies.length; i++) {
        const b = bodies[i];
        const rx = b.x - star.x;
        const ry = b.y - star.y;
        const r = Math.sqrt(rx * rx + ry * ry);
        const vx = b.vx - star.vx;
        const vy = b.vy - star.vy;
        const v2 = vx * vx + vy * vy;

        const specEnergy = v2 / 2 - mu / r;
        if (specEnergy >= -0.001) continue; // Órbita abierta o hiperbólica

        const a = -mu / (2 * specEnergy);
        const h = rx * vy - ry * vx;
        const term = 1 + (2 * specEnergy * h * h) / (mu * mu);
        if (term < 0) continue;
        const ecc = Math.sqrt(term);
        if (ecc >= 0.96) continue;

        const b_semi = a * Math.sqrt(Math.max(0, 1 - ecc * ecc));

        // Vector excentricidad
        const ev_x = (vy * h) / mu - rx / r;
        const ev_y = (-vx * h) / mu - ry / r;
        const omega = Math.atan2(ev_y, ev_x);

        const cDist = a * ecc;
        const worldCenterX = star.x - cDist * Math.cos(omega);
        const worldCenterY = star.y - cDist * Math.sin(omega);

        const centerSc = worldToScreen(worldCenterX, worldCenterY);

        ctx.beginPath();
        ctx.ellipse(centerSc.sx, centerSc.sy, a * camZoom, b_semi * camZoom, omega, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(77, 148, 255, 0.16)';
        ctx.lineWidth = 1;
        ctx.setLineDash([3, 5]);
        ctx.stroke();
        ctx.setLineDash([]);
      }
    }

    // =========================================================================
    // DIBUJO DE RETÍCULA Y POZO DE GRAVEDAD EINSTEINIANO
    // =========================================================================
    function drawCelestialGrid(w: number, h: number) {
      if (!ctx) return;
      const step = 55 * camZoom;

      const cols = Math.ceil(w / step) + 2;
      const rows = Math.ceil(h / step) + 2;

      const startX = (w / 2 - camX * camZoom) % step - step;
      const startY = (h / 2 - camY * camZoom) % step - step;

      const massiveBodies = bodies.filter((b) => b.mass >= 15);

      if (showGravityWell && massiveBodies.length > 0) {
        // Líneas verticales deformadas por el pozo
        for (let c = 0; c < cols; c++) {
          const screenBaseX = startX + c * step;
          ctx.beginPath();
          const numSamples = 20;
          for (let s = 0; s <= numSamples; s++) {
            const screenBaseY = (h * s) / numSamples;
            const wPos = screenToWorld(screenBaseX, screenBaseY);
            let dispX = 0;
            let dispY = 0;
            for (const mb of massiveBodies) {
              const dx = mb.x - wPos.wx;
              const dy = mb.y - wPos.wy;
              const d2 = dx * dx + dy * dy + 900;
              const pull = (mb.mass * 24) / d2;
              dispX += dx * pull;
              dispY += dy * pull;
            }
            const finalSc = worldToScreen(wPos.wx + dispX, wPos.wy + dispY);
            if (s === 0) ctx.moveTo(finalSc.sx, finalSc.sy);
            else ctx.lineTo(finalSc.sx, finalSc.sy);
          }
          ctx.strokeStyle = 'rgba(77, 148, 255, 0.05)';
          ctx.lineWidth = 1;
          ctx.stroke();
        }

        // Líneas horizontales deformadas por el pozo
        for (let r = 0; r < rows; r++) {
          const screenBaseY = startY + r * step;
          ctx.beginPath();
          const numSamples = 20;
          for (let s = 0; s <= numSamples; s++) {
            const screenBaseX = (w * s) / numSamples;
            const wPos = screenToWorld(screenBaseX, screenBaseY);
            let dispX = 0;
            let dispY = 0;
            for (const mb of massiveBodies) {
              const dx = mb.x - wPos.wx;
              const dy = mb.y - wPos.wy;
              const d2 = dx * dx + dy * dy + 900;
              const pull = (mb.mass * 24) / d2;
              dispX += dx * pull;
              dispY += dy * pull;
            }
            const finalSc = worldToScreen(wPos.wx + dispX, wPos.wy + dispY);
            if (s === 0) ctx.moveTo(finalSc.sx, finalSc.sy);
            else ctx.lineTo(finalSc.sx, finalSc.sy);
          }
          ctx.strokeStyle = 'rgba(77, 148, 255, 0.05)';
          ctx.lineWidth = 1;
          ctx.stroke();
        }

        // Círculos concéntricos de isopotencial del pozo (embudo)
        for (const mb of massiveBodies) {
          const mbSc = worldToScreen(mb.x, mb.y);
          const wellRadii = [35, 65, 110, 175, 260, 360];
          wellRadii.forEach((rad, idx) => {
            const screenR = rad * camZoom;
            ctx.beginPath();
            ctx.arc(mbSc.sx, mbSc.sy, screenR, 0, Math.PI * 2);
            ctx.strokeStyle = `rgba(77, 148, 255, ${0.11 - idx * 0.016})`;
            ctx.lineWidth = 1;
            ctx.setLineDash([2, 5]);
            ctx.stroke();
            ctx.setLineDash([]);
          });
        }
      } else {
        // Retícula plana
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.035)';
        ctx.lineWidth = 1;
        for (let x = startX; x < w + step; x += step) {
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, h);
          ctx.stroke();
        }
        for (let y = startY; y < h + step; y += step) {
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(w, y);
          ctx.stroke();
        }
      }
    }

    // =========================================================================
    // PREDICTOR DE TRAYECTORIA CÓNICA ORBITAL (DOTTED LINE)
    // =========================================================================
    function computeOrbitPrediction(startX: number, startY: number, vx: number, vy: number, steps = 140) {
      const simBodies: { x: number; y: number; vx: number; vy: number; mass: number; isFixed?: boolean }[] = bodies.map(b => ({
        x: b.x,
        y: b.y,
        vx: b.vx,
        vy: b.vy,
        mass: b.mass,
        isFixed: b.isFixed
      }));

      const probe = { x: startX, y: startY, vx, vy, mass: 0.001, isFixed: false };
      const path: { x: number; y: number }[] = [{ x: startX, y: startY }];
      const dt = 0.16;

      for (let s = 0; s < steps; s++) {
        let ax = 0;
        let ay = 0;
        for (const b of simBodies) {
          const dx = b.x - probe.x;
          const dy = b.y - probe.y;
          const d2 = dx * dx + dy * dy + SOFTENING * SOFTENING;
          const f = (G * b.mass) / (d2 * Math.sqrt(d2));
          ax += dx * f;
          ay += dy * f;
        }

        probe.vx += ax * dt;
        probe.vy += ay * dt;
        probe.x += probe.vx * dt;
        probe.y += probe.vy * dt;

        if (s % 2 === 0) {
          path.push({ x: probe.x, y: probe.y });
        }
      }
      return path;
    }

    // =========================================================================
    // DIBUJO EN CANVAS 60FPS
    // =========================================================================
    function render() {
      if (!canvas || !ctx) return;
      const rect = canvas.getBoundingClientRect();
      const w = rect.width;
      const h = rect.height;

      ctx.clearRect(0, 0, w, h);

      // 1. Fondo celeste, retícula y pozo gravitatorio
      drawCelestialGrid(w, h);

      // 2. Órbitas guía teóricas
      drawTheoreticalOrbits();

      const star = bodies[0];

      // 3. Dibujar Sectores de la 2.ª Ley de Kepler si están activos
      if (showKepler2Areas && star && kepler2Sectors.length > 0) {
        const starSc = worldToScreen(star.x, star.y);
        for (const sec of kepler2Sectors) {
          const p1Sc = worldToScreen(sec.p1.x, sec.p1.y);
          const p2Sc = worldToScreen(sec.p2.x, sec.p2.y);

          ctx.beginPath();
          ctx.moveTo(starSc.sx, starSc.sy);
          ctx.lineTo(p1Sc.sx, p1Sc.sy);
          ctx.lineTo(p2Sc.sx, p2Sc.sy);
          ctx.closePath();
          ctx.fillStyle = sec.color;
          ctx.fill();
          ctx.strokeStyle = 'rgba(56, 189, 248, 0.4)';
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }

      // 4. Dibujar Trazas orbitales
      for (const b of bodies) {
        if (b.trail.length > 1) {
          ctx.beginPath();
          for (let i = 0; i < b.trail.length; i++) {
            const pt = worldToScreen(b.trail[i].x, b.trail[i].y);
            if (i === 0) ctx.moveTo(pt.sx, pt.sy);
            else ctx.lineTo(pt.sx, pt.sy);
          }
          ctx.strokeStyle = b.color;
          ctx.lineWidth = b.type === 'probe' ? 1.0 : 1.5;
          ctx.globalAlpha = 0.35;
          ctx.stroke();
          ctx.globalAlpha = 1.0;
        }
      }

      // 5. Dibujar Cuerpos Celestes
      for (const b of bodies) {
        const pt = worldToScreen(b.x, b.y);
        const r = Math.max(2.5, b.radius * camZoom);

        if (b.type === 'star') {
          const grad = ctx.createRadialGradient(pt.sx, pt.sy, r * 0.2, pt.sx, pt.sy, r * 2.8);
          grad.addColorStop(0, '#fff4cc');
          grad.addColorStop(0.3, b.color);
          grad.addColorStop(1, 'rgba(255, 193, 77, 0)');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(pt.sx, pt.sy, r * 2.8, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(pt.sx, pt.sy, r, 0, Math.PI * 2);
        ctx.fillStyle = b.color;
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1;
        ctx.stroke();

        if (b.name && camZoom > 0.45) {
          ctx.font = '10px monospace';
          ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
          ctx.fillText(b.name, pt.sx + r + 5, pt.sy + 3);
        }

        // Vectores de Velocidad (Cian tenue) y Gravedad (Coral tenue)
        if (showVelocityVector && !b.isFixed && (b.vx !== 0 || b.vy !== 0)) {
          drawVectorArrow(pt.sx, pt.sy, b.vx * 10 * camZoom, b.vy * 10 * camZoom, 'rgba(56, 189, 248, 0.45)', 'v');
        }
        if (showGravVector && !b.isFixed && (b.ax !== 0 || b.ay !== 0)) {
          drawVectorArrow(pt.sx, pt.sy, b.ax * 65 * camZoom, b.ay * 65 * camZoom, 'rgba(244, 63, 94, 0.4)', 'a');
        }
      }

      // 6. Vector de Lanzamiento Interactivo (Arrastre del usuario)
      if (isDraggingLaunch) {
        const startSc = worldToScreen(dragStartX, dragStartY);
        const vx = (dragStartX - dragCurrentX) * 0.18;
        const vy = (dragStartY - dragCurrentY) * 0.18;

        ctx.beginPath();
        ctx.moveTo(startSc.sx, startSc.sy);
        ctx.lineTo(startSc.sx + vx * 10 * camZoom, startSc.sy + vy * 10 * camZoom);
        ctx.strokeStyle = 'rgba(63, 224, 181, 0.8)';
        ctx.lineWidth = 2;
        ctx.setLineDash([4, 4]);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.beginPath();
        ctx.arc(startSc.sx, startSc.sy, 5, 0, Math.PI * 2);
        ctx.fillStyle = '#3fe0b5';
        ctx.fill();

        if (showOrbitPredictor) {
          const predictedPath = computeOrbitPrediction(dragStartX, dragStartY, vx, vy, 110);
          ctx.beginPath();
          for (let i = 0; i < predictedPath.length; i++) {
            const pSc = worldToScreen(predictedPath[i].x, predictedPath[i].y);
            if (i === 0) ctx.moveTo(pSc.sx, pSc.sy);
            else ctx.lineTo(pSc.sx, pSc.sy);
          }
          ctx.strokeStyle = 'rgba(63, 224, 181, 0.65)';
          ctx.lineWidth = 1.2;
          ctx.setLineDash([3, 5]);
          ctx.stroke();
          ctx.setLineDash([]);
        }
      }

      updateTelemetry();
    }

    function drawVectorArrow(fromX: number, fromY: number, dx: number, dy: number, color: string, label: string) {
      if (!ctx) return;
      const len = Math.sqrt(dx * dx + dy * dy);
      if (len < 3) return;

      const toX = fromX + dx;
      const toY = fromY + dy;

      ctx.beginPath();
      ctx.moveTo(fromX, fromY);
      ctx.lineTo(toX, toY);
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.2;
      ctx.stroke();

      const headAngle = Math.atan2(dy, dx);
      const headLen = 5;
      ctx.beginPath();
      ctx.moveTo(toX, toY);
      ctx.lineTo(toX - headLen * Math.cos(headAngle - Math.PI / 6), toY - headLen * Math.sin(headAngle - Math.PI / 6));
      ctx.lineTo(toX - headLen * Math.cos(headAngle + Math.PI / 6), toY - headLen * Math.sin(headAngle + Math.PI / 6));
      ctx.closePath();
      ctx.fillStyle = color;
      ctx.fill();

      ctx.font = '9px monospace';
      ctx.fillStyle = color;
      ctx.fillText(label, toX + 3, toY + 2);
    }

    // =========================================================================
    // CÁLCULO DE TELEMETRÍA Y ELEMENTOS KEPLERIANOS EN VIVO
    // =========================================================================
    function updateTelemetry() {
      if (hudBodiesCount) hudBodiesCount.textContent = String(bodies.length);

      if (bodies.length < 2) {
        if (hudVel) hudVel.textContent = '--';
        if (hudRadius) hudRadius.textContent = '--';
        if (hudEcc) hudEcc.textContent = '--';
        if (hudConic) {
          hudConic.textContent = 'Sin Órbita';
          hudConic.className = 'hud-conic-pill';
        }
        return;
      }

      const star = bodies[0];
      const planet = bodies[1];
      const dx = planet.x - star.x;
      const dy = planet.y - star.y;
      const r = Math.sqrt(dx * dx + dy * dy);
      const v = Math.sqrt(planet.vx * planet.vx + planet.vy * planet.vy);

      if (hudVel) hudVel.textContent = `${(v * 7.5).toFixed(1)} km/s`;
      if (hudRadius) hudRadius.textContent = `${(r / 150).toFixed(2)} AU`;

      const GM = G * star.mass;
      const specEnergy = (v * v) / 2 - GM / r;
      const h = dx * planet.vy - dy * planet.vx;

      let ecc = 0;
      const term = 1 + (2 * specEnergy * h * h) / (GM * GM);
      if (term >= 0) ecc = Math.sqrt(term);

      if (hudEcc) hudEcc.textContent = ecc.toFixed(3);

      if (hudConic) {
        if (ecc < 0.05) {
          hudConic.textContent = 'Circular (e ≈ 0)';
          hudConic.className = 'hud-conic-pill is-circular';
        } else if (ecc < 0.98) {
          hudConic.textContent = `Elíptica (e = ${ecc.toFixed(2)})`;
          hudConic.className = 'hud-conic-pill is-elliptic';
        } else if (Math.abs(ecc - 1.0) <= 0.05) {
          hudConic.textContent = 'Parabólica (Escape)';
          hudConic.className = 'hud-conic-pill is-parabolic';
        } else {
          hudConic.textContent = 'Hiperbólica (Libre)';
          hudConic.className = 'hud-conic-pill is-hyperbolic';
        }
      }
    }

