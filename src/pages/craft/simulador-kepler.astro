  }

  .mode-hub-card:hover {
    border-color: rgba(77, 148, 255, 0.4);
    background: rgba(77, 148, 255, 0.05);
    transform: translateY(-1px);
  }

  .mode-hub-card.is-active {
    background: rgba(77, 148, 255, 0.1);
    border-color: #4d94ff;
    box-shadow: 0 4px 18px rgba(77, 148, 255, 0.2);
  }

  .mhc-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.45rem;
  }

  .mhc-mode-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--muted, #94a3b8);
  }

  .mode-hub-card.is-active .mhc-mode-tag {
    color: #4d94ff;
  }

  .mhc-status-pill {
    font-family: var(--font-mono, monospace);
