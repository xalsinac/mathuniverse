    min-height: 100vh;
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  .game-cockpit {
    background: radial-gradient(circle at 50% 10%, rgba(77, 148, 255, 0.12), #070c16 70%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.25rem 1rem 1.75rem;
  }

  .cockpit-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* CABECERA */
  .cockpit-header {
