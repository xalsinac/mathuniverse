              radius: 5,
              color: '#3fe0b5',
              trail: [],
              maxTrailLength: 200,
              type: 'planet'
            }
          ];
          clearKepler2Areas();
        },
        checkCondition: (bList) => {
          if (bList.length < 3) return false;
          const probe = bList[2];
          const r = Math.sqrt(probe.x * probe.x + probe.y * probe.y);
          return r >= 230 && r <= 255;
        }
      },
      {
        id: 3,
        title: 'Asistencia Gravitatoria (Slingshot)',
        stepTag: 'MISIÓN 3 DE 4',
        objective: 'Lanza una sonda espacial hacia Júpiter de forma que su gravedad catapulte la sonda aumentando su velocidad heliocéntrica sin chocar contra el planeta.',
        hint: 'Pasa por detrás del planeta en su dirección de movimiento para robar momento orbital.',
        setup: () => {
          loadPreset('slingshot');
          bodies = bodies.filter(b => b.id !== 'voyager');
          clearKepler2Areas();
        },
        checkCondition: (bList) => {
          if (bList.length < 3) return false;
          const probe = bList[2];
          const v = Math.sqrt(probe.vx * probe.vx + probe.vy * probe.vy);
          return v > 32;
        }
      },
      {
        id: 4,
        title: 'Velocidad de Escape Interestelar',
        stepTag: 'MISIÓN 4 DE 4',
        objective: 'Lanza un cuerpo con energía mecánica orbital positiva (excentricidad e ≥ 1.0) para que venza definitivamente la atracción estelar y escape del sistema en una hipérbola.',
        hint: 'Acelera con una flecha larga de vector para que v > √(2GM/r).',
        setup: () => {
          loadPreset('solar-inner');
          bodies = [bodies[0]]; // Dejamos solo el Sol
          clearKepler2Areas();
        },
        checkCondition: (bList) => {
          if (bList.length < 2) return false;
          const star = bList[0];
          const p = bList[1];
          const dx = p.x - star.x;
          const dy = p.y - star.y;
          const r = Math.sqrt(dx * dx + dy * dy);
          const v = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
          const GM = G * star.mass;
          const specEnergy = (v * v) / 2 - GM / r;
          return specEnergy > 0 && r > 280;
        }
      }
    ];

    function loadMission(idx: number) {
      currentMissionIdx = idx;
      clearKepler2Areas();
      const m = MISSIONS[idx];
      if (missionStepTag) missionStepTag.textContent = m.stepTag;
      if (missionTitle) missionTitle.textContent = m.title;
      if (missionObjective) missionObjective.textContent = m.objective;
      if (missionStatusBadge) {
        missionStatusBadge.textContent = 'EN CURSO';
        missionStatusBadge.className = 'mission-status-badge';
      }
      if (missionProgressFill) missionProgressFill.style.width = '0%';
      if (btnMissionNext) btnMissionNext.disabled = true;

      m.setup();
      computeAccelerations(bodies);
    }

    // =========================================================================
    // LOOP PRINCIPAL DE ANIMACIÓN
    // =========================================================================
    let lastTime = performance.now();

    function gameLoop(now: number) {
      const dtRaw = (now - lastTime) / 1000;
      lastTime = now;
      const dtClamped = Math.min(dtRaw, 0.05);

      if (isRunning) {
        const dtSub = (dtClamped * timeWarp) / MAX_SUBSTEPS;
        for (let step = 0; step < MAX_SUBSTEPS; step++) {
          stepVerlet(dtSub);
        }

        if (activeMode === 'missions') {
          const currentM = MISSIONS[currentMissionIdx];
          if (currentM && currentM.checkCondition(bodies)) {
            if (missionStatusBadge && missionStatusBadge.textContent !== '¡COMPLETADA!') {
              missionStatusBadge.textContent = '¡COMPLETADA!';
              missionStatusBadge.className = 'mission-status-badge is-success';
              if (missionProgressFill) missionProgressFill.style.width = '100%';
              if (btnMissionNext) btnMissionNext.disabled = false;
              playSuccessChime();
            }
          }
        }
      }

      render();
      requestAnimationFrame(gameLoop);
    }
    requestAnimationFrame(gameLoop);

    // =========================================================================
    // EVENT LISTENERS DEL CANVAS: LANZAMIENTO Y CÁMARA
    // =========================================================================
    canvas.addEventListener('mousedown', (e) => {
      const rect = canvas.getBoundingClientRect();
      const sx = e.clientX - rect.left;
      const sy = e.clientY - rect.top;

      if (e.button === 1 || e.shiftKey) {
        isPanning = true;
        panStartX = e.clientX;
        panStartY = e.clientY;
        return;
      }

      if (e.button === 0) {
        const wPos = screenToWorld(sx, sy);
        isDraggingLaunch = true;
        dragStartX = wPos.wx;
        dragStartY = wPos.wy;
        dragCurrentX = wPos.wx;
        dragCurrentY = wPos.wy;
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (isPanning) {
        const dx = (e.clientX - panStartX) / camZoom;
        const dy = (e.clientY - panStartY) / camZoom;
        camX -= dx;
        camY -= dy;
        panStartX = e.clientX;
        panStartY = e.clientY;
        return;
      }

      if (isDraggingLaunch && canvas) {
        const rect = canvas.getBoundingClientRect();
        const sx = e.clientX - rect.left;
        const sy = e.clientY - rect.top;
        const wPos = screenToWorld(sx, sy);
        dragCurrentX = wPos.wx;
        dragCurrentY = wPos.wy;
      }
    });

    window.addEventListener('mouseup', (e) => {
      if (isPanning) {
        isPanning = false;
        return;
      }

      if (isDraggingLaunch) {
        isDraggingLaunch = false;

        const vx = (dragStartX - dragCurrentX) * 0.18;
        const vy = (dragStartY - dragCurrentY) * 0.18;

        let mass = 1.0;
        let radius = 5;
        let color = '#3fe0b5';
        let name = 'Planeta';

        if (spawnType === 'probe') {
          mass = 0.001;
          radius = 3;
          color = '#38bdf8';
          name = 'Sonda';
        } else if (spawnType === 'giant') {
          mass = 30;
          radius = 11;
          color = '#fb923c';
          name = 'Gigante';
        } else if (spawnType === 'star') {
          mass = 120;
          radius = 18;
          color = '#ffc14d';
          name = 'Estrella';
        }

        bodies.push({
          id: `body-${Date.now()}`,
          name: `${name} ${bodies.length + 1}`,
          x: dragStartX,
          y: dragStartY,
          vx,
          vy,
          ax: 0,
          ay: 0,
          mass,
          radius,
          color,
          trail: [],
          maxTrailLength: spawnType === 'probe' ? 300 : 200,
          type: spawnType,
          isFixed: spawnType === 'star' && bodies.length === 0
        });

        computeAccelerations(bodies);
        playLaunchTone();
      }
    });

    // Soporte táctil móvil
    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches[0];
        const sx = touch.clientX - rect.left;
        const sy = touch.clientY - rect.top;
        const wPos = screenToWorld(sx, sy);
        isDraggingLaunch = true;
        dragStartX = wPos.wx;
        dragStartY = wPos.wy;
        dragCurrentX = wPos.wx;
        dragCurrentY = wPos.wy;
      }
    }, { passive: false });

    canvas.addEventListener('touchmove', (e) => {
      if (isDraggingLaunch && e.touches.length === 1) {
        e.preventDefault();
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches[0];
        const sx = touch.clientX - rect.left;
        const sy = touch.clientY - rect.top;
        const wPos = screenToWorld(sx, sy);
        dragCurrentX = wPos.wx;
        dragCurrentY = wPos.wy;
      }
    }, { passive: false });

    canvas.addEventListener('touchend', () => {
      if (isDraggingLaunch) {
        isDraggingLaunch = false;
        const vx = (dragStartX - dragCurrentX) * 0.18;
        const vy = (dragStartY - dragCurrentY) * 0.18;
        bodies.push({
          id: `body-${Date.now()}`,
          name: `Planeta ${bodies.length + 1}`,
          x: dragStartX,
          y: dragStartY,
          vx,
          vy,
          ax: 0,
          ay: 0,
          mass: 1.0,
          radius: 5,
          color: '#3fe0b5',
          trail: [],
          maxTrailLength: 200,
          type: 'planet'
        });
        computeAccelerations(bodies);
        playLaunchTone();
      }
    });

    // Zoom con rueda de ratón
    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const zoomFactor = e.deltaY < 0 ? 1.12 : 0.89;
      camZoom = Math.min(Math.max(0.2, camZoom * zoomFactor), 4.0);
    }, { passive: false });

    // =========================================================================
    // EVENT LISTENERS DEL HUB DE MODOS Y BOTONES
    // =========================================================================
    function setMode(mode: 'tutorial' | 'sandbox' | 'missions') {
      activeMode = mode;

      [tabBtnTutorial, tabBtnSandbox, tabBtnMissions].forEach((btn) => {
        btn?.classList.remove('is-active');
        btn?.setAttribute('aria-selected', 'false');
        const pill = btn?.querySelector('.mhc-status-pill');
        if (pill) {
          pill.className = 'mhc-status-pill is-alt';
          if (btn === tabBtnTutorial) pill.textContent = 'PRINCIPIANTE';
          if (btn === tabBtnSandbox) pill.textContent = 'SANDBOX';
          if (btn === tabBtnMissions) pill.textContent = 'DESAFÍOS';
        }
      });

      if (mode === 'tutorial') {
        tabBtnTutorial?.classList.add('is-active');
        tabBtnTutorial?.setAttribute('aria-selected', 'true');
        const pill = tabBtnTutorial?.querySelector('.mhc-status-pill');
        if (pill) {
          pill.textContent = 'ACTIVO';
          pill.className = 'mhc-status-pill is-current';
        }
        if (presetsShelf) presetsShelf.style.display = 'none';
        if (hudMissionDock) hudMissionDock.style.display = 'none';
        if (hudTutorialDock) hudTutorialDock.style.display = 'block';
        showTutorialStep(0);
      } else if (mode === 'sandbox') {
        tabBtnSandbox?.classList.add('is-active');
        tabBtnSandbox?.setAttribute('aria-selected', 'true');
        const pill = tabBtnSandbox?.querySelector('.mhc-status-pill');
        if (pill) {
          pill.textContent = 'ACTIVO';
          pill.className = 'mhc-status-pill is-current';
        }
        if (presetsShelf) presetsShelf.style.display = 'flex';
        if (hudMissionDock) hudMissionDock.style.display = 'none';
        if (hudTutorialDock) hudTutorialDock.style.display = 'none';
        loadPreset(currentPresetName);
      } else if (mode === 'missions') {
        tabBtnMissions?.classList.add('is-active');
        tabBtnMissions?.setAttribute('aria-selected', 'true');
        const pill = tabBtnMissions?.querySelector('.mhc-status-pill');
        if (pill) {
          pill.textContent = 'ACTIVO';
          pill.className = 'mhc-status-pill is-current';
        }
        if (presetsShelf) presetsShelf.style.display = 'none';
        if (hudMissionDock) hudMissionDock.style.display = 'block';
        if (hudTutorialDock) hudTutorialDock.style.display = 'none';
        loadMission(0);
      }
    }

    if (tabBtnTutorial) tabBtnTutorial.addEventListener('click', () => setMode('tutorial'));
    if (tabBtnSandbox) tabBtnSandbox.addEventListener('click', () => setMode('sandbox'));
    if (tabBtnMissions) tabBtnMissions.addEventListener('click', () => setMode('missions'));

    // Botones de navegación del Tutorial
    if (btnTutNext) {
      btnTutNext.addEventListener('click', () => {
        if (currentTutorialStep < TUTORIAL_STEPS.length - 1) {
          showTutorialStep(currentTutorialStep + 1);
        } else {
          setMode('sandbox');
        }
      });
    }

    if (btnTutPrev) {
      btnTutPrev.addEventListener('click', () => {
        if (currentTutorialStep > 0) {
          showTutorialStep(currentTutorialStep - 1);
        }
      });
    }

    if (btnTutClose) {
      btnTutClose.addEventListener('click', () => setMode('sandbox'));
    }

    // Botones de presets
    document.querySelectorAll('.btn-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.id === 'btn-reset-preset') return;
        document.querySelectorAll('.btn-preset').forEach((b) => {
          if (b.id !== 'btn-reset-preset') b.classList.remove('is-active');
        });
        btn.classList.add('is-active');
        const pName = (btn as HTMLElement).dataset.preset || 'solar-inner';
        loadPreset(pName);
      });
    });

    if (btnResetPreset) {
      btnResetPreset.addEventListener('click', () => {
        loadPreset(currentPresetName);
      });
    }

    // Botón de borrado de áreas en el HUD de Kepler 2
    if (btnK2Clear) {
      btnK2Clear.addEventListener('click', () => {
        clearKepler2Areas();
      });
    }

    // Selector de tipo de cuerpo a lanzar
    document.querySelectorAll('.btn-spawn-type').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.btn-spawn-type').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        spawnType = ((btn as HTMLElement).dataset.type as typeof spawnType) || 'planet';
      });
    });

    // Checkbox 2.ª Ley de Kepler
    if (chkKepler2) {
      chkKepler2.addEventListener('change', () => {
        showKepler2Areas = chkKepler2.checked;
        clearKepler2Areas();
        if (hudKepler2Overlay) hudKepler2Overlay.style.display = showKepler2Areas ? 'block' : 'none';
      });
    }

    // Otros checkboxes
    if (chkGravityWell) chkGravityWell.addEventListener('change', () => { showGravityWell = chkGravityWell.checked; });
    if (chkOrbitGuides) chkOrbitGuides.addEventListener('change', () => { showTheoreticalOrbits = chkOrbitGuides.checked; });
    if (chkVelVector) chkVelVector.addEventListener('change', () => { showVelocityVector = chkVelVector.checked; });
    if (chkGravVector) chkGravVector.addEventListener('change', () => { showGravVector = chkGravVector.checked; });
    if (chkOrbitPred) chkOrbitPred.addEventListener('change', () => { showOrbitPredictor = chkOrbitPred.checked; });

    // Controles de tiempo
    if (btnPlayPause) {
      btnPlayPause.addEventListener('click', () => {
        isRunning = !isRunning;
        if (playPauseIcon) playPauseIcon.textContent = isRunning ? '⏸️' : '▶️';
        btnPlayPause.classList.toggle('is-playing', isRunning);
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && e.target === document.body) {
        e.preventDefault();
        btnPlayPause?.click();
      }
    });

    document.querySelectorAll('.btn-warp').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.btn-warp').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        timeWarp = parseFloat((btn as HTMLElement).dataset.warp || '1.0');
      });
    });

    if (btnClearBodies) {
      btnClearBodies.addEventListener('click', () => {
        bodies = bodies.filter(b => b.type === 'star');
        clearKepler2Areas();
      });
    }

    // Herramientas flotantes de zoom y centrado
    if (btnZoomIn) btnZoomIn.addEventListener('click', () => { camZoom = Math.min(4.0, camZoom * 1.25); });
    if (btnZoomOut) btnZoomOut.addEventListener('click', () => { camZoom = Math.max(0.2, camZoom * 0.8); });
    if (btnRecenter) {
      btnRecenter.addEventListener('click', () => {
        camX = 0;
        camY = 0;
        camZoom = 1.0;
      });
    }

    // Botones de Misión
    if (btnMissionRetry) {
      btnMissionRetry.addEventListener('click', () => {
        loadMission(currentMissionIdx);
      });
    }

    if (btnMissionNext) {
      btnMissionNext.addEventListener('click', () => {
        const next = (currentMissionIdx + 1) % MISSIONS.length;
        loadMission(next);
      });
    }

    // =========================================================================
    // CALCULADORA KEPLERIANA DIDÁCTICA (3.ª LEY)
    // =========================================================================
    const calcInput = document.getElementById('calc-semimajor') as HTMLInputElement | null;
    const calcResPeriod = document.getElementById('calc-res-period');
    const calcResVel = document.getElementById('calc-res-vel');
    const calcResRatio = document.getElementById('calc-res-ratio');

    function updateKeplerCalculator() {
      if (!calcInput) return;
      const a = parseFloat(calcInput.value) || 1.0;
      const T_years = Math.sqrt(Math.pow(a, 3));
      const T_days = T_years * 365.25;
      const v_kms = 29.78 / Math.sqrt(a);
      const ratio = (T_years * T_years) / Math.pow(a, 3);

      if (calcResPeriod) calcResPeriod.textContent = `${T_years.toFixed(3)} años terrestres (${T_days.toFixed(1)} días)`;
      if (calcResVel) calcResVel.textContent = `${v_kms.toFixed(2)} km/s`;
      if (calcResRatio) calcResRatio.textContent = `${ratio.toFixed(4)} (Constante Universal)`;
    }

    if (calcInput) calcInput.addEventListener('input', updateKeplerCalculator);

    document.querySelectorAll('.btn-shortcut').forEach((btn) => {
      btn.addEventListener('click', () => {
        const aVal = (btn as HTMLElement).dataset.a;
        if (calcInput && aVal) {
          calcInput.value = aVal;
          updateKeplerCalculator();
        }
      });
    });

    // Iniciar con preset solar
    loadPreset('solar-inner');
    updateKeplerCalculator();
  })();
</script>

<style>
  /* ==========================================================================
     ESTILOS BASE DEL SIMULADOR KEPLERIANO
     ========================================================================== */
