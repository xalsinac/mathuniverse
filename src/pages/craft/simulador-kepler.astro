    flex-shrink: 0;
  }

  .mhc-details {
    flex: 1;
  }

  .mhc-title {
    display: block;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ink, #f8fafc);
    margin-bottom: 0.2rem;
  }

  .mode-hub-card.is-active .mhc-title {
    color: #4d94ff;
  }

  .mhc-desc {
    font-size: 0.76rem;
    line-height: 1.35;
    color: var(--muted, #94a3b8);
    margin: 0;
  }

  /* ARENA DE CANVAS INTERACTIVO */
  .stage-orbital-arena {
    position: relative;
    width: 100%;
    height: 520px;
    background: radial-gradient(circle at center, #0c1524 0%, #060a12 100%);
    border: 1.5px solid rgba(77, 148, 255, 0.35);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.7), 0 8px 30px rgba(0, 0, 0, 0.4);
    touch-action: none;
  }

  @media (max-width: 768px) {
    .stage-orbital-arena {
      height: 420px;
    }
  }

  .kepler-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
  }

  /* HUD DE TELEMETRÍA */
  .hud-telemetry {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(10, 16, 26, 0.82);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    pointer-events: none;
    z-index: 5;
  }

  .hud-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
  }

  .hud-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: var(--muted, #94a3b8);
    font-weight: 700;
  }

  .hud-val {
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    font-weight: 800;
    color: #f8fafc;
  }

  .hud-val.is-cyan {
    color: #38bdf8;
  }

  .hud-val.is-gold {
    color: #ffc14d;
  }

  .hud-conic-pill {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
  }

  .hud-conic-pill.is-circular {
    background: rgba(63, 224, 181, 0.2);
    color: #3fe0b5;
  }

  .hud-conic-pill.is-elliptic {
    background: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
  }

  .hud-conic-pill.is-parabolic {
    background: rgba(251, 146, 60, 0.2);
    color: #fb923c;
  }

  .hud-conic-pill.is-hyperbolic {
    background: rgba(244, 63, 94, 0.2);
    color: #f43f5e;
  }

  /* OVERLAY 2.ª LEY DE KEPLER */
  .hud-kepler2-overlay {
    position: absolute;
    top: 1rem;
    right: 1rem;
    max-width: 330px;
    background: rgba(10, 16, 26, 0.88);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-left: 4px solid #38bdf8;
    border-radius: 10px;
    padding: 0.75rem 0.95rem;
    z-index: 5;
  }

  .k2-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 800;
    color: #38bdf8;
    margin-bottom: 0.45rem;
  }

  .k2-data-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.45rem;
  }

  .k2-metric {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
  }

  .k2-lbl {
    color: var(--muted, #94a3b8);
  }

  .k2-val {
    color: #f8fafc;
    font-weight: 700;
  }

  .k2-val.is-green {
    color: #3fe0b5;
  }

  .k2-note {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--muted, #cbd5e1);
    margin: 0 0 0.55rem;
  }

  .k2-actions-row {
    display: flex;
    justify-content: flex-end;
  }

  .btn-k2-clear {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #cbd5e1;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-k2-clear:hover {
    background: rgba(244, 63, 94, 0.2);
    border-color: #f43f5e;
    color: #f8fafc;
  }

  /* OVERLAY TUTORIAL GUIADO / MODO PRINCIPIANTE */
  .hud-tutorial-dock {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    max-width: 620px;
    margin: 0 auto;
    background: rgba(10, 16, 26, 0.92);
    backdrop-filter: blur(12px);
    border: 1.5px solid #38bdf8;
    border-radius: 14px;
    padding: 1rem 1.35rem;
    z-index: 7;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.6), 0 0 20px rgba(56, 189, 248, 0.15);
  }

  .tutorial-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
  }

  .tut-step-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #38bdf8;
  }

  .tut-close-btn {
    background: transparent;
    border: none;
    color: var(--muted, #94a3b8);
    font-size: 1rem;
    cursor: pointer;
    padding: 0.2rem;
    line-height: 1;
  }

  .tut-close-btn:hover {
    color: #f8fafc;
  }

  .tut-title {
    font-size: 1.05rem;
    font-weight: 800;
    margin: 0 0 0.35rem;
    color: #f8fafc;
  }

  .tut-body {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--muted, #cbd5e1);
    margin: 0 0 0.65rem;
  }

  .tut-body strong {
    color: #f8fafc;
  }

  .tut-callout {
    background: rgba(56, 189, 248, 0.08);
    border-left: 3px solid #38bdf8;
    border-radius: 4px;
    padding: 0.45rem 0.65rem;
    font-size: 0.74rem;
    line-height: 1.35;
    color: #e0f2fe;
    margin-bottom: 0.75rem;
  }

  .tut-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .btn-tut-nav {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-tut-nav.is-prev {
    background: transparent;
    color: var(--muted, #94a3b8);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .btn-tut-nav.is-prev:hover:not(:disabled) {
    color: #f8fafc;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .btn-tut-nav.is-prev:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .btn-tut-nav.is-next {
    background: #38bdf8;
    color: #070c16;
    border: none;
  }

  .btn-tut-nav.is-next:hover {
    background: #7dd3fc;
    transform: translateY(-1px);
  }

  .tut-stepper-dots {
    display: flex;
    gap: 0.35rem;
  }

  .tut-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .tut-dot.is-active {
    background: #38bdf8;
    box-shadow: 0 0 6px #38bdf8;
  }

  .tut-dot.is-done {
    background: rgba(56, 189, 248, 0.5);
  }

  /* OVERLAY DE MISIONES (MODO 3) */
  .hud-mission-dock {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    max-width: 600px;
    margin: 0 auto;
    background: rgba(10, 16, 26, 0.88);
    backdrop-filter: blur(10px);
    border: 1.5px solid #4d94ff;
    border-radius: 12px;
    padding: 0.85rem 1.15rem;
    z-index: 6;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .mission-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .mission-step-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 800;
    color: #4d94ff;
    display: block;
  }

  .mission-title {
    font-size: 1rem;
    font-weight: 800;
    margin: 0;
    color: #f8fafc;
  }

  .mission-status-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: rgba(255, 193, 77, 0.2);
    color: #ffc14d;
    border: 1px solid rgba(255, 193, 77, 0.35);
  }

  .mission-status-badge.is-success {
    background: rgba(63, 224, 181, 0.2);
    color: #3fe0b5;
    border-color: #3fe0b5;
  }

  .mission-objective {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--muted, #cbd5e1);
    margin: 0.25rem 0 0.6rem;
  }

  .mission-progress-bar {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
    margin-bottom: 0.65rem;
  }

  .mission-progress-fill {
    height: 100%;
    background: #3fe0b5;
    transition: width 0.3s ease;
  }

  .mission-actions-row {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .btn-mission-reset,
  .btn-mission-next {
    font-family: var(--font-mono, monospace);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-mission-reset {
    background: transparent;
    color: var(--muted, #94a3b8);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .btn-mission-reset:hover {
    color: #f8fafc;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .btn-mission-next {
    background: #4d94ff;
    color: #070c16;
    border: none;
  }

  .btn-mission-next:hover:not(:disabled) {
    background: #70aaff;
    transform: translateY(-1px);
  }

  .btn-mission-next:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* CONTROLES FLOTANTES DEL CANVAS (ZOOM) */
  .canvas-floating-tools {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    z-index: 5;
  }

  .tool-btn {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(10, 16, 26, 0.78);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #f8fafc;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .tool-btn:hover {
    background: rgba(77, 148, 255, 0.25);
    border-color: #4d94ff;
  }

  .canvas-help-tip {
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(10, 16, 26, 0.75);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    padding: 0.3rem 0.85rem;
    font-size: 0.72rem;
    color: var(--muted, #94a3b8);
    pointer-events: none;
    z-index: 4;
  }

  .canvas-help-tip strong {
    color: #3fe0b5;
  }

  /* BARRA DE PRESETS Y CONTROLES INFERIOR */
  .orbital-dashboard {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .presets-shelf {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.5rem 0.85rem;
  }

  .shelf-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--muted, #94a3b8);
  }

  .presets-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .btn-preset {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--muted, #94a3b8);
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-preset:hover {
    color: #4d94ff;
    border-color: rgba(77, 148, 255, 0.4);
  }

  .btn-preset.is-active {
    background: rgba(77, 148, 255, 0.18);
    border-color: #4d94ff;
    color: #f8fafc;
  }

  .btn-preset.is-reset-btn {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
    color: #f8fafc;
  }

  .btn-preset.is-reset-btn:hover {
    background: rgba(77, 148, 255, 0.2);
    border-color: #4d94ff;
  }

  /* CONTROLES GRID */
  .controls-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .controls-grid {
      grid-template-columns: 1fr;
    }
  }

  .ctrl-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .ctrl-card-title {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--muted, #94a3b8);
    letter-spacing: 0.05em;
  }

  .spawn-type-selector {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.35rem;
  }

  .btn-spawn-type {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--muted, #94a3b8);
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-spawn-type:hover {
    color: #f8fafc;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .btn-spawn-type.is-active {
    background: rgba(77, 148, 255, 0.15);
    border-color: #4d94ff;
    color: #4d94ff;
  }

  .type-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .type-dot.is-probe { background: #38bdf8; }
  .type-dot.is-planet { background: #3fe0b5; }
  .type-dot.is-giant { background: #fb923c; }
  .type-dot.is-star { background: #ffc14d; }

  /* TOGGLES CLUSTER */
  .toggles-cluster {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.35rem;
  }

  .toggle-chip {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    color: var(--muted, #cbd5e1);
    cursor: pointer;
    user-select: none;
  }

  .toggle-chip input {
    display: none;
  }

  .chip-box {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
    transition: all 0.2s ease;
  }

  .toggle-chip input:checked + .chip-box {
    background: #4d94ff;
    border-color: #4d94ff;
  }

  /* MOTOR TEMPORAL & PLAYBACK */
  .playback-dock {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-play-pause {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(77, 148, 255, 0.15);
    border: 1.5px solid #4d94ff;
    color: #f8fafc;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .btn-play-pause:hover {
    background: #4d94ff;
    color: #070c16;
  }

  .time-warp-selector {
    display: flex;
    gap: 0.2rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    padding: 0.15rem;
  }

  .btn-warp {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 700;
    background: transparent;
    border: none;
    color: var(--muted, #94a3b8);
    padding: 0.25rem 0.45rem;
    border-radius: 4px;
    cursor: pointer;
  }

  .btn-warp.is-active {
    background: #4d94ff;
    color: #070c16;
  }

  .btn-ctrl-clear {
    margin-left: auto;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #f43f5e;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .btn-ctrl-clear:hover {
    background: #f43f5e;
    color: #ffffff;
  }

  /* ==========================================================================
     SECCIÓN DIDÁCTICA Y MATEMÁTICA
     ========================================================================== */
  .kepler-theory-section {
    padding: 3rem 1rem 4rem;
  }

  .theory-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .theory-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #4d94ff;
  }

  .theory-title {
    font-size: 1.85rem;
    font-weight: 800;
    margin: 0.4rem 0 0.6rem;
    letter-spacing: -0.01em;
    color: #f8fafc;
  }

  .theory-subtitle {
    font-size: 0.95rem;
    color: var(--muted, #94a3b8);
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* TRIPLE GRID DE LEYES */
  .laws-triple-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 900px) {
    .laws-triple-grid {
      grid-template-columns: 1fr;
    }
  }

  .law-card {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .law-card.is-highlight {
    border-color: rgba(56, 189, 248, 0.4);
    background: rgba(15, 23, 42, 0.85);
    box-shadow: 0 4px 20px rgba(56, 189, 248, 0.12);
  }

  .law-card-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 800;
    color: #4d94ff;
    letter-spacing: 0.08em;
  }

  .law-card-badge.is-accent {
    color: #38bdf8;
  }

  .law-card-title {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0;
    color: #f8fafc;
  }

  .law-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted, #cbd5e1);
    margin: 0;
  }

  .law-desc strong {
    color: #f8fafc;
  }

  .law-subdesc {
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--muted, #94a3b8);
    margin-top: auto;
  }

  /* TARJETAS TÉCNICAS */
  .theory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .theory-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .tcard-icon {
    font-size: 1.35rem;
  }

  .tcard-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    color: #f8fafc;
  }

  .tcard-p {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--muted, #94a3b8);
    margin: 0;
  }

  .theory-steps {
    font-size: 0.82rem;
    color: var(--muted, #94a3b8);
    padding-left: 1.25rem;
    margin: 0.25rem 0;
    line-height: 1.45;
  }

  .math-callout {
    background: rgba(77, 148, 255, 0.08);
    border: 1px solid rgba(77, 148, 255, 0.25);
    border-left: 4px solid #4d94ff;
    border-radius: 8px;
    padding: 0.65rem 0.85rem;
    margin: 0.45rem 0;
    text-align: center;
  }

  .math-formula {
    font-family: var(--font-mono, monospace);
    font-size: 0.95rem;
    font-weight: 700;
    color: #4d94ff;
    letter-spacing: 0.02em;
  }

  .tcard-foot {
