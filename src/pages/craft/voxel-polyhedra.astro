---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---

<BaseLayout
  title="Vóxel Polyhedra 3D & Característica de Euler | Math Universe"
  description="Laboratorio y constructor 3D interactivo de poliedros regulares y formas espaciales con vóxeles. Explora los 5 sólidos platónicos, comprueba la fórmula de Euler (C + V = A + 2) y disecciona volúmenes."
>
  <SiteHeader activePage="craft" statusText="08 · Math Gaming" ctaHref="/craft" ctaLabel="Catálogo Juegos" />

  <main class="polyhedra-page" id="main-content">
    <!-- COCKPIT DEL LABORATORIO 3D -->
    <section class="game-cockpit" id="escenario">
      <div class="cockpit-container">
        <!-- Barra Superior: Navegación, Título y Selector de Modo -->
        <header class="cockpit-header">
          <div class="header-left">
            <a href="/craft" class="back-pill" title="Volver al Catálogo de Math Gaming">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <span>Math Gaming</span>
            </a>
            <div class="header-titles">
              <h1 class="game-title">Vóxel Polyhedra 3D</h1>
              <span class="badge-pill">Euler: C + V − A = 2</span>
            </div>
          </div>

          <div class="header-right-actions">
            <!-- Conmutador de Modo Principal (Poliedros Platónicos vs Taller de Vóxeles) -->
            <div class="mode-toggle-group" role="tablist" aria-label="Modo de visualización y construcción">
              <button
                type="button"
                class="mode-btn is-active"
                data-mode="platonic"
                role="tab"
                aria-selected="true"
                id="tab-platonic"
              >
                <span class="btn-icon">💎</span>
                <span>Sólidos Clásicos</span>
              </button>
              <button
                type="button"
                class="mode-btn"
                data-mode="voxel"
                role="tab"
                aria-selected="false"
                id="tab-voxel"
              >
                <span class="btn-icon">🧱</span>
                <span>Taller Vóxel 3D</span>
              </button>
            </div>

            <!-- Botón Rápido de Tema Claro / Oscuro -->
            <button
              type="button"
              class="hanoi-theme-toggle"
              data-theme-toggle
              aria-label="Cambiar entre modo claro y modo oscuro"
              title="Cambiar modo claro / modo oscuro"
            >
              <svg class="htt-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
              <svg class="htt-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
              </svg>
              <span class="htt-text" data-theme-label>Tema</span>
            </button>
          </div>
        </header>

        <!-- Barra de Control Específica de cada Modo -->
        <!-- Sub-barra 1: Selector de Poliedros Platónicos & Arquimedianos -->
        <div class="sub-controls-bar is-active" id="bar-platonic">
          <div class="preset-scroll-track" role="group" aria-label="Seleccionar poliedro regular">
            <button type="button" class="preset-pill is-active" data-solid="cube">Cubo / Hexaedro</button>
            <button type="button" class="preset-pill" data-solid="tetrahedron">Tetraedro</button>
            <button type="button" class="preset-pill" data-solid="octahedron">Octaedro</button>
            <button type="button" class="preset-pill" data-solid="dodecahedron">Dodecaedro</button>
            <button type="button" class="preset-pill" data-solid="icosahedron">Icosaedro</button>
            <button type="button" class="preset-pill" data-solid="truncated-cube">Cubo Truncado</button>
            <button type="button" class="preset-pill" data-solid="triangular-prism">Prisma Triangular</button>
            <button type="button" class="preset-pill" data-solid="square-pyramid">Pirámide Cuadrangular</button>
          </div>

          <div class="view-toggles">
            <label class="toggle-chip" title="Mostrar u ocultar estructura de aristas">
              <input type="checkbox" id="chk-wireframe" checked />
              <span class="tc-slider"></span>
              <span class="tc-label">Aristas</span>
            </label>
            <label class="toggle-chip" title="Mostrar vértices iluminados">
              <input type="checkbox" id="chk-vertices" checked />
              <span class="tc-slider"></span>
              <span class="tc-label">Vértices</span>
            </label>
            <label class="toggle-chip" title="Caras semitransparentes / Rayos X">
              <input type="checkbox" id="chk-translucent" />
              <span class="tc-slider"></span>
              <span class="tc-label">Rayos X</span>
            </label>
            <label class="toggle-chip" title="Rotación orbital continua">
              <input type="checkbox" id="chk-autorotate" checked />
              <span class="tc-slider"></span>
              <span class="tc-label">Giro</span>
            </label>
          </div>
        </div>

        <!-- Sub-barra 2: Herramientas del Taller Vóxel 3D -->
        <div class="sub-controls-bar" id="bar-voxel" hidden>
          <div class="voxel-tools-group">
            <span class="vt-label">Herramienta:</span>
            <div class="tool-switch-btns">
              <button type="button" class="tool-btn is-active" data-tool="add" title="Poner cubo (Clic sobre cualquier cara)">
                <span>➕</span> Poner Bloque
              </button>
              <button type="button" class="tool-btn" data-tool="remove" title="Picar o borrar cubo (Clic para eliminar)">
                <span>⛏️</span> Picar Bloque
              </button>
            </div>
          </div>

          <div class="voxel-palette-group">
            <span class="vt-label">Material:</span>
            <div class="color-swatches" id="color-palette">
              <button type="button" class="swatch is-active" data-color="#b48cff" style="--swatch:#b48cff;" title="Amatista Matemático"></button>
              <button type="button" class="swatch" data-color="#38bdf8" style="--swatch:#38bdf8;" title="Cyan Cuántico"></button>
              <button type="button" class="swatch" data-color="#3fe0b5" style="--swatch:#3fe0b5;" title="Esmeralda"></button>
              <button type="button" class="swatch" data-color="#fbbf24" style="--swatch:#fbbf24;" title="Oro / Obsidiana"></button>
              <button type="button" class="swatch" data-color="#f43f5e" style="--swatch:#f43f5e;" title="Rubí Neón"></button>
              <button type="button" class="swatch" data-color="#f8fafc" style="--swatch:#f8fafc;" title="Mármol Blanco"></button>
            </div>
          </div>

          <div class="voxel-presets-group">
            <span class="vt-label">Plantillas:</span>
            <select id="select-voxel-preset" class="preset-dropdown">
              <option value="cube2">Cubo 2×2×2 (8 vóxeles)</option>
              <option value="cube3">Cubo 3×3×3 (27 vóxeles)</option>
              <option value="pyramid">Pirámide Escalonada</option>
              <option value="torus">Toroide con Agujero (Género 1)</option>
              <option value="menger">Cruz 3D de Menger</option>
              <option value="clear">Plataforma Base Vacía</option>
            </select>
            <button type="button" class="btn-clear-voxels" id="btn-reset-voxels" title="Reiniciar construcción a la plataforma base">
              Limpiar
            </button>
          </div>
        </div>

        <!-- ESCENARIO 3D INTERACTIVO -->
        <div class="stage-arena" id="arena-viewport">
          <!-- Canvas 3D de Alto Rendimiento -->
          <canvas id="polyhedra-canvas" class="render-canvas"></canvas>

          <!-- Velo de Interacción / HUD Superior flotante con info de sólido -->
          <div class="canvas-floating-header">
            <div class="solid-title-box">
              <span class="st-category" id="solid-type-badge">Sólido Platónico</span>
              <h2 class="st-name" id="solid-display-name">Hexaedro Regular (Cubo)</h2>
            </div>

            <!-- Botones de Cámara y Zoom Rápido -->
            <div class="camera-actions">
              <button type="button" class="btn-cam" id="btn-zoom-in" title="Acercar zoom (+)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              </button>
              <button type="button" class="btn-cam" id="btn-zoom-out" title="Alejar zoom (−)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              </button>
              <button type="button" class="btn-cam" id="btn-cam-reset" title="Restablecer orientación inicial">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><polyline points="3 3 3 8 8 8"></polyline></svg>
              </button>
              <button type="button" class="btn-cam" id="btn-audio-toggle" title="Activar/Silenciar sonido táctil">
                <span id="audio-icon-status">🔊</span>
              </button>
            </div>
          </div>

          <!-- Slider de Despliegue / Explosión de Caras (Solo activo en modo Poliedro) -->
          <div class="explosion-control-dock" id="dock-explosion">
            <div class="dock-label-row">
              <span class="d-title">💥 Explosión de Caras (Descomposición Piramidal):</span>
              <span class="d-val" id="explosion-pct">0%</span>
            </div>
            <input
              type="range"
              id="slider-explosion"
              min="0"
              max="100"
              value="0"
              class="range-slider"
              title="Separa cada cara en dirección a su vector normal exterior"
            />
          </div>

          <!-- Indicador de Navegación 3D en la esquina -->
          <div class="canvas-help-hint">
            <span class="hint-icon">🖐️</span>
            <span id="canvas-hint-text">Arrastra para rotar 360° · Rueda para zoom</span>
          </div>
        </div>

        <!-- DOCK DE MÉTRICAS MATEMÁTICAS & TOPOLOGÍA EN VIVO -->
        <div class="metrics-grid">
          <!-- Tarjeta 1: Característica de Euler -->
          <div class="metric-card card-euler">
            <div class="mc-header">
              <span class="mc-tag">TOPOLOGÍA DE EULER</span>
              <span class="mc-formula">C + V − A = <strong id="euler-result">2</strong></span>
            </div>
            <div class="euler-counts-row">
              <div class="euler-chip">
                <span class="ec-num" id="metric-faces">6</span>
                <span class="ec-lbl">Caras (C)</span>
              </div>
              <span class="ec-op">+</span>
              <div class="euler-chip">
                <span class="ec-num" id="metric-vertices">8</span>
                <span class="ec-lbl">Vértices (V)</span>
              </div>
              <span class="ec-op">−</span>
              <div class="euler-chip">
                <span class="ec-num" id="metric-edges">12</span>
                <span class="ec-lbl">Aristas (A)</span>
              </div>
            </div>
            <div class="euler-status-badge" id="euler-badge">
              <span class="status-dot"></span>
              <span id="euler-status-text">Esfera Topológica (Sólido Conexo, Género 0)</span>
            </div>
          </div>

          <!-- Tarjeta 2: Volumen y Superficie Analítica -->
          <div class="metric-card card-volume">
            <div class="mc-header">
              <span class="mc-tag">GEOMETRÍA MÉTRICA</span>
              <span class="mc-subtitle" id="vol-mode-label">Arista base <em>a</em>:</span>
            </div>

            <div class="param-input-row" id="edge-param-wrap">
              <label for="input-edge-a">Longitud <em>a</em>:</label>
              <input type="range" id="slider-edge-a" min="1" max="10" step="0.5" value="4" class="range-slider-small" />
              <span class="param-val"><span id="val-edge-a">4.0</span> u</span>
            </div>

            <div class="metric-dual-stats">
              <div class="stat-pair">
                <span class="sp-lbl">Área Superficial (<em>A</em>):</span>
                <span class="sp-val" id="metric-surface">96.00 u²</span>
              </div>
              <div class="stat-pair">
                <span class="sp-lbl">Volumen Total (<em>V</em>):</span>
                <span class="sp-val text-accent" id="metric-volume">64.00 u³</span>
              </div>
            </div>

            <!-- Detalle específico de vóxeles (caras internas ocultas vs externas) -->
            <div class="voxel-face-breakdown" id="voxel-stats-extra" hidden>
              <div class="vf-item">
                <span class="vf-lbl">Bloques:</span>
                <span class="vf-val" id="stat-voxel-count">8</span>
              </div>
              <div class="vf-item">
                <span class="vf-lbl">Caras Externas:</span>
                <span class="vf-val text-cyan" id="stat-voxel-ext-faces">24</span>
              </div>
              <div class="vf-item">
                <span class="vf-lbl">Caras Fusionadas:</span>
                <span class="vf-val text-muted" id="stat-voxel-int-faces">24</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DIDÁCTICA MATEMÁTICA Y TEÓRICA -->
    <section class="polyhedra-theory-section" id="teoria">
      <div class="theory-container">
        <header class="theory-header">
          <span class="section-tag">FUNDAMENTOS DE GEOMETRÍA ESPACIAL & TOPOLOGÍA</span>
          <h2 class="theory-title">La Anatomía Matemática de los Poliedros</h2>
          <p class="theory-subtitle">
            Desde la demostración de Euclides de que solo pueden existir cinco sólidos regulares hasta el teorema topológico de Leonhard Euler y la geometría discreta de vóxeles en computación.
          </p>
        </header>

        <div class="theory-grid">
          <!-- Tarjeta 1: Por qué solo existen 5 Sólidos Platónicos -->
          <article class="theory-card">
            <div class="tcard-icon">📐</div>
            <h3 class="tcard-title">El Teorema de los 5 Sólidos Platónicos</h3>
            <p class="tcard-p">
              En un espacio euclídeo tridimensional, es geométricamente imposible construir más de cinco poliedros regulares convexos. La demostración matemática se basa en la <strong>suma de ángulos en un vértice</strong>:
            </p>
            <ol class="theory-steps">
              <li>En cada vértice deben concurrir al menos <strong>3 caras</strong>.</li>
              <li>La suma de los ángulos que coinciden en el vértice debe ser <strong>estrictamente menor que 360°</strong> (de lo contrario, las caras quedarían planas o se solaparían).</li>
              <li>Con triángulos equiláteros (60°): caben 3 (Tetraedro = 180°), 4 (Octaedro = 240°) o 5 (Icosaedro = 300°). Con 6 caras sumarían 360° (teselación plana).</li>
              <li>Con cuadrados (90°): caben exactamente 3 (Cubo = 270°). Con 4 sumarían 360°.</li>
              <li>Con pentágonos regulares (108°): caben exactamente 3 (Dodecaedro = 324°). Con hexágonos (120°) 3 caras sumarían 360°, cerrando el espectro regular.</li>
            </ol>
          </article>

          <!-- Tarjeta 2: La Fórmula de Euler y el Género Topológico -->
          <article class="theory-card">
            <div class="tcard-icon">⚡</div>
            <h3 class="tcard-title">La Característica de Euler: <em>C</em> + <em>V</em> − <em>A</em> = 2</h3>
            <p class="tcard-p">
              Enunciada por Leonhard Euler en 1752 y demostrada con rigor por Cauchy y Poincaré, esta fórmula es el primer <strong>invariante topológico</strong> descubierto en la historia:
            </p>
            <div class="math-callout">
              <span class="math-formula">&chi; = <em>C</em> + <em>V</em> − <em>A</em> = 2(1 − <em>g</em>)</span>
            </div>
            <p class="tcard-p">
              Donde <em>g</em> es el <strong>género topológico</strong> (número de agujeros o túneles del cuerpo).
            </p>
            <ul class="theory-bullets">
              <li>Cualquier sólido cerrado y macizo (género <em>g</em> = 0, homeomorfo a una esfera) verifica siempre <strong><em>C</em> + <em>V</em> − <em>A</em> = 2</strong>, sin importar cuántos vértices o deformaciones sufra.</li>
              <li>Si construyes en el taller vóxel un anillo o toroide (género <em>g</em> = 1 con 1 túnel central), ¡la característica cae exactamente a <strong>&chi; = 0</strong>!</li>
            </ul>
          </article>

          <!-- Tarjeta 3: Descomposición en Pirámides del Volumen -->
          <article class="theory-card">
            <div class="tcard-icon">💥</div>
            <h3 class="tcard-title">Descomposición Volumétrica y Apotema</h3>
            <p class="tcard-p">
              Al activar el control de <strong>Explosión de Caras</strong> del simulador, cada cara se desplaza radialmente hacia afuera. Esto revela el secreto de cómo calcular el volumen exacto de cualquier poliedro regular:
            </p>
            <div class="math-callout">
              <span class="math-formula"><em>V</em><sub>total</sub> = &sum; <em>V</em><sub>pirámides</sub> = <sup>1</sup>/<sub>3</sub> &middot; <em>A</em><sub>superficial</sub> &middot; <em>r</em><sub>inscrito</sub></span>
            </div>
            <p class="tcard-foot">
              Cualquier poliedro regular puede descomponerse en <em>C</em> pirámides idénticas cuya base es una cara del poliedro y cuya altura es exactamente el <strong>radio de la esfera inscrita</strong> (apotema tridimensional).
            </p>
          </article>

          <!-- Tarjeta 4: Geometría de Vóxeles y Oclusión en Gráficos -->
          <article class="theory-card">
            <div class="tcard-icon">🧱</div>
            <h3 class="tcard-title">De la Geometría Continua al Vóxel (Minecraft & Raymarching)</h3>
            <p class="tcard-p">
              Un <strong>vóxel</strong> (del inglés <em>volumetric pixel</em>) es el análogo tridimensional de un píxel. En la computación gráfica moderna (videojuegos voxel, tomografías axiales computarizadas TAC y mallas de fluidos):
            </p>
            <ul class="theory-bullets">
              <li><strong>Culling de Caras Internas</strong>: Cada cubo individual tiene 6 caras. Al unir dos vóxeles adyacentes, sus 2 caras coincidentes se ocultan internamente. El motor gráfico elimina del renderizado las caras con normales opuestas compartidas.</li>
              <li><strong>Volumen por suma discreta</strong>: A diferencia de los poliedros continuos, el volumen de un ensamble de vóxeles es simplemente <em>N &middot; u³</em>, facilitando el cálculo de masas de geometrías arbitrariamente complejas.</li>
            </ul>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  (() => {
    // =========================================================================
    // 1. MOTOR MATEMÁTICO 3D (CANVAS 2D CON PROYECCIÓN PERSPECTIVA)
    // =========================================================================
    const canvas = document.getElementById('polyhedra-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Estado del Motor
    let currentMode: 'platonic' | 'voxel' = 'platonic';
    let currentSolidId = 'cube';
    let autoRotate = true;
    let showWireframe = true;
    let showVertices = true;
    let isTranslucent = false;
    let explosionFactor = 0; // 0 a 1
    let edgeLengthA = 4.0;
    let soundEnabled = true;

    // Cámara y Rotación
    let rotX = 0.55;
    let rotY = -0.65;
    let zoom = 1.0;
    let isDragging = false;
    let lastX = 0;
    let lastY = 0;

    // Herramientas de Vóxel
    let voxelTool: 'add' | 'remove' = 'add';
    let currentVoxelColor = '#b48cff';

    // Tipos de Geometría
    interface Point3D {
      x: number;
      y: number;
      z: number;
    }

    interface FaceDef {
      indices: number[];
      normal?: Point3D;
      centroid?: Point3D;
      color?: string;
    }

    interface SolidModel {
      name: string;
      category: string;
      vertices: Point3D[];
      faces: FaceDef[];
      edgeFormula: string;
      volFormula: (a: number) => number;
      surfFormula: (a: number) => number;
      defaultColor: string;
    }

    // =========================================================================
    // 2. MODELOS MATEMÁTICOS PLATÓNICOS & ARQUIMEDIANOS
    // =========================================================================
    const PHI = (1 + Math.sqrt(5)) / 2; // Proporción Áurea (~1.6180339887)

    function normalize(v: Point3D): Point3D {
      const len = Math.hypot(v.x, v.y, v.z) || 1;
      return { x: v.x / len, y: v.y / len, z: v.z / len };
    }

    function computeFaceCentroidAndNormal(vertices: Point3D[], indices: number[]): { centroid: Point3D; normal: Point3D } {
      let cx = 0, cy = 0, cz = 0;
      for (const idx of indices) {
        cx += vertices[idx].x;
        cy += vertices[idx].y;
        cz += vertices[idx].z;
      }
      const n = indices.length;
      const centroid = { x: cx / n, y: cy / n, z: cz / n };

      // Normal mediante producto cruz de dos aristas de la cara
      const v0 = vertices[indices[0]];
      const v1 = vertices[indices[1]];
      const v2 = vertices[indices[2]];
      const ax = v1.x - v0.x, ay = v1.y - v0.y, az = v1.z - v0.z;
      const bx = v2.x - v0.x, by = v2.y - v0.y, bz = v2.z - v0.z;
      let nx = ay * bz - az * by;
      let ny = az * bx - ax * bz;
      let nz = ax * by - ay * bx;
      // Garantizar que la normal apunte siempre hacia el exterior del poliedro convexo
      if (centroid.x * nx + centroid.y * ny + centroid.z * nz < 0) {
        nx = -nx;
        ny = -ny;
        nz = -nz;
      }
      return { centroid, normal: normalize({ x: nx, y: ny, z: nz }) };
    }

    // Generador de Poliedros Clásicos
    const SOLIDS_CATALOG: Record<string, SolidModel> = {
      // 1. Hexaedro / Cubo
      cube: {
        name: 'Hexaedro Regular (Cubo)',
        category: 'Sólido Platónico',
        vertices: [
          { x: -1, y: -1, z: -1 }, { x: 1, y: -1, z: -1 },
          { x: 1, y: 1, z: -1 }, { x: -1, y: 1, z: -1 },
          { x: -1, y: -1, z: 1 }, { x: 1, y: -1, z: 1 },
          { x: 1, y: 1, z: 1 }, { x: -1, y: 1, z: 1 },
        ],
        faces: [
          { indices: [0, 3, 2, 1] }, // Trasera
          { indices: [4, 5, 6, 7] }, // Frontal
          { indices: [0, 1, 5, 4] }, // Inferior
          { indices: [2, 3, 7, 6] }, // Superior
          { indices: [0, 4, 7, 3] }, // Izquierda
          { indices: [1, 2, 6, 5] }, // Derecha
        ],
        edgeFormula: 'a',
        volFormula: (a) => Math.pow(a, 3),
        surfFormula: (a) => 6 * Math.pow(a, 2),
        defaultColor: '#b48cff',
      },

      // 2. Tetraedro Regular
      tetrahedron: {
        name: 'Tetraedro Regular',
        category: 'Sólido Platónico',
        vertices: [
          { x: 1, y: 1, z: 1 },
          { x: 1, y: -1, z: -1 },
          { x: -1, y: 1, z: -1 },
          { x: -1, y: -1, z: 1 },
        ],
        faces: [
          { indices: [0, 1, 2] },
          { indices: [0, 3, 1] },
          { indices: [0, 2, 3] },
          { indices: [1, 3, 2] },
        ],
        edgeFormula: 'a',
        volFormula: (a) => (Math.pow(a, 3) * Math.SQRT2) / 12,
        surfFormula: (a) => Math.pow(a, 2) * Math.sqrt(3),
        defaultColor: '#38bdf8',
      },

      // 3. Octaedro Regular
      octahedron: {
        name: 'Octaedro Regular',
        category: 'Sólido Platónico',
        vertices: [
          { x: 1, y: 0, z: 0 }, { x: -1, y: 0, z: 0 },
          { x: 0, y: 1, z: 0 }, { x: 0, y: -1, z: 0 },
