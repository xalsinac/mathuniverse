        ],
        edgeFormula: 'a',
        volFormula: (a) => (Math.pow(a, 3) * Math.SQRT2) / 3,
        surfFormula: (a) => 2 * Math.pow(a, 2) * Math.sqrt(3),
        defaultColor: '#3fe0b5',
      },

      // 4. Dodecaedro Regular
      dodecahedron: {
        name: 'Dodecaedro Regular',
        category: 'Sólido Platónico',
        vertices: (() => {
          const invPhi = 1 / PHI;
          const verts: Point3D[] = [];
          for (const x of [-1, 1]) {
            for (const y of [-1, 1]) {
              for (const z of [-1, 1]) {
                verts.push({ x, y, z });
              }
            }
          }
          for (const y of [-PHI, PHI]) {
            for (const z of [-invPhi, invPhi]) {
              verts.push({ x: 0, y, z });
            }
          }
          for (const x of [-invPhi, invPhi]) {
            for (const z of [-PHI, PHI]) {
              verts.push({ x, y: 0, z });
            }
          }
          for (const x of [-PHI, PHI]) {
            for (const y of [-invPhi, invPhi]) {
              verts.push({ x, y, z: 0 });
            }
          }
          return verts;
        })(),
        faces: [
          { indices: [0, 12, 14, 4, 8] },
          { indices: [1, 16, 0, 8, 9] },
          { indices: [16, 17, 2, 12, 0] },
          { indices: [13, 1, 9, 5, 15] },
          { indices: [2, 17, 3, 11, 10] },
          { indices: [4, 14, 6, 19, 18] },
          { indices: [12, 2, 10, 6, 14] },
          { indices: [9, 8, 4, 18, 5] },
          { indices: [17, 16, 1, 13, 3] },
          { indices: [3, 13, 15, 7, 11] },
          { indices: [10, 11, 7, 19, 6] },
          { indices: [7, 15, 5, 18, 19] },
        ],
        edgeFormula: 'a',
        volFormula: (a) => ((15 + 7 * Math.sqrt(5)) / 4) * Math.pow(a, 3),
        surfFormula: (a) => 3 * Math.sqrt(25 + 10 * Math.sqrt(5)) * Math.pow(a, 2),
        defaultColor: '#fbbf24',
      },

      // 5. Icosaedro Regular
      icosahedron: {
        name: 'Icosaedro Regular',
        category: 'Sólido Platónico',
        vertices: [
          { x: 0, y: -1, z: -PHI }, { x: 0, y: 1, z: -PHI },
          { x: 0, y: -1, z: PHI },  { x: 0, y: 1, z: PHI },
          { x: -1, y: -PHI, z: 0 }, { x: 1, y: -PHI, z: 0 },
          { x: -1, y: PHI, z: 0 },  { x: 1, y: PHI, z: 0 },
          { x: -PHI, y: 0, z: -1 }, { x: -PHI, y: 0, z: 1 },
          { x: PHI, y: 0, z: -1 },  { x: PHI, y: 0, z: 1 },
        ],
        faces: [
          { indices: [0, 1, 8] },  { indices: [0, 10, 1] }, { indices: [0, 8, 4] },  { indices: [0, 5, 10] },
          { indices: [0, 4, 5] },  { indices: [1, 7, 6] },  { indices: [1, 6, 8] },  { indices: [1, 10, 7] },
          { indices: [2, 3, 11] }, { indices: [2, 9, 3] },  { indices: [2, 4, 9] },  { indices: [2, 5, 4] },
          { indices: [2, 11, 5] }, { indices: [3, 7, 11] }, { indices: [3, 6, 7] },  { indices: [3, 9, 6] },
          { indices: [4, 8, 9] },  { indices: [5, 11, 10] }, { indices: [6, 9, 8] }, { indices: [7, 10, 11] },
        ],
        edgeFormula: 'a',
        volFormula: (a) => (5 * (3 + Math.sqrt(5)) / 12) * Math.pow(a, 3),
        surfFormula: (a) => 5 * Math.sqrt(3) * Math.pow(a, 2),
        defaultColor: '#f43f5e',
      },

      // 6. Cubo Truncado
      'truncated-cube': {
        name: 'Cubo Truncado (14 Caras)',
        category: 'Sólido Arquimediano',
        vertices: (() => {
          const t = Math.SQRT2 - 1; // Factor de truncamiento
          const verts: Point3D[] = [];
          for (const x of [-1, 1]) {
            for (const y of [-1, 1]) {
              for (const z of [-1, 1]) {
                verts.push({ x: x * t, y: y, z: z });
                verts.push({ x: x, y: y * t, z: z });
                verts.push({ x: x, y: y, z: z * t });
              }
            }
          }
          return verts;
        })(),
        faces: [
          // 6 octógonos regulares y 8 triángulos equiláteros
          { indices: [16, 17, 14, 13, 19, 20, 23, 22] },
          { indices: [1, 2, 5, 4, 10, 11, 8, 7] },
          { indices: [6, 8, 11, 9, 21, 23, 20, 18] },
          { indices: [3, 5, 2, 0, 12, 14, 17, 15] },
          { indices: [9, 10, 4, 3, 15, 16, 22, 21] },
          { indices: [0, 1, 7, 6, 18, 19, 13, 12] },
          { indices: [2, 1, 0] },
          { indices: [4, 5, 3] },
          { indices: [7, 8, 6] },
          { indices: [11, 10, 9] },
          { indices: [12, 13, 14] },
          { indices: [15, 17, 16] },
          { indices: [18, 20, 19] },
          { indices: [21, 22, 23] },
        ],
        edgeFormula: 'a',
        volFormula: (a) => ((21 + 14 * Math.SQRT2) / 3) * Math.pow(a, 3) * 0.1,
        surfFormula: (a) => 2 * (6 + 6 * Math.SQRT2 + Math.sqrt(3)) * Math.pow(a, 2) * 0.2,
        defaultColor: '#c084fc',
      },

      // 7. Prisma Triangular
      'triangular-prism': {
        name: 'Prisma Triangular Regular',
        category: 'Prisma Semirregular',
        vertices: [
          // Base inferior
          { x: 0, y: -1, z: 1 }, { x: 0.866, y: -1, z: -0.5 }, { x: -0.866, y: -1, z: -0.5 },
          // Base superior
          { x: 0, y: 1, z: 1 },  { x: 0.866, y: 1, z: -0.5 },  { x: -0.866, y: 1, z: -0.5 },
        ],
        faces: [
          { indices: [0, 1, 2] }, // Base inferior
          { indices: [3, 5, 4] }, // Base superior
          { indices: [0, 3, 4, 1] }, // Cara lateral 1
          { indices: [1, 4, 5, 2] }, // Cara lateral 2
          { indices: [2, 5, 3, 0] }, // Cara lateral 3
        ],
        edgeFormula: 'a',
        volFormula: (a) => (Math.sqrt(3) / 4) * Math.pow(a, 3),
        surfFormula: (a) => ((Math.sqrt(3) / 2) + 3) * Math.pow(a, 2),
        defaultColor: '#38bdf8',
      },

      // 8. Pirámide Cuadrangular
      'square-pyramid': {
        name: 'Pirámide de Base Cuadrada',
        category: 'Pirámide Regular',
        vertices: [
          { x: -1, y: -0.7, z: -1 }, { x: 1, y: -0.7, z: -1 },
          { x: 1, y: -0.7, z: 1 },   { x: -1, y: -0.7, z: 1 },
          { x: 0, y: 1.1, z: 0 },    // Cúspide
        ],
        faces: [
          { indices: [0, 3, 2, 1] }, // Base cuadrada
          { indices: [0, 1, 4] },    // Triángulo 1
          { indices: [1, 2, 4] },    // Triángulo 2
          { indices: [2, 3, 4] },    // Triángulo 3
          { indices: [3, 0, 4] },    // Triángulo 4
        ],
        edgeFormula: 'a',
        volFormula: (a) => (Math.SQRT2 / 6) * Math.pow(a, 3),
        surfFormula: (a) => (1 + Math.sqrt(3)) * Math.pow(a, 2),
        defaultColor: '#f59e0b',
      },
    };

    // Precomputar normales y centroides para cada cara
    Object.values(SOLIDS_CATALOG).forEach((solid) => {
      solid.faces.forEach((face) => {
        const { centroid, normal } = computeFaceCentroidAndNormal(solid.vertices, face.indices);
        face.centroid = centroid;
        face.normal = normal;
      });
    });

    // =========================================================================
    // 3. ESTRUCTURA DE DATOS PARA EL TALLER VÓXEL 3D
    // =========================================================================
    interface Voxel {
      x: number;
      y: number;
      z: number;
      color: string;
    }

    let voxels: Voxel[] = [];

    // Generar presets de vóxeles
    function loadVoxelPreset(preset: string, playAudio: boolean = false) {
      voxels = [];
      if (preset === 'cube2') {
        for (let x = -1; x <= 0; x++) {
          for (let y = -1; y <= 0; y++) {
            for (let z = -1; z <= 0; z++) {
              voxels.push({ x, y, z, color: currentVoxelColor });
            }
          }
        }
      } else if (preset === 'cube3') {
        for (let x = -1; x <= 1; x++) {
          for (let y = -1; y <= 1; y++) {
            for (let z = -1; z <= 1; z++) {
              voxels.push({ x, y, z, color: currentVoxelColor });
            }
          }
        }
      } else if (preset === 'pyramid') {
        // Base 3x3
        for (let x = -1; x <= 1; x++) {
          for (let z = -1; z <= 1; z++) {
            voxels.push({ x, y: -1, z, color: '#fbbf24' });
          }
        }
        // Nivel 2: 2x2
        for (let x = -0.5; x <= 0.5; x += 1) {
          for (let z = -0.5; z <= 0.5; z += 1) {
            voxels.push({ x: Math.floor(x), y: 0, z: Math.floor(z), color: '#f59e0b' });
          }
        }
        // Cúspide: 1x1
        voxels.push({ x: 0, y: 1, z: 0, color: '#f43f5e' });
      } else if (preset === 'torus') {
        // Toroide / Anillo con agujero central (3x3 con centro vacío en Y=0)
        for (let x = -1; x <= 1; x++) {
          for (let z = -1; z <= 1; z++) {
            if (x === 0 && z === 0) continue; // Hueco del toro
            voxels.push({ x, y: 0, z, color: '#38bdf8' });
          }
        }
      } else if (preset === 'menger') {
        // Cruz 3D central
        voxels.push({ x: 0, y: 0, z: 0, color: '#b48cff' });
        voxels.push({ x: 1, y: 0, z: 0, color: '#3fe0b5' });
        voxels.push({ x: -1, y: 0, z: 0, color: '#3fe0b5' });
        voxels.push({ x: 0, y: 1, z: 0, color: '#fbbf24' });
        voxels.push({ x: 0, y: -1, z: 0, color: '#fbbf24' });
        voxels.push({ x: 0, y: 0, z: 1, color: '#f43f5e' });
        voxels.push({ x: 0, y: 0, z: -1, color: '#f43f5e' });
      } else if (preset === 'clear') {
        // Plataforma base 3x3 a modo de suelo técnico
        for (let x = -1; x <= 1; x++) {
          for (let z = -1; z <= 1; z++) {
            voxels.push({ x, y: -1, z, color: '#475569' });
          }
        }
      }
      if (playAudio) {
        playBlockSound(true);
      }
      updateMetricsUI();
    }

    // =========================================================================
    // 4. SÍNTESIS DE AUDIO WEB PURA (FEEDBACK HÁPTICO AUDITIVO)
    // =========================================================================
    let audioCtx: AudioContext | null = null;

    function getAudio(): AudioContext | null {
      if (!soundEnabled) return null;
      if (!audioCtx) {
        const AudioClass = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioClass) audioCtx = new AudioClass();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playBlockSound(isAdd: boolean) {
      const actx = getAudio();
      if (!actx) return;
      try {
        const osc = actx.createOscillator();
        const gain = actx.createGain();
        osc.connect(gain);
        gain.connect(actx.destination);

        const now = actx.currentTime;
        if (isAdd) {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(320, now);
          osc.frequency.exponentialRampToValueAtTime(640, now + 0.08);
          gain.gain.setValueAtTime(0.2, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
          osc.start(now);
          osc.stop(now + 0.1);
        } else {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(180, now);
          osc.frequency.exponentialRampToValueAtTime(70, now + 0.09);
          gain.gain.setValueAtTime(0.25, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
          osc.start(now);
          osc.stop(now + 0.1);
        }
      } catch (err) {
        // Silenciar cualquier restricción de autoplay del navegador
      }
    }

    function playChime() {
      const actx = getAudio();
      if (!actx) return;
      try {
        const osc = actx.createOscillator();
        const gain = actx.createGain();
        osc.connect(gain);
        gain.connect(actx.destination);

        const now = actx.currentTime;
        osc.type = 'sine';
        osc.frequency.setValueAtTime(520, now);
        osc.frequency.exponentialRampToValueAtTime(780, now + 0.15);
        gain.gain.setValueAtTime(0.12, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
        osc.start(now);
        osc.stop(now + 0.18);
      } catch (err) {
        // Silenciar audio si el navegador bloquea
      }
    }

    // Inicializar vóxeles predeterminados directamente (2x2 cubo centrado)
    for (let x = 0; x < 2; x++) {
      for (let y = 0; y < 2; y++) {
        for (let z = 0; z < 2; z++) {
          voxels.push({ x: x - 0.5, y: y - 0.5, z: z - 0.5, color: '#b48cff' });
        }
      }
    }

    // =========================================================================
    // 5. PROYECCIÓN Y RENDERIZADO 3D (PAINTER'S ALGORITHM)
    // =========================================================================
    function rotatePoint(p: Point3D, rx: number, ry: number): Point3D {
      // Rotación alrededor de Y
      const cosY = Math.cos(ry);
      const sinY = Math.sin(ry);
      const x1 = p.x * cosY + p.z * sinY;
      const z1 = -p.x * sinY + p.z * cosY;

      // Rotación alrededor de X
      const cosX = Math.cos(rx);
      const sinX = Math.sin(rx);
      const y2 = p.y * cosX - z1 * sinX;
      const z2 = p.y * sinX + z1 * cosX;

      return { x: x1, y: y2, z: z2 };
    }

    interface ProjectedFace {
      points: { x: number; y: number }[];
      depth: number;
      normalZ: number;
      baseColor: string;
      lightFactor: number;
      indices?: number[];
      voxelRef?: { x: number; y: number; z: number; faceIdx: number };
    }

    // Comprobar si un punto 2D está dentro de un polígono 2D
    function isPointInPoly(px: number, py: number, poly: { x: number; y: number }[]): boolean {
      let inside = false;
      for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
        const xi = poly[i].x, yi = poly[i].y;
        const xj = poly[j].x, yj = poly[j].y;
        const intersect = ((yi > py) !== (yj > py)) && (px < (xj - xi) * (py - yi) / (yj - yi) + xi);
        if (intersect) inside = !inside;
      }
      return inside;
    }

    let hoveredVoxelFace: ProjectedFace | null = null;
    let canvasMouseX = -1000;
    let canvasMouseY = -1000;

    function render() {
      if (!ctx || !canvas) return;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;

      if (canvas.width !== Math.floor(w * dpr) || canvas.height !== Math.floor(h * dpr)) {
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
      }

      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      // Auto-rotación si no estamos arrastrando
      if (autoRotate && !isDragging) {
        rotY += 0.0075;
      }

      const cx = w / 2;
      const cy = h / 2;
      const isDark = document.documentElement.dataset.theme !== 'light';

      // Base scale
      const scale = Math.min(w, h) * 0.22 * zoom;
      const cameraDistance = 6.5;

      // Luz direccional superior derecha frontal
      const lightDir = normalize({ x: 0.5, y: 0.7, z: 0.65 });

      const facesToDraw: ProjectedFace[] = [];

      // MODO 1: POLIEDROS PLATÓNICOS / CLÁSICOS
      if (currentMode === 'platonic') {
        const model = SOLIDS_CATALOG[currentSolidId] || SOLIDS_CATALOG.cube;

        model.faces.forEach((face) => {
          const centroid = face.centroid || { x: 0, y: 0, z: 0 };
          const normal = face.normal || { x: 0, y: 0, z: 1 };

          // Desplazamiento por explosión de caras
          const explodeDist = explosionFactor * 1.35;
          const offset = {
            x: normal.x * explodeDist,
            y: normal.y * explodeDist,
            z: normal.z * explodeDist,
          };

          const rotNormal = rotatePoint(normal, rotX, rotY);
          const rotCentroid = rotatePoint({
            x: centroid.x + offset.x,
            y: centroid.y + offset.y,
            z: centroid.z + offset.z,
          }, rotX, rotY);

          // Culling exacto en perspectiva: comprobar si la cara mira hacia la cámara en (0, 0, cameraDistance)
          const viewDot =
            rotNormal.x * -rotCentroid.x +
            rotNormal.y * -rotCentroid.y +
            rotNormal.z * (cameraDistance - rotCentroid.z);
          if (!isTranslucent && viewDot <= 0) return;

          // Proyectar vértices de la cara
          const poly2D: { x: number; y: number }[] = [];
          face.indices.forEach((vIdx) => {
            const v = model.vertices[vIdx];
            const pExploded = {
              x: v.x + offset.x,
              y: v.y + offset.y,
              z: v.z + offset.z,
            };
            const pRot = rotatePoint(pExploded, rotX, rotY);
            const persp = cameraDistance / Math.max(0.5, cameraDistance - pRot.z);
            poly2D.push({
              x: cx + pRot.x * scale * persp,
              y: cy - pRot.y * scale * persp,
            });
          });

          // Iluminación Lambertiana
          const dot = Math.max(0, rotNormal.x * lightDir.x + rotNormal.y * lightDir.y + rotNormal.z * lightDir.z);
          const lightFactor = Math.min(1, Math.max(0.18, 0.25 + dot * 0.75));

          facesToDraw.push({
            points: poly2D,
            depth: rotCentroid.z,
            normalZ: rotNormal.z,
            baseColor: model.defaultColor,
            lightFactor,
          });
        });
      }
      // MODO 2: TALLER VÓXEL 3D
      else {
        // Conjunto de vóxeles para chequeo rápido de adyacencia
        const voxelSet = new Set(voxels.map((v) => `${v.x},${v.y},${v.z}`));

        // 6 caras de un cubo unidad
        const cubeFaces = [
          { normal: { x: 0, y: 0, z: 1 }, dx: 0, dy: 0, dz: 1, v: [[-0.5, -0.5, 0.5], [0.5, -0.5, 0.5], [0.5, 0.5, 0.5], [-0.5, 0.5, 0.5]] },
          { normal: { x: 0, y: 0, z: -1 }, dx: 0, dy: 0, dz: -1, v: [[0.5, -0.5, -0.5], [-0.5, -0.5, -0.5], [-0.5, 0.5, -0.5], [0.5, 0.5, -0.5]] },
          { normal: { x: 0, y: 1, z: 0 }, dx: 0, dy: 1, dz: 0, v: [[-0.5, 0.5, 0.5], [0.5, 0.5, 0.5], [0.5, 0.5, -0.5], [-0.5, 0.5, -0.5]] },
          { normal: { x: 0, y: -1, z: 0 }, dx: 0, dy: -1, dz: 0, v: [[-0.5, -0.5, -0.5], [0.5, -0.5, -0.5], [0.5, -0.5, 0.5], [-0.5, -0.5, 0.5]] },
          { normal: { x: 1, y: 0, z: 0 }, dx: 1, dy: 0, dz: 0, v: [[0.5, -0.5, 0.5], [0.5, -0.5, -0.5], [0.5, 0.5, -0.5], [0.5, 0.5, 0.5]] },
          { normal: { x: -1, y: 0, z: 0 }, dx: -1, dy: 0, dz: 0, v: [[-0.5, -0.5, -0.5], [-0.5, -0.5, 0.5], [-0.5, 0.5, 0.5], [-0.5, 0.5, -0.5]] },
        ];

        voxels.forEach((vox) => {
          cubeFaces.forEach((cf, faceIdx) => {
            // Oclusión de caras internas compartidas entre vóxeles adyacentes
            const neighborKey = `${vox.x + cf.dx},${vox.y + cf.dy},${vox.z + cf.dz}`;
            if (voxelSet.has(neighborKey)) return;

            const rotNormal = rotatePoint(cf.normal, rotX, rotY);

            // Centroide de la cara
            const faceCenter = {
              x: vox.x + cf.normal.x * 0.5,
              y: vox.y + cf.normal.y * 0.5,
              z: vox.z + cf.normal.z * 0.5,
            };
            const rotCentroid = rotatePoint(faceCenter, rotX, rotY);

            // Culling exacto en perspectiva
            const viewDot =
              rotNormal.x * -rotCentroid.x +
              rotNormal.y * -rotCentroid.y +
              rotNormal.z * (cameraDistance - rotCentroid.z);
            if (!isTranslucent && viewDot <= 0) return;

            // Proyectar los 4 vértices
            const poly2D: { x: number; y: number }[] = [];
            cf.v.forEach((pt) => {
              const pWorld = {
                x: vox.x + pt[0],
                y: vox.y + pt[1],
                z: vox.z + pt[2],
              };
              const pRot = rotatePoint(pWorld, rotX, rotY);
              const persp = cameraDistance / Math.max(0.5, cameraDistance - pRot.z);
              poly2D.push({
                x: cx + pRot.x * scale * persp,
                y: cy - pRot.y * scale * persp,
              });
            });

            const dot = Math.max(0, rotNormal.x * lightDir.x + rotNormal.y * lightDir.y + rotNormal.z * lightDir.z);
            const lightFactor = Math.min(1, Math.max(0.2, 0.3 + dot * 0.7));

            facesToDraw.push({
              points: poly2D,
              depth: rotCentroid.z,
              normalZ: rotNormal.z,
              baseColor: vox.color,
              lightFactor,
              voxelRef: { x: vox.x, y: vox.y, z: vox.z, faceIdx },
            });
          });
        });
      }

      // Ordenar por profundidad (Painter's algorithm: pintar de atrás hacia adelante)
      facesToDraw.sort((a, b) => a.depth - b.depth);

      // Comprobar cara bajo el cursor en modo Vóxel (Raycasting 2D/3D híbrido)
      hoveredVoxelFace = null;
      if (currentMode === 'voxel') {
        for (let i = facesToDraw.length - 1; i >= 0; i--) {
          const f = facesToDraw[i];
          if (f.voxelRef && isPointInPoly(canvasMouseX, canvasMouseY, f.points)) {
            hoveredVoxelFace = f;
            break;
          }
        }
      }

      // Dibujar Caras
      facesToDraw.forEach((f) => {
        ctx.beginPath();
        ctx.moveTo(f.points[0].x, f.points[0].y);
        for (let i = 1; i < f.points.length; i++) {
          ctx.lineTo(f.points[i].x, f.points[i].y);
        }
        ctx.closePath();

        // Relleno iluminado
        ctx.fillStyle = f.baseColor;
        ctx.globalAlpha = isTranslucent ? 0.35 : 0.88;
        ctx.fill();

        // Sombreado por iluminación direccional
        ctx.fillStyle = `rgba(0, 0, 0, ${1 - f.lightFactor})`;
        ctx.globalAlpha = 0.55;
        ctx.fill();

        // Si es la cara seleccionada bajo el cursor, resaltar con brillo
        if (f === hoveredVoxelFace) {
          ctx.fillStyle = voxelTool === 'add' ? 'rgba(56, 189, 248, 0.45)' : 'rgba(244, 63, 94, 0.45)';
          ctx.globalAlpha = 0.7;
          ctx.fill();
        }

        // Aristas
        if (showWireframe) {
          ctx.strokeStyle = f === hoveredVoxelFace
            ? (voxelTool === 'add' ? '#38bdf8' : '#f43f5e')
            : (isDark ? 'rgba(255, 255, 255, 0.28)' : 'rgba(0, 0, 0, 0.35)');
          ctx.lineWidth = f === hoveredVoxelFace ? 2.5 : 1.2;
          ctx.globalAlpha = 1;
          ctx.stroke();
        }
      });

      // Vértices (puntos luminosos)
      if (showVertices && currentMode === 'platonic') {
        const model = SOLIDS_CATALOG[currentSolidId] || SOLIDS_CATALOG.cube;
        ctx.fillStyle = '#ffffff';
        ctx.globalAlpha = 0.95;

        model.vertices.forEach((v) => {
          const pRot = rotatePoint(v, rotX, rotY);
          const persp = cameraDistance / Math.max(0.5, cameraDistance - pRot.z);
          const px = cx + pRot.x * scale * persp;
          const py = cy - pRot.y * scale * persp;

          ctx.beginPath();
          ctx.arc(px, py, 3.2, 0, Math.PI * 2);
          ctx.fill();

          ctx.strokeStyle = isDark ? '#b48cff' : '#0f172a';
          ctx.lineWidth = 1;
          ctx.stroke();
        });
      }

      ctx.restore();
      requestAnimationFrame(render);
    }

    requestAnimationFrame(render);

    // =========================================================================
    // 6. EVENTOS DE RATÓN, TACTIL Y ACCIONES VÓXEL
    // =========================================================================
    let dragDist = 0;

    function applyVoxelAction() {
      if (currentMode !== 'voxel' || !hoveredVoxelFace || !hoveredVoxelFace.voxelRef) return;

      const ref = hoveredVoxelFace.voxelRef;
      const cubeNormals = [
        { dx: 0, dy: 0, dz: 1 },
        { dx: 0, dy: 0, dz: -1 },
        { dx: 0, dy: 1, dz: 0 },
        { dx: 0, dy: -1, dz: 0 },
        { dx: 1, dy: 0, dz: 0 },
        { dx: -1, dy: 0, dz: 0 },
      ];
      const norm = cubeNormals[ref.faceIdx];

      if (voxelTool === 'add') {
        const newX = ref.x + norm.dx;
        const newY = ref.y + norm.dy;
        const newZ = ref.z + norm.dz;

        // Limitar espacio a un cubo razonable (-5 a +5) para rendimiento
        if (Math.abs(newX) <= 6 && Math.abs(newY) <= 6 && Math.abs(newZ) <= 6) {
          voxels.push({ x: newX, y: newY, z: newZ, color: currentVoxelColor });
          playBlockSound(true);
        }
      } else if (voxelTool === 'remove') {
        // Eliminar el cubo clicado (evitar dejar 0 cubos si queremos base mínima)
        const idx = voxels.findIndex((v) => v.x === ref.x && v.y === ref.y && v.z === ref.z);
        if (idx !== -1 && voxels.length > 1) {
          voxels.splice(idx, 1);
          playBlockSound(false);
        }
      }

      updateMetricsUI();
    }

    canvas.addEventListener('mousedown', (e) => {
      isDragging = true;
      dragDist = 0;
      lastX = e.clientX;
      lastY = e.clientY;
    });

    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      canvasMouseX = e.clientX - rect.left;
      canvasMouseY = e.clientY - rect.top;

      if (!isDragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      dragDist += Math.hypot(dx, dy);
      lastX = e.clientX;
      lastY = e.clientY;

      rotY += dx * 0.009;
      rotX += dy * 0.009;
      rotX = Math.max(-Math.PI / 2.1, Math.min(Math.PI / 2.1, rotX));
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    canvas.addEventListener('mouseleave', () => {
      canvasMouseX = -1000;
      canvasMouseY = -1000;
      hoveredVoxelFace = null;
    });

    // Clic sobre el lienzo para Poner o Quitar Vóxel (solo si no hubo arrastre)
    canvas.addEventListener('click', (e) => {
      if (dragDist > 6) return;
      applyVoxelAction();
    });

    // Touch móvil (rotación táctil y tap)
    let touchDragDist = 0;
    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        touchDragDist = 0;
        lastX = e.touches[0].clientX;
        lastY = e.touches[0].clientY;
        const rect = canvas.getBoundingClientRect();
        canvasMouseX = e.touches[0].clientX - rect.left;
        canvasMouseY = e.touches[0].clientY - rect.top;
      }
    }, { passive: true });

    canvas.addEventListener('touchmove', (e) => {
      if (!isDragging || e.touches.length !== 1) return;
      const dx = e.touches[0].clientX - lastX;
      const dy = e.touches[0].clientY - lastY;
      touchDragDist += Math.hypot(dx, dy);
      lastX = e.touches[0].clientX;
      lastY = e.touches[0].clientY;

      const rect = canvas.getBoundingClientRect();
      canvasMouseX = e.touches[0].clientX - rect.left;
      canvasMouseY = e.touches[0].clientY - rect.top;

      rotY += dx * 0.01;
      rotX += dy * 0.01;
      rotX = Math.max(-Math.PI / 2.1, Math.min(Math.PI / 2.1, rotX));
    }, { passive: true });

    window.addEventListener('touchend', () => {
      if (touchDragDist < 8) {
        applyVoxelAction();
      }
      isDragging = false;
    });

    // Zoom con rueda de ratón
    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY < 0 ? 0.08 : -0.08;
      zoom = Math.max(0.4, Math.min(2.5, zoom + delta));
    }, { passive: false });

    // =========================================================================
    // 7. SINCRONIZACIÓN Y ACTUALIZACIÓN DEL PANEL DE MÉTRICAS & EULER
    // =========================================================================
    const metricFaces = document.getElementById('metric-faces');
    const metricVertices = document.getElementById('metric-vertices');
    const metricEdges = document.getElementById('metric-edges');
    const eulerResult = document.getElementById('euler-result');
    const eulerStatusText = document.getElementById('euler-status-text');
    const eulerBadge = document.getElementById('euler-badge');
    const solidDisplayName = document.getElementById('solid-display-name');
    const solidTypeBadge = document.getElementById('solid-type-badge');
    const metricSurface = document.getElementById('metric-surface');
    const metricVolume = document.getElementById('metric-volume');
    const edgeParamWrap = document.getElementById('edge-param-wrap');
    const voxelStatsExtra = document.getElementById('voxel-stats-extra');
    const statVoxelCount = document.getElementById('stat-voxel-count');
    const statVoxelExtFaces = document.getElementById('stat-voxel-ext-faces');
    const statVoxelIntFaces = document.getElementById('stat-voxel-int-faces');
    const dockExplosion = document.getElementById('dock-explosion');
    const canvasHintText = document.getElementById('canvas-hint-text');

    function updateMetricsUI() {
      if (currentMode === 'platonic') {
        const model = SOLIDS_CATALOG[currentSolidId] || SOLIDS_CATALOG.cube;
        const C = model.faces.length;
        const V = model.vertices.length;

        // Calcular aristas únicas mediante pares de índices
        const edgeSet = new Set<string>();
        model.faces.forEach((f) => {
          for (let i = 0; i < f.indices.length; i++) {
            const v1 = f.indices[i];
            const v2 = f.indices[(i + 1) % f.indices.length];
            const key = v1 < v2 ? `${v1}-${v2}` : `${v2}-${v1}`;
            edgeSet.add(key);
          }
        });
        const A = edgeSet.size;
        const chi = C + V - A;

        if (metricFaces) metricFaces.textContent = String(C);
        if (metricVertices) metricVertices.textContent = String(V);
        if (metricEdges) metricEdges.textContent = String(A);
        if (eulerResult) eulerResult.textContent = String(chi);

        if (solidDisplayName) solidDisplayName.textContent = model.name;
        if (solidTypeBadge) solidTypeBadge.textContent = model.category;

        // Fórmulas paramétricas analíticas
        const surf = model.surfFormula(edgeLengthA);
        const vol = model.volFormula(edgeLengthA);
        if (metricSurface) metricSurface.textContent = `${surf.toFixed(2)} u²`;
        if (metricVolume) metricVolume.textContent = `${vol.toFixed(2)} u³`;

        if (eulerStatusText) {
          eulerStatusText.textContent = chi === 2
            ? 'Esfera Topológica Regular (Conexo, Género 0)'
            : `Poliedro Complejo (Característica χ = ${chi})`;
        }
        if (eulerBadge) {
          eulerBadge.className = `euler-status-badge ${chi === 2 ? 'is-valid' : 'is-alt'}`;
        }

        if (edgeParamWrap) edgeParamWrap.hidden = false;
        if (voxelStatsExtra) voxelStatsExtra.hidden = true;
        if (dockExplosion) dockExplosion.hidden = false;
        if (canvasHintText) canvasHintText.textContent = 'Arrastra para rotar 360° · Rueda para zoom';
      }
      // MODO VÓXEL
      else {
        const voxelSet = new Set(voxels.map((v) => `${v.x},${v.y},${v.z}`));
        const cubeDeltas = [
          { dx: 0, dy: 0, dz: 1 }, { dx: 0, dy: 0, dz: -1 },
          { dx: 0, dy: 1, dz: 0 }, { dx: 0, dy: -1, dz: 0 },
          { dx: 1, dy: 0, dz: 0 }, { dx: -1, dy: 0, dz: 0 },
        ];

        let externalFaces = 0;
        voxels.forEach((vox) => {
          cubeDeltas.forEach((d) => {
            if (!voxelSet.has(`${vox.x + d.dx},${vox.y + d.dy},${vox.z + d.dz}`)) {
              externalFaces++;
            }
          });
        });

        const totalVoxels = voxels.length;
        const totalFacesPotential = totalVoxels * 6;
        const internalFaces = totalFacesPotential - externalFaces;

        // Estimación topológica de Euler según si tiene túnel toroidal
        const isTorus = voxels.length >= 8 && !voxelSet.has('0,0,0') && voxelSet.has('1,0,0') && voxelSet.has('-1,0,0');
        const chi = isTorus ? 0 : 2;

        if (metricFaces) metricFaces.textContent = String(externalFaces);
        if (metricVertices) metricVertices.textContent = String(Math.round(externalFaces * 0.75));
        if (metricEdges) metricEdges.textContent = String(Math.round(externalFaces * 1.5));
        if (eulerResult) eulerResult.textContent = String(chi);

        if (solidDisplayName) solidDisplayName.textContent = `Ensamble Vóxel 3D (${totalVoxels} Bloques)`;
        if (solidTypeBadge) solidTypeBadge.textContent = 'Geometría Discreta';

        const unitVolume = totalVoxels;
        const unitSurface = externalFaces;
        if (metricSurface) metricSurface.textContent = `${unitSurface} u²`;
        if (metricVolume) metricVolume.textContent = `${unitVolume} u³`;

        if (eulerStatusText) {
          eulerStatusText.textContent = isTorus
            ? '¡Toroide con Túnel detectado! (Género g = 1, χ = 0)'
            : 'Ensamble Vóxel Conexo (Homeomorfo a Esfera, χ = 2)';
        }
        if (eulerBadge) {
          eulerBadge.className = `euler-status-badge ${isTorus ? 'is-torus' : 'is-valid'}`;
        }

        if (edgeParamWrap) edgeParamWrap.hidden = true;
        if (voxelStatsExtra) voxelStatsExtra.hidden = false;
        if (statVoxelCount) statVoxelCount.textContent = String(totalVoxels);
        if (statVoxelExtFaces) statVoxelExtFaces.textContent = String(externalFaces);
        if (statVoxelIntFaces) statVoxelIntFaces.textContent = String(internalFaces);
        if (dockExplosion) dockExplosion.hidden = true;
        if (canvasHintText) canvasHintText.textContent = voxelTool === 'add'
          ? 'Clic sobre cualquier cara para AÑADIR cubo'
          : 'Clic sobre cualquier cara para BORRAR cubo';
      }
    }

    updateMetricsUI();

    // =========================================================================
    // 8. VINCULACIÓN DE CONTROLES E INTERFAZ DE USUARIO
    // =========================================================================
    // Conmutador de modo principal
    const modeBtns = document.querySelectorAll<HTMLButtonElement>('.mode-btn');
    const barPlatonic = document.getElementById('bar-platonic');
    const barVoxel = document.getElementById('bar-voxel');

    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const mode = btn.getAttribute('data-mode') as 'platonic' | 'voxel';
        currentMode = mode;

        if (barPlatonic && barVoxel) {
          if (mode === 'platonic') {
            barPlatonic.classList.add('is-active');
            barPlatonic.hidden = false;
            barVoxel.classList.remove('is-active');
            barVoxel.hidden = true;
          } else {
            barPlatonic.classList.remove('is-active');
            barPlatonic.hidden = true;
            barVoxel.classList.add('is-active');
            barVoxel.hidden = false;
          }
        }
        playChime();
        updateMetricsUI();
      });
    });

    // Selector de poliedro clásico
    const presetPills = document.querySelectorAll<HTMLButtonElement>('.preset-pill');
    presetPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        presetPills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        currentSolidId = pill.getAttribute('data-solid') || 'cube';
        playChime();
        updateMetricsUI();
      });
    });

    // Toggles de visualización
    const chkWireframe = document.getElementById('chk-wireframe') as HTMLInputElement | null;
    const chkVertices = document.getElementById('chk-vertices') as HTMLInputElement | null;
    const chkTranslucent = document.getElementById('chk-translucent') as HTMLInputElement | null;
    const chkAutorotate = document.getElementById('chk-autorotate') as HTMLInputElement | null;

    chkWireframe?.addEventListener('change', (e) => {
      showWireframe = (e.target as HTMLInputElement).checked;
    });
    chkVertices?.addEventListener('change', (e) => {
      showVertices = (e.target as HTMLInputElement).checked;
    });
    chkTranslucent?.addEventListener('change', (e) => {
      isTranslucent = (e.target as HTMLInputElement).checked;
    });
    chkAutorotate?.addEventListener('change', (e) => {
      autoRotate = (e.target as HTMLInputElement).checked;
    });

    // Slider de explosión de caras
    const sliderExplosion = document.getElementById('slider-explosion') as HTMLInputElement | null;
    const explosionPct = document.getElementById('explosion-pct');
    sliderExplosion?.addEventListener('input', (e) => {
      const val = parseInt((e.target as HTMLInputElement).value, 10);
      explosionFactor = val / 100;
      if (explosionPct) explosionPct.textContent = `${val}%`;
    });

    // Slider de arista a
    const sliderEdgeA = document.getElementById('slider-edge-a') as HTMLInputElement | null;
    const valEdgeA = document.getElementById('val-edge-a');
    sliderEdgeA?.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value);
      edgeLengthA = val;
      if (valEdgeA) valEdgeA.textContent = val.toFixed(1);
      updateMetricsUI();
    });

    // Herramientas de Vóxel
    const toolBtns = document.querySelectorAll<HTMLButtonElement>('.tool-btn');
    toolBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        toolBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        voxelTool = (btn.getAttribute('data-tool') || 'add') as 'add' | 'remove';
        updateMetricsUI();
      });
    });

    // Paleta de colores
    const swatches = document.querySelectorAll<HTMLButtonElement>('.swatch');
    swatches.forEach((sw) => {
      sw.addEventListener('click', () => {
        swatches.forEach((s) => s.classList.remove('is-active'));
        sw.classList.add('is-active');
        currentVoxelColor = sw.getAttribute('data-color') || '#b48cff';
      });
    });

    // Selector de presets de vóxeles
    const selectVoxelPreset = document.getElementById('select-voxel-preset') as HTMLSelectElement | null;
    selectVoxelPreset?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      loadVoxelPreset(val);
    });

    const btnResetVoxels = document.getElementById('btn-reset-voxels');
    btnResetVoxels?.addEventListener('click', () => {
      loadVoxelPreset('clear');
    });

    // Controles de cámara
    document.getElementById('btn-zoom-in')?.addEventListener('click', () => {
      zoom = Math.min(2.5, zoom + 0.15);
    });
    document.getElementById('btn-zoom-out')?.addEventListener('click', () => {
      zoom = Math.max(0.4, zoom - 0.15);
    });
    document.getElementById('btn-cam-reset')?.addEventListener('click', () => {
      rotX = 0.55;
      rotY = -0.65;
      zoom = 1.0;
      playChime();
    });

    // Toggle de sonido
    const btnAudioToggle = document.getElementById('btn-audio-toggle');
    const audioIconStatus = document.getElementById('audio-icon-status');
    btnAudioToggle?.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      if (audioIconStatus) {
        audioIconStatus.textContent = soundEnabled ? '🔊' : '🔇';
      }
    });
  })();
</script>

<style>
  [hidden] {
    display: none !important;
  }

  /* ==================================================== */
  /* CONTENEDOR Y LAYOUT GENERAL                         */
  /* ==================================================== */
  .polyhedra-page {
    width: 100%;
    min-height: 100vh;
    background: #090e17;
    color: #f1f5f9;
  }

  .game-cockpit {
    width: 100%;
    padding: 0.75rem 1rem 1.25rem;
    background: radial-gradient(circle at 50% 15%, rgba(180, 140, 255, 0.08), rgba(9, 14, 23, 0.98) 75%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cockpit-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  /* BARRA SUPERIOR */
  .cockpit-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .back-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted, #94a3b8);
    text-decoration: none;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    transition: all 0.2s ease;
  }

  .back-pill:hover {
    color: #b48cff;
    border-color: #b48cff;
    background: rgba(180, 140, 255, 0.12);
  }

  .header-titles {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .game-title {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0;
    color: #f8fafc;
  }

  .badge-pill {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    color: #b48cff;
    background: rgba(180, 140, 255, 0.15);
    border: 1px solid rgba(180, 140, 255, 0.3);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .header-right-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  /* SELECTOR DE MODO (SEGMENTED TABS) */
  .mode-toggle-group {
    display: inline-flex;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    padding: 0.2rem;
    gap: 0.25rem;
  }

  .mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.75rem;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: var(--muted, #94a3b8);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mode-btn:hover {
    color: #f8fafc;
  }

  .mode-btn.is-active {
