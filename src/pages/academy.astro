    transition: all 0.2s ease;
  }

  .status-pill.is-available {
    background: linear-gradient(180deg, rgba(16, 185, 129, 0.25) 0%, rgba(16, 185, 129, 0.12) 100%);
    color: #34d399;
    border: 1.5px solid #10b981;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.2);
  }

  .status-pill.is-available:hover {
    background: #10b981;
    color: #064e3b;
    box-shadow: 0 0 16px rgba(16, 185, 129, 0.4);
    transform: translateY(-1px);
  }

  .status-pill.is-available .status-dot {
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  :global([data-theme="light"]) .status-pill {
    background: rgba(217, 119, 6, 0.1);
