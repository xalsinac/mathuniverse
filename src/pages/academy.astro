---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ScientificCalculator from '../components/ScientificCalculator.astro';
import AcademyHeroWave from '../components/AcademyHeroWave.astro';
import { site } from '../config/site';
import {
  ACADEMY_BLOCKS,
  ACADEMY_LESSONS,
  type AcademyLesson,
  type AcademyBlock,
} from '../data/academy';

const totalLessons = ACADEMY_LESSONS.length;
const totalBlocks = ACADEMY_BLOCKS.length;
---

<BaseLayout
  title={`Math Academy — ${site.name}`}
  description="El tratado riguroso y conceptual de matemáticas para ESO y Bachillerato. Donde cada fórmula tiene su deducción, cada teorema sus hipótesis y contraejemplos."
>
  <!-- Barra superior técnica unificada (Limpia: sin saturación, sin emojis, sin Grandes Teoremas repetido) -->
  <SiteHeader activePage="academy" statusText="07 · Math Academy" ctaHref="/#recursos" ctaLabel="Todas las Apps">
    <div slot="right-extra" class="topbar-cell academy-top-actions">
      <button
        type="button"
        class="academy-top-btn"
        data-toggle-floating-calc
        title="Invocar calculadora científica en ventana flotante (Picture-in-Picture)"
      >
        <svg class="btn-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="16" height="20" x="4" y="2" rx="2"></rect>
          <line x1="8" x2="16" y1="6" y2="6"></line>
          <line x1="16" x2="16" y1="14" y2="14"></line>
          <path d="M16 10h.01M12 10h.01M8 10h.01M12 14h.01M8 14h.01M12 18h.01M8 18h.01"></path>
        </svg>
        <span class="btn-text">Calculadora</span>
        <span class="btn-pip-tag" aria-hidden="true">PiP</span>
      </button>
    </div>
  </SiteHeader>

  <main>
    <!-- 1. HERO BAND CON ONDAS Y BANDADA REACTIVA (ESTILO ANTIGRAVITY) -->
    <section class="academy-hero-section">
      <AcademyHeroWave />
    </section>

    <!-- 2. CATÁLOGO DEL TRATADO: PLACAS DE ENTRADA, FILTROS Y BUSCADOR VISIBLE -->
    <section class="academy-catalog-band section-band is-drawn" id="catalogo">
      <span class="section-rule" aria-hidden="true"></span>
      <div class="section-frame">
        <span class="tick tick-half tick-left" aria-hidden="true"></span>
        <span class="tick tick-half tick-right" aria-hidden="true"></span>

        <!-- Eyebrow Técnico -->
        <div class="section-eyebrow">
          <span>
            <span class="eyebrow-num">07</span>
            <span class="eyebrow-sep" aria-hidden="true">/</span>
            Math Academy · Tratado y Mapa del Conocimiento
          </span>
          <span class="eyebrow-right" id="academy-global-counter">{totalBlocks} Bloques Temáticos · {totalLessons} Lecciones</span>
        </div>

        <!-- CONTENEDOR PRINCIPAL DEL CATÁLOGO (UNIFICADO EN UN SOLO BODY SIN ESPACIOS MUERTOS) -->
        <div class="academy-catalog-main section-body">
          
          <!-- BARRA DE BÚSQUEDA PROMINENTE (ALTA VISIBILIDAD SUPERIOR) -->
          <div class="academy-search-hero-box">
            <div class="search-prominent-bar">
              <svg class="search-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="search"
                id="academy-search-input"
                class="academy-search-input"
                placeholder="Buscar teorema, concepto o demostración (ej: Bolzano, absurdo, Ruffini, inducción, Bayes...)"
                aria-label="Buscar en todas las lecciones del tratado"
                autocomplete="off"
              />
              <button type="button" id="search-clear-btn" class="search-clear-btn" aria-label="Limpiar búsqueda" style="display:none;">
                Limpiar
              </button>
              <kbd class="search-kbd-hint" aria-hidden="true">⌘K</kbd>
            </div>

            <!-- FILA COMPACTA DE FILTROS POR NIVEL (SIN ESPACIO MUERTO) -->
            <div class="filter-controls-row">
              <div class="level-tabs-group" role="group" aria-label="Filtrar por nivel educativo">
                <span class="control-label">NIVEL:</span>
                <button type="button" class="level-chip is-active" data-level-filter="all">
                  <span>Todos</span>
                  <span class="chip-count">{totalLessons}</span>
                </button>
                <button type="button" class="level-chip" data-level-filter="ESO">
                  <span>ESO</span>
                  <span class="chip-count">{ACADEMY_LESSONS.filter(l => l.level === 'ESO').length}</span>
                </button>
                <button type="button" class="level-chip" data-level-filter="1º Bachillerato">
                  <span>1º Bachillerato</span>
                  <span class="chip-count">{ACADEMY_LESSONS.filter(l => l.level === '1º Bachillerato').length}</span>
                </button>
                <button type="button" class="level-chip" data-level-filter="2º Bachillerato">
                  <span>2º Bachillerato</span>
                  <span class="chip-count">{ACADEMY_LESSONS.filter(l => l.level === '2º Bachillerato').length}</span>
                </button>
                <button type="button" class="level-chip" data-level-filter="Transversal">
                  <span>Transversal</span>
                  <span class="chip-count">{ACADEMY_LESSONS.filter(l => l.level === 'Transversal').length}</span>
                </button>
              </div>

              <button type="button" class="back-to-blocks-btn" id="btn-return-overview" style="display: none;">
                <span class="btn-arrow" aria-hidden="true">←</span>
                <span>Volver a los 6 Bloques</span>
              </button>
            </div>
          </div>

          <!-- ================================================================= -->
          <!-- VISTA A: DASHBOARD DE LAS 6 PLACAS DE ENTRADA (ESTILO MATH LAB)   -->
          <!-- ================================================================= -->
          <div class="academy-dashboard-view" id="view-dashboard">
            <div class="dashboard-intro-bar">
              <p class="dashboard-kicker">SECCIONES ESTRUCTURADAS</p>
              <h2 class="dashboard-heading">Explora el tratado por <em>bloques fundamentales</em></h2>
              <p class="dashboard-sub">
                Cada placa da acceso a un espacio especializado con sus deducciones formales, contraejemplos interactivos y rigor de examen.
              </p>
            </div>

            <div class="blocks-placas-grid">
              {
                ACADEMY_BLOCKS.map((block) => {
                  const blockLessons = ACADEMY_LESSONS.filter((l) => l.blockId === block.id);
                  return (
                    <article
                      class="academy-block-placa"
                      data-block-target={block.id}
                      style={`--block-accent: ${block.color};`}
                    >
                      <div class="placa-glow" aria-hidden="true"></div>

                      <div class="placa-header">
                        <div class="placa-badge-group">
                          <span class="placa-num">{block.number}</span>
                          <span class="placa-glyph" title={block.glyphLabel}>{block.glyph}</span>
                        </div>
                        <span class="placa-level-tag">{block.levelRange}</span>
                      </div>

                      <h3 class="placa-title">{block.name}</h3>
                      <p class="placa-tagline">{block.tagline}</p>
                      <p class="placa-description">{block.description}</p>

                      <div class="placa-footer">
                        <div class="placa-count-badge">
                          <span class="count-num">{blockLessons.length}</span>
                          <span>lecciones</span>
                        </div>
                        <button
                          type="button"
                          class="placa-enter-action"
                          data-open-block={block.id}
                          aria-label={`Entrar al bloque ${block.number}: ${block.name}`}
                        >
                          <span>Entrar a la sección</span>
                          <span class="action-arrow" aria-hidden="true">→</span>
                        </button>
                      </div>
                    </article>
                  );
                })
              }
            </div>
          </div>

          <!-- ================================================================= -->
          <!-- VISTA B: ESPACIO DE BLOQUE ESPECIALIZADO (PÁGINA DEDICADA DEL BLOQUE) -->
          <!-- ================================================================= -->
          <div class="academy-block-focused-view" id="view-block-detail" style="display: none;">
            <!-- Barra de navegación contextual entre bloques -->
            <div class="block-context-nav">
              <button type="button" class="nav-back-chip" id="btn-back-from-block">
                <span class="btn-arrow" aria-hidden="true">←</span>
                <span>Todos los Bloques</span>
              </button>

              <div class="block-switch-pills" role="tablist" aria-label="Cambiar de bloque temático">
                {
                  ACADEMY_BLOCKS.map((b) => (
                    <button
                      type="button"
                      class="block-switch-tab"
                      data-switch-block={b.id}
                      style={`--tab-color: ${b.color};`}
                      title={`Bloque ${b.number}: ${b.name}`}
                    >
                      <span class="tab-glyph">{b.glyph}</span>
                      <span class="tab-text">{b.number}. {b.name}</span>
                    </button>
                  ))
                }
              </div>
            </div>

            <!-- Banner de Bienvenida del Bloque Activo -->
            {
              ACADEMY_BLOCKS.map((block) => {
                const blockLessons = ACADEMY_LESSONS.filter((l) => l.blockId === block.id);
                return (
                  <div class="block-detail-content" id={`block-content-${block.id}`} style={`--block-accent: ${block.color}; display: none;`}>
                    <header class="block-welcome-card">
                      <div class="welcome-top">
                        <div class="welcome-badges">
                          <span class="welcome-num">BLOQUE {block.number}</span>
                          <span class="welcome-glyph">{block.glyph}</span>
                          <span class="welcome-scope">{block.levelRange}</span>
                        </div>
                        <div class="welcome-stat">
                          <strong>{blockLessons.length}</strong>
                          <span>Lecciones en este bloque</span>
                        </div>
                      </div>

                      <h2 class="welcome-title">{block.name}</h2>
                      <p class="welcome-tagline">{block.tagline}</p>
                      <p class="welcome-desc">{block.description}</p>
                    </header>

                    <!-- Rejilla de Lecciones de este bloque -->
                    <div class="block-lessons-grid">
                      {
                        blockLessons.map((lesson) => (
                          <article
                            class="academy-glass-card"
                            data-lesson-id={lesson.id}
                            data-block={block.id}
                            data-level={lesson.level}
                            data-search-terms={`${lesson.title} ${lesson.subtitle} ${lesson.summary} ${lesson.keyConcept} ${block.name}`.toLowerCase()}
                            style={`--card-accent: ${block.color};`}
                          >
                            <div class="card-glow" aria-hidden="true"></div>

                            <div class="card-top">
                              <span class={`level-badge is-${lesson.level.toLowerCase().replace(/[\sº]/g, '')}`}>
                                {lesson.level}
                              </span>
                              <span class="type-badge">{lesson.badge}</span>
                              <span class="difficulty-indicator" title={`Dificultad: ${lesson.difficulty}`}>
                                {lesson.difficulty}
                              </span>
                            </div>

                            {
                              lesson.status === 'disponible' && lesson.href ? (
                                <h3 class="lesson-title">
                                  <a href={lesson.href} class="lesson-card-link" title={`Estudiar lección: ${lesson.title}`}>
                                    {lesson.title}
                                  </a>
                                </h3>
                              ) : (
                                <h3 class="lesson-title">{lesson.title}</h3>
                              )
                            }
                            <p class="lesson-subtitle">{lesson.subtitle}</p>

                            <!-- Caja de Fórmula o Concepto Clave -->
                            <div class="concept-key-box">
                              <span class="concept-label">EJE RIGUROSO:</span>
                              <code class="concept-formula">{lesson.keyConcept}</code>
                            </div>

                            <p class="lesson-summary">{lesson.summary}</p>

                            <!-- Prerrequisitos -->
                            <div class="lesson-prereqs">
                              <span class="prereqs-label">Requiere:</span>
                              <div class="prereqs-tags">
                                {lesson.prerequisites.map((req) => (
                                  <span class="prereq-tag">{req}</span>
                                ))}
                              </div>
                            </div>

                            <!-- Pie de Tarjeta -->
                            <div class="card-bottom">
                              <div class="duration-estimate">
                                <svg class="duration-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <circle cx="12" cy="12" r="10"></circle>
                                  <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <span>~{lesson.durationMinutes} min de lectura</span>
                              </div>

                              {lesson.status === 'disponible' && lesson.href ? (
                                <a href={lesson.href} class="status-pill is-available" title="Entrar a estudiar esta lección">
                                  <span class="status-dot"></span>
                                  <span>Entrar a la lección →</span>
                                </a>
                              ) : (
                                <div class="status-pill is-prep" title="Contenido en fase de redacción formal">
                                  <span class="status-dot"></span>
                                  <span>Próximamente</span>
                                </div>
                              )}
                            </div>
                          </article>
                        ))
                      }
                    </div>
                  </div>
                );
              })
            }
          </div>

          <!-- ================================================================= -->
          <!-- VISTA C: RESULTADOS DE BÚSQUEDA / FILTRADO GLOBAL                 -->
          <!-- ================================================================= -->
          <div class="academy-search-results-view" id="view-search-results" style="display: none;">
            <div class="search-results-header">
              <div>
                <p class="results-kicker">RESULTADOS EN TIEMPO REAL</p>
                <h2 class="results-title" id="search-results-heading">Lecciones encontradas</h2>
              </div>
              <button type="button" class="back-to-blocks-btn" id="btn-exit-search">
                <span class="btn-arrow" aria-hidden="true">←</span>
                <span>Volver a los 6 Bloques</span>
              </button>
            </div>

            <div class="search-lessons-grid" id="search-cards-container">
              <!-- Las tarjetas filtradas se manejan dinámicamente -->
            </div>
          </div>

        </div>

        <!-- ================================================================= -->
        <!-- 4. SALÓN DE LOS GRANDES TEOREMAS (DESTACADO HISTÓRICO)             -->
        <!-- ================================================================= -->
        <section class="grand-theorems-spotlight section-body" id="teoremas">
          <div class="spotlight-header">
            <span class="spotlight-glyph" aria-hidden="true">∎</span>
            <div class="spotlight-text">
              <h2>El Salón de los Grandes Teoremas</h2>
              <p>
                Demostraciones fundamentales que revolucionaron el pensamiento humano y que todo
                estudiante de secundaria y bachillerato puede comprender y disfrutar en profundidad.
              </p>
            </div>
          </div>

          <div class="theorems-spotlight-grid">
            <div class="spotlight-card">
              <div class="spotlight-badge">TEOREMA CLÁSICO · ANTIGÜEDAD</div>
              <h3>La Irracionalidad de √2</h3>
              <p class="spotlight-author">Escuela Pitagórica / Euclides (~300 a.C.)</p>
              <div class="spotlight-formula">
                <code>√2 ≠ a / b &nbsp;(con a, b ∈ ℤ coprimos)</code>
              </div>
              <p class="spotlight-body">
                El descubrimiento que quebró la filosofía pitagórica de que todo en el cosmos era reducible
                a proporciones de números enteros. La demostración por reducción al absurdo más limpia de la historia.
              </p>
              <div class="spotlight-footer">
                <span class="tag">Reducción al absurdo</span>
                <span class="tag">Paridad matemática</span>
              </div>
            </div>

            <div class="spotlight-card">
              <div class="spotlight-badge">TEORÍA DE NÚMEROS</div>
              <h3>La Infinitud de los Primos</h3>
              <p class="spotlight-author">Euclides de Alejandría (Elementos, Libro IX)</p>
              <div class="spotlight-formula">
                <code>N = (p₁ · p₂ · ... · pₖ) + 1</code>
              </div>
              <p class="spotlight-body">
                Una demostración elegante e imbatible: si asumimos que la lista de primos termina, construimos un nuevo
                número que fuerza la existencia de un primo desconocido, demostrando que los ladrillos numéricos nunca se agotan.
              </p>
              <div class="spotlight-footer">
                <span class="tag">Teorema de Euclides</span>
                <span class="tag">Aritmética fundamental</span>
              </div>
            </div>

            <div class="spotlight-card">
              <div class="spotlight-badge">CUMBRE DEL BACHILLERATO</div>
              <h3>El Teorema Fundamental del Cálculo</h3>
              <p class="spotlight-author">Newton, Leibniz y Barrow (s. XVII)</p>
              <div class="spotlight-formula">
                <code>d/dx [ ∫ₐˣ f(t) dt ] = f(x)</code>
              </div>
              <p class="spotlight-body">
                La conexión monumental entre la velocidad de cambio (derivada) y la acumulación continua de área (integral).
                El puente que convirtió el cálculo infinitesimal en el motor de toda la ciencia moderna.
              </p>
              <div class="spotlight-footer">
                <span class="tag">Regla de Barrow</span>
                <span class="tag">Análisis real</span>
              </div>
            </div>
          </div>
        </section>

        <!-- ================================================================= -->
        <!-- 5. MANIFIESTO DE RIGOR DE MATH ACADEMY                             -->
        <!-- ================================================================= -->
        <section class="academy-manifesto-band section-body" id="metodologia">
          <div class="manifesto-card">
            <div class="manifesto-head">
              <span class="manifesto-axiom" aria-hidden="true">§</span>
              <div class="manifesto-title">
                <h2>El Manifiesto de Rigor de Math Academy</h2>
                <p>Las 4 reglas de oro con las que construimos cada explicación</p>
              </div>
            </div>

            <div class="manifesto-grid">
              <div class="manifesto-rule">
                <span class="rule-num">01</span>
                <h3>Ninguna fórmula sin justificar</h3>
                <p>
                  No enseñamos a memorizar ecuaciones de la nada. Cada fórmula importante se deduce paso a paso 
                  desde axiomas elementales o construcciones geométricas evidentes.
                </p>
              </div>

              <div class="manifesto-rule">
                <span class="rule-num">02</span>
                <h3>Las hipótesis son sagradas</h3>
                <p>
                  Un teorema solo es válido cuando sus condiciones se cumplen al 100%. Por eso, en cada lección 
                  mostramos el <strong>contraejemplo</strong> que prueba por qué cada hipótesis es indispensable.
                </p>
              </div>

              <div class="manifesto-rule">
                <span class="rule-num">03</span>
                <h3>Lenguaje formal traducido</h3>
                <p>
                  No tememos a la notación rigurosa ($\forall, \exists, \iff$), pero la traducimos de inmediato 
                  a lenguaje natural y claro para que el rigor no sea una barrera, sino una herramienta de claridad.
                </p>
              </div>

              <div class="manifesto-rule">
                <span class="rule-num">04</span>
                <h3>Conexión con el aula y la PAU</h3>
                <p>
                  El rigor debe traducirse en notas excelentes. Cada desarrollo concluye con ejemplos resueltos 
                  con el estándar que exigen los correctores de exámenes de Bachillerato y Selectividad.
                </p>
              </div>
            </div>
          </div>
        </section>

      </div>
    </section>
  </main>

  <!-- Calculadora Científica Flotante Integrada (Host invisible listo para PiP) -->
  <div class="academy-calc-dock" style="position: fixed; bottom: -9999px; left: -9999px; opacity: 0; pointer-events: none;" aria-hidden="true">
    <ScientificCalculator compact={true} />
  </div>
</BaseLayout>

<script>
  // =========================================================================
  // CONTROLADOR DINÁMICO DE NAVEGACIÓN POR PLACAS Y BÚSQUEDA (ESTILO MATH LAB)
  // =========================================================================
  (() => {
    // 1. INVOCACIÓN DE CALCULADORA EN PICTURE-IN-PICTURE
    const calcTopBtn = document.querySelector<HTMLButtonElement>('[data-toggle-floating-calc]');
    if (calcTopBtn) {
      calcTopBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('request-calc-pip'));
      });
    }

    // 2. BUSCADOR Y FILTROS DEL CATÁLOGO
    const searchInput = document.getElementById('academy-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('search-clear-btn');
    const levelChips = document.querySelectorAll<HTMLButtonElement>('[data-level-filter]');
    const returnOverviewBtns = [
      document.getElementById('btn-return-overview'),
      document.getElementById('btn-back-from-block'),
      document.getElementById('btn-exit-search')
    ];

    const viewDashboard = document.getElementById('view-dashboard');
    const viewBlockDetail = document.getElementById('view-block-detail');
    const viewSearchResults = document.getElementById('view-search-results');
    const searchCardsContainer = document.getElementById('search-cards-container');
    const searchResultsHeading = document.getElementById('search-results-heading');
    const globalCounter = document.getElementById('academy-global-counter');

    const openBlockButtons = document.querySelectorAll<HTMLElement>('[data-open-block], [data-block-target]');
    const switchBlockButtons = document.querySelectorAll<HTMLButtonElement>('[data-switch-block]');
    const blockContents = document.querySelectorAll<HTMLElement>('.block-detail-content');

    // Clonamos las lecciones de los bloques para poder filtrarlas en modo búsqueda global
    const allLessonCards = Array.from(document.querySelectorAll<HTMLElement>('.block-lessons-grid .academy-glass-card'));

    let currentMode: 'dashboard' | 'block' | 'search' = 'dashboard';
    let currentBlockId: string | null = null;
    let currentLevelFilter = 'all';
    let currentSearchQuery = '';

    const updateView = () => {
      // 1. Si hay texto de búsqueda o si se ha filtrado por nivel desde el dashboard principal:
      if (currentSearchQuery.length > 0 || (currentLevelFilter !== 'all' && currentMode === 'search')) {
        currentMode = 'search';
        if (viewDashboard) viewDashboard.style.display = 'none';
        if (viewBlockDetail) viewBlockDetail.style.display = 'none';
        if (viewSearchResults) viewSearchResults.style.display = 'block';
        returnOverviewBtns.forEach(btn => { if (btn) btn.style.display = 'inline-flex'; });

        renderSearchResults();
        return;
      }

      // 2. Si estamos en modo bloque individual:
      if (currentMode === 'block' && currentBlockId) {
        if (viewDashboard) viewDashboard.style.display = 'none';
        if (viewSearchResults) viewSearchResults.style.display = 'none';
        if (viewBlockDetail) viewBlockDetail.style.display = 'block';
        returnOverviewBtns.forEach(btn => { if (btn) btn.style.display = 'inline-flex'; });

        blockContents.forEach(bc => {
          bc.style.display = bc.id === `block-content-${currentBlockId}` ? 'block' : 'none';
        });

        switchBlockButtons.forEach(btn => {
          btn.classList.toggle('is-active', btn.dataset.switchBlock === currentBlockId);
        });

        // Filtrar lecciones dentro del bloque por el nivel seleccionado
        const activeBlockContent = document.getElementById(`block-content-${currentBlockId}`);
        if (activeBlockContent) {
          const cardsInBlock = activeBlockContent.querySelectorAll<HTMLElement>('.academy-glass-card');
          cardsInBlock.forEach(card => {
            const cardLevel = card.dataset.level || '';
            const matchesLevel = currentLevelFilter === 'all' || cardLevel === currentLevelFilter;
            card.style.display = matchesLevel ? '' : 'none';
          });
        }
        return;
      }

      // 3. Modo Dashboard de 6 Placas (Vista principal por defecto)
      currentMode = 'dashboard';
      if (viewDashboard) viewDashboard.style.display = 'block';
      if (viewBlockDetail) viewBlockDetail.style.display = 'none';
      if (viewSearchResults) viewSearchResults.style.display = 'none';
      returnOverviewBtns.forEach(btn => { if (btn) btn.style.display = 'none'; });
    };

    const renderSearchResults = () => {
      if (!searchCardsContainer) return;
      searchCardsContainer.innerHTML = '';

      let matchCount = 0;
      allLessonCards.forEach(origCard => {
        const cardLevel = origCard.dataset.level || '';
        const searchTerms = origCard.dataset.searchTerms || '';

        const matchesLevel = currentLevelFilter === 'all' || cardLevel === currentLevelFilter;
        const matchesQuery = !currentSearchQuery || searchTerms.includes(currentSearchQuery);

        if (matchesLevel && matchesQuery) {
          matchCount++;
          const clone = origCard.cloneNode(true) as HTMLElement;
          clone.style.display = '';
          searchCardsContainer.appendChild(clone);
        }
      });

      if (searchResultsHeading) {
        if (currentSearchQuery) {
          searchResultsHeading.innerHTML = `Mostrando ${matchCount} lección(es) para «<em>${escapeHtml(currentSearchQuery)}</em>»`;
        } else {
          searchResultsHeading.textContent = `Mostrando ${matchCount} lecciones de ${currentLevelFilter}`;
        }
      }

      if (globalCounter) {
        globalCounter.textContent = `${matchCount} resultado(s) encontrado(s)`;
      }
    };

    const escapeHtml = (str: string) => {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    };

    const selectBlock = (blockId: string, smoothScroll = false) => {
      currentBlockId = blockId;
      currentMode = 'block';
      window.location.hash = `bloque-${blockId}`;
      updateView();

      if (smoothScroll) {
        const catalogBand = document.getElementById('catalogo');
        if (catalogBand) {
          catalogBand.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    };

    const returnToDashboard = () => {
      currentMode = 'dashboard';
      currentSearchQuery = '';
      if (searchInput) searchInput.value = '';
      if (clearBtn) clearBtn.style.display = 'none';
      if (window.location.hash.startsWith('#bloque-')) {
        history.pushState(null, '', window.location.pathname);
      }
      updateView();
      const catalogBand = document.getElementById('catalogo');
      if (catalogBand) {
        catalogBand.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    // Event Listeners en Placas
    openBlockButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = (btn as HTMLElement).dataset.openBlock || (btn as HTMLElement).dataset.blockTarget;
        if (target) {
          e.preventDefault();
          selectBlock(target, true);
        }
      });
    });

    // Pestañas de cambio rápido dentro del bloque
    switchBlockButtons.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.switchBlock;
        if (target) {
          selectBlock(target, false);
        }
      });
    });

    // Botones de retorno al dashboard general
    returnOverviewBtns.forEach(btn => {
      if (btn) btn.addEventListener('click', returnToDashboard);
    });

    // Filtros por Nivel
    levelChips.forEach(chip => {
      chip.addEventListener('click', () => {
        levelChips.forEach(c => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        currentLevelFilter = chip.dataset.levelFilter || 'all';

        // Si estamos en dashboard y el usuario elige un nivel concreto, mostramos los resultados
        if (currentMode === 'dashboard' && currentLevelFilter !== 'all') {
          currentMode = 'search';
        }
        updateView();
      });
    });

    // Buscador en tiempo real
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentSearchQuery = searchInput.value.trim().toLowerCase();
        if (clearBtn) {
          clearBtn.style.display = currentSearchQuery ? 'block' : 'none';
        }
        if (currentSearchQuery.length > 0) {
          currentMode = 'search';
        } else if (currentLevelFilter === 'all' && currentBlockId === null) {
          currentMode = 'dashboard';
        }
        updateView();
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          currentSearchQuery = '';
          clearBtn.style.display = 'none';
          searchInput.focus();
          if (currentBlockId) {
            currentMode = 'block';
          } else {
            currentMode = 'dashboard';
          }
          updateView();
        });
      }

      // Atajo de teclado ⌘K / Ctrl+K
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          searchInput.focus();
          searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        if (e.key === 'Escape' && document.activeElement === searchInput) {
          searchInput.blur();
          if (searchInput.value) {
            searchInput.value = '';
            currentSearchQuery = '';
            if (clearBtn) clearBtn.style.display = 'none';
            updateView();
          }
        }
      });
    }

    // Inicialización según Hash URL (ej. #bloque-algebra)
    const initHash = window.location.hash.replace('#bloque-', '');
    const validBlock = Array.from(blockContents).some(b => b.id === `block-content-${initHash}`);
    if (initHash && validBlock) {
      selectBlock(initHash, false);
    } else {
      updateView();
    }
  })();
</script>

