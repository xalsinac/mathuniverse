  }

  .nav-back-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(255, 193, 77, 0.2) 0%, rgba(255, 193, 77, 0.1) 100%);
