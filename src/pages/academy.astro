  }

  :global([data-theme="light"]) .nav-back-chip:hover {
    background: #d97706;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(217, 119, 6, 0.3);
  }

  .block-switch-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .block-switch-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.75rem;
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
    color: var(--muted, #94a3b8);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .block-switch-tab .tab-glyph {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    color: var(--tab-color, #ffc14d);
  }

  .block-switch-tab:hover {
    color: var(--ink, #f3f2ec);
    border-color: var(--tab-color, #ffc14d);
    background: rgba(255, 255, 255, 0.08);
  }

  .block-switch-tab.is-active {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.05) 100%);
    border-color: var(--tab-color, #ffc14d);
    color: var(--ink, #f3f2ec);
    box-shadow: 0 0 14px rgba(255, 193, 77, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }

  :global([data-theme="light"]) .block-switch-tab {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border-color: rgba(0, 0, 0, 0.1);
    color: #475569;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
  }

  :global([data-theme="light"]) .block-switch-tab.is-active {
    background: linear-gradient(180deg, #fff7ed 0%, #ffedd5 100%);
    border-color: var(--tab-color, #d97706);
    color: #9a3412;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(217, 119, 6, 0.2);
  }

  /* Tarjeta de Bienvenida del Bloque */
  .block-welcome-card {
    padding: 2.2rem;
    border-radius: 18px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
    border: 1.5px solid var(--block-accent, #ffc14d);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    margin-bottom: 2rem;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.2);
  }

  :global([data-theme="light"]) .block-welcome-card {
    background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
    border-color: var(--block-accent, #d97706);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08), inset 0 1px 2px #ffffff;
  }

  .welcome-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }

  .welcome-badges {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .welcome-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--block-accent, #ffc14d);
    background: rgba(255, 255, 255, 0.06);
    border: 1.5px solid var(--block-accent, #ffc14d);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
  }

  .welcome-glyph {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--ink, #f3f2ec);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.03) 100%);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.25);
    padding: 0.2rem 0.75rem;
    border-radius: 8px;
  }

  :global([data-theme="light"]) .welcome-glyph {
    color: var(--block-accent, #0f172a);
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.12);
  }

  .welcome-scope {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted, #94a3b8);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  :global([data-theme="light"]) .welcome-scope {
    background: #f1f5f9;
    border-color: #e2e8f0;
    color: #475569;
  }

  .welcome-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .welcome-stat strong {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--block-accent, #ffc14d);
    line-height: 1;
  }

  .welcome-stat span {
    font-size: 0.75rem;
    color: var(--muted, #94a3b8);
  }

  .welcome-title {
    font-size: 2rem;
    font-weight: 900;
    margin: 0 0 0.4rem;
    color: var(--ink, #f3f2ec);
  }

  .welcome-tagline {
    font-size: 1.05rem;
    font-style: italic;
    color: var(--block-accent, #ffc14d);
    margin: 0 0 1rem;
    font-weight: 600;
  }

  .welcome-desc {
    font-size: 0.95rem;
    color: var(--muted, #94a3b8);
    line-height: 1.6;
    margin: 0;
    max-width: 820px;
  }

  .block-lessons-grid, .search-lessons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.4rem;
  }

  /* =========================================================================
     TARJETAS DE LECCIÓN RIGUROSAS (GLASSMORPHISM CON RESALTE)
     ========================================================================= */
  .academy-glass-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    border-radius: 16px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.015) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-top: 2.5px solid var(--card-accent, #ffc14d);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.15);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .academy-glass-card:hover {
    transform: translateY(-4px);
    border-color: var(--card-accent, #ffc14d);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.45), 0 0 25px -5px var(--card-accent);
  }

  :global([data-theme="light"]) .academy-glass-card {
    background: linear-gradient(145deg, #ffffff 0%, #fbfbfa 100%);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-top: 2.5px solid var(--card-accent, #d97706);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06), inset 0 1px 1px #ffffff;
  }

  :global([data-theme="light"]) .academy-glass-card:hover {
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.12), 0 0 22px -5px var(--card-accent);
  }

  .card-glow {
    position: absolute;
    top: -30px;
    right: -30px;
    width: 90px;
    height: 90px;
    background: radial-gradient(circle, var(--card-accent, #ffc14d) 0%, transparent 70%);
    opacity: 0.15;
    pointer-events: none;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.9rem;
    flex-wrap: wrap;
  }

  .level-badge {
