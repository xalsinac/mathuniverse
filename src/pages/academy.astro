  }

  .duration-svg {
    opacity: 0.75;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    background: rgba(255, 193, 77, 0.14);
    color: #ffc14d;
    border: 1px solid rgba(255, 193, 77, 0.3);
