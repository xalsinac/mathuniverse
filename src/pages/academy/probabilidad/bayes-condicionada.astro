<script>
  // =========================================================================
  // SIMULADOR BAYESIANO INTERACTIVO CON TREEMAP PROPORCIONAL
  // =========================================================================

  interface BayesPreset {
    prev: number; // Prevalencia %
    sens: number; // Sensibilidad % P(+|E)
    fp: number;   // Falsos positivos % P(+|S)
  }

  const PRESETS: Record<string, BayesPreset> = {
    rara: { prev: 0.1, sens: 99.0, fp: 1.0 },
    comun: { prev: 12.0, sens: 92.0, fp: 3.5 },
    fabrica: { prev: 2.0, sens: 98.0, fp: 0.8 },
    cribado: { prev: 0.01, sens: 99.5, fp: 0.5 },
  };

  let curPrev = 0.1;
  let curSens = 99.0;
  let curFp = 1.0;

  const svgTree = document.getElementById('svg-bayes-treemap') as SVGSVGElement | null;
  const sliderPrev = document.getElementById('slider-prev') as HTMLInputElement | null;
  const sliderSens = document.getElementById('slider-sens') as HTMLInputElement | null;
  const sliderFp = document.getElementById('slider-fp') as HTMLInputElement | null;

  const valPrevDisp = document.getElementById('val-prev');
  const valSensDisp = document.getElementById('val-sens');
  const valFpDisp = document.getElementById('val-fp');

  const metricVpp = document.getElementById('metric-vpp');
  const telePtotal = document.getElementById('tele-ptotal');
  const teleRatio = document.getElementById('tele-ratio');
  const teleVpp = document.getElementById('tele-vpp');
  const teleConfLabel = document.getElementById('tele-conf-label');
  const bayesMeter = document.getElementById('bayes-meter');
  const bayesVerdict = document.getElementById('bayes-verdict');
  const bayesExplanation = document.getElementById('bayes-explanation');

  const cntVp = document.getElementById('cnt-vp');
  const cntFp = document.getElementById('cnt-fp');
  const cntSanos = document.getElementById('cnt-sanos');

  const W = 580;
  const H = 240;
  const TOTAL_POP = 10000;

  function renderBayes() {
    if (!svgTree) return;

    const isLight = document.documentElement.getAttribute('data-theme') === 'light';

    const pE = curPrev / 100;
    const pS = 1 - pE;
    const pPosDadoE = curSens / 100;
    const pPosDadoS = curFp / 100;

    // Frecuencias en 10.000 individuos
    const enfermos = TOTAL_POP * pE;
    const sanos = TOTAL_POP * pS;

    const vp = enfermos * pPosDadoE; // Verdaderos Positivos
    const fn = enfermos * (1 - pPosDadoE); // Falsos Negativos
    const fp = sanos * pPosDadoS; // Falsos Positivos
    const vn = sanos * (1 - pPosDadoS); // Verdaderos Negativos

    const totalPositivos = vp + fp;
    const vpp = totalPositivos > 0 ? (vp / totalPositivos) * 100 : 0;
    const pTotalPosPct = (totalPositivos / TOTAL_POP) * 100;

    // Colores adaptados
    const vpColor = isLight ? '#059669' : '#10b981';
    const fpColor = isLight ? '#dc2626' : '#ef4444';
    const fnColor = isLight ? '#d97706' : '#f59e0b';
    const vnColor = isLight ? '#0284c7' : '#38bdf8';
    const borderCol = isLight ? '#cbd5e1' : '#334155';

    // Gráfico Treemap Proporcional SVG
    // Dividimos horizontalmente según enfermos vs sanos
    // Para que la columna de enfermos sea visible incluso con prevalencia del 0.1%,
    // usamos una visualización segmentada en dos columnas principales con ancho amplificado si es mínimo:
    const minColW = 55;
    const rawEnfermosW = Math.max(minColW, Math.min(220, (enfermos / TOTAL_POP) * (W - 30) * 8));
    const sanosW = W - 20 - rawEnfermosW;

    // Columna Enfermos (x = 10 a 10 + rawEnfermosW)
    const hVp = Math.max(16, (vp / Math.max(0.001, enfermos)) * (H - 30));
    const hFn = (H - 30) - hVp;

    // Columna Sanos (x = 10 + rawEnfermosW + 10 a W - 10)
    const hFp = Math.max(16, (fp / sanos) * (H - 30));
    const hVn = (H - 30) - hFp;

    const xEnf = 10;
    const yStart = 20;
    const xSanos = xEnf + rawEnfermosW + 10;

    let svgHtml = `
      <defs>
        <pattern id="diagHatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
        </pattern>
      </defs>

      <!-- Cabeceras de columnas -->
      <text x="${xEnf + rawEnfermosW / 2}" y="14" font-size="11" font-weight="700" fill="${isLight ? '#0f172a' : '#f8fafc'}" text-anchor="middle" font-family="monospace">
        ENFERMOS (${enfermos.toFixed(1)})
      </text>
      <text x="${xSanos + sanosW / 2}" y="14" font-size="11" font-weight="700" fill="${isLight ? '#0f172a' : '#f8fafc'}" text-anchor="middle" font-family="monospace">
        SANOS (${sanos.toFixed(0)})
      </text>

      <!-- Caja VP: Verdaderos Positivos (Enfermos y Positivos) -->
      <rect x="${xEnf}" y="${yStart}" width="${rawEnfermosW}" height="${hVp}" rx="5" fill="${vpColor}" fill-opacity="0.85" stroke="${borderCol}" stroke-width="1.2" />
      <text x="${xEnf + 8}" y="${yStart + Math.min(22, hVp - 6)}" font-size="10" font-weight="700" fill="#ffffff" font-family="monospace">
        VP: ${vp.toFixed(1)}
      </text>
      <text x="${xEnf + 8}" y="${yStart + Math.min(36, hVp + 6)}" font-size="9" fill="#ffffff" opacity="0.9" font-family="sans-serif">
        ${rawEnfermosW > 70 ? 'Test Positivo' : '+'}
      </text>

      <!-- Caja FN: Falsos Negativos (Enfermos pero Negativo) -->
      <rect x="${xEnf}" y="${yStart + hVp}" width="${rawEnfermosW}" height="${hFn}" rx="5" fill="${fnColor}" fill-opacity="0.8" stroke="${borderCol}" stroke-width="1.2" />
      <text x="${xEnf + 8}" y="${yStart + hVp + Math.min(18, hFn - 4)}" font-size="9" font-weight="700" fill="#ffffff" font-family="monospace">
        FN: ${fn.toFixed(1)}
      </text>

      <!-- Caja FP: Falsos Positivos (Sanos pero Positivos - ¡El núcleo de la falacia!) -->
      <rect x="${xSanos}" y="${yStart}" width="${sanosW}" height="${hFp}" rx="5" fill="${fpColor}" fill-opacity="0.85" stroke="${borderCol}" stroke-width="1.2" />
      <rect x="${xSanos}" y="${yStart}" width="${sanosW}" height="${hFp}" rx="5" fill="url(#diagHatch)" />
      <text x="${xSanos + 12}" y="${yStart + Math.min(20, hFp - 6)}" font-size="11" font-weight="800" fill="#ffffff" font-family="monospace">
        ¡FALSOS POSITIVOS!: ${fp.toFixed(0)} personas sanas
      </text>
      <text x="${xSanos + 12}" y="${yStart + Math.min(34, hFp + 6)}" font-size="9.5" fill="#ffffff" opacity="0.95" font-family="sans-serif">
        Test Positivo (sin tener la enfermedad)
      </text>

      <!-- Caja VN: Verdaderos Negativos (Sanos y Negativos) -->
      <rect x="${xSanos}" y="${yStart + hFp}" width="${sanosW}" height="${hVn}" rx="5" fill="${vnColor}" fill-opacity="0.25" stroke="${borderCol}" stroke-width="1.2" />
      <text x="${xSanos + 12}" y="${yStart + hFp + Math.min(24, hVn - 10)}" font-size="11" font-weight="700" fill="${isLight ? '#0284c7' : '#38bdf8'}" font-family="monospace">
        VERDADEROS NEGATIVOS: ${vn.toFixed(0)} sanos con test negativo
      </text>
    `;

    svgTree.innerHTML = svgHtml;

    // Actualizar Telemetría
    if (metricVpp) metricVpp.textContent = `VPP = ${vpp.toFixed(2)}%`;
    if (telePtotal) telePtotal.textContent = `${pTotalPosPct.toFixed(3)}%`;
    if (teleVpp) teleVpp.textContent = `${vpp.toFixed(2)}%`;
    if (teleRatio) teleRatio.textContent = `${curSens.toFixed(1)} : ${curFp.toFixed(1)}`;

    if (cntVp) cntVp.textContent = vp.toFixed(1);
    if (cntFp) cntFp.textContent = fp.toFixed(0);
    if (cntSanos) cntSanos.textContent = sanos.toFixed(0);

    if (valPrevDisp) valPrevDisp.textContent = `${curPrev.toFixed(2)}%`;
    if (valSensDisp) valSensDisp.textContent = `${curSens.toFixed(1)}%`;
    if (valFpDisp) valFpDisp.textContent = `${curFp.toFixed(1)}%`;

    if (bayesMeter && teleConfLabel && bayesVerdict && bayesExplanation) {
      bayesMeter.style.width = `${Math.min(100, Math.max(2, vpp))}%`;

      if (vpp < 25) {
        bayesMeter.style.background = '#ef4444';
        teleConfLabel.textContent = 'Baja Certeza (< 25%)';
        teleConfLabel.style.color = '#ef4444';
        bayesVerdict.textContent = 'DIAGNÓSTICO ENGAÑOSO';
        bayesVerdict.style.color = '#ef4444';
        bayesVerdict.style.borderColor = 'rgba(239, 68, 68, 0.4)';
        bayesExplanation.textContent = `Por cada enfermo que da positivo (${vp.toFixed(0)}), hay ${(fp / Math.max(0.01, vp)).toFixed(0)} personas sanas con falso positivo. Se requiere una segunda prueba confirmatoria.`;
      } else if (vpp < 75) {
        bayesMeter.style.background = '#f59e0b';
        teleConfLabel.textContent = 'Certeza Moderada (25-75%)';
        teleConfLabel.style.color = '#f59e0b';
        bayesVerdict.textContent = 'CERTEZA INTERMEDIA';
        bayesVerdict.style.color = '#f59e0b';
        bayesVerdict.style.borderColor = 'rgba(245, 158, 11, 0.4)';
        bayesExplanation.textContent = 'La evidencia del test inclina la balanza de forma significativa, pero el margen de error clínico exige cautela.';
      } else {
        bayesMeter.style.background = '#10b981';
        teleConfLabel.textContent = 'Alta Certeza (> 75%)';
        teleConfLabel.style.color = '#10b981';
        bayesVerdict.textContent = 'TEST DE ALTA FIABILIDAD';
        bayesVerdict.style.color = '#10b981';
        bayesVerdict.style.borderColor = 'rgba(16, 185, 129, 0.4)';
        bayesExplanation.textContent = 'La combinación de alta prevalencia y baja tasa de falsos positivos otorga un valor predictivo contundente.';
      }
    }
  }

  // Event Listeners Sliders
  if (sliderPrev) {
    sliderPrev.addEventListener('input', (e) => {
      curPrev = parseFloat((e.target as HTMLInputElement).value);
      renderBayes();
    });
  }

  if (sliderSens) {
    sliderSens.addEventListener('input', (e) => {
      curSens = parseFloat((e.target as HTMLInputElement).value);
      renderBayes();
    });
  }

  if (sliderFp) {
    sliderFp.addEventListener('input', (e) => {
      curFp = parseFloat((e.target as HTMLInputElement).value);
      renderBayes();
    });
  }

  // Presets
  const presetBtns = document.querySelectorAll<HTMLButtonElement>('.preset-btn');
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const pKey = btn.dataset.preset;
      if (pKey && PRESETS[pKey]) {
        const p = PRESETS[pKey];
        curPrev = p.prev;
        curSens = p.sens;
        curFp = p.fp;

        if (sliderPrev) sliderPrev.value = String(curPrev);
        if (sliderSens) sliderSens.value = String(curSens);
        if (sliderFp) sliderFp.value = String(curFp);

        renderBayes();
      }
    });
  });

  // Tema Claro / Oscuro
  const themeObserver = new MutationObserver(() => {
    renderBayes();
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  renderBayes();

  // =========================================================================
  // SISTEMA DE AUTOEVALUACIÓN CONCEPTUAL (QUIZ)
  // =========================================================================
  const quizCards = document.querySelectorAll<HTMLElement>('.quiz-card');
  const FEEDBACK_MSGS: Record<string, { correct: string; incorrect: string }> = {
    '1': {
      correct: '¡Exacto! Es un error clásico de examen: si A y B son disjuntos, saber que ocurrió B te da la certeza absoluta de que A NO puede haber ocurrido (P(A|B) = 0 ≠ P(A)). Por tanto, dos sucesos incompatibles nunca son independientes.',
      incorrect: 'Incorrecto. No confundas "incompatibles" con "independientes". Si son incompatibles, A ∩ B = ∅, luego P(A ∩ B) = 0. Para que fueran independientes se requeriría P(A ∩ B) = P(A)·P(B) > 0.',
    },
    '2': {
      correct: '¡Brillante! Si P(Ebrio) = 0, el numerador en el Teorema de Bayes es P(+|Ebrio)·0 = 0. Cualquier positivo obtenido es forzosamente un falso positivo.',
      incorrect: 'Incorrecto. El Teorema de Bayes modula la evidencia con la probabilidad a priori: P(Ebrio|+) = [P(+|Ebrio)·0] / P(+) = 0.',
    },
    '3': {
      correct: '¡Impecable! P(B|A) = P(A ∩ B) / P(A) = 0.3 / 0.6 = 0.50. Dado que P(B) = 0.50, se cumple exactamente P(B|A) = P(B), lo que demuestra independencia formal.',
      incorrect: 'Incorrecto. Aplica la definición de Kolmogorov: P(B|A) = P(A ∩ B) / P(A) = 0.3 / 0.6 = 0.5.',
    },
    '4': {
      correct: '¡Totalmente correcto! El denominador P(B) es la probabilidad total que pondera todas las posibles causas, actuando como factor de escala para que la suma de todas las probabilidades a posteriori sea idénticamente 1.',
      incorrect: 'Incorrecto. El normalizador es el denominador P(B), expandido por el Teorema de la Probabilidad Total.',
    },
  };

  quizCards.forEach((card) => {
    const qId = card.dataset.q || '';
    const btns = card.querySelectorAll<HTMLButtonElement>('.q-opt-btn');
    const fbBox = card.querySelector<HTMLElement>('.q-feedback');
    const fbText = card.querySelector<HTMLElement>('.fb-text');

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isCorrect = btn.dataset.correct === 'true';

        btns.forEach((b) => {
          b.disabled = true;
          if (b.dataset.correct === 'true') {
            b.classList.add('is-right');
          } else if (b === btn) {
            b.classList.add('is-wrong');
          }
        });

        if (fbBox && fbText) {
          fbBox.classList.remove('hidden', 'success', 'failure');
          fbBox.classList.add(isCorrect ? 'success' : 'failure');
          fbText.textContent = isCorrect ? FEEDBACK_MSGS[qId]?.correct : FEEDBACK_MSGS[qId]?.incorrect;
        }
      });
    });
  });
</script>

