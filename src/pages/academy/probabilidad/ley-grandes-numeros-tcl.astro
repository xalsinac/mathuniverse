<script>
  // --- UTILIDAD DE MUESTREO ---
  type DistMeta = {
    sample: () => number;
    mu: number | null;
    sigma: number | null;
    yMin: number;
    yMax: number;
  };

  function getLgnDist(key: string): DistMeta {
    switch (key) {
      case 'dice':
        return {
          sample: () => Math.floor(Math.random() * 6) + 1,
          mu: 3.5,
          sigma: Math.sqrt(35 / 12),
          yMin: 1.0,
          yMax: 6.0,
        };
      case 'exp':
        return {
          sample: () => -Math.log(1 - Math.random()),
          mu: 1.0,
          sigma: 1.0,
          yMin: 0.0,
          yMax: 2.5,
        };
      case 'cauchy':
        return {
          sample: () => Math.tan(Math.PI * (Math.random() - 0.5)),
          mu: null,
          sigma: null,
          yMin: -10,
          yMax: 10,
        };
      case 'coin':
      default:
        return {
          sample: () => (Math.random() < 0.5 ? 1 : 0),
          mu: 0.5,
          sigma: 0.5,
          yMin: 0.0,
          yMax: 1.0,
        };
    }
  }

  // --- EXPERIMENTO 1: LGN ---
  const selLgn = document.getElementById('sel-lgn-dist') as HTMLSelectElement | null;
  const slLgnN = document.getElementById('sl-lgn-n') as HTMLInputElement | null;
  const valLgnN = document.getElementById('val-lgn-n');
  const canvasLgn = document.getElementById('canvas-lgn') as HTMLCanvasElement | null;
  const lgnLastMean = document.getElementById('lgn-last-mean');
  const lgnMuEl = document.getElementById('lgn-mu');
  const lgnBandEl = document.getElementById('lgn-band');

  const btnLgnOne = document.getElementById('btn-lgn-one');
  const btnLgnFive = document.getElementById('btn-lgn-five');
  const btnLgnClear = document.getElementById('btn-lgn-clear');

  let trajectories: number[][] = [];
  const palette = ['#38bdf8', '#c084fc', '#f472b6', '#fbbf24', '#60a5fa', '#2dd4bf'];

  function generateTrajectory(distKey: string, n: number): number[] {
    const meta = getLgnDist(distKey);
    const means: number[] = new Array(n);
    let sum = 0;
    for (let k = 1; k <= n; k++) {
      sum += meta.sample();
      means[k - 1] = sum / k;
    }
    return means;
  }

  function renderLgn() {
    if (!canvasLgn) return;
    const ctx = canvasLgn.getContext('2d');
    if (!ctx) return;

    const distKey = selLgn ? selLgn.value : 'coin';
    const n = slLgnN ? Number(slLgnN.value) : 600;
    if (valLgnN) valLgnN.textContent = String(n);

    const meta = getLgnDist(distKey);
    const w = canvasLgn.width;
    const h = canvasLgn.height;
    ctx.clearRect(0, 0, w, h);

    const padL = 56;
    const padR = 24;
    const padT = 24;
    const padB = 36;
    const plotW = w - padL - padR;
    const plotH = h - padT - padB;

    const toX = (k: number) => padL + ((k - 1) / Math.max(1, n - 1)) * plotW;
    const toY = (y: number) => {
      const clamped = Math.max(meta.yMin, Math.min(meta.yMax, y));
      return padT + ((meta.yMax - clamped) / (meta.yMax - meta.yMin)) * plotH;
    };

    // Grid horizontal
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.14)';
    ctx.lineWidth = 1;
    ctx.font = '12px JetBrains Mono, monospace';
    ctx.fillStyle = '#94a3b8';
    const ticks = 4;
    for (let i = 0; i <= ticks; i++) {
      const yVal = meta.yMin + (i / ticks) * (meta.yMax - meta.yMin);
      const py = padT + ((meta.yMax - yVal) / (meta.yMax - meta.yMin)) * plotH;
      ctx.beginPath();
      ctx.moveTo(padL, py);
      ctx.lineTo(w - padR, py);
      ctx.stroke();
      ctx.fillText(yVal.toFixed(1), 12, py + 4);
    }

    // Banda ±2σ/√k y línea μ si existen
    if (meta.mu !== null && meta.sigma !== null) {
      const mu = meta.mu;
      const sigma = meta.sigma;

      ctx.beginPath();
      for (let k = 1; k <= n; k += 2) {
        const px = toX(k);
        const py = toY(mu + (2 * sigma) / Math.sqrt(k));
        if (k === 1) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      for (let k = n; k >= 1; k -= 2) {
        const px = toX(k);
        const py = toY(mu - (2 * sigma) / Math.sqrt(k));
        ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fillStyle = 'rgba(52, 211, 153, 0.12)';
      ctx.fill();

      const yMu = toY(mu);
      ctx.save();
      ctx.setLineDash([6, 4]);
      ctx.strokeStyle = '#34d399';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(padL, yMu);
      ctx.lineTo(w - padR, yMu);
      ctx.stroke();
      ctx.restore();

      ctx.fillStyle = '#34d399';
      ctx.fillText(`μ = ${mu.toFixed(2)}`, w - padR - 86, yMu - 7);
    } else {
      ctx.fillStyle = '#fbbf24';
      ctx.fillText('Cauchy: μ indefinida, σ = ∞ (sin convergencia)', padL + 12, padT + 16);
    }

    // Trayectorias
    trajectories.forEach((traj, idx) => {
      ctx.strokeStyle = palette[idx % palette.length];
      ctx.lineWidth = 1.9;
      ctx.beginPath();
      const len = Math.min(n, traj.length);
      for (let i = 0; i < len; i++) {
        const px = toX(i + 1);
        const py = toY(traj[i]);
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.stroke();
    });

    // Eje X
    ctx.fillStyle = '#94a3b8';
    ctx.fillText('k = 1', padL, h - 10);
    ctx.fillText(`k = ${n}`, w - padR - 55, h - 10);

    // Métricas
    if (lgnMuEl) lgnMuEl.textContent = meta.mu !== null ? meta.mu.toFixed(4) : 'No existe';
    if (lgnBandEl) {
      lgnBandEl.textContent =
        meta.sigma !== null ? `±${((2 * meta.sigma) / Math.sqrt(n)).toFixed(4)}` : '∞';
    }
    if (lgnLastMean) {
      if (trajectories.length > 0) {
        const lastTraj = trajectories[trajectories.length - 1];
        lgnLastMean.textContent = lastTraj[lastTraj.length - 1].toFixed(4);
      } else {
        lgnLastMean.textContent = '—';
      }
    }
  }

  function addTrajectories(count: number) {
    const distKey = selLgn ? selLgn.value : 'coin';
    const n = slLgnN ? Number(slLgnN.value) : 600;
    for (let i = 0; i < count; i++) {
      trajectories.push(generateTrajectory(distKey, n));
    }
    if (trajectories.length > 10) {
      trajectories = trajectories.slice(trajectories.length - 10);
    }
    renderLgn();
  }

  btnLgnOne?.addEventListener('click', () => addTrajectories(1));
  btnLgnFive?.addEventListener('click', () => addTrajectories(5));
  btnLgnClear?.addEventListener('click', () => {
    trajectories = [];
    renderLgn();
  });
  selLgn?.addEventListener('change', () => {
    trajectories = [];
    addTrajectories(2);
  });
  slLgnN?.addEventListener('input', () => {
    trajectories = [];
    addTrajectories(2);
  });

  addTrajectories(2);

  // --- EXPERIMENTO 2: TCL ---
  const selTcl = document.getElementById('sel-tcl-dist') as HTMLSelectElement | null;
  const slTclN = document.getElementById('sl-tcl-n') as HTMLInputElement | null;
  const slTclM = document.getElementById('sl-tcl-m') as HTMLInputElement | null;
  const valTclN = document.getElementById('val-tcl-n');
  const valTclM = document.getElementById('val-tcl-m');
  const chkTclGauss = document.getElementById('chk-tcl-gauss') as HTMLInputElement | null;
  const btnTclRun = document.getElementById('btn-tcl-run');
  const canvasTcl = document.getElementById('canvas-tcl') as HTMLCanvasElement | null;

  const tclObsMean = document.getElementById('tcl-obs-mean');
  const tclObsSd = document.getElementById('tcl-obs-sd');
  const tclTheoSd = document.getElementById('tcl-theo-sd');
  const tclSkew = document.getElementById('tcl-skew');

  function getTclDist(key: string): { sample: () => number; mu: number; sigma: number; minX: number; maxX: number } {
    switch (key) {
      case 'exp':
        return {
          sample: () => -Math.log(1 - Math.random()),
          mu: 1.0,
          sigma: 1.0,
          minX: 0,
          maxX: 3.0,
        };
      case 'ushape': {
        return {
          sample: () => {
            const s = Math.sin(Math.PI * Math.random() * 0.5);
            return s * s;
          },
          mu: 0.5,
          sigma: Math.sqrt(1 / 8),
          minX: 0,
          maxX: 1,
        };
      }
      case 'dice':
        return {
          sample: () => Math.floor(Math.random() * 6) + 1,
          mu: 3.5,
          sigma: Math.sqrt(35 / 12),
          minX: 1,
          maxX: 6,
        };
      case 'uniform':
      default:
        return {
          sample: () => Math.random(),
          mu: 0.5,
          sigma: Math.sqrt(1 / 12),
          minX: 0,
          maxX: 1,
        };
    }
  }

  function runTclSimulation() {
    if (!canvasTcl) return;
    const ctx = canvasTcl.getContext('2d');
    if (!ctx) return;

    const distKey = selTcl ? selTcl.value : 'uniform';
    const n = slTclN ? Number(slTclN.value) : 10;
    const m = slTclM ? Number(slTclM.value) : 4000;
    const showGauss = chkTclGauss ? chkTclGauss.checked : true;

    if (valTclN) valTclN.textContent = String(n);
    if (valTclM) valTclM.textContent = String(m);

    const dist = getTclDist(distKey);
    const means: number[] = new Array(m);

    let sumMeans = 0;
    for (let i = 0; i < m; i++) {
      let s = 0;
      for (let j = 0; j < n; j++) {
        s += dist.sample();
      }
      const mean = s / n;
      means[i] = mean;
      sumMeans += mean;
    }

    const obsMean = sumMeans / m;
    let m2 = 0;
    let m3 = 0;
    for (let i = 0; i < m; i++) {
      const d = means[i] - obsMean;
      m2 += d * d;
      m3 += d * d * d;
    }
    const obsVar = m2 / m;
    const obsSd = Math.sqrt(obsVar);
    const skew = obsSd > 1e-9 ? (m3 / m) / Math.pow(obsSd, 3) : 0;
    const theoSd = dist.sigma / Math.sqrt(n);

    if (tclObsMean) tclObsMean.textContent = obsMean.toFixed(4);
    if (tclObsSd) tclObsSd.textContent = obsSd.toFixed(4);
    if (tclTheoSd) tclTheoSd.textContent = theoSd.toFixed(4);
    if (tclSkew) tclSkew.textContent = skew.toFixed(3);

    const xMin = dist.minX;
    const xMax = dist.maxX;
    const bins = n === 1 && distKey === 'dice' ? 6 : 36;
    const counts = new Array(bins).fill(0);
    const binW = (xMax - xMin) / bins;

    for (let i = 0; i < m; i++) {
      const idx = Math.floor((means[i] - xMin) / binW);
      if (idx >= 0 && idx < bins) counts[idx]++;
    }

    const densities = counts.map((c) => c / (m * binW));
    const maxGauss = 1 / (theoSd * Math.sqrt(2 * Math.PI));
    const maxDens = Math.max(...densities, showGauss ? maxGauss : 0, 0.1) * 1.12;

    const w = canvasTcl.width;
    const h = canvasTcl.height;
    ctx.clearRect(0, 0, w, h);

    const padL = 48;
    const padR = 24;
    const padT = 26;
    const padB = 38;
    const plotW = w - padL - padR;
    const plotH = h - padT - padB;

    const toX = (x: number) => padL + ((x - xMin) / (xMax - xMin)) * plotW;
    const toY = (d: number) => padT + (1 - d / maxDens) * plotH;

    const pxBarW = plotW / bins;
    for (let i = 0; i < bins; i++) {
      const x = padL + i * pxBarW;
      const y = toY(densities[i]);
      const barH = h - padB - y;
      ctx.fillStyle = 'rgba(192, 132, 252, 0.45)';
      ctx.strokeStyle = 'rgba(192, 132, 252, 0.85)';
      ctx.lineWidth = 1;
      ctx.fillRect(x + 1, y, Math.max(1, pxBarW - 2), barH);
      ctx.strokeRect(x + 1, y, Math.max(1, pxBarW - 2), barH);
    }

    if (showGauss) {
      ctx.strokeStyle = '#34d399';
      ctx.lineWidth = 2.6;
      ctx.beginPath();
      const steps = 260;
      for (let i = 0; i <= steps; i++) {
        const x = xMin + (i / steps) * (xMax - xMin);
        const z = (x - dist.mu) / theoSd;
        const g = (1 / (theoSd * Math.sqrt(2 * Math.PI))) * Math.exp(-0.5 * z * z);
        const px = toX(x);
        const py = toY(g);
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.stroke();
    }

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.3)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(padL, h - padB);
    ctx.lineTo(w - padR, h - padB);
    ctx.stroke();

    ctx.fillStyle = '#94a3b8';
    ctx.font = '12px JetBrains Mono, monospace';
    ctx.fillText(xMin.toFixed(1), padL, h - 12);
    ctx.fillText(`μ=${dist.mu.toFixed(2)}`, toX(dist.mu) - 26, h - 12);
    ctx.fillText(xMax.toFixed(1), w - padR - 28, h - 12);
  }

  selTcl?.addEventListener('change', runTclSimulation);
  slTclN?.addEventListener('input', runTclSimulation);
  slTclM?.addEventListener('input', runTclSimulation);
  chkTclGauss?.addEventListener('change', runTclSimulation);
  btnTclRun?.addEventListener('click', runTclSimulation);
  runTclSimulation();

  // --- QUIZ ---
  const explanations: Record<string, { ok: string; err: string }> = {
    p1: {
      ok: 'Correcto. El margen de error escala como 1/√n. Para dividir el error por 2, necesitamos multiplicar n por 2² = 4, pasando de 1.000 a 4.000 encuestados.',
      err: 'Recuerda que la desviación típica de la media muestral es σ/√n, no σ/n. Para reducir el error a la mitad, √n debe duplicarse.'
    },
    p2: {
      ok: 'Exacto. Si la varianza es infinita (como en la distribución de Cauchy), no se cumplen las hipótesis ni de Chebyshev ni del TCL.',
      err: 'Revisa las secciones 1 y 3: la LGN no implica compensación de rachas pasadas, el TCL funciona incluso con distribuciones asimétricas y la varianza de X̄ₙ es σ²/n.'
    }
  };

  document.querySelectorAll<HTMLButtonElement>('.quiz-opt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = btn.dataset.q || '';
      const isCorrect = btn.dataset.correct === 'true';
      const siblings = document.querySelectorAll<HTMLButtonElement>(`.quiz-opt[data-q="${q}"]`);
      siblings.forEach((s) => s.classList.remove('correct', 'wrong'));
      btn.classList.add(isCorrect ? 'correct' : 'wrong');

      const fb = document.getElementById(`fb-${q}`);
      if (fb && explanations[q]) {
        fb.hidden = false;
        fb.className = `quiz-feedback ${isCorrect ? 'ok' : 'err'}`;
        fb.textContent = isCorrect ? explanations[q].ok : explanations[q].err;
      }
    });
  });
</script>
