<script>
  (() => {
    // =========================================================================
    // 1. LABORATORIO INTERACTIVO: EL DETECTOR DE CONTRADICCIONES
    // =========================================================================
    const absurdSelect = document.getElementById('absurd-select') as HTMLSelectElement | null;
    const thesisText = document.getElementById('thesis-text');
    const adversaryText = document.getElementById('adversary-text');
    const collisionDesc = document.getElementById('collision-desc');
    const systemStatus = document.getElementById('system-status');
    const absurdVerdict = document.getElementById('absurd-verdict');

    interface AbsurdScenario {
      thesis: string;
      adversary: string;
      collision: string;
      status: string;
      verdict: string;
    }

    const scenarios: Record<string, AbsurdScenario> = {
      raiz2: {
        thesis: '√2 es un número irracional (√2 ∉ ℚ).',
        adversary: 'Supongamos que √2 es racional: √2 = a / b con mcd(a,b) = 1 (irreducible).',
        collision: 'Se deduce que tanto "a" como "b" son pares. Por consiguiente, ambos son divisibles por 2, lo cual contradice que la fracción fuera irreducible (mcd(a,b) ≥ 2 ≠ 1).',
        status: 'CONTRADICCIÓN DETECTADA: mcd(a,b)=1 ∧ mcd(a,b)≥2',
        verdict: 'La hipótesis adversaria √2 ∈ ℚ rompe la consistencia de la aritmética. Por tanto, √2 es estrictamente irracional.',
      },
      primos: {
        thesis: 'Existen infinitos números primos en el conjunto ℕ.',
        adversary: 'Supongamos que la lista completa de números primos es finita: ℙ = {p₁, p₂, ..., p_k}.',
        collision: 'Construimos N = (p₁ · p₂ · ... · p_k) + 1. Ningún primo p_i puede dividir a N porque siempre deja resto 1. Sin embargo, todo entero mayor que 1 tiene factores primos. Existe un primo fuera de la lista.',
        status: 'CONTRADICCIÓN DETECTADA: Lista completa que omite primos',
        verdict: 'La suposición de que los primos caben en una lista finita es insostenible. El conjunto ℙ es infinito.',
      },
      mayorEntero: {
        thesis: 'No existe un número entero que sea el mayor de todos.',
        adversary: 'Supongamos que existe un entero "M" tal que M ≥ n para todo n ∈ ℤ.',
        collision: 'Definimos el entero M\' = M + 1. Como 1 > 0, se cumple estrictamente que M\' > M. Pero M debía ser mayor o igual que cualquier entero existente.',
        status: 'CONTRADICCIÓN DETECTADA: M\' > M cuando M debía ser el máximo',
        verdict: 'La idea de un "último número entero" se autodestruye de inmediato sumándole 1. Los enteros son ilimitados superiormente.',
      },
      sumaRacional: {
        thesis: 'La suma de un número racional y un número irracional es siempre irracional.',
        adversary: 'Sean r ∈ ℚ e i ∉ ℚ. Supongamos que su suma es racional: r + i = q con q ∈ ℚ.',
        collision: 'Despejamos el irracional: i = q - r. Como la resta de dos números racionales es siempre racional, se deduce que i ∈ ℚ, lo cual contradice la hipótesis inicial de que "i" era irracional.',
        status: 'CONTRADICCIÓN DETECTADA: i ∈ ℚ ∧ i ∉ ℚ',
        verdict: 'La suma r + i no puede ser jamás un número racional.',
      },
    };

    if (absurdSelect) {
      absurdSelect.addEventListener('change', () => {
        const val = absurdSelect.value;
        const s = scenarios[val];
        if (!s) return;

        if (thesisText) thesisText.textContent = s.thesis;
        if (adversaryText) adversaryText.textContent = s.adversary;
        if (collisionDesc) collisionDesc.innerHTML = s.collision;
        if (systemStatus) systemStatus.textContent = s.status;
        if (absurdVerdict) absurdVerdict.innerHTML = s.verdict;
      });
    }

    // =========================================================================
    // 2. GENERADOR INTERACTIVO DE NÚMEROS DE EUCLIDES
    // =========================================================================
    const slider = document.getElementById('primes-count-slider') as HTMLInputElement | null;
    const sliderBadge = document.getElementById('primes-count-val');
    const formulaText = document.getElementById('euclid-formula-text');
    const verdictBox = document.getElementById('euclid-verdict-box');
    const analysisText = document.getElementById('euclid-analysis-text');

    const basePrimes = [2, 3, 5, 7, 11, 13];

    const isPrime = (num: number): boolean => {
      if (num < 2) return false;
      for (let i = 2; i * i <= num; i++) {
        if (num % i === 0) return false;
      }
      return true;
    };

    const updateEuclidDemo = () => {
      if (!slider) return;
      const k = parseInt(slider.value, 10);
      const chosen = basePrimes.slice(0, k);

      if (sliderBadge) {
        sliderBadge.textContent = `k = ${k} primos (${chosen.join(', ')})`;
      }

      let product = 1;
      for (const p of chosen) product *= p;
      const euclidN = product + 1;

      if (formulaText) {
        formulaText.textContent = `N = (${chosen.join(' · ')}) + 1 = ${product} + 1 = ${euclidN}`;
      }

      const primeResult = isPrime(euclidN);

      if (verdictBox && analysisText) {
        if (primeResult) {
          verdictBox.innerHTML = `
            <div class="verdict-status-pill is-prime">${euclidN} ES PRIMO</div>
            <p>¡El número <strong>${euclidN}</strong> es en sí mismo un nuevo número primo! Es estrictamente mayor que todos los de tu lista inicial (${chosen.join(', ')}).</p>
          `;
        } else {
          // Hallar menor factor primo
          let smallestFactor = 2;
          for (let f = 2; f <= euclidN; f++) {
            if (euclidN % f === 0) {
              smallestFactor = f;
              break;
            }
          }
          verdictBox.innerHTML = `
            <div class="verdict-status-pill is-composite">${euclidN} ES COMPUESTO</div>
            <p>El número <strong>${euclidN}</strong> es compuesto. Su factor primo más pequeño es <strong>${smallestFactor}</strong>, el cual <strong>¡tampoco estaba en la lista inicial (${chosen.join(', ')})!</strong> El teorema se cumple con exactitud.</p>
          `;
        }
      }
    };

    if (slider) {
      slider.addEventListener('input', updateEuclidDemo);
      updateEuclidDemo();
    }

    // =========================================================================
    // 3. AUTOEVALUACIÓN INTERACTIVA
    // =========================================================================
    document.querySelectorAll<HTMLElement>('.quiz-card').forEach((card) => {
      const options = card.querySelectorAll<HTMLButtonElement>('.quiz-opt');
      const explanation = card.querySelector<HTMLElement>('.quiz-explanation');

      options.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isCorrect = btn.dataset.correct === 'true';

          options.forEach((o) => {
            o.disabled = true;
            if (o.dataset.correct === 'true') {
              o.classList.add('is-revealed-correct');
            }
          });

          if (isCorrect) {
            btn.classList.add('is-user-correct');
            if (explanation) {
              explanation.hidden = false;
              explanation.className = 'quiz-explanation is-good';
              explanation.innerHTML = '<strong>¡Exacto!</strong> Has razonado con rigor formal deductivo.';
            }
          } else {
            btn.classList.add('is-user-wrong');
            if (explanation) {
              explanation.hidden = false;
              explanation.className = 'quiz-explanation is-bad';
              explanation.innerHTML = '<strong>Incorrecto.</strong> Revisa la estructura: la reducción al absurdo niega la tesis conservando la consistencia axiomática.';
            }
          }
        });
      });
    });
  })();
</script>

