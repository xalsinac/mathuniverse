<script>
  (() => {
    // =========================================================================
    // 1. LABORATORIO DE LÓGICA INTERACTIVA (RECÍPROCOS Y CONTRAEJEMPLOS)
    // =========================================================================
    const selectEl = document.getElementById('statement-select') as HTMLSelectElement | null;
    const directText = document.getElementById('direct-text');
    const converseText = document.getElementById('converse-text');
    const counterText = document.getElementById('counterexample-text');
    const vennOuter = document.getElementById('venn-outer-label');
    const vennInner = document.getElementById('venn-inner-label');

    const statementsData: Record<string, { direct: string; converse: string; counter: string; outer: string; inner: string }> = {
      multiplo: {
        direct: 'Si un número es múltiplo de 4, entonces es un número par.',
        converse: 'Si un número es par, entonces es múltiplo de 4.',
        counter: 'El número 6 es un número par (6 = 2 × 3), pero NO es divisible por 4 (6 / 4 = 1.5). Un solo caso refuta por completo el recíproco.',
        outer: 'Números Pares (Q)',
        inner: 'Múltiplos de 4 (P)',
      },
      derivable: {
        direct: 'Si una función f(x) es derivable en x₀, entonces f(x) es continua en x₀.',
        converse: 'Si una función f(x) es continua en x₀, entonces f(x) es derivable en x₀.',
        counter: 'La función valor absoluto f(x) = |x| es perfectamente continua en x = 0, pero presenta un punto anguloso y NO es derivable en x = 0 (sus derivadas laterales son -1 y +1).',
        outer: 'Funciones Continuas (Q)',
        inner: 'Funciones Derivables (P)',
      },
      cuadrado: {
        direct: 'Si una figura geométrica es un cuadrado, entonces es un rectángulo.',
        converse: 'Si una figura geométrica es un rectángulo, entonces es un cuadrado.',
        counter: 'Una hoja de papel A4 tiene cuatro ángulos rectos de 90° (cumple la definición de rectángulo), pero sus lados no son iguales, por lo que NO es un cuadrado.',
        outer: 'Rectángulos (Q)',
        inner: 'Cuadrados (P)',
      },
    };

    if (selectEl) {
      selectEl.addEventListener('change', () => {
        const val = selectEl.value;
        const d = statementsData[val];
        if (!d) return;

        if (directText) directText.textContent = d.direct;
        if (converseText) converseText.textContent = d.converse;
        if (counterText) counterText.innerHTML = d.counter;
        if (vennOuter) vennOuter.textContent = d.outer;
        if (vennInner) vennInner.textContent = d.inner;
      });
    }

    // =========================================================================
    // 2. DEMOSTRACIÓN GEOMÉTRICA DE LA SUMA DE DOS IMPARES (FICHAS SUELTAS)
    // =========================================================================
    const inputA = document.getElementById('odd-a') as HTMLInputElement | null;
    const inputB = document.getElementById('odd-b') as HTMLInputElement | null;
    const valA = document.getElementById('val-a');
    const valB = document.getElementById('val-b');
    const pairsA = document.getElementById('pairs-a');
    const pairsB = document.getElementById('pairs-b');
    const pairsTotal = document.getElementById('pairs-total');
    const totalVerdict = document.getElementById('total-verdict');

    const renderGeoPairs = () => {
      if (!inputA || !inputB) return;
      const a = parseInt(inputA.value, 10);
      const b = parseInt(inputB.value, 10);
      const k = Math.floor(a / 2);
      const m = Math.floor(b / 2);
      const total = a + b;
      const totalPairs = total / 2;

      if (valA) valA.textContent = `${a} (k=${k})`;
      if (valB) valB.textContent = `${b} (m=${m})`;

      // Renderizar a: k parejas + 1 suelta
      if (pairsA) {
        pairsA.innerHTML = '';
        for (let i = 0; i < k; i++) {
          const p = document.createElement('span');
          p.className = 'pair-token';
          p.title = 'Pareja de fichas';
          p.textContent = '●●';
          pairsA.appendChild(p);
        }
        const loose = document.createElement('span');
        loose.className = 'loose-token';
        loose.title = 'Ficha impar suelta';
        loose.textContent = '●';
        pairsA.appendChild(loose);
      }

      // Renderizar b: m parejas + 1 suelta
      if (pairsB) {
        pairsB.innerHTML = '';
        for (let i = 0; i < m; i++) {
          const p = document.createElement('span');
          p.className = 'pair-token';
          p.title = 'Pareja de fichas';
          p.textContent = '●●';
          pairsB.appendChild(p);
        }
        const loose = document.createElement('span');
        loose.className = 'loose-token';
        loose.title = 'Ficha impar suelta';
        loose.textContent = '●';
        pairsB.appendChild(loose);
      }

      // Renderizar suma total: todas emparejadas perfectamente
      if (pairsTotal) {
        pairsTotal.innerHTML = '';
        for (let i = 0; i < totalPairs; i++) {
          const p = document.createElement('span');
          p.className = 'pair-token is-joined';
          p.textContent = '●●';
          pairsTotal.appendChild(p);
        }
      }

      if (totalVerdict) {
        totalVerdict.innerHTML = `<strong>${total}</strong> es <strong>PAR</strong>: son exactamente ${totalPairs} parejas (${k} + ${m} + 1 nueva pareja con las dos fichas sueltas).`;
      }
    };

    if (inputA && inputB) {
      inputA.addEventListener('input', renderGeoPairs);
      inputB.addEventListener('input', renderGeoPairs);
      renderGeoPairs();
    }

    // =========================================================================
    // 3. AUTOEVALUACIÓN INTERACTIVA
    // =========================================================================
    document.querySelectorAll<HTMLElement>('.quiz-card').forEach((card) => {
      const options = card.querySelectorAll<HTMLButtonElement>('.quiz-opt');
      const explanation = card.querySelector<HTMLElement>('.quiz-explanation');

      options.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isCorrect = btn.dataset.correct === 'true';

          options.forEach((o) => {
            o.disabled = true;
            if (o.dataset.correct === 'true') {
              o.classList.add('is-revealed-correct');
            }
          });

          if (isCorrect) {
            btn.classList.add('is-user-correct');
            if (explanation) {
              explanation.hidden = false;
              explanation.className = 'quiz-explanation is-good';
              explanation.innerHTML = '<strong>¡Exacto!</strong> Has razonado con rigor formal matemático.';
            }
          } else {
            btn.classList.add('is-user-wrong');
            if (explanation) {
              explanation.hidden = false;
              explanation.className = 'quiz-explanation is-bad';
              explanation.innerHTML = '<strong>Incorrecto.</strong> Revisa el concepto: un solo contraejemplo refuta un enunciado universal, mientras que una colección finita de ejemplos no demuestra una ley.';
            }
          }
        });
      });
    });
  })();
</script>

