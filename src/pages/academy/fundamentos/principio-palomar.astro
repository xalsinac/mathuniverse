<script>
  (() => {
    const arena = document.getElementById('boxes-arena');
    const slN = document.getElementById('sl-pal-n') as HTMLInputElement | null;
    const slM = document.getElementById('sl-pal-m') as HTMLInputElement | null;
    const lblN = document.getElementById('pal-n-lbl');
    const lblM = document.getElementById('pal-m-lbl');
    const statusBar = document.getElementById('pal-status-bar');
    const statusText = document.getElementById('pal-status-text');
    const btnOpt = document.getElementById('btn-mode-optimal');
    const btnRand = document.getElementById('btn-mode-random');

    let n = 7;
    let m = 6;
    let mode: 'optimal' | 'random' = 'optimal';

    function renderPalomar() {
      if (!arena) return;
      const counts = new Array(m).fill(0);
      if (mode === 'optimal') {
        for (let i = 0; i < n; i++) counts[i % m]++;
      } else {
        for (let i = 0; i < n; i++) counts[Math.floor(Math.random() * m)]++;
      }

      const ceilVal = Math.ceil(n / m);
      const maxInBox = Math.max(...counts);
      let anyCollision = false;

      arena.replaceChildren();
      counts.forEach((cnt, idx) => {
        const isColliding = cnt >= 2;
        if (isColliding) anyCollision = true;

        const box = document.createElement('div');
        box.className = `pal-box ${isColliding ? 'has-collision' : ''}`;

        const head = document.createElement('div');
        head.className = 'pal-box-head';
        head.innerHTML = `<span>Casilla ${idx + 1}</span><span>${cnt}</span>`;

        const dots = document.createElement('div');
        dots.className = 'pal-dots';
        for (let d = 0; d < cnt; d++) {
          const dot = document.createElement('span');
          dot.className = 'pal-dot';
          dots.appendChild(dot);
        }

        box.append(head, dots);
        arena.appendChild(box);
      });

      if (statusBar && statusText) {
        if (n > m) {
          statusBar.className = 'lab-status-bar is-collision';
          statusText.textContent = `n = ${n} > m = ${m}  ⇒  Colisión inevitable: cota garantizada ⌈${n}/${m}⌉ = ${ceilVal} (máximo observado: ${maxInBox}).`;
        } else if (anyCollision) {
          statusBar.className = 'lab-status-bar is-collision';
          statusText.textContent = `n = ${n} ≤ m = ${m}, pero el reparto aleatorio provocó una colisión de ${maxInBox} elementos.`;
        } else {
          statusBar.className = 'lab-status-bar is-safe';
          statusText.textContent = `n = ${n} ≤ m = ${m}  ⇒  Sin colisiones: cabe como máximo 1 elemento por casilla.`;
        }
      }
    }

    btnOpt?.addEventListener('click', () => {
      mode = 'optimal';
      btnOpt.classList.add('is-active');
      btnRand?.classList.remove('is-active');
      renderPalomar();
    });

    btnRand?.addEventListener('click', () => {
      mode = 'random';
      btnRand.classList.add('is-active');
      btnOpt?.classList.remove('is-active');
      renderPalomar();
    });

    slN?.addEventListener('input', (e) => {
      n = parseInt((e.target as HTMLInputElement).value, 10);
      if (lblN) lblN.textContent = String(n);
      renderPalomar();
    });

    slM?.addEventListener('input', (e) => {
      m = parseInt((e.target as HTMLInputElement).value, 10);
      if (lblM) lblM.textContent = String(m);
      renderPalomar();
    });

    renderPalomar();

    const fbMap: Record<string, { ok: string; ko: string }> = {
      p1: {
        ok: 'Correcto: Hay m = 3 colores (casillas). Con 3 calcetines podrían salir los 3 distintos; con el 4.º es imposible no repetir.',
        ko: 'Con 3 calcetines podrías sacar 1 azul, 1 rojo y 1 verde. Necesitas n = m + 1 = 4 para garantizar pareja.',
      },
      p2: {
        ok: 'Correcto: Por el Palomar Fuerte, ⌈25 / 4⌉ = ⌈6,25⌉ = 7 alumnos como mínimo en al menos un aula.',
        ko: 'Si hubiera como máximo 6 por aula solo cabrían 4 × 6 = 24 alumnos. El alumno 25 obliga a que haya al menos 7 en una.',
      },
    };

    document.querySelectorAll<HTMLElement>('.quiz-options').forEach((group) => {
      const qId = group.getAttribute('data-quiz') || '';
      const fbEl = document.getElementById(`fb-${qId}`);
      const buttons = group.querySelectorAll<HTMLButtonElement>('.quiz-opt');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((b) => b.classList.remove('is-right', 'is-wrong'));
          const isOk = btn.getAttribute('data-correct') === 'true';
          btn.classList.add(isOk ? 'is-right' : 'is-wrong');
          if (fbEl && fbMap[qId]) {
            fbEl.hidden = false;
            fbEl.textContent = isOk ? fbMap[qId].ok : fbMap[qId].ko;
            fbEl.style.color = isOk ? '#10b981' : '#f43f5e';
          }
        });
      });
    });
  })();
</script>
