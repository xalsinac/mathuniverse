</style>

<script>
  (() => {
    const canvas = document.getElementById('blocks-lab-canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    const slN = document.getElementById('sl-blk-n') as HTMLInputElement | null;
    const lblN = document.getElementById('blk-n-lbl');
    const chkDup = document.getElementById('chk-dup-stairs') as HTMLInputElement | null;
    const wrapDup = document.getElementById('wrap-duplicate-toggle');
    const roLast = document.getElementById('ro-blk-last');
    const roDim = document.getElementById('ro-blk-dim');
    const roSum = document.getElementById('ro-blk-sum');
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-b-mode]');

    let bMode: 'gauss' | 'odd' = 'gauss';
    let nVal = 6;
    let showDup = true;

    const ODD_COLORS = ['#38bdf8', '#10b981', '#c084fc', '#fbbf24', '#f43f5e', '#60a5fa'];

    function drawBlocks() {
      if (!canvas || !ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (w === 0 || h === 0) return;

      if (canvas.width !== Math.floor(w * dpr) || canvas.height !== Math.floor(h * dpr)) {
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
      }

      const isLight = document.documentElement.dataset.theme === 'light';
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      if (bMode === 'gauss') {
        const cols = showDup ? nVal + 1 : nVal;
        const rows = nVal;
        const cell = Math.min((w - 64) / Math.max(1, cols), (h - 56) / Math.max(1, rows), 42);
        const startX = (w - cols * cell) / 2;
        const startY = (h - rows * cell) / 2;

        for (let r = 0; r < rows; r++) {
          const count = r + 1;
          for (let c = 0; c < cols; c++) {
            const x = startX + c * cell;
            const y = startY + r * cell;
            if (c < count) {
              // Escalera original (cyan)
              ctx.fillStyle = 'rgba(56, 189, 248, 0.35)';
              ctx.strokeStyle = '#38bdf8';
              ctx.lineWidth = 1.4;
              ctx.fillRect(x + 1, y + 1, cell - 2, cell - 2);
              ctx.strokeRect(x + 1, y + 1, cell - 2, cell - 2);
            } else if (showDup) {
              // Segunda escalera rotada 180° (violeta)
              ctx.fillStyle = 'rgba(192, 132, 252, 0.32)';
              ctx.strokeStyle = '#c084fc';
              ctx.lineWidth = 1.4;
              ctx.fillRect(x + 1, y + 1, cell - 2, cell - 2);
              ctx.strokeRect(x + 1, y + 1, cell - 2, cell - 2);
            }
          }
        }

        // Etiquetas de dimensiones
        ctx.font = 'bold 12px monospace';
        ctx.fillStyle = isLight ? '#0f172a' : '#f8fafc';
        ctx.textAlign = 'center';
        ctx.fillText(showDup ? `Base = n + 1 = ${nVal + 1}` : `Base = n = ${nVal}`, w / 2, startY + rows * cell + 18);
        ctx.fillText(`Altura = n = ${nVal}`, w / 2, startY - 10);

        const sumGauss = (nVal * (nVal + 1)) / 2;
        if (roLast) roLast.textContent = `${nVal} bloques`;
        if (roDim) roDim.textContent = showDup ? `${nVal} × ${nVal + 1} = ${nVal * (nVal + 1)}` : `Escalera ${nVal}`;
        if (roSum) roSum.textContent = `${sumGauss}`;
      } else {
        // Escuadras impares: cuadrado n x n
        const cell = Math.min((w - 64) / nVal, (h - 56) / nVal, 44);
        const startX = (w - nVal * cell) / 2;
        const startY = (h - nVal * cell) / 2;

        for (let r = 0; r < nVal; r++) {
          for (let c = 0; c < nVal; c++) {
            const layer = Math.max(r, c); // Escuadra k = layer + 1
            const col = ODD_COLORS[layer % ODD_COLORS.length];
            const x = startX + c * cell;
            const y = startY + r * cell;
            ctx.fillStyle = col + '44';
            ctx.strokeStyle = col;
            ctx.lineWidth = 1.4;
            ctx.fillRect(x + 1, y + 1, cell - 2, cell - 2);
            ctx.strokeRect(x + 1, y + 1, cell - 2, cell - 2);
          }
        }

        ctx.font = 'bold 12px monospace';
        ctx.fillStyle = isLight ? '#0f172a' : '#f8fafc';
        ctx.textAlign = 'center';
        ctx.fillText(`Cuadrado perfecto ${nVal} × ${nVal} = ${nVal * nVal}`, w / 2, startY + nVal * cell + 18);

        if (roLast) roLast.textContent = `2(${nVal}) − 1 = ${2 * nVal - 1}`;
        if (roDim) roDim.textContent = `${nVal} × ${nVal}`;
        if (roSum) roSum.textContent = `${nVal * nVal}`;
      }

      ctx.restore();
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        bMode = (tab.getAttribute('data-b-mode') as 'gauss' | 'odd') || 'gauss';
        if (wrapDup) wrapDup.hidden = bMode !== 'gauss';
        drawBlocks();
      });
    });

    slN?.addEventListener('input', (e) => {
      nVal = parseInt((e.target as HTMLInputElement).value, 10);
      if (lblN) lblN.textContent = String(nVal);
      drawBlocks();
    });

    chkDup?.addEventListener('change', (e) => {
      showDup = (e.target as HTMLInputElement).checked;
      drawBlocks();
    });

    window.addEventListener('resize', drawBlocks);
    new MutationObserver(drawBlocks).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    drawBlocks();

    const fbMap: Record<string, { ok: string; ko: string }> = {
      g1: {
        ok: 'Correcto: El primero juega 11 partidas, el segundo 10 nuevas… Suma de 1 a 11 = 11·12/2 = 66 partidas.',
        ko: 'Cada jugador juega contra los otros 11 sin repetir: 11 + 10 + … + 1 = 11·12 / 2 = 66 partidas.',
      },
      g2: {
        ok: 'Correcto: La suma de los primeros n = 20 impares es exactamente n² = 20² = 400.',
        ko: 'Recuerda la fórmula de las escuadras: sumar los primeros n = 20 impares da n² = 20² = 400.',
      },
    };

    document.querySelectorAll<HTMLElement>('.quiz-options').forEach((group) => {
      const qId = group.getAttribute('data-quiz') || '';
      const fbEl = document.getElementById(`fb-${qId}`);
      const buttons = group.querySelectorAll<HTMLButtonElement>('.quiz-opt');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((b) => b.classList.remove('is-right', 'is-wrong'));
          const isOk = btn.getAttribute('data-correct') === 'true';
          btn.classList.add(isOk ? 'is-right' : 'is-wrong');
          if (fbEl && fbMap[qId]) {
            fbEl.hidden = false;
            fbEl.textContent = isOk ? fbMap[qId].ok : fbMap[qId].ko;
            fbEl.style.color = isOk ? '#10b981' : '#f43f5e';
          }
        });
      });
    });
  })();
</script>
