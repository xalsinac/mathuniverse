  .counter-interactive-card {
    margin: 1.25rem 0;
    border-color: rgba(244, 63, 94, 0.3);
  }

  .counter-header h4 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }

  .counter-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: center;
  }

  @media (max-width: 720px) {
    .counter-split {
      grid-template-columns: 1fr;
    }
  }

  .counter-controls {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .ce-metrics {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .ce-metric-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.86rem;
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line, rgba(255, 255, 255, 0.08));
  }

  .ce-val {
    font-family: var(--mono, monospace);
  }

  .ce-status-pill {
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    font-family: var(--mono, monospace);
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
  }

  .ce-status-pill.is-broken {
    background: rgba(244, 63, 94, 0.16);
    color: #fda4af;
    border: 1px solid rgba(244, 63, 94, 0.4);
  }

  .ce-status-pill.is-valid {
    background: rgba(16, 185, 129, 0.16);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  :global([data-theme="light"]) .ce-status-pill.is-broken { color: #be123c; }
  :global([data-theme="light"]) .ce-status-pill.is-valid { color: #047857; }

  .ce-tip {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted, #94a3b8);
  }

  .ce-static-card h4,
  .app-card h4 {
    margin: 0 0 0.55rem;
    font-size: 0.98rem;
  }

  /* PULGAR ESTIRADO */
  .thumb-sim-card {
    margin: 1.25rem 0;
    border-color: rgba(251, 191, 36, 0.3);
  }

  .thumb-sim-card h3 {
    margin: 0 0 0.6rem;
  }

  .thumb-calc-box {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    margin-top: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line, rgba(255, 255, 255, 0.1));
  }

  @media (max-width: 640px) {
    .thumb-calc-box {
      grid-template-columns: 1fr;
    }
  }

  .thumb-result {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    text-align: center;
  }

  .thumb-result span {
    font-size: 0.72rem;
    color: var(--muted, #94a3b8);
  }

  .thumb-result strong {
    font-family: var(--mono, monospace);
    font-size: 1.15rem;
    color: #10b981;
  }

  /* QUIZ */
  .quiz-q {
    margin: 0 0 0.85rem;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .quiz-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .quiz-opt {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line, rgba(255, 255, 255, 0.15));
    color: var(--ink-strong, #f8fafc);
    padding: 0.45rem 0.9rem;
    border-radius: 7px;
    font-family: var(--mono, monospace);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .quiz-opt:hover {
    border-color: #c084fc;
  }

  .quiz-opt.is-right {
    background: rgba(16, 185, 129, 0.2);
    border-color: #10b981;
    color: #34d399;
  }

  .quiz-opt.is-wrong {
    background: rgba(244, 63, 94, 0.2);
    border-color: #f43f5e;
    color: #fda4af;
  }

  .quiz-feedback {
    margin: 0.75rem 0 0;
    font-size: 0.84rem;
    line-height: 1.45;
  }
</style>

<script>
  (() => {
    // =========================================================================
    // 1. LABORATORIO INTERACTIVO DE TALES & DEMOSTRACIÓN POR ÁREAS
    // =========================================================================
    const canvas = document.getElementById('tales-lab-canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    const sliderK = document.getElementById('slider-tales-k') as HTMLInputElement | null;
    const sliderSkew = document.getElementById('slider-tales-skew') as HTMLInputElement | null;
    const kValLabel = document.getElementById('tales-k-val');
    const skewValLabel = document.getElementById('tales-skew-val');
    const roOA = document.getElementById('ro-oa');
    const roOB = document.getElementById('ro-ob');
    const roAB = document.getElementById('ro-ab');
    const roArea = document.getElementById('ro-area');
    const readoutRatios = document.getElementById('readout-ratios');
    const readoutAreas = document.getElementById('readout-areas');
    const roAreaPair = document.getElementById('ro-area-pair');
    const labTabs = document.querySelectorAll<HTMLButtonElement>('[data-lab-mode]');

    let labMode: 'ratios' | 'areas' = 'ratios';
    let kScale = 0.60;
    let skewX = -40;

    function triArea(p1: { x: number; y: number }, p2: { x: number; y: number }, p3: { x: number; y: number }): number {
      return Math.abs((p1.x * (p2.y - p3.y) + p2.x * (p3.y - p1.y) + p3.x * (p1.y - p2.y)) / 2);
    }

    function dist(p1: { x: number; y: number }, p2: { x: number; y: number }): number {
      return Math.hypot(p2.x - p1.x, p2.y - p1.y);
    }

    function drawLab() {
      if (!canvas || !ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (w === 0 || h === 0) return;

      if (canvas.width !== Math.floor(w * dpr) || canvas.height !== Math.floor(h * dpr)) {
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
      }

      const isLight = document.documentElement.dataset.theme === 'light';
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      // Puntos base O, A, B
      const O = { x: w * 0.5 + skewX, y: 42 };
      const baseW = Math.min(w * 0.68, 420);
      const baseY = h - 78;
      const A = { x: w * 0.5 - baseW * 0.5, y: baseY };
      const B = { x: w * 0.5 + baseW * 0.5, y: baseY };

      const Ap = { x: O.x + (A.x - O.x) * kScale, y: O.y + (A.y - O.y) * kScale };
      const Bp = { x: O.x + (B.x - O.x) * kScale, y: O.y + (B.y - O.y) * kScale };

      // Cuadrícula de fondo sutil
      ctx.strokeStyle = isLight ? 'rgba(15, 23, 42, 0.05)' : 'rgba(255, 255, 255, 0.04)';
      ctx.lineWidth = 1;
      for (let gx = 0; gx < w; gx += 32) {
        ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, h); ctx.stroke();
      }
      for (let gy = 0; gy < h; gy += 32) {
        ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(w, gy); ctx.stroke();
      }

      if (labMode === 'areas') {
        // Triángulo A'B'A (naranja) y A'B'B (verde) entre paralelas
        ctx.fillStyle = 'rgba(251, 191, 36, 0.24)';
        ctx.beginPath();
        ctx.moveTo(Ap.x, Ap.y); ctx.lineTo(Bp.x, Bp.y); ctx.lineTo(A.x, A.y);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = '#fbbf24';
        ctx.lineWidth = 1.6;
        ctx.stroke();

        ctx.fillStyle = 'rgba(16, 185, 129, 0.24)';
        ctx.beginPath();
        ctx.moveTo(Ap.x, Ap.y); ctx.lineTo(Bp.x, Bp.y); ctx.lineTo(B.x, B.y);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = '#10b981';
        ctx.lineWidth = 1.6;
        ctx.stroke();

        // Altura h entre las paralelas
        const hx = (Ap.x + Bp.x) / 2;
        ctx.strokeStyle = isLight ? '#0f172a' : '#f8fafc';
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(hx, Ap.y);
        ctx.lineTo(hx, A.y);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = isLight ? '#0f172a' : '#f8fafc';
        ctx.font = 'bold 12px monospace';
        ctx.fillText('h', hx + 6, (Ap.y + A.y) / 2 + 4);

        const a1 = triArea(Ap, Bp, A);
        const a2 = triArea(Ap, Bp, B);
        if (roAreaPair) {
          roAreaPair.textContent = `Área(△A′B′A) = ${Math.round(a1)} px²  =  Área(△A′B′B) = ${Math.round(a2)} px²`;
        }
      } else {
        // Relleno triángulo grande y pequeño
        ctx.fillStyle = 'rgba(192, 132, 252, 0.10)';
        ctx.beginPath();
        ctx.moveTo(O.x, O.y); ctx.lineTo(A.x, A.y); ctx.lineTo(B.x, B.y);
        ctx.closePath();
        ctx.fill();

        ctx.fillStyle = 'rgba(56, 189, 248, 0.18)';
        ctx.beginPath();
        ctx.moveTo(O.x, O.y); ctx.lineTo(Ap.x, Ap.y); ctx.lineTo(Bp.x, Bp.y);
        ctx.closePath();
        ctx.fill();
      }

      // Secantes prolongadas desde O
      const ext = Math.max(1.1, kScale + 0.12);
      const endA = { x: O.x + (A.x - O.x) * ext, y: O.y + (A.y - O.y) * ext };
      const endB = { x: O.x + (B.x - O.x) * ext, y: O.y + (B.y - O.y) * ext };

      ctx.strokeStyle = isLight ? '#334155' : '#cbd5e1';
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(O.x, O.y); ctx.lineTo(endA.x, endA.y); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(O.x, O.y); ctx.lineTo(endB.x, endB.y); ctx.stroke();

      // Base AB y paralela A'B'
      ctx.strokeStyle = '#c084fc';
      ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(A.x, A.y); ctx.lineTo(B.x, B.y); ctx.stroke();

      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(Ap.x, Ap.y); ctx.lineTo(Bp.x, Bp.y); ctx.stroke();

      // Puntos y etiquetas
      const pts = [
        { p: O, lbl: 'O', color: '#fbbf24', dx: 0, dy: -14 },
        { p: A, lbl: 'A', color: '#c084fc', dx: -16, dy: 6 },
        { p: B, lbl: 'B', color: '#c084fc', dx: 14, dy: 6 },
        { p: Ap, lbl: 'A′', color: '#38bdf8', dx: -18, dy: 4 },
        { p: Bp, lbl: 'B′', color: '#38bdf8', dx: 16, dy: 4 },
      ];
      ctx.font = 'bold 13px monospace';
      ctx.textAlign = 'center';
      pts.forEach(({ p, lbl, color, dx, dy }) => {
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillText(lbl, p.x + dx, p.y + dy);
      });

      // Actualizar métricas
      const rOA = dist(O, Ap) / dist(O, A);
      const rOB = dist(O, Bp) / dist(O, B);
      const rAB = dist(Ap, Bp) / dist(A, B);
      const rArea = triArea(O, Ap, Bp) / triArea(O, A, B);

      if (roOA) roOA.textContent = rOA.toFixed(3);
      if (roOB) roOB.textContent = rOB.toFixed(3);
      if (roAB) roAB.textContent = rAB.toFixed(3);
      if (roArea) roArea.textContent = rArea.toFixed(3);

      ctx.restore();
    }

    labTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        labTabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        labMode = (tab.getAttribute('data-lab-mode') as 'ratios' | 'areas') || 'ratios';
        if (readoutRatios) readoutRatios.hidden = labMode === 'areas';
        if (readoutAreas) readoutAreas.hidden = labMode === 'ratios';
        drawLab();
      });
    });

    sliderK?.addEventListener('input', (e) => {
      kScale = parseFloat((e.target as HTMLInputElement).value);
      if (kValLabel) kValLabel.textContent = kScale.toFixed(2);
      drawLab();
    });

    sliderSkew?.addEventListener('input', (e) => {
      skewX = parseFloat((e.target as HTMLInputElement).value);
      if (skewValLabel) skewValLabel.textContent = `${Math.round((skewX / 110) * 35)}°`;
      drawLab();
    });

    window.addEventListener('resize', drawLab);
    new MutationObserver(drawLab).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    drawLab();

    // =========================================================================
    // 2. CONTRAEJEMPLO INTERACTIVO: RECTA NO PARALELA
    // =========================================================================
    const sliderTilt = document.getElementById('slider-ce-tilt') as HTMLInputElement | null;
    const ceTiltVal = document.getElementById('ce-tilt-val');
    const ceCutLine = document.getElementById('ce-cut-line');
    const ceDotA = document.getElementById('ce-dot-a');
    const ceDotB = document.getElementById('ce-dot-b');
    const ceLblA = document.getElementById('ce-lbl-a');
    const ceLblB = document.getElementById('ce-lbl-b');
    const ceRatioL = document.getElementById('ce-ratio-l');
    const ceRatioR = document.getElementById('ce-ratio-r');
    const ceStatusPill = document.getElementById('ce-status-pill');

    function updateCounterexample(tiltDeg: number) {
      if (ceTiltVal) ceTiltVal.textContent = `${tiltDeg > 0 ? '+' : ''}${tiltDeg}°`;

      // Base: O=(150,25), A=(40,170), B=(280,170), corte medio en t=0.50
      const tL = Math.max(0.2, Math.min(0.85, 0.5 - tiltDeg * 0.01));
      const tR = Math.max(0.2, Math.min(0.85, 0.5 + tiltDeg * 0.01));

      const ax = 150 + (40 - 150) * tL;
      const ay = 25 + (170 - 25) * tL;
      const bx = 150 + (280 - 150) * tR;
      const by = 25 + (170 - 25) * tR;

      const isParallel = tiltDeg === 0;
      const strokeColor = isParallel ? '#10b981' : '#f43f5e';

      ceCutLine?.setAttribute('x1', ax.toFixed(1));
      ceCutLine?.setAttribute('y1', ay.toFixed(1));
      ceCutLine?.setAttribute('x2', bx.toFixed(1));
      ceCutLine?.setAttribute('y2', by.toFixed(1));
      ceCutLine?.setAttribute('stroke', strokeColor);

      ceDotA?.setAttribute('cx', ax.toFixed(1));
      ceDotA?.setAttribute('cy', ay.toFixed(1));
      ceDotA?.setAttribute('fill', strokeColor);
      ceLblA?.setAttribute('x', (ax - 12).toFixed(1));
      ceLblA?.setAttribute('y', (ay + 4).toFixed(1));

      ceDotB?.setAttribute('cx', bx.toFixed(1));
      ceDotB?.setAttribute('cy', by.toFixed(1));
      ceDotB?.setAttribute('fill', strokeColor);
      ceLblB?.setAttribute('x', (bx + 12).toFixed(1));
      ceLblB?.setAttribute('y', (by + 4).toFixed(1));

      if (ceRatioL) ceRatioL.textContent = tL.toFixed(2);
      if (ceRatioR) ceRatioR.textContent = tR.toFixed(2);
      if (ceStatusPill) {
        if (isParallel) {
          ceStatusPill.className = 'ce-status-pill is-valid';
          ceStatusPill.textContent = `A′B′ ∥ AB — ¡Proporcionalidad exacta! (${tL.toFixed(2)} = ${tR.toFixed(2)})`;
        } else {
          ceStatusPill.className = 'ce-status-pill is-broken';
          ceStatusPill.textContent = `A′B′ ∦ AB — ¡Proporcionalidad rota! (${tL.toFixed(2)} ≠ ${tR.toFixed(2)})`;
        }
      }
    }

    sliderTilt?.addEventListener('input', (e) => {
      updateCounterexample(parseInt((e.target as HTMLInputElement).value, 10));
    });
    updateCounterexample(18);

    // =========================================================================
    // 3. CALCULADORA DE PARALAJE DEL PULGAR ESTIRADO
    // =========================================================================
    const sliderThumb = document.getElementById('slider-thumb-w') as HTMLInputElement | null;
    const thumbWVal = document.getElementById('thumb-w-val');
    const thumbDVal = document.getElementById('thumb-d-val');

    sliderThumb?.addEventListener('input', (e) => {
      const wVal = parseInt((e.target as HTMLInputElement).value, 10);
      if (thumbWVal) thumbWVal.textContent = `${wVal} m`;
      if (thumbDVal) thumbDVal.textContent = `${wVal * 10} metros`;
    });

    // =========================================================================
    // 4. QUIZ DE COMPROBACIÓN PRÁCTICA
    // =========================================================================
    const feedbackMap: Record<string, { ok: string; ko: string }> = {
      q1: {
        ok: 'Correcto: H / 24 = 1,8 / 1,2 = 1,5  ⇒  H = 24 · 1,5 = 36 metros.',
        ko: 'Revisa la proporción: H / 24 = 1,8 / 1,2. Despejando, H = 24 · (1,8 / 1,2) = 36 m.',
      },
      q2: {
        ok: 'Correcto: Si los lados se multiplican por k = 3, el área se multiplica por k² = 9  ⇒  10 · 9 = 90 cm².',
        ko: 'Recuerda la ley cuadrática de escala: las longitudes escalan por k, pero las áreas escalan por k² = 3² = 9.',
      },
    };

    document.querySelectorAll<HTMLElement>('.quiz-options').forEach((group) => {
      const qId = group.getAttribute('data-quiz') || '';
      const fbEl = document.getElementById(`fb-${qId}`);
      const buttons = group.querySelectorAll<HTMLButtonElement>('.quiz-opt');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((b) => b.classList.remove('is-right', 'is-wrong'));
          const isOk = btn.getAttribute('data-correct') === 'true';
          btn.classList.add(isOk ? 'is-right' : 'is-wrong');
          if (fbEl && feedbackMap[qId]) {
            fbEl.hidden = false;
            fbEl.textContent = isOk ? feedbackMap[qId].ok : feedbackMap[qId].ko;
            fbEl.style.color = isOk ? '#10b981' : '#f43f5e';
          }
        });
      });
    });
  })();
</script>
