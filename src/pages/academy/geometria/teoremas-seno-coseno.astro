<script>
  (() => {
    // =========================================================================
    // 1. LABORATORIO UNIFICADO SENO & COSENO
    // =========================================================================
    const canvas = document.getElementById('trig-lab-canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    const slA = document.getElementById('sl-a') as HTMLInputElement | null;
    const slB = document.getElementById('sl-b') as HTMLInputElement | null;
    const slGamma = document.getElementById('sl-gamma') as HTMLInputElement | null;
    const lblA = document.getElementById('lbl-a');
    const lblB = document.getElementById('lbl-b');
    const lblGamma = document.getElementById('lbl-gamma');
    const btn90 = document.getElementById('btn-set-90');
    const trigTabs = document.querySelectorAll<HTMLButtonElement>('[data-trig-mode]');

    const roCos = document.getElementById('trig-readout-cos');
    const roSin = document.getElementById('trig-readout-sin');
    const roAB2 = document.getElementById('ro-ab2');
    const roCorr = document.getElementById('ro-corr');
    const roC2 = document.getElementById('ro-c2');
    const roC = document.getElementById('ro-c');
    const roSA = document.getElementById('ro-sa');
    const roSB = document.getElementById('ro-sb');
    const roSC = document.getElementById('ro-sc');
    const ro2R = document.getElementById('ro-2r');

    let trigMode: 'cos' | 'sin' = 'cos';
    let a = 6.0;
    let b = 5.0;
    let gammaDeg = 62;

    function drawTrigLab() {
      if (!canvas || !ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (w === 0 || h === 0) return;

      if (canvas.width !== Math.floor(w * dpr) || canvas.height !== Math.floor(h * dpr)) {
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
      }

      const isLight = document.documentElement.dataset.theme === 'light';
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, w, h);

      const gamma = (gammaDeg * Math.PI) / 180;
      const c2 = a * a + b * b - 2 * a * b * Math.cos(gamma);
      const c = Math.sqrt(Math.max(0.001, c2));

      // Coordenadas del triángulo en unidades matemáticas: C=(0,0), B=(a,0), A=(b cos γ, b sen γ)
      const Cx = 0, Cy = 0;
      const Bx = a, By = 0;
      const Ax = b * Math.cos(gamma), Ay = b * Math.sin(gamma);

      // Circuncentro y radio R para auto-encuadre
      const D = 2 * (Ax * By - Bx * Ay); // = -2 * a * b * sin(gamma)
      const a2 = Ax * Ax + Ay * Ay;
      const b2 = Bx * Bx + By * By;
      const ux = (a2 * By - b2 * Ay) / (D || 1);
      const uy = (Ax * b2 - Bx * a2) / (D || 1);
      const R = Math.hypot(ux, uy);

      // Escala dinámica para que quepa en ambos modos
      let minX = Math.min(0, Ax, Bx), maxX = Math.max(0, Ax, Bx);
      let minY = Math.min(0, Ay, By), maxY = Math.max(0, Ay, By);
      if (trigMode === 'sin') {
        minX = Math.min(minX, ux - R);
        maxX = Math.max(maxX, ux + R);
        minY = Math.min(minY, uy - R);
        maxY = Math.max(maxY, uy + R);
      }
      const spanX = Math.max(1, maxX - minX);
      const spanY = Math.max(1, maxY - minY);
      const pad = 42;
      const pxScale = Math.min((w - pad * 2) / spanX, (h - pad * 2) / spanY);

      const midX = (minX + maxX) / 2;
      const midY = (minY + maxY) / 2;
      const toScreen = (mx: number, my: number) => ({
        x: w / 2 + (mx - midX) * pxScale,
        y: h / 2 - (my - midY) * pxScale,
      });

      const sC = toScreen(Cx, Cy);
      const sB = toScreen(Bx, By);
      const sA = toScreen(Ax, Ay);
      const sH = toScreen(Ax, 0);
      const sO = toScreen(ux, uy);

      // Circunferencia circunscrita en modo seno
      if (trigMode === 'sin') {
        ctx.strokeStyle = 'rgba(251, 191, 36, 0.5)';
        ctx.lineWidth = 1.8;
        ctx.setLineDash([5, 4]);
        ctx.beginPath();
        ctx.arc(sO.x, sO.y, R * pxScale, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);

        // Radio R desde centro O hasta B
        ctx.strokeStyle = '#fbbf24';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(sO.x, sO.y);
        ctx.lineTo(sB.x, sB.y);
        ctx.stroke();

        ctx.fillStyle = '#fbbf24';
        ctx.beginPath(); ctx.arc(sO.x, sO.y, 4, 0, Math.PI * 2); ctx.fill();
        ctx.font = 'bold 12px monospace';
        ctx.fillText(`R = ${R.toFixed(2)}`, (sO.x + sB.x) / 2 + 6, (sO.y + sB.y) / 2 - 6);
      } else {
        // Proyección exterior si gamma > 90°
        if (Ax < 0) {
          ctx.strokeStyle = isLight ? 'rgba(15, 23, 42, 0.35)' : 'rgba(255, 255, 255, 0.35)';
          ctx.lineWidth = 1.5;
          ctx.setLineDash([4, 4]);
          ctx.beginPath(); ctx.moveTo(sH.x, sH.y); ctx.lineTo(sC.x, sC.y); ctx.stroke();
          ctx.setLineDash([]);
        }
        // Altura h
        ctx.strokeStyle = '#fbbf24';
        ctx.lineWidth = 2;
        ctx.setLineDash([4, 3]);
        ctx.beginPath(); ctx.moveTo(sA.x, sA.y); ctx.lineTo(sH.x, sH.y); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#fbbf24';
        ctx.font = 'bold 12px monospace';
        ctx.fillText('h', sA.x + 8, (sA.y + sH.y) / 2);
      }

      // Triángulo principal
      ctx.fillStyle = gammaDeg === 90 ? 'rgba(16, 185, 129, 0.16)' : 'rgba(56, 189, 248, 0.14)';
      ctx.beginPath();
      ctx.moveTo(sC.x, sC.y); ctx.lineTo(sB.x, sB.y); ctx.lineTo(sA.x, sA.y);
      ctx.closePath();
      ctx.fill();

      // Lados
      ctx.lineWidth = 2.8;
      ctx.strokeStyle = '#c084fc';
      ctx.beginPath(); ctx.moveTo(sC.x, sC.y); ctx.lineTo(sB.x, sB.y); ctx.stroke(); // a
      ctx.beginPath(); ctx.moveTo(sC.x, sC.y); ctx.lineTo(sA.x, sA.y); ctx.stroke(); // b

      ctx.strokeStyle = gammaDeg === 90 ? '#10b981' : '#38bdf8';
      ctx.beginPath(); ctx.moveTo(sB.x, sB.y); ctx.lineTo(sA.x, sA.y); ctx.stroke(); // c

      // Etiquetas de vértices y lados
      ctx.font = 'bold 13px monospace';
      ctx.textAlign = 'center';
      ctx.fillStyle = isLight ? '#0f172a' : '#f8fafc';
      ctx.fillText(`C (${gammaDeg}°)`, sC.x - 4, sC.y + 18);
      ctx.fillText('B', sB.x + 12, sB.y + 14);
      ctx.fillText('A', sA.x, sA.y - 10);

      ctx.fillStyle = '#c084fc';
      ctx.fillText(`a=${a.toFixed(1)}`, (sC.x + sB.x) / 2, sC.y + 18);
      ctx.fillText(`b=${b.toFixed(1)}`, (sC.x + sA.x) / 2 - 22, (sC.y + sA.y) / 2);
      ctx.fillStyle = gammaDeg === 90 ? '#10b981' : '#38bdf8';
      ctx.fillText(`c=${c.toFixed(2)}`, (sA.x + sB.x) / 2 + 24, (sA.y + sB.y) / 2);

      // Actualizar paneles de lectura
      const corr = -2 * a * b * Math.cos(gamma);
      if (roAB2) roAB2.textContent = (a * a + b * b).toFixed(2);
      if (roCorr) roCorr.textContent = `${corr >= 0 ? '+' : '−'}${Math.abs(corr).toFixed(2)}`;
      if (roC2) roC2.textContent = c2.toFixed(2);
      if (roC) roC.textContent = c.toFixed(2);

      const ratio2R = c / Math.sin(gamma);
      if (roSA) roSA.textContent = ratio2R.toFixed(2);
      if (roSB) roSB.textContent = ratio2R.toFixed(2);
      if (roSC) roSC.textContent = ratio2R.toFixed(2);
      if (ro2R) ro2R.textContent = (2 * R).toFixed(2);

      ctx.restore();
    }

    trigTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        trigTabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        trigMode = (tab.getAttribute('data-trig-mode') as 'cos' | 'sin') || 'cos';
        if (roCos) roCos.hidden = trigMode !== 'cos';
        if (roSin) roSin.hidden = trigMode !== 'sin';
        drawTrigLab();
      });
    });

    slA?.addEventListener('input', (e) => {
      a = parseFloat((e.target as HTMLInputElement).value);
      if (lblA) lblA.textContent = a.toFixed(1);
      drawTrigLab();
    });
    slB?.addEventListener('input', (e) => {
      b = parseFloat((e.target as HTMLInputElement).value);
      if (lblB) lblB.textContent = b.toFixed(1);
      drawTrigLab();
    });
    slGamma?.addEventListener('input', (e) => {
      gammaDeg = parseInt((e.target as HTMLInputElement).value, 10);
      if (lblGamma) lblGamma.textContent = `${gammaDeg}°`;
      drawTrigLab();
    });
    btn90?.addEventListener('click', () => {
      gammaDeg = 90;
      if (slGamma) slGamma.value = '90';
      if (lblGamma) lblGamma.textContent = '90°';
      drawTrigLab();
    });

    // =========================================================================
    // 2. EXPLORADOR DEL CASO AMBIGUO (LLA)
    // =========================================================================
    const ambigCanvas = document.getElementById('ambig-canvas') as HTMLCanvasElement | null;
    const ambigCtx = ambigCanvas?.getContext('2d');
    const slAmbigA = document.getElementById('sl-ambig-a') as HTMLInputElement | null;
    const ambigAVal = document.getElementById('ambig-a-val');
    const ambigStatus = document.getElementById('ambig-status');

    let ambigA = 4.2;
    const ambigB = 6.0;
    const ambigAlpha = (32 * Math.PI) / 180;

    function drawAmbiguous() {
      if (!ambigCanvas || !ambigCtx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = ambigCanvas.clientWidth;
      const h = ambigCanvas.clientHeight;
      if (w === 0 || h === 0) return;

      if (ambigCanvas.width !== Math.floor(w * dpr) || ambigCanvas.height !== Math.floor(h * dpr)) {
        ambigCanvas.width = Math.floor(w * dpr);
        ambigCanvas.height = Math.floor(h * dpr);
      }

      const isLight = document.documentElement.dataset.theme === 'light';
      ambigCtx.save();
      ambigCtx.scale(dpr, dpr);
      ambigCtx.clearRect(0, 0, w, h);

      const sc = Math.min(w / 14.5, h / 5.5);
      const origin = { x: 34, y: h - 38 };
      const C = {
        x: origin.x + ambigB * Math.cos(ambigAlpha) * sc,
        y: origin.y - ambigB * Math.sin(ambigAlpha) * sc,
      };
      const H = { x: C.x, y: origin.y };
      const hCrit = ambigB * Math.sin(ambigAlpha);

      // Rayo base horizontal desde A
      ambigCtx.strokeStyle = isLight ? 'rgba(15, 23, 42, 0.4)' : 'rgba(255, 255, 255, 0.35)';
      ambigCtx.lineWidth = 1.8;
      ambigCtx.beginPath();
      ambigCtx.moveTo(origin.x, origin.y);
      ambigCtx.lineTo(w - 18, origin.y);
      ambigCtx.stroke();

      // Lado fijo b
      ambigCtx.strokeStyle = '#38bdf8';
      ambigCtx.lineWidth = 2.6;
      ambigCtx.beginPath();
      ambigCtx.moveTo(origin.x, origin.y);
      ambigCtx.lineTo(C.x, C.y);
      ambigCtx.stroke();

      // Altura crítica h
      ambigCtx.strokeStyle = '#94a3b8';
      ambigCtx.lineWidth = 1.2;
      ambigCtx.setLineDash([3, 3]);
      ambigCtx.beginPath();
      ambigCtx.moveTo(C.x, C.y);
      ambigCtx.lineTo(H.x, H.y);
      ambigCtx.stroke();
      ambigCtx.setLineDash([]);

      // Arco de compás de radio a centrado en C
      const rPx = ambigA * sc;
      ambigCtx.strokeStyle = 'rgba(251, 191, 36, 0.55)';
      ambigCtx.lineWidth = 1.5;
      ambigCtx.setLineDash([4, 4]);
      ambigCtx.beginPath();
      ambigCtx.arc(C.x, C.y, rPx, 0.1 * Math.PI, 0.9 * Math.PI);
      ambigCtx.stroke();
      ambigCtx.setLineDash([]);

      // Intersecciones con la base (y = origin.y)
      if (ambigA >= hCrit - 0.02) {
        const dx = Math.sqrt(Math.max(0, ambigA * ambigA - hCrit * hCrit));
        const x1 = C.x + dx * sc;
        const x2 = C.x - dx * sc;

        // Solución derecha siempre válida si x1 > origin.x
        ambigCtx.strokeStyle = '#10b981';
        ambigCtx.lineWidth = 2.4;
        ambigCtx.beginPath(); ambigCtx.moveTo(C.x, C.y); ambigCtx.lineTo(x1, origin.y); ambigCtx.stroke();
        ambigCtx.fillStyle = '#10b981';
        ambigCtx.beginPath(); ambigCtx.arc(x1, origin.y, 4.5, 0, Math.PI * 2); ambigCtx.fill();

        // Solución izquierda válida si x2 > origin.x (es decir a < b)
        if (ambigA < ambigB - 0.05 && dx > 0.08) {
          ambigCtx.strokeStyle = '#f43f5e';
          ambigCtx.lineWidth = 2.4;
          ambigCtx.beginPath(); ambigCtx.moveTo(C.x, C.y); ambigCtx.lineTo(x2, origin.y); ambigCtx.stroke();
          ambigCtx.fillStyle = '#f43f5e';
          ambigCtx.beginPath(); ambigCtx.arc(x2, origin.y, 4.5, 0, Math.PI * 2); ambigCtx.fill();
        }
      }

      ambigCtx.fillStyle = '#fbbf24';
      ambigCtx.beginPath(); ambigCtx.arc(C.x, C.y, 4.5, 0, Math.PI * 2); ambigCtx.fill();

      ambigCtx.font = 'bold 12px monospace';
      ambigCtx.fillStyle = isLight ? '#0f172a' : '#f8fafc';
      ambigCtx.fillText('A (32°)', origin.x + 12, origin.y + 18);
      ambigCtx.fillStyle = '#38bdf8';
      ambigCtx.fillText('b=6', (origin.x + C.x) / 2 - 18, (origin.y + C.y) / 2 - 6);

      if (ambigStatus) {
        if (ambigA < hCrit - 0.03) {
          ambigStatus.className = 'ambig-status is-zero';
          ambigStatus.textContent = 'a < h  ⇒  0 TRIÁNGULOS POSIBLES (El lado a no alcanza la base)';
        } else if (Math.abs(ambigA - hCrit) <= 0.06) {
          ambigStatus.className = 'ambig-status is-one';
          ambigStatus.textContent = 'a = h  ⇒  1 ÚNICO TRIÁNGULO RECTÁNGULO (β = 90°)';
        } else if (ambigA < ambigB) {
          ambigStatus.className = 'ambig-status is-two';
          ambigStatus.textContent = 'h < a < b  ⇒  ¡2 TRIÁNGULOS POSIBLES! (Caso Ambiguo LLA)';
        } else {
          ambigStatus.className = 'ambig-status is-one';
          ambigStatus.textContent = 'a ≥ b  ⇒  1 ÚNICO TRIÁNGULO VÁLIDO';
        }
      }

      ambigCtx.restore();
    }

    slAmbigA?.addEventListener('input', (e) => {
      ambigA = parseFloat((e.target as HTMLInputElement).value);
      if (ambigAVal) ambigAVal.textContent = ambigA.toFixed(1);
      drawAmbiguous();
    });

    window.addEventListener('resize', () => {
      drawTrigLab();
      drawAmbiguous();
    });
    new MutationObserver(() => {
      drawTrigLab();
      drawAmbiguous();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    drawTrigLab();
    drawAmbiguous();

    // =========================================================================
    // 3. QUIZ
    // =========================================================================
    const fbMap: Record<string, { ok: string; ko: string }> = {
      tc1: {
        ok: 'Correcto: c² = 5² + 8² − 2·5·8·cos(60°) = 25 + 64 − 40 = 49  ⇒  c = 7 km.',
        ko: 'Aplica c² = 5² + 8² − 2·5·8·cos(60°). Como cos(60°) = 0,5, queda 25 + 64 − 40 = 49  ⇒  7 km.',
      },
      tc2: {
        ok: 'Correcto: 2R = a / sen(α) = 10 / sen(30°) = 10 / 0,5 = 20 cm  ⇒  R = 10 cm.',
        ko: 'Recuerda que a / sen(α) = 2R (el diámetro, no el radio). Como 2R = 10 / 0,5 = 20 cm, el radio es R = 10 cm.',
      },
    };

    document.querySelectorAll<HTMLElement>('.quiz-options').forEach((group) => {
      const qId = group.getAttribute('data-quiz') || '';
      const fbEl = document.getElementById(`fb-${qId}`);
      const buttons = group.querySelectorAll<HTMLButtonElement>('.quiz-opt');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((b) => b.classList.remove('is-right', 'is-wrong'));
          const isOk = btn.getAttribute('data-correct') === 'true';
          btn.classList.add(isOk ? 'is-right' : 'is-wrong');
          if (fbEl && fbMap[qId]) {
            fbEl.hidden = false;
            fbEl.textContent = isOk ? fbMap[qId].ok : fbMap[qId].ko;
            fbEl.style.color = isOk ? '#10b981' : '#f43f5e';
          }
        });
      });
    });
  })();
</script>
