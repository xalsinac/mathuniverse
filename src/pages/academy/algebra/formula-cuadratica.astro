---
import AcademyLessonLayout from '../../../layouts/AcademyLessonLayout.astro';
import { ACADEMY_LESSONS } from '../../../data/academy';

const lessonData = ACADEMY_LESSONS.find((l) => l.id === 'alg-02')!;
const prevLessonData = ACADEMY_LESSONS.find((l) => l.id === 'alg-01');
const nextLessonData = ACADEMY_LESSONS.find((l) => l.id === 'alg-03');
---

<AcademyLessonLayout lesson={lessonData} prevLesson={prevLessonData} nextLesson={nextLessonData}>
  <!-- SECCIÓN 1: EL DILEMA DEL DESPEJE -->
  <section class="lesson-section" id="el-dilema">
    <div class="section-marker">
      <span class="marker-num">01</span>
      <span class="marker-line"></span>
    </div>

    <h2>1. El Gran Dilema: ¿Por qué no podemos despejar la x directamente?</h2>

    <p class="lead-paragraph">
      En una ecuación de primer grado como <code class="inline-code">ax + b = 0</code>, despejar la incógnita es un proceso puramente lineal: restamos <code class="inline-code">b</code> y dividimos por <code class="inline-code">a</code>. Sin embargo, en cuanto aparece el término cuadrático en <code class="inline-code">ax² + bx + c = 0</code>, cualquier intento ingenuo de aislar la variable fracasa.
    </p>

    <!-- Caja de advertencia de error común -->
    <div class="algebra-trap-card">
      <div class="trap-header">
        <svg class="trap-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span class="trap-title">EL CALLEJÓN SIN SALIDA DEL DESPEJE DIRECTO</span>
      </div>
      <p>
        Si intentamos factorizar la <code class="inline-code">x</code> de los dos primeros términos:
      </p>
      <div class="bad-derivation-row">
        <code>ax² + bx = -c ⟹ x · (ax + b) = -c ⟹ x = -c / (ax + b)</code>
      </div>
      <p class="trap-explanation">
        La incógnita <code class="inline-code">x</code> no ha sido despejada: sigue atrapada en el denominador del lado derecho. Hemos transformado una ecuación polinómica en una ecuación racional sin avanzar un solo milímetro hacia la solución.
      </p>
    </div>

    <div class="insight-callout">
      <span class="insight-badge">EL SALTO CONCEPTUAL</span>
      <p>
        La genialidad del método consiste en una sola idea: <strong>reunir todos los términos que contienen x dentro de un único binomio al cuadrado</strong>. Si logramos escribir la ecuación como <code class="inline-code">(x + k)² = M</code>, la incógnita pasa de aparecer dos veces (al cuadrado y lineal) a aparecer exactamente <em>una sola vez</em>. A partir de ahí, basta con extraer la raíz cuadrada para liberarla.
      </p>
    </div>
  </section>

  <!-- SECCIÓN 2: LA GEOMETRÍA DE AL-JUARISMI -->
  <section class="lesson-section" id="geometria-historica">
    <div class="section-marker">
      <span class="marker-num">02</span>
      <span class="marker-line"></span>
    </div>

    <h2>2. La Geometría de Al-Juarismi: Completar el Cuadrado Físico</h2>

    <p>
      Hace más de 1200 años en la Casa de la Sabiduría de Bagdad, el matemático persa <strong>Muhammad ibn Musa al-Juarismi</strong> demostró este resultado sin utilizar notación algebraica moderna. Para él, las ecuaciones representaban áreas físicas de terreno.
    </p>

    <div class="derivation-step-card">
      <div class="step-num-pill">
        <span>PASO A</span>
        <span class="step-tag">EL CUADRADO INCOMPLETO</span>
      </div>
      <p>
        Consideremos una ecuación normalizada de la forma <code class="inline-code">x² + px = q</code> (por ejemplo, con <code class="inline-code">p = b/a</code>). Tenemos un cuadrado de lado <code class="inline-code">x</code> (área <code class="inline-code">x²</code>) al que debemos sumar un área rectangular <code class="inline-code">px</code>.
      </p>
    </div>

    <div class="derivation-step-card">
      <div class="step-num-pill">
        <span>PASO B</span>
        <span class="step-tag">SIMETRÍA Y PARTICIÓN EN DOS FRANJAS</span>
      </div>
      <p>
        Para preservar la forma cuadrada en lugar de estirar la figura en un rectángulo deforme, Al-Juarismi dividió el término lineal en <strong>dos franjas simétricas de anchura p/2</strong>:
      </p>
      <div class="formula-focus-box">
        <code>px = (p / 2) · x + (p / 2) · x</code>
      </div>
      <p>
        Colocamos una franja adosada a la derecha del cuadrado <code class="inline-code">x²</code> y la otra franja adosada debajo. La figura resultante es una «L» o un cuadrado casi completo, al que le falta exactamente una pequeña esquina inferior derecha.
      </p>
    </div>

    <div class="derivation-step-card">
      <div class="step-num-pill">
        <span>PASO C</span>
        <span class="step-tag">COMPLETAR LA ESQUINA FALTANTE</span>
      </div>
      <p>
        ¿Qué dimensiones tiene la esquina que falta para cerrar el cuadrado perfecto? Sus lados miden exactamente la anchura de las franjas: <code class="inline-code">p/2</code> por <code class="inline-code">p/2</code>.
      </p>
      <div class="formula-focus-box">
        <code>Área de la esquina = (p / 2) · (p / 2) = (p / 2)²</code>
      </div>
      <p>
        Si sumamos esa esquina a la figura física, <strong>debemos sumarla también al lado derecho de la ecuación</strong> para mantener la balanza en equilibrio. El cuadrado grande resultante tiene ahora lado <code class="inline-code">(x + p/2)</code> y área total:
      </p>
      <div class="formal-math-block">
        <code>(x + p/2)² = q + (p/2)²</code>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 3: LABORATORIO INTERACTIVO SVG -->
  <section class="lesson-section" id="laboratorio-interactivo">
    <div class="section-marker">
      <span class="marker-num">03</span>
      <span class="marker-line"></span>
    </div>

    <h2>3. Laboratorio Visual: Explorador Geométrico de Completación</h2>

    <p>
      Modifica los coeficientes de la ecuación cuadrática para ver en directo cómo se ensamblan las piezas geométricas, cómo se calcula la esquina complementaria y cómo responde el discriminante.
    </p>

    <!-- Contenedor del Laboratorio Dinámico -->
    <div class="geo-lab-shell">
      <div class="lab-glass-panel">
        <div class="lab-header-bar">
          <span class="lab-tag">LABORATORIO VECTORIAL</span>
          <div class="mode-toggles">
            <button type="button" class="tab-btn is-active" data-lab-mode="geometria">Geometría de Al-Juarismi</button>
            <button type="button" class="tab-btn" data-lab-mode="parabola">Parábola y Vértice</button>
          </div>
        </div>

        <!-- Sliders de Coeficientes a, b, c -->
        <div class="controls-row">
          <div class="slider-group">
            <div class="slider-header">
              <label for="coef-a">Coeficiente a (cuadrático):</label>
              <span id="disp-a" class="slider-badge">a = 1</span>
            </div>
            <input type="range" id="coef-a" min="1" max="4" step="1" value="1" class="slider-accent" />
          </div>

          <div class="slider-group">
            <div class="slider-header">
              <label for="coef-b">Coeficiente b (lineal):</label>
              <span id="disp-b" class="slider-badge">b = 6</span>
            </div>
            <input type="range" id="coef-b" min="2" max="12" step="2" value="6" class="slider-accent" />
          </div>

          <div class="slider-group">
            <div class="slider-header">
              <label for="coef-c">Término independiente c:</label>
              <span id="disp-c" class="slider-badge">c = 5</span>
            </div>
            <input type="range" id="coef-c" min="-16" max="12" step="1" value="5" class="slider-accent" />
          </div>
        </div>

        <!-- Lienzo Interactivo SVG con render inicial para SSR estático -->
        <div class="geo-interactive-stage">
          <div class="svg-stage-container">
            <svg id="quad-svg" viewBox="0 0 440 440" class="geometric-canvas" aria-label="Visualización de la completación del cuadrado">
              <!-- Renderizado Estático Inicial: a=1, b=6, c=5 ⟹ x² + 6x = -5 -->
              <!-- Cotas exteriores -->
              <g stroke="#38bdf8" stroke-width="1.5" opacity="0.9">
                <line x1="50" y1="34" x2="270" y2="34" stroke-dasharray="3 3" />
                <line x1="50" y1="28" x2="50" y2="40" />
                <line x1="270" y1="28" x2="270" y2="40" />
                <text x="160" y="26" fill="#38bdf8" font-size="12" font-weight="700" text-anchor="middle" font-family="monospace">x</text>
              </g>
              <g stroke="#fbbf24" stroke-width="1.5" opacity="0.9">
                <line x1="270" y1="34" x2="380" y2="34" stroke-dasharray="3 3" />
                <line x1="270" y1="28" x2="270" y2="40" />
                <line x1="380" y1="28" x2="380" y2="40" />
                <text x="325" y="26" fill="#fbbf24" font-size="12" font-weight="700" text-anchor="middle" font-family="monospace">b/(2a) = 3</text>
              </g>
              <g stroke="#38bdf8" stroke-width="1.5" opacity="0.9">
                <line x1="34" y1="50" x2="34" y2="270" stroke-dasharray="3 3" />
                <line x1="28" y1="50" x2="40" y2="50" />
                <line x1="28" y1="270" x2="40" y2="270" />
                <text x="24" y="165" fill="#38bdf8" font-size="12" font-weight="700" text-anchor="end" font-family="monospace">x</text>
              </g>
              <g stroke="#fbbf24" stroke-width="1.5" opacity="0.9">
                <line x1="34" y1="270" x2="34" y2="380" stroke-dasharray="3 3" />
                <line x1="28" y1="270" x2="40" y2="270" />
                <line x1="28" y1="380" x2="40" y2="380" />
                <text x="24" y="330" fill="#fbbf24" font-size="12" font-weight="700" text-anchor="end" font-family="monospace">b/(2a) = 3</text>
              </g>

              <!-- 1. Cuadrado principal x² -->
              <rect x="50" y="50" width="220" height="220" rx="6" fill="rgba(56, 189, 248, 0.32)" stroke="#38bdf8" stroke-width="2" />
              <text x="160" y="165" fill="#ffffff" font-size="16" font-weight="700" text-anchor="middle" font-family="system-ui, sans-serif" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));">Cuadrado: x²</text>

              <!-- 2. Franja lateral derecha: (b/2a) · x -->
              <rect x="270" y="50" width="110" height="220" rx="6" fill="rgba(16, 185, 129, 0.32)" stroke="#10b981" stroke-width="2" />
              <text x="325" y="165" fill="#ffffff" font-size="13" font-weight="600" text-anchor="middle" font-family="system-ui, sans-serif" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));">Franja: 3x</text>

              <!-- 3. Franja inferior: x · (b/2a) -->
              <rect x="50" y="270" width="220" height="110" rx="6" fill="rgba(16, 185, 129, 0.32)" stroke="#10b981" stroke-width="2" />
              <text x="160" y="330" fill="#ffffff" font-size="13" font-weight="600" text-anchor="middle" font-family="system-ui, sans-serif" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));">Franja: 3x</text>

              <!-- 4. Esquina complementaria completada: (b/2a)² -->
              <rect x="270" y="270" width="110" height="110" rx="6" fill="rgba(251, 191, 36, 0.45)" stroke="#fbbf24" stroke-width="2.5" stroke-dasharray="4 2" />
              <text x="325" y="325" fill="#ffffff" font-size="14" font-weight="700" text-anchor="middle" font-family="system-ui, sans-serif" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));">+ 3² = 9</text>
              <text x="325" y="345" fill="#fbbf24" font-size="10" font-weight="600" text-anchor="middle" font-family="system-ui, sans-serif">¡Completado!</text>
            </svg>
          </div>

          <!-- Barra lateral analítica en tiempo real -->
          <div class="geo-metrics-sidebar">
            <div class="sidebar-header">
              <span class="sidebar-tag">ANATOMÍA DEL TRINOMIO</span>
              <h4 id="eq-title">1x² + 6x + 5 = 0</h4>
            </div>

            <div class="metrics-card-stack">
              <div class="metric-row">
                <span class="metric-label">Término completador (b/2a)²:</span>
                <span id="metric-k" class="metric-val" style="color: #fbbf24;">(6 / 2)² = 9</span>
              </div>

              <div class="metric-row">
                <span class="metric-label">Binomio cuadrado resultante:</span>
                <span id="metric-bin" class="metric-val" style="color: #38bdf8;">(x + 3)² = 4</span>
              </div>

              <div class="metric-row">
                <span class="metric-label">Discriminante Δ = b² - 4ac:</span>
                <span id="metric-disc" class="metric-val" style="color: #10b981;">36 - 20 = 16 (Δ &gt; 0)</span>
              </div>

              <div class="metric-row highlight-row">
                <span class="metric-label">Soluciones exactas reales:</span>
                <span id="metric-sols" class="metric-val-strong">x₁ = -1.00  |  x₂ = -5.00</span>
              </div>
            </div>

            <div class="total-identity-eval">
              <span class="eval-tag">PROCESO DE RESOLUCIÓN:</span>
              <div id="eval-trace" class="eval-trace-box">
                x = <span class="math-frac"><span class="num">-6 ± <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">16</span></span></span><span class="den">2</span></span> = <span class="math-frac"><span class="num">-6 ± 4</span><span class="den">2</span></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 4: LA DEDUCCIÓN FORMAL PASO A PASO -->
  <section class="lesson-section" id="deduccion-formal">
    <div class="section-marker">
      <span class="marker-num">04</span>
      <span class="marker-line"></span>
    </div>

    <h2>4. La Deducción Algebraica Rigurosa (Paso a Paso)</h2>

    <div class="formal-theorem-banner">
      <span class="theorem-badge">TEOREMA FUNDAMENTAL DE LA ECUACIÓN CUADRÁTICA</span>
      <h3>«Toda ecuación cuadrática con coeficientes en los números reales y coeficiente principal no nulo admite una fórmula explícita universal para sus raíces»</h3>
      <div class="theorem-symbolic">
        ∀ a, b, c ∈ ℝ, a ≠ 0 : &emsp; ax² + bx + c = 0 &emsp;⟺&emsp; x = <span class="math-frac"><span class="num">-b ± <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">b² - 4ac</span></span></span><span class="den">2a</span></span>
      </div>
    </div>

    <p>
      Desgranemos paso por paso la deducción axiomática aplicando las propiedades de los cuerpos de números reales (ℝ, +, ·):
    </p>

    <!-- Stepper de 6 Pasos Formales -->
    <div class="algebraic-stepper">
      <!-- Paso 1 -->
      <div class="stepper-card">
        <div class="stepper-step-badge">01</div>
        <div class="stepper-content">
          <h4>Hipótesis inicial y transposición de la constante</h4>
          <span class="step-rule-tag">Axioma de existencia de elemento opuesto aditivo</span>
          <p>
            Partimos de la forma general con la condición indispensable <code class="inline-code">a ≠ 0</code>. Sumamos el opuesto <code class="inline-code">-c</code> en ambos lados de la igualdad:
          </p>
          <div class="code-step-box">
            <code>ax² + bx = -c</code>
          </div>
        </div>
      </div>

      <!-- Paso 2 -->
      <div class="stepper-card">
        <div class="stepper-step-badge">02</div>
        <div class="stepper-content">
          <h4>Normalización del coeficiente cuadrático</h4>
          <span class="step-rule-tag">Elemento inverso multiplicativo (división por a ≠ 0)</span>
          <p>
            Como <code class="inline-code">a ≠ 0</code>, su inverso <code class="inline-code">1/a</code> existe. Multiplicamos toda la ecuación por <code class="inline-code">1/a</code> para conseguir que el monomio principal sea mónico (<code class="inline-code">1 · x²</code>):
          </p>
          <div class="code-step-box">
            <span>x² + <span class="math-frac"><span class="num">b</span><span class="den">a</span></span>x = -<span class="math-frac"><span class="num">c</span><span class="den">a</span></span></span>
          </div>
        </div>
      </div>

      <!-- Paso 3 -->
      <div class="stepper-card">
        <div class="stepper-step-badge">03</div>
        <div class="stepper-content">
          <h4>Identificación del doble producto notable</h4>
          <span class="step-rule-tag">Reconocimiento del binomio (x + k)² = x² + 2kx + k²</span>
          <p>
            Para que el término lineal <code class="inline-code">(b/a)x</code> coincida con el doble producto <code class="inline-code">2 · x · k</code>, forzamos la igualdad:
          </p>
          <div class="code-step-box">
            <span>2 · k = <span class="math-frac"><span class="num">b</span><span class="den">a</span></span> &emsp;⟹&emsp; k = <span class="math-frac"><span class="num">b</span><span class="den">2a</span></span></span>
          </div>
          <p>
            Por consiguiente, el término cuadrático que le falta a la izquierda para ser un trinomio cuadrado perfecto es <code class="inline-code">k² = (b / 2a)² = <span class="math-frac"><span class="num">b²</span><span class="den">4a²</span></span></code>.
          </p>
        </div>
      </div>

      <!-- Paso 4 -->
      <div class="stepper-card">
        <div class="stepper-step-badge">04</div>
        <div class="stepper-content">
          <h4>Completar el cuadrado sumando k² a ambos miembros</h4>
          <span class="step-rule-tag">Axioma de adición de igualdades</span>
          <p>
            Sumamos <code class="inline-code"><span class="math-frac"><span class="num">b²</span><span class="den">4a²</span></span></code> a izquierda y derecha para no alterar la ecuación:
          </p>
          <div class="code-step-box">
            <span>x² + <span class="math-frac"><span class="num">b</span><span class="den">a</span></span>x + <span class="math-frac"><span class="num">b²</span><span class="den">4a²</span></span> = -<span class="math-frac"><span class="num">c</span><span class="den">a</span></span> + <span class="math-frac"><span class="num">b²</span><span class="den">4a²</span></span></span>
          </div>
        </div>
      </div>

      <!-- Paso 5 -->
      <div class="stepper-card">
        <div class="stepper-step-badge">05</div>
        <div class="stepper-content">
          <h4>Factorización del binomio y denominador común</h4>
          <span class="step-rule-tag">Primera Identidad Notable e igualación fraccionaria</span>
          <p>
            El miembro izquierdo se colapsa de forma exacta en el cuadrado del binomio <code class="inline-code">(x + <span class="math-frac"><span class="num">b</span><span class="den">2a</span></span>)²</code>. A la derecha, reducimos a común denominador multiplicando numerador y denominador de <code class="inline-code">-c/a</code> por <code class="inline-code">4a</code>:
          </p>
          <div class="code-step-box">
            <span>(x + <span class="math-frac"><span class="num">b</span><span class="den">2a</span></span>)² = <span class="math-frac"><span class="num">-4ac + b²</span><span class="den">4a²</span></span> = <span class="math-frac"><span class="num">b² - 4ac</span><span class="den">4a²</span></span></span>
          </div>
          <p class="callout-note-inline">
            ¡Aquí nace de manera natural y espontánea la expresión milagrosa <code class="inline-code">b² - 4ac</code>! No es una ocurrencia arbitraria: es el numerador inevitable tras igualar denominadores.
          </p>
        </div>
      </div>

      <!-- Paso 6 -->
      <div class="stepper-card">
        <div class="stepper-step-badge">06</div>
        <div class="stepper-content">
          <h4>Extracción de la raíz cuadrada y justificación estricta del doble signo (±)</h4>
          <span class="step-rule-tag">Propiedad de valor absoluto y radicación en cocientes</span>
          <p>
            Tomamos raíz cuadrada en ambos miembros recordando la identidad fundamental <code class="inline-code"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">u²</span></span> = |u|</code>:
          </p>

          <div class="math-derivation-chain">
            <div class="math-step-line">
              <span class="math-step-tag">Paso 6.1 · Radicación</span>
              <span>
                |x + <span class="math-frac"><span class="num">b</span><span class="den">2a</span></span>| 
                = <span class="math-frac"><span class="num"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">b² - 4ac</span></span></span><span class="den"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">4a²</span></span></span></span>
                = <span class="math-frac"><span class="num"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">b² - 4ac</span></span></span><span class="den">2|a|</span></span>
              </span>
            </div>

            <div class="math-step-line">
              <span class="math-step-tag">Paso 6.2 · Absorción del signo</span>
              <span>
                x + <span class="math-frac"><span class="num">b</span><span class="den">2a</span></span>
                = ± <span class="math-frac"><span class="num"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">b² - 4ac</span></span></span><span class="den">2a</span></span>
              </span>
            </div>

            <div class="math-step-line is-highlight">
              <span class="math-step-tag">Fórmula Cuadrática Universal</span>
              <span>
                x = <span class="math-frac"><span class="num">-b ± <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">b² - 4ac</span></span></span><span class="den">2a</span></span>
              </span>
              <span class="math-qed">∎ Q.E.D.</span>
            </div>
          </div>

          <p class="callout-note-inline">
            El signo dual <code class="inline-code">± / |a|</code> genera exactamente el mismo conjunto binario de valores <code class="inline-code">&#123;+1/a, -1/a&#125;</code> que <code class="inline-code">± / a</code>, por lo que el valor absoluto en el denominador queda rigurosamente absorbido sin pérdida de generalidad.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 5: ANATOMÍA DEL DISCRIMINANTE -->
  <section class="lesson-section" id="discriminante">
    <div class="section-marker">
      <span class="marker-num">05</span>
      <span class="marker-line"></span>
    </div>

    <h2>5. Anatomía del Discriminante: ¿Qué nos dice Δ = b² - 4ac?</h2>

    <p>
      El término subradical <code class="inline-code">Δ = b² - 4ac</code> se llama <strong>discriminante</strong> porque literalmente <em>discrimina</em> o clasifica el número y la naturaleza de las soluciones de la ecuación sin necesidad de calcularlas:
    </p>

    <div class="disc-cases-grid">
      <!-- Caso 1 -->
      <div class="disc-case-card is-positive">
        <div class="disc-case-header">
          <span class="disc-indicator">Δ &gt; 0</span>
          <span class="disc-badge">DOS RAÍCES REALES DISTINTAS</span>
        </div>
        <p>
          La raíz cuadrada <code class="inline-code"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">Δ</span></span></code> es un número real estrictamente positivo. Sumar y restar <code class="inline-code"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">Δ</span></span></code> genera dos valores distintos:
        </p>
        <div class="disc-formula math-display-eq">
          x₁ = <span class="math-frac"><span class="num">-b + <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">Δ</span></span></span><span class="den">2a</span></span> &emsp;≠&emsp; x₂ = <span class="math-frac"><span class="num">-b - <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">Δ</span></span></span><span class="den">2a</span></span>
        </div>
        <p class="disc-geom-note">
          <strong>Interpretación gráfica:</strong> La parábola <code class="inline-code">y = ax² + bx + c</code> corta al eje X en dos puntos reales independientes.
        </p>
      </div>

      <!-- Caso 2 -->
      <div class="disc-case-card is-zero">
        <div class="disc-case-header">
          <span class="disc-indicator">Δ = 0</span>
          <span class="disc-badge">UNA RAÍZ REAL DOBLE</span>
        </div>
        <p>
          La raíz cuadrada es nula: <code class="inline-code"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">0</span></span> = 0</code>. Sumar o restar cero no altera la fracción:
        </p>
        <div class="disc-formula math-display-eq">
          x₁ = x₂ = -<span class="math-frac"><span class="num">b</span><span class="den">2a</span></span>
        </div>
        <p class="disc-geom-note">
          <strong>Interpretación gráfica:</strong> La parábola es tangente al eje X; su vértice toca exactamente el eje en un único punto.
        </p>
      </div>

      <!-- Caso 3 -->
      <div class="disc-case-card is-negative">
        <div class="disc-case-header">
          <span class="disc-indicator">Δ &lt; 0</span>
          <span class="disc-badge">SIN SOLUCIÓN REAL (2 COMPLEJAS CONJUGADAS)</span>
        </div>
        <p>
          En el cuerpo de los números reales <code class="inline-code">ℝ</code>, no existe la raíz de un número negativo. Las soluciones viven en el cuerpo complejo <code class="inline-code">ℂ</code>:
        </p>
        <div class="disc-formula math-display-eq">
          x = <span class="math-frac"><span class="num">-b ± i<span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">|Δ|</span></span></span><span class="den">2a</span></span> &emsp;∈&emsp; ℂ
        </div>
        <p class="disc-geom-note">
          <strong>Interpretación gráfica:</strong> La parábola flota por encima o por debajo del eje X sin llegar a tocarlo jamás.
        </p>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 6: RELACIONES DE CARDANO-VIETA -->
  <section class="lesson-section" id="cardano-vieta">
    <div class="section-marker">
      <span class="marker-num">06</span>
      <span class="marker-line"></span>
    </div>

    <h2>6. Las Fórmulas de Cardano-Vieta y Factorización Inmediata</h2>

    <p>
      Las raíces <code class="inline-code">x₁</code> y <code class="inline-code">x₂</code> guardan una relación simétrica directa con los coeficientes <code class="inline-code">a, b, c</code>. Esta propiedad permite calcular soluciones mentalmente y comprobar cualquier resultado en 3 segundos:
    </p>

    <div class="vieta-duo-container">
      <div class="vieta-box">
        <h4>1. Suma de Raíces</h4>
        <div class="vieta-derivation math-display-eq">
          x₁ + x₂ = <span class="math-frac"><span class="num">-b + <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">Δ</span></span></span><span class="den">2a</span></span> + <span class="math-frac"><span class="num">-b - <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">Δ</span></span></span><span class="den">2a</span></span> = <span class="math-frac"><span class="num">-2b</span><span class="den">2a</span></span> = -<span class="math-frac"><span class="num">b</span><span class="den">a</span></span>
        </div>
        <p>La suma de las soluciones es siempre igual al coeficiente lineal con signo cambiado dividido por el coeficiente cuadrático.</p>
      </div>

      <div class="vieta-box">
        <h4>2. Producto de Raíces</h4>
        <div class="vieta-derivation math-display-eq">
          x₁ · x₂ = <span class="math-frac"><span class="num">(-b + <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">Δ</span></span>)(-b - <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">Δ</span></span>)</span><span class="den">4a²</span></span> = <span class="math-frac"><span class="num">b² - Δ</span><span class="den">4a²</span></span> = <span class="math-frac"><span class="num">4ac</span><span class="den">4a²</span></span> = <span class="math-frac"><span class="num">c</span><span class="den">a</span></span>
        </div>
        <p>El producto de las soluciones es igual al término independiente dividido por el coeficiente cuadrático.</p>
      </div>
    </div>

    <div class="factorization-banner">
      <span class="factor-tag">TEOREMA DE FACTORIZACIÓN</span>
      <h3>ax² + bx + c = a · (x - x₁) · (x - x₂)</h3>
      <p>
        Nunca olvides el factor principal <code class="inline-code">a</code> al descomponer en factores: si <code class="inline-code">a ≠ 1</code> y omites ese coeficiente, el polinomio factorizado no coincidirá con el original.
      </p>
    </div>
  </section>

  <!-- SECCIÓN 7: RÚBRICA DE LOS 4 ERRORES FATALES EN EXÁMENES -->
  <section class="lesson-section" id="errores-fatales">
    <div class="section-marker">
      <span class="marker-num">07</span>
      <span class="marker-line"></span>
    </div>

    <h2>7. Rúbrica de los 4 Errores Fatales en Exámenes y PAU</h2>

    <p>
      Incluso estudiantes con buenas notas en Bachillerato pierden décimas cruciales por descuidos tipográficos o mecánicos al aplicar la fórmula. Evítalos sistemáticamente con esta guía de detección:
    </p>

    <div class="sins-grid">
      <!-- Error 1 -->
      <div class="sin-card">
        <div class="sin-header">
          <span class="sin-num">ERROR 01</span>
          <span class="sin-title">La Barra de Fracción Incompleta</span>
        </div>
        <p>Escribir el <code class="inline-code">2a</code> dividiendo únicamente a la raíz cuadrada y dejando el <code class="inline-code">-b</code> fuera:</p>
        <div class="sin-contrast-box">
          <div class="sin-bad">
            <span class="sin-cross">✗</span>
            <span>x = -b ± <span class="math-frac"><span class="num"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">b² - 4ac</span></span></span><span class="den">2a</span></span></span>
          </div>
          <div class="sin-good">
            <span class="sin-check">✓</span>
            <span>x = <span class="math-frac"><span class="num">-b ± <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">b² - 4ac</span></span></span><span class="den">2a</span></span></span>
          </div>
        </div>
      </div>

      <!-- Error 2 -->
      <div class="sin-card">
        <div class="sin-header">
          <span class="sin-num">ERROR 02</span>
          <span class="sin-title">El Signo de -b cuando b ya es Negativo</span>
        </div>
        <p>Si la ecuación es <code class="inline-code">x² - 6x + 5 = 0</code>, tenemos <code class="inline-code">b = -6</code>. El primer término es <code class="inline-code">-b = -(-6) = +6</code>:</p>
        <div class="sin-contrast-box">
          <div class="sin-bad">
            <span class="sin-cross">✗</span>
            <span>x = -6 ± <span class="math-frac"><span class="num"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">Δ</span></span></span><span class="den">2a</span></span></span>
          </div>
          <div class="sin-good">
            <span class="sin-check">✓</span>
            <span>x = +6 ± <span class="math-frac"><span class="num"><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">Δ</span></span></span><span class="den">2a</span></span></span>
          </div>
        </div>
      </div>

      <!-- Error 3 -->
      <div class="sin-card">
        <div class="sin-header">
          <span class="sin-num">ERROR 03</span>
          <span class="sin-title">Confundir (-b)² con -b² dentro de la Raíz</span>
        </div>
        <p>Al elevar un número negativo al cuadrado, el resultado es siempre estrictamente positivo: <code class="inline-code">(-3)² = +9</code>, jamás <code class="inline-code">-9</code>:</p>
        <div class="sin-contrast-box">
          <div class="sin-bad">
            <span class="sin-cross">✗</span>
            <span><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">-3² - 4ac</span></span> = <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">-9 - 4ac</span></span></span>
          </div>
          <div class="sin-good">
            <span class="sin-check">✓</span>
            <span><span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">(-3)² - 4ac</span></span> = <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">9 - 4ac</span></span></span>
          </div>
        </div>
      </div>

      <!-- Error 4 -->
      <div class="sin-card">
        <div class="sin-header">
          <span class="sin-num">ERROR 04</span>
          <span class="sin-title">Olvidar el Coeficiente 'a' en la Factorización</span>
        </div>
        <p>Para la ecuación <code class="inline-code">2x² - 5x + 2 = 0</code>, las raíces son <code class="inline-code">x = 2</code> y <code class="inline-code">x = 1/2</code>:</p>
        <div class="sin-contrast-box">
          <div class="sin-bad">
            <span class="sin-cross">✗</span>
            <span>P(x) = (x - 2)(x - <span class="math-frac"><span class="num">1</span><span class="den">2</span></span>) &emsp;[Falta factor principal a=2]</span>
          </div>
          <div class="sin-good">
            <span class="sin-check">✓</span>
            <span>P(x) = 2(x - 2)(x - <span class="math-frac"><span class="num">1</span><span class="den">2</span></span>) = (x - 2)(2x - 1)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 8: AUTOEVALUACIÓN INTERACTIVA -->
  <section class="lesson-section" id="autoevaluacion">
    <div class="section-marker">
      <span class="marker-num">08</span>
      <span class="marker-line"></span>
    </div>

    <h2>8. Autoevaluación Conceptual: Pon a Prueba tu Dominio</h2>

    <p>
      Responde a estas tres preguntas deductivas para comprobar si has asimilado la lógica que sustenta la fórmula cuadrática:
    </p>

    <div class="quiz-container">
      <!-- Pregunta 1 -->
      <div class="quiz-card" data-quiz-item="1">
        <div class="quiz-question-header">
          <span class="quiz-num">1</span>
          <p class="quiz-question-text">
            ¿Por qué sumamos exactamente <code class="inline-code">b² / (4a²)</code> a ambos lados tras dividir por <code class="inline-code">a</code>?
          </p>
        </div>
        <div class="quiz-options">
          <button type="button" class="quiz-opt" data-opt="A">
            A) Porque es el cuadrado del coeficiente independiente <code class="inline-code">c</code>.
          </button>
          <button type="button" class="quiz-opt" data-opt="B" data-correct="true">
            B) Porque <code class="inline-code">(b / a)x</code> es el doble producto <code class="inline-code">2 · x · k</code>, de modo que <code class="inline-code">k = b / (2a)</code> y su cuadrado cierra el trinomio perfecto.
          </button>
          <button type="button" class="quiz-opt" data-opt="C">
            C) Porque así se anula el término lineal con la raíz cuadrada.
          </button>
        </div>
        <div class="quiz-feedback" aria-live="polite"></div>
      </div>

      <!-- Pregunta 2 -->
      <div class="quiz-card" data-quiz-item="2">
        <div class="quiz-question-header">
          <span class="quiz-num">2</span>
          <p class="quiz-question-text">
            Si una ecuación cuadrática tiene <code class="inline-code">b² - 4ac = 0</code>, ¿cuál es la interpretación geométrica de su solución?
          </p>
        </div>
        <div class="quiz-options">
          <button type="button" class="quiz-opt" data-opt="A">
            A) La parábola nunca llega a tocar el eje horizontal X.
          </button>
          <button type="button" class="quiz-opt" data-opt="B">
            B) La ecuación tiene dos soluciones simétricas respecto al origen de coordenadas.
          </button>
          <button type="button" class="quiz-opt" data-opt="C" data-correct="true">
            C) El vértice de la parábola está exactamente sobre el eje X, siendo tangente en el punto <code class="inline-code">x = -b / (2a)</code>.
          </button>
        </div>
        <div class="quiz-feedback" aria-live="polite"></div>
      </div>

      <!-- Pregunta 3 -->
      <div class="quiz-card" data-quiz-item="3">
        <div class="quiz-question-header">
          <span class="quiz-num">3</span>
          <p class="quiz-question-text">
            Dada la ecuación <code class="inline-code">x² - 7x + 12 = 0</code>, usando las relaciones de Cardano-Vieta sin usar la fórmula larga, ¿cuáles son sus raíces?
          </p>
        </div>
        <div class="quiz-options">
          <button type="button" class="quiz-opt" data-opt="A" data-correct="true">
            A) <code class="inline-code">x₁ = 3</code> y <code class="inline-code">x₂ = 4</code>, porque su suma es <code class="inline-code">3 + 4 = 7</code> y su producto es <code class="inline-code">3 · 4 = 12</code>.
          </button>
          <button type="button" class="quiz-opt" data-opt="B">
            B) <code class="inline-code">x₁ = -3</code> y <code class="inline-code">x₂ = -4</code>, porque los signos deben coincidir con la ecuación.
          </button>
          <button type="button" class="quiz-opt" data-opt="C">
            C) <code class="inline-code">x₁ = 2</code> y <code class="inline-code">x₂ = 6</code>, porque <code class="inline-code">2 · 6 = 12</code>.
          </button>
        </div>
        <div class="quiz-feedback" aria-live="polite"></div>
      </div>
    </div>
  </section>
</AcademyLessonLayout>

<script>
  (() => {
    // =========================================================================
    // 1. LABORATORIO VECTORIAL INTERACTIVO DE COMPLETAR EL CUADRADO
    // =========================================================================
    const svgEl = document.getElementById('quad-svg') as SVGSVGElement | null;
    const sliderA = document.getElementById('coef-a') as HTMLInputElement | null;
    const sliderB = document.getElementById('coef-b') as HTMLInputElement | null;
    const sliderC = document.getElementById('coef-c') as HTMLInputElement | null;

    const dispA = document.getElementById('disp-a');
    const dispB = document.getElementById('disp-b');
    const dispC = document.getElementById('disp-c');

    const eqTitle = document.getElementById('eq-title');
    const metricK = document.getElementById('metric-k');
    const metricBin = document.getElementById('metric-bin');
    const metricDisc = document.getElementById('metric-disc');
    const metricSols = document.getElementById('metric-sols');
    const evalTrace = document.getElementById('eval-trace');

    const modeButtons = document.querySelectorAll<HTMLButtonElement>('.mode-toggles .tab-btn');
    let currentMode: 'geometria' | 'parabola' = 'geometria';

    const updateLab = () => {
      if (!sliderA || !sliderB || !sliderC || !svgEl) return;

      const a = parseInt(sliderA.value, 10);
      const b = parseInt(sliderB.value, 10);
      const c = parseInt(sliderC.value, 10);

      if (dispA) dispA.textContent = `a = ${a}`;
      if (dispB) dispB.textContent = `b = ${b}`;
      if (dispC) dispC.textContent = `c = ${c >= 0 ? '+' + c : c}`;

      // Formato título ecuación
      const signB = b >= 0 ? `+ ${b}` : `- ${Math.abs(b)}`;
      const signC = c >= 0 ? `+ ${c}` : `- ${Math.abs(c)}`;
      if (eqTitle) eqTitle.textContent = `${a === 1 ? '' : a}x² ${signB}x ${signC} = 0`;

      // Cálculos analíticos
      const disc = b * b - 4 * a * c;
      const kVal = b / (2 * a);
      const kValSq = (b * b) / (4 * a * a);
      const binRhs = disc / (4 * a * a);

      if (metricK) metricK.textContent = `(${b} / ${2 * a})² = ${kValSq.toFixed(2)}`;
      if (metricBin) {
        const signK = kVal >= 0 ? `+ ${kVal.toFixed(2)}` : `- ${Math.abs(kVal).toFixed(2)}`;
        metricBin.textContent = `(x ${signK})² = ${binRhs.toFixed(2)}`;
      }

      if (metricDisc) {
        if (disc > 0) {
          metricDisc.textContent = `${b * b} - ${4 * a * c} = ${disc} (Δ > 0)`;
          metricDisc.style.color = '#10b981';
        } else if (disc === 0) {
          metricDisc.textContent = `${b * b} - ${4 * a * c} = 0 (Δ = 0, doble)`;
          metricDisc.style.color = '#fbbf24';
        } else {
          metricDisc.textContent = `${b * b} - ${4 * a * c} = ${disc} (Δ < 0, compleja)`;
          metricDisc.style.color = '#ef4444';
        }
      }

      if (metricSols) {
        if (disc > 0) {
          const root1 = (-b + Math.sqrt(disc)) / (2 * a);
          const root2 = (-b - Math.sqrt(disc)) / (2 * a);
          metricSols.textContent = `x₁ = ${root1.toFixed(2)}  |  x₂ = ${root2.toFixed(2)}`;
          metricSols.style.color = '#38bdf8';
        } else if (disc === 0) {
          const root = -b / (2 * a);
          metricSols.textContent = `x = ${root.toFixed(2)} (raíz doble)`;
          metricSols.style.color = '#fbbf24';
        } else {
          const realPart = (-b / (2 * a)).toFixed(2);
          const imagPart = (Math.sqrt(Math.abs(disc)) / (2 * a)).toFixed(2);
          metricSols.textContent = `x = ${realPart} ± ${imagPart}i (en ℂ)`;
          metricSols.style.color = '#f87171';
        }
      }

      if (evalTrace) {
        if (disc >= 0) {
          const sq = Math.sqrt(disc);
          const isExact = Number.isInteger(sq);
          const exactStep = isExact ? ` = <span class="math-frac"><span class="num">${-b} ± ${sq}</span><span class="den">${2 * a}</span></span>` : '';
          evalTrace.innerHTML = `x = <span class="math-frac"><span class="num">${-b} ± <span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">${disc}</span></span></span><span class="den">${2 * a}</span></span>${exactStep}`;
        } else {
          evalTrace.innerHTML = `x = <span class="math-frac"><span class="num">${-b} ± i<span class="math-sqrt"><span class="sqrt-rad">&radic;</span><span class="sqrt-body">${Math.abs(disc)}</span></span></span><span class="den">${2 * a}</span></span> &isin; &#x2102;`;
        }
      }

      // Renderizado SVG Dinámico
      svgEl.innerHTML = '';

      if (currentMode === 'geometria') {
        renderGeometryMode(svgEl, a, b, c, kVal);
      } else {
        renderParabolaMode(svgEl, a, b, c, disc);
      }
    };

    // Modo 1: Geometría de Al-Juarismi
    const renderGeometryMode = (svg: SVGSVGElement, a: number, b: number, c: number, k: number) => {
      const offset = 48;
      const maxSize = 340;

      // Escala para el cuadrado x y las dos franjas k
      const effectiveX = 5;
      const effectiveK = Math.max(1, Math.min(5, Math.abs(k)));
      const totalUnits = effectiveX + effectiveK;
      const scale = maxSize / totalUnits;

      const pxX = effectiveX * scale;
      const pxK = effectiveK * scale;

      // 1. Cotas exteriores
      createSvgDimension(offset, offset - 14, pxX, 'x', '#38bdf8');
      createSvgDimension(offset + pxX, offset - 14, pxK, `b/(2a) = ${k.toFixed(1)}`, '#fbbf24');
      createSvgDimension(offset - 14, offset, pxX, 'x', '#38bdf8', true);
      createSvgDimension(offset - 14, offset + pxX, pxK, `b/(2a) = ${k.toFixed(1)}`, '#fbbf24', true);

      // 2. Cuadrado principal x²
      createSvgRect(offset, offset, pxX, pxX, 'rgba(56, 189, 248, 0.35)', '#38bdf8', 'Cuadrado: x²');

      // 3. Franja lateral derecha
      createSvgRect(offset + pxX, offset, pxK, pxX, 'rgba(16, 185, 129, 0.35)', '#10b981', `Franja: ${k.toFixed(1)}x`);

      // 4. Franja inferior
      createSvgRect(offset, offset + pxX, pxX, pxK, 'rgba(16, 185, 129, 0.35)', '#10b981', `Franja: ${k.toFixed(1)}x`);

      // 5. Esquina complementaria completada
      createSvgRect(offset + pxX, offset + pxX, pxK, pxK, 'rgba(251, 191, 36, 0.45)', '#fbbf24', `+ ${(k * k).toFixed(1)}`);
    };

    // Modo 2: Parábola Cartesiana y Vértice
    const renderParabolaMode = (svg: SVGSVGElement, a: number, b: number, c: number, disc: number) => {
      const cx = 220;
      const cy = 220;
      const scaleX = 22;
      const scaleY = 10;

      // Ejes coordenados
      const gAxes = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      gAxes.setAttribute('stroke', 'rgba(255, 255, 255, 0.22)');
      gAxes.setAttribute('stroke-width', '1');

      // Eje X y Eje Y
      const lineX = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      lineX.setAttribute('x1', '20');
      lineX.setAttribute('y1', String(cy));
      lineX.setAttribute('x2', '420');
      lineX.setAttribute('y2', String(cy));
      gAxes.appendChild(lineX);

      const lineY = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      lineY.setAttribute('x1', String(cx));
      lineY.setAttribute('y1', '20');
      lineY.setAttribute('x2', String(cx));
      lineY.setAttribute('y2', '420');
      gAxes.appendChild(lineY);
      svg.appendChild(gAxes);

      // Trazo de la parábola: y = a x² + b x + c
      let dPath = '';
      for (let px = -9; px <= 9; px += 0.2) {
        const py = a * px * px + b * px + c;
        const screenX = cx + px * scaleX;
        const screenY = cy - py * scaleY;
        if (px === -9) {
          dPath += `M ${screenX.toFixed(1)} ${screenY.toFixed(1)}`;
        } else {
          dPath += ` L ${screenX.toFixed(1)} ${screenY.toFixed(1)}`;
        }
      }

      const pathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      pathEl.setAttribute('d', dPath);
      pathEl.setAttribute('fill', 'none');
      pathEl.setAttribute('stroke', '#38bdf8');
      pathEl.setAttribute('stroke-width', '2.5');
      svg.appendChild(pathEl);

      // Vértice: xV = -b / (2a)
      const xV = -b / (2 * a);
      const yV = a * xV * xV + b * xV + c;
      const screenXV = cx + xV * scaleX;
      const screenYV = cy - yV * scaleY;

      // Eje de simetría vertical punteado
      const simAxis = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      simAxis.setAttribute('x1', String(screenXV));
      simAxis.setAttribute('y1', '30');
      simAxis.setAttribute('x2', String(screenXV));
      simAxis.setAttribute('y2', '410');
      simAxis.setAttribute('stroke', 'rgba(251, 191, 36, 0.6)');
      simAxis.setAttribute('stroke-width', '1.5');
      simAxis.setAttribute('stroke-dasharray', '4 3');
      svg.appendChild(simAxis);

      // Punto del vértice
      const circleV = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      circleV.setAttribute('cx', String(screenXV));
      circleV.setAttribute('cy', String(screenYV));
      circleV.setAttribute('r', '5');
      circleV.setAttribute('fill', '#fbbf24');
      svg.appendChild(circleV);

      // Puntos de corte con el eje X (si Δ >= 0)
      if (disc >= 0) {
        const root1 = (-b + Math.sqrt(disc)) / (2 * a);
        const root2 = (-b - Math.sqrt(disc)) / (2 * a);

        [root1, root2].forEach((root) => {
          const rootScreenX = cx + root * scaleX;
          const circleR = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          circleR.setAttribute('cx', String(rootScreenX));
          circleR.setAttribute('cy', String(cy));
          circleR.setAttribute('r', '5');
          circleR.setAttribute('fill', '#10b981');
          svg.appendChild(circleR);
        });
      }
    };

    // Funciones auxiliares para SVG
    const createSvgRect = (x: number, y: number, w: number, h: number, fill: string, stroke: string, label: string) => {
      if (!svgEl) return;
      const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      rect.setAttribute('x', String(x));
      rect.setAttribute('y', String(y));
      rect.setAttribute('width', String(w));
      rect.setAttribute('height', String(h));
      rect.setAttribute('rx', '6');
      rect.setAttribute('fill', fill);
      rect.setAttribute('stroke', stroke);
      rect.setAttribute('stroke-width', '2');
      svgEl.appendChild(rect);

      if (w > 30 && h > 20) {
        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', String(x + w / 2));
        text.setAttribute('y', String(y + h / 2 + 5));
        text.setAttribute('fill', '#ffffff');
        text.setAttribute('font-size', '13');
        text.setAttribute('font-weight', '600');
        text.setAttribute('text-anchor', 'middle');
        text.setAttribute('font-family', 'system-ui, sans-serif');
        text.setAttribute('style', 'filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));');
        text.textContent = label;
        svgEl.appendChild(text);
      }
    };

    const createSvgDimension = (x: number, y: number, length: number, text: string, color: string, isVertical = false) => {
      if (!svgEl) return;
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('stroke', color);
      g.setAttribute('stroke-width', '1.5');
      g.setAttribute('opacity', '0.9');

      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      const tick1 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      const tick2 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('fill', color);
      t.setAttribute('font-size', '11');
      t.setAttribute('font-weight', '700');
      t.setAttribute('font-family', 'monospace');

      if (!isVertical) {
        line.setAttribute('x1', String(x));
        line.setAttribute('y1', String(y));
        line.setAttribute('x2', String(x + length));
        line.setAttribute('y2', String(y));
        line.setAttribute('stroke-dasharray', '3 3');

        tick1.setAttribute('x1', String(x));
        tick1.setAttribute('y1', String(y - 5));
        tick1.setAttribute('x2', String(x));
        tick1.setAttribute('y2', String(y + 5));

        tick2.setAttribute('x1', String(x + length));
        tick2.setAttribute('y1', String(y - 5));
        tick2.setAttribute('x2', String(x + length));
        tick2.setAttribute('y2', String(y + 5));

        t.setAttribute('x', String(x + length / 2));
        t.setAttribute('y', String(y - 7));
        t.setAttribute('text-anchor', 'middle');
      } else {
        line.setAttribute('x1', String(x));
        line.setAttribute('y1', String(y));
        line.setAttribute('x2', String(x));
        line.setAttribute('y2', String(y + length));
        line.setAttribute('stroke-dasharray', '3 3');

        tick1.setAttribute('x1', String(x - 5));
        tick1.setAttribute('y1', String(y));
        tick1.setAttribute('x2', String(x + 5));
        tick1.setAttribute('y2', String(y));

        tick2.setAttribute('x1', String(x - 5));
        tick2.setAttribute('y1', String(y + length));
        tick2.setAttribute('x2', String(x + 5));
        tick2.setAttribute('y2', String(y + length));

        t.setAttribute('x', String(x - 8));
        t.setAttribute('y', String(y + length / 2 + 4));
        t.setAttribute('text-anchor', 'end');
      }

      t.textContent = text;
      g.appendChild(line);
      g.appendChild(tick1);
      g.appendChild(tick2);
      g.appendChild(t);
      svgEl.appendChild(g);
    };

    sliderA?.addEventListener('input', updateLab);
    sliderB?.addEventListener('input', updateLab);
    sliderC?.addEventListener('input', updateLab);

    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        modeButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        currentMode = (btn.dataset.labMode as 'geometria' | 'parabola') || 'geometria';
        updateLab();
      });
    });

    // =========================================================================
    // 2. AUTOEVALUACIÓN INTERACTIVA
    // =========================================================================
    const quizCards = document.querySelectorAll<HTMLElement>('.quiz-card');

    quizCards.forEach((card) => {
      const options = card.querySelectorAll<HTMLButtonElement>('.quiz-opt');
      const feedback = card.querySelector<HTMLElement>('.quiz-feedback');

      options.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isCorrect = btn.dataset.correct === 'true';

          options.forEach((b) => {
            b.disabled = true;
            if (b.dataset.correct === 'true') {
              b.classList.add('is-correct');
            } else if (b === btn && !isCorrect) {
              b.classList.add('is-incorrect');
            }
          });

          if (feedback) {
            feedback.style.display = 'block';
            if (isCorrect) {
              feedback.className = 'quiz-feedback feedback-success';
              feedback.innerHTML = '<strong>Respuesta Correcta:</strong> Has identificado con exactitud el principio matemático subyacente.';
            } else {
              feedback.className = 'quiz-feedback feedback-error';
              feedback.innerHTML = '<strong>Incorrecto:</strong> Revisa la justificación formal del paso en la sección de deducción.';
            }
          }
        });
      });
    });
  })();
</script>

