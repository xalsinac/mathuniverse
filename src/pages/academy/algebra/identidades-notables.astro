---
import AcademyLessonLayout from '../../../layouts/AcademyLessonLayout.astro';
import { ACADEMY_LESSONS } from '../../../data/academy';

const lessonData = ACADEMY_LESSONS.find((l) => l.id === 'alg-01')!;
const prevLessonData = ACADEMY_LESSONS.find((l) => l.id === 'f-02');
const nextLessonData = ACADEMY_LESSONS.find((l) => l.id === 'alg-02');
---

<AcademyLessonLayout lesson={lessonData} prevLesson={prevLessonData} nextLesson={nextLessonData}>
  <!-- SECCIÓN 1: EL PECADO CAPITAL DEL ÁLGEBRA -->
  <section class="lesson-section" id="el-pecado-universal">
    <div class="section-marker">
      <span class="marker-num">01</span>
      <span class="marker-line"></span>
    </div>
    
    <h2>1. El Gran Error del Álgebra: ¿Por qué (a + b)² ≠ a² + b²?</h2>
    
    <p class="prose-lead">
      En las aulas de secundaria y bachillerato de todo el mundo ocurre un tropiezo casi universal: cuando un estudiante ve la expresión <code>(a + b)²</code>, la intuición no entrenada le susurra escribir de inmediato <code>a² + b²</code>.
      <strong>Esto es falso en cualquier cuerpo de números donde 1 + 1 ≠ 0.</strong>
    </p>

    <!-- Caja de advertencia analítica -->
    <div class="math-warning-box">
      <div class="warning-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </div>
      <div class="warning-body">
        <h4>La Falacia de la Linealidad: El Exponente no es Distributivo respecto a la Suma</h4>
        <p>
          La potencia al cuadrado significa <em>multiplicar la base por sí misma</em>, es decir, <code>(a + b) · (a + b)</code>. 
          No puedes "repartir" el exponente a cada sumando como si fuera una multiplicación. Comprobemos la catástrofe con un simple contraejemplo aritmético:
        </p>
      </div>
    </div>

    <!-- Comparativa Aritmética Demoledora -->
    <div class="academic-cards-grid">
      <div class="academic-concept-card is-correct-card">
        <div class="concept-head">
          <span class="concept-num">✓</span>
          <h4>Cálculo Real Riguroso (a = 3, b = 4)</h4>
        </div>
        <p class="concept-def">
          Primero resolvemos el paréntesis interior y elevamos al cuadrado:
        </p>
        <div class="step-equation">
          <code>(3 + 4)² = 7² = 49</code>
        </div>
      </div>

      <div class="academic-concept-card is-wrong-card">
        <div class="concept-head">
          <span class="concept-num is-danger">✕</span>
          <h4>La Falsa Fórmula Olvidadiza</h4>
        </div>
        <p class="concept-def">
          Si aplicamos el error de olvidar los términos cruzados:
        </p>
        <div class="step-equation is-conclusive">
          <code>3² + 4² = 9 + 16 = 25 &emsp;(¡Faltan 24 unidades!)</code>
        </div>
      </div>
    </div>

    <p class="callout-caption">
      ¿De dónde proceden exactamente esas <strong>24 unidades desaparecidas</strong>? 
      Proceden con precisión milimétrica del <em>doble producto cruzado</em>: <code>2 · a · b = 2 · 3 · 4 = 24</code>. Y <code>25 + 24 = 49</code>.
    </p>
  </section>

  <!-- SECCIÓN 2: PRIMERA IDENTIDAD (CUADRADO DE UNA SUMA) -->
  <section class="lesson-section" id="cuadrado-suma">
    <div class="section-marker">
      <span class="marker-num">02</span>
      <span class="marker-line"></span>
    </div>

    <h2>2. Primera Identidad: Cuadrado de una Suma</h2>

    <div class="formal-theorem-banner">
      <span class="theorem-badge">TEOREMA DEL CUADRADO DE UN BINOMIO</span>
      <h3>«El cuadrado de una suma es igual al cuadrado del primero, más el doble producto del primero por el segundo, más el cuadrado del segundo»</h3>
      <code class="theorem-symbolic">∀ a, b ∈ ℝ : (a + b)² = a² + 2ab + b²</code>
    </div>

    <!-- Stepper de Deducción Algebraica -->
    <div class="proof-stepper-container">
      <div class="proof-stepper-header">
        <h4>DEDUCCIÓN ALGEBRAICA FORMAL POR PROPIEDAD DISTRIBUTIVA</h4>
        <span class="stepper-hint">Paso a paso en el anillo de los polinomios</span>
      </div>

      <div class="proof-steps-list">
        <!-- Paso 1 -->
        <div class="proof-step-card is-active">
          <div class="step-num-col">01</div>
          <div class="step-content">
            <div class="step-head">
              <strong>Definición axiomática de potencia</strong>
              <span class="step-rule">x² = x · x</span>
            </div>
            <p>
              Por definición de exponente cuadrático, multiplicar un binomio por sí mismo equivale a escribirlo como producto de dos factores:
            </p>
            <div class="step-equation">
              <code>(a + b)² = (a + b) · (a + b)</code>
            </div>
          </div>
        </div>

        <!-- Paso 2 -->
        <div class="proof-step-card">
          <div class="step-num-col">02</div>
          <div class="step-content">
            <div class="step-head">
              <strong>Aplicación de la propiedad distributiva</strong>
              <span class="step-rule">Distributividad del producto respecto a la suma</span>
            </div>
            <p>
              Distribuimos cada término del primer paréntesis sobre todos los términos del segundo paréntesis:
            </p>
            <div class="step-equation">
              <code>a · (a + b) + b · (a + b) = (a · a) + (a · b) + (b · a) + (b · b)</code>
            </div>
          </div>
        </div>

        <!-- Paso 3 -->
        <div class="proof-step-card">
          <div class="step-num-col">03</div>
          <div class="step-content">
            <div class="step-head">
              <strong>Conmutatividad del producto y reducción de términos semejantes</strong>
              <span class="step-rule">Conmutatividad en (ℝ, ·): b · a = a · b</span>
            </div>
            <p>
              Puesto que el orden de los factores no altera el producto en los números reales, los dos monomios centrales son idénticos:
            </p>
            <div class="step-equation is-conclusive">
              <code>a² + ab + ab + b² = a² + 2ab + b²</code>
            </div>
            <div class="qed-badge">
              <span>∎ Q.E.D. · El término '2ab' emerge con absoluta necesidad deductiva</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 3: LABORATORIO GEOMÉTRICO INTERACTIVO -->
  <section class="lesson-section" id="laboratorio-geometrico">
    <div class="section-marker">
      <span class="marker-num">03</span>
      <span class="marker-line"></span>
    </div>

    <h2>3. Laboratorio Visual: La Geometría de los Elementos de Euclides</h2>

    <p class="prose-lead">
      En el Libro II de los <em>Elementos</em> (hacia 300 a.C.), Euclides no utilizaba letras ni álgebra simbólica moderna. 
      Para los griegos, <code>(a + b)²</code> era literalmente el <strong>área física de un cuadrado de lado (a + b)</strong>.
    </p>

    <!-- WIDGET INTERACTIVO DE GEOMETRÍA DINÁMICA -->
    <div class="geometry-lab-widget" id="geo-widget">
      <div class="widget-head">
        <div class="widget-title-group">
          <span class="widget-tag">GEOMETRÍA DINÁMICA VECTORIAL</span>
          <h3>Explorador Visual de Áreas y Términos Cruzados</h3>
        </div>
        <div class="identity-tabs">
          <button type="button" class="tab-btn is-active" data-identity="suma">1. Cuadrado de la Suma (a + b)²</button>
          <button type="button" class="tab-btn" data-identity="diferencia">2. Cuadrado de la Diferencia (a - b)²</button>
          <button type="button" class="tab-btn" data-identity="conjugado">3. Suma por Diferencia (a + b)(a - b)</button>
        </div>
      </div>

      <div class="widget-body">
        <!-- Controles deslizantes de dimensiones -->
        <div class="geo-sliders-panel">
          <div class="slider-control">
            <div class="slider-label-row">
              <label for="slider-a">Segmento principal <em>a</em>:</label>
              <span class="slider-val-pill" id="val-a-display">a = 4</span>
            </div>
            <input type="range" id="slider-a" min="2" max="6" value="4" step="1" class="math-slider" />
          </div>

          <div class="slider-control">
            <div class="slider-label-row">
              <label for="slider-b">Segmento secundario <em>b</em>:</label>
              <span class="slider-val-pill" id="val-b-display">b = 2</span>
            </div>
            <input type="range" id="slider-b" min="1" max="4" value="2" step="1" class="math-slider" />
          </div>
        </div>

        <!-- Lienzo SVG Interactivo con render inicial para carga instantánea -->
        <div class="geo-interactive-stage">
          <div class="svg-stage-container">
            <svg id="geo-svg" viewBox="0 0 420 420" class="geometric-canvas" aria-label="Descomposición geométrica de áreas">
              <!-- Cotas exteriores iniciales -->
              <g stroke="#38bdf8" stroke-width="1.5" opacity="0.9">
                <line x1="40" y1="28" x2="267" y2="28" stroke-dasharray="2 2" />
                <line x1="40" y1="23" x2="40" y2="33" />
                <line x1="267" y1="23" x2="267" y2="33" />
                <text x="153.5" y="21" fill="#38bdf8" font-size="11" font-weight="700" text-anchor="middle" font-family="monospace">a = 4</text>
              </g>
              <g stroke="#fbbf24" stroke-width="1.5" opacity="0.9">
                <line x1="267" y1="28" x2="380" y2="28" stroke-dasharray="2 2" />
                <line x1="267" y1="23" x2="267" y2="33" />
                <line x1="380" y1="23" x2="380" y2="33" />
                <text x="323.5" y="21" fill="#fbbf24" font-size="11" font-weight="700" text-anchor="middle" font-family="monospace">b = 2</text>
              </g>
              <g stroke="#38bdf8" stroke-width="1.5" opacity="0.9">
                <line x1="28" y1="40" x2="28" y2="267" stroke-dasharray="2 2" />
                <line x1="23" y1="40" x2="33" y2="40" />
                <line x1="23" y1="267" x2="33" y2="267" />
                <text x="22" y="157.5" fill="#38bdf8" font-size="11" font-weight="700" text-anchor="end" font-family="monospace">a = 4</text>
              </g>
              <g stroke="#fbbf24" stroke-width="1.5" opacity="0.9">
                <line x1="28" y1="267" x2="28" y2="380" stroke-dasharray="2 2" />
                <line x1="23" y1="267" x2="33" y2="267" />
                <line x1="23" y1="380" x2="33" y2="380" />
                <text x="22" y="327.5" fill="#fbbf24" font-size="11" font-weight="700" text-anchor="end" font-family="monospace">b = 2</text>
              </g>

              <!-- Regiones geométricas -->
              <!-- 1. Cuadrado a² -->
              <rect x="40" y="40" width="227" height="227" rx="6" fill="rgba(56, 189, 248, 0.35)" stroke="#38bdf8" stroke-width="2" class="svg-piece" />
              <text x="153.5" y="158.5" fill="#ffffff" font-size="15" font-weight="700" text-anchor="middle" font-family="system-ui, sans-serif" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));">a² = 16</text>

              <!-- 2. Rectángulo ab -->
              <rect x="267" y="40" width="113" height="227" rx="6" fill="rgba(16, 185, 129, 0.35)" stroke="#10b981" stroke-width="2" class="svg-piece" />
              <text x="323.5" y="158.5" fill="#ffffff" font-size="14" font-weight="600" text-anchor="middle" font-family="system-ui, sans-serif" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));">ab = 8</text>

              <!-- 3. Rectángulo ba -->
              <rect x="40" y="267" width="227" height="113" rx="6" fill="rgba(16, 185, 129, 0.35)" stroke="#10b981" stroke-width="2" class="svg-piece" />
              <text x="153.5" y="328.5" fill="#ffffff" font-size="14" font-weight="600" text-anchor="middle" font-family="system-ui, sans-serif" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));">ba = 8</text>

              <!-- 4. Cuadrado b² -->
              <rect x="267" y="267" width="113" height="113" rx="6" fill="rgba(251, 191, 36, 0.4)" stroke="#fbbf24" stroke-width="2" class="svg-piece" />
              <text x="323.5" y="328.5" fill="#ffffff" font-size="14" font-weight="700" text-anchor="middle" font-family="system-ui, sans-serif" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));">b² = 4</text>
            </svg>
          </div>

          <!-- Desglose analítico de las áreas en tiempo real -->
          <div class="geo-metrics-sidebar">
            <div class="sidebar-header">
              <span class="sidebar-tag">BALANCE EXACTO DE ÁREAS</span>
              <h4 id="metrics-title">Área Total del Cuadrado (a + b)²</h4>
            </div>

            <div class="areas-breakdown-list" id="areas-list">
              <div class="area-item" style="border-left: 3px solid #38bdf8;">
                <span class="area-name">Cuadrado principal (a × a)</span>
                <span class="area-val" style="color: #38bdf8;">16 u²</span>
              </div>
              <div class="area-item" style="border-left: 3px solid #10b981;">
                <span class="area-name">Rectángulo superior (a × b)</span>
                <span class="area-val" style="color: #10b981;">8 u²</span>
              </div>
              <div class="area-item" style="border-left: 3px solid #10b981;">
                <span class="area-name">Rectángulo lateral (b × a)</span>
                <span class="area-val" style="color: #10b981;">8 u²</span>
              </div>
              <div class="area-item" style="border-left: 3px solid #fbbf24;">
                <span class="area-name">Cuadrado complementario (b × b)</span>
                <span class="area-val" style="color: #fbbf24;">4 u²</span>
              </div>
            </div>

            <div class="total-identity-eval">
              <span class="eval-tag">IGUALDAD IDENTITARIA:</span>
              <code id="identity-formula-eval">(4 + 2)² = 16 + 8 + 8 + 4 = 36</code>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 4: SEGUNDA IDENTIDAD (CUADRADO DE UNA DIFERENCIA) -->
  <section class="lesson-section" id="cuadrado-diferencia">
    <div class="section-marker">
      <span class="marker-num">04</span>
      <span class="marker-line"></span>
    </div>

    <h2>4. Segunda Identidad: Cuadrado de una Diferencia</h2>

    <div class="formal-theorem-banner">
      <span class="theorem-badge">TEOREMA DE LA DIFERENCIA AL CUADRADO</span>
      <h3>«El cuadrado de una diferencia es igual al cuadrado del primero, menos el doble producto del primero por el segundo, más el cuadrado del segundo»</h3>
      <code class="theorem-symbolic">∀ a, b ∈ ℝ : (a - b)² = a² - 2ab + b²</code>
    </div>

    <p>
      ¿Por qué el último término <code>+b²</code> lleva signo <strong>positivo</strong> si partíamos de una resta?
      La respuesta reside en la ley fundamental de los signos del producto en el cuerpo de los números reales:
    </p>

    <div class="math-callout">
      <div class="callout-header">
        <span class="callout-badge">RIGOR DE SIGNOS</span>
        <h3>Deducción como Suma con Elemento Opuesto</h3>
      </div>
      <p>
        Podemos reescribir cualquier resta <em>a - b</em> como la suma de <em>a</em> con el opuesto de <em>b</em>: <code>a + (-b)</code>. 
        Aplicando la Primera Identidad demostrada en la sección anterior:
      </p>
      <div class="formula-spotlight">
        <code>(a - b)² = [a + (-b)]² = a² + 2 · a · (-b) + (-b)²</code>
      </div>
      <p class="callout-caption">
        Puesto que <code>2 · a · (-b) = -2ab</code> y el producto de dos números negativos es positivo <code>(-b) · (-b) = +b²</code>, obtenemos sin excepción:
        <strong>(a - b)² = a² - 2ab + b²</strong>.
      </p>
    </div>

    <div class="geometric-insight-box">
      <h4>La Explicación Geométrica del +b² (La Corrección de la Sobre-Sustracción)</h4>
      <p>
        Imagina un cuadrado grande de área <code>a²</code>. Queremos recortarlo para quedarnos solo con el cuadrado menor de lado <code>(a - b)</code>:
      </p>
      <ol class="geometric-steps-list">
        <li>Restamos la franja horizontal superior de área <code>a · b</code>. Nos queda <code>a² - ab</code>.</li>
        <li>Restamos la franja vertical derecha de área <code>a · b</code>. Nos queda <code>a² - 2ab</code>.</li>
        <li><strong>¡Atención al cruce!</strong> La esquina superior derecha (de dimensiones <code>b × b</code> y área <code>b²</code>) <em>pertenecía a ambas franjas</em>, por lo que <strong>la hemos restado dos veces</strong>.</li>
        <li>Para compensar esa doble resta, es geométricamente obligatorio <strong>sumar una vez la esquina</strong>: <code>+ b²</code>.</li>
      </ol>
    </div>
  </section>

  <!-- SECCIÓN 5: TERCERA IDENTIDAD (SUMA POR DIFERENCIA) -->
  <section class="lesson-section" id="suma-por-diferencia">
    <div class="section-marker">
      <span class="marker-num">05</span>
      <span class="marker-line"></span>
    </div>

    <h2>5. Tercera Identidad: Suma por Diferencia (Diferencia de Cuadrados)</h2>

    <div class="formal-theorem-banner">
      <span class="theorem-badge">DIFERENCIA DE CUADRADOS</span>
      <h3>«El producto de la suma de dos términos por su diferencia es igual a la diferencia de sus cuadrados»</h3>
      <code class="theorem-symbolic">∀ a, b ∈ ℝ : (a + b)(a - b) = a² - b²</code>
    </div>

    <p>
      Esta es sin duda la identidad más potente y utilizada de toda la educación secundaria y el bachillerato. 
      A diferencia de las dos anteriores, <strong>aquí no aparece ningún término doble</strong>. ¿Por qué se desvanecen los términos intermedios?
    </p>

    <div class="proof-stepper-container">
      <div class="proof-stepper-header">
        <h4>ANULACIÓN POR ELEMENTOS OPUESTOS</h4>
        <span class="stepper-hint">La cancelación exacta en (ℝ, +)</span>
      </div>

      <div class="proof-steps-list">
        <div class="proof-step-card is-active">
          <div class="step-num-col">01</div>
          <div class="step-content">
            <div class="step-head">
              <strong>Desarrollo por doble distributividad</strong>
              <span class="step-rule">Propiedad distributiva general</span>
            </div>
            <div class="step-equation">
              <code>(a + b) · (a - b) = a(a - b) + b(a - b) = a² - ab + ba - b²</code>
            </div>
          </div>
        </div>

        <div class="proof-step-card">
          <div class="step-num-col">02</div>
          <div class="step-content">
            <div class="step-head">
              <strong>Cancelación de los términos cruzados</strong>
              <span class="step-rule">ba = ab ⟹ -ab + ab = 0</span>
            </div>
            <p>
              El término <code>-ab</code> y el término <code>+ba = +ab</code> son elementos simétricos respecto a la suma (opuestos). Su suma da exactamente el elemento neutro cero (0):
            </p>
            <div class="step-equation is-conclusive">
              <code>a² + (-ab + ab) - b² = a² + 0 - b² = a² - b²</code>
            </div>
            <div class="qed-badge">
              <span>∎ Q.E.D. · Los términos cruzados se anulan mutuamente sin dejar residuo</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 6: RÚBRICA Y ERRORES DE EXAMEN -->
  <section class="lesson-section" id="rubrica-examen">
    <div class="section-marker">
      <span class="marker-num">06</span>
      <span class="marker-line"></span>
    </div>

    <h2>6. Los 4 Pecados Capitales en Exámenes de Álgebra y PAU</h2>
    <p>
      En los exámenes de ESO, Bachillerato y pruebas de acceso a la universidad, las identidades notables aparecen camufladas en límites, derivadas, integrales y resolución de ecuaciones. Evita estos 4 tropiezos clásicos:
    </p>

    <div class="rubric-grid">
      <div class="rubric-card is-error">
        <div class="rubric-top">
          <span class="rubric-badge">ERROR CLÁSICO 01</span>
          <h3>La Trampa del Doble Menos: (-a - b)²</h3>
        </div>
        <p class="rubric-desc">
          Creer que tener dos signos negativos convierte el resultado en negativo o en una diferencia.
        </p>
        <div class="rubric-fix">
          <span class="fix-good">Identidad real:</span>
          <code>(-a - b)² = [-(a + b)]² = (-1)² · (a + b)² = (a + b)² = a² + 2ab + b²</code>
        </div>
      </div>

      <div class="rubric-card is-error">
        <div class="rubric-top">
          <span class="rubric-badge">ERROR CLÁSICO 02</span>
          <h3>La Inversión en la Resta: (b - a)²</h3>
        </div>
        <p class="rubric-desc">
          Dudar de si el orden importa al elevar una resta al cuadrado.
        </p>
        <div class="rubric-fix">
          <span class="fix-good">Identidad simétrica:</span>
          <code>(b - a)² = [-(a - b)]² = (a - b)² = a² - 2ab + b² (¡Son exactamente iguales!)</code>
        </div>
      </div>

      <div class="rubric-card is-error">
        <div class="rubric-top">
          <span class="rubric-badge">ERROR CLÁSICO 03</span>
          <h3>Olvidar la Racionalización por el Conjugado</h3>
        </div>
        <p class="rubric-desc">
          En límites de 1º y 2º de Bachillerato con indeterminaciones del tipo 0/0 o ∞ - ∞ con raíces cuadradas, intentar multiplicar sin usar la diferencia de cuadrados.
        </p>
        <div class="rubric-fix">
          <span class="fix-good">Aplicación rigurosa:</span>
          <code>(√x - 2)(√x + 2) = (√x)² - 2² = x - 4 (¡Elimina de raíz las indeterminaciones!)</code>
        </div>
      </div>

      <div class="rubric-card is-error">
        <div class="rubric-top">
          <span class="rubric-badge">ERROR CLÁSICO 04</span>
          <h3>No Reconocer la Factorización Inversa</h3>
        </div>
        <p class="rubric-desc">
          Ver una expresión como <code>x² + 6x + 9</code> y no darse cuenta inmediatamente de que es el cuadrado perfecto <code>(x + 3)²</code>.
        </p>
        <div class="rubric-fix">
          <span class="fix-good">Comprobación rápida:</span>
          <em>¿Es el término independiente el cuadrado de la mitad del coeficiente lineal? (6 / 2)² = 3² = 9. ¡Sí!</em>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 7: AUTOEVALUACIÓN INTERACTIVA -->
  <section class="lesson-section" id="autoevaluacion-algebra">
    <div class="section-marker">
      <span class="marker-num">07</span>
      <span class="marker-line"></span>
    </div>

    <h2>7. Autoevaluación de Destreza Algebraica: Demuestra tu Dominio</h2>
    <p>Responde a estas tres preguntas técnicas para consolidar las tres identidades notables:</p>

    <div class="quiz-container">
      <!-- Pregunta 1 -->
      <div class="quiz-card" data-quiz-q="1">
        <div class="quiz-question">
          <span class="q-num">1.</span>
          <p>Al desarrollar y simplificar al máximo la expresión <code>(2x - 3y)²</code>, ¿cuál es el resultado matemáticamente correcto?</p>
        </div>
        <div class="quiz-options">
          <button type="button" class="quiz-opt" data-correct="false">
            <span>A) 4x² - 9y²</span>
          </button>
          <button type="button" class="quiz-opt" data-correct="false">
            <span>B) 4x² - 6xy + 9y²</span>
          </button>
          <button type="button" class="quiz-opt" data-correct="true">
            <span>C) 4x² - 12xy + 9y²</span>
          </button>
        </div>
        <div class="quiz-explanation" hidden></div>
      </div>

      <!-- Pregunta 2 -->
      <div class="quiz-card" data-quiz-q="2">
        <div class="quiz-question">
          <span class="q-num">2.</span>
          <p>¿Cuál es la factorización algebraica irreducible de la diferencia <code>49x² - 16</code>?</p>
        </div>
        <div class="quiz-options">
          <button type="button" class="quiz-opt" data-correct="true">
            <span>A) (7x + 4)(7x - 4)</span>
          </button>
          <button type="button" class="quiz-opt" data-correct="false">
            <span>B) (7x - 4)²</span>
          </button>
          <button type="button" class="quiz-opt" data-correct="false">
            <span>C) (49x - 16)(49x + 16)</span>
          </button>
        </div>
        <div class="quiz-explanation" hidden></div>
      </div>

      <!-- Pregunta 3 -->
      <div class="quiz-card" data-quiz-q="3">
        <div class="quiz-question">
          <span class="q-num">3.</span>
          <p>¿Qué valor numérico exacto debe tener la constante <em>k</em> para que el trinomio <code>x² + 10x + k</code> sea un cuadrado perfecto <code>(x + c)²</code>?</p>
        </div>
        <div class="quiz-options">
          <button type="button" class="quiz-opt" data-correct="false">
            <span>A) k = 100</span>
          </button>
          <button type="button" class="quiz-opt" data-correct="true">
            <span>B) k = 25</span>
          </button>
          <button type="button" class="quiz-opt" data-correct="false">
            <span>C) k = 20</span>
          </button>
        </div>
        <div class="quiz-explanation" hidden></div>
      </div>
    </div>
  </section>
</AcademyLessonLayout>

<script>
  (() => {
    // =========================================================================
    // 1. LABORATORIO GEOMÉTRICO INTERACTIVO DE IDENTIDADES NOTABLES (SVG)
    // =========================================================================
    const svgEl = document.getElementById('geo-svg') as SVGSVGElement | null;
    const sliderA = document.getElementById('slider-a') as HTMLInputElement | null;
    const sliderB = document.getElementById('slider-b') as HTMLInputElement | null;
    const valADisplay = document.getElementById('val-a-display');
    const valBDisplay = document.getElementById('val-b-display');
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.identity-tabs .tab-btn');
    const metricsTitle = document.getElementById('metrics-title');
    const areasList = document.getElementById('areas-list');
    const identityEval = document.getElementById('identity-formula-eval');

    let currentIdentity: 'suma' | 'diferencia' | 'conjugado' = 'suma';

    const renderGeometry = () => {
      if (!svgEl || !sliderA || !sliderB) return;
      const a = parseInt(sliderA.value, 10);
      const b = parseInt(sliderB.value, 10);

      if (valADisplay) valADisplay.textContent = `a = ${a}`;
      if (valBDisplay) valBDisplay.textContent = `b = ${b}`;

      // Configuración de dimensiones y escala dentro del viewBox (420x420 con margen 40)
      const offset = 40;
      const maxSize = 340;

      svgEl.innerHTML = ''; // Limpiar SVG

      if (currentIdentity === 'suma') {
        const totalUnits = a + b;
        const scale = maxSize / totalUnits;
        const pxA = a * scale;
        const pxB = b * scale;

        if (metricsTitle) metricsTitle.textContent = `Área Total del Cuadrado: (a + b)² = (${a} + ${b})²`;

        // 1. Región a² (Cuadrado azul superior izquierdo)
        createSvgRect(offset, offset, pxA, pxA, 'rgba(56, 189, 248, 0.35)', '#38bdf8', `a² = ${a * a}`);
        // 2. Región ab (Rectángulo cian superior derecho)
        createSvgRect(offset + pxA, offset, pxB, pxA, 'rgba(16, 185, 129, 0.35)', '#10b981', `ab = ${a * b}`);
        // 3. Región ab (Rectángulo cian inferior izquierdo)
        createSvgRect(offset, offset + pxA, pxA, pxB, 'rgba(16, 185, 129, 0.35)', '#10b981', `ba = ${b * a}`);
        // 4. Región b² (Cuadrado dorado inferior derecho)
        createSvgRect(offset + pxA, offset + pxA, pxB, pxB, 'rgba(251, 191, 36, 0.4)', '#fbbf24', `b² = ${b * b}`);

        // Cotas y cotas de dimensión
        createSvgDimension(offset, offset - 12, pxA, `a = ${a}`, '#38bdf8');
        createSvgDimension(offset + pxA, offset - 12, pxB, `b = ${b}`, '#fbbf24');
        createSvgDimension(offset - 12, offset, pxA, `a = ${a}`, '#38bdf8', true);
        createSvgDimension(offset - 12, offset + pxA, pxB, `b = ${b}`, '#fbbf24', true);

        const totalArea = Math.pow(a + b, 2);
        if (areasList) {
          areasList.innerHTML = `
            <div class="area-metric-row is-a2">
              <span class="row-indicator" style="background: #38bdf8;"></span>
              <span class="row-label">Cuadrado mayor: a²</span>
              <strong class="row-val">${a}² = ${a * a}</strong>
            </div>
            <div class="area-metric-row is-ab">
              <span class="row-indicator" style="background: #10b981;"></span>
              <span class="row-label">Rectángulo horizontal: ab</span>
              <strong class="row-val">${a} × ${b} = ${a * b}</strong>
            </div>
            <div class="area-metric-row is-ab">
              <span class="row-indicator" style="background: #10b981;"></span>
              <span class="row-label">Rectángulo vertical: ba = ab</span>
              <strong class="row-val">${b} × ${a} = ${b * a}</strong>
            </div>
            <div class="area-metric-row is-b2">
              <span class="row-indicator" style="background: #fbbf24;"></span>
              <span class="row-label">Cuadrado menor: b²</span>
              <strong class="row-val">${b}² = ${b * b}</strong>
            </div>
          `;
        }

        if (identityEval) {
          identityEval.innerHTML = `(${a} + ${b})² = ${a * a} + 2·(${a * b}) + ${b * b} = <strong>${totalArea}</strong>`;
        }
      } else if (currentIdentity === 'diferencia') {
        // En diferencia, a debe ser mayor estricto que b
        const effectiveA = Math.max(a, b + 1);
        const scale = maxSize / effectiveA;
        const pxA = effectiveA * scale;
        const pxDiff = (effectiveA - b) * scale;
        const pxB = b * scale;

        if (metricsTitle) metricsTitle.textContent = `Área del Cuadrado Restante: (a - b)² = (${effectiveA} - ${b})²`;

        // Fondo total a²
        createSvgRect(offset, offset, pxA, pxA, 'rgba(255, 255, 255, 0.04)', 'rgba(255, 255, 255, 0.2)', `a² total = ${effectiveA * effectiveA}`);
        // Cuadrado objetivo (a - b)²
        createSvgRect(offset, offset, pxDiff, pxDiff, 'rgba(56, 189, 248, 0.45)', '#38bdf8', `(a - b)² = ${(effectiveA - b) * (effectiveA - b)}`);
        // Franja horizontal restada
        createSvgRect(offset, offset + pxDiff, pxA, pxB, 'rgba(239, 68, 68, 0.25)', '#ef4444', `Franja horizontal (-ab)`);
        // Franja vertical restada
        createSvgRect(offset + pxDiff, offset, pxB, pxA, 'rgba(239, 68, 68, 0.25)', '#ef4444', `Franja vertical (-ab)`);
        // Esquina superpuesta sumada de vuelta (+b²)
        createSvgRect(offset + pxDiff, offset + pxDiff, pxB, pxB, 'rgba(251, 191, 36, 0.55)', '#fbbf24', `+ b² compensado`);

        createSvgDimension(offset, offset - 12, pxDiff, `a - b = ${effectiveA - b}`, '#38bdf8');
        createSvgDimension(offset + pxDiff, offset - 12, pxB, `b = ${b}`, '#ef4444');

        const diffArea = Math.pow(effectiveA - b, 2);
        if (areasList) {
          areasList.innerHTML = `
            <div class="area-metric-row is-a2">
              <span class="row-indicator" style="background: rgba(255,255,255,0.4);"></span>
              <span class="row-label">Cuadrado completo de partida: a²</span>
              <strong class="row-val">${effectiveA}² = ${effectiveA * effectiveA}</strong>
            </div>
            <div class="area-metric-row is-ab">
              <span class="row-indicator" style="background: #ef4444;"></span>
              <span class="row-label">Menos dos franjas de área ab: -2ab</span>
              <strong class="row-val">-2·(${effectiveA}×${b}) = -${2 * effectiveA * b}</strong>
            </div>
            <div class="area-metric-row is-b2">
              <span class="row-indicator" style="background: #fbbf24;"></span>
              <span class="row-label">Más esquina superpuesta compensada: +b²</span>
              <strong class="row-val">+${b}² = +${b * b}</strong>
            </div>
          `;
        }

        if (identityEval) {
          identityEval.innerHTML = `(${effectiveA} - ${b})² = ${effectiveA * effectiveA} - ${2 * effectiveA * b} + ${b * b} = <strong>${diffArea}</strong>`;
        }
      } else if (currentIdentity === 'conjugado') {
        const effectiveA = Math.max(a, b + 1);
        const scale = maxSize / effectiveA;
        const pxA = effectiveA * scale;
        const pxB = b * scale;

        if (metricsTitle) metricsTitle.textContent = `Diferencia de Cuadrados: a² - b² = (${effectiveA}² - ${b}²)`;

        // 1. Cuadrado a² con esquina b² recortada (forma de L)
        createSvgRect(offset, offset, pxA, pxA, 'rgba(56, 189, 248, 0.35)', '#38bdf8', `a²`);
        // Recorte b² en esquina inferior derecha
        createSvgRect(offset + pxA - pxB, offset + pxA - pxB, pxB, pxB, 'rgba(239, 68, 68, 0.45)', '#ef4444', `Recorte: -b² = -${b * b}`);

        createSvgDimension(offset, offset - 12, pxA, `Lado a = ${effectiveA}`, '#38bdf8');
        createSvgDimension(offset + pxA + 12, offset + pxA - pxB, pxB, `b = ${b}`, '#ef4444', true);

        const conjugateArea = effectiveA * effectiveA - b * b;
        if (areasList) {
          areasList.innerHTML = `
            <div class="area-metric-row is-a2">
              <span class="row-indicator" style="background: #38bdf8;"></span>
              <span class="row-label">Área del cuadrado inicial: a²</span>
              <strong class="row-val">${effectiveA}² = ${effectiveA * effectiveA}</strong>
            </div>
            <div class="area-metric-row is-ab">
              <span class="row-indicator" style="background: #ef4444;"></span>
              <span class="row-label">Esquina recortada: -b²</span>
              <strong class="row-val">-${b}² = -${b * b}</strong>
            </div>
            <div class="area-metric-row is-b2">
              <span class="row-indicator" style="background: #10b981;"></span>
              <span class="row-label">Rectángulo equivalente: (a+b)(a-b)</span>
              <strong class="row-val">(${effectiveA}+${b}) · (${effectiveA}-${b}) = ${effectiveA + b} · ${effectiveA - b} = ${conjugateArea}</strong>
            </div>
          `;
        }

        if (identityEval) {
          identityEval.innerHTML = `(${effectiveA} + ${b})(${effectiveA} - ${b}) = ${effectiveA * effectiveA} - ${b * b} = <strong>${conjugateArea}</strong>`;
        }
      }
    };

    // Funciones auxiliares para construcción de SVG limpio
    const createSvgRect = (x: number, y: number, w: number, h: number, fill: string, stroke: string, label: string) => {
      if (!svgEl) return;
      const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      rect.setAttribute('x', x.toString());
      rect.setAttribute('y', y.toString());
      rect.setAttribute('width', w.toString());
      rect.setAttribute('height', h.toString());
      rect.setAttribute('fill', fill);
      rect.setAttribute('stroke', stroke);
      rect.setAttribute('stroke-width', '1.5');
      rect.setAttribute('rx', '4');
      svgEl.appendChild(rect);

      if (w > 30 && h > 20) {
        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', (x + w / 2).toString());
        text.setAttribute('y', (y + h / 2 + 4).toString());
        text.setAttribute('text-anchor', 'middle');
        text.setAttribute('fill', stroke);
        text.setAttribute('font-family', 'ui-monospace, monospace');
        text.setAttribute('font-weight', '700');
        text.setAttribute('font-size', '12');
        text.textContent = label;
        svgEl.appendChild(text);
      }
    };

    const createSvgDimension = (x: number, y: number, length: number, text: string, color: string, isVertical = false) => {
      if (!svgEl) return;
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('fill', color);
      t.setAttribute('font-family', 'ui-monospace, monospace');
      t.setAttribute('font-size', '11');
      t.setAttribute('font-weight', '700');

      if (!isVertical) {
        t.setAttribute('x', (x + length / 2).toString());
        t.setAttribute('y', y.toString());
        t.setAttribute('text-anchor', 'middle');
      } else {
        t.setAttribute('x', x.toString());
        t.setAttribute('y', (y + length / 2 + 4).toString());
        t.setAttribute('text-anchor', 'end');
      }

      t.textContent = text;
      g.appendChild(t);
      svgEl.appendChild(g);
    };

    if (sliderA && sliderB) {
      sliderA.addEventListener('input', renderGeometry);
      sliderB.addEventListener('input', renderGeometry);
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        currentIdentity = (btn.dataset.identity as any) || 'suma';
        renderGeometry();
      });
    });

    renderGeometry();

    // =========================================================================
    // 2. AUTOEVALUACIÓN INTERACTIVA
    // =========================================================================
    document.querySelectorAll<HTMLElement>('.quiz-card').forEach((card) => {
      const options = card.querySelectorAll<HTMLButtonElement>('.quiz-opt');
      const explanation = card.querySelector<HTMLElement>('.quiz-explanation');

      options.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isCorrect = btn.dataset.correct === 'true';

          options.forEach((o) => {
            o.disabled = true;
            if (o.dataset.correct === 'true') {
              o.classList.add('is-revealed-correct');
            }
          });

          if (isCorrect) {
            btn.classList.add('is-user-correct');
            if (explanation) {
              explanation.hidden = false;
              explanation.className = 'quiz-explanation is-good';
              explanation.innerHTML = '<strong>¡Exacto!</strong> Has aplicado las identidades notables con pleno rigor formal.';
            }
          } else {
            btn.classList.add('is-user-wrong');
            if (explanation) {
              explanation.hidden = false;
              explanation.className = 'quiz-explanation is-bad';
              explanation.innerHTML = '<strong>Incorrecto.</strong> Recuerda vigilar el doble producto 2ab y el cuadrado de los coeficientes numéricos.';
            }
          }
        });
      });
    });
  })();
</script>

