<script>
  (() => {
    // =========================================================================
    // 1. LABORATORIO INTERACTIVO DE RUFFINI Y TEOREMA DEL RESTO
    // =========================================================================
    const inputPoly = document.getElementById('input-poly') as HTMLInputElement | null;
    const inputValA = document.getElementById('input-val-a') as HTMLInputElement | null;
    const btnCalc = document.getElementById('btn-calc-ruffini');
    const presetBtns = document.querySelectorAll<HTMLButtonElement>('.preset-btn');

    const divTitle = document.getElementById('div-title');
    const tableDisplay = document.getElementById('ruffini-table-display');
    const quotientFormula = document.getElementById('quotient-formula');
    const directEvalTrace = document.getElementById('direct-eval-trace');
    const identityBadge = document.getElementById('identity-badge');
    const verdictIcon = document.getElementById('verdict-icon');
    const verdictTitle = document.getElementById('verdict-title');
    const verdictDesc = document.getElementById('verdict-desc');
    const factorDecomp = document.getElementById('factor-decomp');

    const computeRuffini = () => {
      if (!inputPoly || !inputValA || !tableDisplay) return;

      const rawCoeffs = inputPoly.value.split(',').map((s) => parseFloat(s.trim())).filter((n) => !isNaN(n));
      const aVal = parseFloat(inputValA.value);

      if (rawCoeffs.length < 2 || isNaN(aVal)) return;

      const n = rawCoeffs.length;
      const multipliers: number[] = [0];
      const results: number[] = [rawCoeffs[0]];

      for (let i = 1; i < n; i++) {
        const mult = results[i - 1] * aVal;
        multipliers.push(mult);
        results.push(rawCoeffs[i] + mult);
      }

      const remainder = results[n - 1];
      const quotientCoeffs = results.slice(0, n - 1);

      // 1. Actualizar títulos
      const signA = aVal >= 0 ? `- ${aVal}` : `+ ${Math.abs(aVal)}`;
      if (divTitle) divTitle.textContent = `División de P(x) entre (x ${signA})`;

      // 2. Renderizar tabla HTML de Ruffini
      let tableHtml = '<tbody>';

      // Fila 1: Coeficientes de P(x)
      tableHtml += '<tr class="row-coeffs"><td class="cell-a-divider"></td>';
      rawCoeffs.forEach((c) => {
        tableHtml += `<td class="cell-num">${c}</td>`;
      });
      tableHtml += '</tr>';

      // Fila 2: a y multiplicadores
      tableHtml += `<tr class="row-multipliers"><td class="cell-a-label">a = ${aVal}</td>`;
      tableHtml += '<td class="cell-num cell-empty"></td>';
      for (let i = 1; i < n; i++) {
        tableHtml += `<td class="cell-num cell-mult">${multipliers[i]}</td>`;
      }
      tableHtml += '</tr>';

      // Fila 3: Resultados (Cociente + Resto)
      tableHtml += '<tr class="row-results"><td class="cell-a-divider"></td>';
      quotientCoeffs.forEach((q) => {
        tableHtml += `<td class="cell-num cell-res">${q}</td>`;
      });
      tableHtml += `<td class="cell-num cell-remainder">${remainder}</td>`;
      tableHtml += '</tr></tbody>';

      tableDisplay.innerHTML = tableHtml;

      // 3. Formatear fórmula del cociente
      if (quotientFormula) {
        let qStr = 'C(x) = ';
        const deg = quotientCoeffs.length - 1;
        const terms: string[] = [];

        quotientCoeffs.forEach((c, idx) => {
          const power = deg - idx;
          if (c === 0 && quotientCoeffs.length > 1) return;

          let term = '';
          const absC = Math.abs(c);
          const sign = c < 0 ? '- ' : '+ ';

          if (terms.length === 0) {
            term = c < 0 ? `-${absC === 1 && power > 0 ? '' : absC}` : `${absC === 1 && power > 0 ? '' : absC}`;
          } else {
            term = `${sign}${absC === 1 && power > 0 ? '' : absC}`;
          }

          if (power > 1) term += `x^${power}`;
          else if (power === 1) term += 'x';
          else if (power === 0 && (absC === 1 || absC !== 1)) term = `${terms.length === 0 ? c : sign + absC}`;

          terms.push(term);
        });

        qStr += terms.join(' ') || '0';
        // Sustituir ^ por superíndice legible
        qStr = qStr.replace(/\^3/g, '³').replace(/\^2/g, '²').replace(/\^4/g, '⁴');
        quotientFormula.textContent = qStr;
      }

      // 4. Formatear traza de sustitución directa
      if (directEvalTrace) {
        let evalStr = `P(${aVal}) = `;
        let numericSum = 0;
        const degP = rawCoeffs.length - 1;
        const parts: string[] = [];

        rawCoeffs.forEach((c, idx) => {
          const power = degP - idx;
          const val = c * Math.pow(aVal, power);
          numericSum += val;

          let part = '';
          if (power > 0) {
            part = `${c}·(${aVal})${power > 1 ? (power === 2 ? '²' : power === 3 ? '³' : '⁴') : ''}`;
          } else {
            part = `${c >= 0 ? '+' : ''}${c}`;
          }
          parts.push(part);
        });

        evalStr += `${parts.join(' + ')} = ${numericSum}`;
        directEvalTrace.textContent = evalStr;
      }

      if (identityBadge) {
        identityBadge.textContent = `Resto Ruffini R = ${remainder}  ⟺  P(${aVal}) = ${remainder}`;
      }

      // 5. Veredicto de raíz y factorización
      const isExact = remainder === 0;

      if (verdictIcon) {
        verdictIcon.textContent = isExact ? '✓' : '≠';
        verdictIcon.style.color = isExact ? '#10b981' : '#f59e0b';
      }

      if (verdictTitle) {
        verdictTitle.textContent = isExact ? `x = ${aVal} ES RAÍZ EXACTA` : `x = ${aVal} NO ES RAÍZ (R ≠ 0)`;
        verdictTitle.style.color = isExact ? '#10b981' : '#f59e0b';
      }

      if (verdictDesc) {
        if (isExact) {
          verdictDesc.innerHTML = `Como el resto es exactamente 0, <code class="inline-code">(x ${signA})</code> divide de forma exacta al polinomio.`;
        } else {
          verdictDesc.innerHTML = `Como el resto es <code class="inline-code">${remainder} ≠ 0</code>, la división no es exacta y <code class="inline-code">P(${aVal}) = ${remainder}</code>.`;
        }
      }

      if (factorDecomp) {
        if (isExact) {
          const qText = quotientFormula?.textContent?.replace('C(x) = ', '') || '';
          factorDecomp.innerHTML = `<code>P(x) = (x ${signA}) · (${qText})</code>`;
          factorDecomp.style.display = 'block';
        } else {
          const qText = quotientFormula?.textContent?.replace('C(x) = ', '') || '';
          factorDecomp.innerHTML = `<code>P(x) = (x ${signA}) · (${qText}) + ${remainder}</code>`;
          factorDecomp.style.display = 'block';
        }
      }
    };

    btnCalc?.addEventListener('click', computeRuffini);

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        if (inputPoly && btn.dataset.p) inputPoly.value = btn.dataset.p;
        if (inputValA && btn.dataset.a) inputValA.value = btn.dataset.a;

        computeRuffini();
      });
    });

    // =========================================================================
    // 2. AUTOEVALUACIÓN INTERACTIVA
    // =========================================================================
    const quizCards = document.querySelectorAll<HTMLElement>('.quiz-card');

    quizCards.forEach((card) => {
      const options = card.querySelectorAll<HTMLButtonElement>('.quiz-opt');
      const feedback = card.querySelector<HTMLElement>('.quiz-feedback');

      options.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isCorrect = btn.dataset.correct === 'true';

          options.forEach((b) => {
            b.disabled = true;
            if (b.dataset.correct === 'true') {
              b.classList.add('is-correct');
            } else if (b === btn && !isCorrect) {
              b.classList.add('is-incorrect');
            }
          });

          if (feedback) {
            feedback.style.display = 'block';
            if (isCorrect) {
              feedback.className = 'quiz-feedback feedback-success';
              feedback.innerHTML = '<strong>Respuesta Correcta:</strong> Has identificado con exactitud la base deductiva del teorema.';
            } else {
              feedback.className = 'quiz-feedback feedback-error';
              feedback.innerHTML = '<strong>Incorrecto:</strong> Revisa el desarrollo formal en los apartados 2 y 6 de la lección.';
            }
          }
        });
      });
    });
  })();
</script>

