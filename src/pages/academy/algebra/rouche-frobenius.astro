<!-- SCRIPT DEL LABORATORIO Y QUIZ -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ------------------------------------------------------------------------
    // LABORATORIO DE ROUCHÉ-FROBENIUS
    // ------------------------------------------------------------------------
    const paramControlContainer = document.getElementById('param-control-container');
    const paramSlider = document.getElementById('param-k-input');
    const paramValueDisplay = document.getElementById('param-k-value-display');
    const presetButtons = document.querySelectorAll('.preset-btn');
    const quickValButtons = document.querySelectorAll('.quick-val-btn');

    const sysEqLines = document.getElementById('sys-eq-lines');
    const matrixAPreview = document.getElementById('matrix-a-preview');
    const matrixABPreview = document.getElementById('matrix-ab-preview');
    const detAValue = document.getElementById('det-a-value');
    const menoresABInfo = document.getElementById('menores-ab-info');
    const rankABadge = document.getElementById('rank-a-badge');
    const rankABBadge = document.getElementById('rank-ab-badge');

    const verdictBanner = document.getElementById('verdict-banner-box');
    const verdictCategory = document.getElementById('verdict-category');
    const verdictTitle = document.getElementById('verdict-title');
    const verdictExplanation = document.getElementById('verdict-explanation-text');
    const verdictSolution = document.getElementById('verdict-solution-preview');

    let currentPreset = 'param_k';
    let currentK = 1;

    // Presets estáticos y dinámicos
    const PRESET_SYSTEMS = {
      param_k: {
        getSystem: (k) => ({
          eqs: [
            `x + y + ${k === 1 ? '' : k === -1 ? '-' : k}z = 1`,
            `x + ${k === 1 ? '' : k === -1 ? '-' : k}y + z = 1`,
            `${k === 1 ? '' : k === -1 ? '-' : k}x + y + z = 1`,
          ],
          A: [
            [1, 1, k],
            [1, k, 1],
            [k, 1, 1],
          ],
          B: [1, 1, 1],
        }),
      },
      scd_clean: {
        system: {
          eqs: [
            '2x - y + z = 3',
            'x + 2y - z = 2',
            'x + y + 2z = 5',
          ],
          A: [
            [2, -1, 1],
            [1, 2, -1],
            [1, 1, 2],
          ],
          B: [3, 2, 5],
        },
      },
      sci_line: {
        system: {
          eqs: [
            'x + y - z = 2',
            '2x + 2y - 2z = 4',
            'x - y + z = 0',
          ],
          A: [
            [1, 1, -1],
            [2, 2, -2],
            [1, -1, 1],
          ],
          B: [2, 4, 0],
        },
      },
      si_prism: {
        system: {
          eqs: [
            'x + y + z = 2',
            '2x + 2y + 2z = 5',
            'x - y + 2z = 1',
          ],
          A: [
            [1, 1, 1],
            [2, 2, 2],
            [1, -1, 2],
          ],
          B: [2, 5, 1],
        },
      },
      homogeneous: {
        system: {
          eqs: [
            'x + 2y - z = 0',
            '2x - y + 3z = 0',
            '3x + y + 2z = 0',
          ],
          A: [
            [1, 2, -1],
            [2, -1, 3],
            [3, 1, 2],
          ],
          B: [0, 0, 0],
        },
      },
    };

    function computeDet3x3(m) {
      return (
        m[0][0] * (m[1][1] * m[2][2] - m[1][2] * m[2][1]) -
        m[0][1] * (m[1][0] * m[2][2] - m[1][2] * m[2][0]) +
        m[0][2] * (m[1][0] * m[2][1] - m[1][1] * m[2][0])
      );
    }

    function computeRank(matrix) {
      // Para matrices hasta 3x4
      const rows = matrix.length;
      const cols = matrix[0].length;
      
      // Buscar menores de 3x3 si cols >= 3
      if (rows === 3 && cols >= 3) {
        for (let j1 = 0; j1 < cols - 2; j1++) {
          for (let j2 = j1 + 1; j2 < cols - 1; j2++) {
            for (let j3 = j2 + 1; j3 < cols; j3++) {
              const sub = [
                [matrix[0][j1], matrix[0][j2], matrix[0][j3]],
                [matrix[1][j1], matrix[1][j2], matrix[1][j3]],
                [matrix[2][j1], matrix[2][j2], matrix[2][j3]],
              ];
              const d = computeDet3x3(sub);
              if (Math.abs(d) > 1e-6) return 3;
            }
          }
        }
      }

      // Buscar menores de 2x2
      for (let i1 = 0; i1 < rows - 1; i1++) {
        for (let i2 = i1 + 1; i2 < rows; i2++) {
          for (let j1 = 0; j1 < cols - 1; j1++) {
            for (let j2 = j1 + 1; j2 < cols; j2++) {
              const d2 = matrix[i1][j1] * matrix[i2][j2] - matrix[i1][j2] * matrix[i2][j1];
              if (Math.abs(d2) > 1e-6) return 2;
            }
          }
        }
      }

      // Comprobar si hay algún elemento no nulo
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (Math.abs(matrix[r][c]) > 1e-6) return 1;
        }
      }

      return 0;
    }

    function renderSystem() {
      let sys;
      if (currentPreset === 'param_k') {
        paramControlContainer.style.display = 'block';
        sys = PRESET_SYSTEMS.param_k.getSystem(currentK);
      } else {
        paramControlContainer.style.display = 'none';
        sys = PRESET_SYSTEMS[currentPreset].system;
      }

      // Render ecuaciones
      sysEqLines.innerHTML = sys.eqs
        .map((eq) => `<div class="eq-line-item">${eq}</div>`)
        .join('');

      // Construir matriz A y A|B
      const A = sys.A;
      const B = sys.B;
      const AB = A.map((row, i) => [...row, B[i]]);

      // Render Matriz A
      matrixAPreview.innerHTML = `
        <span class="bracket-large">[</span>
        <div class="matrix-cells-grid cols-3">
          ${A.map(row => row.map(v => `<span class="mat-c">${Number.isInteger(v) ? v : v.toFixed(1)}</span>`).join('')).join('')}
        </div>
        <span class="bracket-large">]</span>
      `;

      // Render Matriz A|B
      matrixABPreview.innerHTML = `
        <span class="bracket-large">[</span>
        <div class="matrix-cells-grid cols-4">
          ${AB.map(row => {
            return `
              <span class="mat-c">${Number.isInteger(row[0]) ? row[0] : row[0].toFixed(1)}</span>
              <span class="mat-c">${Number.isInteger(row[1]) ? row[1] : row[1].toFixed(1)}</span>
              <span class="mat-c">${Number.isInteger(row[2]) ? row[2] : row[2].toFixed(1)}</span>
              <span class="mat-c col-aug">${Number.isInteger(row[3]) ? row[3] : row[3].toFixed(1)}</span>
            `;
          }).join('')}
        </div>
        <span class="bracket-large">]</span>
      `;

      // Cálculos de determinante y rangos
      const detA = computeDet3x3(A);
      const rgA = computeRank(A);
      const rgAB = computeRank(AB);

      detAValue.textContent = Math.abs(detA) < 1e-6 ? '0 (Matriz singular)' : Number.isInteger(detA) ? detA : detA.toFixed(2);
      rankABadge.textContent = `rg(A) = ${rgA}`;
      rankABBadge.textContent = `rg(A|B) = ${rgAB}`;

      // Resetear clases de píldoras
      rankABadge.className = 'rank-indicator ' + (rgA === 3 ? 'badge-green' : rgA === 2 ? 'badge-amber' : 'badge-red');
      rankABBadge.className = 'rank-indicator ' + (rgAB === 3 ? 'badge-green' : rgAB === 2 ? 'badge-amber' : 'badge-red');

      // Veredicto
      verdictBanner.className = 'verdict-banner';
      if (rgA < rgAB) {
        // Incompatible
        verdictBanner.classList.add('verdict-si');
        verdictCategory.textContent = 'SISTEMA INCOMPATIBLE (SI)';
        verdictTitle.textContent = `rg(A) = ${rgA}  <  rg(A|B) = ${rgAB}`;
        verdictExplanation.textContent = 'El vector de términos independientes no pertenece al espacio generado por las columnas de coeficientes. No existe ninguna combinación lineal posible: el sistema carece de soluciones.';
        verdictSolution.innerHTML = `
          <strong>Geometría en ℝ³:</strong> Los tres planos no comparten ningún punto simultáneo (superficie prismática o planos paralelos).<br/>
          <strong>Conjunto solución:</strong> S = ∅
        `;
      } else if (rgA === rgAB && rgA === 3) {
        // SCD
        verdictBanner.classList.add('verdict-scd');
        verdictCategory.textContent = 'SISTEMA COMPATIBLE DETERMINADO (SCD)';
        verdictTitle.textContent = `rg(A) = 3 = rg(A|B) = nº incógnitas (n = 3)`;
        verdictExplanation.textContent = 'Las 3 columnas de A son linealmente independientes y forman una base de ℝ³. El vector B se descompone de forma única según dicha base.';
        
        let solText = '';
        if (currentPreset === 'param_k') {
          // Solución simétrica para el sistema paramétrico: x = y = z = 1/(k + 2)
          const solVal = (1 / (currentK + 2)).toFixed(2);
          solText = `x = y = z = 1/(k + 2) = 1/(${currentK} + 2) = ${solVal}`;
        } else if (currentPreset === 'scd_clean') {
          solText = 'x = 1, y = 2, z = 1';
        } else {
          solText = 'Solución única resoluble mediante la Regla de Cramer: x = |A_x|/|A|, y = |A_y|/|A|, z = |A_z|/|A|';
        }

        verdictSolution.innerHTML = `
          <strong>Geometría en ℝ³:</strong> Tres planos secantes en un <strong>único punto</strong>.<br/>
          <strong>Punto solución:</strong> ${solText}
        `;
      } else {
        // SCI
        const params = 3 - rgA;
        verdictBanner.classList.add('verdict-sci');
        verdictCategory.textContent = 'SISTEMA COMPATIBLE INDETERMINADO (SCI)';
        verdictTitle.textContent = `rg(A) = ${rgA} = rg(A|B) < nº incógnitas (n = 3)`;
        verdictExplanation.textContent = `El sistema tiene infinitas soluciones continuas dependientes de ${params} parámetro(s) libre(s) (${params === 1 ? 'λ' : 'λ, μ'}).`;

        verdictSolution.innerHTML = `
          <strong>Geometría en ℝ³:</strong> ${params === 1 ? 'Los planos comparten una <strong>recta común</strong> (haz de planos).' : 'Los tres planos son <strong>completamente coincidentes</strong>.'}<br/>
          <strong>Grados de libertad:</strong> Dimensión de las soluciones = ${params} (recta si dim=1, plano si dim=2).
        `;
      }
    }

    // Eventos de presets
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        currentPreset = btn.getAttribute('data-preset');
        renderSystem();
      });
    });

    // Slider de parámetro k
    paramSlider.addEventListener('input', (e) => {
      currentK = parseFloat(e.target.value);
      paramValueDisplay.textContent = `k = ${currentK}`;
      renderSystem();
    });

    // Botones de acceso rápido a k
    quickValButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = parseFloat(btn.getAttribute('data-set-k'));
        currentK = val;
        paramSlider.value = val;
        paramValueDisplay.textContent = `k = ${val}`;
        renderSystem();
      });
    });

    // Inicializar simulador
    renderSystem();

    // ------------------------------------------------------------------------
    // AUTOEVALUACIÓN INTERACTIVA (QUIZ)
    // ------------------------------------------------------------------------
    const quizCards = document.querySelectorAll('.quiz-card');

    quizCards.forEach((card) => {
      const options = card.querySelectorAll('.quiz-opt');
      const feedback = card.querySelector('.quiz-feedback');

      options.forEach((opt) => {
        opt.addEventListener('click', () => {
          const isCorrect = opt.getAttribute('data-correct') === 'true';

          options.forEach((o) => {
            o.disabled = true;
            if (o.getAttribute('data-correct') === 'true') {
              o.classList.add('is-correct');
            } else if (o === opt) {
              o.classList.add('is-incorrect');
            }
          });

          feedback.style.display = 'block';
          if (isCorrect) {
            feedback.className = 'quiz-feedback feedback-success';
            feedback.textContent = '¡Correcto! Has aplicado con total exactitud las condiciones del Teorema de Rouché-Frobenius.';
          } else {
            feedback.className = 'quiz-feedback feedback-error';
            feedback.textContent = 'Incorrecto. Revisa las condiciones de comparación entre rg(A), rg(A|B) y el número de incógnitas n.';
          }
        });
      });
    });
  });
</script>

