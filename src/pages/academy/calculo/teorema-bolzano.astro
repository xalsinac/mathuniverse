  }

  .surgical-card h4 {
    color: var(--ink, #f8fafc);
    font-size: 1.05rem;
    margin: 0 0 0.6rem 0;
  }

  .surgical-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft, #94a3b8);
    margin: 0;
  }

  /* 3. GALERÍA DE CONTRAEJEMPLOS */
  .counterexamples-grid {
    display: grid;
