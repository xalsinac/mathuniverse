    padding: 0.6rem 0.8rem;
    margin-bottom: 1rem;
    color: #fca5a5;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .counter-card.is-subtle .c-formula {
    border-color: rgba(245, 158, 11, 0.25);
