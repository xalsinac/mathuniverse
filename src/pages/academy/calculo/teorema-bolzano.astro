    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.3);
  }

  .m-label {
    font-size: 0.72rem;
    color: #94a3b8;
    text-transform: uppercase;
    font-family: ui-monospace, SFMono-Regular, monospace;
  }

  .m-val {
