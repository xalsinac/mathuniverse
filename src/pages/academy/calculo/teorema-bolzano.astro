  }

  .c-note {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--muted, #94a3b8);
    margin-top: auto;
  }

  /* 4. LABORATORIO INTERACTIVO */
  .bisection-lab-container {
    background: #090e17;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 14px;
    overflow: hidden;
    margin: 2.5rem 0;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
  }

  .lab-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: rgba(15, 23, 42, 0.9);
    border-bottom: 1px solid rgba(56, 189, 248, 0.2);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .lab-title-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .lab-indicator-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .lab-header-text {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #38bdf8;
  }

  .lab-func-selector {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .b-tab-btn {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.78rem;
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.2);
    color: #94a3b8;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .b-tab-btn:hover {
    color: #f1f5f9;
    border-color: rgba(56, 189, 248, 0.4);
  }

  .b-tab-btn.is-active {
    background: rgba(56, 189, 248, 0.18);
    border-color: #38bdf8;
    color: #38bdf8;
    font-weight: 700;
  }

  .lab-workbench-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
  }

  @media (max-width: 960px) {
    .lab-workbench-grid {
      grid-template-columns: 1fr;
    }
  }

  .lab-graph-card {
    background: #060a12;
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
  }

  .graph-legend {
    display: flex;
    gap: 1.25rem;
    font-size: 0.75rem;
    color: #94a3b8;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .leg-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .dot-swatch {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .swatch-curve { background: #38bdf8; }
  .swatch-interval { background: rgba(56, 189, 248, 0.35); border-radius: 2px; }
  .swatch-mid { background: #fbbf24; }
  .swatch-root { background: #10b981; }

  .svg-stage-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #020617;
    border-radius: 8px;
    border: 1px solid rgba(56, 189, 248, 0.15);
    overflow: hidden;
  }

  .bisection-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .lab-controls-bar {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .lab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .lab-btn.is-primary {
    background: #0284c7;
    color: #fff;
    border: 1px solid #38bdf8;
  }
  .lab-btn.is-primary:hover {
    background: #0369a1;
  }

  .lab-btn.is-secondary {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }
  .lab-btn.is-secondary:hover {
    background: rgba(56, 189, 248, 0.25);
  }

  .lab-btn.is-outline {
    background: transparent;
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.3);
  }
  .lab-btn.is-outline:hover {
    color: #f1f5f9;
    border-color: #f1f5f9;
  }

  /* Telemetría */
  .lab-telemetry-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 10px;
    padding: 1.25rem;
