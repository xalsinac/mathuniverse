  }
  .m-val.highlight {
    font-size: 1.35rem;
    color: #fbbf24;
  }
  .m-val.text-green { color: #10b981; }
  .m-val.text-amber { color: #f59e0b; }

  .m-sub {
    font-size: 0.75rem;
    color: #64748b;
  }

  /* Tabla histórica */
  .tel-history-wrap {
    margin-top: auto;
  }

  .hist-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    margin-bottom: 0.4rem;
