<!-- SCRIPT DEL LABORATORIO Y QUIZ -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ------------------------------------------------------------------------
    // LABORATORIO DE LÍMITES Y DISCONTINUIDADES
    // ------------------------------------------------------------------------
    const caseButtons = document.querySelectorAll('.case-btn');
    const zoomButtons = document.querySelectorAll('.zoom-btn');
    const proxSlider = document.getElementById('prox-slider');
    const proxValDisplay = document.getElementById('prox-val-display');

    const currentFuncFormula = document.getElementById('current-func-formula');
    const currentPointA = document.getElementById('current-point-a');

    const leftXVal = document.getElementById('left-x-val');
    const leftFxVal = document.getElementById('left-fx-val');
    const leftTendency = document.getElementById('left-tendency-display');

    const rightXVal = document.getElementById('right-x-val');
    const rightFxVal = document.getElementById('right-fx-val');
    const rightTendency = document.getElementById('right-tendency-display');

    const verdictBanner = document.getElementById('lab-verdict-banner');
    const vStatusBadge = document.getElementById('v-status-badge');
    const vLimitStatement = document.getElementById('v-limit-statement');
    const vDescText = document.getElementById('v-desc-text');
    const vContinuityText = document.getElementById('v-continuity-text');

    const DX_VALUES = [0.5, 0.1, 0.01, 0.001, 0.0001];
    let currentCase = 'hole';
    let currentDx = 0.01;

    const STUDY_CASES = {
      hole: {
        formula: 'f(x) = (x² - 4) / (x - 2)',
        a: 2,
        eval: (x) => {
          if (Math.abs(x - 2) < 1e-12) return NaN;
          return (x * x - 4) / (x - 2); // Equivalente a x + 2
        },
        leftLimit: '4',
        rightLimit: '4',
        globalLimit: '4',
        hasLimit: true,
        statusBadge: 'LÍMITE EXISTENTE (FINITO)',
        badgeClass: 'badge-green',
        desc: 'Como el límite lateral izquierdo (4) coincide exactamente con el límite lateral derecho (4), el límite global existe y vale 4, a pesar de que f(2) no esté definida (0/0).',
        continuity: 'Presenta una Discontinuidad Evitable en x = 2. Redefiniendo f(2) = 4, la función sería continua en todo ℝ.',
      },
      jump: {
        formula: 'f(x) = |x| / x  (Función Signo)',
        a: 0,
        eval: (x) => {
          if (Math.abs(x) < 1e-12) return NaN;
          return Math.abs(x) / x;
        },
        leftLimit: '-1',
        rightLimit: '+1',
        globalLimit: 'NO EXISTE',
        hasLimit: false,
        statusBadge: 'LÍMITE NO EXISTE (SALTO FINITO)',
        badgeClass: 'badge-red',
        desc: 'El límite lateral izquierdo (-1) y el límite lateral derecho (+1) son finitos pero distintos. Por el teorema de existencia, el límite global NO EXISTE.',
        continuity: 'Presenta una Discontinuidad Inevitable de Salto Finito en x = 0 (magnitud del salto = 2 unidades).',
      },
      asymptote: {
        formula: 'f(x) = 1 / (x - 2)',
        a: 2,
        eval: (x) => {
          if (Math.abs(x - 2) < 1e-12) return Infinity;
          return 1 / (x - 2);
        },
        leftLimit: '-∞',
        rightLimit: '+∞',
        globalLimit: 'NO EXISTE',
        hasLimit: false,
        statusBadge: 'LÍMITE NO EXISTE (ASÍNTOTA VERTICAL)',
        badgeClass: 'badge-red',
        desc: 'Por la izquierda la función cae sin cota hacia -∞ y por la derecha crece hacia +∞. Los límites laterales divergen con signos opuestos.',
        continuity: 'Presenta una Discontinuidad Inevitable de Salto Infinito en x = 2 (Asíntota vertical x = 2).',
      },
      continuous: {
        formula: 'f(x) = x² + 1  (Parábola continua)',
        a: 1,
        eval: (x) => x * x + 1,
        leftLimit: '2',
        rightLimit: '2',
        globalLimit: '2',
        hasLimit: true,
        statusBadge: 'FUNCIÓN CONTINUA (lim = f(a))',
        badgeClass: 'badge-green',
        desc: 'Ambos límites laterales existen, valen 2 y coinciden exactamente con f(1) = 1² + 1 = 2. Cumple las 3 condiciones de continuidad.',
        continuity: 'Función Continua en x = 1 (y en todo ℝ).',
      },
    };

    function updateSimulation() {
      const data = STUDY_CASES[currentCase];
      const a = data.a;

      currentFuncFormula.textContent = data.formula;
      currentPointA.textContent = `a = ${a}`;

      const xLeft = a - currentDx;
      const xRight = a + currentDx;

      const fLeft = data.eval(xLeft);
      const fRight = data.eval(xRight);

      // Formatear coordenadas
      leftXVal.textContent = xLeft.toFixed(6);
      rightXVal.textContent = xRight.toFixed(6);

      if (currentCase === 'asymptote') {
        leftFxVal.textContent = fLeft < -1000 ? fLeft.toExponential(2) : fLeft.toFixed(4);
        rightFxVal.textContent = fRight > 1000 ? fRight.toExponential(2) : fRight.toFixed(4);
      } else {
        leftFxVal.textContent = fLeft.toFixed(6);
        rightFxVal.textContent = fRight.toFixed(6);
      }

      leftTendency.innerHTML = `lim<sub>x→${a}⁻</sub> = ${data.leftLimit}`;
      rightTendency.innerHTML = `lim<sub>x→${a}⁺</sub> = ${data.rightLimit}`;

      // Banner veredicto
      vStatusBadge.textContent = data.statusBadge;
      vStatusBadge.className = 'verdict-type-badge ' + data.badgeClass;

      vLimitStatement.innerHTML = data.hasLimit
        ? `lim<sub>x→${a}</sub> f(x) = ${data.globalLimit}`
        : `lim<sub>x→${a}</sub> f(x) NO EXISTE`;

      vDescText.textContent = data.desc;
      vContinuityText.innerHTML = `<strong>Diagnóstico de Continuidad:</strong> ${data.continuity}`;

      verdictBanner.className = 'lab-verdict-box ' + (data.hasLimit ? 'verdict-pass' : 'verdict-fail');
    }

    // Eventos selector de casos
    caseButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        caseButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        currentCase = btn.getAttribute('data-case');
        updateSimulation();
      });
    });

    // Evento slider
    proxSlider.addEventListener('input', (e) => {
      const idx = parseInt(e.target.value, 10) - 1;
      currentDx = DX_VALUES[idx];
      proxValDisplay.textContent = `Δx = ${currentDx}`;
      updateSimulation();
    });

    // Botones zoom
    zoomButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const dx = parseFloat(btn.getAttribute('data-set-dx'));
        currentDx = dx;
        const idx = DX_VALUES.indexOf(dx);
        if (idx !== -1) {
          proxSlider.value = idx + 1;
        }
        proxValDisplay.textContent = `Δx = ${dx}`;
        updateSimulation();
      });
    });

    // Iniciar simulación
    updateSimulation();

    // ------------------------------------------------------------------------
    // AUTOEVALUACIÓN INTERACTIVA (QUIZ)
    // ------------------------------------------------------------------------
    const quizCards = document.querySelectorAll('.quiz-card');

    quizCards.forEach((card) => {
      const options = card.querySelectorAll('.quiz-opt');
      const feedback = card.querySelector('.quiz-feedback');

      options.forEach((opt) => {
        opt.addEventListener('click', () => {
          const isCorrect = opt.getAttribute('data-correct') === 'true';

          options.forEach((o) => {
            o.disabled = true;
            if (o.getAttribute('data-correct') === 'true') {
              o.classList.add('is-correct');
            } else if (o === opt) {
              o.classList.add('is-incorrect');
            }
          });

          feedback.style.display = 'block';
          if (isCorrect) {
            feedback.className = 'quiz-feedback feedback-success';
            feedback.textContent = '¡Correcto! Has razonado con precisión las hipótesis del análisis real y la definición de límite.';
          } else {
            feedback.className = 'quiz-feedback feedback-error';
            feedback.textContent = 'Incorrecto. Recuerda que el límite estudia el entorno perforado de aproximación y requiere igualdad estricta de ambos laterales.';
          }
        });
      });
    });
  });
</script>

