<script>
  (() => {
    // -------------------------------------------------------------
    // 1. LABORATORIO VECTORIAL DE LAGRANGE Y ROLLE
    // -------------------------------------------------------------
    interface CurveDef {
      name: string;
      f: (x: number) => number;
      df: (x: number) => number;
      defaultA: number;
      defaultB: number;
      minSlider: number;
      maxSlider: number;
      domainMin: number;
      domainMax: number;
      rangeMin: number;
      rangeMax: number;
      isNonDifferentiable?: boolean;
    }

    const curves: Record<string, CurveDef> = {
      cubic: {
        name: 'Cúbica de Rolle',
        f: (x: number) => x * x * x - 3 * x * x + 2 * x,
        df: (x: number) => 3 * x * x - 6 * x + 2,
        defaultA: 0.0,
        defaultB: 2.0,
        minSlider: -0.5,
        maxSlider: 2.5,
        domainMin: -0.6,
        domainMax: 2.6,
        rangeMin: -1.2,
        rangeMax: 1.2
      },
      parabola: {
        name: 'Parábola de Lagrange',
        f: (x: number) => -x * x + 4 * x,
        df: (x: number) => -2 * x + 4,
        defaultA: 0.5,
        defaultB: 3.5,
        minSlider: -0.5,
        maxSlider: 4.5,
        domainMin: -0.8,
        domainMax: 4.8,
        rangeMin: -1.0,
        rangeMax: 4.5
      },
      sin: {
        name: 'Trigonométrica Senoidal',
        f: (x: number) => Math.sin(x),
        df: (x: number) => Math.cos(x),
        defaultA: 0.0,
        defaultB: 3.14159,
        minSlider: -0.5,
        maxSlider: 3.6,
        domainMin: -0.8,
        domainMax: 3.8,
        rangeMin: -1.3,
        rangeMax: 1.3
      },
      abs: {
        name: 'Punto Anguloso (Contraejemplo)',
        f: (x: number) => 1 - Math.abs(x),
        df: (x: number) => (x < 0 ? 1 : x > 0 ? -1 : 0),
        defaultA: -1.0,
        defaultB: 1.0,
        minSlider: -1.5,
        maxSlider: 1.5,
        domainMin: -1.8,
        domainMax: 1.8,
        rangeMin: -1.0,
        rangeMax: 1.5,
        isNonDifferentiable: true
      }
    };

    let currentCurveKey = 'cubic';

    // DOM Elements
    const svgEl = document.getElementById('lagrange-svg') as SVGSVGElement | null;
    const bgGrid = document.getElementById('bg-grid');
    const axesLayer = document.getElementById('axes-layer');
    const curvePath = document.getElementById('curve-path');
    const secantLine = document.getElementById('secant-line');
    const tangentLine = document.getElementById('tangent-line');
    const lineA = document.getElementById('line-a');
    const lineB = document.getElementById('line-b');
    const lineC = document.getElementById('line-c');
    const pointsLayer = document.getElementById('points-layer');

    const sliderA = document.getElementById('slider-a') as HTMLInputElement | null;
    const sliderB = document.getElementById('slider-b') as HTMLInputElement | null;
    const dispSliderA = document.getElementById('disp-slider-a');
    const dispSliderB = document.getElementById('disp-slider-b');

    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.l-tab-btn');

    // Telemetría
    const valMsec = document.getElementById('val-msec');
    const valMtan = document.getElementById('val-mtan');
    const valCoordC = document.getElementById('val-coord-c');
    const valFc = document.getElementById('val-fc');
    const valRolleCheck = document.getElementById('val-rolle-check');
    const valRolleSub = document.getElementById('val-rolle-sub');
    const valDiffAngle = document.getElementById('val-diff-angle');
    const valRegularity = document.getElementById('val-regularity');
    const telParallelStatus = document.getElementById('tel-parallel-status');
    const telNoteBox = document.getElementById('tel-note-box');

    // Dimensiones SVG
    const SVG_W = 600;
    const SVG_H = 340;
    const PAD = 35;

    function getCoords(x: number, y: number, def: CurveDef) {
      const sx = PAD + ((x - def.domainMin) / (def.domainMax - def.domainMin)) * (SVG_W - 2 * PAD);
      const sy = (SVG_H - PAD) - ((y - def.rangeMin) / (def.rangeMax - def.rangeMin)) * (SVG_H - 2 * PAD);
      return { x: sx, y: sy };
    }

    function findLagrangeC(def: CurveDef, a: number, b: number, mSec: number): number | null {
      if (def.isNonDifferentiable) return null;

      if (currentCurveKey === 'parabola') {
        // -2c + 4 = mSec => c = (4 - mSec) / 2 = (a + b) / 2
        return (a + b) / 2;
      }

      if (currentCurveKey === 'sin') {
        // cos(c) = mSec
        if (Math.abs(mSec) <= 1) {
          const cCand = Math.acos(mSec);
          if (cCand > a && cCand < b) return cCand;
          const cCand2 = -cCand;
          if (cCand2 > a && cCand2 < b) return cCand2;
          const cCand3 = 2 * Math.PI - cCand;
          if (cCand3 > a && cCand3 < b) return cCand3;
        }
      }

      // Método numérico para cúbica u otras: muestreo denso
      let bestC = (a + b) / 2;
      let minDiff = Infinity;
      const samples = 200;
      for (let i = 1; i < samples; i++) {
        const xTest = a + (i / samples) * (b - a);
        const dfVal = def.df(xTest);
        const diff = Math.abs(dfVal - mSec);
        if (diff < minDiff) {
          minDiff = diff;
          bestC = xTest;
        }
      }
      return bestC;
    }

    function renderLab() {
      const def = curves[currentCurveKey];
      if (!def || !sliderA || !sliderB || !svgEl) return;

      const isLight = document.documentElement.getAttribute('data-theme') === 'light';

      let a = parseFloat(sliderA.value);
      let b = parseFloat(sliderB.value);

      // Impedir colapso del intervalo
      if (b <= a + 0.1) {
        b = a + 0.1;
        sliderB.value = b.toFixed(2);
      }

      if (dispSliderA) dispSliderA.textContent = a.toFixed(2);
      if (dispSliderB) dispSliderB.textContent = b.toFixed(2);

      const fA = def.f(a);
      const fB = def.f(b);
      const mSec = (fB - fA) / (b - a);

      const c = findLagrangeC(def, a, b, mSec);
      const hasC = c !== null && !def.isNonDifferentiable;
      const fC = hasC ? def.f(c) : 0;
      const mTan = hasC ? def.df(c) : 0;

      // 1. Ejes y Rejilla
      if (axesLayer && bgGrid) {
        axesLayer.innerHTML = '';
        bgGrid.innerHTML = '';

        // Eje X (y = 0)
        const pLeft = getCoords(def.domainMin, 0, def);
        const pRight = getCoords(def.domainMax, 0, def);
        const axisX = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        axisX.setAttribute('x1', pLeft.x.toString());
        axisX.setAttribute('y1', pLeft.y.toString());
        axisX.setAttribute('x2', pRight.x.toString());
        axisX.setAttribute('y2', pRight.y.toString());
        axisX.setAttribute('stroke', isLight ? '#94a3b8' : '#475569');
        axisX.setAttribute('stroke-width', '2');
        axesLayer.appendChild(axisX);

        // Ticks en X
        const stepX = (def.domainMax - def.domainMin) / 6;
        for (let xVal = def.domainMin; xVal <= def.domainMax; xVal += stepX) {
          const pt = getCoords(xVal, 0, def);
          const tick = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          tick.setAttribute('x1', pt.x.toString());
          tick.setAttribute('y1', (pt.y - 4).toString());
          tick.setAttribute('x2', pt.x.toString());
          tick.setAttribute('y2', (pt.y + 4).toString());
          tick.setAttribute('stroke', isLight ? '#cbd5e1' : '#64748b');
          tick.setAttribute('stroke-width', '1.5');
          axesLayer.appendChild(tick);

          const txt = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          txt.setAttribute('x', pt.x.toString());
          txt.setAttribute('y', (pt.y + 16).toString());
          txt.setAttribute('fill', isLight ? '#475569' : '#94a3b8');
          txt.setAttribute('font-size', '10');
          txt.setAttribute('text-anchor', 'middle');
          txt.textContent = xVal.toFixed(1);
          axesLayer.appendChild(txt);
        }
      }

      // 2. Trazo de la Curva f(x)
      if (curvePath) {
        let dStr = '';
        const samples = 140;
        for (let i = 0; i <= samples; i++) {
          const t = i / samples;
          const xVal = def.domainMin + t * (def.domainMax - def.domainMin);
          const yVal = def.f(xVal);
          const pt = getCoords(xVal, yVal, def);
          dStr += (i === 0 ? 'M ' : ' L ') + pt.x.toFixed(2) + ' ' + pt.y.toFixed(2);
        }
        curvePath.setAttribute('d', dStr);
        curvePath.setAttribute('stroke', isLight ? '#0284c7' : '#38bdf8');
      }

      // 3. Recta Secante AB
      const ptA = getCoords(a, fA, def);
      const ptB = getCoords(b, fB, def);
      if (secantLine) {
        // Extender la línea secante más allá de A y B
        const extX1 = a - 0.4 * (b - a);
        const extY1 = fA - 0.4 * (fB - fA);
        const extX2 = b + 0.4 * (b - a);
        const extY2 = fB + 0.4 * (fB - fA);
        const pSec1 = getCoords(extX1, extY1, def);
        const pSec2 = getCoords(extX2, extY2, def);

        secantLine.setAttribute('x1', pSec1.x.toString());
        secantLine.setAttribute('y1', pSec1.y.toString());
        secantLine.setAttribute('x2', pSec2.x.toString());
        secantLine.setAttribute('y2', pSec2.y.toString());
      }

      // 4. Recta Tangente en c
      if (tangentLine) {
        if (hasC && c !== null) {
          const tangHalfSpan = 0.5 * (b - a);
          const tX1 = c - tangHalfSpan;
          const tY1 = fC - mTan * tangHalfSpan;
          const tX2 = c + tangHalfSpan;
          const tY2 = fC + mTan * tangHalfSpan;
          const pTan1 = getCoords(tX1, tY1, def);
          const pTan2 = getCoords(tX2, tY2, def);

          tangentLine.setAttribute('x1', pTan1.x.toString());
          tangentLine.setAttribute('y1', pTan1.y.toString());
          tangentLine.setAttribute('x2', pTan2.x.toString());
          tangentLine.setAttribute('y2', pTan2.y.toString());
          tangentLine.style.display = 'block';
        } else {
          tangentLine.style.display = 'none';
        }
      }

      // 5. Líneas Verticales Guía
      const ptA_axis = getCoords(a, 0, def);
      if (lineA) {
        lineA.setAttribute('x1', ptA.x.toString());
        lineA.setAttribute('y1', ptA.y.toString());
        lineA.setAttribute('x2', ptA_axis.x.toString());
        lineA.setAttribute('y2', ptA_axis.y.toString());
      }

      const ptB_axis = getCoords(b, 0, def);
      if (lineB) {
        lineB.setAttribute('x1', ptB.x.toString());
        lineB.setAttribute('y1', ptB.y.toString());
        lineB.setAttribute('x2', ptB_axis.x.toString());
        lineB.setAttribute('y2', ptB_axis.y.toString());
      }

      if (lineC) {
        if (hasC && c !== null) {
          const ptC = getCoords(c, fC, def);
          const ptC_axis = getCoords(c, 0, def);
          lineC.setAttribute('x1', ptC.x.toString());
          lineC.setAttribute('y1', ptC.y.toString());
          lineC.setAttribute('x2', ptC_axis.x.toString());
          lineC.setAttribute('y2', ptC_axis.y.toString());
          lineC.style.display = 'block';
        } else {
          lineC.style.display = 'none';
        }
      }

      // 6. Puntos en PointsLayer
      if (pointsLayer) {
        pointsLayer.innerHTML = '';

        // Punto A
        const circleA = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circleA.setAttribute('cx', ptA.x.toString());
        circleA.setAttribute('cy', ptA.y.toString());
        circleA.setAttribute('r', '6');
        circleA.setAttribute('fill', '#f43f5e');
        circleA.setAttribute('stroke', isLight ? '#ffffff' : '#0f172a');
        circleA.setAttribute('stroke-width', '2');
        pointsLayer.appendChild(circleA);

        // Punto B
        const circleB = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circleB.setAttribute('cx', ptB.x.toString());
        circleB.setAttribute('cy', ptB.y.toString());
        circleB.setAttribute('r', '6');
        circleB.setAttribute('fill', '#f43f5e');
        circleB.setAttribute('stroke', isLight ? '#ffffff' : '#0f172a');
        circleB.setAttribute('stroke-width', '2');
        pointsLayer.appendChild(circleB);

        // Punto C
        if (hasC && c !== null) {
          const ptC = getCoords(c, fC, def);
          const circleC = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          circleC.setAttribute('cx', ptC.x.toString());
          circleC.setAttribute('cy', ptC.y.toString());
          circleC.setAttribute('r', '7.5');
          circleC.setAttribute('fill', '#10b981');
          circleC.setAttribute('stroke', isLight ? '#ffffff' : '#0f172a');
          circleC.setAttribute('stroke-width', '2.5');
          pointsLayer.appendChild(circleC);
        }
      }

      // 7. Actualización de Telemetría
      if (valMsec) valMsec.textContent = mSec.toFixed(5);
      if (valMtan) valMtan.textContent = hasC ? mTan.toFixed(5) : 'No definida';
      if (valCoordC) valCoordC.textContent = hasC && c !== null ? `c = ${c.toFixed(5)}` : 'Inexistente ✗';
      if (valFc) valFc.textContent = hasC ? `f(c) = ${fC.toFixed(5)} ∈ (${a.toFixed(2)}, ${b.toFixed(2)})` : 'Punto anguloso en x = 0';

      const isRolle = Math.abs(fA - fB) < 1e-4;
      if (valRolleCheck) {
        if (isRolle) {
          valRolleCheck.textContent = `f(a) = f(b) = ${fA.toFixed(2)} ✓`;
          valRolleCheck.className = 'm-val text-green';
        } else {
          valRolleCheck.textContent = `f(a) ≠ f(b) (General)`;
          valRolleCheck.className = 'm-val text-amber';
        }
      }
      if (valRolleSub) {
        valRolleSub.textContent = isRolle ? 'Cumple hipótesis de Rolle: m_sec = 0' : 'Aplica caso general de Lagrange';
      }

      if (valDiffAngle) {
        if (hasC) {
          const angSec = Math.atan(mSec) * (180 / Math.PI);
          const angTan = Math.atan(mTan) * (180 / Math.PI);
          const diffAng = Math.abs(angSec - angTan);
          valDiffAngle.textContent = `${diffAng.toFixed(3)}°`;
        } else {
          valDiffAngle.textContent = 'Indeterminada';
        }
      }

      if (valRegularity) {
        if (def.isNonDifferentiable) {
          valRegularity.textContent = 'No derivable en x = 0 ✗';
          valRegularity.className = 'm-val text-red';
        } else {
          valRegularity.textContent = 'Continua y Derivable ✓';
          valRegularity.className = 'm-val text-cyan';
        }
      }

      if (telParallelStatus) {
        if (def.isNonDifferentiable) {
          telParallelStatus.textContent = 'Fallo de Hipótesis: No Derivable';
          telParallelStatus.className = 'tel-status-badge is-error';
        } else {
          telParallelStatus.textContent = 'Paralelismo: 100% ✓';
          telParallelStatus.className = 'tel-status-badge is-success';
        }
      }

      if (telNoteBox) {
        if (def.isNonDifferentiable) {
          telNoteBox.innerHTML = `<strong>Contraejemplo Activo:</strong> La función valor absoluto tiene un punto anguloso en <code class="inline-code">x = 0</code>. Aunque <code class="inline-code">f(-1) = f(1) = 0</code> y la secante es horizontal, <strong>no existe ningún punto con tangente horizontal</strong> ya que <code class="inline-code">f'(x) ∈ &#123;-1, +1&#125;</code>.`;
        } else if (isRolle) {
          telNoteBox.innerHTML = `<strong>Condición de Rolle satisfecha:</strong> Como los extremos tienen la misma altura (<code class="inline-code">f(a) = f(b) = ${fA.toFixed(2)}</code>), la pendiente de la secante es nula y la recta tangente en <code class="inline-code">c</code> es estrictamente horizontal (<code class="inline-code">f'(c) = 0</code>).`;
        } else {
          telNoteBox.innerHTML = `<strong>Teorema de Lagrange en acción:</strong> La secante tiene pendiente oblicua <code class="inline-code">m = ${mSec.toFixed(3)}</code>. En <code class="inline-code">c = ${c !== null ? c.toFixed(3) : ''}</code> la curva tiene exactamente la misma velocidad instantánea que la media global.`;
        }
      }
    }

    function switchCurve(curveKey: string) {
      currentCurveKey = curveKey;
      const def = curves[curveKey];
      if (!def || !sliderA || !sliderB) return;

      sliderA.min = def.minSlider.toString();
      sliderA.max = (def.defaultB - 0.2).toString();
      sliderA.value = def.defaultA.toString();

      sliderB.min = (def.defaultA + 0.2).toString();
      sliderB.max = def.maxSlider.toString();
      sliderB.value = def.defaultB.toString();

      renderLab();
    }

    // Eventos
    sliderA?.addEventListener('input', () => {
      if (sliderB && parseFloat(sliderB.value) <= parseFloat(sliderA.value) + 0.1) {
        sliderB.value = (parseFloat(sliderA.value) + 0.1).toFixed(2);
      }
      renderLab();
    });

    sliderB?.addEventListener('input', () => {
      if (sliderA && parseFloat(sliderA.value) >= parseFloat(sliderB.value) - 0.1) {
        sliderA.value = (parseFloat(sliderB.value) - 0.1).toFixed(2);
      }
      renderLab();
    });

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        switchCurve(btn.dataset.curve || 'cubic');
      });
    });

    // Inicializar laboratorio
    renderLab();

    // Observar cambio de tema (claro / oscuro) para actualizar gráficos SVG al vuelo
    const themeObserver = new MutationObserver(() => {
      renderLab();
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // -------------------------------------------------------------
    // 2. LÓGICA DE AUTOEVALUACIÓN INTERACTIVA
    // -------------------------------------------------------------
    const quizCards = document.querySelectorAll<HTMLElement>('.quiz-card');

    quizCards.forEach((card) => {
      const optBtns = card.querySelectorAll<HTMLButtonElement>('.q-opt-btn');
      const feedback = card.querySelector<HTMLElement>('.q-feedback');

      optBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          optBtns.forEach((b) => {
            b.disabled = true;
            b.classList.remove('is-selected');
          });
          btn.classList.add('is-selected');

          const isCorrect = btn.getAttribute('data-correct') === 'true';

          if (isCorrect) {
            btn.classList.add('is-correct');
            if (feedback) {
              feedback.innerHTML = `
                <div class="fb-badge fb-success">✓ ¡RESPUESTA EXACTA!</div>
                <p>Excelente rigor analítico. Has aplicado con precisión las hipótesis de diferenciabilidad y los teoremas de valor medio.</p>
              `;
              feedback.className = 'q-feedback show success';
            }
          } else {
            btn.classList.add('is-wrong');
            optBtns.forEach((b) => {
              if (b.getAttribute('data-correct') === 'true') {
                b.classList.add('is-correct');
              }
            });
            if (feedback) {
              feedback.innerHTML = `
                <div class="fb-badge fb-error">✗ RESPUESTA INCORRECTA</div>
                <p>Cuidado con la trampa teórica. Revisa la opción correcta señalada en verde y recuerda verificar siempre la derivabilidad en el intervalo abierto.</p>
              `;
              feedback.className = 'q-feedback show error';
            }
          }
        });
      });
    });
  })();
</script>

