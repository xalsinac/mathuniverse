<script>
  // =========================================================================
  // SIMULADOR INTERACTIVO DEL TEOREMA FUNDAMENTAL DEL CÁLCULO
  // =========================================================================

  interface FuncDef {
    f: (t: number) => number;
    F: (x: number) => number; // Primitiva con F(0) = 0
    fPrime: (x: number) => number;
    tMin: number;
    tMax: number;
    yMin: number;
    yMax: number;
    FyMin: number;
    FyMax: number;
    fExpr: string;
    FExpr: string;
  }

  const FUNC_PRESETS: Record<string, FuncDef> = {
    parabola: {
      f: (t) => -Math.pow(t - 1.5, 2) + 3.25,
      F: (x) => -Math.pow(x - 1.5, 3) / 3 + 3.25 * x - (-Math.pow(-1.5, 3) / 3),
      fPrime: (x) => -2 * (x - 1.5),
      tMin: 0,
      tMax: 3,
      yMin: 0,
      yMax: 4.2,
      FyMin: 0,
      FyMax: 8.5,
      fExpr: 'f(t) = -(t - 1.5)² + 3.25',
      FExpr: 'F(x) = ∫₀ˣ f(t)dt',
    },
    seno: {
      f: (t) => Math.sin(t * 1.8) + 1.25,
      F: (x) => (-Math.cos(x * 1.8) + 1) / 1.8 + 1.25 * x,
      fPrime: (x) => 1.8 * Math.cos(x * 1.8),
      tMin: 0,
      tMax: 3,
      yMin: 0,
      yMax: 2.8,
      FyMin: 0,
      FyMax: 6.5,
      fExpr: 'f(t) = sen(1.8t) + 1.25',
      FExpr: 'F(x) = ∫₀ˣ f(t)dt',
    },
    polinomica: {
      f: (t) => 0.35 * Math.pow(t, 3) - 1.4 * t + 2.2,
      F: (x) => 0.35 * Math.pow(x, 4) / 4 - 0.7 * Math.pow(x, 2) + 2.2 * x,
      fPrime: (x) => 1.05 * Math.pow(x, 2) - 1.4,
      tMin: 0,
      tMax: 3,
      yMin: 0,
      yMax: 8.0,
      FyMin: 0,
      FyMax: 13.5,
      fExpr: 'f(t) = 0.35t³ - 1.4t + 2.2',
      FExpr: 'F(x) = ∫₀ˣ f(t)dt',
    },
    exponencial: {
      f: (t) => 0.6 * Math.exp(0.65 * t),
      F: (x) => (0.6 / 0.65) * (Math.exp(0.65 * x) - 1),
      fPrime: (x) => 0.6 * 0.65 * Math.exp(0.65 * x),
      tMin: 0,
      tMax: 3,
      yMin: 0,
      yMax: 4.8,
      FyMin: 0,
      FyMax: 6.5,
      fExpr: 'f(t) = 0.6·e^(0.65t)',
      FExpr: 'F(x) = ∫₀ˣ f(t)dt',
    },
  };

  let currentKey = 'parabola';
  let curX = 1.5;
  let curH = 0.25;

  const svgFt = document.getElementById('svg-ft') as SVGSVGElement | null;
  const svgFx = document.getElementById('svg-fx') as SVGSVGElement | null;
  const sliderX = document.getElementById('slider-x') as HTMLInputElement | null;
  const sliderH = document.getElementById('slider-h') as HTMLInputElement | null;
  const valXDisp = document.getElementById('val-x');
  const valHDisp = document.getElementById('val-h');

  const metricArea = document.getElementById('metric-area');
  const metricSlope = document.getElementById('metric-slope');
  const teleFx = document.getElementById('tele-fx');
  const teleFprime = document.getElementById('tele-fprime');
  const teleQuotient = document.getElementById('tele-quotient');
  const teleError = document.getElementById('tele-error');
  const teleBarrow = document.getElementById('tele-barrow');
  const meterFill = document.getElementById('meter-fill');
  const meterCaption = document.getElementById('meter-caption');

  const W = 580;
  const H = 200;
  const PAD = { top: 20, right: 30, bottom: 35, left: 50 };
  const PLOT_W = W - PAD.left - PAD.right;
  const PLOT_H = H - PAD.top - PAD.bottom;

  function toSvgX(t: number, tMin: number, tMax: number): number {
    return PAD.left + ((t - tMin) / (tMax - tMin)) * PLOT_W;
  }

  function toSvgY(y: number, yMin: number, yMax: number): number {
    return PAD.top + PLOT_H - ((y - yMin) / (yMax - yMin)) * PLOT_H;
  }

  function renderLab() {
    if (!svgFt || !svgFx) return;

    const fn = FUNC_PRESETS[currentKey];
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';

    const axisColor = isLight ? '#94a3b8' : '#475569';
    const textColor = isLight ? '#475569' : '#94a3b8';
    const gridColor = isLight ? 'rgba(0,0,0,0.05)' : 'rgba(255,255,255,0.05)';
    const curveBlue = isLight ? '#0284c7' : '#38bdf8';
    const curveGreen = isLight ? '#059669' : '#10b981';
    const areaFill = isLight ? 'rgba(2, 132, 199, 0.22)' : 'rgba(56, 189, 248, 0.25)';
    const stripFill = isLight ? 'rgba(245, 158, 11, 0.35)' : 'rgba(245, 158, 11, 0.35)';

    const xVal = curX;
    const hVal = curH;
    const fxVal = fn.f(xVal);
    const FxVal = fn.F(xVal);
    const FxhVal = fn.F(xVal + hVal);
    const quotient = (FxhVal - FxVal) / hVal;
    const error = Math.abs(quotient - fxVal);

    // -------------------------------------------------------------
    // GRÁFICO 1: f(t) y ÁREA ACUMULADA
    // -------------------------------------------------------------
    let ftHtml = `
      <defs>
        <linearGradient id="gradArea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="${curveBlue}" stop-opacity="0.45" />
          <stop offset="100%" stop-color="${curveBlue}" stop-opacity="0.05" />
        </linearGradient>
      </defs>
    `;

    // Rejilla y Ejes
    ftHtml += `
      <line x1="${PAD.left}" y1="${toSvgY(0, fn.yMin, fn.yMax)}" x2="${W - PAD.right}" y2="${toSvgY(0, fn.yMin, fn.yMax)}" stroke="${axisColor}" stroke-width="1.8" />
      <line x1="${PAD.left}" y1="${PAD.top}" x2="${PAD.left}" y2="${H - PAD.bottom}" stroke="${axisColor}" stroke-width="1.8" />
      <text x="${W - PAD.right + 8}" y="${toSvgY(0, fn.yMin, fn.yMax) + 4}" font-size="11" fill="${textColor}" font-family="monospace">t</text>
      <text x="${PAD.left - 30}" y="${PAD.top + 8}" font-size="11" fill="${textColor}" font-family="monospace">f(t)</text>
    `;

    // Curva y Área sombreada bajo f(t) hasta x
    const samples = 100;
    let pathD = '';
    let areaD = `M ${toSvgX(0, fn.tMin, fn.tMax)} ${toSvgY(0, fn.yMin, fn.yMax)}`;

    for (let i = 0; i <= samples; i++) {
      const t = fn.tMin + (i / samples) * (fn.tMax - fn.tMin);
      const y = fn.f(t);
      const sx = toSvgX(t, fn.tMin, fn.tMax);
      const sy = toSvgY(y, fn.yMin, fn.yMax);
      pathD += (i === 0 ? 'M' : 'L') + ` ${sx} ${sy}`;
    }

    // Polígono de área sombreada acumulada [0, xVal]
    const areaSamples = 50;
    for (let i = 0; i <= areaSamples; i++) {
      const t = fn.tMin + (i / areaSamples) * (xVal - fn.tMin);
      const y = fn.f(t);
      areaD += ` L ${toSvgX(t, fn.tMin, fn.tMax)} ${toSvgY(y, fn.yMin, fn.yMax)}`;
    }
    areaD += ` L ${toSvgX(xVal, fn.tMin, fn.tMax)} ${toSvgY(0, fn.yMin, fn.yMax)} Z`;

    // Polígono de tira incremental [xVal, xVal + hVal]
    let stripD = `M ${toSvgX(xVal, fn.tMin, fn.tMax)} ${toSvgY(0, fn.yMin, fn.yMax)}`;
    const stripSamples = 20;
    for (let i = 0; i <= stripSamples; i++) {
      const t = xVal + (i / stripSamples) * hVal;
      const y = fn.f(t);
      stripD += ` L ${toSvgX(t, fn.tMin, fn.tMax)} ${toSvgY(y, fn.yMin, fn.yMax)}`;
    }
    stripD += ` L ${toSvgX(xVal + hVal, fn.tMin, fn.tMax)} ${toSvgY(0, fn.yMin, fn.yMax)} Z`;

    ftHtml += `
      <path d="${areaD}" fill="url(#gradArea)" />
      <path d="${stripD}" fill="${stripFill}" stroke="#f59e0b" stroke-width="1.2" stroke-dasharray="3,3" />
      <path d="${pathD}" fill="none" stroke="${curveBlue}" stroke-width="2.6" stroke-linecap="round" />
    `;

    // Línea vertical en x y en x+h
    const sx_val = toSvgX(xVal, fn.tMin, fn.tMax);
    const sy_val = toSvgY(fxVal, fn.yMin, fn.yMax);
    const s_base_y = toSvgY(0, fn.yMin, fn.yMax);

    ftHtml += `
      <line x1="${sx_val}" y1="${s_base_y}" x2="${sx_val}" y2="${sy_val}" stroke="${curveBlue}" stroke-width="2" stroke-dasharray="4,3" />
      <circle cx="${sx_val}" cy="${sy_val}" r="4.5" fill="${curveBlue}" />
      <text x="${sx_val}" y="${s_base_y + 16}" font-size="11" font-weight="700" fill="${curveBlue}" text-anchor="middle" font-family="monospace">x</text>

      <line x1="${toSvgX(xVal + hVal, fn.tMin, fn.tMax)}" y1="${s_base_y}" x2="${toSvgX(xVal + hVal, fn.tMin, fn.tMax)}" y2="${toSvgY(fn.f(xVal + hVal), fn.yMin, fn.yMax)}" stroke="#f59e0b" stroke-width="1.4" stroke-dasharray="3,3" />
      <text x="${toSvgX(xVal + hVal, fn.tMin, fn.tMax)}" y="${s_base_y + 16}" font-size="10" font-weight="600" fill="#f59e0b" text-anchor="middle" font-family="monospace">x+h</text>

      <!-- Etiqueta de altura instantánea f(x) -->
      <line x1="${PAD.left}" y1="${sy_val}" x2="${sx_val}" y2="${sy_val}" stroke="${curveBlue}" stroke-width="1" stroke-dasharray="3,3" opacity="0.6" />
      <text x="${PAD.left - 8}" y="${sy_val + 4}" font-size="10" fill="${curveBlue}" font-weight="700" text-anchor="end" font-family="monospace">f(x)=${fxVal.toFixed(2)}</text>
    `;

    svgFt.innerHTML = ftHtml;

    // -------------------------------------------------------------
    // GRÁFICO 2: F(x) y RECTA TANGENTE CON PENDIENTE f(x)
    // -------------------------------------------------------------
    let fxHtml = '';

    // Ejes
    fxHtml += `
      <line x1="${PAD.left}" y1="${toSvgY(0, fn.FyMin, fn.FyMax)}" x2="${W - PAD.right}" y2="${toSvgY(0, fn.FyMin, fn.FyMax)}" stroke="${axisColor}" stroke-width="1.8" />
      <line x1="${PAD.left}" y1="${PAD.top}" x2="${PAD.left}" y2="${H - PAD.bottom}" stroke="${axisColor}" stroke-width="1.8" />
      <text x="${W - PAD.right + 8}" y="${toSvgY(0, fn.FyMin, fn.FyMax) + 4}" font-size="11" fill="${textColor}" font-family="monospace">x</text>
      <text x="${PAD.left - 30}" y="${PAD.top + 8}" font-size="11" fill="${textColor}" font-family="monospace">F(x)</text>
    `;

    // Curva F(x)
    let pathFD = '';
    for (let i = 0; i <= samples; i++) {
      const x = fn.tMin + (i / samples) * (fn.tMax - fn.tMin);
      const yF = fn.F(x);
      const sx = toSvgX(x, fn.tMin, fn.tMax);
      const sy = toSvgY(yF, fn.FyMin, fn.FyMax);
      pathFD += (i === 0 ? 'M' : 'L') + ` ${sx} ${sy}`;
    }

    fxHtml += `
      <path d="${pathFD}" fill="none" stroke="${curveGreen}" stroke-width="2.6" stroke-linecap="round" />
    `;

    // Punto en F(x)
    const s_Fx_x = toSvgX(xVal, fn.tMin, fn.tMax);
    const s_Fx_y = toSvgY(FxVal, fn.FyMin, fn.FyMax);

    // Recta Tangente en (x, F(x)) con pendiente f(x)
    // Longitud visual en x: deltaX = 0.75
    const dxTangent = 0.65;
    const xTan1 = Math.max(fn.tMin, xVal - dxTangent);
    const xTan2 = Math.min(fn.tMax, xVal + dxTangent);
    const yTan1 = FxVal + fxVal * (xTan1 - xVal);
    const yTan2 = FxVal + fxVal * (xTan2 - xVal);

    const sTanX1 = toSvgX(xTan1, fn.tMin, fn.tMax);
    const sTanY1 = toSvgY(yTan1, fn.FyMin, fn.FyMax);
    const sTanX2 = toSvgX(xTan2, fn.tMin, fn.tMax);
    const sTanY2 = toSvgY(yTan2, fn.FyMin, fn.FyMax);

    // Secante incremental de ancho h: entre (x, F(x)) y (x+h, F(x+h))
    const sSecX2 = toSvgX(xVal + hVal, fn.tMin, fn.tMax);
    const sSecY2 = toSvgY(FxhVal, fn.FyMin, fn.FyMax);

    fxHtml += `
      <!-- Recta Secante Incremental -->
      <line x1="${s_Fx_x}" y1="${s_Fx_y}" x2="${sSecX2}" y2="${sSecY2}" stroke="#f59e0b" stroke-width="2" stroke-dasharray="4,3" />
      <circle cx="${sSecX2}" cy="${sSecY2}" r="3.5" fill="#f59e0b" />

      <!-- Recta Tangente Exacta -->
      <line x1="${sTanX1}" y1="${sTanY1}" x2="${sTanX2}" y2="${sTanY2}" stroke="${curveGreen}" stroke-width="2.8" stroke-linecap="round" />
      <circle cx="${s_Fx_x}" cy="${s_Fx_y}" r="5" fill="${curveGreen}" stroke="#ffffff" stroke-width="1.5" />

      <!-- Línea indicadora vertical -->
      <line x1="${s_Fx_x}" y1="${toSvgY(0, fn.FyMin, fn.FyMax)}" x2="${s_Fx_x}" y2="${s_Fx_y}" stroke="${curveGreen}" stroke-width="1.5" stroke-dasharray="3,3" />
      <text x="${s_Fx_x}" y="${toSvgY(0, fn.FyMin, fn.FyMax) + 16}" font-size="11" font-weight="700" fill="${curveGreen}" text-anchor="middle" font-family="monospace">x</text>

      <text x="${sTanX2 + 8}" y="${sTanY2}" font-size="11" font-weight="700" fill="${curveGreen}" font-family="monospace">m = F'(x) = ${fxVal.toFixed(2)}</text>
    `;

    svgFx.innerHTML = fxHtml;

    // Actualizar Telemetría
    if (metricArea) metricArea.textContent = `Área F(x) = ${FxVal.toFixed(3)}`;
    if (metricSlope) metricSlope.textContent = `Pendiente F'(x) = ${fxVal.toFixed(3)}`;
    if (teleFx) teleFx.textContent = fxVal.toFixed(3);
    if (teleFprime) teleFprime.textContent = fxVal.toFixed(3);
    if (teleQuotient) teleQuotient.textContent = quotient.toFixed(3);
    if (teleError) teleError.textContent = error.toFixed(4);
    if (teleBarrow) teleBarrow.textContent = FxVal.toFixed(3);

    if (valXDisp) valXDisp.textContent = xVal.toFixed(2);
    if (valHDisp) valHDisp.textContent = hVal.toFixed(2);

    if (meterFill) {
      // 0 error = 100% convergencia
      const pct = Math.max(0, Math.min(100, (1 - error / 0.5) * 100));
      meterFill.style.width = `${pct}%`;
    }
  }

  // Event Listeners
  if (sliderX) {
    sliderX.addEventListener('input', (e) => {
      curX = parseFloat((e.target as HTMLInputElement).value);
      renderLab();
    });
  }

  if (sliderH) {
    sliderH.addEventListener('input', (e) => {
      curH = parseFloat((e.target as HTMLInputElement).value);
      renderLab();
    });
  }

  const presetBtns = document.querySelectorAll<HTMLButtonElement>('.preset-btn');
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const funcKey = btn.dataset.func;
      if (funcKey && FUNC_PRESETS[funcKey]) {
        currentKey = funcKey;
        renderLab();
      }
    });
  });

  // Escuchar cambios de tema (Modo Claro / Modo Oscuro)
  const themeObserver = new MutationObserver(() => {
    renderLab();
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // Inicializar simulación
  renderLab();

  // =========================================================================
  // SISTEMA DE AUTOEVALUACIÓN CONCEPTUAL (QUIZ)
  // =========================================================================
  const quizCards = document.querySelectorAll<HTMLElement>('.quiz-card');
  const FEEDBACK_MSGS: Record<string, { correct: string; incorrect: string }> = {
    '1': {
      correct: '¡Exacto! Por la regla de Leibniz, G\'(x) = f(x²) · (x²)\' = ln(1 + x²) · 2x. Evaluando en x = 1: G\'(1) = ln(2) · 2 = 2·ln(2).',
      incorrect: 'Incorrecto. No olvides aplicar la regla de la cadena: la derivada del límite superior x² es 2x. G\'(x) = ln(1 + x²) · 2x.',
    },
    '2': {
      correct: '¡Brillante! La función f(x) = 1/x tiene una discontinuidad asintótica en x = 0, que cae de lleno en el intervalo [-2, 2]. Al no ser continua, la Regla de Barrow es inaplicable.',
      incorrect: 'Incorrecto. La razón es analítica estricta: Barrow exige como hipótesis innegociable que la función sea continua en todo el intervalo cerrado. En x = 0, f(x) diverge.',
    },
    '3': {
      correct: '¡Correcto! Por el TFC 1, F\'(x) = f(x). Si la primera derivada de F(x) es estrictamente positiva (F\'(x) > 0), el criterio de la primera derivada garantiza que F(x) es estrictamente creciente.',
      incorrect: 'Incorrecto. Recuerda que la derivada de F(x) es f(x). Si F\'(x) > 0, la función F es creciente. La concavidad dependería de la segunda derivada F\'\'(x) = f\'(x).',
    },
    '4': {
      correct: '¡Impecable! Por las propiedades de la integral definida, invertir los límites cambia el signo: F(x) = -∫₂ˣ t³ dt. Derivando con el TFC 1: F\'(x) = -x³.',
      incorrect: 'Incorrecto. Como la variable x está en el límite inferior, F(x) = -∫₂ˣ t³ dt. Por tanto su derivada es -x³.',
    },
  };

  quizCards.forEach((card) => {
    const qId = card.dataset.q || '';
    const btns = card.querySelectorAll<HTMLButtonElement>('.q-opt-btn');
    const fbBox = card.querySelector<HTMLElement>('.q-feedback');
    const fbText = card.querySelector<HTMLElement>('.fb-text');

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isCorrect = btn.dataset.correct === 'true';

        btns.forEach((b) => {
          b.disabled = true;
          if (b.dataset.correct === 'true') {
            b.classList.add('is-right');
          } else if (b === btn) {
            b.classList.add('is-wrong');
          }
        });

        if (fbBox && fbText) {
          fbBox.classList.remove('hidden', 'success', 'failure');
          fbBox.classList.add(isCorrect ? 'success' : 'failure');
          fbText.textContent = isCorrect ? FEEDBACK_MSGS[qId]?.correct : FEEDBACK_MSGS[qId]?.incorrect;
        }
      });
    });
  });
</script>

