  .const-glyph {
    display: block;
    font-size: 1.8rem;
    font-weight: 800;
    font-family: serif;
    margin-bottom: 0.4rem;
    line-height: 1;
  }

  .const-glyph.gold { color: #fbbf24; }
  .const-glyph.cyan { color: #38bdf8; }
  .const-glyph.purple { color: #c084fc; }
  .const-glyph.emerald { color: #34d399; }
