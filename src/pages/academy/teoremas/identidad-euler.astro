<script>
  // =========================================================================
  // LABORATORIO INTERACTIVO: EL FASOR DINÁMICO DE EULER
  // =========================================================================

  let curTheta = Math.PI; // Iniciar en pi

  const sliderTheta = document.getElementById('slider-angle-theta') as HTMLInputElement | null;
  const dispTheta = document.getElementById('disp-angle-theta');
  const svgEl = document.getElementById('svg-euler') as SVGSVGElement | null;

  const eulerStatus = document.getElementById('lab-euler-status');
  const teleStatus = document.getElementById('tele-status');
  const teleValCos = document.getElementById('tele-val-cos');
  const teleValSin = document.getElementById('tele-val-sin');
  const teleValPhasor = document.getElementById('tele-val-phasor');
  const teleSubPhasor = document.getElementById('tele-sub-phasor');

  function updateEulerLab() {
    const theta = curTheta;
    const cosVal = Math.cos(theta);
    const sinVal = Math.sin(theta);

    const deg = Math.round((theta * 180) / Math.PI);

    if (dispTheta) {
      if (Math.abs(theta - Math.PI) < 0.03) {
        dispTheta.textContent = `3.14 rad (θ = π)`;
      } else if (Math.abs(theta - Math.PI / 2) < 0.03) {
        dispTheta.textContent = `1.57 rad (θ = π/2)`;
      } else if (Math.abs(theta - 2 * Math.PI) < 0.03) {
        dispTheta.textContent = `6.28 rad (θ = 2π)`;
      } else {
        dispTheta.textContent = `${theta.toFixed(2)} rad (${deg}°)`;
      }
    }

    if (teleStatus) teleStatus.textContent = `θ = ${deg}° (${(theta / Math.PI).toFixed(2)}π)`;

    if (teleValCos) teleValCos.textContent = cosVal.toFixed(4);
    if (teleValSin) teleValSin.textContent = sinVal.toFixed(4);

    const signIm = sinVal >= 0 ? '+' : '-';
    const absIm = Math.abs(sinVal).toFixed(4);
    if (teleValPhasor) {
      teleValPhasor.textContent = `${cosVal.toFixed(4)} ${signIm} ${absIm} i`;
    }

    const isEulerIdentity = Math.abs(theta - Math.PI) < 0.05;

    if (eulerStatus) {
      if (isEulerIdentity) {
        eulerStatus.textContent = '¡IDENTIDAD DE EULER: e^(iπ) + 1 = 0!';
        eulerStatus.className = 'graph-metric is-euler';
      } else {
        eulerStatus.textContent = `e^(iθ) = cos(θ) + i·sin(θ)`;
        eulerStatus.className = 'graph-metric';
      }
    }

    if (teleSubPhasor) {
      if (isEulerIdentity) {
        teleSubPhasor.innerHTML = '<strong>e<sup>iπ</sup> = -1 ⟹ e<sup>iπ</sup> + 1 = 0</strong> (¡Identidad Cumbre!)';
      } else {
        teleSubPhasor.innerHTML = `Fasor unitario girado ${deg}° en sentido antihorario.`;
      }
    }

    renderEulerSVG(theta, cosVal, sinVal, isEulerIdentity);
  }

  function renderEulerSVG(theta: number, cosVal: number, sinVal: number, isIdentity: boolean) {
    if (!svgEl) return;

    const isLight = document.documentElement.getAttribute('data-theme') === 'light';

    const W = 540;
    const H = 320;
    const cx = W / 2;
    const cy = H / 2;
    const R = 110; // Radio del círculo unitario en píxeles

    const axisColor = isLight ? 'rgba(0,0,0,0.18)' : 'rgba(255,255,255,0.18)';
    const circleColor = isLight ? 'rgba(0,0,0,0.12)' : 'rgba(255,255,255,0.15)';
    const textColor = isLight ? '#475569' : '#94a3b8';

    // Extremo del fasor:
    // x va hacia la derecha, y va hacia arriba (en pantalla hacia abajo: cy - sinVal * R)
    const px = cx + cosVal * R;
    const py = cy - sinVal * R;

    // Arco de barrido del ángulo theta
    const arcRadius = 32;
    const largeArc = theta > Math.PI ? 1 : 0;
    const arcEndX = cx + arcRadius * Math.cos(theta);
    const arcEndY = cy - arcRadius * Math.sin(theta);
    const arcPath = `M ${cx + arcRadius} ${cy} A ${arcRadius} ${arcRadius} 0 ${largeArc} 0 ${arcEndX} ${arcEndY}`;

    svgEl.innerHTML = `
      <!-- Ejes Re e Im -->
      <line x1="40" y1="${cy}" x2="${W - 40}" y2="${cy}" stroke="${axisColor}" stroke-width="1.5" />
      <line x1="${cx}" y1="30" x2="${cx}" y2="${H - 30}" stroke="${axisColor}" stroke-width="1.5" />
      <text x="${W - 35}" y="${cy - 8}" fill="${textColor}" font-size="11" font-family="'JetBrains Mono', monospace">Re</text>
      <text x="${cx + 8}" y="42" fill="${textColor}" font-size="11" font-family="'JetBrains Mono', monospace">Im</text>

      <!-- Círculo unitario |z| = 1 -->
      <circle cx="${cx}" cy="${cy}" r="${R}" fill="none" stroke="${circleColor}" stroke-width="1.5" stroke-dasharray="4 3" />
      <text x="${cx + R + 6}" y="${cy + 16}" fill="${textColor}" font-size="10" font-family="monospace">+1</text>
      <text x="${cx - R - 20}" y="${cy + 16}" fill="${isIdentity ? '#fbbf24' : textColor}" font-size="${isIdentity ? '12' : '10'}" font-weight="${isIdentity ? 'bold' : 'normal'}" font-family="monospace">-1</text>
      <text x="${cx + 8}" y="${cy - R + 4}" fill="${textColor}" font-size="10" font-family="monospace">+i</text>
      <text x="${cx + 8}" y="${cy + R + 14}" fill="${textColor}" font-size="10" font-family="monospace">-i</text>

      <!-- Triángulo rectángulo auxiliar de descomposición -->
      <!-- Cateto real horizontal (oro) -->
      <line x1="${cx}" y1="${cy}" x2="${px}" y2="${cy}" stroke="#fbbf24" stroke-width="2.5" />
      <!-- Cateto imaginario vertical (cian) -->
      <line x1="${px}" y1="${cy}" x2="${px}" y2="${py}" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="3 2" />

      <!-- Arco de ángulo θ -->
      <path d="${arcPath}" fill="none" stroke="#fbbf24" stroke-width="2" />
      <text x="${cx + 40}" y="${cy - 12}" fill="#fbbf24" font-size="11" font-weight="bold" font-family="monospace">θ</text>

      <!-- Fasor vector complejo e^(iθ) desde el origen hasta (px, py) -->
      <line x1="${cx}" y1="${cy}" x2="${px}" y2="${py}" stroke="${isIdentity ? '#10b981' : '#f8fafc'}" stroke-width="${isIdentity ? '3.5' : '2.5'}" />
      
      <!-- Punto en la punta del vector -->
      <circle cx="${px}" cy="${py}" r="${isIdentity ? '7' : '5'}" fill="${isIdentity ? '#10b981' : '#38bdf8'}" stroke="#f8fafc" stroke-width="2" />

      <!-- Etiqueta del fasor rotando -->
      <text x="${px + (cosVal >= 0 ? 10 : -75)}" y="${py + (sinVal >= 0 ? -10 : 18)}" fill="${isIdentity ? '#10b981' : '#f8fafc'}" font-size="12" font-weight="bold" font-family="'JetBrains Mono', monospace">
        e<sup>iθ</sup>
      </text>
    `;
  }

  // Slider de ángulo
  if (sliderTheta) {
    sliderTheta.addEventListener('input', (e) => {
      curTheta = parseFloat((e.target as HTMLInputElement).value);
      updateEulerLab();
    });
  }

  // Presets
  const presetBtns = document.querySelectorAll('.lab-preset-bar .preset-btn');
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const ang = parseFloat(btn.getAttribute('data-angle') || '3.141593');
      curTheta = ang;
      if (sliderTheta) sliderTheta.value = String(ang);
      updateEulerLab();
    });
  });

  // Inicializar simulación
  updateEulerLab();

  // Observador de cambio de tema claro / oscuro
  const themeObserver = new MutationObserver(() => {
    updateEulerLab();
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // =========================================================================
  // SISTEMA INTERACTIVO DE AUTOEVALUACIÓN (QUIZ)
  // =========================================================================
  const quizCards = document.querySelectorAll('.quiz-card');
  quizCards.forEach((card) => {
    const buttons = card.querySelectorAll<HTMLButtonElement>('.q-opt-btn');
    const feedback = card.querySelector<HTMLDivElement>('.q-feedback');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.disabled = true;
          if (b.getAttribute('data-correct') === 'true') {
            b.classList.add('is-correct');
          }
        });

        const isCorrect = btn.getAttribute('data-correct') === 'true';
        if (!isCorrect) {
          btn.classList.add('is-wrong');
        }

        if (feedback) {
          feedback.style.display = 'block';
          feedback.className = `q-feedback ${isCorrect ? 'feedback-correct' : 'feedback-wrong'}`;
          feedback.innerHTML = isCorrect
            ? '<strong>✓ ¡Correcto!</strong> ' + getQuizExplanation(card.getAttribute('data-q') || '1')
            : '<strong>✕ Incorrecto.</strong> ' + getQuizExplanation(card.getAttribute('data-q') || '1');
        }
      });
    });
  });

  function getQuizExplanation(qId: string): string {
    switch (qId) {
      case '1':
        return 'Al calcular las potencias de i (i, -1, -i, 1), los términos pares se vuelven reales alternando signos (+1, -θ²/2!, +θ⁴/4!, ...) reproduciendo la serie de cos(θ), y los impares conservan el factor i (iθ, -iθ³/3!, ...) igualando a i·sin(θ).';
      case '2':
        return 'Multiplicar por e^(iπ/2) = i rota cualquier vector complejo 90° en sentido antihorario sin modificar su longitud (isometría rígida del plano complejo).';
      case '3':
        return 'Escribiendo la base en forma polar i = e^(iπ/2), al elevar a la potencia i multiplicamos los exponentes: i · (iπ/2) = i²·(π/2) = -π/2. El resultado es el número puramente real e^(-π/2) ≈ 0.20788.';
      case '4':
        return 'Derivando f(θ) = cos(θ) + i·sin(θ) se obtiene -sin(θ) + i·cos(θ) = i·(cos θ + i·sin θ) = i·f(θ). Por unicidad de ecuaciones diferenciales, f(θ) debe ser la función exponencial e^(iθ).';
      default:
        return '¡Excelente razonamiento!';
    }
  }
</script>

<style>
