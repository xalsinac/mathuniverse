    if (wireframeCheck) {
      wireframeCheck.addEventListener('change', (e) => {
        wireframeOnly = (e.target as HTMLInputElement).checked;
      });
    }

    const autorotateCheck = document.getElementById('toggle-autorotate') as HTMLInputElement | null;
    if (autorotateCheck) {
      autorotateCheck.addEventListener('change', (e) => {
        autoRotate = (e.target as HTMLInputElement).checked;
      });
    }

    // Eventos de ratón y táctil para rotar en 3D
    canvas.addEventListener('mousedown', (e) => {
      isDragging = true;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - lastMouseX;
      const dy = e.clientY - lastMouseY;
      rotY += dx * 0.01;
      rotX += dy * 0.01;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        lastMouseX = e.touches[0].clientX;
        lastMouseY = e.touches[0].clientY;
      }
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (!isDragging || e.touches.length !== 1) return;
      const dx = e.touches[0].clientX - lastMouseX;
      const dy = e.touches[0].clientY - lastMouseY;
      rotY += dx * 0.01;
      rotX += dy * 0.01;
      lastMouseX = e.touches[0].clientX;
      lastMouseY = e.touches[0].clientY;
    }, { passive: true });

    window.addEventListener('touchend', () => {
      isDragging = false;
    });

    // Render loop 3D
    function render() {
      if (!ctx || !canvas) return;

      const width = canvas.width;
      const height = canvas.height;
      const cx = width / 2;
      const cy = height / 2;
      const scale = 110;

      if (autoRotate && !isDragging) {
        rotY += 0.007;
        rotX += 0.003;
      }

      ctx.clearRect(0, 0, width, height);

      const m = models[activeSolidKey];
      if (!m) return;

      // Transformar y proyectar vértices
      const cosX = Math.cos(rotX);
      const sinX = Math.sin(rotX);
      const cosY = Math.cos(rotY);
      const sinY = Math.sin(rotY);

      const projected = m.vertices.map(([vx, vy, vz]) => {
        // Rotación alrededor de Y
        const x1 = vx * cosY + vz * sinY;
        const y1 = vy;
        const z1 = -vx * sinY + vz * cosY;

        // Rotación alrededor de X
        const x2 = x1;
        const y2 = y1 * cosX - z1 * sinX;
        const z2 = y1 * sinX + z1 * cosX;

        // Proyección en perspectiva suave
        const fov = 4.5;
        const pz = z2 + fov;
        const px = cx + (x2 / pz) * scale * 2.8;
        const py = cy - (y2 / pz) * scale * 2.8;

        return { px, py, z: z2 };
      });

      // Dibujar caras o aristas
      if (!wireframeOnly) {
        // Ordenar caras de atrás hacia adelante (algoritmo del pintor)
        const sortedFaces = m.faces.map((faceIndices) => {
          let sumZ = 0;
          faceIndices.forEach((idx) => {
            if (projected[idx]) sumZ += projected[idx].z;
          });
          const avgZ = sumZ / faceIndices.length;
          return { faceIndices, avgZ };
        }).sort((a, b) => a.avgZ - b.avgZ);

        sortedFaces.forEach(({ faceIndices, avgZ }) => {
          if (faceIndices.length < 3) return;

          ctx.beginPath();
          const first = projected[faceIndices[0]];
          if (!first) return;
          ctx.moveTo(first.px, first.py);

          for (let i = 1; i < faceIndices.length; i++) {
            const p = projected[faceIndices[i]];
            if (p) ctx.lineTo(p.px, p.py);
          }
          ctx.closePath();

          // Iluminación básica según profundidad Z
          const normZ = Math.max(0, Math.min(1, (avgZ + 2.5) / 5));
          const alpha = 0.25 + normZ * 0.45;

          if (m.genus === 1) {
            ctx.fillStyle = `rgba(244, 63, 94, ${alpha})`; // Tono magenta/coral para el toroide
            ctx.strokeStyle = '#fda4af';
          } else {
            ctx.fillStyle = `rgba(14, 165, 233, ${alpha})`; // Tono cyan/azul para los convexos
            ctx.strokeStyle = '#7dd3fc';
          }

          ctx.fill();
          ctx.lineWidth = 1.5;
          ctx.stroke();
        });
      } else {
        // Modo Alambre Puro: dibujar aristas
        ctx.strokeStyle = m.genus === 1 ? '#fb7185' : '#38bdf8';
        ctx.lineWidth = 1.8;

        m.faces.forEach((faceIndices) => {
          for (let i = 0; i < faceIndices.length; i++) {
            const nextIdx = (i + 1) % faceIndices.length;
            const p1 = projected[faceIndices[i]];
            const p2 = projected[faceIndices[nextIdx]];
            if (p1 && p2) {
              ctx.beginPath();
              ctx.moveTo(p1.px, p1.py);
              ctx.lineTo(p2.px, p2.py);
              ctx.stroke();
            }
          }
        });
      }

      // Dibujar vértices destacados
      projected.forEach(({ px, py }) => {
        ctx.beginPath();
        ctx.arc(px, py, 4, 0, Math.PI * 2);
        ctx.fillStyle = '#fbbf24'; // Oro
        ctx.fill();
        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = 1.2;
        ctx.stroke();
      });

      requestAnimationFrame(render);
    }

    updateMetricPanel(models[activeSolidKey]);
    requestAnimationFrame(render);

    // =========================================================================
    // 2. SISTEMA DE AUTOEVALUACIÓN INTERACTIVO
    // =========================================================================
    const quizCards = document.querySelectorAll<HTMLElement>('.quiz-question-card');
    quizCards.forEach((card) => {
      const optButtons = card.querySelectorAll<HTMLButtonElement>('.q-opt-btn');
      const feedbackEl = card.querySelector<HTMLElement>('.q-feedback');

      optButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isCorrect = btn.dataset.correct === 'true';

          optButtons.forEach((b) => {
            b.disabled = true;
            if (b.dataset.correct === 'true') {
              b.classList.add('is-right');
            } else if (b === btn && !isCorrect) {
              b.classList.add('is-wrong');
            }
          });

          if (feedbackEl) {
            feedbackEl.style.display = 'block';
            if (isCorrect) {
              feedbackEl.className = 'q-feedback is-correct';
              feedbackEl.innerHTML = '<strong>Respuesta Correcta.</strong> Has aplicado con precisión el invariante topológico de Euler y las propiedades algebraicas deducidas.';
            } else {
              feedbackEl.className = 'q-feedback is-incorrect';
              feedbackEl.innerHTML = '<strong>Respuesta Incorrecta.</strong> Revisa cómo la cantidad de elementos o el género de la superficie imponen la suma estricta de Euler.';
            }
          }
        });
      });
    });
  })();
</script>

