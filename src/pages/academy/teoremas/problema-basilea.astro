    border: 1px solid rgba(148, 163, 184, 0.22);
    padding: 0.1rem 0.42rem;
    border-radius: 5px;
    color: #e2e8f0;
  }

  .basel-monument-card {
    background: linear-gradient(145deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.72));
    border: 1px solid rgba(56, 189, 248, 0.28);
    border-radius: 16px;
