    line-height: 1.55;
  }

  .quiz-feedback.ok {
    background: rgba(52, 211, 153, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.35);
    color: #a7f3d0;
  }

  .quiz-feedback.err {
    background: rgba(248, 113, 113, 0.12);
    border: 1px solid rgba(248, 113, 113, 0.35);
    color: #fecaca;
  }
</style>

<script>
  // --- EXPERIMENTO 1: SUMAS PARCIALES ---
  const PI2_6 = (Math.PI * Math.PI) / 6;
  const slN = document.getElementById('sl-basel-n') as HTMLInputElement | null;
  const valN = document.getElementById('val-basel-n');
  const metricSn = document.getElementById('metric-sn');
  const metricErr = document.getElementById('metric-err');
  const metricTerm = document.getElementById('metric-term');
  const quickBtns = document.querySelectorAll<HTMLButtonElement>('.quick-btn');
  const canvasSums = document.getElementById('canvas-partial-sums') as HTMLCanvasElement | null;

  function computePartialSums(maxN: number): number[] {
    const sums: number[] = new Array(maxN + 1);
    sums[0] = 0;
    for (let k = 1; k <= maxN; k++) {
      sums[k] = sums[k - 1] + 1 / (k * k);
    }
    return sums;
  }

  function drawPartialSums(n: number) {
    if (!canvasSums) return;
    const ctx = canvasSums.getContext('2d');
    if (!ctx) return;

    const w = canvasSums.width;
    const h = canvasSums.height;
    ctx.clearRect(0, 0, w, h);

    const padL = 62;
    const padR = 28;
    const padT = 28;
    const padB = 42;
    const plotW = w - padL - padR;
    const plotH = h - padT - padB;

    const yMin = 0.8;
    const yMax = 1.75;
    const toX = (k: number) => padL + ((k - 1) / Math.max(1, n - 1)) * plotW;
    const toY = (y: number) => padT + ((yMax - y) / (yMax - yMin)) * plotH;

    // Grid horizontal
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.14)';
    ctx.lineWidth = 1;
    ctx.font = '12px JetBrains Mono, monospace';
    ctx.fillStyle = '#94a3b8';

    for (let y = 0.8; y <= 1.71; y += 0.2) {
      const py = toY(y);
      ctx.beginPath();
      ctx.moveTo(padL, py);
      ctx.lineTo(w - padR, py);
      ctx.stroke();
      ctx.fillText(y.toFixed(1), 16, py + 4);
    }

    // Línea objetivo π²/6
    const yTarget = toY(PI2_6);
    ctx.save();
    ctx.setLineDash([7, 5]);
    ctx.strokeStyle = '#34d399';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(padL, yTarget);
    ctx.lineTo(w - padR, yTarget);
    ctx.stroke();
    ctx.restore();

    ctx.fillStyle = '#34d399';
    ctx.font = 'bold 12px JetBrains Mono, monospace';
    ctx.fillText('π²/6 ≈ 1.644934', w - padR - 135, yTarget - 8);

    const sums = computePartialSums(n);

    // Área bajo la curva
    ctx.beginPath();
    if (n === 1) {
      ctx.arc(padL + plotW * 0.5, toY(sums[1]), 6, 0, Math.PI * 2);
      ctx.fillStyle = '#38bdf8';
      ctx.fill();
    } else {
      ctx.moveTo(toX(1), toY(yMin));
      for (let k = 1; k <= n; k++) {
        ctx.lineTo(toX(k), toY(sums[k]));
      }
      ctx.lineTo(toX(n), toY(yMin));
      ctx.closePath();
      const grad = ctx.createLinearGradient(0, padT, 0, h - padB);
      grad.addColorStop(0, 'rgba(56, 189, 248, 0.32)');
      grad.addColorStop(1, 'rgba(56, 189, 248, 0.02)');
      ctx.fillStyle = grad;
      ctx.fill();

      // Curva S_k
      ctx.beginPath();
      for (let k = 1; k <= n; k++) {
        const px = toX(k);
        const py = toY(sums[k]);
        if (k === 1) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      // Punto final
      const lastX = toX(n);
      const lastY = toY(sums[n]);
      ctx.beginPath();
      ctx.arc(lastX, lastY, 5, 0, Math.PI * 2);
      ctx.fillStyle = '#f8fafc';
      ctx.fill();
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    // Eje X etiquetas
    ctx.fillStyle = '#94a3b8';
    ctx.font = '12px JetBrains Mono, monospace';
    ctx.fillText('k = 1', padL, h - 14);
    ctx.fillText(`k = ${n}`, w - padR - 55, h - 14);

    // Actualizar métricas
    const sn = sums[n];
    const err = PI2_6 - sn;
    const term = 1 / (n * n);
    if (valN) valN.textContent = String(n);
    if (metricSn) metricSn.textContent = sn.toFixed(6);
    if (metricErr) metricErr.textContent = err.toFixed(6);
    if (metricTerm) metricTerm.textContent = term.toFixed(6);
  }

  if (slN) {
    slN.addEventListener('input', () => {
      const n = Number(slN.value);
      quickBtns.forEach((b) => b.classList.toggle('active', Number(b.dataset.n) === n));
      drawPartialSums(n);
    });
  }

  quickBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const n = Number(btn.dataset.n || '40');
      if (slN) slN.value = String(n);
      quickBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      drawPartialSums(n);
    });
  });

  drawPartialSums(40);

  // --- EXPERIMENTO 2: SIN(X)/X VS TAYLOR Y PRODUCTO DE EULER ---
  const slK = document.getElementById('sl-taylor-k') as HTMLInputElement | null;
  const slM = document.getElementById('sl-euler-m') as HTMLInputElement | null;
  const valK = document.getElementById('val-taylor-k');
  const valM = document.getElementById('val-euler-m');
  const chkTaylor = document.getElementById('chk-show-taylor') as HTMLInputElement | null;
  const chkProduct = document.getElementById('chk-show-product') as HTMLInputElement | null;
  const canvasSinc = document.getElementById('canvas-sinc-zeros') as HTMLCanvasElement | null;

  function sinc(x: number): number {
    if (Math.abs(x) < 1e-6) return 1 - (x * x) / 6;
    return Math.sin(x) / x;
  }

  function taylorSinc(x: number, kMax: number): number {
    let sum = 1;
    let term = 1;
    for (let k = 1; k <= kMax; k++) {
      term *= -(x * x) / ((2 * k) * (2 * k + 1));
      sum += term;
    }
    return sum;
  }

  function eulerProductSinc(x: number, mMax: number): number {
    let prod = 1;
    const pi2 = Math.PI * Math.PI;
    for (let n = 1; n <= mMax; n++) {
      prod *= 1 - (x * x) / (n * n * pi2);
    }
    return prod;
  }

  function drawSincScene() {
    if (!canvasSinc) return;
    const ctx = canvasSinc.getContext('2d');
    if (!ctx) return;

    const kMax = slK ? Number(slK.value) : 3;
    const mMax = slM ? Number(slM.value) : 3;
    const showTaylor = chkTaylor ? chkTaylor.checked : true;
    const showProduct = chkProduct ? chkProduct.checked : true;

    if (valK) valK.textContent = `x^${2 * kMax} (K=${kMax})`;
    if (valM) valM.textContent = `M = ${mMax} (ceros ±π … ±${mMax}π)`;

    const w = canvasSinc.width;
    const h = canvasSinc.height;
    ctx.clearRect(0, 0, w, h);

    const padL = 52;
    const padR = 24;
    const padT = 24;
    const padB = 38;
    const plotW = w - padL - padR;
    const plotH = h - padT - padB;

    const xMin = -3.6 * Math.PI;
    const xMax = 3.6 * Math.PI;
    const yMin = -0.6;
    const yMax = 1.25;

    const toX = (x: number) => padL + ((x - xMin) / (xMax - xMin)) * plotW;
    const toY = (y: number) => padT + ((yMax - y) / (yMax - yMin)) * plotH;

    // Eje Y=0 y X=0
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(padL, toY(0));
    ctx.lineTo(w - padR, toY(0));
    ctx.moveTo(toX(0), padT);
    ctx.lineTo(toX(0), h - padB);
    ctx.stroke();

    // Etiquetas de múltiplos de π
    ctx.fillStyle = '#94a3b8';
    ctx.font = '12px JetBrains Mono, monospace';
    for (let m = -3; m <= 3; m++) {
      if (m === 0) continue;
      const px = toX(m * Math.PI);
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.1)';
      ctx.beginPath();
      ctx.moveTo(px, padT);
      ctx.lineTo(px, h - padB);
      ctx.stroke();
      const label = m === 1 ? 'π' : m === -1 ? '-π' : `${m}π`;
      ctx.fillText(label, px - 10, h - 12);
    }

    const plotCurve = (fn: (x: number) => number, color: string, width: number, dashed = false) => {
      ctx.save();
      if (dashed) ctx.setLineDash([6, 4]);
      ctx.strokeStyle = color;
      ctx.lineWidth = width;
      ctx.beginPath();
      let started = false;
      const steps = 420;
      for (let i = 0; i <= steps; i++) {
        const x = xMin + (i / steps) * (xMax - xMin);
        const y = fn(x);
        if (y < yMin - 0.5 || y > yMax + 0.5) {
          started = false;
          continue;
        }
        const px = toX(x);
        const py = toY(y);
        if (!started) {
          ctx.moveTo(px, py);
          started = true;
        } else {
          ctx.lineTo(px, py);
        }
      }
      ctx.stroke();
      ctx.restore();
    };

    // 1. Producto de Euler
    if (showProduct) {
      plotCurve((x) => eulerProductSinc(x, mMax), '#c084fc', 2.2, true);
    }

    // 2. Polinomio de Taylor
    if (showTaylor) {
      plotCurve((x) => taylorSinc(x, kMax), '#38bdf8', 2.2, false);
    }

    // 3. Curva real sin(x)/x
    plotCurve(sinc, '#34d399', 2.8, false);

    // Puntos en los ceros de sin(x)/x
    for (let m = -3; m <= 3; m++) {
      if (m === 0) continue;
      const px = toX(m * Math.PI);
      const py = toY(0);
      ctx.beginPath();
      ctx.arc(px, py, 4.5, 0, Math.PI * 2);
      ctx.fillStyle = '#34d399';
      ctx.fill();
    }

    // Leyenda superior izquierda
    ctx.font = '12px JetBrains Mono, monospace';
    ctx.fillStyle = '#34d399';
    ctx.fillText('— sin(x)/x (real)', padL + 10, padT + 14);
    if (showTaylor) {
      ctx.fillStyle = '#38bdf8';
      ctx.fillText(`— Taylor grado ${2 * kMax}`, padL + 165, padT + 14);
    }
    if (showProduct) {
      ctx.fillStyle = '#c084fc';
      ctx.fillText(`-- Producto M=${mMax}`, padL + 330, padT + 14);
    }
  }

  slK?.addEventListener('input', drawSincScene);
  slM?.addEventListener('input', drawSincScene);
  chkTaylor?.addEventListener('change', drawSincScene);
  chkProduct?.addEventListener('change', drawSincScene);
  drawSincScene();

  // --- QUIZ ---
  const explanations: Record<string, { ok: string; err: string }> = {
    p1: {
      ok: 'Correcto. La suma de los pares es 1/2² + 1/4² + 1/6² + … = (1/4)·(1 + 1/2² + 1/3² + …) = (1/4)·(π²/6) = π²/24. Al restarla del total: π²/6 − π²/24 = 3π²/24 = π²/8.',
      err: 'Pista: separa la serie total en pares e impares. La suma de los inversos de los cuadrados pares es exactamente 1/4 del total (π²/24).'
    },
    p2: {
      ok: 'Exacto. Al dividir sin(x) = x − x³/3! + x⁵/5! − … entre x, el segundo término pasa a ser −x²/3! = −x²/6. Al igualar −1/6 con −(1/π²)∑(1/n²) aparece directamente π²/6.',
      err: 'Revisa el Paso 1 y el Paso 3: sin(x) tiene término cúbico −x³/3! = −x³/6, que al dividir por x se convierte en −x²/6.'
    }
  };

  document.querySelectorAll<HTMLButtonElement>('.quiz-opt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = btn.dataset.q || '';
      const isCorrect = btn.dataset.correct === 'true';
      const siblings = document.querySelectorAll<HTMLButtonElement>(`.quiz-opt[data-q="${q}"]`);
      siblings.forEach((s) => s.classList.remove('correct', 'wrong'));
      btn.classList.add(isCorrect ? 'correct' : 'wrong');

      const fb = document.getElementById(`fb-${q}`);
      if (fb && explanations[q]) {
        fb.hidden = false;
        fb.className = `quiz-feedback ${isCorrect ? 'ok' : 'err'}`;
        fb.textContent = isCorrect ? explanations[q].ok : explanations[q].err;
      }
    });
  });
</script>
