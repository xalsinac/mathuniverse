<script>
  // =========================================================================
  // LABORATORIO INTERACTIVO: SIMULADOR DINÁMICO DE PITÁGORAS
  // =========================================================================

  let curA = 3;
  let curB = 4;

  const sliderA = document.getElementById('slider-cat-a') as HTMLInputElement | null;
  const sliderB = document.getElementById('slider-cat-b') as HTMLInputElement | null;
  const dispA = document.getElementById('disp-cat-a');
  const dispB = document.getElementById('disp-cat-b');

  const svgEl = document.getElementById('svg-pitagoras') as SVGSVGElement | null;
  const tripleStatus = document.getElementById('lab-triple-status');

  const teleValA2 = document.getElementById('tele-val-a2');
  const teleValB2 = document.getElementById('tele-val-b2');
  const teleValC2 = document.getElementById('tele-val-c2');
  const teleSubA = document.getElementById('tele-sub-a');
  const teleSubB = document.getElementById('tele-sub-b');
  const teleSubC = document.getElementById('tele-sub-c');
  const teleBalance = document.getElementById('tele-balance');
  const barPartA = document.getElementById('bar-part-a');
  const barPartB = document.getElementById('bar-part-b');

  function isPythagoreanTriple(a: number, b: number, c: number): boolean {
    return Math.abs(c - Math.round(c)) < 1e-6;
  }

  function updateSim() {
    const a = curA;
    const b = curB;
    const a2 = a * a;
    const b2 = b * b;
    const c2 = a2 + b2;
    const c = Math.sqrt(c2);

    if (dispA) dispA.textContent = String(a);
    if (dispB) dispB.textContent = String(b);

    const isTriple = isPythagoreanTriple(a, b, c);
    const roundC = Math.round(c);

    if (tripleStatus) {
      if (isTriple) {
        tripleStatus.textContent = `TERNA ENTERA: (${a}, ${b}, ${roundC})`;
        tripleStatus.className = 'graph-metric is-triple';
      } else {
        tripleStatus.textContent = `c = ${c.toFixed(3)} (Irracional)`;
        tripleStatus.className = 'graph-metric';
      }
    }

    if (teleValA2) teleValA2.textContent = a2.toFixed(2);
    if (teleValB2) teleValB2.textContent = b2.toFixed(2);
    if (teleValC2) teleValC2.textContent = c2.toFixed(2);

    if (teleSubA) teleSubA.textContent = `Lado a = ${a}`;
    if (teleSubB) teleSubB.textContent = `Lado b = ${b}`;
    if (teleSubC) teleSubC.textContent = `Hipotenusa c = ${c.toFixed(6)}`;

    if (teleBalance) {
      teleBalance.textContent = `${a2} + ${b2} = ${c2} ✓`;
    }

    const pctA = (a2 / c2) * 100;
    const pctB = (b2 / c2) * 100;
    if (barPartA) barPartA.style.width = `${pctA}%`;
    if (barPartB) barPartB.style.width = `${pctB}%`;

    // Renderizar gráfico vectorial en SVG
    renderSVG(a, b, c);
  }

  function renderSVG(a: number, b: number, c: number) {
    if (!svgEl) return;

    const isLight = document.documentElement.getAttribute('data-theme') === 'light';

    const a2 = a * a;
    const b2 = b * b;
    const c2 = a2 + b2;
    const isTriple = isPythagoreanTriple(a, b, c);
    const roundC = Math.round(c);

    // Tamaño de canvas viewBox="0 0 540 320"
    const W_svg = 540;
    const H_svg = 320;

    // Escala dinámica para centrar perfectamente el bounding box (2a + b) x (a + 2b)
    const scale = Math.min(460 / (2 * a + b), 260 / (a + 2 * b));
    const sA = a * scale;
    const sB = b * scale;

    // Vértice del ángulo recto C en (xC, yC) centrado en el canvas
    const xC = W_svg / 2 - sB / 2;
    const yC = H_svg / 2 + sA / 2;

    // Vértices del triángulo:
    // C es el ángulo recto en (xC, yC)
    // A sobre el cateto vertical a (hacia arriba): (xC, yC - sA)
    // B sobre el cateto horizontal b (hacia la derecha): (xC + sB, yC)
    const ax = xC;
    const ay = yC - sA;
    const bx = xC + sB;
    const by = yC;

    // Cuadrado de la hipotenusa AB:
    // Vector normal perpendicular hacia afuera: (sA, -sB)
    const p3x = bx + sA;
    const p3y = by - sB;
    const p4x = ax + sA;
    const p4y = ay - sB;

    // Centro del cuadrado c² y ángulo de inclinación
    const cMidX = xC + (sA + sB) / 2;
    const cMidY = yC - (sA + sB) / 2;
    const angleDeg = -Math.atan2(sA, sB) * (180 / Math.PI);

    // Tipografía proporcional
    const fsMain = Math.max(10, Math.min(16, scale * 1.1));
    const fsSub = Math.max(9, Math.min(13, scale * 0.9));
    const rSize = Math.max(6, Math.min(14, Math.min(sA, sB) * 0.22));

    const colorA = isLight ? '#d97706' : '#fbbf24';
    const bgA = isLight ? 'rgba(217, 119, 6, 0.16)' : 'rgba(251, 191, 36, 0.2)';

    const colorB = isLight ? '#0284c7' : '#38bdf8';
    const bgB = isLight ? 'rgba(2, 132, 199, 0.16)' : 'rgba(56, 189, 248, 0.2)';

    const colorC = isLight ? '#059669' : '#10b981';
    const textC = isLight ? '#047857' : '#34d399';
    const bgC = isLight ? 'rgba(16, 185, 129, 0.18)' : 'rgba(16, 185, 129, 0.22)';

    const triFill = isLight ? '#e2e8f0' : '#1e293b';
    const triStroke = isLight ? '#0f172a' : '#f8fafc';

    svgEl.innerHTML = `
      <!-- Cuadrado cateto a² (a la izquierda de C) -->
      <rect x="${xC - sA}" y="${yC - sA}" width="${sA}" height="${sA}" fill="${bgA}" stroke="${colorA}" stroke-width="2" rx="3" />
      <text x="${xC - sA / 2}" y="${yC - sA / 2 + 4}" fill="${colorA}" font-size="${fsMain}" font-weight="bold" font-family="'JetBrains Mono', monospace" text-anchor="middle">a² = ${a2}</text>

      <!-- Cuadrado cateto b² (debajo de C) -->
      <rect x="${xC}" y="${yC}" width="${sB}" height="${sB}" fill="${bgB}" stroke="${colorB}" stroke-width="2" rx="3" />
      <text x="${xC + sB / 2}" y="${yC + sB / 2 + 4}" fill="${colorB}" font-size="${fsMain}" font-weight="bold" font-family="'JetBrains Mono', monospace" text-anchor="middle">b² = ${b2}</text>

      <!-- Cuadrado hipotenusa c² (inclinado, estrictamente ortogonal) -->
      <polygon points="${ax},${ay} ${bx},${by} ${p3x},${p3y} ${p4x},${p4y}" fill="${bgC}" stroke="${colorC}" stroke-width="2" />
      <g transform="rotate(${angleDeg} ${cMidX} ${cMidY})">
        <text x="${cMidX}" y="${cMidY - 3}" fill="${textC}" font-size="${fsMain + 1}" font-weight="bold" font-family="'JetBrains Mono', monospace" text-anchor="middle">c² = ${c2}</text>
        <text x="${cMidX}" y="${cMidY + fsSub + 1}" fill="${textC}" font-size="${fsSub}" font-family="'JetBrains Mono', monospace" text-anchor="middle">c = ${isTriple ? roundC : c.toFixed(2)}</text>
      </g>

      <!-- Triángulo rectángulo base ABC -->
      <polygon points="${xC},${yC} ${ax},${ay} ${bx},${by}" fill="${triFill}" stroke="${triStroke}" stroke-width="2.5" />
      
      <!-- Cuadradito de ángulo recto en el vértice C (hacia el interior del triángulo) -->
      <rect x="${xC}" y="${yC - rSize}" width="${rSize}" height="${rSize}" fill="none" stroke="${triStroke}" stroke-width="1.5" />

      <!-- Etiquetas de catetos a y b en los bordes del triángulo -->
      <text x="${xC + 8}" y="${yC - sA / 2 + 4}" fill="${colorA}" font-size="${fsSub}" font-weight="bold" font-family="'JetBrains Mono', monospace">a = ${a}</text>
      <text x="${xC + sB / 2}" y="${yC - 8}" fill="${colorB}" font-size="${fsSub}" font-weight="bold" font-family="'JetBrains Mono', monospace" text-anchor="middle">b = ${b}</text>
    `;
  }

  // Escuchadores de eventos para los sliders
  if (sliderA) {
    sliderA.addEventListener('input', (e) => {
      curA = parseInt((e.target as HTMLInputElement).value, 10);
      updateSim();
    });
  }

  if (sliderB) {
    sliderB.addEventListener('input', (e) => {
      curB = parseInt((e.target as HTMLInputElement).value, 10);
      updateSim();
    });
  }

  // Presets
  const presetBtns = document.querySelectorAll('.lab-preset-bar .preset-btn');
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const a = parseInt(btn.getAttribute('data-a') || '3', 10);
      const b = parseInt(btn.getAttribute('data-b') || '4', 10);

      curA = a;
      curB = b;
      if (sliderA) sliderA.value = String(a);
      if (sliderB) sliderB.value = String(b);
      updateSim();
    });
  });

  // Inicializar simulación
  updateSim();

  // Observador de cambio de tema claro / oscuro
  const themeObserver = new MutationObserver(() => {
    updateSim();
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // =========================================================================
  // SISTEMA INTERACTIVO DE AUTOEVALUACIÓN (QUIZ)
  // =========================================================================
  const quizCards = document.querySelectorAll('.quiz-card');
  quizCards.forEach((card) => {
    const buttons = card.querySelectorAll<HTMLButtonElement>('.q-opt-btn');
    const feedback = card.querySelector<HTMLDivElement>('.q-feedback');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.disabled = true;
          if (b.getAttribute('data-correct') === 'true') {
            b.classList.add('is-correct');
          }
        });

        const isCorrect = btn.getAttribute('data-correct') === 'true';
        if (!isCorrect) {
          btn.classList.add('is-wrong');
        }

        if (feedback) {
          feedback.style.display = 'block';
          feedback.className = `q-feedback ${isCorrect ? 'feedback-correct' : 'feedback-wrong'}`;
          feedback.innerHTML = isCorrect
            ? '<strong>✓ ¡Correcto!</strong> ' + getQuizExplanation(card.getAttribute('data-q') || '1')
            : '<strong>✕ Incorrecto.</strong> ' + getQuizExplanation(card.getAttribute('data-q') || '1');
        }
      });
    });
  });

  function getQuizExplanation(qId: string): string {
    switch (qId) {
      case '1':
        return 'Ambas configuraciones encajan dentro del mismo contenedor cuadrado de lado (a+b). Como las cuatro esquinas contienen triángulos rectángulos idénticos de área ½·ab, al quitarlos ambos espacios restantes (a²+b² por un lado y c² por el otro) deben ser exactamente idénticos.';
      case '2':
        return 'Euclides demostró que la altura divide el cuadrado de la hipotenusa en dos rectángulos. Mediante cizallamiento y congruencia de triángulos LAL, cada rectángulo tiene la misma área que el cuadrado del cateto adyacente.';
      case '3':
        return 'Por la Proposición VI.31 de Euclides, las áreas de figuras semejantes son proporcionales al cuadrado de sus dimensiones lineales. Por tanto, la suma de las áreas de dos semicírculos sobre los catetos iguala con exactitud al semicírculo sobre la hipotenusa.';
      case '4':
        return 'El Teorema de Pitágoras es equivalente al Quinto Postulado de las paralelas de Euclides. En superficies con curvatura positiva como una esfera, los triángulos tienen una suma de ángulos mayor a 180° y la hipotenusa es más corta que en el plano (c² < a² + b²).';
      default:
        return '¡Excelente razonamiento!';
    }
  }
</script>

