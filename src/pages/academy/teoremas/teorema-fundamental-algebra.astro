      <!-- Pregunta 4 -->
      <div class="quiz-card" data-q="4">
        <div class="q-header">
          <span class="q-badge">PREGUNTA 04</span>
          <h4>¿Cuál es la diferencia capital entre el Teorema Fundamental del Álgebra y el Teorema de Abel-Ruffini?</h4>
        </div>
        <div class="q-options">
          <button type="button" class="q-opt-btn" data-correct="false">
            <span class="opt-letter">A</span>
            <span class="opt-text">El TFA fue demostrado por Euclides y Abel-Ruffini por Newton.</span>
          </button>
          <button type="button" class="q-opt-btn" data-correct="true">
            <span class="opt-letter">B</span>
            <span class="opt-text">El TFA garantiza que las n raíces existen en ℂ; Abel-Ruffini demuestra que para grado ≥ 5 no existe una fórmula general por radicales algebraicos elementales para expresarlas.</span>
          </button>
          <button type="button" class="q-opt-btn" data-correct="false">
            <span class="opt-letter">C</span>
            <span class="opt-text">El TFA solo se aplica a polinomios cuadráticos y Abel-Ruffini a polinomios cúbicos.</span>
          </button>
          <button type="button" class="q-opt-btn" data-correct="false">
            <span class="opt-letter">D</span>
            <span class="opt-text">Son dos nombres distintos para el mismo teorema.</span>
          </button>
        </div>
        <div class="q-feedback" style="display: none;"></div>
      </div>
    </div>
  </section>
</AcademyLessonLayout>

<script>
  // =========================================================================
  // LABORATORIO INTERACTIVO: EL EXPLORADOR DE GIRO TOPOLÓGICO DEL TFA
  // =========================================================================

  interface Complex {
    re: number;
    im: number;
  }

  function cAdd(a: Complex, b: Complex): Complex {
    return { re: a.re + b.re, im: a.im + b.im };
  }

  function cMul(a: Complex, b: Complex): Complex {
    return { re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re };
  }

  function cPower(c: Complex, n: number): Complex {
    let res: Complex = { re: 1, im: 0 };
    for (let i = 0; i < n; i++) {
      res = cMul(res, c);
    }
    return res;
  }

  interface PolyConfig {
    name: string;
    degree: number;
    eval: (z: Complex) => Complex;
    roots: Complex[];
    maxR: number;
  }

  const POLYS: Record<string, PolyConfig> = {
    z2p1: {
      name: 'P(z) = z² + 1',
      degree: 2,
      eval: (z) => {
        const z2 = cPower(z, 2);
        return { re: z2.re + 1, im: z2.im };
      },
      roots: [{ re: 0, im: 1 }, { re: 0, im: -1 }],
      maxR: 2.2
    },
    z3m1: {
      name: 'P(z) = z³ - 1',
      degree: 3,
      eval: (z) => {
        const z3 = cPower(z, 3);
        return { re: z3.re - 1, im: z3.im };
      },
      roots: [
        { re: 1, im: 0 },
        { re: -0.5, im: Math.sqrt(3) / 2 },
        { re: -0.5, im: -Math.sqrt(3) / 2 }
      ],
      maxR: 2.2
    },
    z2m2zp2: {
      name: 'P(z) = z² - 2z + 2',
      degree: 2,
      eval: (z) => {
        const z2 = cPower(z, 2);
        return { re: z2.re - 2 * z.re + 2, im: z2.im - 2 * z.im };
      },
      roots: [{ re: 1, im: 1 }, { re: 1, im: -1 }],
      maxR: 2.5
    },
    z4m1: {
      name: 'P(z) = z⁴ - 1',
      degree: 4,
      eval: (z) => {
        const z4 = cPower(z, 4);
        return { re: z4.re - 1, im: z4.im };
      },
      roots: [
        { re: 1, im: 0 },
        { re: -1, im: 0 },
        { re: 0, im: 1 },
        { re: 0, im: -1 }
      ],
      maxR: 2.2
    }
  };

  let curPolyKey = 'z2p1';
  let curR = 1.0;

  const sliderR = document.getElementById('slider-radius-r') as HTMLInputElement | null;
  const dispR = document.getElementById('disp-radius-r');
  const svgEl = document.getElementById('svg-fta') as SVGSVGElement | null;

  const rootAlert = document.getElementById('lab-root-alert');
  const teleStatus = document.getElementById('tele-status');
  const teleValR = document.getElementById('tele-val-r');
  const teleValWind = document.getElementById('tele-val-wind');
  const teleDistOrigin = document.getElementById('tele-dist-origin');
  const teleDistSub = document.getElementById('tele-dist-sub');
  const teleRootsCaptured = document.getElementById('tele-roots-captured');
  const ftaMeterFill = document.getElementById('fta-meter-fill');
  const teleCaption = document.getElementById('tele-caption');

  function updateLab() {
    const poly = POLYS[curPolyKey];
    if (!poly) return;

    if (dispR) dispR.textContent = curR.toFixed(2);
    if (teleValR) teleValR.textContent = curR.toFixed(2);
    if (teleStatus) teleStatus.textContent = `R = ${curR.toFixed(2)}`;

    // Contar cuántas raíces tienen |root| <= curR
    const rootsInside = poly.roots.filter((rt) => Math.hypot(rt.re, rt.im) <= curR + 0.04);
    const numInside = rootsInside.length;

    // Calcular distancia mínima de la curva P(R e^it) al origen
    const SAMPLES = 120;
    let minDist = Infinity;
    let pathWPoints: { x: number; y: number }[] = [];

    // Calcular winding number aproximado sumando ángulos de cambio dtheta
    let totalAngleChange = 0;
    let prevAngle = 0;

    for (let i = 0; i <= SAMPLES; i++) {
      const theta = (i / SAMPLES) * 2 * Math.PI;
      const z: Complex = { re: curR * Math.cos(theta), im: curR * Math.sin(theta) };
      const w = poly.eval(z);
      const dist = Math.hypot(w.re, w.im);
      if (dist < minDist) minDist = dist;

      const angle = Math.atan2(w.im, w.re);
      if (i > 0) {
        let diff = angle - prevAngle;
        while (diff > Math.PI) diff -= 2 * Math.PI;
        while (diff < -Math.PI) diff += 2 * Math.PI;
        totalAngleChange += diff;
      }
      prevAngle = angle;
    }

    const windingNumber = Math.round(totalAngleChange / (2 * Math.PI));

    const isAtRoot = minDist < 0.25;

    if (rootAlert) {
      if (isAtRoot) {
        rootAlert.textContent = '¡LA CURVA CRUZA EL ORIGEN! (P(z) = 0)';
        rootAlert.className = 'graph-metric is-root';
      } else {
        rootAlert.textContent = `ÍNDICE DE GIRO: ${windingNumber} ${windingNumber === 1 ? 'VUELTA' : 'VUELTAS'}`;
        rootAlert.className = 'graph-metric';
      }
    }

    if (teleValWind) {
      teleValWind.textContent = `${windingNumber} ${windingNumber === 1 ? 'vuelta' : 'vueltas'}`;
    }

    if (teleDistOrigin) {
      teleDistOrigin.textContent = minDist.toFixed(3);
      teleDistOrigin.className = isAtRoot ? 't-val big-val is-zero' : 't-val big-val';
    }

    if (teleDistSub) {
      teleDistSub.textContent = isAtRoot
        ? '¡La curva cruza exactamente el centro (0,0)! ¡Raíz hallada!'
        : `Distancia al origen en W. El centro no se toca aún.`;
    }

    if (teleRootsCaptured) {
      teleRootsCaptured.textContent = `${numInside} / ${poly.roots.length} raíces`;
    }

    if (ftaMeterFill) {
      const pct = (numInside / poly.roots.length) * 100;
      ftaMeterFill.style.width = `${pct}%`;
      ftaMeterFill.style.background = pct === 100 ? '#10b981' : pct > 0 ? '#38bdf8' : '#fbbf24';
    }

    if (teleCaption) {
      teleCaption.textContent = isAtRoot
        ? `¡Momento exacto del TFA! El radio R = ${curR.toFixed(2)} coincide con el módulo de la raíz del polinomio.`
        : `Al incrementar R, el índice de giro salta discretamente cuando el círculo Z engloba cada una de las raíces.`;
    }

    renderDualPlanes(poly, curR, isAtRoot);
  }

  function renderDualPlanes(poly: PolyConfig, R: number, isAtRoot: boolean) {
    if (!svgEl) return;

    const isLight = document.documentElement.getAttribute('data-theme') === 'light';

    const W = 540;
    const H = 280;

    // Plano Z: centro (135, 140), radio de visualización 110 px para R_max = 2.5 (escala = 42 px / unidad)
    const zCenterX = 135;
    const zCenterY = 140;
    const zScale = 44;

    // Plano W: centro (405, 140), radio de visualización ajustado
    const wCenterX = 405;
    const wCenterY = 140;
    const wScale = 22; // Ajustado para contener valores mayores de P(z)

    const axisColor = isLight ? 'rgba(0,0,0,0.18)' : 'rgba(255,255,255,0.18)';
    const textColor = isLight ? '#475569' : '#94a3b8';
    const circleZColor = '#fbbf24';
    const curveWColor = isAtRoot ? '#10b981' : '#38bdf8';
    const rootColor = '#ef4444';

    // Construir curva Z (círculo)
    const circleZRadius = R * zScale;

    // Construir curva W con 120 puntos
    const SAMPLES = 120;
    let pathWStr = '';
    for (let i = 0; i <= SAMPLES; i++) {
      const theta = (i / SAMPLES) * 2 * Math.PI;
      const z: Complex = { re: R * Math.cos(theta), im: R * Math.sin(theta) };
      const w = poly.eval(z);
      const wx = wCenterX + w.re * wScale;
      const wy = wCenterY - w.im * wScale;
      if (i === 0) {
        pathWStr += `M ${wx.toFixed(1)} ${wy.toFixed(1)}`;
      } else {
        pathWStr += ` L ${wx.toFixed(1)} ${wy.toFixed(1)}`;
      }
    }
    pathWStr += ' Z';

    // Raíces en plano Z
    const rootsZStr = poly.roots
      .map((rt) => {
        const rx = zCenterX + rt.re * zScale;
        const ry = zCenterY - rt.im * zScale;
        const isEnclosed = Math.hypot(rt.re, rt.im) <= R + 0.04;
        return `
        <circle cx="${rx.toFixed(1)}" cy="${ry.toFixed(1)}" r="${isEnclosed ? '5' : '4'}" fill="${isEnclosed ? '#10b981' : '#ef4444'}" stroke="#f8fafc" stroke-width="1.5" />
      `;
      })
      .join('');

    svgEl.innerHTML = `
      <!-- ================= PLANO Z (DOMINIO) ================= -->
      <!-- Divisoria vertical suave -->
      <line x1="270" y1="20" x2="270" y2="260" stroke="${axisColor}" stroke-dasharray="3 3" />

      <!-- Título Plano Z -->
      <text x="${zCenterX}" y="28" fill="${textColor}" font-size="11" font-weight="bold" font-family="'JetBrains Mono', monospace" text-anchor="middle">PLANO DOMINIO Z</text>
      
      <!-- Ejes coordenados Plano Z -->
      <line x1="25" y1="${zCenterY}" x2="245" y2="${zCenterY}" stroke="${axisColor}" stroke-width="1.5" />
      <line x1="${zCenterX}" y1="35" x2="${zCenterX}" y2="255" stroke="${axisColor}" stroke-width="1.5" />
      <text x="240" y="${zCenterY - 6}" fill="${textColor}" font-size="10" font-family="monospace">Re(z)</text>
      <text x="${zCenterX + 6}" y="45" fill="${textColor}" font-size="10" font-family="monospace">Im(z)</text>

      <!-- Círculo de prueba de radio R en Z -->
      <circle cx="${zCenterX}" cy="${zCenterY}" r="${circleZRadius.toFixed(1)}" fill="rgba(251, 191, 36, 0.08)" stroke="${circleZColor}" stroke-width="2" stroke-dasharray="4 2" />
      <text x="${zCenterX + circleZRadius + 5}" y="${zCenterY - 6}" fill="${circleZColor}" font-size="10" font-weight="bold" font-family="monospace">R=${R.toFixed(2)}</text>

      <!-- Raíces teóricas en Z -->
      ${rootsZStr}

      <!-- ================= PLANO W = P(Z) (IMAGEN) ================= -->
      <!-- Título Plano W -->
      <text x="${wCenterX}" y="28" fill="${textColor}" font-size="11" font-weight="bold" font-family="'JetBrains Mono', monospace" text-anchor="middle">PLANO IMAGEN W = P(z)</text>

      <!-- Ejes coordenados Plano W -->
      <line x1="295" y1="${wCenterY}" x2="515" y2="${wCenterY}" stroke="${axisColor}" stroke-width="1.5" />
      <line x1="${wCenterX}" y1="35" x2="${wCenterX}" y2="255" stroke="${axisColor}" stroke-width="1.5" />
      <text x="510" y="${wCenterY - 6}" fill="${textColor}" font-size="10" font-family="monospace">Re(w)</text>
      <text x="${wCenterX + 6}" y="45" fill="${textColor}" font-size="10" font-family="monospace">Im(w)</text>

      <!-- Origen (0,0) en W -->
      <circle cx="${wCenterX}" cy="${wCenterY}" r="4" fill="${isAtRoot ? '#10b981' : '#f8fafc'}" stroke="${isAtRoot ? '#10b981' : '#ef4444'}" stroke-width="2" />
      <text x="${wCenterX - 8}" y="${wCenterY + 14}" fill="${textColor}" font-size="10" font-family="monospace">0</text>

      <!-- Curva transformada cerrada W = P(z) -->
      <path d="${pathWStr}" fill="${isAtRoot ? 'rgba(16, 185, 129, 0.15)' : 'rgba(56, 189, 248, 0.1)'}" stroke="${curveWColor}" stroke-width="${isAtRoot ? '3' : '2'}" />
    `;
  }

  // Deslizador de radio R
  if (sliderR) {
    sliderR.addEventListener('input', (e) => {
      curR = parseFloat((e.target as HTMLInputElement).value);
      updateLab();
    });
  }

  // Presets de Polinomios
  const presetBtns = document.querySelectorAll('.lab-preset-bar .preset-btn');
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const polyKey = btn.getAttribute('data-poly') || 'z2p1';
      curPolyKey = polyKey;
      curR = 1.0;
      if (sliderR) sliderR.value = '1.00';
      updateLab();
    });
  });

  // Inicializar simulación
  updateLab();

  // Observador de cambio de tema claro / oscuro
  const themeObserver = new MutationObserver(() => {
    updateLab();
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // =========================================================================
  // SISTEMA INTERACTIVO DE AUTOEVALUACIÓN (QUIZ)
  // =========================================================================
  const quizCards = document.querySelectorAll('.quiz-card');
  quizCards.forEach((card) => {
    const buttons = card.querySelectorAll<HTMLButtonElement>('.q-opt-btn');
    const feedback = card.querySelector<HTMLDivElement>('.q-feedback');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.disabled = true;
          if (b.getAttribute('data-correct') === 'true') {
            b.classList.add('is-correct');
          }
        });

        const isCorrect = btn.getAttribute('data-correct') === 'true';
        if (!isCorrect) {
          btn.classList.add('is-wrong');
        }

        if (feedback) {
          feedback.style.display = 'block';
          feedback.className = `q-feedback ${isCorrect ? 'feedback-correct' : 'feedback-wrong'}`;
          feedback.innerHTML = isCorrect
            ? '<strong>✓ ¡Correcto!</strong> ' + getQuizExplanation(card.getAttribute('data-q') || '1')
            : '<strong>✕ Incorrecto.</strong> ' + getQuizExplanation(card.getAttribute('data-q') || '1');
        }
      });
    });
  });

  function getQuizExplanation(qId: string): string {
    switch (qId) {
      case '1':
        return 'Un cuerpo es algebraicamente cerrado si cualquier polinomio no constante con coeficientes en dicho cuerpo tiene todas sus raíces en el propio cuerpo. El plano complejo ℂ no requiere ninguna extensión algebraica adicional.';
      case '2':
        return 'Para R muy pequeño la curva rodea al término independiente a₀ (0 vueltas). Para R muy grande domina aₙzⁿ que da n vueltas. Al crecer R continuamente, la curva debe forzosamente cruzar el origen (0,0), lo que garantiza la existencia de al menos una raíz P(z₀) = 0.';
      case '3':
        return 'Por el Teorema del Conjugado, en polinomios reales las raíces imaginarias vienen siempre emparejadas (α ± βi). Como el grado es 5 (impar), no todas las raíces pueden agruparse en parejas de dos, forzando a que al menos una raíz sea puramente real.';
      case '4':
        return 'El TFA es un teorema de existencia pura (las n raíces existen y habitan en ℂ). Abel y Galois demostraron que para polinomios de grado 5 o superior no existe ninguna fórmula universal que exprese dichas raíces mediante radicales algebraicos.';
      default:
