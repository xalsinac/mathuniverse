<script>
  // =========================================================================
  // LABORATORIO INTERACTIVO: EL GENERADOR EUCLIDIANO DE PRIMOS
  // =========================================================================

  interface EuclidCase {
    k: number;
    primes: number[];
    p: number;
    n: number;
    isPrime: boolean;
    factors: number[];
    factorComment: string;
    natureDesc: string;
    stateBadge: string;
  }

  const CASES: Record<number, EuclidCase> = {
    1: {
      k: 1,
      primes: [2],
      p: 2,
      n: 3,
      isPrime: true,
      factors: [3],
      factorComment: 'N = 3 es un número primo en sí mismo. Supera a p₁ = 2.',
      natureDesc: 'N = 3 es estrictamente <strong>PRIMO</strong>.',
      stateBadge: 'ESTADO: PRIMO DESCUBIERTO (3)'
    },
    2: {
      k: 2,
      primes: [2, 3],
      p: 6,
      n: 7,
      isPrime: true,
      factors: [7],
      factorComment: 'N = 7 es un número primo en sí mismo. Supera a p₂ = 3.',
      natureDesc: 'N = 7 es estrictamente <strong>PRIMO</strong>.',
      stateBadge: 'ESTADO: PRIMO DESCUBIERTO (7)'
    },
    3: {
      k: 3,
      primes: [2, 3, 5],
      p: 30,
      n: 31,
      isPrime: true,
      factors: [31],
      factorComment: 'N = 31 es primo. Supera al mayor de la lista (5).',
      natureDesc: 'N = 31 es estrictamente <strong>PRIMO</strong>.',
      stateBadge: 'ESTADO: PRIMO DESCUBIERTO (31)'
    },
    4: {
      k: 4,
      primes: [2, 3, 5, 7],
      p: 210,
      n: 211,
      isPrime: true,
      factors: [211],
      factorComment: 'N = 211 es primo. Supera al mayor primo inicial (7).',
      natureDesc: 'N = 211 es estrictamente <strong>PRIMO</strong>.',
      stateBadge: 'ESTADO: PRIMO DESCUBIERTO (211)'
    },
    5: {
      k: 5,
      primes: [2, 3, 5, 7, 11],
      p: 2310,
      n: 2311,
      isPrime: true,
      factors: [2311],
      factorComment: 'N = 2311 es primo. Supera con creces a p₅ = 11.',
      natureDesc: 'N = 2311 es estrictamente <strong>PRIMO</strong>.',
      stateBadge: 'ESTADO: PRIMO DESCUBIERTO (2311)'
    },
    6: {
      k: 6,
      primes: [2, 3, 5, 7, 11, 13],
      p: 30030,
      n: 30031,
      isPrime: false,
      factors: [59, 509],
      factorComment: '¡N es compuesto! Factores 59 y 509: ¡ninguno estaba en la lista inicial!',
      natureDesc: 'N = 30031 es <strong>COMPUESTO</strong> (59 × 509).',
      stateBadge: 'ESTADO: 2 PRIMOS INÉDITOS HALLADOS'
    },
    7: {
      k: 7,
      primes: [2, 3, 5, 7, 11, 13, 17],
      p: 510510,
      n: 510511,
      isPrime: false,
      factors: [19, 97, 277],
      factorComment: '¡N es compuesto! Factores 19, 97 y 277: ¡todos inéditos para la lista!',
      natureDesc: 'N = 510511 es <strong>COMPUESTO</strong> (19 × 97 × 277).',
      stateBadge: 'ESTADO: 3 PRIMOS INÉDITOS HALLADOS'
    }
  };

  const exprProdEl = document.getElementById('lab-expr-prod');
  const valNEl = document.getElementById('lab-val-n');
  const natureDescEl = document.getElementById('lab-nature-desc');
  const stateBadgeEl = document.getElementById('lab-state-badge');
  const modGridEl = document.getElementById('lab-mod-grid');

  const teleValP = document.getElementById('tele-val-p');
  const teleValN = document.getElementById('tele-val-n');
  const teleFactors = document.getElementById('tele-factors');
  const teleFactorComment = document.getElementById('tele-factor-comment');
  const teleStatus = document.getElementById('tele-status');
  const radarFill = document.getElementById('radar-fill');

  function renderLabCase(k: number) {
    const data = CASES[k];
    if (!data) return;

    if (exprProdEl) exprProdEl.textContent = data.primes.join(' · ');
    if (valNEl) valNEl.textContent = data.n.toLocaleString();
    if (natureDescEl) natureDescEl.innerHTML = data.natureDesc;
    if (stateBadgeEl) stateBadgeEl.textContent = data.stateBadge;

    if (teleValP) teleValP.textContent = data.p.toLocaleString();
    if (teleValN) teleValN.textContent = data.n.toLocaleString();
    if (teleFactors) {
      teleFactors.textContent = data.factors.join(' × ');
      if (data.isPrime) {
        teleFactors.className = 't-val big-val prime-glow';
      } else {
        teleFactors.className = 't-val big-val composite-glow';
      }
    }
    if (teleFactorComment) teleFactorComment.textContent = data.factorComment;
    if (teleStatus) {
      teleStatus.textContent = data.isPrime ? 'PRIMO NUEVO' : 'COMPUESTO (FACTORES NUEVOS)';
      teleStatus.className = data.isPrime ? 'telemetry-badge prime' : 'telemetry-badge composite';
    }

    if (radarFill) {
      radarFill.style.background = data.isPrime ? '#10b981' : '#f59e0b';
    }

    // Grid de Restos Módulo p_i
    if (modGridEl) {
      modGridEl.innerHTML = '';
      data.primes.forEach((p) => {
        const cell = document.createElement('div');
        cell.className = 'mod-cell';
        cell.innerHTML = `
          <span class="m-primo">p = ${p}</span>
          <span class="m-op">${data.n} mod ${p} = </span>
          <span class="m-rem">1</span>
        `;
        modGridEl.appendChild(cell);
      });
    }
  }

  // Presets click listener
  const presetBtns = document.querySelectorAll('.lab-preset-bar .preset-btn');
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const k = parseInt(btn.getAttribute('data-k') || '1', 10);
      renderLabCase(k);
    });
  });

  // Inicializar caso k = 1
  renderLabCase(1);

  // =========================================================================
  // SISTEMA INTERACTIVO DE AUTOEVALUACIÓN (QUIZ)
  // =========================================================================
  const quizCards = document.querySelectorAll('.quiz-card');
  quizCards.forEach((card) => {
    const buttons = card.querySelectorAll<HTMLButtonElement>('.q-opt-btn');
    const feedback = card.querySelector<HTMLDivElement>('.q-feedback');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.disabled = true;
          if (b.getAttribute('data-correct') === 'true') {
            b.classList.add('is-correct');
          }
        });

        const isCorrect = btn.getAttribute('data-correct') === 'true';
        if (!isCorrect) {
          btn.classList.add('is-wrong');
        }

        if (feedback) {
          feedback.style.display = 'block';
          feedback.className = `q-feedback ${isCorrect ? 'feedback-correct' : 'feedback-wrong'}`;
          feedback.innerHTML = isCorrect
            ? '<strong>✓ ¡Correcto!</strong> ' + getQuizExplanation(card.getAttribute('data-q') || '1')
            : '<strong>✕ Incorrecto.</strong> ' + getQuizExplanation(card.getAttribute('data-q') || '1');
        }
      });
    });
  });

  function getQuizExplanation(qId: string): string {
    switch (qId) {
      case '1':
        return 'Al construir N como el producto de todos los pᵢ más 1, cualquier división entre pᵢ deja exactamente resto 1. Como un número mayor que 1 no puede dividir a 1, ninguno de los primos de la lista puede ser divisor de N.';
      case '2':
        return 'Euclides demostró que N tiene AL MENOS un divisor primo ajeno a la lista. Que 30031 sea compuesto confirma la prueba, pues sus divisores primos (59 y 509) son primos nuevos que no figuraban en {2, 3, 5, 7, 11, 13}.';
      case '3':
        return 'Leonhard Euler conectó el producto sobre todos los números primos con la suma de la serie armónica ∑(1/n). Como la serie diverge a infinito, el número de factores primos en el producto no puede ser finito.';
      case '4':
        return 'Tomando el factorial de 101, cada número de la forma 101! + k (para 2 ≤ k ≤ 101) es divisible por k. Por tanto, es compuesto. Esta construcción permite fabricar desiertos de compuestos consecutivos tan inmensos como se desee.';
      default:
        return '¡Buen razonamiento!';
    }
  }
</script>

