    margin-top: 1.2rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #94a3b8;
  }

  /* 2. Lemas de Divisibilidad */
  .lemmas-pair-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
    margin: 1.6rem 0;
  }

  @media (max-width: 768px) {
    .lemmas-pair-grid {
      grid-template-columns: 1fr;
    }
  }

  .lemma-box {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.5rem;
  }

  .lemma-box-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 0.8rem;
  }

  .lemma-badge {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    padding: 0.2rem 0.55rem;
    border-radius: 5px;
    align-self: flex-start;
  }

  .lemma-badge.amber {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.12);
  }

  .lemma-box h4 {
    margin: 0;
    font-size: 1.05rem;
    color: #f8fafc;
  }

  .lemma-body p {
    font-size: 0.88rem;
    color: #cbd5e1;
    line-height: 1.55;
    margin: 0.6rem 0;
  }

  /* 3. Tarjeta de Demostración Canónica */
  .proof-container-card {
    background: #0b1120;
    border: 1.5px solid rgba(251, 191, 36, 0.25);
    border-radius: 16px;
    padding: 1.8rem;
    margin: 1.8rem 0;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
  }

  .proof-top-indicator {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
  }

  .proof-tag {
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    letter-spacing: 0.08em;
  }

  .proof-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .math-step-line.is-highlight-contradiction {
    padding: 1rem 1.25rem;
    border-radius: 10px;
    background: rgba(239, 68, 68, 0.08);
    border: 1.5px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
  }

  .math-step-line.is-highlight-qed {
    padding: 1.1rem 1.35rem;
    border-radius: 10px;
    background: rgba(16, 185, 129, 0.08);
    border: 1.5px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
  }

  .math-step-tag.red {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  .math-step-tag.gold {
    background: rgba(251, 191, 36, 0.2);
    color: #fbbf24;
  }

  .math-qed {
    color: #fbbf24;
    font-weight: 800;
    margin-left: 0.4rem;
  }

  /* 4. Mito Bust Card y Ramas */
  .myth-bust-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 14px;
    padding: 1.6rem 1.8rem;
    margin: 1.6rem 0;
  }

  .myth-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 5px;
    background: rgba(245, 158, 11, 0.18);
    color: #f59e0b;
    margin-bottom: 0.6rem;
  }

  .myth-bust-card h4 {
    margin: 0 0 0.8rem 0;
    font-size: 1.15rem;
    color: #f8fafc;
  }

  .myth-bust-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0 0 0.8rem 0;
  }

  .myth-branches-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-top: 1.2rem;
  }

  @media (max-width: 650px) {
    .myth-branches-grid {
      grid-template-columns: 1fr;
    }
  }

  .myth-branch {
    border-radius: 10px;
    padding: 1.2rem;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .myth-branch h5 {
    margin: 0.6rem 0 0.4rem 0;
    font-size: 1rem;
    color: #f8fafc;
  }

  .myth-branch p {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .branch-pill {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
  }

  .branch-pill.amber {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
  }

  /* Tabla de Euclides */
  .euclid-table-container {
    margin: 2rem 0;
  }

  .euclid-table-container h4 {
    font-size: 1.05rem;
    color: #f8fafc;
    margin-bottom: 0.9rem;
  }

  .table-scroll-wrapper {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .euclid-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    background: #0f172a;
    text-align: left;
  }

  .euclid-table th {
    background: rgba(0, 0, 0, 0.4);
    padding: 0.85rem 1rem;
    color: #94a3b8;
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .euclid-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: #cbd5e1;
  }

  .row-k {
    display: inline-block;
    font-weight: 800;
    font-family: monospace;
    color: #38bdf8;
  }

  .row-k.gold {
    color: #fbbf24;
  }

  .highlight-composite-row {
    background: rgba(245, 158, 11, 0.06);
  }

  .status-badge-prime {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 800;
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
  }

  .status-badge-comp {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 800;
    background: rgba(245, 158, 11, 0.18);
    color: #f59e0b;
  }

  .table-caption {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-top: 0.8rem;
    line-height: 1.5;
  }

  /* 5. Laboratorio Interactivo */
  .lab-container {
    background: #0b1120;
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 16px;
    padding: 1.8rem;
    margin: 1.8rem 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .lab-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
  }

  .lab-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 10px #38bdf8;
  }

  .lab-title {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #38bdf8;
    font-family: 'JetBrains Mono', monospace;
  }

  .lab-preset-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.4rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .preset-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #94a3b8;
    margin-right: 0.4rem;
  }

  .preset-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    font-size: 0.82rem;
    padding: 0.35rem 0.8rem;
    border-radius: 8px;
    cursor: pointer;
    font-family: monospace;
    transition: all 0.2s ease;
  }

  .preset-btn:hover {
    background: rgba(56, 189, 248, 0.15);
    border-color: #38bdf8;
    color: #38bdf8;
  }

  .preset-btn.is-active {
    background: #0284c7;
    border-color: #38bdf8;
    color: #ffffff;
    font-weight: 700;
    box-shadow: 0 0 12px rgba(2, 132, 199, 0.4);
  }

  .lab-workspace-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .lab-workspace-grid {
      grid-template-columns: 1fr;
    }
  }

  .graph-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.4rem;
  }

  .graph-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .graph-tag {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(251, 191, 36, 0.12);
    color: #fbbf24;
  }

  .graph-metric {
    font-size: 0.78rem;
    font-weight: 700;
    color: #10b981;
    font-family: monospace;
  }

  .formula-stage-box {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 1.4rem;
    margin-bottom: 1.2rem;
    text-align: center;
  }

  .formula-line-main {
    font-size: 1.35rem;
    font-family: 'JetBrains Mono', monospace;
    color: #f8fafc;
    font-weight: 700;
    margin-bottom: 0.6rem;
    word-break: break-all;
  }

  .f-prod-expr {
    color: #fbbf24;
  }

  .f-result {
    color: #38bdf8;
  }

  .formula-line-status {
    font-size: 0.95rem;
    color: #cbd5e1;
  }

  .mod-check-panel {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 1rem;
  }

  .mod-check-title {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #94a3b8;
    margin-bottom: 0.8rem;
  }

  .mod-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.6rem;
  }

  .mod-cell {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 0.45rem 0.6rem;
    font-size: 0.82rem;
    font-family: monospace;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .m-primo {
    color: #fbbf24;
    font-weight: 700;
  }

  .m-op {
    color: #94a3b8;
    font-size: 0.72rem;
  }

  .m-rem {
    color: #10b981;
    font-weight: 800;
    font-size: 0.9rem;
  }

  /* Telemetría */
  .lab-telemetry-panel {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.4rem;
  }

  .telemetry-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .telemetry-header h5 {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #94a3b8;
  }

  .telemetry-badge {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
  }

  .telemetry-badge.composite {
    background: rgba(245, 158, 11, 0.18);
    color: #f59e0b;
  }

  .telemetry-card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .t-cell {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 0.85rem;
  }

  .t-cell.full-width {
    grid-column: 1 / -1;
  }

  .t-label {
    display: block;
    font-size: 0.68rem;
    color: #94a3b8;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  .t-val {
    font-size: 1.12rem;
    font-weight: 700;
    font-family: monospace;
    color: #f8fafc;
  }

  .t-val.gold { color: #fbbf24; }
  .t-val.cyan { color: #38bdf8; }
  .t-val.big-val { font-size: 1.35rem; }
  .t-val.small { font-size: 0.82rem; }

  .prime-glow {
    color: #10b981 !important;
    text-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
  }

  .composite-glow {
    color: #f59e0b !important;
    text-shadow: 0 0 10px rgba(245, 158, 11, 0.4);
  }

  .t-sub {
    display: block;
    font-size: 0.72rem;
    color: #64748b;
    margin-top: 0.25rem;
  }

  .t-flex-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .prime-radar-bar {
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .radar-fill {
    height: 100%;
    transition: all 0.3s ease;
  }

  .meter-caption {
    display: block;
    font-size: 0.74rem;
    color: #94a3b8;
    line-height: 1.45;
  }

  /* 6. Otras Demostraciones */
  .alt-proofs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 1.6rem 0;
  }

  @media (max-width: 800px) {
    .alt-proofs-grid {
      grid-template-columns: 1fr;
    }
  }

  .alt-proof-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
  }

  .alt-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: 5px;
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    margin-bottom: 0.8rem;
  }

  .alt-badge.cyan {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
  }

  .alt-proof-card h4 {
    margin: 0 0 0.8rem 0;
    font-size: 1.08rem;
    color: #f8fafc;
  }

  .alt-proof-card p {
    font-size: 0.88rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0 0 0.8rem 0;
  }

  .alt-tag-footer {
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.78rem;
    color: #fbbf24;
    font-style: italic;
  }

  .alt-tag-footer.cyan {
    color: #38bdf8;
  }

  /* 7. Trampas (Sins) */
  .sins-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
    margin: 1.6rem 0;
  }

  @media (max-width: 768px) {
    .sins-grid {
      grid-template-columns: 1fr;
    }
  }

  .sin-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.4rem;
  }

  .sin-pill {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    margin-bottom: 0.6rem;
  }

  .sin-card h4 {
    margin: 0 0 0.6rem 0;
    font-size: 1.02rem;
    color: #f8fafc;
  }

  .sin-card p {
    font-size: 0.86rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0 0 0.8rem 0;
  }

  .sin-bad {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 6px;
    padding: 0.6rem 0.8rem;
    font-size: 0.82rem;
    color: #fca5a5;
    margin-bottom: 0.6rem;
    line-height: 1.45;
  }

  .sin-good {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 6px;
    padding: 0.6rem 0.8rem;
    font-size: 0.82rem;
    color: #6ee7b7;
    line-height: 1.45;
  }

  /* 8. Quiz */
  .quiz-stack {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin: 1.6rem 0;
  }

  .quiz-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 1.6rem;
  }

  .q-header {
    margin-bottom: 1.2rem;
  }

  .q-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    margin-bottom: 0.5rem;
  }

  .q-header h4 {
    margin: 0;
    font-size: 1.08rem;
    color: #f8fafc;
    line-height: 1.45;
  }

  .q-options {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .q-opt-btn {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    text-align: left;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.85rem 1.1rem;
    color: #cbd5e1;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .q-opt-btn:hover:not(:disabled) {
    background: rgba(56, 189, 248, 0.1);
    border-color: #38bdf8;
    color: #f8fafc;
  }

  .q-opt-btn.is-correct {
    background: rgba(16, 185, 129, 0.18) !important;
    border-color: #10b981 !important;
    color: #6ee7b7 !important;
    font-weight: 700;
  }

  .q-opt-btn.is-wrong {
    background: rgba(239, 68, 68, 0.18) !important;
    border-color: #ef4444 !important;
    color: #fca5a5 !important;
  }

  .opt-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.78rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .q-feedback {
    margin-top: 1rem;
    padding: 0.85rem 1.1rem;
    border-radius: 8px;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .feedback-correct {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #6ee7b7;
  }

  .feedback-wrong {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #fca5a5;
  }

  /* =========================================================================
     MODO CLARO (LIGHT THEME SUPPORT)
     ========================================================================= */
  :global([data-theme="light"]) .prime-atom-card,
  :global([data-theme="light"]) .proof-container-card,
  :global([data-theme="light"]) .myth-bust-card,
  :global([data-theme="light"]) .lab-container,
  :global([data-theme="light"]) .graph-card,
  :global([data-theme="light"]) .lab-telemetry-panel,
  :global([data-theme="light"]) .alt-proof-card,
  :global([data-theme="light"]) .sin-card,
  :global([data-theme="light"]) .quiz-card,
  :global([data-theme="light"]) .lemma-box {
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.1);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
  }

  :global([data-theme="light"]) .atom-col h4,
  :global([data-theme="light"]) .lemma-box h4,
  :global([data-theme="light"]) .myth-bust-card h4,
  :global([data-theme="light"]) .myth-branch h5,
  :global([data-theme="light"]) .euclid-table-container h4,
