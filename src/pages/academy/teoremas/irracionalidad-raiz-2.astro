<script>
  // =========================================================================
  // SIMULADOR INTERACTIVO DEL CAZADOR DE APROXIMACIONES RACIONALES (PELL)
  // =========================================================================

  let curA = 3;
  let curB = 2;

  const svgTennen = document.getElementById('svg-tennenbaum') as SVGSVGElement | null;
  const sliderA = document.getElementById('slider-num-a') as HTMLInputElement | null;
  const sliderB = document.getElementById('slider-den-b') as HTMLInputElement | null;

  const dispValA = document.getElementById('disp-val-a');
  const dispValB = document.getElementById('disp-val-b');

  const metricRatio = document.getElementById('metric-ratio');
  const teleFracVal = document.getElementById('tele-frac-val');
  const telePell = document.getElementById('tele-pell');
  const teleErrPct = document.getElementById('tele-err-pct');
  const pellMeter = document.getElementById('pell-meter');
  const telePellCaption = document.getElementById('tele-pell-caption');

  const SQRT2 = Math.SQRT2;
  const W = 580;
  const H = 260;

  function renderSim() {
    if (!svgTennen) return;

    const isLight = document.documentElement.getAttribute('data-theme') === 'light';

    const a = curA;
    const b = curB;
    const ratio = a / b;
    const pellVal = (a * a) - (2 * b * b);
    const err = Math.abs(ratio - SQRT2);

    // Geometría del cuadrado de Tennenbaum
    // Dibujamos un cuadrado grande de lado a, y dos cuadrados de lado b en esquinas opuestas
    const maxBoxSize = 210;
    const scale = maxBoxSize / Math.max(a, b * SQRT2, 1);
    const sizeA = Math.max(60, Math.min(maxBoxSize, a * scale));
    const sizeB = (b / a) * sizeA;

    const startX = (W / 2) - (sizeA / 2);
    const startY = (H / 2) - (sizeA / 2);

    // Esquinas de los dos cuadrados B
    // B1: esquina superior izquierda (startX, startY)
    // B2: esquina inferior derecha (startX + sizeA - sizeB, startY + sizeA - sizeB)
    const b2x = startX + sizeA - sizeB;
    const b2y = startY + sizeA - sizeB;

    // Región de solapamiento central (nuevo cuadrado menor):
    // ancho del solapamiento: 2b - a
    const overlapW = Math.max(0, (2 * sizeB) - sizeA);

    const goldBorder = isLight ? '#d97706' : '#fbbf24';
    const textCol = isLight ? '#0f172a' : '#f8fafc';
    const subCol = isLight ? '#64748b' : '#94a3b8';

    let svgHtml = `
      <!-- Cuadrado Grande de Lado a -->
      <rect x="${startX}" y="${startY}" width="${sizeA}" height="${sizeA}" rx="4" fill="rgba(251, 191, 36, 0.08)" stroke="${goldBorder}" stroke-width="2.2" />
      <text x="${startX + sizeA / 2}" y="${startY - 8}" font-size="12" font-weight="800" fill="${goldBorder}" text-anchor="middle" font-family="monospace">
        Área total = a² = ${a * a}
      </text>

      <!-- Cuadrado B1 (Superior Izquierdo) -->
      <rect x="${startX}" y="${startY}" width="${sizeB}" height="${sizeB}" fill="rgba(56, 189, 248, 0.2)" stroke="#38bdf8" stroke-width="1.6" stroke-dasharray="3,3" />

      <!-- Cuadrado B2 (Inferior Derecho) -->
      <rect x="${b2x}" y="${b2y}" width="${sizeB}" height="${sizeB}" fill="rgba(16, 185, 129, 0.2)" stroke="#10b981" stroke-width="1.6" stroke-dasharray="3,3" />

      <!-- Cuadrado de Solapamiento Central (Descenso Infinito) -->
      ${overlapW > 4 ? `
        <rect x="${b2x}" y="${b2y}" width="${overlapW}" height="${overlapW}" fill="rgba(244, 63, 94, 0.55)" stroke="#f43f5e" stroke-width="1.8" />
        <text x="${b2x + overlapW / 2}" y="${b2y + overlapW / 2 + 4}" font-size="10" font-weight="800" fill="#ffffff" text-anchor="middle" font-family="monospace">
          (2b - a)²
        </text>
      ` : ''}

      <!-- Rótulos de dimensiones -->
      <text x="${startX - 10}" y="${startY + sizeA / 2 + 4}" font-size="12" font-weight="800" fill="${goldBorder}" text-anchor="end" font-family="monospace">
        a = ${a}
      </text>
      <text x="${startX + sizeB / 2}" y="${startY + sizeB + 16}" font-size="11" font-weight="700" fill="#38bdf8" text-anchor="middle" font-family="monospace">
        b = ${b}
      </text>
      <text x="${b2x + sizeB / 2}" y="${b2y - 6}" font-size="11" font-weight="700" fill="#10b981" text-anchor="middle" font-family="monospace">
        b = ${b}
      </text>
    `;

    svgTennen.innerHTML = svgHtml;

    // Actualizar Textos
    if (dispValA) dispValA.textContent = String(a);
    if (dispValB) dispValB.textContent = String(b);
    if (metricRatio) metricRatio.textContent = `a / b = ${ratio.toFixed(8)}`;
    if (teleFracVal) teleFracVal.textContent = ratio.toFixed(6);

    if (telePell) {
      telePell.textContent = (pellVal > 0 ? `+${pellVal}` : String(pellVal));
      if (Math.abs(pellVal) === 1) {
        telePell.style.color = '#10b981';
      } else {
        telePell.style.color = '#fbbf24';
      }
    }

    if (teleErrPct) teleErrPct.textContent = `Error: ${err.toFixed(6)}`;

    if (pellMeter) {
      // Si el error es menor, barra más alta
      const pct = Math.max(5, Math.min(100, (1 - err / 0.1) * 100));
      pellMeter.style.width = `${pct}%`;
    }

    if (telePellCaption) {
      if (Math.abs(pellVal) === 1) {
        telePellCaption.textContent = `¡Excelente aproximación armónica! a² - 2b² = ${pellVal > 0 ? '+1' : '-1'}. Es la mejor aproximación posible para números de este tamaño.`;
      } else {
        telePellCaption.textContent = `El residuo de Pell es a² - 2b² = ${pellVal}. Para aproximarse a √2, busca pares de números donde este residuo sea exactamente ±1.`;
      }
    }
  }

  // Event Listeners Sliders
  if (sliderA) {
    sliderA.addEventListener('input', (e) => {
      curA = parseInt((e.target as HTMLInputElement).value, 10);
      renderSim();
    });
  }

  if (sliderB) {
    sliderB.addEventListener('input', (e) => {
      curB = parseInt((e.target as HTMLInputElement).value, 10);
      renderSim();
    });
  }

  // Presets Históricos
  const presetBtns = document.querySelectorAll<HTMLButtonElement>('.preset-btn');
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      curA = parseInt(btn.dataset.a || '3', 10);
      curB = parseInt(btn.dataset.b || '2', 10);

      if (sliderA) {
        sliderA.max = String(Math.max(140, curA));
        sliderA.value = String(curA);
      }
      if (sliderB) {
        sliderB.max = String(Math.max(100, curB));
        sliderB.value = String(curB);
      }

      renderSim();
    });
  });

  // Tema Claro / Oscuro
  const themeObserver = new MutationObserver(() => {
    renderSim();
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  renderSim();

  // =========================================================================
  // SISTEMA DE AUTOEVALUACIÓN CONCEPTUAL (QUIZ)
  // =========================================================================
  const quizCards = document.querySelectorAll<HTMLElement>('.quiz-card');
  const FEEDBACK_MSGS: Record<string, { correct: string; incorrect: string }> = {
    '1': {
      correct: '¡Brillante! El motor de la prueba es precisamente ese: partimos de la hipótesis de que la fracción estaba totalmente simplificada (mcd=1), pero el razonamiento nos lleva inexorablemente a que tanto a como b son pares (mcd≥2), lo cual es imposible.',
      incorrect: 'Incorrecto. La contradicción surge de la naturaleza de las fracciones irreducibles: si la fracción es irreducible, numerador y denominador no pueden ser ambos pares.',
    },
    '2': {
      correct: '¡Exacto! Al ser 4 un cuadrado perfecto (2²), 4b² = (2k)² da 4b² = 4k² ⟹ b² = k², lo que no impone que b deba tener ningún factor 2. La prueba colapsa de forma natural.',
      incorrect: 'Incorrecto. En el caso de √4 = 2, la ecuación es b² = k², lo que no exige que b sea par ni genera ninguna contradicción aritmética.',
    },
    '3': {
      correct: '¡Totalmente correcto! Es una propiedad directa de los números primos (Lema de Euclides): si un número primo p divide a un producto (a · a), forzosamente debe dividir a uno de los factores.',
      incorrect: 'Incorrecto. Por el Teorema Fundamental de la Aritmética y el Lema de Euclides, si un número primo divide a a², necesariamente divide a a.',
    },
    '4': {
      correct: '¡Impecable! √2 es la raíz del polinomio algebraico x² - 2 = 0 con coeficientes enteros. Por tanto es un irracional algebraico, no trascendente.',
      incorrect: 'Incorrecto. √2 no es trascendente: es una solución exacta del polinomio elemental x² - 2 = 0. Los números trascendentes son aquellos que no son raíz de ningún polinomio algebraico.',
    },
  };

  quizCards.forEach((card) => {
    const qId = card.dataset.q || '';
    const btns = card.querySelectorAll<HTMLButtonElement>('.q-opt-btn');
    const fbBox = card.querySelector<HTMLElement>('.q-feedback');
    const fbText = card.querySelector<HTMLElement>('.fb-text');

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isCorrect = btn.dataset.correct === 'true';

        btns.forEach((b) => {
          b.disabled = true;
          if (b.dataset.correct === 'true') {
            b.classList.add('is-right');
          } else if (b === btn) {
            b.classList.add('is-wrong');
          }
        });

        if (fbBox && fbText) {
          fbBox.classList.remove('hidden', 'success', 'failure');
          fbBox.classList.add(isCorrect ? 'success' : 'failure');
          fbText.textContent = isCorrect ? FEEDBACK_MSGS[qId]?.correct : FEEDBACK_MSGS[qId]?.incorrect;
        }
      });
    });
  });
</script>

