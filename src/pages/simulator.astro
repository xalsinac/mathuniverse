        </div>

        <!-- PANEL DE CONTROLES PHET (SLIDERS Y SELECTORES) -->
        <div class="workbench-controls">
          <div class="controls-card">
            <h3 class="controls-heading">Parámetros del Sistema</h3>

            <!-- TIPO DE ONDA -->
            <div class="ctrl-group">
              <label class="ctrl-label">Forma de onda objetivo:</label>
              <div class="btn-segmented">
                <button type="button" class="seg-btn active" data-wave="sine">Senoidal</button>
                <button type="button" class="seg-btn" data-wave="square">Cuadrada</button>
                <button type="button" class="seg-btn" data-wave="sawtooth">Diente Sierra</button>
                <button type="button" class="seg-btn" data-wave="triangle">Triangular</button>
              </div>
            </div>

            <!-- AMPLITUD -->
            <div class="ctrl-group">
              <div class="ctrl-row">
                <label for="sl-amp">Amplitud (A):</label>
                <strong id="val-amp">45 px</strong>
              </div>
              <input type="range" id="sl-amp" min="10" max="80" value="45" />
            </div>

            <!-- FRECUENCIA ANGULAR -->
            <div class="ctrl-group">
              <div class="ctrl-row">
                <label for="sl-freq">Frecuencia angular (ω):</label>
                <strong id="val-freq">1.2 rad/s</strong>
              </div>
              <input type="range" id="sl-freq" min="0.2" max="3.5" step="0.1" value="1.2" />
            </div>

            <!-- NÚMERO DE ARMÓNICOS (FOURIER) -->
            <div class="ctrl-group">
              <div class="ctrl-row">
                <label for="sl-harmonics">Términos de Fourier (N):</label>
                <strong id="val-harmonics">1 (Fundamental)</strong>
