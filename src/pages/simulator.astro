---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../config/site';
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface SimulationItem {
  id: string;
  title: string;
  shortTitle?: string;
  category: 'calculo' | 'algebra' | 'trigonometria' | 'probabilidad' | 'geometria' | 'fisica';
  categoryLabel: string;
  level: 'ESO' | 'Bachillerato' | 'Universidad / Transversal';
  badge: string;
  desc: string;
  formula: string;
  formulaHtml?: string;
  features: string[];
  inPhetStyle: string;
  accentColor: string;
  icon: string;
  hasLiveDemo?: boolean;
  href?: string;
}

const renderMath = (latex: string, displayMode = true) => {
  try {
    return katex.renderToString(latex, {
      displayMode,
      throwOnError: false,
    });
  } catch {
    return `<span class="sf-fallback">${latex}</span>`;
  }
};

const rawSimulations: SimulationItem[] = [
  {
    id: 'ondas-fourier',
    title: 'Síntesis de Ondas & Serie de Fourier',
    shortTitle: 'Ondas & Serie de Fourier',
    category: 'trigonometria',
    categoryLabel: 'Trigonometría & Ondas',
    level: 'Bachillerato',
    badge: 'DEMO EN VIVO ARRIBA',
    desc: 'Construye ondas cuadradas, triangulares y dientes de sierra sumando armónicos sinusoidales puros con su vector de fase rotatorio acoplado.',
    formula: String.raw`f(t) = \sum_{n=1}^{N} A_n \sin(n\omega t + \phi_n)`,
    features: ['Controles de armónicos N', 'Círculo fasorial rotatorio', 'Visualización espectral'],
    inPhetStyle: 'Inspirada en Fourier: Making Waves (PhET)',
    accentColor: '#06b6d4',
    icon: '🌊',
    hasLiveDemo: true
  },
  {
    id: 'vectores-2d3d',
    title: 'Vectores, Producto Escalar y Proyecciones',
    shortTitle: 'Vectores & Producto Escalar',
    category: 'algebra',
    categoryLabel: 'Álgebra Lineal & Vectores',
    level: 'Bachillerato',
    badge: 'LABORATORIO 2D/3D',
    desc: 'Arrastra las puntas de flecha de los vectores u⃗ y v⃗ para observar su suma analítica, el ángulo θ resultante, la proyección ortogonal y el producto escalar u⃗ · v⃗.',
    formula: String.raw`\vec{u} \cdot \vec{v} = \|\vec{u}\| \|\vec{v}\| \cos(\theta) = u_x v_x + u_y v_y`,
    features: ['Plano cartesiano milimetrado', 'Proyección ortogonal en vivo', 'Descomposición cartesiana y polar'],
    inPhetStyle: 'Inspirada en Vector Addition (PhET)',
    accentColor: '#38bdf8',
    icon: '↗️'
  },
  {
    id: 'derivada-tangente',
    title: 'La Derivada y la Recta Tangente Dinámica',
    shortTitle: 'La Derivada & Recta Tangente',
    category: 'calculo',
    categoryLabel: 'Cálculo & Funciones',
    level: 'Bachillerato',
    badge: 'CÁLCULO DINÁMICO',
    desc: 'Desplaza un punto x sobre cualquier función polinómica o trigonométrica. Observa cómo la secante colapsa en la tangente y cómo se dibuja la curva de la función derivada f\'(x).',
    formula: String.raw`f'(x) = \lim_{\Delta x \to 0} \frac{f(x+\Delta x) - f(x)}{\Delta x}`,
    features: ['Paso al límite de secante a tangente', 'Trazador en vivo de f\'(x)', 'Selección de funciones f(x)'],
    inPhetStyle: 'Inspirada en Calculus Grapher (PhET)',
    accentColor: '#10b981',
    icon: '📈',
    href: '/simulator/calculo-visual-3d?tab=deriv'
  },
  {
    id: 'tablero-galton',
    title: 'Tablero de Galton & Campana de Gauss',
    shortTitle: 'Tablero de Galton & Gauss',
    category: 'probabilidad',
    categoryLabel: 'Probabilidad & Estadística',
    level: 'ESO',
    badge: 'ESTOCÁSTICA EN VIVO',
    desc: 'Deja caer cientos de canicas a través de una pirámide de clavos de Galton (Plinko). Observa cómo las decisiones binarias aleatorias forman la distribución normal gaussiana.',
    formula: String.raw`f(x) = \frac{1}{\sigma \sqrt{2\pi}} \exp\left(-\frac{(x-\mu)^2}{2\sigma^2}\right)`,
    features: ['Simulación física de partículas', 'Histograma en tiempo real', 'Teorema Central del Límite'],
    inPhetStyle: 'Inspirada en Plinko Probability (PhET)',
    accentColor: '#f59e0b',
    icon: '🎲',
    href: '/simulator/tablero-galton'
  },
  {
    id: 'circulo-unitario',
    title: 'La Esencia de la Trigonometría en 3D',
    shortTitle: 'Círculo Unitario · Seno · Tangente',
    category: 'trigonometria',
    categoryLabel: 'Trigonometría & Ondas',
    level: 'Bachillerato',
    badge: 'ESPACIO & TIEMPO 3D',
    desc: 'Observa en 3D cómo la rotación en el círculo unitario genera las ondas de seno, coseno y las ramas de la tangente al proyectarse en el tiempo a lo largo de una hélice.',
    formula: String.raw`\sin^2(\theta) + \cos^2(\theta) = 1 \quad\Longleftrightarrow\quad x^2 + y^2 = 1`,
    features: ['Cámara 3D con órbita libre y zoom', 'Despliegue de ondas y hélice 3D', 'Tangente y cotangente asintóticas'],
    inPhetStyle: 'Inspirada en MathViz & Trig Tour (PhET)',
    accentColor: '#38bdf8',
    icon: '⭕',
    href: '/simulator/trigonometria-3d'
  },
  {
    id: 'identidades-trig-3d',
    title: 'Identidades Trigonométricas en 3D',
    shortTitle: 'Identidades Trigonométricas',
    category: 'trigonometria',
    categoryLabel: 'Trigonometría & Álgebra',
    level: 'Bachillerato',
    badge: 'MÁQUINA DE IDENTIDADES',
    desc: 'Deduce sin memorizar las fórmulas de la suma de ángulos (α + β), los espejos de reducción al primer cuadrante y la combinación lineal a·sin + b·cos = R·sin(θ + φ).',
    formula: String.raw`\cos(\alpha + \beta) = \cos\alpha\cos\beta - \sin\alpha\sin\beta`,
    features: ['Deducción geométrica paso a paso', 'Espejos de simetría horizontal/vertical', 'Fasor auxiliar y ángulo doble'],
    inPhetStyle: 'Inspirada en MathViz & 3Blue1Brown',
    accentColor: '#fb7185',
    icon: '🪞',
    href: '/simulator/identidades-trigonometricas-3d'
  },
  {
    id: 'secciones-conicas-3d',
    title: 'Secciones Cónicas en 3D: Cono de Apolonio & Dandelin',
    shortTitle: 'La Esencia de las Cónicas',
    category: 'geometria',
    categoryLabel: 'Geometría Analítica 3D',
    level: 'Bachillerato',
    badge: 'CONO DE APOLONIO & DANDELIN',
    desc: 'Corta el cono doble con un plano variable. Alterna al instante con botones dedicados entre circunferencia, elipse, parábola e hipérbola según la inclinación β. Explora las esferas de Dandelin y la definición unificada foco-directriz.',
    formula: String.raw`e = \tan\beta \quad\Longleftrightarrow\quad r(\theta) = \frac{p}{1 + e\cos\theta}`,
    features: ['Botones directos de cónicas (Círculo, Elipse, Parábola, Hipérbola)', 'Doble cono 3D con plano secante dinámico', 'Esferas de Dandelin y deducción foco-directriz'],
    inPhetStyle: 'Inspirada en MathViz & Apolonio de Perge',
    accentColor: '#a855f7',
    icon: '📐',
    href: '/simulator/secciones-conicas-3d'
  },
  {
    id: 'esencia-de-pi-3d',
    title: 'La Esencia de π en 3D: Longitud, Arquímedes, Kepler, Azar y Series',
    shortTitle: 'La Esencia de π',
    category: 'geometria',
    categoryLabel: 'Geometría, Cálculo & Azar',
    level: 'Bachillerato',
    badge: 'CONSTANTE UNIVERSAL π',
    desc: 'Descubre la firma universal de π en 5 escenas: rueda desenrollada y cicloide, método de exhaustión de Arquímedes con n=6..192, puzle de disección del área de Kepler, probabilidad Monte Carlo y Buffon, y series oscilantes de Leibniz y Euler.',
    formula: String.raw`\pi = \lim_{n \to \infty} n\sin\left(\frac{\pi}{n}\right) = 4\sum_{k=1}^\infty \frac{(-1)^{k-1}}{2k-1} = \sqrt{6\sum_{k=1}^\infty \frac{1}{k^2}}`,
    features: ['5 escenarios interactivos 3D', 'Metamorfosis animada de círculo a rectángulo', 'Generador estocástico Monte Carlo y Agujas de Buffon'],
    inPhetStyle: 'Inspirada en MathViz, 3Blue1Brown y Arquímedes',
    accentColor: '#f59e0b',
    icon: '🥧',
    href: '/simulator/esencia-de-pi-3d'
  },
  {
    id: 'regresion-lineal',
    title: 'Regresión Lineal y Mínimos Cuadrados',
    shortTitle: 'Regresión Lineal (Mínimos Cuadrados)',
    category: 'probabilidad',
    categoryLabel: 'Probabilidad & Estadística',
    level: 'Bachillerato',
    badge: 'ANÁLISIS DE DATOS',
    desc: 'Coloca puntos experimentales con clics sobre el plano cartesiano. Visualiza los cuadrados de los residuos y cómo la recta de ajuste óptimo minimiza la suma del error cuadrático.',
    formula: String.raw`S(m,n) = \min_{m,n} \sum_{i=1}^{N} \big(y_i - (m x_i + n)\big)^2`,
    features: ['Representación visual de residuos', 'Cálculo de R² de correlación', 'Arrastre interactivo de datos'],
    inPhetStyle: 'Inspirada en Least-Squares Regression (PhET)',
    accentColor: '#ec4899',
    icon: '📉'
  },
  {
    id: 'sumas-riemann',
    title: 'Sumas de Riemann & Área Bajo la Curva',
    shortTitle: 'Sumas de Riemann & Integrales',
    category: 'calculo',
    categoryLabel: 'Cálculo & Funciones',
    level: 'Bachillerato',
    badge: 'INTEGRACIÓN',
    desc: 'Aumenta el número de rectángulos n desde 2 hasta 200. Compara la suma izquierda, derecha, trapezoidal y punto medio con el valor exacto de la integral definida de Riemann.',
    formula: String.raw`\int_{a}^{b} f(x)\,dx = \lim_{n \to \infty} \sum_{i=1}^{n} f(x_i^*)\,\Delta x`,
    features: ['Selector de partición n rectángulos', 'Comparador de sumas inf/sup', 'Error de cuadratura numérico'],
    inPhetStyle: 'Inspirada en Area Model & Integration (PhET)',
    accentColor: '#14b8a6',
    icon: '📊',
    href: '/simulator/calculo-visual-3d?tab=riemann'
  },
  {
    id: 'pendulo-simple',
    title: 'Péndulo Físico & Espacio de Fases',
    shortTitle: 'Péndulo Físico & Espacio de Fases',
    category: 'fisica',
    categoryLabel: 'Física Matemática',
    level: 'Universidad / Transversal',
    badge: 'SISTEMAS DINÁMICOS',
    desc: 'Simula el movimiento de un péndulo bajo gravedad y fricción variable. Visualiza en paralelo la trayectoria temporal θ(t) y la curva en el espacio de fases (θ, ω).',
    formula: String.raw`\frac{d^2\theta}{dt^2} + \frac{g}{L} \sin(\theta) = 0`,
    features: ['Aproximación de ángulos pequeños', 'Gráfica de energía cinética/potencial', 'Retrato de fase orbital'],
    inPhetStyle: 'Inspirada en Pendulum Lab (PhET)',
    accentColor: '#0ea5e9',
    icon: '⏱️'
  },
  {
    id: 'esencia-de-i-3d',
    title: 'La Esencia de i en 3D: Rotación, Cardano, Raíces Ocultas y Matrices',
    shortTitle: 'La Esencia de i (Imaginarios)',
    category: 'algebra',
    categoryLabel: 'Álgebra Lineal & Complejos',
    level: 'Bachillerato',
    badge: 'ESPACIO COMPLEJO 3D',
    desc: 'Desmitifica la unidad imaginaria i en 5 escenas: el cuarto de vuelta (rotación 90°), el enigma de Cardano x³ = 15x + 4, raíces fuera del papel en la superficie |p(z)|, gemelos espejo conjugados y la matriz real J² = −I.',
    formula: String.raw`i = \begin{pmatrix} 0 & -1 \\ 1 & 0 \end{pmatrix} \;\Longrightarrow\; i^2 = -1 \;\Longleftrightarrow\; e^{i\pi/2} = i`,
    features: ['5 escenarios interactivos 3D', 'Resolución de la cúbica de Cardano', 'Superficie de módulo y matrices de rotación'],
    inPhetStyle: 'Inspirada en MathViz, Bombelli y Gauss',
    accentColor: '#818cf8',
    icon: '🌀',
    href: '/simulator/esencia-de-i-3d'
  },
  {
    id: 'esencia-de-e-3d',
    title: 'La Esencia de e en 3D: Interés Compuesto, Autoderivada y Hélice de Euler',
    shortTitle: 'La Esencia de e (Euler)',
    category: 'calculo',
    categoryLabel: 'Cálculo & Funciones',
    level: 'Bachillerato',
    badge: 'CRECIMIENTO CONTINUO',
    desc: 'Descubre la firma de e ≈ 2.71828 en 6 escenas: interés compuesto continuo, la función que es su propia derivada (y\' = y), campo de pendientes, área unitaria bajo 1/x, probabilidad 1/e y la hélice 3D de Euler e^(iθ).',
    formula: String.raw`e = \lim_{n \to \infty}\left(1 + \frac{1}{n}\right)^n \;\Longrightarrow\; \frac{d}{dx}(e^x) = e^x \;\Longrightarrow\; e^{i\pi} + 1 = 0`,
    features: ['6 escenarios interactivos 3D', 'Hélice compleja de Euler con sombras sin/cos', 'Autoderivada en vivo y área unitaria ∫(1/x)dx = 1'],
    inPhetStyle: 'Inspirada en MathViz, Bernoulli y Euler',
    accentColor: '#10b981',
    icon: '🌿',
    href: '/simulator/esencia-de-e-3d'
  },
  {
    id: 'puntos-notables-triangulo',
    title: 'Puntos Notables del Triángulo & Recta de Euler',
    shortTitle: 'Puntos Notables (H, G, I, O)',
    category: 'geometria',
    categoryLabel: 'Geometría Sintética',
    level: 'ESO',
    badge: 'CONSTRUCCIÓN INTERACTIVA',
    desc: 'Arrastra los vértices A, B, C en tiempo real y observa cómo se trazan medianas (Baricentro G / centro de masa), mediatrices (Circuncentro O), bisectrices (Incentro I) y alturas (Ortocentro H), además de la Recta de Euler.',
    formula: String.raw`G = \frac{A + B + C}{3} \quad\Longrightarrow\quad \overrightarrow{HG} = 2\,\overrightarrow{GO}`,
    features: ['Arrastre directo de vértices y trazado animado', 'Marcas de 90°, ángulos y circunferencias', 'Datos curiosos físicos y Recta de Euler en vivo'],
    inPhetStyle: 'Inspirada en GeoGebra & Leonhard Euler',
    accentColor: '#a855f7',
    icon: '🔺',
    href: '/simulator/puntos-notables-triangulo'
  }
];

const simulations = rawSimulations.map((sim) => ({
  ...sim,
  formulaHtml: renderMath(sim.formula, true),
}));

const CATEGORY_GROUPS = [
  {
    key: 'trigonometria',
    title: 'TRIGONOMETRÍA & ONDAS',
    accent: '#38bdf8',
    sims: simulations.filter((s) => s.category === 'trigonometria')
  },
  {
    key: 'geometria',
    title: 'GEOMETRÍA & CÓNICAS 3D',
    accent: '#a855f7',
    sims: simulations.filter((s) => s.category === 'geometria')
  },
  {
    key: 'algebra',
    title: 'ÁLGEBRA LINEAL & VECTORES',
    accent: '#06b6d4',
    sims: simulations.filter((s) => s.category === 'algebra')
  },
  {
    key: 'calculo',
    title: 'CÁLCULO & FUNCIONES',
    accent: '#10b981',
    sims: simulations.filter((s) => s.category === 'calculo')
  },
  {
    key: 'probabilidad',
    title: 'PROBABILIDAD & ESTADÍSTICA',
    accent: '#f59e0b',
    sims: simulations.filter((s) => s.category === 'probabilidad')
  },
  {
    key: 'fisica',
    title: 'FÍSICA MATEMÁTICA',
    accent: '#0ea5e9',
    sims: simulations.filter((s) => s.category === 'fisica')
  }
];
---

<BaseLayout
  title={`Math Simulator — Simulaciones Matemáticas y Modelos PhET | ${site.name}`}
  description="Laboratorios matemáticos interactivos estilo PhET Colorado. Experimenta con parámetros en vivo, funciones dinámicas, vectores, ondas, series de Fourier y modelos estocásticos."
>
  <SiteHeader activePage="simulator" statusText="08 · Math Simulator" ctaHref="/#recursos" ctaLabel="Math Universe" />

  <div class="sim-page-wrapper" id="simPageWrapper">

    <!-- =========================================================================
         PANEL LATERAL (SIDEBAR) · ESTILO MATHVIZ
         ========================================================================= -->
    <aside class="sim-sidebar" id="simSidebar" aria-label="Navegador de simulaciones matemáticas">
      <div class="sidebar-inner">
        <!-- HEADER DEL PANEL LATERAL -->
        <div class="sidebar-header">
          <div class="sidebar-brand-group">
            <span class="sidebar-brand-sub">INTERACTIVE MATH</span>
            <div class="sidebar-title-row">
              <span class="sidebar-brand-icon">⚡</span>
              <h2 class="sidebar-brand-name">Math Simulator</h2>
            </div>
          </div>
          <button type="button" class="sidebar-toggle-btn" id="sidebarCollapseBtn" title="Colapsar panel lateral" aria-label="Colapsar panel lateral">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
        </div>

        <!-- BUSCADOR EN VIVO DE HERRAMIENTAS -->
        <div class="sidebar-search-wrap">
          <div class="sidebar-search-box">
            <svg class="search-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="sidebarSearchInput" placeholder="Buscar simulaciones..." aria-label="Buscar simulaciones" />
            <button type="button" id="sidebarSearchClear" class="search-clear-btn" aria-label="Limpiar búsqueda" style="display: none;">×</button>
          </div>
        </div>

        <!-- ACCESO GALERÍA COMPLETA -->
        <div class="sidebar-nav-all-wrap">
          <button type="button" class="sidebar-nav-all-btn active" id="sidebarAllFilterBtn" data-filter="all">
            <span class="all-btn-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              </svg>
            </span>
            <span class="all-btn-label">Todas las simulaciones</span>
            <span class="all-btn-count">{simulations.length}</span>
          </button>
        </div>

        <!-- LISTADO POR CATEGORÍAS -->
        <div class="sidebar-scroll-area" id="sidebarScrollArea">
          {CATEGORY_GROUPS.map((group) => (
            <div class="sidebar-group" data-cat-key={group.key}>
              <div class="sidebar-group-header">
                <span class="sidebar-group-title">{group.title}</span>
              </div>
              <ul class="sidebar-item-list">
                {group.sims.map((sim) => (
                  <li
                    class="sidebar-item"
                    data-id={sim.id}
                    data-cat={sim.category}
                    data-search={`${sim.title} ${sim.shortTitle || ''} ${sim.features.join(' ')}`.toLowerCase()}
                  >
                    <a
                      href={sim.href || (sim.hasLiveDemo ? '#lab-fourier' : `#sim-card-${sim.id}`)}
                      class="sidebar-item-link"
                      data-target-id={sim.id}
                      data-is-direct={Boolean(sim.href)}
                      title={`${sim.title} · ${sim.categoryLabel}`}
                    >
                      <span
                        class="status-dot"
                        style={`--dot-color: ${sim.accentColor};`}
                        title={`Categoría: ${sim.categoryLabel}`}
                      ></span>
                      <span class="item-title">{sim.shortTitle || sim.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- PIE DEL PANEL LATERAL -->
        <div class="sidebar-footer">
          <div class="sf-stats">
            <span class="sf-stat-dot"></span>
            <span>{simulations.length} laboratorios listos</span>
          </div>
          <a href="/#recursos" class="sf-link-home">
            <span>← Índice Math Universe</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- BOTÓN FLOTANTE PARA REABRIR PANEL CUANDO ESTÁ COLAPSADO O EN MÓVIL -->
    <button type="button" class="sidebar-expand-btn" id="sidebarExpandBtn" title="Abrir panel de simulaciones" aria-label="Abrir panel lateral de simulaciones">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
      <span class="expand-btn-text">Simulaciones</span>
    </button>

    <!-- TELÓN DE FONDO PARA DISPOSITIVOS MÓVILES -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

    <!-- ENVOLTORIO DE CONTENIDO PRINCIPAL -->
    <div class="sim-content-wrapper">
      <main class="sim-main-container">

        <!-- =========================================================================
             1. HERO DE MATH SIMULATOR CON TRIPLE ONDA SENOIDAL SUAVE
             ========================================================================= -->
        <section class="sim-hero">
          <!-- LIENZO TRIPLE ONDA SINUSOIDAL CON DESPLAZAMIENTO LENTO DETRÁS DEL TÍTULO -->
          <canvas id="heroWavesCanvas" class="hero-waves-canvas" aria-hidden="true"></canvas>
          <div class="sim-hero-glow"></div>
          <div class="sim-hero-content">
            <div class="sim-hero-kicker">
              <span class="pulse-dot"></span>
              <span>MODELOS MATEMÁTICOS DINÁMICOS &amp; LABORATORIOS INTERACTIVOS</span>
            </div>
            <h1 class="sim-hero-title">
              <span class="word-math">MATH</span>
              <span class="word-sim">SIMULATOR</span>
            </h1>
            <p class="sim-hero-desc">
              Entornos interactivos para manipular variables en tiempo real. Inspirados en la filosofía de <strong>PhET Interactive Simulations</strong> y <strong>MathViz</strong>, aquí las fórmulas se convierten en fenómenos visuales que puedes tocar, pausar y transformar para construir una <strong>intuición matemática genuina</strong>.
            </p>

            <div class="sim-hero-controls-hint">
              <span>Funciona en el navegador, sin instalar nada</span>
              <span class="hint-sep">·</span>
              <span>Arrastrar para rotar</span>
              <span class="hint-sep">·</span>
              <span>Shift + arrastrar para desplazar</span>
              <span class="hint-sep">·</span>
              <span>Rueda para zoom</span>
              <span class="hint-sep">·</span>
              <span>Doble clic para reiniciar</span>
            </div>
          </div>
        </section>

    <!-- =========================================================================
         2. SIMULADOR DESTACADO ACTIVO EN VIVO: LABORATORIO DE ONDAS & FOURIER
         ========================================================================= -->
    <section class="live-lab-section" id="lab-fourier">
      <div class="live-lab-header">
        <div class="live-lab-title-group">
          <span class="live-chip">LABORATORIO EN VIVO N.º 1</span>
          <h2>Síntesis Armónica de Ondas y Serie de Fourier</h2>
          <p>
