              <input type="range" id="sl-harmonics" min="1" max="15" step="1" value="1" />
              <div class="harmonics-hint">Añade armónicos impares para aproximar la forma discontinua.</div>
            </div>

            <!-- TOGGLES VISUALES -->
            <div class="ctrl-toggles">
              <label class="sim-toggle">
                <input type="checkbox" id="chk-show-phasor" checked />
                <span>Mostrar círculo fasorial rotatorio</span>
              </label>
              <label class="sim-toggle">
                <input type="checkbox" id="chk-show-grid" checked />
                <span>Mostrar rejilla milimetrada</span>
              </label>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- =========================================================================
         3. CATÁLOGO COMPLETO DE SIMULACIONES MATEMÁTICAS
         ========================================================================= -->
    <section class="sim-catalog-section">
      <div class="catalog-header">
        <div class="ch-text">
          <span class="ch-eyebrow">COLECCIÓN DE MODELOS VIRTUALES</span>
          <h2>Catálogo de Simulaciones Matemáticas</h2>
          <p>Explora experimentos interactivos clasificados por ramas y niveles académicos.</p>
        </div>

        <!-- FILTROS DE CATEGORÍA -->
        <div class="filter-pills-row">
          <button type="button" class="cat-pill active" data-filter="all">Todas ({simulations.length})</button>
          <button type="button" class="cat-pill" data-filter="trigonometria">Trigonometría &amp; Ondas</button>
          <button type="button" class="cat-pill" data-filter="geometria">Geometría &amp; Cónicas 3D</button>
          <button type="button" class="cat-pill" data-filter="algebra">Álgebra &amp; Vectores</button>
          <button type="button" class="cat-pill" data-filter="calculo">Cálculo &amp; Análisis</button>
          <button type="button" class="cat-pill" data-filter="probabilidad">Probabilidad &amp; Datos</button>
          <button type="button" class="cat-pill" data-filter="fisica">Física Matemática</button>
        </div>
      </div>

      <!-- GRID DE TARJETAS DE SIMULACIÓN -->
      <div class="sim-cards-grid" id="sim-cards-container">
        {simulations.map((sim) => (
          <article class="sim-card" id={`sim-card-${sim.id}`} data-category={sim.category} style={`--card-accent: ${sim.accentColor};`}>
            <div class="sim-card-top">
              <div class="sim-chip-row">
                <span class="sim-category-chip">{sim.categoryLabel}</span>
                <span class="sim-level-badge">{sim.level}</span>
              </div>
              <span class="sim-card-icon">{sim.icon}</span>
            </div>

            <h3 class="sim-card-title">{sim.title}</h3>
            <p class="sim-card-desc">{sim.desc}</p>

            <div class="sim-formula-box">
              <span class="sf-label">Modelo Teórico</span>
              <div class="sf-math" set:html={sim.formulaHtml} />
