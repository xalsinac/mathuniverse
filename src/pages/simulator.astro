            <div class="sim-card-footer">
              <span class="phet-note">{sim.inPhetStyle}</span>
              {sim.href ? (
                <a href={sim.href} class="btn-launch-sim primary">
                  <span>Abrir Laboratorio 3D ↗</span>
                </a>
              ) : sim.hasLiveDemo ? (
                <a href="#lab-fourier" class="btn-launch-sim primary">
                  <span>Probar en vivo ↑</span>
                </a>
              ) : (
                <button type="button" class="btn-launch-sim" data-open-info={sim.id}>
                  <span>Ver Ficha Técnica →</span>
                </button>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- =========================================================================
         4. MANIFIESTO PEDAGÓGICO · POR QUÉ SIMULAR MATEMÁTICAS
         ========================================================================= -->
    <section class="philosophy-section">
      <div class="philosophy-card">
        <span class="ph-eyebrow">METODOLOGÍA EDUCATIVA</span>
        <h2 class="ph-title">La Filosofía del Aprendizaje Activo en Math Simulator</h2>
        <div class="ph-grid">
          <div class="ph-item">
            <div class="ph-icon">🔍</div>
            <h3>Intuición antes que Algoritmos</h3>
            <p>
              Antes de aprender a derivar o integrar de memoria sobre el papel, manipular la pendiente de la recta tangente y ver cómo se generan los rectángulos de Riemann crea una conexión conceptual imborrable.
            </p>
          </div>
          <div class="ph-item">
            <div class="ph-icon">⚖️</div>
            <h3>Dualidad Gráfica-Algebraica</h3>
            <p>
              Cada vez que mueves un control deslizante en Math Simulator, la ecuación analítica cambia al instante en paralelo con la gráfica. No hay símbolos abstractos aislados: cada letra representa una dimensión visible.
            </p>
          </div>
          <div class="ph-item">
            <div class="ph-icon">🧪</div>
            <h3>Laboratorio Libre de Frustración</h3>
            <p>
              El alumno puede equivocarse, llevar parámetros al infinito o a cero, y ver las consecuencias físicas y geométricas sin la presión de un examen formal. La curiosidad es el motor del rigor matemático.
            </p>
          </div>
        </div>
      </div>
    </section>

      </main>
    </div><!-- /.sim-content-wrapper -->

  </div><!-- /#simPageWrapper -->
</BaseLayout>

<script>
  import katex from 'katex';

  (() => {
    // =========================================================================
    // 1. MOTOR GRÁFICO INTERACTIVO DE ONDAS & FOURIER (PHET STYLE)
    // =========================================================================
    const canvas = document.getElementById('fourier-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;

    // Controles
    const slAmp = document.getElementById('sl-amp') as HTMLInputElement;
    const valAmp = document.getElementById('val-amp') as HTMLElement;
    const slFreq = document.getElementById('sl-freq') as HTMLInputElement;
    const valFreq = document.getElementById('val-freq') as HTMLElement;
    const slHarmonics = document.getElementById('sl-harmonics') as HTMLInputElement;
    const valHarmonics = document.getElementById('val-harmonics') as HTMLElement;
    const chkPhasor = document.getElementById('chk-show-phasor') as HTMLInputElement;
    const chkGrid = document.getElementById('chk-show-grid') as HTMLInputElement;
    const btnTogglePlay = document.getElementById('btn-toggle-play') as HTMLButtonElement;
    const playIcon = document.getElementById('play-icon') as HTMLElement;
    const playText = document.getElementById('play-text') as HTMLElement;
    const btnReset = document.getElementById('btn-reset-sim') as HTMLButtonElement;
    const liveFormula = document.getElementById('live-fourier-formula') as HTMLElement;

    const segButtons = document.querySelectorAll('.seg-btn');

    let isPlaying = true;
    let waveType: 'sine' | 'square' | 'sawtooth' | 'triangle' = 'sine';
    let time = 0;

    // Estado de parámetros
    let amp = parseFloat(slAmp.value) || 45;
    let freq = parseFloat(slFreq.value) || 1.2;
    let harmonics = parseInt(slHarmonics.value, 10) || 1;

    const updateFormulaText = () => {
      if (!liveFormula) return;
      const omegaStr = freq.toFixed(1);
      const ampInt = Math.round(amp);
      let latex = '';

      if (waveType === 'sine') {
        latex = String.raw`f(t) = ${ampInt} \sin(${omegaStr} t)`;
      } else if (waveType === 'square') {
        latex = String.raw`f(t) = \frac{4 \cdot ${ampInt}}{\pi} \sum_{k=1}^{${harmonics}} \frac{\sin\big((2k-1)${omegaStr} t\big)}{2k-1}`;
      } else if (waveType === 'sawtooth') {
        latex = String.raw`f(t) = \frac{2 \cdot ${ampInt}}{\pi} \sum_{k=1}^{${harmonics}} \frac{(-1)^{k+1} \sin\big(k \cdot ${omegaStr} t\big)}{k}`;
      } else {
        latex = String.raw`f(t) = \frac{8 \cdot ${ampInt}}{\pi^2} \sum_{k=0}^{${Math.max(0, harmonics - 1)}} \frac{(-1)^k \sin\big((2k+1)${omegaStr} t\big)}{(2k+1)^2}`;
      }

      try {
        katex.render(latex, liveFormula, { displayMode: false, throwOnError: false });
      } catch {
        liveFormula.textContent = latex;
      }
    };

    // Botones segmentados de tipo de onda
    segButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        segButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        waveType = (btn.getAttribute('data-wave') || 'sine') as typeof waveType;
        updateFormulaText();
      });
    });

    // Renderizar fórmula inicial con KaTeX
    updateFormulaText();

    slAmp.addEventListener('input', () => {
      amp = parseFloat(slAmp.value);
      valAmp.textContent = `${amp} px`;
      updateFormulaText();
    });

    slFreq.addEventListener('input', () => {
      freq = parseFloat(slFreq.value);
      valFreq.textContent = `${freq.toFixed(1)} rad/s`;
      updateFormulaText();
    });

    slHarmonics.addEventListener('input', () => {
      harmonics = parseInt(slHarmonics.value, 10);
      valHarmonics.textContent = `${harmonics} ${harmonics === 1 ? '(Fundamental)' : 'armónicos'}`;
      updateFormulaText();
    });

    btnTogglePlay.addEventListener('click', () => {
      isPlaying = !isPlaying;
      playIcon.textContent = isPlaying ? '⏸️' : '▶️';
      playText.textContent = isPlaying ? 'Pausar' : 'Reanudar';
    });

    btnReset.addEventListener('click', () => {
      time = 0;
      amp = 45;
      slAmp.value = '45';
      valAmp.textContent = '45 px';

      freq = 1.2;
      slFreq.value = '1.2';
      valFreq.textContent = '1.2 rad/s';

      harmonics = 1;
      slHarmonics.value = '1';
      valHarmonics.textContent = '1 (Fundamental)';

      waveType = 'sine';
      segButtons.forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-wave') === 'sine');
      });

      updateFormulaText();
    });

    // Función de cálculo de Fourier
    const evaluateWaveAt = (t: number, xCoord: number) => {
      let y = 0;
      const kX = xCoord * 0.02;

      if (waveType === 'sine') {
        return amp * Math.sin(freq * t - kX);
      }

      for (let n = 1; n <= harmonics; n++) {
        if (waveType === 'square') {
          const k = 2 * n - 1;
          const aN = (4 * amp) / (Math.PI * k);
          y += aN * Math.sin(k * (freq * t - kX));
        } else if (waveType === 'sawtooth') {
          const aN = (2 * amp * (n % 2 === 0 ? -1 : 1)) / (Math.PI * n);
          y += aN * Math.sin(n * (freq * t - kX));
        } else if (waveType === 'triangle') {
          const k = 2 * n - 1;
          const sign = n % 2 === 0 ? -1 : 1;
          const aN = (8 * amp * sign) / (Math.PI * Math.PI * k * k);
          y += aN * Math.sin(k * (freq * t - kX));
        }
      }

      return y;
    };

    // Bucle de renderizado
    const render = () => {
      const W = canvas.width;
      const H = canvas.height;
      const centerY = H / 2;

      ctx.clearRect(0, 0, W, H);

      // Rejilla de osciloscopio
      if (chkGrid.checked) {
        ctx.save();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.06)';
        ctx.lineWidth = 1;
        for (let x = 0; x < W; x += 40) {
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, H);
          ctx.stroke();
        }
        for (let y = 0; y < H; y += 40) {
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(W, y);
          ctx.stroke();
        }

        // Eje central
        ctx.strokeStyle = 'rgba(6, 182, 212, 0.35)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(0, centerY);
        ctx.lineTo(W, centerY);
        ctx.stroke();
        ctx.restore();
      }

      const phasorCenterX = 130;
      const waveStartX = 230;

      // Círculo Fasorial a la izquierda
      if (chkPhasor.checked) {
        ctx.save();
        // Círculo base de amplitud
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(phasorCenterX, centerY, Math.min(100, amp), 0, Math.PI * 2);
        ctx.stroke();

        // Ejes del fasor
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
        ctx.beginPath();
        ctx.moveTo(phasorCenterX - 100, centerY);
        ctx.lineTo(phasorCenterX + 100, centerY);
        ctx.moveTo(phasorCenterX, centerY - 100);
        ctx.lineTo(phasorCenterX, centerY + 100);
        ctx.stroke();

        // Punto del vector giratorio en el fasor
        const currentY = evaluateWaveAt(time, 0);
        const theta = freq * time;
        const phasorTipX = phasorCenterX + amp * Math.cos(theta);
        const phasorTipY = centerY - currentY;

        // Flecha del fasor
        ctx.strokeStyle = '#06b6d4';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(phasorCenterX, centerY);
        ctx.lineTo(phasorTipX, phasorTipY);
        ctx.stroke();

        ctx.fillStyle = '#06b6d4';
        ctx.beginPath();
        ctx.arc(phasorTipX, phasorTipY, 5, 0, Math.PI * 2);
        ctx.fill();

        // Línea guía discontinua que conecta el fasor con la onda
        ctx.strokeStyle = 'rgba(6, 182, 212, 0.55)';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(phasorTipX, phasorTipY);
        ctx.lineTo(waveStartX, phasorTipY);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.restore();
      }

      // Trazo de la Onda
      ctx.save();
      const waveGrad = ctx.createLinearGradient(waveStartX, 0, W, 0);
      waveGrad.addColorStop(0, '#06b6d4');
      waveGrad.addColorStop(0.5, '#38bdf8');
      waveGrad.addColorStop(1, '#818cf8');

      ctx.strokeStyle = waveGrad;
      ctx.lineWidth = 3.5;
      ctx.beginPath();

      const startX = chkPhasor.checked ? waveStartX : 20;

      for (let px = startX; px < W; px++) {
        const xDist = px - startX;
        const valY = evaluateWaveAt(time, xDist);
        const yPos = centerY - valY;

        if (px === startX) {
          ctx.moveTo(px, yPos);
        } else {
          ctx.lineTo(px, yPos);
        }
      }
      ctx.stroke();

      // Punto activo de entrada de la onda
      const val0 = evaluateWaveAt(time, 0);
      ctx.fillStyle = '#ffffff';
      ctx.shadowColor = '#06b6d4';
      ctx.shadowBlur = 12;
      ctx.beginPath();
      ctx.arc(startX, centerY - val0, 6, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();

      if (isPlaying) {
        time += 0.035;
      }

      requestAnimationFrame(render);
    };

    requestAnimationFrame(render);

    // =========================================================================
    // 2. LIENZO DE TRIPLE ONDA SENOIDAL SUAVE (DESPLAZAMIENTO LENTO TRAS EL HEADER)
    // =========================================================================
    const initHeroWaves = () => {
      const canvasWaves = document.getElementById('heroWavesCanvas') as HTMLCanvasElement;
      if (!canvasWaves) return;
      const ctxWaves = canvasWaves.getContext('2d');
      if (!ctxWaves) return;

      let w = 0;
      let h = 0;
      let animId = 0;
      let waveTick = 0;

      const handleResize = () => {
        const parent = canvasWaves.parentElement;
        const rect = parent ? parent.getBoundingClientRect() : canvasWaves.getBoundingClientRect();
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        w = Math.max(300, rect.width);
        h = Math.max(260, rect.height);
        canvasWaves.width = Math.round(w * dpr);
        canvasWaves.height = Math.round(h * dpr);
        canvasWaves.style.width = `${w}px`;
        canvasWaves.style.height = `${h}px`;
        ctxWaves.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      window.addEventListener('resize', handleResize, { passive: true });
      handleResize();

      const drawSinWave = (
        amp: number,
        lambda: number,
        phase: number,
        colorDark: string,
        colorLight: string,
        lw: number,
        glowDark: string,
        glowLight: string
      ) => {
        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
        const stroke = isLight ? colorLight : colorDark;
        const glow = isLight ? glowLight : glowDark;
        const centerY = h * 0.52;

        ctxWaves.save();
        ctxWaves.strokeStyle = stroke;
        ctxWaves.lineWidth = lw;
        ctxWaves.lineCap = 'round';
        ctxWaves.lineJoin = 'round';
        ctxWaves.shadowColor = glow;
        ctxWaves.shadowBlur = isLight ? 6 : 14;

        ctxWaves.beginPath();
        const k = (2 * Math.PI) / lambda;
        const step = 4;

        for (let x = 0; x <= w; x += step) {
          const normX = x / w;
          // Envolvente matemática suave para difuminar armónicamente en ambos bordes
          const envelope = Math.pow(Math.sin(normX * Math.PI), 1.25);
          const y = centerY + amp * envelope * Math.sin(k * x + phase);

          if (x === 0) {
            ctxWaves.moveTo(x, y);
          } else {
            ctxWaves.lineTo(x, y);
          }
        }
        ctxWaves.stroke();
        ctxWaves.restore();
      };

      const renderWaves = () => {
        ctxWaves.clearRect(0, 0, w, h);

        // Onda 1: Cyan / Neón (Principal, avance lento hacia la derecha)
        drawSinWave(
          44,
          Math.max(320, w * 0.44),
          waveTick * 0.0075,
          'rgba(6, 182, 212, 0.52)',
          'rgba(8, 145, 178, 0.42)',
          2.5,
          'rgba(6, 182, 212, 0.65)',
          'rgba(8, 145, 178, 0.35)'
        );

        // Onda 2: Púrpura / Violeta (Secundaria, deriva lenta opuesta y longitud mayor)
        drawSinWave(
          32,
          Math.max(450, w * 0.65),
          -waveTick * 0.0052 + 1.85,
          'rgba(168, 85, 247, 0.42)',
          'rgba(147, 51, 234, 0.32)',
          2.0,
          'rgba(168, 85, 247, 0.55)',
          'rgba(147, 51, 234, 0.25)'
        );

        // Onda 3: Azul Celeste / Hélice fina (Terciaria, oscilación más viva)
        drawSinWave(
          22,
          Math.max(220, w * 0.3),
          waveTick * 0.0108 + 3.4,
          'rgba(56, 189, 248, 0.35)',
          'rgba(2, 132, 199, 0.28)',
          1.5,
          'rgba(56, 189, 248, 0.45)',
          'rgba(2, 132, 199, 0.2)'
        );

        waveTick += 1;
        animId = requestAnimationFrame(renderWaves);
      };

      animId = requestAnimationFrame(renderWaves);
    };

    initHeroWaves();

    // =========================================================================
    // 3. PANEL LATERAL (SIDEBAR) ESTILO MATHVIZ: COLAPSO, BÚSQUEDA Y NAVEGACIÓN
    // =========================================================================
    const initSidebar = () => {
      const pageWrapper = document.getElementById('simPageWrapper');
      const sidebar = document.getElementById('simSidebar');
      const btnCollapse = document.getElementById('sidebarCollapseBtn');
      const btnExpand = document.getElementById('sidebarExpandBtn');
      const backdrop = document.getElementById('sidebarBackdrop');
      const searchInput = document.getElementById('sidebarSearchInput') as HTMLInputElement | null;
      const searchClear = document.getElementById('sidebarSearchClear') as HTMLButtonElement | null;
      const btnAll = document.getElementById('sidebarAllFilterBtn');
      const catPills = document.querySelectorAll('.cat-pill');
      const navLinks = document.querySelectorAll('.sidebar-item-link');
      const sidebarItems = document.querySelectorAll('.sidebar-item');
      const sidebarGroups = document.querySelectorAll('.sidebar-group');
      const galleryCards = document.querySelectorAll('.sim-card');

      if (!pageWrapper || !sidebar) return;

      const STORAGE_KEY = 'math_sim_sidebar_collapsed';
      const isMobile = () => window.innerWidth <= 960;

      const setCollapsed = (collapsed: boolean) => {
        if (collapsed) {
          pageWrapper.classList.add('sidebar-collapsed');
          if (btnExpand) btnExpand.style.display = 'flex';
          localStorage.setItem(STORAGE_KEY, 'true');
        } else {
          pageWrapper.classList.remove('sidebar-collapsed');
          if (btnExpand && !isMobile()) btnExpand.style.display = 'none';
          localStorage.setItem(STORAGE_KEY, 'false');
        }
      };

      const savedCollapsed = localStorage.getItem(STORAGE_KEY);
      if (savedCollapsed === 'true' && !isMobile()) {
        setCollapsed(true);
      } else if (isMobile()) {
        pageWrapper.classList.add('sidebar-collapsed');
      }

      btnCollapse?.addEventListener('click', () => {
        setCollapsed(true);
      });

      btnExpand?.addEventListener('click', () => {
        if (isMobile()) {
          sidebar.classList.add('mobile-open');
          backdrop?.classList.add('show');
        } else {
          setCollapsed(false);
        }
      });

      backdrop?.addEventListener('click', () => {
        sidebar.classList.remove('mobile-open');
        backdrop.classList.remove('show');
      });

      // Búsqueda en tiempo real
      const performSearch = () => {
        if (!searchInput) return;
        const query = searchInput.value.trim().toLowerCase();

        if (searchClear) {
          searchClear.style.display = query.length > 0 ? 'inline-flex' : 'none';
        }

        // 1. Filtrar lista lateral
        sidebarGroups.forEach((group) => {
          let visibleInGroup = 0;
          const items = group.querySelectorAll('.sidebar-item');
          items.forEach((item) => {
            const searchHaystack = (item.getAttribute('data-search') || item.querySelector('.item-title')?.textContent || '').toLowerCase();
            const matches = !query || searchHaystack.includes(query);
            (item as HTMLElement).style.display = matches ? 'block' : 'none';
            if (matches) visibleInGroup++;
          });
          (group as HTMLElement).style.display = visibleInGroup > 0 ? 'block' : 'none';
        });

        // 2. Filtrar tarjetas de la galería
        galleryCards.forEach((card) => {
          const cardTitle = (card.querySelector('.sim-card-title')?.textContent || '').toLowerCase();
          const cardDesc = (card.querySelector('.sim-card-desc')?.textContent || '').toLowerCase();
          const matches = !query || cardTitle.includes(query) || cardDesc.includes(query);
          (card as HTMLElement).style.display = matches ? 'flex' : 'none';
        });
      };

      searchInput?.addEventListener('input', performSearch);
      searchClear?.addEventListener('click', () => {
        if (!searchInput) return;
        searchInput.value = '';
        performSearch();
        searchInput.focus();
      });

      // Botón "Todas las simulaciones"
      btnAll?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        sidebarGroups.forEach((g) => ((g as HTMLElement).style.display = 'block'));
        sidebarItems.forEach((i) => ((i as HTMLElement).style.display = 'block'));
        galleryCards.forEach((c) => ((c as HTMLElement).style.display = 'flex'));
        catPills.forEach((p) => p.classList.remove('active'));
        document.querySelector('.cat-pill[data-filter="all"]')?.classList.add('active');
        btnAll.classList.add('active');

        if (isMobile()) {
          sidebar.classList.remove('mobile-open');
          backdrop?.classList.remove('show');
        }
      });

      // Filtros de categoría del catálogo sincronizados
      catPills.forEach((btn) => {
        btn.addEventListener('click', () => {
          catPills.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const cat = btn.getAttribute('data-filter');

          galleryCards.forEach((card) => {
            const cardCat = card.getAttribute('data-category');
            if (cat === 'all' || cardCat === cat) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });

          sidebarGroups.forEach((group) => {
            const gCat = group.getAttribute('data-cat-key');
            if (cat === 'all' || gCat === cat) {
              (group as HTMLElement).style.display = 'block';
            } else {
              (group as HTMLElement).style.display = 'none';
            }
          });
        });
      });

      // Clic en enlace del sidebar
      navLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          const targetId = link.getAttribute('data-target-id');
          const isDirect = link.getAttribute('data-is-direct') === 'true';

          if (isDirect) {
            return;
          }

          if (targetId === 'ondas-fourier') {
            const fourierEl = document.getElementById('lab-fourier');
            if (fourierEl) {
              e.preventDefault();
              fourierEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
              fourierEl.classList.remove('highlight-glow');
              void fourierEl.offsetWidth;
              fourierEl.classList.add('highlight-glow');
            }
          } else {
            const cardEl = document.getElementById(`sim-card-${targetId}`);
            if (cardEl) {
              e.preventDefault();
              (cardEl as HTMLElement).style.display = 'flex';
              cardEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
              cardEl.classList.remove('highlight-glow');
              void cardEl.offsetWidth;
              cardEl.classList.add('highlight-glow');
            }
          }

          if (isMobile()) {
            sidebar.classList.remove('mobile-open');
            backdrop?.classList.remove('show');
          }
        });
      });
    };

    initSidebar();

  })();
</script>

