          </p>
        </div>
        <div class="live-lab-formula-card">
          <span class="f-label">Ecuación en Vivo:</span>
          <div class="f-code-math" id="live-fourier-formula" set:html={renderMath(String.raw`f(t) = 45 \sin(1.2 t)`, false)}></div>
        </div>
      </div>

      <!-- BANCO DE TRABAJO DEL SIMULADOR -->
      <div class="lab-workbench-grid">
        
        <!-- PANEL DE VISUALIZACIÓN CANVAS -->
        <div class="workbench-viewport">
          <div class="viewport-toolbar">
            <div class="vt-left">
              <span class="screen-label">OSCILOSCOPIO &amp; FASOR GIERROTATORIO</span>
            </div>
            <div class="vt-right">
              <button type="button" class="btn-ctrl-sim" id="btn-toggle-play" title="Pausar / Reanudar simulación">
                <span id="play-icon">⏸️</span>
                <span id="play-text">Pausar</span>
              </button>
              <button type="button" class="btn-ctrl-sim" id="btn-reset-sim" title="Restablecer simulación">
                <span>↺ Reset</span>
              </button>
            </div>
          </div>

          <div class="canvas-wrapper">
            <canvas id="fourier-canvas" width="840" height="380"></canvas>
