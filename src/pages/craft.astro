<script>
  function initCraftCatalog() {
    let currentAuthor = 'all';
    let currentCategory = 'all';
    let currentSearch = '';

    const authorButtons = document.querySelectorAll<HTMLButtonElement>('[data-author-filter]');
    const categoryChips = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
    const searchInput = document.querySelector<HTMLInputElement>('[data-craft-search]');
    const clearBtn = document.querySelector<HTMLButtonElement>('[data-search-clear]');
    const statusCounter = document.querySelector('[data-craft-status-counter]');
    const emptyState = document.querySelector('[data-craft-empty]');
    const resetFiltersBtn = document.querySelector('[data-reset-filters]');
    const cards = document.querySelectorAll<HTMLElement>('[data-craft-card]');

    function filterCards() {
      let visibleCount = 0;
      const q = currentSearch.trim().toLowerCase();

      cards.forEach((card) => {
        const author = card.getAttribute('data-author') || '';
        const category = card.getAttribute('data-category') || '';
        const title = card.getAttribute('data-title') || '';
        const authorName = card.getAttribute('data-author-name') || '';
        const desc = card.getAttribute('data-desc') || '';
        const topic = card.getAttribute('data-topic') || '';
        const tags = card.getAttribute('data-tags') || '';

        // Comprobación de autor
        const matchAuthor = currentAuthor === 'all' || author === currentAuthor;

        // Comprobación de categoría temática
        const matchCategory = currentCategory === 'all' || category === currentCategory;

        // Comprobación de búsqueda de texto
        let matchSearch = true;
        if (q) {
          const haystack = `${title} ${authorName} ${desc} ${topic} ${tags}`.toLowerCase();
          matchSearch = haystack.includes(q);
        }

        const isVisible = matchAuthor && matchCategory && matchSearch;
        card.style.display = isVisible ? '' : 'none';

        if (isVisible) visibleCount++;
      });

      // Actualizar contador
      if (statusCounter) {
        statusCounter.textContent = `Mostrando ${visibleCount} de ${cards.length} juegos`;
      }

      // Mostrar estado vacío si no hay coincidencias
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.setAttribute('hidden', '');
        }
      }
    }

    // Eventos de botones de autor
    authorButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        authorButtons.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
        currentAuthor = btn.getAttribute('data-author-filter') || 'all';
        filterCards();
      });
    });

    // Eventos de chips de categoría
    categoryChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        categoryChips.forEach((c) => {
          c.classList.remove('is-active');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.add('is-active');
        chip.setAttribute('aria-selected', 'true');
        currentCategory = chip.getAttribute('data-category-filter') || 'all';
        filterCards();
      });
    });

    // Eventos de búsqueda
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentSearch = searchInput.value;
        if (clearBtn) {
          if (currentSearch.length > 0) {
            clearBtn.removeAttribute('hidden');
          } else {
            clearBtn.setAttribute('hidden', '');
          }
        }
        filterCards();
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentSearch = '';
        clearBtn.setAttribute('hidden', '');
        searchInput.focus();
        filterCards();
      });
    }

    // Botón de restablecer filtros en estado vacío
    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        currentAuthor = 'all';
        currentCategory = 'all';
        currentSearch = '';
        if (searchInput) searchInput.value = '';
        if (clearBtn) clearBtn.setAttribute('hidden', '');

        authorButtons.forEach((b) => {
          const isAll = b.getAttribute('data-author-filter') === 'all';
          b.classList.toggle('is-active', isAll);
          b.setAttribute('aria-pressed', isAll ? 'true' : 'false');
        });

        categoryChips.forEach((c) => {
          const isAll = c.getAttribute('data-category-filter') === 'all';
          c.classList.toggle('is-active', isAll);
          c.setAttribute('aria-selected', isAll ? 'true' : 'false');
        });

        filterCards();
      });
    }
  }

  // Inicialización
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCraftCatalog);
  } else {
    initCraftCatalog();
  }
  document.addEventListener('astro:page-load', initCraftCatalog);
</script>
