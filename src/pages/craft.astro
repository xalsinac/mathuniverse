---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CraftHeroOrbit from '../components/CraftHeroOrbit.astro';
import { site } from '../config/site';
import {
  craftProjects,
  CRAFT_CATEGORIES,
  type CraftProject,
} from '../data/craft';

const teacherCount = craftProjects.filter((p) => p.authorType === 'teacher').length;
const studentCount = craftProjects.filter((p) => p.authorType === 'student').length;
const totalCount = craftProjects.length;
---

<BaseLayout
  title={`Math Gaming — ${site.name}`}
  description="Juegos matemáticos, simulaciones de física y experimentos interactivos creados por profesores y alumnos en Math Universe. Donde jugar es otra forma de pensar."
>
  <!-- Barra superior técnica unificada -->
  <SiteHeader activePage="craft" statusText="08 · Math Gaming" ctaHref="/#recursos" ctaLabel="Todas las Apps">
    <div slot="right-extra" class="topbar-cell craft-top-actions">
      <a
        href="#colabora"
        class="craft-top-btn is-accent"
        title="Proponer un juego o proyecto de alumno"
      >
        <span class="btn-icon">✨</span>
        <span class="btn-text">Proponer juego</span>
      </a>
    </div>
  </SiteHeader>

  <main>
    <!-- Cabecera Hero Orbits a sangre estilo ArtCraft Studio -->
    <section class="craft-hero-band">
      <CraftHeroOrbit />
    </section>

    <!-- Barra de Filtros, Diferenciación de Autor y Búsqueda Rápida -->
    <section class="craft-catalog-band section-band is-drawn" id="catalogo">
      <span class="section-rule" aria-hidden="true"></span>
      <div class="section-frame">
        <span class="tick tick-half tick-left" aria-hidden="true"></span>
        <span class="tick tick-half tick-right" aria-hidden="true"></span>

        <div class="section-eyebrow">
          <span>
            <span class="eyebrow-num">08</span>
            <span class="eyebrow-sep" aria-hidden="true">/</span>
            Math Gaming · Catálogo de Juegos y Experimentos
          </span>
          <span class="eyebrow-right" data-craft-status-counter>Mostrando {totalCount} juegos</span>
        </div>

        <div class="craft-controls-bar section-body">
          <!-- Filtro Principal: Autor (Profesor vs Alumnos) -->
          <div class="author-toggle-group" role="group" aria-label="Filtrar por autor">
            <span class="filter-group-label">CREADOR:</span>
            <button
              type="button"
              class="author-btn is-active"
              data-author-filter="all"
              aria-pressed="true"
            >
              <span>Todos</span>
              <span class="author-count">{totalCount}</span>
            </button>
            <button
              type="button"
              class="author-btn"
              data-author-filter="teacher"
              aria-pressed="false"
            >
              <span class="author-dot is-teacher"></span>
              <span>Profesor · Xavier Alsina</span>
              <span class="author-count">{teacherCount}</span>
            </button>
            <button
              type="button"
              class="author-btn"
              data-author-filter="student"
              aria-pressed="false"
            >
              <span class="author-dot is-student"></span>
              <span>Proyectos de Alumnos</span>
              <span class="author-count">{studentCount}</span>
            </button>
          </div>

          <!-- Fila secundaria: Buscador y Categorías -->
          <div class="craft-secondary-bar">
            <!-- Buscador en tiempo real -->
            <div class="craft-search-box">
              <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              <input
                type="search"
                class="craft-search-input"
                data-craft-search
                placeholder="Buscar juego, alumno (ej. Leo Rueda), física, colisiones..."
                aria-label="Buscar proyectos en Math Gaming"
                autocomplete="off"
                spellcheck="false"
              />
              <button
                type="button"
                class="search-clear-btn"
                data-search-clear
                aria-label="Borrar búsqueda"
                hidden
              >
                ✕
              </button>
            </div>

            <!-- Chips de Categoría temática -->
            <div class="category-chips-row" role="tablist" aria-label="Filtrar por categoría temática">
              {
                CRAFT_CATEGORIES.map((cat, idx) => (
                  <button
                    type="button"
                    class={`cat-chip ${idx === 0 ? 'is-active' : ''}`}
                    data-category-filter={cat.id}
                    role="tab"
                    aria-selected={idx === 0 ? 'true' : 'false'}
                  >
                    <span class="cat-chip-icon">{cat.icon}</span>
                    <span>{cat.label}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Rejilla de Tarjetas Cuadradas Simplificadas (Cristal) -->
        <div class="craft-cards-grid section-body" data-craft-grid>
          {
            craftProjects.map((project) => (
              <a
                href={project.url}
                target={project.isExternal ? '_blank' : undefined}
                rel={project.isExternal ? 'noopener noreferrer' : undefined}
                class={`craft-card ${project.url === '#' ? 'is-upcoming' : ''}`}
                id={`game-${project.id}`}
                data-craft-card
                data-id={project.id}
                data-author={project.authorType}
                data-category={project.category}
                data-tags={project.tags.join(',').toLowerCase()}
                data-title={project.title.toLowerCase()}
                data-author-name={project.authorName.toLowerCase()}
                data-desc={project.description.toLowerCase()}
                data-topic={project.mathTopic.toLowerCase()}
                style={`--card-accent:${project.color}`}
              >
                <!-- Miniatura Visual -->
                <div class="card-media-frame">
                  {project.previewImage ? (
                    <img
                      src={project.previewImage}
                      alt={`Captura del juego ${project.title}`}
                      class="card-img"
                      loading="lazy"
                    />
                  ) : (
                    <div class="card-placeholder-art" aria-hidden="true">
                      <!-- Procedural vector art según tipo de juego -->
                      {project.id === 'astro-raya' && (
                        <svg class="preview-svg" viewBox="0 0 320 180" fill="none">
                          <rect width="320" height="180" fill="#0d1124" />
                          <circle cx="52" cy="36" r="1.4" fill="#ffffff" opacity="0.65" />
                          <circle cx="272" cy="144" r="1.8" fill="#38bdf8" opacity="0.75" />
                          <circle cx="255" cy="34" r="1.2" fill="#b48cff" opacity="0.7" />
                          <circle cx="66" cy="148" r="1.2" fill="#3fe0b5" opacity="0.6" />
                          <circle cx="160" cy="90" r="68" stroke="#38bdf8" stroke-width="1" stroke-dasharray="4 5" opacity="0.22" />
                          <!-- Tablero 3x3 cósmico centrado -->
                          <line x1="138" y1="30" x2="138" y2="150" stroke="#38bdf8" stroke-width="1.8" opacity="0.45" />
                          <line x1="182" y1="30" x2="182" y2="150" stroke="#38bdf8" stroke-width="1.8" opacity="0.45" />
                          <line x1="100" y1="70" x2="220" y2="70" stroke="#38bdf8" stroke-width="1.8" opacity="0.45" />
                          <line x1="100" y1="110" x2="220" y2="110" stroke="#38bdf8" stroke-width="1.8" opacity="0.45" />
                          <!-- X en diagonal ganadora -->
                          <path d="M108 40 L128 60 M128 40 L108 60" stroke="#38bdf8" stroke-width="3.5" stroke-linecap="round" />
                          <path d="M150 80 L170 100 M170 80 L150 100" stroke="#38bdf8" stroke-width="3.5" stroke-linecap="round" />
                          <path d="M192 120 L212 140 M212 120 L192 140" stroke="#38bdf8" stroke-width="3.5" stroke-linecap="round" />
                          <!-- O orbitales -->
                          <circle cx="202" cy="50" r="10.5" stroke="#b48cff" stroke-width="3.2" />
                          <circle cx="118" cy="130" r="10.5" stroke="#b48cff" stroke-width="3.2" />
                          <!-- Línea láser de victoria -->
                          <line x1="102" y1="34" x2="218" y2="146" stroke="#3fe0b5" stroke-width="2.5" stroke-linecap="round" opacity="0.88" />
                          <text x="20" y="30" fill="#38bdf8" font-family="monospace" font-size="11" letter-spacing="1">ASTRO · RAYA</text>
                        </svg>
                      )}
                      {project.id === 'monty-hall' && (
                        <svg class="preview-svg" viewBox="0 0 320 180" fill="none">
                          <rect width="320" height="180" fill="#0d1b18" />
                          <circle cx="160" cy="90" r="70" stroke="#3fe0b5" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.25" />
                          <!-- 3 Puertas Estilizadas -->
                          <!-- Puerta 1 (Cerrada) -->
                          <g transform="translate(60, 48)">
                            <rect width="50" height="92" rx="4" stroke="#3fe0b5" stroke-width="1.8" fill="#132b26" />
                            <rect x="6" y="8" width="38" height="34" rx="2" stroke="#3fe0b5" stroke-width="1" opacity="0.4" />
                            <rect x="6" y="48" width="38" height="36" rx="2" stroke="#3fe0b5" stroke-width="1" opacity="0.4" />
                            <circle cx="42" cy="50" r="3" fill="#3fe0b5" />
                            <text x="25" y="28" fill="#3fe0b5" font-family="monospace" font-size="14" font-weight="bold" text-anchor="middle">1</text>
                          </g>
                          <!-- Puerta 2 (Abierta - Coche / Premio) -->
                          <g transform="translate(135, 48)">
                            <rect width="50" height="92" rx="4" stroke="#3fe0b5" stroke-width="1.8" fill="#091412" stroke-dasharray="2 2" opacity="0.5" />
                            <!-- Coche deportivo dentro -->
                            <g transform="translate(6, 32) scale(0.65)">
                              <path d="M4 35 Q10 18 28 16 L42 16 Q54 22 56 35 Z" fill="#3fe0b5" />
                              <circle cx="16" cy="38" r="7" fill="#091412" stroke="#3fe0b5" stroke-width="2" />
                              <circle cx="44" cy="38" r="7" fill="#091412" stroke="#3fe0b5" stroke-width="2" />
                              <path d="M18 22 L26 18 L38 18 L42 22 Z" fill="#091412" />
                            </g>
                            <!-- Hoja de puerta abierta en ángulo -->
                            <path d="M0 0 L-18 12 L-18 84 L0 92 Z" fill="#163830" stroke="#3fe0b5" stroke-width="1.8" />
                            <text x="25" y="20" fill="#3fe0b5" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">2/3</text>
                          </g>
                          <!-- Puerta 3 (Cerrada) -->
                          <g transform="translate(210, 48)">
                            <rect width="50" height="92" rx="4" stroke="#3fe0b5" stroke-width="1.8" fill="#132b26" />
                            <rect x="6" y="8" width="38" height="34" rx="2" stroke="#3fe0b5" stroke-width="1" opacity="0.4" />
                            <rect x="6" y="48" width="38" height="36" rx="2" stroke="#3fe0b5" stroke-width="1" opacity="0.4" />
                            <circle cx="42" cy="50" r="3" fill="#3fe0b5" />
                            <text x="25" y="28" fill="#3fe0b5" font-family="monospace" font-size="14" font-weight="bold" text-anchor="middle">3</text>
                          </g>
                          <text x="20" y="30" fill="#3fe0b5" font-family="monospace" font-size="11" letter-spacing="1">MONTY HALL · 3 PUERTAS</text>
                          <text x="300" y="30" text-anchor="end" fill="#3fe0b5" opacity="0.6" font-family="monospace" font-size="10">P=2/3</text>
                        </svg>
                      )}
                      {project.id === 'torres-hanoi' && (
                        <svg class="preview-svg" viewBox="0 0 320 180" fill="none">
                          <rect width="320" height="180" fill="#08131e" />
                          <circle cx="160" cy="92" r="74" stroke="#38bdf8" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.25" />
                          <circle cx="160" cy="92" r="48" stroke="#38bdf8" stroke-width="0.8" opacity="0.15" />

                          <!-- Base principal de madera técnica/metálica -->
                          <rect x="28" y="148" width="264" height="9" rx="4.5" fill="#0f1d2d" stroke="#38bdf8" stroke-width="1.6" />

                          <!-- 3 Varas Cilíndricas (Pegs A, B, C) -->
                          <!-- Vara A (x = 75) -->
                          <rect x="72.5" y="52" width="5" height="96" rx="2.5" fill="#1e293b" stroke="#38bdf8" stroke-width="1.2" opacity="0.85" />
                          <text x="75" y="44" fill="#38bdf8" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">A</text>

                          <!-- Vara B (x = 160) -->
                          <rect x="157.5" y="52" width="5" height="96" rx="2.5" fill="#1e293b" stroke="#38bdf8" stroke-width="1.2" opacity="0.85" />
                          <text x="160" y="44" fill="#38bdf8" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">B</text>

                          <!-- Vara C (x = 245) -->
                          <rect x="242.5" y="52" width="5" height="96" rx="2.5" fill="#1e293b" stroke="#38bdf8" stroke-width="1.2" opacity="0.85" />
                          <text x="245" y="44" fill="#38bdf8" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">C</text>

                          <!-- Discos apilados en Vara A -->
                          <!-- Disco 4 (rosa/coral) -->
                          <rect x="42" y="133" width="66" height="14" rx="3.5" fill="#f43f5e" stroke="#fda4af" stroke-width="1.2" />
                          <text x="75" y="143" fill="#032030" font-family="monospace" font-size="8" font-weight="bold" text-anchor="middle">4</text>
                          <!-- Disco 3 (ámbar) -->
                          <rect x="49" y="117" width="52" height="14" rx="3.5" fill="#fbbf24" stroke="#fde68a" stroke-width="1.2" />
                          <text x="75" y="127" fill="#032030" font-family="monospace" font-size="8" font-weight="bold" text-anchor="middle">3</text>

                          <!-- Arco balístico de trasvase (de A hacia C) -->
                          <path d="M 75 104 Q 160 14 245 118" stroke="#38bdf8" stroke-width="1.8" stroke-dasharray="4 3" opacity="0.75" />

                          <!-- Disco 1 volando en pleno movimiento parabólico (Cyan) -->
                          <g transform="translate(142, 38) rotate(7)">
                            <rect width="36" height="13" rx="3" fill="#38bdf8" stroke="#7dd3fc" stroke-width="1.5" />
                            <text x="18" y="9.5" fill="#032030" font-family="monospace" font-size="8.5" font-weight="bold" text-anchor="middle">1</text>
                          </g>

                          <!-- Disco en Vara C (esmeralda) -->
                          <!-- Disco 2 -->
                          <rect x="224" y="133" width="42" height="14" rx="3.5" fill="#3fe0b5" stroke="#6ee7b7" stroke-width="1.2" />
                          <text x="245" y="143" fill="#032030" font-family="monospace" font-size="8" font-weight="bold" text-anchor="middle">2</text>

                          <!-- Textos de cabecera -->
                          <text x="20" y="28" fill="#38bdf8" font-family="monospace" font-size="11" letter-spacing="1">TORRES DE HANOI · RECURSIÓN</text>
                          <text x="300" y="28" text-anchor="end" fill="#38bdf8" opacity="0.8" font-family="monospace" font-size="10">2ⁿ - 1</text>
                        </svg>
                      )}
                      {project.id === 'simulador-loteria' && (
                        <svg class="preview-svg" viewBox="0 0 320 180" fill="none">
                          <rect width="320" height="180" fill="#17120a" />
                          <circle cx="160" cy="95" r="72" stroke="#fbbf24" stroke-width="1.1" stroke-dasharray="4 4" opacity="0.22" />
                          <!-- Gráfica descendente de Esperanza Matemática E[X] < 0 -->
                          <line x1="24" y1="108" x2="296" y2="108" stroke="#94a3b8" stroke-width="1" stroke-dasharray="3 3" opacity="0.45" />
                          <path d="M 24 108 L 70 115 L 115 123 L 155 119 L 205 135 L 250 144 L 296 156" stroke="#f43f5e" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                          <circle cx="296" cy="156" r="3.5" fill="#f43f5e" />

                          <!-- Bolas de Lotería -->
                          <g transform="translate(46, 74)">
                            <circle cx="0" cy="0" r="18" fill="#1e293b" stroke="#38bdf8" stroke-width="2" />
                            <text x="0" y="5" fill="#f8fafc" font-family="monospace" font-size="13" font-weight="bold" text-anchor="middle">07</text>
                          </g>
                          <g transform="translate(92, 66)">
                            <circle cx="0" cy="0" r="18" fill="#1e293b" stroke="#38bdf8" stroke-width="2" />
                            <text x="0" y="5" fill="#f8fafc" font-family="monospace" font-size="13" font-weight="bold" text-anchor="middle">23</text>
                          </g>
                          <g transform="translate(138, 76)">
                            <circle cx="0" cy="0" r="18" fill="#1e293b" stroke="#3fe0b5" stroke-width="2.2" />
                            <text x="0" y="5" fill="#3fe0b5" font-family="monospace" font-size="13" font-weight="bold" text-anchor="middle">42</text>
                          </g>

                          <!-- Estrellas doradas -->
                          <g transform="translate(208, 70)">
                            <circle cx="0" cy="0" r="19" fill="#2a1f08" stroke="#fbbf24" stroke-width="2.2" />
                            <text x="0" y="5" fill="#fbbf24" font-family="monospace" font-size="13" font-weight="bold" text-anchor="middle">★5</text>
                          </g>
                          <g transform="translate(256, 70)">
                            <circle cx="0" cy="0" r="19" fill="#2a1f08" stroke="#fbbf24" stroke-width="2.2" />
                            <text x="0" y="5" fill="#fbbf24" font-family="monospace" font-size="13" font-weight="bold" text-anchor="middle">★9</text>
                          </g>

                          <text x="20" y="28" fill="#fbbf24" font-family="monospace" font-size="11" letter-spacing="1">LOTERÍA · E[X] &lt; 0</text>
                          <text x="300" y="28" text-anchor="end" fill="#fbbf24" opacity="0.8" font-family="monospace" font-size="10">1 / 139.8M</text>
                        </svg>
                      )}
                      {project.id === 'ruleta-martingala' && (
                        <svg class="preview-svg" viewBox="0 0 320 180" fill="none">
                          <rect width="320" height="180" fill="#180d14" />
                          <!-- Ruleta estilizada a la izquierda -->
                          <g transform="translate(88, 96)">
                            <circle cx="0" cy="0" r="52" fill="#23121b" stroke="#fbbf24" stroke-width="2.5" />
                            <circle cx="0" cy="0" r="42" stroke="#f43f5e" stroke-width="8" stroke-dasharray="11 11" />
                            <circle cx="0" cy="0" r="42" stroke="#1e293b" stroke-width="8" stroke-dasharray="11 11" stroke-dashoffset="11" />
                            <!-- Casilla 0 verde -->
                            <path d="M 0 -46 L 4 -36 L -4 -36 Z" fill="#10b981" />
                            <circle cx="0" cy="0" r="16" fill="#180d14" stroke="#fbbf24" stroke-width="1.8" />
                            <circle cx="0" cy="0" r="4" fill="#fbbf24" />
                            <!-- Bola blanca -->
                            <circle cx="28" cy="-24" r="4.2" fill="#ffffff" />
                          </g>
                          <!-- Gráfica dientes de sierra + caída abrupta -->
                          <path d="M 162 122 L 176 116 L 176 118 L 190 110 L 190 112 L 204 103 L 204 105 L 218 96 L 218 98 L 232 90 L 240 156 L 296 156" stroke="#34d399" stroke-width="2.2" stroke-linejoin="round" fill="none" />
                          <path d="M 232 90 L 240 156 L 296 156" stroke="#f43f5e" stroke-width="2.6" stroke-linejoin="round" fill="none" />
                          <circle cx="240" cy="156" r="3.5" fill="#f43f5e" />
                          <text x="20" y="28" fill="#f43f5e" font-family="monospace" font-size="11" letter-spacing="1">RULETA · MARTINGALA</text>
                          <text x="300" y="28" text-anchor="end" fill="#fbbf24" opacity="0.85" font-family="monospace" font-size="10">-2.70%</text>
                        </svg>
                      )}
                      {project.id === 'problema-100-prisioneros' && (
                        <svg class="preview-svg" viewBox="0 0 320 180" fill="none">
                          <rect width="320" height="180" fill="#091614" />
                          <!-- Ciclo cerrado de cajas conectadas -->
                          <circle cx="160" cy="94" r="54" stroke="#3fe0b5" stroke-width="1.5" stroke-dasharray="5 4" opacity="0.45" />
                          <!-- 5 Cajas en ciclo -->
                          <g transform="translate(145, 32)">
                            <rect width="30" height="24" rx="4" fill="#102a25" stroke="#3fe0b5" stroke-width="1.8" />
                            <text x="15" y="16" fill="#3fe0b5" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">12</text>
                          </g>
                          <g transform="translate(202, 72)">
                            <rect width="30" height="24" rx="4" fill="#102a25" stroke="#3fe0b5" stroke-width="1.8" />
                            <text x="15" y="16" fill="#3fe0b5" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">47</text>
                          </g>
                          <g transform="translate(182, 128)">
                            <rect width="30" height="24" rx="4" fill="#102a25" stroke="#3fe0b5" stroke-width="1.8" />
                            <text x="15" y="16" fill="#3fe0b5" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">83</text>
                          </g>
                          <g transform="translate(108, 128)">
                            <rect width="30" height="24" rx="4" fill="#102a25" stroke="#3fe0b5" stroke-width="1.8" />
                            <text x="15" y="16" fill="#3fe0b5" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">05</text>
                          </g>
                          <g transform="translate(88, 72)">
                            <rect width="30" height="24" rx="4" fill="#102a25" stroke="#fbbf24" stroke-width="2" />
                            <text x="15" y="16" fill="#fbbf24" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">12</text>
                          </g>
                          <!-- Flechas de ciclo -->
                          <path d="M 178 48 L 204 68" stroke="#38bdf8" stroke-width="1.8" />
                          <path d="M 212 99 L 200 124" stroke="#38bdf8" stroke-width="1.8" />
                          <path d="M 179 140 L 141 140" stroke="#38bdf8" stroke-width="1.8" />
                          <path d="M 118 124 L 106 99" stroke="#38bdf8" stroke-width="1.8" />
                          <path d="M 118 68 L 142 48" stroke="#fbbf24" stroke-width="1.8" />

                          <text x="20" y="28" fill="#3fe0b5" font-family="monospace" font-size="11" letter-spacing="1">100 PRISIONEROS · CICLOS</text>
                          <text x="300" y="28" text-anchor="end" fill="#fbbf24" opacity="0.9" font-family="monospace" font-size="10">31.18%</text>
                        </svg>
                      )}
                      {project.id === 'paradoja-cumpleanos' && (
                        <svg class="preview-svg" viewBox="0 0 320 180" fill="none">
                          <rect width="320" height="180" fill="#091322" />
                          <!-- Mini calendario estilizado -->
                          <rect x="24" y="42" width="146" height="114" rx="8" fill="#102036" stroke="#38bdf8" stroke-width="1.5" opacity="0.9" />
