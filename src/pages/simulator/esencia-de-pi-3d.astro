    // Escena 2 (Arquímedes)
    archStepBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        archStepBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        archSides = parseInt(btn.getAttribute('data-n') || '6', 10);
        vArchN.textContent = `n = ${archSides} lados`;
        updateTelemetry();
      });
    });

    btnAutoArch.addEventListener('click', () => {
      isArchPlaying = !isArchPlaying;
      btnAutoArch.classList.toggle('active', isArchPlaying);
      autoArchIcon.textContent = isArchPlaying ? '⏸' : '▶';
      autoArchText.textContent = isArchPlaying ? 'Pausar Escalera' : 'Subir Escalera de Lados';
    });

    // Escena 3 (Puzle Área)
    sectorStepBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        sectorStepBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        numSectors = parseInt(btn.getAttribute('data-sec') || '16', 10);
        vSectors.textContent = `${numSectors} sectores`;
        updateTelemetry();
      });
    });

    rMorph.addEventListener('input', () => {
      morphProgress = parseFloat(rMorph.value);
      vMorph.textContent = `${Math.round(morphProgress * 100)}% (${morphProgress > 0.85 ? 'Rectángulo' : morphProgress < 0.15 ? 'Círculo' : 'Transformando'})`;
      updateTelemetry();
    });

    btnToggleMorph.addEventListener('click', () => {
      isMorphing = !isMorphing;
      btnToggleMorph.classList.toggle('active', isMorphing);
      morphIcon.textContent = isMorphing ? '⏸' : '▶';
      morphText.textContent = isMorphing ? 'Pausar Despliegue' : 'Desplegar / Recomponer';
    });

    // Escena 4 (Probabilidad)
    btnModeDarts.addEventListener('click', () => {
      probMode = 'darts';
      btnModeDarts.classList.add('active');
      btnModeBuffon.classList.remove('active');
      updateTelemetry();
    });

    btnModeBuffon.addEventListener('click', () => {
      probMode = 'buffon';
      btnModeBuffon.classList.add('active');
      btnModeDarts.classList.remove('active');
      updateTelemetry();
    });

    const addSamples = (count: number) => {
      if (probMode === 'darts') {
        for (let i = 0; i < count; i++) {
          const x = Math.random();
          const y = Math.random();
          const inCircle = x * x + y * y <= 1.0;
          if (inCircle) dartsIn++;
          dartsList.push({ x, y, inCircle });
        }
        vSampleCount.textContent = `N = ${dartsList.length}`;
      } else {
        const D = 1.0;
        const L = 1.0;
        for (let i = 0; i < count; i++) {
          const x = (Math.random() - 0.5) * 4.0;
          const y = (Math.random() - 0.5) * 4.0;
          const angle = Math.random() * Math.PI;
          const yDistToLine = Math.abs(y - Math.round(y / D) * D);
          const crosses = yDistToLine <= (L / 2) * Math.sin(angle);
          if (crosses) needlesCross++;
          needlesList.push({ x, y, angle, crosses });
        }
        vSampleCount.textContent = `N = ${needlesList.length}`;
      }
      updateTelemetry();
    };

    btnAdd100.addEventListener('click', () => addSamples(100));
    btnAdd500.addEventListener('click', () => addSamples(500));
    btnAdd2000.addEventListener('click', () => addSamples(2000));

    btnStreamPoints.addEventListener('click', () => {
      isStreamingProb = !isStreamingProb;
      btnStreamPoints.classList.toggle('active', isStreamingProb);
      streamIcon.textContent = isStreamingProb ? '⏸' : '▶';
      streamText.textContent = isStreamingProb ? 'Detener Lluvia' : 'Lluvia Continua';
    });

    btnResetProb.addEventListener('click', () => {
      dartsList = [];
      needlesList = [];
      dartsIn = 0;
      needlesCross = 0;
      isStreamingProb = false;
      btnStreamPoints.classList.remove('active');
      streamIcon.textContent = '▶';
      streamText.textContent = 'Lluvia Continua';
      vSampleCount.textContent = 'N = 0';
      updateTelemetry();
    });

    // Escena 5 (Series)
    seriesTypeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        seriesTypeBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        seriesType = btn.getAttribute('data-series') as SeriesType;
        updateTelemetry();
      });
    });

    rTerms.addEventListener('input', () => {
      seriesTerms = parseInt(rTerms.value, 10);
      vTerms.textContent = `k = ${seriesTerms} términos`;
      updateTelemetry();
    });

    btnPlaySeries.addEventListener('click', () => {
      isSeriesPlaying = !isSeriesPlaying;
      btnPlaySeries.classList.toggle('active', isSeriesPlaying);
      playSeriesIcon.textContent = isSeriesPlaying ? '⏸' : '▶';
      playSeriesText.textContent = isSeriesPlaying ? 'Pausar Suma' : 'Sumar Términos';
    });

    // =========================================================================
    // INTERACCIÓN DE CÁMARA (MOUSE & TOUCH)
    // =========================================================================
    let isDragging = false;
    let dragMode: 'orbit' | 'pan' = 'orbit';
    let lastMouseX = 0;
    let lastMouseY = 0;

    canvas.addEventListener('mousedown', (e) => {
      isDragging = true;
      dragMode = e.button === 2 || e.shiftKey ? 'pan' : 'orbit';
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      camTween = null;
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - lastMouseX;
      const dy = e.clientY - lastMouseY;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;

      if (dragMode === 'orbit') {
        cam.az -= dx * 0.007;
        cam.el = Math.max(-1.45, Math.min(1.45, cam.el + dy * 0.007));
      } else {
        const panSpeed = cam.dist * 0.0015;
        const C = makeCam();
        cam.tx -= (C.r[0] * dx - C.u[0] * dy) * panSpeed;
        cam.ty -= (C.r[1] * dx - C.u[1] * dy) * panSpeed;
        cam.tz -= (C.r[2] * dx - C.u[2] * dy) * panSpeed;
      }
    });

    window.addEventListener('mouseup', () => { isDragging = false; });
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());

    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      camTween = null;
      const factor = Math.exp(e.deltaY * 0.001);
      cam.dist = Math.max(3.5, Math.min(26.0, cam.dist * factor));
    }, { passive: false });

    canvas.addEventListener('dblclick', () => {
      const defaultView = VIEWS[activeTab].iso;
      camTween = {
        from: { ...cam },
        to: { ...defaultView },
        start: performance.now(),
        dur: 500,
      };
      camBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-view') === 'iso'));
    });

    // Touch
    let touchDist0 = 0;
    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        dragMode = 'orbit';
        lastMouseX = e.touches[0].clientX;
        lastMouseY = e.touches[0].clientY;
      } else if (e.touches.length === 2) {
        isDragging = true;
        dragMode = 'pan';
        touchDist0 = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
      }
    });

    canvas.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      if (e.touches.length === 1 && dragMode === 'orbit') {
        const dx = e.touches[0].clientX - lastMouseX;
        const dy = e.touches[0].clientY - lastMouseY;
        lastMouseX = e.touches[0].clientX;
        lastMouseY = e.touches[0].clientY;
        cam.az -= dx * 0.007;
        cam.el = Math.max(-1.45, Math.min(1.45, cam.el + dy * 0.007));
      } else if (e.touches.length === 2) {
        const dist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
        const factor = touchDist0 / (dist || 1);
        cam.dist = Math.max(3.5, Math.min(26.0, cam.dist * factor));
        touchDist0 = dist;
      }
    });

    canvas.addEventListener('touchend', () => { isDragging = false; });

    // =========================================================================
    // LOOP PRINCIPAL DE ANIMACIÓN
    // =========================================================================
    let lastTime = performance.now();

    const loop = (now: number) => {
      const dt = (now - lastTime) / 1000;
      lastTime = now;

      if (isRollPlaying && activeTab === 'roll') {
        rollTheta = (rollTheta + dt * 1.5) % (Math.PI * 2);
        rAngle.value = rollTheta.toString();
        vAngle.textContent = `${rollTheta.toFixed(2)} rad (${((rollTheta * 180) / Math.PI).toFixed(0)}°)`;
        recordCycloid();
        updateTelemetry();
      }

      if (isArchPlaying && activeTab === 'arch') {
        archTimer += dt;
        if (archTimer > 1.2) {
          archTimer = 0;
          const STEPS = [6, 12, 24, 48, 96, 192];
          const currIdx = STEPS.indexOf(archSides);
          const nextIdx = (currIdx + 1) % STEPS.length;
          archSides = STEPS[nextIdx];
          archStepBtns.forEach((b) => {
            b.classList.toggle('active', parseInt(b.getAttribute('data-n') || '0', 10) === archSides);
          });
          vArchN.textContent = `n = ${archSides} lados`;
          updateTelemetry();
        }
      }

      if (isMorphing && activeTab === 'area') {
        morphProgress += dt * 0.45 * morphDirection;
        if (morphProgress >= 1.0) {
          morphProgress = 1.0;
          morphDirection = -1;
        } else if (morphProgress <= 0.0) {
          morphProgress = 0.0;
          morphDirection = 1;
        }
        rMorph.value = morphProgress.toString();
        vMorph.textContent = `${Math.round(morphProgress * 100)}% (${morphProgress > 0.85 ? 'Rectángulo' : morphProgress < 0.15 ? 'Círculo' : 'Transformando'})`;
        updateTelemetry();
      }

      if (isStreamingProb && activeTab === 'prob') {
        addSamples(8);
      }

      if (isSeriesPlaying && activeTab === 'series') {
        seriesTerms = (seriesTerms % 150) + 1;
        rTerms.value = seriesTerms.toString();
        vTerms.textContent = `k = ${seriesTerms} términos`;
        updateTelemetry();
      }

      // Tween de cámara
      if (camTween) {
        const progress = Math.min(1, (now - camTween.start) / camTween.dur);
        const k = ease(progress);
        cam.az = camTween.from.az + (camTween.to.az - camTween.from.az) * k;
        cam.el = camTween.from.el + (camTween.to.el - camTween.from.el) * k;
        cam.dist = camTween.from.dist + (camTween.to.dist - camTween.from.dist) * k;
        cam.tx = camTween.from.tx + (camTween.to.tx - camTween.from.tx) * k;
        cam.ty = camTween.from.ty + (camTween.to.ty - camTween.from.ty) * k;
        cam.tz = camTween.from.tz + (camTween.to.tz - camTween.from.tz) * k;
        if (progress >= 1) camTween = null;
      }

      // Limpiar lienzo
      ctx.clearRect(0, 0, W, H);

      const isDark = document.documentElement.dataset.theme !== 'light';
      const bgGrad = ctx.createRadialGradient(CX, CY, 50, CX, CY, Math.max(W, H) * 0.7);
      if (isDark) {
        bgGrad.addColorStop(0, 'rgba(15, 23, 42, 0.98)');
        bgGrad.addColorStop(1, 'rgba(2, 6, 23, 1)');
      } else {
        bgGrad.addColorStop(0, 'rgba(248, 250, 252, 0.98)');
        bgGrad.addColorStop(1, 'rgba(241, 245, 249, 1)');
      }
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, W, H);

      const C = makeCam();

      try {
        if (activeTab === 'roll') {
          drawRollScene(C);
        } else if (activeTab === 'arch') {
          drawArchScene(C);
        } else if (activeTab === 'area') {
          drawAreaScene(C);
        } else if (activeTab === 'prob') {
          drawProbScene(C);
        } else {
          drawSeriesScene(C);
        }
      } catch (err) {
        console.error('Error in render loop:', err);
      }

      requestAnimationFrame(loop);
    };

    // Inicializar
    updateTelemetry();
    renderGuideContent();
    requestAnimationFrame(loop);
  })();
</script>

