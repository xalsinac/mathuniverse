      if (state.tab === 'deriv') {
        list = [
          { key: 'showSecant', label: 'Recta Secante (P → Q)', color: C_VIO },
          { key: 'showTangent', label: 'Recta Tangente Límite', color: C_AMB },
          { key: 'showDiffTriangle', label: 'Triángulo Δx / Δy', color: C_ORG },
          { key: 'showDerivCurve', label: 'Trazador Curva f\'(x)', color: C_ROSE },
          { key: 'showGrid', label: 'Rejilla y Ejes', color: '#64748b' },
        ];
      } else if (state.tab === 'riemann') {
        list = [
          { key: 'show3DBars', label: 'Bloques 3D Extruidos', color: C_CYN },
          { key: 'showExactArea', label: 'Área Exacta Sombreada', color: C_EME },
          { key: 'showGrid', label: 'Rejilla y Ejes', color: '#64748b' },
        ];
      } else if (state.tab === 'solid') {
        list = [
          { key: 'showMesh', label: 'Superficie de Revolución', color: C_CYN },
          { key: 'showDisks', label: 'Discos de Riemann πr²Δx', color: C_AMB },
          { key: 'showGrid', label: 'Rejilla Espacial', color: '#64748b' },
        ];
      } else {
        list = [
          { key: 'showIntegralCurve', label: 'Curva Integral F(x)', color: C_EME },
          { key: 'showTangent', label: 'Pendiente F\'(x) = f(x)', color: C_AMB },
          { key: 'showGrid', label: 'Rejilla y Ejes', color: '#64748b' },
        ];
      }

      list.forEach(t => {
        const lbl = document.createElement('label');
        lbl.className = 'toggle-pill';
        const inp = document.createElement('input');
        inp.type = 'checkbox';
        inp.checked = Boolean(state[t.key]);
        inp.addEventListener('change', () => {
          (state as any)[t.key] = inp.checked;
        });
        const dot = document.createElement('span');
        dot.className = 'color-dot';
        dot.style.setProperty('--dot-c', t.color);
        const txt = document.createElement('span');
        txt.textContent = t.label;
        lbl.appendChild(inp);
        lbl.appendChild(dot);
        lbl.appendChild(txt);
        togglesContainer.appendChild(lbl);
      });
    };

    const updateTelemetry = () => {
      const fnObj = FUNCTIONS[state.fn];

      if (state.tab === 'deriv') {
        const y0 = fnObj.f(state.x0);
        const y1 = fnObj.f(state.x0 + state.dx);
        const secSlope = (y1 - y0) / state.dx;
        const tanSlope = fnObj.df(state.x0);

        teleBadgePill.textContent = '1. DERIVADA Y SECANTE';
        teleCondition.textContent = state.dx < 0.05
          ? '¡Límite alcanzado! La recta secante se funde con la tangente exacta'
          : 'Reduce Δx → 0 para observar cómo la secante converge a f\'(x₀)';

        teleMetricsRow.innerHTML = `
          <div class="tm-item">
            <span class="tm-label">Pendiente Secante</span>
            <span class="tm-val" style="color: ${C_VIO};">${secSlope.toFixed(3)}</span>
          </div>
          <div class="tm-item">
            <span class="tm-label">Derivada f'(x₀)</span>
            <span class="tm-val tm-highlight">${tanSlope.toFixed(3)}</span>
          </div>
          <div class="tm-item">
            <span class="tm-label">Diferencia |ε|</span>
            <span class="tm-val" style="color: ${C_AMB};">${Math.abs(secSlope - tanSlope).toFixed(4)}</span>
          </div>
        `;
        teleEqBox.innerHTML = renderMathClient(
          String.raw`f'(x_0) = \lim_{\Delta x \to 0} \frac{f(x_0 + \Delta x) - f(x_0)}{\Delta x} \approx \frac{${(y1 - y0).toFixed(2)}}{${state.dx.toFixed(2)}} = ${secSlope.toFixed(2)}`,
          false
        );
      } else if (state.tab === 'riemann') {
        const { sum, exact, err } = computeRiemann(state.fn, state.limA, state.limB, state.riemannN, state.method);
        teleBadgePill.textContent = '2. SUMAS DE RIEMANN';
        teleCondition.textContent = `Aproximación mediante ${state.riemannN} particiones en [${state.limA.toFixed(1)}, ${state.limB.toFixed(1)}]`;

        teleMetricsRow.innerHTML = `
          <div class="tm-item">
            <span class="tm-label">Suma Riemann</span>
            <span class="tm-val tm-highlight">${sum.toFixed(4)}</span>
          </div>
          <div class="tm-item">
            <span class="tm-label">Integral Exacta</span>
            <span class="tm-val" style="color: ${C_EME};">${exact.toFixed(4)}</span>
          </div>
          <div class="tm-item">
            <span class="tm-label">Error |ε|</span>
            <span class="tm-val" style="color: ${C_AMB};">${err.toFixed(4)}</span>
          </div>
        `;
        teleEqBox.innerHTML = renderMathClient(
          String.raw`\int_{${state.limA.toFixed(1)}}^{${state.limB.toFixed(1)}} f(x)\,dx \approx \sum_{i=1}^{${state.riemannN}} f(x_i^*)\,\Delta x = ${sum.toFixed(3)}`,
          false
        );
      } else if (state.tab === 'solid') {
        const { diskVol, exactVol, err } = computeSolidVolume(state.fn, -1.2, 1.8, state.disksN);
        teleBadgePill.textContent = '3. SÓLIDO DE REVOLUCIÓN 3D';
        teleCondition.textContent = `Volumen generado por ${state.disksN} discos cilíndricos de radio r = f(x) al rotar ${state.revAngle}°`;

        teleMetricsRow.innerHTML = `
          <div class="tm-item">
            <span class="tm-label">Volumen Discos</span>
            <span class="tm-val tm-highlight">${diskVol.toFixed(3)} u³</span>
          </div>
          <div class="tm-item">
            <span class="tm-label">Volumen Exacto</span>
            <span class="tm-val" style="color: ${C_AMB};">${exactVol.toFixed(3)} u³</span>
          </div>
          <div class="tm-item">
            <span class="tm-label">Error |ε|</span>
            <span class="tm-val">${err.toFixed(3)}</span>
          </div>
        `;
        teleEqBox.innerHTML = renderMathClient(
          String.raw`V = \pi \int_{a}^{b} \big[f(x)\big]^2\,dx \approx \sum_{i=1}^{${state.disksN}} \pi \big[f(x_i)\big]^2 \Delta x`,
          false
        );
      } else {
        const a = -1.5;
        const x = state.tfcX;
        const areaVal = fnObj.F(x) - fnObj.F(a);
        const heightVal = fnObj.f(x);

        teleBadgePill.textContent = '4. TEOREMA FUNDAMENTAL';
        teleCondition.textContent = 'La pendiente de la integral acumulada F(x) es exactamente la altura f(x)';

        teleMetricsRow.innerHTML = `
          <div class="tm-item">
            <span class="tm-label">Área F(x)</span>
            <span class="tm-val" style="color: ${C_EME};">${areaVal.toFixed(3)}</span>
          </div>
          <div class="tm-item">
            <span class="tm-label">Pendiente F'(x)</span>
            <span class="tm-val tm-highlight">${heightVal.toFixed(3)}</span>
          </div>
          <div class="tm-item">
            <span class="tm-label">Altura f(x)</span>
            <span class="tm-val" style="color: ${C_AMB};">${heightVal.toFixed(3)}</span>
          </div>
        `;
        teleEqBox.innerHTML = renderMathClient(
          String.raw`\frac{d}{dx} \left[ \int_{a}^{x} f(t)\,dt \right] = f(x) = ${heightVal.toFixed(2)}`,
          false
        );
      }
    };

    // Guía Pedagógica
    const guideContent = document.getElementById('guideContent') as HTMLElement;
    const populateGuide = () => {
      if (!guideContent) return;
      guideContent.innerHTML = `
        <article class="guide-article">
          <section class="guide-section">
            <div class="sec-badge">1. EL PROBLEMA DE LA TANGENTE (DERIVADA)</div>
            <h3>¿Cómo medir la velocidad en un único instante?</h3>
            <p>
              Para medir una pendiente media entre dos puntos $P(x_0, f(x_0))$ y $Q(x_0 + h, f(x_0 + h))$ usamos la recta secante. Pero cuando queremos la <strong>velocidad o pendiente instantánea</strong> en $P$, acercamos $Q$ hacia $P$ haciendo $h = \Delta x \to 0$:
            </p>
            <div class="math-center">${renderMathClient(String.raw`f'(x_0) = \lim_{h \to 0} \frac{f(x_0 + h) - f(x_0)}{h}`, true)}</div>
            <p>
              En el simulador, observa que cuando $f'(x) = 0$ (la curva derivada roja cruza el eje $X$), la función original $f(x)$ alcanza un máximo o mínimo local.
            </p>
          </section>

          <section class="guide-section">
            <div class="sec-badge">2. EL PROBLEMA DEL ÁREA (SUMAS DE RIEMANN)</div>
            <h3>Particionar para conquistar lo curvo</h3>
            <p>
              Bernhard Riemann formalizó cómo calcular el área exacta bajo una curva dividiendo $[a, b]$ en $n$ rectángulos de base $\Delta x = \frac{b-a}{n}$ y sumando sus áreas. Al hacer $n \to \infty$, el error desaparece:
            </p>
            <div class="math-center">${renderMathClient(String.raw`\int_a^b f(x)\,dx = \lim_{n \to \infty} \sum_{i=1}^n f(x_i^*)\,\Delta x`, true)}</div>
            <p>
              Fíjate en la diferencia de precisión entre tomar la altura por la izquierda, por el punto medio o usando <strong>trapecios</strong> (que convergen muchísimo más rápido).
            </p>
          </section>

          <section class="guide-section">
            <div class="sec-badge">3. SÓLIDOS DE REVOLUCIÓN EN 3D</div>
            <h3>De rectángulos planos a discos cilíndricos</h3>
            <p>
              Si giramos una curva $y = f(x)$ $360^\circ$ alrededor del eje $X$, cada rectángulo de Riemann genera un <strong>disco cilíndrico</strong> de radio $r = f(x)$ y grosor $\Delta x$, cuyo volumen elemental es $\pi r^2 \Delta x$. Sumando infinitos discos obtenemos la fórmula de Selectividad:
            </p>
            <div class="math-center">${renderMathClient(String.raw`V = \pi \int_a^b \big[f(x)\big]^2\,dx`, true)}</div>
          </section>

          <section class="guide-section">
            <div class="sec-badge">4. EL TEOREMA FUNDAMENTAL DEL CÁLCULO</div>
            <h3>La unión histórica de Newton y Leibniz</h3>
            <p>
              Si definimos la función área acumulada $F(x) = \int_a^x f(t)\,dt$, un pequeño avance $\Delta x$ añade una franja de área $\Delta F \approx f(x)\,\Delta x$. Dividiendo por $\Delta x$, descubrimos que la derivada del área es la propia curva original:
            </p>
            <div class="math-center">${renderMathClient(String.raw`\frac{d}{dx}\int_a^x f(t)\,dt = f(x)`, true)}</div>
          </section>
        </article>
      `;
    };
    populateGuide();

    // Controles DOM
    const tabBtns = document.querySelectorAll('.calc-tab-btn');
    const fnBtns = document.querySelectorAll('.fn-btn');
    const methodBtns = document.querySelectorAll('.method-btn');
    const camBtns = document.querySelectorAll('.cam-btn');
    const btnFold = document.getElementById('btnFold');
    const panel = document.getElementById('panel');
    const btnOpenGuide = document.getElementById('btnOpenGuide');
    const btnCloseGuide = document.getElementById('btnCloseGuide');
    const guideDrawer = document.getElementById('guideDrawer');

    btnOpenGuide?.addEventListener('click', () => guideDrawer?.classList.add('open'));
    btnCloseGuide?.addEventListener('click', () => guideDrawer?.classList.remove('open'));
    btnFold?.addEventListener('click', () => {
      panel?.classList.toggle('collapsed');
      if (btnFold) btnFold.textContent = panel?.classList.contains('collapsed') ? '+' : '−';
    });

    const ctlSections = {
      deriv: document.querySelector('.tab-deriv-only') as HTMLElement,
      riemann: document.querySelector('.tab-riemann-only') as HTMLElement,
      solid: document.querySelector('.tab-solid-only') as HTMLElement,
      tfc: document.querySelector('.tab-tfc-only') as HTMLElement,
    };

    const setCameraForTab = (tab: typeof state.tab) => {
      if (tab === 'solid') {
        cam.az = -0.75; cam.el = 0.38; cam.dist = 8.0; cam.tx = 0.2; cam.ty = 0; cam.tz = 0;
      } else if (tab === 'riemann') {
        cam.az = -0.45; cam.el = 0.28; cam.dist = 7.8; cam.tx = 0.2; cam.ty = 0.3; cam.tz = 0;
      } else {
        cam.az = 0.001; cam.el = 0.02; cam.dist = 7.2; cam.tx = 0.1; cam.ty = 0.25; cam.tz = 0;
      }
    };

    const switchTab = (tab: typeof state.tab) => {
      state.tab = tab;
      tabBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-tab') === tab));
      Object.keys(ctlSections).forEach(k => {
        const el = ctlSections[k as keyof typeof ctlSections];
        if (el) el.style.display = k === tab ? 'block' : 'none';
      });
      setCameraForTab(tab);
      updateTogglesUI();
      updateTelemetry();
    };

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => switchTab(btn.getAttribute('data-tab') as typeof state.tab));
    });

    // Selector de función
    fnBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        fnBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        state.fn = btn.getAttribute('data-fn') as FnKey;
        updateTelemetry();
      });
    });

    // Sliders Escena 1
    const slX0 = document.getElementById('slX0') as HTMLInputElement;
    const vX0 = document.getElementById('vX0') as HTMLElement;
    const slDx = document.getElementById('slDx') as HTMLInputElement;
    const vDx = document.getElementById('vDx') as HTMLElement;
    slX0?.addEventListener('input', () => {
      state.x0 = parseFloat(slX0.value);
      if (vX0) vX0.textContent = state.x0.toFixed(2);
      updateTelemetry();
    });
    slDx?.addEventListener('input', () => {
      state.dx = parseFloat(slDx.value);
      if (vDx) vDx.textContent = state.dx.toFixed(2);
      updateTelemetry();
    });

    let animTimer: number | null = null;
    const stopAnim = () => {
      if (animTimer !== null) {
        cancelAnimationFrame(animTimer);
        animTimer = null;
      }
    };

    document.getElementById('btnAnimLimit')?.addEventListener('click', () => {
      stopAnim();
      let cur = 1.6;
      const step = () => {
        cur = Math.max(0.01, cur * 0.965);
        state.dx = cur;
        if (slDx) slDx.value = cur.toFixed(2);
        if (vDx) vDx.textContent = cur.toFixed(2);
        updateTelemetry();
        if (cur > 0.012 && state.tab === 'deriv') animTimer = requestAnimationFrame(step);
      };
      animTimer = requestAnimationFrame(step);
    });

    document.getElementById('btnResetDx')?.addEventListener('click', () => {
      stopAnim();
      state.dx = 1.1;
      if (slDx) slDx.value = '1.10';
      if (vDx) vDx.textContent = '1.10';
      updateTelemetry();
    });

    // Sliders Escena 2
    const slRiemannN = document.getElementById('slRiemannN') as HTMLInputElement;
    const vRiemannN = document.getElementById('vRiemannN') as HTMLElement;
    const slLimA = document.getElementById('slLimA') as HTMLInputElement;
    const vLimA = document.getElementById('vLimA') as HTMLElement;
    const slLimB = document.getElementById('slLimB') as HTMLInputElement;
    const vLimB = document.getElementById('vLimB') as HTMLElement;

    slRiemannN?.addEventListener('input', () => {
      state.riemannN = parseInt(slRiemannN.value, 10);
      if (vRiemannN) vRiemannN.textContent = String(state.riemannN);
      updateTelemetry();
    });
    slLimA?.addEventListener('input', () => {
      state.limA = Math.min(state.limB - 0.3, parseFloat(slLimA.value));
      slLimA.value = state.limA.toFixed(1);
      if (vLimA) vLimA.textContent = state.limA.toFixed(2);
      updateTelemetry();
    });
    slLimB?.addEventListener('input', () => {
      state.limB = Math.max(state.limA + 0.3, parseFloat(slLimB.value));
      slLimB.value = state.limB.toFixed(1);
      if (vLimB) vLimB.textContent = state.limB.toFixed(2);
      updateTelemetry();
    });
    methodBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        methodBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        state.method = btn.getAttribute('data-method') as typeof state.method;
        updateTelemetry();
      });
    });

    document.getElementById('btnAnimRiemann')?.addEventListener('click', () => {
      stopAnim();
      let curN = 2;
      let tick = 0;
      const step = () => {
        tick++;
        if (tick % 4 === 0) {
          curN = Math.min(60, curN + 1);
          state.riemannN = curN;
          if (slRiemannN) slRiemannN.value = String(curN);
          if (vRiemannN) vRiemannN.textContent = String(curN);
          updateTelemetry();
        }
        if (curN < 60 && state.tab === 'riemann') animTimer = requestAnimationFrame(step);
      };
      animTimer = requestAnimationFrame(step);
    });

    // Sliders Escena 3
    const slRevAngle = document.getElementById('slRevAngle') as HTMLInputElement;
    const vRevAngle = document.getElementById('vRevAngle') as HTMLElement;
    const slDisksN = document.getElementById('slDisksN') as HTMLInputElement;
    const vDisksN = document.getElementById('vDisksN') as HTMLElement;
    slRevAngle?.addEventListener('input', () => {
      state.revAngle = parseInt(slRevAngle.value, 10);
      if (vRevAngle) vRevAngle.textContent = `${state.revAngle}°`;
      updateTelemetry();
    });
    slDisksN?.addEventListener('input', () => {
      state.disksN = parseInt(slDisksN.value, 10);
      if (vDisksN) vDisksN.textContent = String(state.disksN);
      updateTelemetry();
    });
    document.getElementById('btnAnimSolid')?.addEventListener('click', () => {
      stopAnim();
      let ang = 15;
      const step = () => {
        ang = Math.min(360, ang + 4);
        state.revAngle = ang;
        if (slRevAngle) slRevAngle.value = String(ang);
        if (vRevAngle) vRevAngle.textContent = `${ang}°`;
        updateTelemetry();
        if (ang < 360 && state.tab === 'solid') animTimer = requestAnimationFrame(step);
      };
      animTimer = requestAnimationFrame(step);
    });

    // Sliders Escena 4
    const slTfcX = document.getElementById('slTfcX') as HTMLInputElement;
    const vTfcX = document.getElementById('vTfcX') as HTMLElement;
    slTfcX?.addEventListener('input', () => {
      state.tfcX = parseFloat(slTfcX.value);
      if (vTfcX) vTfcX.textContent = state.tfcX.toFixed(2);
      updateTelemetry();
    });
    document.getElementById('btnAnimTfc')?.addEventListener('click', () => {
      stopAnim();
      let curX = -1.4;
      const step = () => {
        curX += 0.025;
        if (curX > 2.4) curX = 2.4;
        state.tfcX = curX;
        if (slTfcX) slTfcX.value = curX.toFixed(2);
        if (vTfcX) vTfcX.textContent = curX.toFixed(2);
        updateTelemetry();
        if (curX < 2.4 && state.tab === 'tfc') animTimer = requestAnimationFrame(step);
      };
      animTimer = requestAnimationFrame(step);
    });

    // Cámara Presets
    camBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        camBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const view = btn.getAttribute('data-view');
        if (view === 'iso') {
          cam.az = -0.55; cam.el = 0.32; cam.dist = 7.8; cam.tx = 0.2; cam.ty = 0.25; cam.tz = 0;
        } else if (view === 'front') {
          cam.az = 0.001; cam.el = 0.02; cam.dist = 7.2; cam.tx = 0.1; cam.ty = 0.25; cam.tz = 0;
        } else if (view === 'top') {
          cam.az = 0.001; cam.el = 1.52; cam.dist = 8.2; cam.tx = 0.1; cam.ty = 0; cam.tz = 0;
        }
      });
    });

    // Interacción ratón
    let isDragging = false, isPanning = false, lastX = 0, lastY = 0;
    canvas.addEventListener('mousedown', e => {
      isDragging = true;
      isPanning = e.shiftKey || e.button === 2;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas.classList.add('dragging');
    });
    window.addEventListener('mouseup', () => {
      isDragging = false;
      isPanning = false;
      canvas.classList.remove('dragging');
    });
    window.addEventListener('mousemove', e => {
      if (!isDragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      lastX = e.clientX;
      lastY = e.clientY;
      if (isPanning) {
        cam.tx -= dx * 0.008 * (cam.dist / 8);
        cam.ty += dy * 0.008 * (cam.dist / 8);
      } else {
        cam.az -= dx * 0.007;
        cam.el = Math.max(-1.52, Math.min(1.52, cam.el + dy * 0.007));
      }
    });
    canvas.addEventListener('wheel', e => {
      e.preventDefault();
      cam.dist = Math.max(2.5, Math.min(25, cam.dist * (e.deltaY > 0 ? 1.08 : 0.92)));
    }, { passive: false });
    canvas.addEventListener('dblclick', () => setCameraForTab(state.tab));

    switchTab(initialTab);

    // =========================================================================
    // LOOP DE RENDERIZADO 3D
    // =========================================================================
    let lastTime = performance.now();

    const drawAxes = (C: ReturnType<typeof makeCam>, x0 = -2.8, x1 = 3.0, y0 = -2.2, y1 = 2.6) => {
      line3(C, [x0, 0, 0], [x1, 0, 0], AXIS, 1.5);
      arrowAt(C, [x1, 0, 0], [x1 - 0.2, 0, 0], AXIS);
      label3(C, [x1 + 0.22, 0, 0], 'x', COL_AXIS_LBL, 13, 'center', 0, 'italic');

      line3(C, [0, y0, 0], [0, y1, 0], AXIS, 1.5);
      arrowAt(C, [0, y1, 0], [0, y1 - 0.2, 0], AXIS);
      label3(C, [0, y1 + 0.22, 0], 'y', COL_AXIS_LBL, 13, 'center', 0, 'italic');
    };

    const render = (now: number) => {
      const dt = Math.min(0.1, (now - lastTime) / 1000);
      lastTime = now;
      state.t += dt;

      ctx.clearRect(0, 0, W, H);
      syncThemeColors();
      const C = makeCam();
      const fnObj = FUNCTIONS[state.fn];

      // 1. ESCENA 1: DERIVADA (SECANTE -> TANGENTE + TRAZADOR f'(x))
      if (state.tab === 'deriv') {
        if (state.showGrid) gridRect(C, -2.8, 2.8, -2.2, 2.6, 0.5);
        drawAxes(C);

        // Curva principal f(x)
        for (let x = -2.5; x < 2.6; x += 0.05) {
          line3(C, [x, fnObj.f(x), 0], [x + 0.05, fnObj.f(x + 0.05), 0], C_CYN, 2.8);
        }

        // Trazador de la función derivada f'(x)
        if (state.showDerivCurve) {
          for (let x = -2.5; x < 2.6; x += 0.05) {
            line3(C, [x, fnObj.df(x), -0.35], [x + 0.05, fnObj.df(x + 0.05), -0.35], C_ROSE, 2.0, [4, 4]);
          }
          const df0 = fnObj.df(state.x0);
          line3(C, [state.x0, fnObj.f(state.x0), 0], [state.x0, df0, -0.35], hexA(C_ROSE, 0.5), 1.2, [3, 3]);
          glowDot(C, [state.x0, df0, -0.35], 5.5, COL_VEC_MAIN, C_ROSE);
          label3(C, [state.x0, df0 - 0.22, -0.35], `f'(${state.x0.toFixed(1)})=${df0.toFixed(2)}`, C_ROSE, 11, 'center', 0, 'italic');
        }

        const x0 = state.x0, y0 = fnObj.f(x0);
        const x1 = x0 + state.dx, y1 = fnObj.f(x1);
        const tanSlope = fnObj.df(x0);
        const secSlope = (y1 - y0) / state.dx;

        // Triángulo diferencial Δx / Δy
        if (state.showDiffTriangle) {
          line3(C, [x0, y0, 0], [x1, y0, 0], C_ORG, 2.0);
          line3(C, [x1, y0, 0], [x1, y1, 0], C_EME, 2.0);
          label3(C, [(x0 + x1) / 2, y0 - 0.16, 0], `Δx=${state.dx.toFixed(2)}`, C_ORG, 10.5, 'center', 0, 'italic');
          label3(C, [x1 + 0.16, (y0 + y1) / 2, 0], `Δy=${(y1 - y0).toFixed(2)}`, C_EME, 10.5, 'left', 0, 'italic');
        }

        // Recta tangente límite
        if (state.showTangent) {
          line3(C, [x0 - 1.1, y0 - 1.1 * tanSlope, 0], [x0 + 1.1, y0 + 1.1 * tanSlope, 0], C_AMB, 2.2);
        }

        // Recta secante por P y Q
        if (state.showSecant) {
          line3(C, [x0 - 0.9, y0 - 0.9 * secSlope, 0], [x1 + 0.9, y1 + 0.9 * secSlope, 0], C_VIO, 2.0, [6, 4]);
          glowDot(C, [x1, y1, 0], 6, COL_VEC_MAIN, C_VIO);
          label3(C, [x1, y1 + 0.22, 0], 'Q', C_VIO, 12, 'center', 0, 'italic');
        }

        glowDot(C, [x0, y0, 0], 7, COL_VEC_MAIN, C_AMB);
        label3(C, [x0, y0 + 0.24, 0], 'P', C_AMB, 12.5, 'center', 0, 'italic');
      }

      // 2. ESCENA 2: SUMAS DE RIEMANN
      else if (state.tab === 'riemann') {
        if (state.showGrid) gridRect(C, -2.8, 2.8, -2.2, 2.6, 0.5);
        drawAxes(C);

        const a = state.limA, b = state.limB, n = state.riemannN;
        const dx = (b - a) / n;

        // Área exacta sombreada sutil
        if (state.showExactArea) {
          const st = (b - a) / 60;
          for (let x = a; x < b; x += st) {
            const xN = Math.min(b, x + st);
            fillPoly3(C, [[x, 0, -0.02], [xN, 0, -0.02], [xN, fnObj.f(xN), -0.02], [x, fnObj.f(x), -0.02]], hexA(C_EME, 0.16));
          }
        }

        // Rectángulos / Bloques 3D de Riemann
        const depth = state.show3DBars ? 0.55 : 0;
        for (let i = 0; i < n; i++) {
          const x0 = a + i * dx, x1 = x0 + dx;
          let yLeft = 0, yRight = 0;
          if (state.method === 'left') { yLeft = yRight = fnObj.f(x0); }
          else if (state.method === 'right') { yLeft = yRight = fnObj.f(x1); }
          else if (state.method === 'mid') { yLeft = yRight = fnObj.f((x0 + x1) / 2); }
          else { yLeft = fnObj.f(x0); yRight = fnObj.f(x1); }

          const colFill = yLeft >= 0 ? hexA(C_CYN, 0.35) : hexA(C_ROSE, 0.35);
          const colEdge = yLeft >= 0 ? C_CYN : C_ROSE;

          // Cara frontal
          fillPoly3(C, [[x0, 0, 0], [x1, 0, 0], [x1, yRight, 0], [x0, yLeft, 0]], colFill);
          line3(C, [x0, 0, 0], [x0, yLeft, 0], colEdge, 1.2);
          line3(C, [x0, yLeft, 0], [x1, yRight, 0], colEdge, 1.5);
          line3(C, [x1, yRight, 0], [x1, 0, 0], colEdge, 1.2);

          if (depth > 0 && n <= 45) {
            // Extrusión 3D superior y lateral
            fillPoly3(C, [[x0, yLeft, 0], [x1, yRight, 0], [x1, yRight, -depth], [x0, yLeft, -depth]], hexA(colEdge, 0.25));
            line3(C, [x0, yLeft, -depth], [x1, yRight, -depth], hexA(colEdge, 0.6), 1);
            line3(C, [x1, yRight, 0], [x1, yRight, -depth], hexA(colEdge, 0.6), 1);
          }
        }

        // Curva f(x) sobre los rectángulos
        for (let x = -2.5; x < 2.6; x += 0.05) {
          line3(C, [x, fnObj.f(x), 0.02], [x + 0.05, fnObj.f(x + 0.05), 0.02], C_AMB, 2.6);
        }
      }

      // 3. ESCENA 3: SÓLIDO DE REVOLUCIÓN 3D
      else if (state.tab === 'solid') {
        if (state.showGrid) gridRect(C, -2.5, 2.5, -2.0, 2.0, 0.5);
        drawAxes(C, -2.2, 2.4, -2.0, 2.0);

        const a = -1.2, b = 1.8;
        const maxRad = (state.revAngle * Math.PI) / 180;

        // Discos cilíndricos de Riemann
        if (state.showDisks) {
          const n = state.disksN;
          const dx = (b - a) / n;
          for (let i = 0; i < n; i++) {
            const xm = a + (i + 0.5) * dx;
            const r = Math.abs(fnObj.f(xm));
            const steps = 16;
            for (let s = 0; s < steps; s++) {
              const a0 = (s / steps) * maxRad;
              const a1 = ((s + 1) / steps) * maxRad;
              line3(C, [xm, r * Math.cos(a0), r * Math.sin(a0)], [xm, r * Math.cos(a1), r * Math.sin(a1)], hexA(C_AMB, 0.55), 1.2);
            }
          }
        }

        // Malla de superficie de revolución
        if (state.showMesh) {
          const xSteps = 22, rSteps = 18;
          for (let i = 0; i <= xSteps; i++) {
            const x = a + (i / xSteps) * (b - a);
            const r = Math.abs(fnObj.f(x));
            for (let j = 0; j < rSteps; j++) {
              const t0 = (j / rSteps) * maxRad;
              const t1 = ((j + 1) / rSteps) * maxRad;
              line3(C, [x, r * Math.cos(t0), r * Math.sin(t0)], [x, r * Math.cos(t1), r * Math.sin(t1)], hexA(C_CYN, 0.4), 1);
            }
          }
          for (let j = 0; j <= rSteps; j += 2) {
            const t = (j / rSteps) * maxRad;
            for (let i = 0; i < xSteps; i++) {
              const x0 = a + (i / xSteps) * (b - a);
              const x1 = a + ((i + 1) / xSteps) * (b - a);
              const r0 = Math.abs(fnObj.f(x0)), r1 = Math.abs(fnObj.f(x1));
              line3(C, [x0, r0 * Math.cos(t), r0 * Math.sin(t)], [x1, r1 * Math.cos(t), r1 * Math.sin(t)], hexA(C_CYN, 0.35), 1);
            }
          }
        }

        // Perfil generatriz f(x) destacado
        for (let x = a; x < b; x += 0.05) {
          line3(C, [x, fnObj.f(x), 0], [x + 0.05, fnObj.f(x + 0.05), 0], C_ROSE, 2.8);
        }
      }

      // 4. ESCENA 4: TEOREMA FUNDAMENTAL DEL CÁLCULO
      else {
        if (state.showGrid) gridRect(C, -2.5, 2.8, -2.2, 2.8, 0.5);
        drawAxes(C);

        const a = -1.5, xCur = state.tfcX;

        // Área acumulada ∫ₐˣ f(t) dt
        const st = 0.06;
        for (let t = a; t < xCur; t += st) {
          const tN = Math.min(xCur, t + st);
          fillPoly3(C, [[t, 0, 0], [tN, 0, 0], [tN, fnObj.f(tN), 0], [t, fnObj.f(t), 0]], hexA(C_CYN, 0.25));
        }

        // Curva original f(x)
        for (let x = -2.2; x < 2.5; x += 0.05) {
          line3(C, [x, fnObj.f(x), 0], [x + 0.05, fnObj.f(x + 0.05), 0], C_CYN, 2.5);
        }

        // Curva integral F(x) = ∫ₐˣ f(t) dt
        if (state.showIntegralCurve) {
          const Fa = fnObj.F(a);
          for (let x = a; x < 2.4; x += 0.05) {
            line3(C, [x, fnObj.F(x) - Fa, 0], [x + 0.05, fnObj.F(x + 0.05) - Fa, 0], C_EME, 2.5);
          }
          const Fx = fnObj.F(xCur) - Fa;
          glowDot(C, [xCur, Fx, 0], 6.5, COL_VEC_MAIN, C_EME);
          label3(C, [xCur, Fx + 0.24, 0], `F(x)=${Fx.toFixed(2)}`, C_EME, 11.5, 'center', 0, 'italic');

          // Tangente a F(x) cuya pendiente es f(x)
          if (state.showTangent) {
            const slope = fnObj.f(xCur);
            line3(C, [xCur - 0.7, Fx - 0.7 * slope, 0], [xCur + 0.7, Fx + 0.7 * slope, 0], C_AMB, 2.2);
          }
        }

        const fx = fnObj.f(xCur);
        line3(C, [xCur, 0, 0], [xCur, fx, 0], C_AMB, 1.8, [4, 4]);
        glowDot(C, [xCur, fx, 0], 6.5, COL_VEC_MAIN, C_AMB);
        label3(C, [xCur, fx + 0.24, 0], `f(x)=${fx.toFixed(2)}`, C_AMB, 11.5, 'center', 0, 'italic');
      }

      requestAnimationFrame(render);
    };

    requestAnimationFrame(render);
  })();
</script>

