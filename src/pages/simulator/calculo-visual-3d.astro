---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { site } from '../../config/site';
import katex from 'katex';
import 'katex/dist/katex.min.css';

const renderMath = (latex: string, displayMode = false) => {
  try {
    return katex.renderToString(latex, { displayMode, throwOnError: false });
  } catch {
    return latex;
  }
};
---

<BaseLayout
  title={`Cálculo Visual 3D: Derivadas, Sumas de Riemann y Sólidos de Revolución — Math Simulator | ${site.name}`}
  description="Laboratorio 3D interactivo de Cálculo Diferencial e Integral: paso al límite de secante a tangente, trazador de f'(x), sumas de Riemann en 3D, sólidos de revolución por discos y Teorema Fundamental del Cálculo."
>
  <SiteHeader activePage="simulator" statusText="08 · Math Simulator / Cálculo Visual 3D" ctaHref="/simulator" ctaLabel="← Catálogo de Simuladores" />

  <main class="calc-container">
    <!-- LIENZO 3D CANVAS PRINCIPAL -->
    <canvas id="scene" class="calc-canvas"></canvas>

    <!-- CABECERA SUPERIOR FLOTANTE IZQUIERDA -->
    <header class="calc-header">
      <div class="calc-kicker">
        <span class="pulse-dot"></span>
        <span>CÁLCULO DIFERENCIAL E INTEGRAL · BACHILLERATO &amp; SELECTIVIDAD</span>
      </div>
      <h1 class="calc-title">Cálculo Visual en 3D</h1>
      <p class="calc-desc" id="brandDesc">
        Observa cómo el cambio instantáneo (<strong class="hl-calc">derivada</strong>) y la acumulación continua (<strong class="hl-calc">integral</strong>) son dos caras inversas de la misma moneda geométrica.
      </p>
      <button type="button" class="btn-open-guide" id="btnOpenGuide" title="Abrir explicación didáctica completa">
        <span>📖 Teoría y Demostración Paso a Paso</span>
      </button>
    </header>

    <!-- SELECTOR DE LAS 4 ESCENAS / PESTAÑAS (PARTE SUPERIOR CENTRAL) -->
    <nav class="calc-tabs-nav" aria-label="Escena de simulación">
      <button type="button" class="calc-tab-btn active" data-tab="deriv" id="tabDerivBtn">
        <span class="tab-icon">📈</span>
        <span>1. Secante → Tangente f'(x)</span>
      </button>
      <button type="button" class="calc-tab-btn" data-tab="riemann" id="tabRiemannBtn">
        <span class="tab-icon">📊</span>
        <span>2. Sumas de Riemann</span>
      </button>
      <button type="button" class="calc-tab-btn" data-tab="solid" id="tabSolidBtn">
        <span class="tab-icon">🏺</span>
        <span>3. Sólido de Revolución 3D</span>
      </button>
      <button type="button" class="calc-tab-btn" data-tab="tfc" id="tabTfcBtn">
        <span class="tab-icon">🔗</span>
        <span>4. Teorema Fundamental</span>
      </button>
    </nav>

    <!-- MODAL / DRAWER PEDAGÓGICO -->
    <div class="guide-drawer" id="guideDrawer">
      <div class="guide-header">
        <div class="gh-left">
          <span class="gh-badge">TRATADO DE CÁLCULO VISUAL</span>
          <h2 id="guideModalTitle">Derivadas, Integrales y su Conexión Profunda</h2>
        </div>
        <button type="button" class="btn-close-guide" id="btnCloseGuide" title="Cerrar guía">✕</button>
      </div>
      <div class="guide-body" id="guideContent"></div>
    </div>

    <!-- PANEL FLOTANTE DE CONTROLES DERECHA -->
    <aside class="calc-panel" id="panel">
      <div class="panel-header">
        <div class="ph-title-group">
          <span class="ph-icon">🎛️</span>
          <span class="ph-title">Controles &amp; Parámetros</span>
        </div>
        <button type="button" class="btn-fold" id="btnFold" title="Plegar / Desplegar panel">−</button>
      </div>

      <div class="panel-content" id="panelBody">

        <!-- SELECTOR DE FUNCIÓN GLOBAL -->
        <div class="ctl-section">
          <div class="ctl-header-bar">
            <span class="sec-tag">Función de Estudio f(x)</span>
          </div>
          <div class="fn-grid">
            <button type="button" class="fn-btn active" data-fn="cubic">0.25x³ − 0.75x</button>
            <button type="button" class="fn-btn" data-fn="quad">0.5x² − 1</button>
            <button type="button" class="fn-btn" data-fn="sin">sin(1.5x) + 1.2</button>
            <button type="button" class="fn-btn" data-fn="exp">0.5·e^(0.5x)</button>
          </div>
        </div>

        <!-- =================== ESCENA 1: DERIVADA =================== -->
        <div class="ctl-section tab-deriv-only">
          <div class="ctl-header-bar">
            <span class="sec-tag">Paso al Límite: Δx → 0</span>
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slX0">Punto de estudio <span class="math-sym">x₀</span></label>
              <span class="ctl-val" id="vX0">0.80</span>
            </div>
            <input type="range" id="slX0" min="-2.2" max="2.2" step="0.05" value="0.80" />
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slDx">Incremento <span class="math-sym">h = Δx</span></label>
              <span class="ctl-val" id="vDx">1.10</span>
            </div>
            <input type="range" id="slDx" min="0.01" max="2.00" step="0.01" value="1.10" />
          </div>

          <div class="quick-presets-row">
            <button type="button" class="preset-chip" id="btnAnimLimit">▶ Animar Δx → 0</button>
            <button type="button" class="preset-chip" id="btnResetDx">h = 1.10</button>
          </div>
        </div>

        <!-- =================== ESCENA 2: SUMAS DE RIEMANN =================== -->
        <div class="ctl-section tab-riemann-only" style="display: none;">
          <div class="ctl-header-bar">
            <span class="sec-tag">Partición y Método Numérico</span>
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slRiemannN">Rectángulos <span class="math-sym">n</span></label>
              <span class="ctl-val" id="vRiemannN">8</span>
            </div>
            <input type="range" id="slRiemannN" min="2" max="100" step="1" value="8" />
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slLimA">Límite inferior <span class="math-sym">a</span></label>
              <span class="ctl-val" id="vLimA">-1.50</span>
            </div>
            <input type="range" id="slLimA" min="-2.5" max="0.5" step="0.1" value="-1.50" />
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slLimB">Límite superior <span class="math-sym">b</span></label>
              <span class="ctl-val" id="vLimB">2.00</span>
            </div>
            <input type="range" id="slLimB" min="0.6" max="2.6" step="0.1" value="2.00" />
          </div>

          <div class="ctl-group">
            <label class="ctl-label">Criterio de altura:</label>
            <div class="method-grid">
              <button type="button" class="method-btn active" data-method="left">Izquierda</button>
              <button type="button" class="method-btn" data-method="right">Derecha</button>
              <button type="button" class="method-btn" data-method="mid">Punto Medio</button>
              <button type="button" class="method-btn" data-method="trap">Trapecios</button>
            </div>
          </div>

          <div class="quick-presets-row">
            <button type="button" class="preset-chip" id="btnAnimRiemann">▶ Animar n: 2 → 60</button>
          </div>
        </div>

        <!-- =================== ESCENA 3: SÓLIDO DE REVOLUCIÓN =================== -->
        <div class="ctl-section tab-solid-only" style="display: none;">
          <div class="ctl-header-bar">
            <span class="sec-tag">Revolución Alrededor del Eje X</span>
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slRevAngle">Ángulo de giro <span class="math-sym">θ</span></label>
              <span class="ctl-val" id="vRevAngle">360°</span>
            </div>
            <input type="range" id="slRevAngle" min="15" max="360" step="5" value="360" />
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slDisksN">Discos de Riemann <span class="math-sym">n</span></label>
              <span class="ctl-val" id="vDisksN">14</span>
            </div>
            <input type="range" id="slDisksN" min="4" max="40" step="1" value="14" />
          </div>

          <div class="quick-presets-row">
            <button type="button" class="preset-chip" id="btnAnimSolid">▶ Rotar 0° → 360°</button>
          </div>
        </div>

        <!-- =================== ESCENA 4: TEOREMA FUNDAMENTAL =================== -->
        <div class="ctl-section tab-tfc-only" style="display: none;">
          <div class="ctl-header-bar">
            <span class="sec-tag">Función Integral F(x) = ∫ₐˣ f(t) dt</span>
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slTfcX">Posición actual <span class="math-sym">x</span></label>
              <span class="ctl-val" id="vTfcX">1.20</span>
            </div>
            <input type="range" id="slTfcX" min="-1.5" max="2.4" step="0.05" value="1.20" />
          </div>

          <div class="quick-presets-row">
            <button type="button" class="preset-chip" id="btnAnimTfc">▶ Barrer x en [a, b]</button>
          </div>
        </div>

        <!-- TOGGLES DINÁMICOS POR ESCENA -->
        <div class="toggles-box">
          <span class="tg-section-label">Capas Visuales:</span>
          <div class="toggles-grid" id="togglesContainer"></div>
        </div>

        <!-- VISTAS DE CÁMARA -->
        <div class="camera-views-box">
          <span class="tg-section-label">Vistas de Cámara:</span>
          <div class="cam-btns-grid">
            <button type="button" class="cam-btn active" data-view="iso">Perspectiva 3D</button>
            <button type="button" class="cam-btn" data-view="front">Frontal (X-Y)</button>
            <button type="button" class="cam-btn" data-view="top">Planta (X-Z)</button>
          </div>
        </div>

      </div>
    </aside>

    <!-- TARJETA FLOTANTE DE TELEMETRÍA (INFERIOR IZQUIERDA) -->
    <div class="telemetry-badge" id="telemetryCard">
      <div class="tele-top">
        <span class="tele-type-pill" id="teleBadgePill">DERIVADA INSTANTÁNEA</span>
        <span class="tele-condition" id="teleCondition">Cuando Δx → 0, la pendiente secante converge a f'(x₀)</span>
      </div>
      <div class="tele-metrics-row" id="teleMetricsRow"></div>
      <div class="tele-eq-box" id="teleEqBox"></div>
    </div>

    <!-- HINT FLOTANTE INFERIOR -->
    <div class="cam-hint" id="camHint">
      <span>🖱️ <strong>Arrastrar:</strong> Rotar órbita 3D</span>
      <span>•</span>
      <span>⌨️ <strong>Shift + Arrastrar:</strong> Desplazar vista</span>
      <span>•</span>
      <span>📜 <strong>Rueda:</strong> Zoom</span>
      <span>•</span>
      <span>⚡ <strong>Doble clic:</strong> Reiniciar vista</span>
    </div>
  </main>
</BaseLayout>

<script>
  import katex from 'katex';

  (() => {
    const canvas = document.getElementById('scene') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;

    const renderMathClient = (latex: string, displayMode = false) => {
      try {
        return katex.renderToString(latex, { displayMode, throwOnError: false });
      } catch {
        return latex;
      }
    };

    // Paleta adaptativa Modo Oscuro / Modo Claro
    let isLight = document.documentElement.dataset.theme === 'light';
    let C_CYN = '#2dd4ea';
    let C_ROSE = '#fb7185';
    let C_VIO = '#a78bfa';
    let C_EME = '#34d399';
    let C_ORG = '#fb923c';
    let C_AMB = '#fbbf24';
    let AXIS = 'rgba(148, 163, 184, 0.45)';
    let COL_AXIS_LBL = '#c4d2e6';
    let COL_GRID = 'rgba(148, 163, 184, 0.08)';
    let COL_VEC_MAIN = 'rgba(241, 245, 249, 0.92)';
    const FONT_MATH = 'Georgia, "Times New Roman", serif';

    const syncThemeColors = () => {
      isLight = document.documentElement.dataset.theme === 'light';
      if (isLight) {
        C_CYN = '#0891b2';
        C_ROSE = '#e11d48';
        C_VIO = '#7c3aed';
        C_EME = '#059669';
        C_ORG = '#ea580c';
        C_AMB = '#d97706';
        AXIS = 'rgba(51, 65, 85, 0.55)';
        COL_AXIS_LBL = '#1e293b';
        COL_GRID = 'rgba(15, 23, 42, 0.08)';
        COL_VEC_MAIN = 'rgba(15, 23, 42, 0.88)';
      } else {
        C_CYN = '#2dd4ea';
        C_ROSE = '#fb7185';
        C_VIO = '#a78bfa';
        C_EME = '#34d399';
        C_ORG = '#fb923c';
        C_AMB = '#fbbf24';
        AXIS = 'rgba(148, 163, 184, 0.45)';
        COL_AXIS_LBL = '#c4d2e6';
        COL_GRID = 'rgba(148, 163, 184, 0.08)';
        COL_VEC_MAIN = 'rgba(241, 245, 249, 0.92)';
      }
    };
    syncThemeColors();

    const hexA = (hex: string, a: number) => {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return `rgba(${r},${g},${b},${a})`;
    };

    // Definición analítica de funciones f(x), f'(x) y primitiva ∫f(x)dx
    type FnKey = 'cubic' | 'quad' | 'sin' | 'exp';
    const FUNCTIONS: Record<FnKey, {
      label: string;
      f: (x: number) => number;
      df: (x: number) => number;
      F: (x: number) => number;
      latex: string;
    }> = {
      cubic: {
        label: '0.25x³ − 0.75x',
        f: x => 0.25 * x * x * x - 0.75 * x,
        df: x => 0.75 * x * x - 0.75,
        F: x => 0.0625 * Math.pow(x, 4) - 0.375 * x * x,
        latex: String.raw`f(x) = 0.25x^3 - 0.75x`
      },
      quad: {
        label: '0.5x² − 1',
        f: x => 0.5 * x * x - 1,
        df: x => x,
        F: x => (1 / 6) * x * x * x - x,
        latex: String.raw`f(x) = 0.5x^2 - 1`
      },
      sin: {
        label: 'sin(1.5x) + 1.2',
        f: x => Math.sin(1.5 * x) + 1.2,
        df: x => 1.5 * Math.cos(1.5 * x),
        F: x => -Math.cos(1.5 * x) / 1.5 + 1.2 * x,
        latex: String.raw`f(x) = \sin(1.5x) + 1.2`
      },
      exp: {
        label: '0.5·e^(0.5x)',
        f: x => 0.5 * Math.exp(0.5 * x),
        df: x => 0.25 * Math.exp(0.5 * x),
        F: x => Math.exp(0.5 * x),
        latex: String.raw`f(x) = 0.5 e^{0.5x}`
      }
    };

    // Leer ?tab= de URL si viene desde una tarjeta específica
    const urlParams = new URLSearchParams(window.location.search);
    const paramTab = urlParams.get('tab');
    const initialTab = (paramTab === 'riemann' || paramTab === 'solid' || paramTab === 'tfc' || paramTab === 'deriv') ? paramTab : 'deriv';

    const state = {
      tab: initialTab as 'deriv' | 'riemann' | 'solid' | 'tfc',
      fn: 'cubic' as FnKey,
      x0: 0.80,
      dx: 1.10,
      riemannN: 8,
      limA: -1.5,
      limB: 2.0,
      method: 'left' as 'left' | 'right' | 'mid' | 'trap',
      revAngle: 360,
      disksN: 14,
      tfcX: 1.20,
      t: 0,
      showGrid: true,
      // Toggles
      showSecant: true,
      showTangent: true,
      showDerivCurve: true,
      showDiffTriangle: true,
      showExactArea: true,
      show3DBars: true,
      showDisks: true,
      showMesh: true,
      showIntegralCurve: true,
    };

    // Cámara 3D
    let W = 0, H = 0, CX = 0, CY = 0, FOCAL = 1000;
    const cam = { az: -0.5, el: 0.25, dist: 7.5, tx: 0, ty: 0.3, tz: 0 };

    const resize = () => {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      canvas.style.width = `${W}px`;
      canvas.style.height = `${H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const panelWidth = W > 1024 ? 330 : 0;
      CX = Math.round((W - panelWidth) / 2);
      CY = Math.round(H / 2);
      FOCAL = 1.15 * Math.min(H, (W - panelWidth) * 1.05);
    };
    window.addEventListener('resize', resize);
    resize();

    type Pt3 = [number, number, number];
    type Pt2 = [number, number];

    const sub = (a: Pt3, b: Pt3): Pt3 => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
    const dot3 = (a: Pt3, b: Pt3): number => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
    const cross = (a: Pt3, b: Pt3): Pt3 => [
      a[1] * b[2] - a[2] * b[1],
      a[2] * b[0] - a[0] * b[2],
      a[0] * b[1] - a[1] * b[0],
    ];
    const norm = (a: Pt3): Pt3 => {
      const l = Math.hypot(a[0], a[1], a[2]) || 1;
      return [a[0] / l, a[1] / l, a[2] / l];
    };

    const makeCam = () => {
      const cp = Math.cos(cam.el), sp = Math.sin(cam.el);
      const eye: Pt3 = [
        cam.tx + cam.dist * cp * Math.sin(cam.az),
        cam.ty + cam.dist * sp,
        cam.tz + cam.dist * cp * Math.cos(cam.az),
      ];
      const f = norm(sub([cam.tx, cam.ty, cam.tz], eye));
      const r = norm(cross(f, [0, 1, 0]));
      const u = cross(r, f);
      return { eye, f, r, u };
    };

    const project = (p: Pt3, c: ReturnType<typeof makeCam>): { p2: Pt2; z: number; visible: boolean } => {
      const d = sub(p, c.eye);
      const zCam = dot3(d, c.f);
      if (zCam <= 0.05) return { p2: [0, 0], z: zCam, visible: false };
      const xCam = dot3(d, c.r);
      const yCam = dot3(d, c.u);
      const s = FOCAL / zCam;
      return {
        p2: [CX + xCam * s, CY - yCam * s],
        z: zCam,
        visible: true,
      };
    };

    const line3 = (C: ReturnType<typeof makeCam>, a: Pt3, b: Pt3, col: string, w = 1.5, dash: number[] = []) => {
      const pa = project(a, C);
      const pb = project(b, C);
      if (!pa.visible && !pb.visible) return;
      ctx.save();
      ctx.strokeStyle = col;
      ctx.lineWidth = w;
      if (dash.length) ctx.setLineDash(dash);
      ctx.beginPath();
      ctx.moveTo(pa.p2[0], pa.p2[1]);
      ctx.lineTo(pb.p2[0], pb.p2[1]);
      ctx.stroke();
      ctx.restore();
    };

    const fillPoly3 = (C: ReturnType<typeof makeCam>, pts: Pt3[], col: string) => {
      const p2s = pts.map(p => project(p, C)).filter(p => p.visible);
      if (p2s.length < 3) return;
      ctx.save();
      ctx.fillStyle = col;
      ctx.beginPath();
      ctx.moveTo(p2s[0].p2[0], p2s[0].p2[1]);
      for (let i = 1; i < p2s.length; i++) ctx.lineTo(p2s[i].p2[0], p2s[i].p2[1]);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    };

    const glowDot = (C: ReturnType<typeof makeCam>, p: Pt3, r: number, core: string, glow: string) => {
      const pp = project(p, C);
      if (!pp.visible) return;
      ctx.save();
      ctx.shadowColor = glow;
      ctx.shadowBlur = r * 1.5;
      ctx.fillStyle = core;
      ctx.beginPath();
      ctx.arc(pp.p2[0], pp.p2[1], r, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    };

    const label3 = (C: ReturnType<typeof makeCam>, p: Pt3, text: string, col = '#ffffff', size = 11, align: CanvasTextAlign = 'center', dy = -10, fontStyle = '') => {
      const pp = project(p, C);
      if (!pp.visible) return;
      ctx.save();
      ctx.fillStyle = col;
      ctx.font = `${fontStyle ? fontStyle + ' ' : ''}${size}px ${fontStyle ? FONT_MATH : 'ui-sans-serif, system-ui, sans-serif'}`;
      ctx.textAlign = align;
      ctx.textBaseline = 'middle';
      ctx.fillText(text, pp.p2[0], pp.p2[1] + dy);
      ctx.restore();
    };

    const arrowAt = (C: ReturnType<typeof makeCam>, tip: Pt3, tail: Pt3, col: string) => {
      const pt = project(tip, C);
      const pr = project(tail, C);
      if (!pt.visible || !pr.visible) return;
      const dx = pt.p2[0] - pr.p2[0];
      const dy = pt.p2[1] - pr.p2[1];
      const len = Math.hypot(dx, dy);
      if (len < 2) return;
      const ux = dx / len, uy = dy / len;
      const sz = 8;
      ctx.save();
      ctx.fillStyle = col;
      ctx.beginPath();
      ctx.moveTo(pt.p2[0], pt.p2[1]);
      ctx.lineTo(pt.p2[0] - sz * ux + (sz * 0.45) * uy, pt.p2[1] - sz * uy - (sz * 0.45) * ux);
      ctx.lineTo(pt.p2[0] - sz * ux - (sz * 0.45) * uy, pt.p2[1] - sz * uy + (sz * 0.45) * ux);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    };

    const gridRect = (C: ReturnType<typeof makeCam>, x0: number, x1: number, y0: number, y1: number, st = 0.5) => {
      for (let x = Math.ceil(x0 / st) * st; x <= x1 + 1e-9; x += st) {
        line3(C, [x, y0, 0], [x, y1, 0], COL_GRID, 1);
      }
      for (let y = Math.ceil(y0 / st) * st; y <= y1 + 1e-9; y += st) {
        line3(C, [x0, y, 0], [x1, y, 0], COL_GRID, 1);
      }
    };

    // Cálculo de Suma de Riemann
    const computeRiemann = (fnKey: FnKey, a: number, b: number, n: number, method: typeof state.method) => {
      const f = FUNCTIONS[fnKey].f;
      const F = FUNCTIONS[fnKey].F;
      const dx = (b - a) / n;
      let sum = 0;
      for (let i = 0; i < n; i++) {
        const x0 = a + i * dx;
        const x1 = x0 + dx;
        if (method === 'left') sum += f(x0) * dx;
        else if (method === 'right') sum += f(x1) * dx;
        else if (method === 'mid') sum += f((x0 + x1) / 2) * dx;
        else sum += 0.5 * (f(x0) + f(x1)) * dx;
      }
      const exact = F(b) - F(a);
      return { sum, exact, err: Math.abs(sum - exact), dx };
    };

    // Cálculo numérico volumen sólido de revolución V = π ∫ f(x)² dx
    const computeSolidVolume = (fnKey: FnKey, a: number, b: number, n: number) => {
      const f = FUNCTIONS[fnKey].f;
      const dx = (b - a) / n;
      let diskVol = 0;
      for (let i = 0; i < n; i++) {
        const xm = a + (i + 0.5) * dx;
        const r = f(xm);
        diskVol += Math.PI * r * r * dx;
      }
      // Integral exacta aproximada por Simpson fino (N=400)
      const N = 400;
      const h = (b - a) / N;
      let exactVol = 0;
      for (let i = 0; i <= N; i++) {
        const x = a + i * h;
        const w = (i === 0 || i === N) ? 1 : (i % 2 === 1 ? 4 : 2);
        const r = f(x);
        exactVol += w * Math.PI * r * r;
      }
      exactVol *= h / 3;
      return { diskVol, exactVol, err: Math.abs(diskVol - exactVol) };
    };

    // Elementos UI
    const togglesContainer = document.getElementById('togglesContainer') as HTMLElement;
    const teleBadgePill = document.getElementById('teleBadgePill') as HTMLElement;
    const teleCondition = document.getElementById('teleCondition') as HTMLElement;
    const teleMetricsRow = document.getElementById('teleMetricsRow') as HTMLElement;
    const teleEqBox = document.getElementById('teleEqBox') as HTMLElement;

    const updateTogglesUI = () => {
      if (!togglesContainer) return;
      togglesContainer.innerHTML = '';

      type ToggleDef = { key: keyof typeof state; label: string; color: string };
