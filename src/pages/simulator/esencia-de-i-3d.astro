    const gridFloor = (C: ReturnType<typeof makeCam>, g = 2, st = 0.5) => {
      const n = Math.round(g / st);
      for (let i = -n; i <= n; i++) {
        if (i === 0) continue;
        const u = i * st;
        line3(C, [u, 0, -g], [u, 0, g], COL_GRID, 1);
        line3(C, [-g, 0, u], [g, 0, u], COL_GRID, 1);
