---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { site } from '../../config/site';
import katex from 'katex';
import 'katex/dist/katex.min.css';

const renderMath = (latex: string, displayMode = false) => {
  try {
    return katex.renderToString(latex, { displayMode, throwOnError: false });
  } catch {
    return latex;
  }
};
---

<BaseLayout
  title={`La Esencia de i en 3D: Rotación de 90°, Cardano, Raíces Ocultas y Matrices — Math Simulator | ${site.name}`}
  description="Laboratorio 3D interactivo para comprender la verdadera naturaleza del número imaginario i: el cuarto de vuelta (rotación 90°), el enigma de Cardano x³ = 15x + 4, raíces fuera del papel en la superficie |p(z)|, gemelos espejo conjugados y la matriz real J² = −I."
>
  <SiteHeader activePage="simulator" statusText="08 · Math Simulator / La Esencia de i" ctaHref="/simulator" ctaLabel="← Catálogo de Simuladores" />

  <main class="i-container">
    <!-- LIENZO 3D CANVAS PRINCIPAL -->
    <canvas id="scene" class="i-canvas"></canvas>

    <!-- CABECERA SUPERIOR FLOTANTE IZQUIERDA -->
    <header class="i-header">
      <div class="i-kicker">
        <span class="pulse-dot"></span>
        <span>ÁLGEBRA LINEAL &amp; PLANO COMPLEJO · LA ESENCIA DE i</span>
      </div>
      <h1 class="i-title">La Esencia de i en 3D</h1>
      <p class="i-desc" id="brandDesc">
        El número <strong class="hl-i">i</strong> no es un truco ficticio ni «imaginario»: es el operador geométrico que rota el espacio <strong class="hl-i">90°</strong>. Descubre cómo $i^2 = -1$ significa dar media vuelta y por qué los complejos son el puente obligado hacia la realidad.
      </p>
      <button type="button" class="btn-open-guide" id="btnOpenGuide" title="Abrir explicación didáctica completa">
        <span>📖 Deducción Histórica y Explicación Paso a Paso</span>
      </button>
    </header>

    <!-- SELECTOR DE LAS 5 ESCENAS / PESTAÑAS (PARTE SUPERIOR CENTRAL) -->
    <nav class="i-tabs-nav" aria-label="Escena de simulación">
      <button type="button" class="i-tab-btn active" data-tab="turn" id="tabTurnBtn">
        <span class="tab-icon">🔄</span>
        <span>1. El Cuarto de Vuelta (×i = 90°)</span>
      </button>
      <button type="button" class="i-tab-btn" data-tab="cubic" id="tabCubicBtn">
        <span class="tab-icon">🏛️</span>
        <span>2. Enigma de Cardano (x³ = 15x + 4)</span>
      </button>
      <button type="button" class="i-tab-btn" data-tab="roots" id="tabRootsBtn">
        <span class="tab-icon">⛰️</span>
        <span>3. Raíces Fuera del Papel (|p(z)|)</span>
      </button>
      <button type="button" class="i-tab-btn" data-tab="conj" id="tabConjBtn">
        <span class="tab-icon">🪞</span>
        <span>4. Gemelos Espejo (Conjugados)</span>
      </button>
      <button type="button" class="i-tab-btn" data-tab="matrix" id="tabMatrixBtn">
        <span class="tab-icon">🧮</span>
        <span>5. i es una Matriz (J² = −I)</span>
      </button>
    </nav>

    <!-- MODAL / DRAWER PEDAGÓGICO DE EXPLICACIÓN DETALLADA -->
    <div class="guide-drawer" id="guideDrawer">
      <div class="guide-header">
        <div class="gh-left">
          <span class="gh-badge">TRATADO DIDÁCTICO</span>
          <h2 id="guideModalTitle">¿Qué es en realidad el número i?</h2>
        </div>
        <button type="button" class="btn-close-guide" id="btnCloseGuide" title="Cerrar guía">✕</button>
      </div>

      <div class="guide-body" id="guideContent">
        <!-- Contenido renderizado con KaTeX -->
      </div>
    </div>

    <!-- PANEL FLOTANTE DE CONTROLES DERECHA -->
    <aside class="i-panel" id="panel">
      <div class="panel-header">
        <div class="ph-title-group">
          <span class="ph-icon">🎛️</span>
          <span class="ph-title">Controles &amp; Parámetros</span>
        </div>
        <button type="button" class="btn-fold" id="btnFold" title="Plegar / Desplegar panel">−</button>
      </div>

      <div class="panel-content" id="panelBody">
        
        <!-- =================== PARÁMETROS ESCENA 1: EL CUARTO DE VUELTA =================== -->
        <div class="ctl-section tab-turn-only">
          <div class="ctl-header-bar">
            <span class="sec-tag">Punto Inicial z₀ = a + bi</span>
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slRe0">Parte Real <span class="math-sym">Re(z₀)</span></label>
              <span class="ctl-val" id="vRe0">1.20</span>
            </div>
            <input type="range" id="slRe0" min="-2.0" max="2.0" step="0.05" value="1.20" />
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slIm0">Parte Imaginaria <span class="math-sym">Im(z₀)</span></label>
              <span class="ctl-val" id="vIm0">0.50</span>
            </div>
            <input type="range" id="slIm0" min="-2.0" max="2.0" step="0.05" value="0.50" />
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slTurnSpeed">Velocidad de Giro <span class="math-sym">ω</span></label>
              <span class="ctl-val" id="vTurnSpeed">0.80×</span>
            </div>
            <input type="range" id="slTurnSpeed" min="0.2" max="2.0" step="0.1" value="0.8" />
          </div>

          <div class="quick-presets-row">
            <button type="button" class="preset-chip" id="btnPreset1" title="Situar en 1 real">z₀ = 1</button>
            <button type="button" class="preset-chip" id="btnPresetI" title="Situar en i imaginario">z₀ = i</button>
            <button type="button" class="preset-chip" id="btnPresetDiag" title="Situar en 1 + i">z₀ = 1 + i</button>
          </div>
        </div>

        <!-- =================== PARÁMETROS ESCENA 2: CARDANO =================== -->
        <div class="ctl-section tab-cubic-only" style="display: none;">
          <div class="ctl-header-bar">
            <span class="sec-tag">Ecuación de Cardano: x³ = 15x + 4</span>
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slBranchK">Rama Cúbica <span class="math-sym">k</span></label>
              <span class="ctl-val" id="vBranchK">0 (Raíz x = 4)</span>
            </div>
            <input type="range" id="slBranchK" min="0" max="2" step="1" value="0" />
          </div>

          <div class="quick-presets-row">
            <button type="button" class="preset-chip active" id="btnBranch0" title="Rama principal: x = 4">k = 0 → x = 4</button>
            <button type="button" class="preset-chip" id="btnBranch1" title="Segunda raíz: x = -2 - √3">k = 1 → −3.73</button>
            <button type="button" class="preset-chip" id="btnBranch2" title="Tercera raíz: x = -2 + √3">k = 2 → −0.27</button>
          </div>
        </div>

        <!-- =================== PARÁMETROS ESCENA 3: RAÍCES FUERA DEL PAPEL =================== -->
        <div class="ctl-section tab-roots-only" style="display: none;">
          <div class="ctl-header-bar">
            <span class="sec-tag">Superficie de Módulo |p(z)|</span>
          </div>

          <div class="ctl-group">
            <label class="ctl-label">Familia de Polinomios:</label>
            <div class="btn-segmented">
              <button type="button" class="seg-btn active" id="btnPolyQuad" data-poly="0">p(z) = z² + c</button>
              <button type="button" class="seg-btn" id="btnPolyCubic" data-poly="1">p(z) = z³ − z + c</button>
            </div>
          </div>

          <div class="ctl-group" style="margin-top: 0.65rem;">
            <div class="ctl-header">
              <label for="slParamC">Parámetro <span class="math-sym">c</span></label>
              <span class="ctl-val" id="vParamC">0.50</span>
            </div>
            <input type="range" id="slParamC" min="-2.0" max="2.0" step="0.02" value="0.50" />
          </div>

          <div class="quick-presets-row">
            <button type="button" class="preset-chip" id="btnPresetNegC" title="c = -1 (Raíces reales en eje X)">c = −1 (Reales)</button>
            <button type="button" class="preset-chip" id="btnPresetZeroC" title="c = 0 (Bifurcación en origen)">c = 0 (Colisión)</button>
            <button type="button" class="preset-chip active" id="btnPresetPosC" title="c = +1 (Raíces en eje imaginario)">c = +1 (Fuera del Papel)</button>
          </div>
        </div>

        <!-- =================== PARÁMETROS ESCENA 4: GEMELOS ESPEJO =================== -->
        <div class="ctl-section tab-conj-only" style="display: none;">
          <div class="ctl-header-bar">
            <span class="sec-tag">Simetría de Conjugación z y z̄</span>
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slZRe">Parte Real <span class="math-sym">a = Re(z)</span></label>
              <span class="ctl-val" id="vZRe">1.10</span>
            </div>
            <input type="range" id="slZRe" min="-2.0" max="2.0" step="0.05" value="1.10" />
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slZIm">Parte Imaginaria <span class="math-sym">b = Im(z)</span></label>
              <span class="ctl-val" id="vZIm">0.90</span>
            </div>
            <input type="range" id="slZIm" min="-2.0" max="2.0" step="0.05" value="0.90" />
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slQuarQ">Parámetro Cuártico <span class="math-sym">q</span> (Raíces)</label>
              <span class="ctl-val" id="vQuarQ">0.45</span>
            </div>
            <input type="range" id="slQuarQ" min="-1.2" max="1.2" step="0.02" value="0.45" />
          </div>
        </div>

        <!-- =================== PARÁMETROS ESCENA 5: MATRICES =================== -->
        <div class="ctl-section tab-matrix-only" style="display: none;">
          <div class="ctl-header-bar">
            <span class="sec-tag">Matriz J = [0 −1; 1 0] y Mapa aI + bJ</span>
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slMatA">Componente Real <span class="math-sym">a</span></label>
              <span class="ctl-val" id="vMatA">0.80</span>
            </div>
            <input type="range" id="slMatA" min="-1.5" max="1.5" step="0.05" value="0.80" />
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slMatB">Componente Rotatoria <span class="math-sym">b</span></label>
              <span class="ctl-val" id="vMatB">0.60</span>
            </div>
            <input type="range" id="slMatB" min="-1.5" max="1.5" step="0.05" value="0.60" />
          </div>

          <div class="ctl-group">
            <div class="ctl-header">
              <label for="slMatSpeed">Velocidad Paso <span class="math-sym">J</span></label>
              <span class="ctl-val" id="vMatSpeed">0.80×</span>
            </div>
            <input type="range" id="slMatSpeed" min="0.2" max="2.0" step="0.1" value="0.8" />
          </div>
        </div>

        <!-- TOGGLES DINÁMICOS POR ESCENA -->
        <div class="toggles-box">
          <span class="tg-section-label">Capas Visuales:</span>
          <div class="toggles-grid" id="togglesContainer">
            <!-- Toggles dinámicos generados según la pestaña activa -->
          </div>
        </div>

        <!-- VISTAS DE CÁMARA PREDEFINIDAS -->
        <div class="camera-views-box">
          <span class="tg-section-label">Vistas de Cámara:</span>
          <div class="cam-btns-grid">
            <button type="button" class="cam-btn active" data-view="iso">Perspectiva 3D</button>
            <button type="button" class="cam-btn" data-view="front">Plano Complejo (X-Y)</button>
            <button type="button" class="cam-btn" data-view="top">Planta Superior (X-Z)</button>
          </div>
        </div>

      </div>
    </aside>

    <!-- TARJETA FLOTANTE DE TELEMETRÍA (COLOCADA ABAJO A LA IZQUIERDA) -->
    <div class="telemetry-badge" id="telemetryCard">
      <div class="tele-top">
        <span class="tele-type-pill" id="teleBadgePill">ROTACIÓN COMPLEJA</span>
        <span class="tele-condition" id="teleCondition">Operador de rotación antihoraria de 90°</span>
      </div>
      <div class="tele-metrics-row" id="teleMetricsRow">
        <!-- Métricas dinámicas en tiempo real -->
      </div>
      <div class="tele-eq-box" id="teleEqBox">
        <!-- Ecuación en vivo generada con KaTeX -->
      </div>
    </div>

    <!-- HINT FLOTANTE INFERIOR DE CÁMARA 3D -->
    <div class="cam-hint" id="camHint">
      <span>🖱️ <strong>Arrastrar:</strong> Rotar órbita 3D</span>
      <span>•</span>
      <span>⌨️ <strong>Shift + Arrastrar:</strong> Desplazar vista</span>
      <span>•</span>
      <span>📜 <strong>Rueda:</strong> Zoom</span>
      <span>•</span>
      <span>⚡ <strong>Doble clic:</strong> Reiniciar vista</span>
    </div>
  </main>
</BaseLayout>

<script>
  import katex from 'katex';

  (() => {
    const canvas = document.getElementById('scene') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;

    // Helper KaTeX para el cliente
    const renderMathClient = (latex: string, displayMode = false) => {
      try {
        return katex.renderToString(latex, { displayMode, throwOnError: false });
      } catch {
        return latex;
      }
    };

    // Paleta cromática estándar MathViz (adaptable a Modo Oscuro y Claro)
    let isLight = document.documentElement.dataset.theme === 'light';
    let C_CYN = '#2dd4ea';
    let C_ROSE = '#fb7185';
    let C_VIO = '#a78bfa';
    let C_EME = '#34d399';
    let C_ORG = '#fb923c';
    let C_AMB = '#fbbf24';
    let AXIS = 'rgba(148, 163, 184, 0.45)';
    let AXIS_DIM = 'rgba(148, 163, 184, 0.2)';
    let COL_AXIS_LBL = COL_AXIS_LBL;
    let COL_TICK = 'rgba(159, 176, 200, 0.65)';
    let COL_GRID = 'rgba(148, 163, 184, 0.08)';
    let COL_VEC_MAIN = 'rgba(241, 245, 249, 0.92)';
    let COL_VEC_SUB = 'rgba(241, 245, 249, 0.5)';
    let COL_DOT_CORE = '#ffffff';
    const FONT_MATH = 'Georgia, "Times New Roman", serif';

    const syncThemeColors = () => {
      isLight = document.documentElement.dataset.theme === 'light';
      if (isLight) {
        C_CYN = '#0891b2';
        C_ROSE = '#e11d48';
        C_VIO = '#7c3aed';
        C_EME = '#059669';
        C_ORG = '#ea580c';
        C_AMB = '#d97706';
        AXIS = 'rgba(51, 65, 85, 0.55)';
        AXIS_DIM = 'rgba(51, 65, 85, 0.28)';
        COL_AXIS_LBL = '#1e293b';
        COL_TICK = 'rgba(51, 65, 85, 0.78)';
        COL_GRID = 'rgba(15, 23, 42, 0.08)';
        COL_VEC_MAIN = 'rgba(15, 23, 42, 0.88)';
        COL_VEC_SUB = 'rgba(15, 23, 42, 0.45)';
        COL_DOT_CORE = '#0f172a';
      } else {
        C_CYN = '#2dd4ea';
        C_ROSE = '#fb7185';
        C_VIO = '#a78bfa';
        C_EME = '#34d399';
        C_ORG = '#fb923c';
        C_AMB = '#fbbf24';
        AXIS = 'rgba(148, 163, 184, 0.45)';
        AXIS_DIM = 'rgba(148, 163, 184, 0.2)';
        COL_AXIS_LBL = COL_AXIS_LBL;
        COL_TICK = 'rgba(159, 176, 200, 0.65)';
        COL_GRID = 'rgba(148, 163, 184, 0.08)';
        COL_VEC_MAIN = 'rgba(241, 245, 249, 0.92)';
        COL_VEC_SUB = 'rgba(241, 245, 249, 0.5)';
        COL_DOT_CORE = '#ffffff';
      }
    };
    syncThemeColors();

    const hexA = (hex: string, a: number) => {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return `rgba(${r},${g},${b},${a})`;
    };

    const fmt = (n: number, d = 2) => Math.abs(n) < 1e-6 ? '0' : n.toFixed(d);
    const fmtS = (n: number, d = 2) => (Math.abs(n) < 1e-6 ? '0' : (n >= 0 ? '+' : '−') + Math.abs(n).toFixed(d));
    const czs = (re: number, im: number) => fmt(re) + (im < 0 ? ' − ' : ' + ') + fmt(Math.abs(im)) + 'i';
    const ease = (u: number) => (u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);
    const stepAngle = (u: number) => {
      const n = Math.floor(u);
      const f = u - n;
      return (n + ease(Math.min(1, f / 0.7))) * (Math.PI / 2);
    };

    // Estado global de la simulación
    const state = {
      tab: 'turn' as 'turn' | 'cubic' | 'roots' | 'conj' | 'matrix',
      re0: 1.20,
      im0: 0.50,
      turnSpeed: 0.8,
      branchK: 0,
      polySel: 0,
      paramC: 0.50,
      zRe: 1.10,
      zIm: 0.90,
      quarQ: 0.45,
      matA: 0.80,
      matB: 0.60,
      matSpeed: 0.8,
      t: 0,
      showGrid: true,
      // Toggles Escena 1
      showTurnPt: true,
      showGhosts: true,
      showArc: true,
      stepDemo: true,
      // Toggles Escena 2
      showCubic: true,
      showRootsP: true,
      showConjP: true,
      showPair: true,
      // Toggles Escena 3
      showSlice: true,
      showPath: true,
      showSurf: true,
      showPits: true,
      // Toggles Escena 4
      showZ: true,
      showTwin: true,
      showSum: true,
      showProd: true,
      showQuartic: true,
      // Toggles Escena 5
      showTrack: true,
      showAB: false,
      showCloud: true,
      mDemo: true,
    };

    // Cámara 3D
    let W = 0, H = 0, CX = 0, CY = 0, FOCAL = 1000;
    const cam = {
      az: -0.7,
      el: 0.35,
      dist: 8.5,
      tx: 0,
      ty: 0,
      tz: 0,
    };

    const resize = () => {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      canvas.style.width = `${W}px`;
      canvas.style.height = `${H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const panelWidth = W > 1024 ? 330 : 0;
      CX = Math.round((W - panelWidth) / 2);
      CY = Math.round(H / 2);
      FOCAL = 1.15 * Math.min(H, (W - panelWidth) * 1.05);
    };
    window.addEventListener('resize', resize);
    resize();

    // Matemáticas 3D y proyecciones
    type Pt3 = [number, number, number];
    type Pt2 = [number, number];

    const sub = (a: Pt3, b: Pt3): Pt3 => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
    const dot3 = (a: Pt3, b: Pt3): number => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
    const cross = (a: Pt3, b: Pt3): Pt3 => [
      a[1] * b[2] - a[2] * b[1],
      a[2] * b[0] - a[0] * b[2],
      a[0] * b[1] - a[1] * b[0],
    ];
    const norm = (a: Pt3): Pt3 => {
      const l = Math.hypot(a[0], a[1], a[2]) || 1;
      return [a[0] / l, a[1] / l, a[2] / l];
    };

    const makeCam = () => {
      const cp = Math.cos(cam.el), sp = Math.sin(cam.el);
      const eye: Pt3 = [
        cam.tx + cam.dist * cp * Math.sin(cam.az),
        cam.ty + cam.dist * sp,
        cam.tz + cam.dist * cp * Math.cos(cam.az),
      ];
      const f = norm(sub([cam.tx, cam.ty, cam.tz], eye));
      const r = norm(cross(f, [0, 1, 0]));
      const u = cross(r, f);
      return { eye, f, r, u };
    };

    const project = (p: Pt3, c: ReturnType<typeof makeCam>): { p2: Pt2; z: number; visible: boolean } => {
      const d = sub(p, c.eye);
      const zCam = dot3(d, c.f);
      if (zCam <= 0.05) return { p2: [0, 0], z: zCam, visible: false };
      const xCam = dot3(d, c.r);
      const yCam = dot3(d, c.u);
      const s = FOCAL / zCam;
      return {
        p2: [CX + xCam * s, CY - yCam * s],
        z: zCam,
        visible: true,
      };
    };

    const line3 = (C: ReturnType<typeof makeCam>, a: Pt3, b: Pt3, col: string, w = 1.5, dash: number[] = []) => {
      const pa = project(a, C);
      const pb = project(b, C);
      if (!pa.visible && !pb.visible) return;
      ctx.save();
      ctx.strokeStyle = col;
      ctx.lineWidth = w;
      if (dash.length) ctx.setLineDash(dash);
      ctx.beginPath();
      ctx.moveTo(pa.p2[0], pa.p2[1]);
      ctx.lineTo(pb.p2[0], pb.p2[1]);
      ctx.stroke();
      ctx.restore();
    };

    const dot3D = (C: ReturnType<typeof makeCam>, p: Pt3, r: number, fill: string, stroke = '#ffffff', sw = 1.5) => {
      const pp = project(p, C);
      if (!pp.visible) return;
      ctx.save();
      ctx.fillStyle = fill;
      ctx.strokeStyle = stroke;
      ctx.lineWidth = sw;
      ctx.beginPath();
      ctx.arc(pp.p2[0], pp.p2[1], r, 0, Math.PI * 2);
      ctx.fill();
      if (sw > 0) ctx.stroke();
      ctx.restore();
    };

    const glowDot = (C: ReturnType<typeof makeCam>, p: Pt3, r: number, core: string, glow: string) => {
      const pp = project(p, C);
      if (!pp.visible) return;
      ctx.save();
      ctx.shadowColor = glow;
      ctx.shadowBlur = r * 1.5;
      ctx.fillStyle = core;
      ctx.beginPath();
      ctx.arc(pp.p2[0], pp.p2[1], r, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    };

    const label3 = (C: ReturnType<typeof makeCam>, p: Pt3, text: string, col = '#ffffff', size = 11, align: CanvasTextAlign = 'center', dy = -10, fontStyle = '') => {
      const pp = project(p, C);
      if (!pp.visible) return;
      ctx.save();
      ctx.fillStyle = col;
      ctx.font = `${fontStyle ? fontStyle + ' ' : ''}${size}px ${fontStyle ? FONT_MATH : 'ui-sans-serif, system-ui, sans-serif'}`;
      ctx.textAlign = align;
      ctx.textBaseline = 'middle';
      ctx.fillText(text, pp.p2[0], pp.p2[1] + dy);
      ctx.restore();
    };

    const arrowAt = (C: ReturnType<typeof makeCam>, tip: Pt3, tail: Pt3, col: string) => {
      const pt = project(tip, C);
      const pr = project(tail, C);
      if (!pt.visible || !pr.visible) return;
      const dx = pt.p2[0] - pr.p2[0];
      const dy = pt.p2[1] - pr.p2[1];
      const len = Math.hypot(dx, dy);
      if (len < 2) return;
      const ux = dx / len, uy = dy / len;
      const sz = 8;
      ctx.save();
      ctx.fillStyle = col;
      ctx.beginPath();
      ctx.moveTo(pt.p2[0], pt.p2[1]);
      ctx.lineTo(pt.p2[0] - sz * ux + (sz * 0.45) * uy, pt.p2[1] - sz * uy - (sz * 0.45) * ux);
      ctx.lineTo(pt.p2[0] - sz * ux - (sz * 0.45) * uy, pt.p2[1] - sz * uy + (sz * 0.45) * ux);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    };

    const rot2 = (x: number, y: number, ang: number): [number, number] => {
      const c = Math.cos(ang), s = Math.sin(ang);
      return [x * c - y * s, x * s + y * c];
    };

    const arcPts = (cx: number, cy: number, r: number, a0: number, a1: number): Pt3[] => {
      const n = Math.max(2, Math.ceil(Math.abs(a1 - a0) / 0.05));
      const pts: Pt3[] = [];
      for (let j = 0; j <= n; j++) {
        const a = a0 + (a1 - a0) * j / n;
        pts.push([cx + r * Math.cos(a), cy + r * Math.sin(a), 0]);
      }
      return pts;
    };

    const axesC = (C: ReturnType<typeof makeCam>, cx: number, hw: number, hh: number, o?: { hwL?: number; xlab?: string; ylab?: string; xticks?: { v: number; lab: string; c?: string }[]; yticks?: { v: number; lab: string; c?: string }[] }) => {
      const opt = o || {};
      const hl = opt.hwL != null ? opt.hwL : hw;
      line3(C, [cx - hl, 0, 0], [cx + hw, 0, 0], AXIS, 1.4);
      arrowAt(C, [cx + hw, 0, 0], [cx + hw - 0.2, 0, 0], AXIS);
      label3(C, [cx + hw + 0.25, 0, 0], opt.xlab || 'Re', COL_AXIS_LBL, 13, 'center', 0, 'italic');
      line3(C, [cx, -hh, 0], [cx, hh, 0], AXIS, 1.4);
      arrowAt(C, [cx, hh, 0], [cx, hh - 0.2, 0], AXIS);
      label3(C, [cx, hh + 0.2, 0], opt.ylab || 'Im', COL_AXIS_LBL, 13, 'center', 0, 'italic');

      (opt.xticks || []).forEach(tk => {
        line3(C, [cx + tk.v, -0.05, 0], [cx + tk.v, 0.05, 0], AXIS_DIM, 1.2);
        label3(C, [cx + tk.v, -0.22, 0], tk.lab, tk.c || COL_TICK, 10.5, 'center', 0, tk.c ? 'italic' : '');
      });
      (opt.yticks || []).forEach(tk => {
        line3(C, [cx - 0.05, tk.v, 0], [cx + 0.05, tk.v, 0], AXIS_DIM, 1.2);
        label3(C, [cx - 0.15, tk.v, 0], tk.lab, tk.c || COL_TICK, 10.5, 'right', 0, tk.c ? 'italic' : '');
