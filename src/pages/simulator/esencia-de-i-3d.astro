            </p>
            <p>
              La respuesta radica en la <strong>simetría de los gemelos conjugados</strong>:
            </p>
            <div class="math-center">${renderMathClient(String.raw`z = a + bi \quad\Longleftrightarrow\quad \bar{z} = a - bi`, true)}</div>
            <p>
              En cualquier polinomio o ecuación diferencial con coeficientes reales, las soluciones complejas aparecen obligatoriamente en pares conjugados. Al sumarse o multiplicarse:
            </p>
            <div class="math-center">${renderMathClient(String.raw`z + \bar{z} = 2a \in \mathbb{R} \qquad z \cdot \bar{z} = a^2 + b^2 \in \mathbb{R}`, true)}</div>
            <p>
              La parte imaginaria se cancela de forma exacta y simétrica, garantizando que el mundo observable permanezca 100% en el eje real.
            </p>
          </section>

          <section class="guide-section">
            <div class="sec-badge">SECCIÓN 5</div>
            <h3>La desmitificación definitiva: $i$ es álgebra lineal pura</h3>
            <p>
              Si aún dudas de si $i$ existe, considera la siguiente matriz cuadrada de números reales ordinarios:
            </p>
            <div class="math-center">${renderMathClient(String.raw`J = \begin{pmatrix} 0 & -1 \\ 1 & 0 \end{pmatrix}`, true)}</div>
            <p>
              Al multiplicar esta matriz por sí misma:
            </p>
            <div class="math-center">${renderMathClient(String.raw`J^2 = \begin{pmatrix} 0 & -1 \\ 1 & 0 \end{pmatrix} \begin{pmatrix} 0 & -1 \\ 1 & 0 \end{pmatrix} = \begin{pmatrix} -1 & 0 \\ 0 & -1 \end{pmatrix} = -I`, true)}</div>
            <p>
              Cualquier número complejo $a + bi$ es matemáticamente indistinguible de la matriz:
            </p>
            <div class="math-center">${renderMathClient(String.raw`aI + bJ = \begin{pmatrix} a & -b \\ b & a \end{pmatrix}`, true)}</div>
            <p>
              No hace falta imaginar nada esotérico: <strong>los números complejos son simplemente matrices reales de rotación y escalado de $2 \times 2$ escritas en notación abreviada</strong>.
            </p>
          </section>
        </article>
      `;
    };
    populateGuide();

    // Controles DOM
    const tabBtns = document.querySelectorAll('.i-tab-btn');
    const camBtns = document.querySelectorAll('.cam-btn');
    const btnFold = document.getElementById('btnFold');
    const panel = document.getElementById('panel');
    const btnOpenGuide = document.getElementById('btnOpenGuide');
    const btnCloseGuide = document.getElementById('btnCloseGuide');
    const guideDrawer = document.getElementById('guideDrawer');

    // Drawer de Guía
    btnOpenGuide?.addEventListener('click', () => guideDrawer?.classList.add('open'));
    btnCloseGuide?.addEventListener('click', () => guideDrawer?.classList.remove('open'));

    // Plegar panel
    btnFold?.addEventListener('click', () => {
      panel?.classList.toggle('collapsed');
      if (btnFold) btnFold.textContent = panel?.classList.contains('collapsed') ? '+' : '−';
    });

    // Pestañas
    const ctlSections = {
      turn: document.querySelector('.tab-turn-only') as HTMLElement,
      cubic: document.querySelector('.tab-cubic-only') as HTMLElement,
      roots: document.querySelector('.tab-roots-only') as HTMLElement,
      conj: document.querySelector('.tab-conj-only') as HTMLElement,
      matrix: document.querySelector('.tab-matrix-only') as HTMLElement,
    };

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        state.tab = btn.getAttribute('data-tab') as typeof state.tab;

        Object.keys(ctlSections).forEach(k => {
          if (ctlSections[k as keyof typeof ctlSections]) {
            ctlSections[k as keyof typeof ctlSections].style.display = k === state.tab ? 'block' : 'none';
          }
        });

        updateTogglesUI();
        updateTelemetry();

        // Ajustes de cámara sugeridos para cada escena
        if (state.tab === 'turn') {
          cam.az = -0.7; cam.el = 0.35; cam.dist = 8.5; cam.tx = 0; cam.ty = 0; cam.tz = 0;
        } else if (state.tab === 'cubic') {
          cam.az = -0.55; cam.el = 0.3; cam.dist = 9.5; cam.tx = 0; cam.ty = 0; cam.tz = 0;
        } else if (state.tab === 'roots') {
          cam.az = -0.75; cam.el = 0.42; cam.dist = 9.5; cam.tx = 0; cam.ty = 0.6; cam.tz = 0;
        } else if (state.tab === 'conj') {
          cam.az = -0.7; cam.el = 0.35; cam.dist = 8.5; cam.tx = 0; cam.ty = 0; cam.tz = 0;
        } else {
          cam.az = -0.7; cam.el = 0.35; cam.dist = 8.5; cam.tx = 0; cam.ty = 0; cam.tz = 0;
        }
      });
    });

    // Sliders Escena 1
    const slRe0 = document.getElementById('slRe0') as HTMLInputElement;
    const vRe0 = document.getElementById('vRe0') as HTMLElement;
    const slIm0 = document.getElementById('slIm0') as HTMLInputElement;
    const vIm0 = document.getElementById('vIm0') as HTMLElement;
    const slTurnSpeed = document.getElementById('slTurnSpeed') as HTMLInputElement;
    const vTurnSpeed = document.getElementById('vTurnSpeed') as HTMLElement;

    slRe0?.addEventListener('input', () => {
      state.re0 = parseFloat(slRe0.value);
      if (vRe0) vRe0.textContent = state.re0.toFixed(2);
      updateTelemetry();
    });
    slIm0?.addEventListener('input', () => {
      state.im0 = parseFloat(slIm0.value);
      if (vIm0) vIm0.textContent = state.im0.toFixed(2);
      updateTelemetry();
    });
    slTurnSpeed?.addEventListener('input', () => {
      state.turnSpeed = parseFloat(slTurnSpeed.value);
      if (vTurnSpeed) vTurnSpeed.textContent = state.turnSpeed.toFixed(2) + '×';
    });

    document.getElementById('btnPreset1')?.addEventListener('click', () => {
      state.re0 = 1; state.im0 = 0;
      slRe0.value = '1'; slIm0.value = '0';
      vRe0.textContent = '1.00'; vIm0.textContent = '0.00';
      updateTelemetry();
    });
    document.getElementById('btnPresetI')?.addEventListener('click', () => {
      state.re0 = 0; state.im0 = 1;
      slRe0.value = '0'; slIm0.value = '1';
      vRe0.textContent = '0.00'; vIm0.textContent = '1.00';
      updateTelemetry();
    });
    document.getElementById('btnPresetDiag')?.addEventListener('click', () => {
      state.re0 = 1; state.im0 = 1;
      slRe0.value = '1'; slIm0.value = '1';
      vRe0.textContent = '1.00'; vIm0.textContent = '1.00';
      updateTelemetry();
    });

    // Sliders Escena 2
    const slBranchK = document.getElementById('slBranchK') as HTMLInputElement;
    const vBranchK = document.getElementById('vBranchK') as HTMLElement;
    const branchBtns = [
      document.getElementById('btnBranch0'),
      document.getElementById('btnBranch1'),
      document.getElementById('btnBranch2'),
    ];

    const setBranch = (k: number) => {
      state.branchK = k;
      if (slBranchK) slBranchK.value = String(k);
      if (vBranchK) vBranchK.textContent = `${k} (${CB_REAL_LAB[k]})`;
      branchBtns.forEach((b, idx) => b?.classList.toggle('active', idx === k));
      updateTelemetry();
    };

    slBranchK?.addEventListener('input', () => setBranch(parseInt(slBranchK.value, 10)));
    branchBtns.forEach((b, idx) => b?.addEventListener('click', () => setBranch(idx)));

    // Sliders Escena 3
    const slParamC = document.getElementById('slParamC') as HTMLInputElement;
    const vParamC = document.getElementById('vParamC') as HTMLElement;
    const btnPolyQuad = document.getElementById('btnPolyQuad');
    const btnPolyCubic = document.getElementById('btnPolyCubic');

    btnPolyQuad?.addEventListener('click', () => {
      btnPolyQuad.classList.add('active');
      btnPolyCubic?.classList.remove('active');
      state.polySel = 0;
      updateTelemetry();
    });
    btnPolyCubic?.addEventListener('click', () => {
      btnPolyCubic.classList.add('active');
      btnPolyQuad?.classList.remove('active');
      state.polySel = 1;
      updateTelemetry();
    });

    slParamC?.addEventListener('input', () => {
      state.paramC = parseFloat(slParamC.value);
      if (vParamC) vParamC.textContent = (state.paramC >= 0 ? '+' : '') + state.paramC.toFixed(2);
      updateTelemetry();
    });

    document.getElementById('btnPresetNegC')?.addEventListener('click', () => {
      state.paramC = -1; slParamC.value = '-1'; vParamC.textContent = '-1.00';
      updateTelemetry();
    });
    document.getElementById('btnPresetZeroC')?.addEventListener('click', () => {
      state.paramC = 0; slParamC.value = '0'; vParamC.textContent = '0.00';
      updateTelemetry();
    });
    document.getElementById('btnPresetPosC')?.addEventListener('click', () => {
      state.paramC = 1; slParamC.value = '1'; vParamC.textContent = '+1.00';
      updateTelemetry();
    });

    // Sliders Escena 4
    const slZRe = document.getElementById('slZRe') as HTMLInputElement;
    const vZRe = document.getElementById('vZRe') as HTMLElement;
    const slZIm = document.getElementById('slZIm') as HTMLInputElement;
    const vZIm = document.getElementById('vZIm') as HTMLElement;
    const slQuarQ = document.getElementById('slQuarQ') as HTMLInputElement;
    const vQuarQ = document.getElementById('vQuarQ') as HTMLElement;

    slZRe?.addEventListener('input', () => {
      state.zRe = parseFloat(slZRe.value);
      if (vZRe) vZRe.textContent = state.zRe.toFixed(2);
      updateTelemetry();
    });
    slZIm?.addEventListener('input', () => {
      state.zIm = parseFloat(slZIm.value);
      if (vZIm) vZIm.textContent = state.zIm.toFixed(2);
      updateTelemetry();
    });
    slQuarQ?.addEventListener('input', () => {
      state.quarQ = parseFloat(slQuarQ.value);
      if (vQuarQ) vQuarQ.textContent = state.quarQ.toFixed(2);
      updateTelemetry();
    });

    // Sliders Escena 5
    const slMatA = document.getElementById('slMatA') as HTMLInputElement;
    const vMatA = document.getElementById('vMatA') as HTMLElement;
    const slMatB = document.getElementById('slMatB') as HTMLInputElement;
    const vMatB = document.getElementById('vMatB') as HTMLElement;
    const slMatSpeed = document.getElementById('slMatSpeed') as HTMLInputElement;
    const vMatSpeed = document.getElementById('vMatSpeed') as HTMLElement;

    slMatA?.addEventListener('input', () => {
      state.matA = parseFloat(slMatA.value);
      if (vMatA) vMatA.textContent = state.matA.toFixed(2);
      updateTelemetry();
    });
    slMatB?.addEventListener('input', () => {
      state.matB = parseFloat(slMatB.value);
      if (vMatB) vMatB.textContent = state.matB.toFixed(2);
      updateTelemetry();
    });
    slMatSpeed?.addEventListener('input', () => {
      state.matSpeed = parseFloat(slMatSpeed.value);
      if (vMatSpeed) vMatSpeed.textContent = state.matSpeed.toFixed(2) + '×';
    });

    // Cámara Presets
    camBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        camBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const view = btn.getAttribute('data-view');
        if (view === 'iso') {
          cam.az = -0.7; cam.el = 0.35; cam.dist = 8.5; cam.tx = 0; cam.ty = 0; cam.tz = 0;
        } else if (view === 'front') {
          cam.az = 0.001; cam.el = 0.02; cam.dist = 6.8; cam.tx = 0; cam.ty = 0; cam.tz = 0;
        } else if (view === 'top') {
          cam.az = 0.001; cam.el = 1.54; cam.dist = 8.0; cam.tx = 0; cam.ty = 0; cam.tz = 0;
        }
      });
    });

    // Interacción ratón / táctil con la cámara
    let isDragging = false;
    let isPanning = false;
    let lastX = 0, lastY = 0;

    canvas.addEventListener('mousedown', e => {
      isDragging = true;
      isPanning = e.shiftKey || e.button === 2;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas.classList.add('dragging');
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
      isPanning = false;
      canvas.classList.remove('dragging');
    });

    window.addEventListener('mousemove', e => {
      if (!isDragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      lastX = e.clientX;
      lastY = e.clientY;

      if (isPanning) {
        cam.tx -= dx * 0.008 * (cam.dist / 8);
        cam.ty += dy * 0.008 * (cam.dist / 8);
      } else {
        cam.az -= dx * 0.007;
        cam.el = Math.max(-1.52, Math.min(1.52, cam.el + dy * 0.007));
      }
    });

    canvas.addEventListener('wheel', e => {
      e.preventDefault();
      const zoomFactor = e.deltaY > 0 ? 1.08 : 0.92;
      cam.dist = Math.max(2.5, Math.min(25, cam.dist * zoomFactor));
    }, { passive: false });

    canvas.addEventListener('dblclick', () => {
      cam.az = -0.7;
      cam.el = 0.35;
      cam.dist = 8.5;
      cam.tx = 0;
      cam.ty = 0;
      cam.tz = 0;
    });

    // Inicializar UI de toggles y telemetría
    updateTogglesUI();
    updateTelemetry();

    // =========================================================================
    // LOOP DE RENDERIZADO PRINCIPAL
    // =========================================================================
    let lastTime = performance.now();

    const render = (now: number) => {
      const dt = Math.min(0.1, (now - lastTime) / 1000);
      lastTime = now;
      state.t += dt;

      // Incrementar variables continuas
      if (state.tab === 'turn') {
        turnA += (0.9 * state.turnSpeed) * dt;
      } else if (state.tab === 'matrix') {
        matU += (0.9 * state.matSpeed) * dt;
      }

      ctx.clearRect(0, 0, W, H);
      syncThemeColors();
      const C = makeCam();

      // =====================================================================
      // 1. ESCENA 1: EL CUARTO DE VUELTA (×i = 90°)
      // =====================================================================
      if (state.tab === 'turn') {
        const a0 = state.re0, b0 = state.im0;
        const R = Math.hypot(a0, b0);
        const base = Math.atan2(b0, a0);
        const rot = state.stepDemo ? stepAngle(turnA) : turnA * Math.PI * 0.5;
        const n = Math.floor(turnA);
        const nm = ((n % 4) + 4) % 4;

        if (state.showGrid) gridRect(C, -2.4, 2.4, -2.0, 2.0, 0.5);

        axesC(C, 0, 2.35, 1.9, {
          xlab: 'Re',
          ylab: 'Im',
          xticks: [{ v: -2, lab: '−2' }, { v: -1, lab: '−1' }, { v: 1, lab: '1' }, { v: 2, lab: '2' }],
          yticks: [{ v: 1, lab: 'i', c: C_CYN }, { v: -1, lab: '−i', c: C_CYN }],
        });

        // Eje real destacado
        line3(C, [-2.35, 0, 0], [2.35, 0, 0], 'rgba(45,212,234,0.15)', 5.5);
        line3(C, [-2.35, 0, 0], [2.35, 0, 0], 'rgba(45,212,234,0.6)', 1.8);
        label3(C, [-2.25, 0.2, 0], 'Eje Real ℝ', hexA(C_CYN, 0.85), 11, 'left');

        // Círculo orbital de radio R
        if (R > 0.05) {
          const circ = arcPts(0, 0, R, 0, Math.PI * 2);
          for (let i = 0; i < circ.length - 1; i++) {
            line3(C, circ[i], circ[i + 1], 'rgba(251,191,36,0.22)', 1, [4, 5]);
          }
        }

        // Cuatro estaciones z₀, i·z₀, −z₀, −i·z₀
        if (state.showGhosts && R > 0.04) {
          const stationLabs = ['z₀', 'i·z₀', '−z₀', '−i·z₀'];
          for (let k = 0; k < 4; k++) {
            const p2 = rot2(a0, b0, k * (Math.PI / 2));
            const isCur = k === nm;
            dot3D(C, [p2[0], p2[1], 0], isCur ? 4.5 : 3.0, hexA(C_VIO, isCur ? 1 : 0.6), '#ffffff', isCur ? 2 : 1);
            label3(
              C,
              [p2[0] * (1 + 0.28 / R), p2[1] * (1 + 0.28 / R), 0],
              stationLabs[k],
              hexA(C_VIO, 0.95),
              12,
              'center',
              0,
              'italic'
            );
          }
        }

        // Arco de giro y ángulo recto 90°
        if (state.showArc && R > 0.04) {
          const aSt = base + n * (Math.PI / 2);
          const currentArc = arcPts(0, 0, R, aSt, base + rot);
          for (let i = 0; i < currentArc.length - 1; i++) {
            line3(C, currentArc[i], currentArc[i + 1], 'rgba(251,191,36,0.9)', 2.2);
          }
          const ca = Math.cos(aSt), sa = Math.sin(aSt), ss = 0.16;
          line3(C, [(R - ss) * ca, (R - ss) * sa, 0], [(R - ss) * ca - ss * sa, (R - ss) * sa + ss * ca, 0], 'rgba(251,191,36,0.85)', 1.2);
          line3(C, [(R - ss) * ca - ss * sa, (R - ss) * sa + ss * ca, 0], [R * ca - ss * sa, R * sa + ss * ca, 0], 'rgba(251,191,36,0.85)', 1.2);

          const midA = aSt + Math.min(Math.PI / 4, (rot - n * (Math.PI / 2)) / 2);
          label3(C, [(R + 0.28) * Math.cos(midA), (R + 0.28) * Math.sin(midA), 0], '90°', C_AMB, 11, 'center', 0, 'italic');
        }

        // Vector radio giratorio z
        const pRot = rot2(a0, b0, rot);
        line3(C, [0, 0, 0], [pRot[0], pRot[1], 0], COL_VEC_MAIN, 2.2);
        arrowAt(C, [pRot[0], pRot[1], 0], [pRot[0] * 0.85, pRot[1] * 0.85, 0], '#ffffff');

        if (state.showTurnPt && R > 0.04) {
          glowDot(C, [pRot[0], pRot[1], 0], 8, '#ffffff', hexA(C_ROSE, 0.95));
          label3(C, [pRot[0], pRot[1], 0], 'z', C_ROSE, 14, 'left', -14, 'italic');
        }

        // Destello dorado cuando aterriza en -z₀ (i² = -1)
        const rotMod = ((rot % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
        if (Math.abs(rotMod - Math.PI) < 0.22) {
          const negP = rot2(a0, b0, Math.PI);
          glowDot(C, [negP[0], negP[1], 0], 16 + 4 * Math.sin(state.t * 10), '#fffbeb', 'rgba(251,191,36,0.95)');
          label3(C, [negP[0], negP[1] - 0.35, 0], 'i² z₀ = −z₀', C_AMB, 13, 'center', 0, 'italic');
        }

        label3(C, [-2.25, 1.68, 0], '×i = Rotación 90° antihoraria', C_ROSE, 13, 'left', 0, 'italic');
      }

      // =====================================================================
      // 2. ESCENA 2: CARDANO (x³ = 15x + 4)
      // =====================================================================
      else if (state.tab === 'cubic') {
        const k = Math.round(state.branchK);
        if (state.showGrid) gridRect(C, -3.5, 3.8, -1.6, 1.6, 0.5);

        // Panel Izquierdo: Curva Real y = x³ - 15x - 4
        axesC(C, CBA.cx, 1.5, 1.75, {
          hwL: 1.4,
          xlab: 'x',
          ylab: 'y',
          xticks: [
            { v: -4 * CBA.sx, lab: '−4' },
            { v: -2 * CBA.sx, lab: '−2' },
            { v: 2 * CBA.sx, lab: '2' },
            { v: 4 * CBA.sx, lab: '4' },
          ],
        });

        if (state.showCubic) {
          const pts: Pt3[] = [];
          for (let x = CBA.x0; x <= CBA.x1 + 1e-6; x += 0.05) {
            const y = (x * x * x - 15 * x - 4) * CBA.sy;
            pts.push([CBA.cx + x * CBA.sx, y, 0]);
          }
          for (let i = 0; i < pts.length - 1; i++) {
            line3(C, pts[i], pts[i + 1], hexA(C_ROSE, 0.9), 2.2);
          }
          label3(C, [CBA.cx - 1.35, 1.6, 0], 'y = x³ − 15x − 4', C_ROSE, 13, 'left', 0, 'italic');
        }

        // Raíces reales marcadas en el eje X izquierdo
        CB_REAL.forEach((r, idx) => {
          const wx = CBA.cx + r * CBA.sx;
          line3(C, [wx, -0.08, 0], [wx, 0.08, 0], 'rgba(251,191,36,0.9)', 2);
          label3(C, [wx, 0.25, 0], CB_REAL_LAB[idx], hexA(C_AMB, idx === k ? 1 : 0.6), 11, 'center', 0, 'italic');
        });

        // Panel Derecho: Plano Complejo w = ∛(2 ± 11i) sobre círculo |w| = √5
        axesC(C, CBB.cx, 1.95, 1.45, {
          hwL: 1.35,
          xlab: 'Re',
          ylab: 'Im',
          xticks: [{ v: 2 * CBB.s, lab: '2' }, { v: -2 * CBB.s, lab: '−2' }],
          yticks: [{ v: CBB.s, lab: 'i', c: C_CYN }, { v: -CBB.s, lab: '−i', c: C_CYN }],
        });

        const circ = arcPts(CBB.cx, 0, CB_MOD * CBB.s, 0, Math.PI * 2);
        for (let i = 0; i < circ.length - 1; i++) {
          line3(C, circ[i], circ[i + 1], 'rgba(45,212,234,0.7)', 1.8);
        }
        label3(C, [CBB.cx - 0.95, 1.05, 0], '|w| = √5', C_CYN, 12, 'center', 0, 'italic');

        const toW = (re: number, im: number): Pt3 => [CBB.cx + re * CBB.s, im * CBB.s, 0];

        // 3 Raíces de ∛(2 + 11i) en violeta
        if (state.showRootsP) {
          CB_ROOTS.forEach((r, idx) => {
            const isCur = idx === k;
            glowDot(C, toW(r[0], r[1]), isCur ? 7 : 4.5, '#ffffff', hexA(C_VIO, isCur ? 0.95 : 0.5));
          });
          label3(C, toW(2, 1), '2 + i', C_VIO, 12, 'left', -10, 'italic');
          label3(C, [CBB.cx - 1.25, 1.35, 0], '∛(2 + 11i)', C_VIO, 12, 'left', 0, 'italic');
        }

        // 3 Raíces conjugadas de ∛(2 − 11i) en esmeralda
        if (state.showConjP) {
          CB_ROOTS.forEach((r, idx) => {
            const isCur = idx === k;
            glowDot(C, toW(r[0], -r[1]), isCur ? 7 : 4.5, '#ffffff', hexA(C_EME, isCur ? 0.95 : 0.5));
          });
          label3(C, toW(2, -1), '2 − i', C_EME, 12, 'left', 12, 'italic');
          label3(C, [CBB.cx - 1.25, -1.35, 0], '∛(2 − 11i)', C_EME, 12, 'left', 0, 'italic');
        }

        // Par conjugado sumándose y conectando con la raíz real (Puente de Cardano)
        if (state.showPair) {
          const r = CB_ROOTS[k];
          const sumReal = 2 * r[0];
          const pTop = toW(r[0], r[1]);
          const pBot = toW(r[0], -r[1]);
          const pSum = toW(sumReal, 0);

          line3(C, pTop, pBot, 'rgba(251,191,36,0.8)', 1.5, [5, 5]);
          line3(C, pTop, pSum, 'rgba(251,191,36,0.5)', 1.2, [4, 4]);
          line3(C, pBot, pSum, 'rgba(251,191,36,0.5)', 1.2, [4, 4]);

          glowDot(C, pSum, 8 + 2 * Math.sin(state.t * 6), '#fffbeb', 'rgba(251,191,36,0.95)');
          label3(C, pSum, `Suma = ${sumReal.toFixed(2)}`, C_AMB, 11.5, 'center', -16, 'italic');

          // Puente ámbar hacia el panel izquierdo
          const pRealLeft: Pt3 = [CBA.cx + CB_REAL[k] * CBA.sx, 0, 0];
          line3(C, pSum, pRealLeft, 'rgba(251,191,36,0.7)', 1.6, [6, 6]);
          arrowAt(C, pRealLeft, [pRealLeft[0] + 0.3, 0, 0], 'rgba(251,191,36,0.95)');
          glowDot(C, pRealLeft, 8 + 2 * Math.sin(state.t * 6), '#fffbeb', 'rgba(251,191,36,0.95)');
        }

        label3(C, [0, 1.85, 0], 'x = ∛(2 + 11i) + ∛(2 − 11i)', C_AMB, 13.5, 'center', 0, 'italic');
        label3(C, [CBB.cx - 1.3, -1.7, 0], '(2 + i)³ = 2 + 11i', C_VIO, 12, 'left', 0, 'italic');
      }

      // =====================================================================
      // 3. ESCENA 3: RAÍCES FUERA DEL PAPEL (|p(z)|)
      // =====================================================================
      else if (state.tab === 'roots') {
        const sel = state.polySel;
        const c = state.paramC;
        const sc = RT_SC[sel];

        if (state.showGrid) gridFloor(C, 2.2, 0.5);

        // Ejes 3D: X = Re(z), Z = Im(z), Y = |p(z)|
        line3(C, [-2.2, 0, 0], [2.35, 0, 0], AXIS, 1.4);
        arrowAt(C, [2.35, 0, 0], [2.15, 0, 0], AXIS);
        label3(C, [2.6, 0, 0], 'Re z', COL_AXIS_LBL, 13, 'center', 0, 'italic');

        line3(C, [0, 0, -2.2], [0, 0, 2.35], AXIS, 1.4);
        arrowAt(C, [0, 0, 2.35], [0, 0, 2.15], AXIS);
        label3(C, [0, 0, 2.6], 'Im z', COL_AXIS_LBL, 13, 'center', 0, 'italic');

        line3(C, [0, 0, 0], [0, 2.5, 0], AXIS, 1.4);
        arrowAt(C, [0, 2.5, 0], [0, 2.3, 0], AXIS);
        label3(C, [0, 2.7, 0], '|p(z)|', COL_AXIS_LBL, 13, 'center', 0, 'italic');

        // Malla de la superficie 3D |p(z)|
        if (state.showSurf) {
          const X = (i: number) => -RT_D + 2 * RT_D * i / RT_GN;
          const h = (re: number, im: number) => {
            const p = pEval(sel, c, re, im);
            return Math.hypot(p[0], p[1]) * sc;
          };

          // Rejillas longitudinales
          for (let j = 0; j <= RT_GN; j += 2) {
            for (let i = 0; i < RT_GN; i++) {
              const p1: Pt3 = [X(i), h(X(i), X(j)), X(j)];
              const p2: Pt3 = [X(i + 1), h(X(i + 1), X(j)), X(j)];
              line3(C, p1, p2, 'rgba(45,212,234,0.22)', 1);
            }
          }
          // Rejillas transversales
          for (let i = 0; i <= RT_GN; i += 2) {
            for (let j = 0; j < RT_GN; j++) {
              const p1: Pt3 = [X(i), h(X(i), X(j)), X(j)];
              const p2: Pt3 = [X(i), h(X(i), X(j + 1)), X(j + 1)];
              line3(C, p1, p2, 'rgba(45,212,234,0.22)', 1);
            }
          }
        }

        // Corte en el eje real Im(z) = 0 (la curva del libro de texto)
        if (state.showSlice) {
          const slicePts: Pt3[] = [];
          for (let x = -RT_D; x <= RT_D + 1e-6; x += 0.04) {
            const val = pEval(sel, c, x, 0)[0];
            slicePts.push([x, Math.abs(val) * sc, 0]);
          }
          for (let i = 0; i < slicePts.length - 1; i++) {
            line3(C, slicePts[i], slicePts[i + 1], hexA(C_ROSE, 0.95), 2.4);
          }
          label3(
            C,
            [-1.5, Math.abs(pEval(sel, c, -1.5, 0)[0]) * sc + 0.3, 0],
            sel === 0 ? 'y = x² + c' : 'y = x³ − x + c',
            C_ROSE,
            13,
            'center',
            0,
            'italic'
          );
        }

        // Huella de migración de raíces (c ∈ [-2, 2])
        if (state.showPath) {
          for (let cStep = -2; cStep <= 2; cStep += 0.08) {
            rtRoots(sel, cStep).forEach(r => {
              dot3D(C, [r[0], 0, r[1]], 1.5, hexA(C_VIO, 0.4), 'transparent', 0);
            });
          }
          label3(C, [0.15, 0, 1.6], 'Huella de migración de raíces', hexA(C_VIO, 0.85), 11, 'left');
        }

        // Pozos de ceros actuales
        if (state.showPits) {
          const roots = rtRoots(sel, c);
          roots.forEach(r => {
            if (Math.abs(r[0]) > RT_D || Math.abs(r[1]) > RT_D) return;
            glowDot(C, [r[0], 0, r[1]], 6.5, '#fffbeb', 'rgba(251,191,36,0.95)');
            label3(
              C,
              [r[0], 0.25, r[1]],
              Math.abs(r[1]) < 1e-4 ? fmt(r[0]) : czs(r[0], r[1]),
              C_AMB,
              11,
              'center',
              0,
              'italic'
            );
          });

          // Alerta visual de colisión / despegue del papel cuando c ≈ 0
          if (Math.abs(c) < 0.08) {
            glowDot(C, [0, 0, 0], 14 + 3 * Math.sin(state.t * 8), '#ffffff', 'rgba(251,191,36,0.9)');
            label3(C, [0, -0.3, 0], '¡Las raíces chocan y despegan del papel!', C_AMB, 12, 'center', 0, 'italic');
          }
        }
      }

      // =====================================================================
      // 4. ESCENA 4: GEMELOS ESPEJO (CONJUGADOS)
      // =====================================================================
      else if (state.tab === 'conj') {
        const a = state.zRe, b = state.zIm, q = state.quarQ;
        if (state.showGrid) gridRect(C, -2.4, 2.4, -2.0, 2.0, 0.5);

        axesC(C, 0, 2.5, 1.9, {
          xlab: 'Re',
          ylab: 'Im',
          xticks: [{ v: -1, lab: '−1' }, { v: 1, lab: '1' }, { v: 2, lab: '2' }],
          yticks: [{ v: 1, lab: 'i', c: C_CYN }, { v: -1, lab: '−i', c: C_CYN }],
        });

        // Espejo = Eje Real ℝ
        line3(C, [-2.5, 0, 0], [2.5, 0, 0], 'rgba(45,212,234,0.12)', 7);
        line3(C, [-2.5, 0, 0], [2.5, 0, 0], 'rgba(45,212,234,0.8)', 1.8);
        label3(C, [-2.4, 0.2, 0], 'Espejo = Eje Real ℝ', hexA(C_CYN, 0.85), 11, 'left');

        // z (Rosa) y z̄ (Violeta)
        if (state.showZ) {
          line3(C, [0, 0, 0], [a, b, 0], COL_VEC_MAIN, 2);
          glowDot(C, [a, b, 0], 7.5, '#ffffff', hexA(C_ROSE, 0.95));
          label3(C, [a, b + 0.25, 0], 'z = a + bi', C_ROSE, 13, 'center', 0, 'italic');
        }

        if (state.showTwin) {
          line3(C, [0, 0, 0], [a, -b, 0], COL_VEC_SUB, 1.6);
          line3(C, [a, b, 0], [a, -b, 0], hexA(C_VIO, 0.55), 1.4, [6, 6]);
          glowDot(C, [a, -b, 0], 6.5, '#ffffff', hexA(C_VIO, 0.85));
          label3(C, [a, -b - 0.25, 0], 'z̄ = a − bi', C_VIO, 13, 'center', 0, 'italic');
        }

        // Suma vectorial z + z̄ = 2a (Esmeralda)
        if (state.showSum) {
          line3(C, [a, b, 0], [2 * a, 0, 0], hexA(C_EME, 0.5), 1.2, [5, 5]);
          line3(C, [a, -b, 0], [2 * a, 0, 0], hexA(C_EME, 0.5), 1.2, [5, 5]);
          line3(C, [0, 0, 0], [2 * a, 0, 0], hexA(C_EME, 0.9), 2.4);
          arrowAt(C, [2 * a, 0, 0], [2 * a - (a >= 0 ? 0.2 : -0.2), 0, 0], hexA(C_EME, 0.95));
          glowDot(C, [2 * a, 0, 0], 6, '#ffffff', hexA(C_EME, 0.85));
          label3(C, [2 * a, -0.28, 0], 'z + z̄ = 2a', C_EME, 12, 'center', 0, 'italic');
        }

        // Producto z · z̄ = a² + b² (Naranja)
        if (state.showProd) {
          const m2 = a * a + b * b;
          line3(C, [0, 0, 0], [a, 0, 0], 'rgba(251,191,36,0.75)', 1.4);
          line3(C, [a, 0, 0], [a, b, 0], 'rgba(251,191,36,0.75)', 1.4);
          label3(C, [a / 2, -0.16, 0], 'a', C_AMB, 11.5, 'center', 0, 'italic');
          label3(C, [a + 0.15, b / 2, 0], 'b', C_AMB, 11.5, 'left', 0, 'italic');

          glowDot(C, [m2, 0, 0], 6.5, '#ffffff', hexA(C_ORG, 0.9));
          label3(C, [m2, 0.28, 0], 'z·z̄ = a² + b²', C_ORG, 12, 'center', 0, 'italic');
        }

        // Raíces del polinomio real bajo parámetro q
        if (state.showQuartic) {
          const pr = q > 0
            ? [[0.3, Math.sqrt(q)], [0.3, -Math.sqrt(q)]]
            : [[0.3 + Math.sqrt(-q), 0], [0.3 - Math.sqrt(-q), 0]];

          pr.forEach(r => {
            glowDot(C, [r[0], r[1], 0], 5.5, '#ffffff', 'rgba(226,232,240,0.85)');
          });
          if (q > 0.001) {
            line3(C, [pr[0][0], pr[0][1], 0], [pr[1][0], pr[1][1], 0], 'rgba(226,232,240,0.4)', 1.2, [6, 6]);
          }
          label3(C, [0.3, (q > 0 ? Math.sqrt(q) : 0) + 0.32, 0], 'Raíces conjugadas de polinomio real', 'rgba(226,232,240,0.8)', 11, 'center');
        }
      }

      // =====================================================================
      // 5. ESCENA 5: i ES UNA MATRIZ (J² = −I)
      // =====================================================================
      else {
        const a = state.matA, b = state.matB;
        const rot = state.mDemo ? stepAngle(matU) : matU * Math.PI * 0.5;
        const n = Math.floor(matU);
        const nm = ((n % 4) + 4) % 4;

        if (state.showGrid) gridRect(C, -2.2, 2.2, -2.0, 2.0, 0.5);

        axesC(C, 0, 2.1, 1.9, {
          xlab: 'x',
          ylab: 'y',
          xticks: [{ v: 1, lab: '1' }, { v: -1, lab: '−1' }],
          yticks: [{ v: 1, lab: '1' }, { v: -1, lab: '−1' }],
        });

        // Nube vectorial en rotación bajo J
        if (state.showCloud) {
          MAT_CLOUD.forEach(v => {
            const p = rot2(v[0], v[1], rot);
            line3(C, [0, 0, 0], [p[0], p[1], 0], 'rgba(45,212,234,0.45)', 1.4);
            arrowAt(C, [p[0], p[1], 0], [p[0] * 0.8, p[1] * 0.8, 0], 'rgba(45,212,234,0.65)');
          });
        }

        // Mapa lineal M = aI + bJ (en violeta)
        if (state.showAB) {
          MAT_CLOUD.forEach(v => {
            const p = rot2(v[0], v[1], rot);
            const w = [a * p[0] - b * p[1], b * p[0] + a * p[1]];
            line3(C, [0, 0, 0], [w[0], w[1], 0], hexA(C_VIO, 0.5), 1.4);
            arrowAt(C, [w[0], w[1], 0], [w[0] * 0.8, w[1] * 0.8, 0], hexA(C_VIO, 0.55));
          });
        }

        // Vector guía principal v y sus 4 paradas
        const v0 = [1.05, 0.45];
        if (state.showTrack) {
          for (let k = 0; k < 4; k++) {
            const g = rot2(v0[0], v0[1], k * (Math.PI / 2));
            dot3D(C, [g[0], g[1], 0], 3, hexA(C_ROSE, k === nm ? 1 : 0.4), '#ffffff', 1);
          }
          const pv = rot2(v0[0], v0[1], rot);
          line3(C, [0, 0, 0], [pv[0], pv[1], 0], hexA(C_ROSE, 0.95), 2.4);
          arrowAt(C, [pv[0], pv[1], 0], [pv[0] * 0.85, pv[1] * 0.85, 0], hexA(C_ROSE, 0.95));
          label3(C, [pv[0] * 1.25, pv[1] * 1.25, 0], 'Jⁿ v', C_ROSE, 12, 'center', 0, 'italic');
        }

        // Destello cuando J² = -I
        if (nm === 2 && Math.abs((rot % (Math.PI * 2)) - Math.PI) < 0.2) {
          glowDot(C, [0, 0, 0], 14 + 3 * Math.sin(state.t * 8), '#ffffff', 'rgba(251,191,36,0.9)');
          label3(C, [0, -0.35, 0], 'J² = −I (¡Inversión completa con matriz real!)', C_AMB, 12.5, 'center', 0, 'italic');
        }

        label3(C, [-2.0, 1.7, 0], 'J = [0 −1; 1 0] ≡ i (Rotación 90°)', C_CYN, 13, 'left', 0, 'italic');
      }

      requestAnimationFrame(render);
    };

    requestAnimationFrame(render);
  })();
</script>

