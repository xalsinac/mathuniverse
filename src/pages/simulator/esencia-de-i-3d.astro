    const RT_CRIT = 2 / (3 * Math.sqrt(3));

    const pEval = (sel: number, c: number, re: number, im: number): [number, number] => {
      if (sel === 0) return [re * re - im * im + c, 2 * re * im];
      return [re * re * re - 3 * re * im * im - re + c, 3 * re * re * im - im * im * im - im];
    };

    const rtRoots = (sel: number, c: number): [number, number][] => {
      if (sel === 0) {
        if (c <= 0) {
          const r = Math.sqrt(-c);
          return [[r, 0], [-r, 0]];
        }
        const r = Math.sqrt(c);
        return [[0, r], [0, -r]];
      }
      if (Math.abs(c) <= RT_CRIT) {
        const m = 2 / Math.sqrt(3);
        const ph = Math.acos(Math.max(-1, Math.min(1, -c * 3 * Math.sqrt(3) / 2))) / 3;
        return [0, 1, 2].map(k => [m * Math.cos(ph - 2 * Math.PI * k / 3), 0]);
      }
      const D = Math.sqrt(c * c / 4 - 1 / 27);
      const r = Math.cbrt(-c / 2 + D) + Math.cbrt(-c / 2 - D);
      const im = Math.sqrt(Math.max(0, 3 * r * r - 4)) / 2;
      return [[r, 0], [-r / 2, im], [-r / 2, -im]];
    };

    // Nube vectorial para Escena 5 (Matriz J)
    const MAT_N = 24;
    const MAT_CLOUD: [number, number][] = [];
