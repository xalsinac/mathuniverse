    };

    // Constantes Escena 2 (Cardano: x³ = 15x + 4)
    const CBA = { cx: -1.95, sx: 0.28, sy: 0.042, x0: -4.4, x1: 4.8 };
    const CBB = { cx: 1.85, s: 0.42 };
    const CB_ARG = Math.atan2(11, 2);
    const CB_MOD = Math.sqrt(5);
    const CB_ROOTS = [0, 1, 2].map(k => {
      const a = (CB_ARG + 2 * Math.PI * k) / 3;
      return [CB_MOD * Math.cos(a), CB_MOD * Math.sin(a)] as [number, number];
