---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ScientificCalculator from '../components/ScientificCalculator.astro';
import { site } from '../config/site';
import {
  MODALITIES,
  REGIONS,
  selectividadExams,
  resolveR2Url,
} from '../data/selectividad';

const years = [...new Set(selectividadExams.map((e) => e.year))].sort((a, b) => b - a);

// Serializamos el catálogo con las URLs resueltas hacia Cloudflare R2 para el cliente
const clientExams = selectividadExams.map((exam) => ({
  ...exam,
  statementUrl: resolveR2Url(exam.statementPath),
  solutionUrl: resolveR2Url(exam.solutionPath),
}));
---

<BaseLayout
  title={`Selectividad (PAU) — ${site.name}`}
  description="Exámenes oficiales de Selectividad (PAU) de Matemáticas Científicas y Matemáticas Aplicadas a las Ciencias Sociales clasificados por año, con enunciados y correcciones."
>
  <!-- Barra superior técnica unificada + Cronómetro de Simulacro PAU (90 min) + Buscador ⌘K -->
  <SiteHeader activePage="selectividad" statusText="" ctaLabel="">
    <div slot="right-extra" class="topbar-cell sim-timer" data-sim-timer>
      <span class="timer-label">SIMULACRO PAU</span>
      <strong class="timer-readout" data-timer-display>90:00</strong>
      <button
        type="button"
        class="timer-btn"
        data-timer-toggle
        title="Iniciar / Pausar simulacro de 90 minutos"
      >
        <span data-timer-play-label>▶</span>
      </button>
      <button
        type="button"
        class="timer-btn"
        data-timer-reset
        title="Reiniciar cronómetro a 90:00"
      >
        ↺
      </button>
    </div>
  </SiteHeader>

  <main>
    <section class="selectividad-band section-band is-drawn">
      <span class="section-rule" aria-hidden="true"></span>
      <div class="section-frame">
        <span class="tick tick-half tick-left" aria-hidden="true"></span>
        <span class="tick tick-half tick-right" aria-hidden="true"></span>

        <div class="section-eyebrow">
          <span>
            <span class="eyebrow-num">06</span>
            <span class="eyebrow-sep" aria-hidden="true">/</span>
            Archivo de Selectividad · PAU
          </span>
          <span class="eyebrow-right">Enunciados oficiales · Pautas de corrección · Visor estudio</span>
        </div>

        <!-- Cabecera + Panel Destacado de Cronómetro de Simulacro + Selector de Modalidad -->
        <div class="sel-hero section-body">
          <div class="sel-top-split">
            <div class="sel-intro">
              <p class="kicker">Rumbo a la universidad</p>
              <h1>Exámenes y correcciones <em>por año.</em></h1>
              <p class="sel-lead">
                Elige tu modalidad de Bachillerato, selecciona el año y la convocatoria, y consulta
                tanto el enunciado original como su pauta de resolución paso a paso.
              </p>
            </div>

            <!-- Panel Protagonista: Cronómetro Oficial de Simulacro PAU -->
            <aside class="simulacro-station" data-sim-station aria-label="Cronómetro de simulacro PAU">
              <div class="sim-station-head">
                <div class="sim-title-group">
                  <span class="sim-live-dot" aria-hidden="true"></span>
                  <span class="sim-eyebrow">MODO SIMULACRO OFICIAL PAU</span>
                </div>
                <div class="sim-duration-pills" role="group" aria-label="Duración del simulacro">
                  <button type="button" class="dur-pill is-active" data-timer-preset="90">90m · Examen</button>
                  <button type="button" class="dur-pill" data-timer-preset="45">45m · Medio</button>
                  <button type="button" class="dur-pill" data-timer-preset="25">25m · 1 Ej.</button>
                </div>
              </div>

              <div class="sim-clock-row">
                <div class="sim-big-time" data-timer-display>90:00</div>
                <div class="sim-main-controls">
                  <button type="button" class="sim-primary-btn" data-timer-toggle>
                    <span data-timer-main-label>▶ INICIAR SIMULACRO</span>
                  </button>
                  <button
                    type="button"
                    class="sim-secondary-btn"
                    data-timer-reset
                    title="Reiniciar cuenta atrás"
                  >
                    ↺ REINICIAR
                  </button>
                </div>
              </div>

              <div class="sim-progress-track" aria-hidden="true">
                <div class="sim-progress-bar" data-timer-bar style="width: 100%"></div>
              </div>

              <div class="sim-station-foot">
                <span class="sim-status-msg" data-timer-status>
                  Tiempo oficial de examen: 1 hora y 30 minutos
                </span>
                <div class="sim-foot-btns">
                  <button
                    type="button"
                    class="sim-random-btn"
                    data-toggle-floating-calc
                    title="Abrir calculadora científica flotante o en Picture-in-Picture"
                  >
                    🧮 Calculadora Flotante / PiP
                  </button>
                  <button
                    type="button"
                    class="sim-random-btn"
                    data-random-exam
                    title="Elegir un examen aleatorio de esta modalidad y abrir su enunciado"
                  >
                    🎲 Examen al azar + Cronómetro
                  </button>
                </div>
              </div>
            </aside>
          </div>

          <!-- Selector grande de las 2 asignaturas -->
          <div class="modality-selector" role="tablist" aria-label="Elegir modalidad de Matemáticas">
            <button
              type="button"
              role="tab"
              aria-selected="true"
              class="modality-card is-active"
              data-modality-btn="ciencias"
            >
              <div class="mod-top">
                <span class="mod-code">{MODALITIES.ciencias.code}</span>
                <span class="mod-status">ACTIVA</span>
              </div>
              <h2 class="mod-title">{MODALITIES.ciencias.name}</h2>
              <p class="mod-sub">{MODALITIES.ciencias.subtitle}</p>
            </button>

            <button
              type="button"
              role="tab"
              aria-selected="false"
              class="modality-card"
              data-modality-btn="ccss"
            >
              <div class="mod-top">
                <span class="mod-code">{MODALITIES.ccss.code}</span>
                <span class="mod-status">SELECCIONAR</span>
              </div>
              <h2 class="mod-title">{MODALITIES.ccss.name}</h2>
              <p class="mod-sub">{MODALITIES.ccss.subtitle}</p>
            </button>
          </div>
        </div>

        <!-- Barra de Filtros: Comunidad Autónoma (Cataluña + futuras), Año, Convocatoria y Buscador -->
        <div class="sel-filters-bar">
          <!-- Selector de Comunidad Autónoma preparado para escalar -->
          <div class="filter-row region-row">
            <span class="filter-label">COMUNIDAD AUTÓNOMA:</span>
            <div class="region-pills" role="tablist" aria-label="Comunidad Autónoma">
              {
                REGIONS.map((reg) => (
                  <button
                    type="button"
                    class:list={['region-pill', { 'is-active': reg.id === 'catalunya', 'is-soon': !reg.active }]}
                    data-region-btn={reg.id}
                    data-region-active={String(reg.active)}
                  >
                    <span>{reg.name}</span>
                    {!reg.active && <small>PRÓX.</small>}
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Filtros de Año, Serie/Convocatoria y Búsqueda -->
          <div class="filter-row controls-row">
            <div class="year-pills-wrap">
              <span class="filter-label">AÑO:</span>
              <div class="year-pills">
                <button type="button" class="year-pill is-active" data-year-btn="all">Todos</button>
                {
                  years.map((y) => (
                    <button type="button" class="year-pill" data-year-btn={String(y)}>
                      {y}
                    </button>
                  ))
                }
              </div>
            </div>

            <div class="session-and-search">
              <select class="session-select" data-session-select aria-label="Filtrar por convocatoria">
                <option value="all">Todas las convocatorias (Sèrie 1, 2, Setembre)</option>
                <option value="ordinaria">Junio · Serie 1 (Ordinaria)</option>
                <option value="incidencias">Junio · Serie 2 (Incidencias)</option>
                <option value="extraordinaria">Septiembre · Serie 3 (Extraordinaria)</option>
              </select>

              <input
                type="search"
                class="exam-search-input"
                data-exam-search
                placeholder="Buscar año o serie (ej. 2024 serie 1)..."
                aria-label="Buscar examen"
              />
            </div>
          </div>
        </div>

        <!-- =============================================================== -->
        <!-- VISOR INTEGRADO DE ESTUDIO (ENUNCIADO ↔ CORRECCIÓN / SPLIT)     -->
        <!-- =============================================================== -->
        <div class="study-viewer" data-study-viewer hidden>
          <div class="viewer-toolbar">
            <div class="viewer-info">
              <span class="viewer-badge" data-viewer-badge>MAT-II · 2025</span>
              <h3 class="viewer-title" data-viewer-title>Junio · Serie 1</h3>
            </div>

            <!-- Conmutador Enunciado / Corrección / Vista Dividida -->
            <div class="viewer-mode-tabs" role="tablist" aria-label="Modo de visualización del examen">
              <button
                type="button"
                class="v-tab is-active"
                data-viewer-mode="statement"
              >
                <span>📄 Enunciado</span>
              </button>
              <button
                type="button"
                class="v-tab"
                data-viewer-mode="solution"
              >
                <span>✅ Corrección</span>
              </button>
              <button
                type="button"
                class="v-tab hide-mobile"
                data-viewer-mode="split"
              >
                <span>◫ Lado a lado (Enunciado + Corrección)</span>
              </button>
            </div>

            <div class="viewer-actions">
              <button
                type="button"
                class="viewer-aux-link"
                data-toggle-floating-calc
                title="Mostrar / ocultar calculadora flotante arrastrable encima del examen"
              >
                🧮 Calculadora Flotante
              </button>
              <button
                type="button"
                class="viewer-aux-link is-pip"
                data-trigger-pip-direct
                title="Sacar calculadora en ventana Picture-in-Picture (siempre visible sobre cualquier PDF)"
              >
                ⧉ Sacar en PiP
              </button>
              <button type="button" class="viewer-close-btn" data-viewer-close>
                CERRAR VISOR ✕
              </button>
            </div>
          </div>

          <div class="viewer-stage" data-viewer-stage></div>
        </div>

        <!-- Aviso cuando se selecciona una Comunidad Autónoma marcada como "Próximamente" -->
        <div class="region-soon-banner" data-region-soon hidden>
          <div class="soon-box">
            <span class="soon-kicker">COMUNIDAD EN PREPARACIÓN</span>
            <h3 data-soon-title>Próximamente en Math Universe</h3>
            <p>
              La estructura de carpetas en Cloudflare R2 ya está lista para incorporar los exámenes
              oficiales y soluciones de esta comunidad autónoma. Por ahora puedes consultar el
              archivo completo de <strong>Cataluña (PAU)</strong>.
            </p>
            <button type="button" class="soon-back-btn" data-back-catalunya>
              ← Volver a Cataluña (PAU)
            </button>
          </div>
        </div>

        <!-- =============================================================== -->
        <!-- LISTADO CRONOLÓGICO DE EXÁMENES POR AÑO                         -->
        <!-- =============================================================== -->
        <div class="years-archive section-body" data-years-archive></div>
      </div>
    </section>
  </main>

  <!-- Ventana flotante arrastrable de Calculadora Científica para resolver exámenes sin salir del PDF -->
  <aside
    class="floating-calc-drawer"
    data-floating-calc
    hidden
    aria-label="Calculadora científica flotante"
  >
    <div class="floating-calc-bar" data-floating-drag-handle>
      <div class="floating-calc-title">
        <span class="drag-grip" aria-hidden="true">⠿</span>
        <span>CALCULADORA DE EXAMEN · ARRASTRAR</span>
      </div>
      <div class="floating-calc-actions">
        <button
          type="button"
          class="floating-bar-btn is-pip"
          data-trigger-pip-direct
          title="Sacar fuera del navegador en modo Picture-in-Picture (siempre encima)"
        >
          ⧉ PiP EXTERNO
        </button>
        <button
          type="button"
          class="floating-bar-btn"
          data-close-floating-calc
          title="Cerrar calculadora flotante"
        >
          ✕
        </button>
      </div>
    </div>
    <div class="floating-calc-body">
      <ScientificCalculator compact={true} />
    </div>
  </aside>

  <!-- Pie de página enmarcado -->
  <footer class="footer-section section-band is-drawn">
    <span class="section-rule" aria-hidden="true"></span>
    <div class="section-frame">
      <span class="tick tick-half tick-left" aria-hidden="true"></span>
      <span class="tick tick-half tick-right" aria-hidden="true"></span>

      <div class="footer-body section-body">
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Math Universe · Xavier Alsina</span>
          <a href="/">← Volver a la galaxia principal</a>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>

<script define:vars={{ clientExams, MODALITIES, REGIONS }}>
  window.__SELECTIVIDAD_DATA__ = { clientExams, MODALITIES, REGIONS };
</script>

<script>
  import type { ExamPaper, ModalityId, RegionId } from '../data/selectividad';

  type ClientExam = ExamPaper & {
    statementUrl: string;
    solutionUrl: string;
  };

  const dataStore = (window as unknown as {
    __SELECTIVIDAD_DATA__: {
      clientExams: ClientExam[];
      MODALITIES: Record<ModalityId, { code: string; name: string; subtitle: string }>;
    };
  }).__SELECTIVIDAD_DATA__;

  // 1. Cronómetro oficial de Simulacro PAU (sincronizado entre estación principal y barra superior fija)
  const timerDisplays = document.querySelectorAll<HTMLElement>('[data-timer-display]');
  const timerToggles = document.querySelectorAll<HTMLButtonElement>('[data-timer-toggle]');
  const timerPlayLabel = document.querySelector<HTMLElement>('[data-timer-play-label]');
  const timerMainLabel = document.querySelector<HTMLElement>('[data-timer-main-label]');
  const timerResets = document.querySelectorAll<HTMLButtonElement>('[data-timer-reset]');
  const timerWrap = document.querySelector<HTMLElement>('[data-sim-timer]');
  const timerStation = document.querySelector<HTMLElement>('[data-sim-station]');
  const timerBar = document.querySelector<HTMLElement>('[data-timer-bar]');
  const timerStatus = document.querySelector<HTMLElement>('[data-timer-status]');
  const presetBtns = document.querySelectorAll<HTMLButtonElement>('[data-timer-preset]');

  let totalDurationSec = 90 * 60;
  let remainingSec = totalDurationSec;
  let timerInterval: number | null = null;

  const formatTimer = (sec: number): string => {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  };

  const updateTimerUI = () => {
    const formatted = formatTimer(remainingSec);
    timerDisplays.forEach((el) => {
      el.textContent = formatted;
    });

    const isRunning = timerInterval !== null;
    const isWarn = remainingSec > 0 && remainingSec <= Math.min(15 * 60, totalDurationSec * 0.25);
    const isDone = remainingSec === 0;

    [timerWrap, timerStation].forEach((container) => {
      if (!container) return;
      container.classList.toggle('is-running', isRunning);
      container.classList.toggle('is-warning', isWarn);
      container.classList.toggle('is-finished', isDone);
    });

    if (timerPlayLabel) {
      timerPlayLabel.textContent = isRunning ? '⏸' : '▶';
    }
    if (timerMainLabel) {
      timerMainLabel.textContent = isRunning ? '⏸ PAUSAR SIMULACRO' : '▶ INICIAR SIMULACRO';
    }
    if (timerBar) {
      const pct = totalDurationSec > 0 ? Math.max(0, (remainingSec / totalDurationSec) * 100) : 0;
      timerBar.style.width = `${pct.toFixed(2)}%`;
    }
    if (timerStatus) {
      if (isDone) {
        timerStatus.textContent = '¡Tiempo agotado! Revisa tu examen con la pauta de corrección.';
      } else if (isWarn) {
        timerStatus.textContent = 'Último tramo del examen · Revisa unidades y resultados.';
      } else if (isRunning) {
        timerStatus.textContent = 'Simulacro en curso · El reloj permanece visible arriba al bajar.';
      } else {
        timerStatus.textContent = `Duración seleccionada: ${Math.round(totalDurationSec / 60)} minutos`;
      }
    }
  };

  const startTimer = () => {
    if (timerInterval !== null) return;
    if (remainingSec <= 0) remainingSec = totalDurationSec;
    timerInterval = window.setInterval(() => {
      remainingSec = Math.max(0, remainingSec - 1);
      updateTimerUI();
      if (remainingSec === 0 && timerInterval !== null) {
        window.clearInterval(timerInterval);
        timerInterval = null;
        updateTimerUI();
      }
    }, 1000);
    updateTimerUI();
  };

  const toggleTimer = () => {
    if (timerInterval !== null) {
      window.clearInterval(timerInterval);
      timerInterval = null;
      updateTimerUI();
    } else {
      startTimer();
    }
  };

  const resetTimer = () => {
    if (timerInterval !== null) {
      window.clearInterval(timerInterval);
      timerInterval = null;
    }
    remainingSec = totalDurationSec;
    updateTimerUI();
  };

  timerToggles.forEach((btn) => btn.addEventListener('click', toggleTimer));
  timerResets.forEach((btn) => btn.addEventListener('click', resetTimer));

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mins = Number(btn.dataset.timerPreset || 90);
      totalDurationSec = mins * 60;
      presetBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
      resetTimer();
    });
  });

  // 3. Estado y Renderizado del Archivo de Selectividad
  if (dataStore) {
    const { clientExams, MODALITIES } = dataStore;

    let activeModality: ModalityId = 'ciencias';
    let activeRegion: RegionId = 'catalunya';
    let activeYear = 'all';
    let activeSession = 'all';
    let searchQuery = '';

    let selectedExam: ClientExam | null = null;
    let viewerMode: 'statement' | 'solution' | 'split' = 'statement';

    const archiveEl = document.querySelector<HTMLElement>('[data-years-archive]');
    const regionSoonEl = document.querySelector<HTMLElement>('[data-region-soon]');
    const soonTitleEl = document.querySelector<HTMLElement>('[data-soon-title]');
    const viewerEl = document.querySelector<HTMLElement>('[data-study-viewer]');
    const viewerBadgeEl = document.querySelector<HTMLElement>('[data-viewer-badge]');
    const viewerTitleEl = document.querySelector<HTMLElement>('[data-viewer-title]');
    const viewerStageEl = document.querySelector<HTMLElement>('[data-viewer-stage]');

    // Construye el panel del PDF (o la ficha técnica R2 cuando el archivo aún no se ha subido al bucket)
    const renderDocumentPane = (exam: ClientExam, docType: 'statement' | 'solution'): string => {
      const isStatement = docType === 'statement';
      const label = isStatement ? 'ENUNCIADO OFICIAL' : 'PAUTA DE CORRECCIÓN Y SOLUCIÓN';
      const r2Path = isStatement ? exam.statementPath : exam.solutionPath;
      const fullUrl = isStatement ? exam.statementUrl : exam.solutionUrl;

      if (exam.available) {
        return `
          <div class="doc-pane">
            <div class="doc-pane-head">
              <span>${label}</span>
              <div class="doc-pane-links">
                <a href="${fullUrl}" target="_blank" rel="noopener noreferrer">Abrir en pestaña ↗</a>
                <a href="${fullUrl}" download class="dl-btn">↓ Descargar PDF</a>
              </div>
            </div>
            <iframe class="pdf-iframe" src="${fullUrl}" title="${label} - ${exam.title} (${exam.year})"></iframe>
          </div>
        `;
      }

      // Ficha técnica limpia mientras aún no se han subido los archivos al bucket de Cloudflare R2
      return `
        <div class="doc-pane is-placeholder">
          <div class="doc-pane-head">
            <span>${label}</span>
            <span class="r2-status-pill">PENDIENTE DE SUBIR A CLOUDFLARE R2</span>
          </div>
          <div class="r2-blueprint">
            <div class="r2-icon">${isStatement ? '📄' : '✅'}</div>
            <h4>${exam.year} · ${exam.title} — ${isStatement ? 'Enunciado' : 'Corrección'}</h4>
            <p>
              Este espacio cargará automáticamente el visor PDF en cuanto subas el archivo a tu
              bucket de <strong>Cloudflare R2</strong> con la siguiente clave:
            </p>
            <div class="r2-path-box">
              <code>${r2Path}</code>
              <button type="button" class="copy-r2-btn" data-copy-path="${r2Path}">COPIAR RUTA</button>
            </div>
            <p class="r2-hint">
              Configura tu dominio público R2 en <code>src/data/selectividad.ts</code> (constante <code>R2_BASE_URL</code>) y cambia <code>available: true</code>.
            </p>
          </div>
        </div>
      `;
    };

    const renderViewer = () => {
      if (!viewerEl || !viewerStageEl || !viewerBadgeEl || !viewerTitleEl) return;
      if (!selectedExam) {
        viewerEl.hidden = true;
        return;
      }

      viewerEl.hidden = false;
      const modInfo = MODALITIES[selectedExam.modality];
      viewerBadgeEl.textContent = `${modInfo.code} · PAU ${selectedExam.year}`;
      viewerTitleEl.textContent = `${selectedExam.title} — ${modInfo.name}`;

      document.querySelectorAll<HTMLButtonElement>('[data-viewer-mode]').forEach((btn) => {
        btn.classList.toggle('is-active', btn.dataset.viewerMode === viewerMode);
      });

      if (viewerMode === 'statement') {
        viewerStageEl.className = 'viewer-stage is-single';
        viewerStageEl.innerHTML = renderDocumentPane(selectedExam, 'statement');
      } else if (viewerMode === 'solution') {
        viewerStageEl.className = 'viewer-stage is-single';
        viewerStageEl.innerHTML = renderDocumentPane(selectedExam, 'solution');
      } else {
        viewerStageEl.className = 'viewer-stage is-split';
        viewerStageEl.innerHTML =
          renderDocumentPane(selectedExam, 'statement') +
          renderDocumentPane(selectedExam, 'solution');
      }

      // Botón para copiar la ruta R2 fácilmente
      viewerStageEl.querySelectorAll<HTMLButtonElement>('[data-copy-path]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const path = btn.dataset.copyPath || '';
          try {
            await navigator.clipboard.writeText(path);
            const prev = btn.textContent;
            btn.textContent = '¡COPIADA!';
            window.setTimeout(() => {
              btn.textContent = prev;
            }, 1300);
          } catch {}
        });
      });
    };

    const renderArchive = () => {
      if (!archiveEl || !regionSoonEl) return;

      // Si se selecciona una comunidad marcada para el futuro
      if (activeRegion !== 'catalunya') {
        archiveEl.hidden = true;
        regionSoonEl.hidden = false;
        if (soonTitleEl) {
          soonTitleEl.textContent = `Exámenes de ${activeRegion.toUpperCase()} — Próximamente`;
        }
        return;
      }

      archiveEl.hidden = false;
      regionSoonEl.hidden = true;

      const q = searchQuery.trim().toLowerCase();
      const filtered = clientExams.filter((exam) => {
        if (exam.region !== activeRegion) return false;
        if (exam.modality !== activeModality) return false;
        if (activeYear !== 'all' && String(exam.year) !== activeYear) return false;
        if (activeSession !== 'all' && exam.sessionKind !== activeSession) return false;
        if (q) {
          const haystack = `${exam.year} ${exam.title} ${exam.subtitle}`.toLowerCase();
          if (!haystack.includes(q)) return false;
        }
        return true;
      });

      if (filtered.length === 0) {
        archiveEl.innerHTML = `
          <div class="empty-archive">
            <p>No se han encontrado convocatorias con esos filtros.</p>
            <button type="button" data-reset-filters>Restablecer filtros</button>
          </div>
        `;
        archiveEl
          .querySelector('[data-reset-filters]')
          ?.addEventListener('click', () => {
            activeYear = 'all';
            activeSession = 'all';
            searchQuery = '';
            const searchInp = document.querySelector<HTMLInputElement>('[data-exam-search]');
            const sessSel = document.querySelector<HTMLSelectElement>('[data-session-select]');
            if (searchInp) searchInp.value = '';
            if (sessSel) sessSel.value = 'all';
            document.querySelectorAll('[data-year-btn]').forEach((b) =>
              b.classList.toggle('is-active', (b as HTMLElement).dataset.yearBtn === 'all'),
            );
            renderArchive();
          });
        return;
      }

      // Agrupar por año descendente
      const groupedYears = [...new Set(filtered.map((e) => e.year))].sort((a, b) => b - a);
      const modInfo = MODALITIES[activeModality];

      archiveEl.innerHTML = groupedYears
        .map((year) => {
          const examsOfYear = filtered.filter((e) => e.year === year);
          const cardsHtml = examsOfYear
            .map((exam) => {
              const isSelected = selectedExam?.id === exam.id;
              const badgeLabel =
                exam.sessionKind === 'ordinaria'
                  ? 'ORDINARIA · SÈRIE 1'
                  : exam.sessionKind === 'incidencias'
                    ? 'ORDINARIA · SÈRIE 2'
                    : 'EXTRAORDINARIA · SETEMBRE';

              return `
                <article class="exam-card ${isSelected ? 'is-selected' : ''}" data-exam-card="${exam.id}">
                  <div class="exam-card-top">
                    <span class="exam-session-tag ${exam.sessionKind}">${badgeLabel}</span>
                    <span class="exam-mod-code">${modInfo.code}</span>
                  </div>

                  <h3 class="exam-card-title">${exam.title}</h3>
                  <p class="exam-card-sub">${exam.subtitle}</p>

                  <div class="exam-card-actions">
                    <button
                      type="button"
                      class="exam-btn primary"
                      data-open-viewer="${exam.id}"
                      data-open-mode="statement"
                    >
                      <span>📄 Enunciado</span>
                    </button>
                    <button
                      type="button"
                      class="exam-btn solution"
                      data-open-viewer="${exam.id}"
                      data-open-mode="solution"
                    >
                      <span>✅ Corrección</span>
                    </button>
                  </div>

                  <button
                    type="button"
                    class="exam-split-trigger"
                    data-open-viewer="${exam.id}"
                    data-open-mode="split"
                  >
                    <span>◫ Comparar Enunciado y Corrección lado a lado →</span>
                  </button>
                </article>
              `;
            })
            .join('');

          return `
            <div class="year-block">
              <div class="year-sidebar">
                <span class="year-kicker">CONVOCATORIA PAU</span>
                <h2 class="year-number">${year}</h2>
                <span class="year-count">${examsOfYear.length} exámenes · ${modInfo.code}</span>
              </div>
              <div class="year-cards-grid">
                ${cardsHtml}
              </div>
            </div>
          `;
        })
        .join('');

      // Eventos de apertura del visor en cada tarjeta
      archiveEl.querySelectorAll<HTMLButtonElement>('[data-open-viewer]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.openViewer;
          const mode = (btn.dataset.openMode as 'statement' | 'solution' | 'split') || 'statement';
          const found = clientExams.find((e) => e.id === id);
          if (!found) return;
          selectedExam = found;
          viewerMode = mode;
          renderViewer();
          renderArchive();
          viewerEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      });
    };

    // Eventos de cambio de Modalidad (Científicas vs CC.SS.)
    document.querySelectorAll<HTMLButtonElement>('[data-modality-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeModality = (btn.dataset.modalityBtn as ModalityId) || 'ciencias';
        document.querySelectorAll<HTMLButtonElement>('[data-modality-btn]').forEach((b) => {
          const isAct = b === btn;
          b.classList.toggle('is-active', isAct);
          b.setAttribute('aria-selected', String(isAct));
          const st = b.querySelector('.mod-status');
          if (st) st.textContent = isAct ? 'ACTIVA' : 'SELECCIONAR';
        });
        if (selectedExam) {
          // Actualizar el examen abierto en el visor a su homólogo en la otra modalidad
          const counterpart = clientExams.find(
            (e) =>
              e.modality === activeModality &&
              e.year === selectedExam?.year &&
              e.sessionKind === selectedExam?.sessionKind,
          );
          selectedExam = counterpart || null;
          renderViewer();
        }
        renderArchive();
      });
    });

    // Eventos de Comunidad Autónoma
    document.querySelectorAll<HTMLButtonElement>('[data-region-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeRegion = (btn.dataset.regionBtn as RegionId) || 'catalunya';
        document.querySelectorAll('[data-region-btn]').forEach((b) =>
          b.classList.toggle('is-active', b === btn),
        );
        renderArchive();
      });
    });

    document.querySelector('[data-back-catalunya]')?.addEventListener('click', () => {
      activeRegion = 'catalunya';
      document.querySelectorAll<HTMLElement>('[data-region-btn]').forEach((b) =>
        b.classList.toggle('is-active', b.dataset.regionBtn === 'catalunya'),
      );
      renderArchive();
    });

    // Eventos de Año, Serie y Búsqueda
    document.querySelectorAll<HTMLButtonElement>('[data-year-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeYear = btn.dataset.yearBtn || 'all';
        document.querySelectorAll('[data-year-btn]').forEach((b) =>
          b.classList.toggle('is-active', b === btn),
        );
        renderArchive();
      });
    });

    const sessionSelect = document.querySelector<HTMLSelectElement>('[data-session-select]');
    sessionSelect?.addEventListener('change', () => {
      activeSession = sessionSelect.value;
      renderArchive();
    });

    const searchInput = document.querySelector<HTMLInputElement>('[data-exam-search]');
    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value;
      renderArchive();
    });

    // Eventos del Visor Integrado
    document.querySelectorAll<HTMLButtonElement>('[data-viewer-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        viewerMode =
          (btn.dataset.viewerMode as 'statement' | 'solution' | 'split') || 'statement';
        renderViewer();
      });
    });

    document.querySelector('[data-viewer-close]')?.addEventListener('click', () => {
      selectedExam = null;
      renderViewer();
      renderArchive();
    });

    // Botón "Examen al azar + Cronómetro" desde la estación de simulacro
    document.querySelector('[data-random-exam]')?.addEventListener('click', () => {
      const pool = clientExams.filter(
        (e) => e.region === 'catalunya' && e.modality === activeModality,
      );
      if (!pool.length) return;
      const chosen = pool[Math.floor(Math.random() * pool.length)];
      selectedExam = chosen;
      viewerMode = 'statement';
      renderViewer();
      renderArchive();
      resetTimer();
      startTimer();
      viewerEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    // Soporte para parámetros de URL desde el buscador global ⌘K (?modality=ccss&year=2024)
    const urlParams = new URLSearchParams(window.location.search);
    const paramMod = urlParams.get('modality');
    const paramYear = urlParams.get('year');
    if (paramMod === 'ciencias' || paramMod === 'ccss') {
      activeModality = paramMod;
      document.querySelectorAll<HTMLButtonElement>('[data-modality-btn]').forEach((b) => {
        const isAct = b.dataset.modalityBtn === activeModality;
        b.classList.toggle('is-active', isAct);
        b.setAttribute('aria-selected', String(isAct));
        const st = b.querySelector('.mod-status');
        if (st) st.textContent = isAct ? 'ACTIVA' : 'SELECCIONAR';
      });
    }
    if (paramYear) {
      activeYear = paramYear;
      document.querySelectorAll<HTMLElement>('[data-year-btn]').forEach((b) => {
        b.classList.toggle('is-active', b.dataset.yearBtn === activeYear);
      });
    }

    renderArchive();
  }

  // =========================================================================
  // 4. CALCULADORA CIENTÍFICA FLOTANTE ARRASTRABLE Y PICTURE-IN-PICTURE
  // =========================================================================
  const floatingDrawer = document.querySelector<HTMLElement>('[data-floating-calc]');
  const dragHandle = document.querySelector<HTMLElement>('[data-floating-drag-handle]');

  document.querySelectorAll<HTMLElement>('[data-toggle-floating-calc]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!floatingDrawer) return;
      floatingDrawer.hidden = !floatingDrawer.hidden;
    });
  });

  document.querySelector('[data-close-floating-calc]')?.addEventListener('click', () => {
    if (floatingDrawer) floatingDrawer.hidden = true;
  });

  document.querySelectorAll<HTMLElement>('[data-trigger-pip-direct]').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('request-calc-pip'));
    });
  });

  // Si se abre la ventana PiP del sistema operativo, ocultamos el marco flotante interno
  window.addEventListener('calc-pip-opened', () => {
    if (floatingDrawer) floatingDrawer.hidden = true;
  });

  // Permitir arrastrar la calculadora flotante por toda la pantalla
  if (floatingDrawer && dragHandle) {
    let isDraggingCalc = false;
    let offsetX = 0;
    let offsetY = 0;

    dragHandle.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      isDraggingCalc = true;
      const rect = floatingDrawer.getBoundingClientRect();
      offsetX = e.clientX - rect.left;
      offsetY = e.clientY - rect.top;
      floatingDrawer.style.right = 'auto';
      floatingDrawer.style.bottom = 'auto';
      floatingDrawer.style.left = `${rect.left}px`;
      floatingDrawer.style.top = `${rect.top}px`;
      dragHandle.setPointerCapture(e.pointerId);
    });

    dragHandle.addEventListener('pointermove', (e) => {
      if (!isDraggingCalc) return;
      const maxX = window.innerWidth - 120;
      const maxY = window.innerHeight - 80;
      const nextLeft = Math.max(8, Math.min(maxX, e.clientX - offsetX));
      const nextTop = Math.max(8, Math.min(maxY, e.clientY - offsetY));
      floatingDrawer.style.left = `${nextLeft}px`;
      floatingDrawer.style.top = `${nextTop}px`;
    });

    const stopCalcDrag = () => {
      isDraggingCalc = false;
    };
    dragHandle.addEventListener('pointerup', stopCalcDrag);
    dragHandle.addEventListener('pointercancel', stopCalcDrag);
  }
</script>

