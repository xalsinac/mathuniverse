---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ScientificCalculator from '../components/ScientificCalculator.astro';
import { site } from '../config/site';
import {
  GYM_LEVELS,
  GYM_BRANCHES,
  gymWorksheets,
  resolveGymPdfUrl,
} from '../data/gym';

// Serializamos el catálogo con las URLs resueltas hacia Cloudflare R2 para el cliente
const clientWorksheets = gymWorksheets.map((sheet) => ({
  ...sheet,
  pdfUrl: resolveGymPdfUrl(sheet.pdfPath),
}));

const levelCounts = gymWorksheets.reduce((acc, w) => {
  acc[w.level] = (acc[w.level] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const branchCounts = gymWorksheets.reduce((acc, w) => {
  acc[w.branch] = (acc[w.branch] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
---

<BaseLayout
  title={`Math Gym — ${site.name}`}
  description="Banco de ejercicios y hojas de problemas de matemáticas para ESO y Bachillerato organizados por nivel y rama matemática, con visor integrado, calculadora flotante y series en vivo."
>
  <!-- Barra superior técnica unificada + Acceso a Calculadora / PiP -->
  <SiteHeader activePage="gym" statusText="04 · Math Gym" ctaHref="/#recursos" ctaLabel="Todas las Apps">
    <div slot="right-extra" class="topbar-cell gym-top-actions">
      <button
        type="button"
        class="gym-top-btn"
        data-toggle-floating-calc
        title="Abrir calculadora científica flotante o en Picture-in-Picture"
      >
        <span>🧮 Calculadora</span>
      </button>
      <a
        href="#entrenamiento-en-vivo"
        class="gym-top-btn is-accent"
        title="Ir al generador de series rápidas en vivo"
      >
        <span>⚡ Series en vivo</span>
      </a>
    </div>
  </SiteHeader>

  <main>
    <section class="gym-band section-band is-drawn">
      <span class="section-rule" aria-hidden="true"></span>
      <div class="section-frame">
        <span class="tick tick-half tick-left" aria-hidden="true"></span>
        <span class="tick tick-half tick-right" aria-hidden="true"></span>

        <div class="section-eyebrow">
          <span>
            <span class="eyebrow-num">04</span>
            <span class="eyebrow-sep" aria-hidden="true">/</span>
            Math Gym · Banco de ejercicios
          </span>
          <span class="eyebrow-right">Hojas de problemas · Visor R2 · Entrenamiento en vivo</span>
        </div>

        <!-- Cabecera + Estación de Entrenamiento Rápido en Vivo -->
        <div class="gym-hero section-body">
          <div class="gym-top-split">
            <div class="gym-intro">
              <p class="kicker">Entrenamiento con propósito</p>
              <h1>Ejercicios y problemas <em>por nivel y tema.</em></h1>
              <p class="gym-lead">
                Selecciona tu curso y bloque temático para consultar o descargar cada hoja de problemas
                en PDF. También puedes activar el generador de series rápidas con soluciones paso a paso
                y utilizar la calculadora científica flotante en cualquier momento.
              </p>
              <div class="gym-hero-pills">
                <span class="stat-pill"><strong>{gymWorksheets.length}</strong> Hojas catalogadas</span>
                <span class="stat-pill"><strong>6</strong> Cursos (ESO y Bachillerato)</span>
                <span class="stat-pill"><strong>5</strong> Ramas matemáticas</span>
              </div>
            </div>

            <!-- Estación Interactiva: Generador de Series Rápidas en Vivo -->
            <aside
              id="entrenamiento-en-vivo"
              class="gym-workout-station"
              aria-label="Generador de series rápidas de ejercicios matemáticos"
            >
              <div class="station-head">
                <div class="station-title-group">
                  <span class="live-dot" aria-hidden="true"></span>
                  <span class="station-eyebrow">SERIES RÁPIDAS EN VIVO</span>
                </div>
                <div class="station-actions-top">
                  <button
                    type="button"
                    class="station-refresh-btn"
                    data-generate-workout
                    title="Generar nueva serie con números aleatorios"
                  >
                    ↺ Nueva serie
                  </button>
                  <button
                    type="button"
                    class="station-print-btn"
                    data-print-workout
                    title="Imprimir esta serie de ejercicios"
                  >
                    🖨️ Imprimir
                  </button>
                </div>
              </div>

              <!-- Selector de tema para la serie en vivo -->
              <div class="workout-preset-bar">
                <span class="preset-label">TEMA:</span>
                <div class="preset-pills" role="group" aria-label="Elegir tema de entrenamiento rápido">
                  <button type="button" class="preset-pill is-active" data-workout-topic="fracciones">Fracciones</button>
                  <button type="button" class="preset-pill" data-workout-topic="ecuaciones1">Ecuaciones 1.º</button>
                  <button type="button" class="preset-pill" data-workout-topic="ecuaciones2">Ecuaciones 2.º</button>
                  <button type="button" class="preset-pill" data-workout-topic="sistemas">Sistemas 2×2</button>
                  <button type="button" class="preset-pill" data-workout-topic="potencias">Potencias</button>
                </div>
              </div>

              <!-- Lista de ejercicios generados en vivo con solución desplegable -->
              <div class="workout-list" data-workout-list aria-live="polite"></div>

              <div class="station-foot">
                <span class="station-hint">
                  Resuélvelos en papel y pulsa <strong>Ver solución</strong> para comprobar tu resultado.
                </span>
                <button
                  type="button"
                  class="station-calc-trigger"
                  data-toggle-floating-calc
                >
                  🧮 Abrir Calculadora
                </button>
              </div>
            </aside>
          </div>

          <!-- Selector de Curso / Nivel (1.º ESO a 2.º Bachillerato) -->
          <div class="level-selector-bar">
            <span class="bar-tag">FILTRAR POR CURSO:</span>
            <div class="level-pills" role="tablist" aria-label="Filtrar por nivel o curso">
              <button
                type="button"
                role="tab"
                aria-selected="true"
                class="level-pill is-active"
                data-level-btn="all"
              >
                <span>Todos los cursos ({gymWorksheets.length})</span>
              </button>
              {
                GYM_LEVELS.map((lvl) => (
                  <button
                    type="button"
                    role="tab"
                    aria-selected="false"
                    class="level-pill"
                    data-level-btn={lvl.id}
                  >
                    <span>{lvl.short} ({levelCounts[lvl.id] || 0})</span>
                    <small>{lvl.stage}</small>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Barra de Filtros: Ramas Matemáticas y Buscador en Vivo -->
        <div class="gym-filters-bar">
          <div class="branch-selector">
            <span class="filter-label">RAMA MATEMÁTICA:</span>
            <div class="branch-pills" role="tablist" aria-label="Filtrar por rama matemática">
              <button
                type="button"
                class="branch-pill is-active"
                data-branch-btn="all"
              >
                <span class="branch-sym">✱</span>
                <span>Todas las ramas ({gymWorksheets.length})</span>
              </button>
              {
                GYM_BRANCHES.map((br) => (
                  <button
                    type="button"
                    class="branch-pill"
                    data-branch-btn={br.id}
                    style={`--branch-col:${br.color}`}
                  >
                    <span class="branch-sym">{br.symbol}</span>
                    <span>{br.name} ({branchCounts[br.id] || 0})</span>
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Buscador y contador de hojas -->
          <div class="gym-search-row">
            <div class="search-input-wrap">
              <svg
                class="search-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              <input
                type="search"
                class="gym-search-input"
                data-gym-search
                placeholder="Buscar tema o palabra clave (ej. Ruffini, fracciones, Pitágoras, derivadas, límites)..."
                aria-label="Buscar hojas de ejercicios"
              />
            </div>
            <div class="gym-count-badge" data-gym-count>
              Mostrando {gymWorksheets.length} hojas
            </div>
          </div>
        </div>

        <!-- =============================================================== -->
        <!-- VISOR INTEGRADO DE ESTUDIO (HOJA PDF / FICHA TÉCNICA CLOUDFLARE) -->
        <!-- =============================================================== -->
        <div class="study-viewer" data-study-viewer hidden>
          <div class="viewer-toolbar">
            <div class="viewer-info">
              <span class="viewer-badge" data-viewer-badge>3.º ESO · ÁLGEBRA</span>
              <h3 class="viewer-title" data-viewer-title>Ecuaciones y Sistemas</h3>
            </div>

            <div class="viewer-actions">
              <a
                href="#"
                download
                class="viewer-dl-external"
                data-gym-viewer-dl
                title="Descargar esta hoja de ejercicios en PDF"
              >
                📥 Descargar PDF
              </a>
              <button
                type="button"
                class="viewer-aux-link"
                data-toggle-floating-calc
                title="Mostrar u ocultar calculadora científica flotante"
              >
                🧮 Calculadora Flotante
              </button>
              <button
                type="button"
                class="viewer-aux-link is-pip"
                data-trigger-pip-direct
                title="Sacar calculadora en ventana Picture-in-Picture siempre visible"
              >
                ⧉ PiP EXTERNO
              </button>
              <button type="button" class="viewer-close-btn" data-viewer-close>
                CERRAR VISOR ✕
              </button>
            </div>
          </div>

          <div class="viewer-stage" data-viewer-stage></div>
        </div>

        <!-- =============================================================== -->
        <!-- LISTADO DE HOJAS DE EJERCICIOS (CARDS GRID)                     -->
        <!-- =============================================================== -->
        <div class="gym-archive section-body" data-gym-archive></div>
      </div>
    </section>
  </main>

  <!-- Ventana flotante arrastrable de Calculadora Científica para resolver ejercicios sin salir del PDF -->
  <aside
    class="floating-calc-drawer"
    data-floating-calc
    hidden
    aria-label="Calculadora científica flotante"
  >
    <div class="floating-calc-bar" data-floating-drag-handle>
      <div class="floating-calc-title">
        <span class="drag-grip" aria-hidden="true">⠿</span>
        <span>CALCULADORA DE ENTRENAMIENTO · ARRASTRAR</span>
      </div>
      <div class="floating-calc-actions">
        <button
          type="button"
          class="floating-bar-btn is-pip"
          data-trigger-pip-direct
          title="Sacar fuera del navegador en modo Picture-in-Picture (siempre encima)"
        >
          ⧉ PiP EXTERNO
        </button>
        <button
          type="button"
          class="floating-bar-btn"
          data-close-floating-calc
          title="Cerrar calculadora flotante"
        >
          ✕
        </button>
      </div>
    </div>
    <div class="floating-calc-body">
      <ScientificCalculator compact={true} />
    </div>
  </aside>

  <!-- Pie de página enmarcado -->
  <footer class="footer-section section-band is-drawn">
    <span class="section-rule" aria-hidden="true"></span>
    <div class="section-frame">
      <span class="tick tick-half tick-left" aria-hidden="true"></span>
      <span class="tick tick-half tick-right" aria-hidden="true"></span>

      <div class="footer-body section-body">
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Math Universe · Xavier Alsina</span>
          <a href="/">← Volver a la galaxia principal</a>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>

<script define:vars={{ clientWorksheets, GYM_LEVELS, GYM_BRANCHES }}>
  window.__GYM_DATA__ = { clientWorksheets, GYM_LEVELS, GYM_BRANCHES };
</script>

<script>
  import type { GymWorksheet, GymLevelId, GymBranchId } from '../data/gym';
  import { renderNaturalExpression } from '../lib/mathEngine';

  type ClientWorksheet = GymWorksheet & {
    pdfUrl: string;
  };

  const gymStore = (window as unknown as {
    __GYM_DATA__: {
      clientWorksheets: ClientWorksheet[];
      GYM_LEVELS: Array<{ id: GymLevelId; short: string; name: string; stage: string }>;
      GYM_BRANCHES: Array<{ id: GymBranchId; code: string; name: string; symbol: string; color: string; subtopics: string[] }>;
    };
  }).__GYM_DATA__;

  // ===========================================================================
  // 1. GENERADOR DE SERIES RÁPIDAS EN VIVO (WORKOUT STATION)
  // ===========================================================================
  interface ExerciseItem {
    id: number;
    statement: string;
    solution: string;
    steps?: string;
  }

  const gcd = (a: number, b: number): number => (b === 0 ? a : gcd(b, a % b));
  const lcm = (a: number, b: number): number => Math.abs(a * b) / gcd(a, b);
  const randInt = (min: number, max: number): number =>
    Math.floor(Math.random() * (max - min + 1)) + min;

  const generateWorkoutSeries = (topic: string): ExerciseItem[] => {
    const list: ExerciseItem[] = [];

    if (topic === 'fracciones') {
      for (let i = 1; i <= 4; i++) {
        const d1 = [2, 3, 4, 5, 6][randInt(0, 4)];
        let d2 = [2, 3, 4, 5, 6][randInt(0, 4)];
        while (d2 === d1) d2 = [2, 3, 4, 5, 6][randInt(0, 4)];
        const n1 = randInt(1, d1 * 2);
        const n2 = randInt(1, d2 * 2);
        const op = Math.random() > 0.5 ? '+' : '−';
        const denComun = lcm(d1, d2);
        const numFinal = op === '+'
          ? n1 * (denComun / d1) + n2 * (denComun / d2)
          : n1 * (denComun / d1) - n2 * (denComun / d2);
        const g = gcd(Math.abs(numFinal), denComun);
        const simNum = numFinal / g;
        const simDen = denComun / g;

        const solVal = simDen === 1 ? `${simNum}` : `\\frac{${simNum}}{${simDen}}`;
        list.push({
          id: i,
          statement: `\\frac{${n1}}{${d1}} ${op} \\frac{${n2}}{${d2}}`,
          solution: `Resultado: ${solVal}`,
          steps: `m.c.m.(${d1}, ${d2}) = ${denComun} ➔ \\frac{${n1 * (denComun / d1)}}{${denComun}} ${op} \\frac{${n2 * (denComun / d2)}}{${denComun}} = \\frac{${numFinal}}{${denComun}} = ${solVal}`,
        });
      }
    } else if (topic === 'ecuaciones1') {
      for (let i = 1; i <= 4; i++) {
        const x = randInt(-8, 9);
        const a = randInt(2, 6);
        const b = randInt(-10, 10);
        const rhs = a * x + b;
        list.push({
          id: i,
          statement: `${a}x ${b >= 0 ? `+ ${b}` : `− ${Math.abs(b)}`} = ${rhs}`,
          solution: `x = ${x}`,
          steps: `${a}x = ${rhs} ${b >= 0 ? `− ${b}` : `+ ${Math.abs(b)}`} ➔ ${a}x = ${rhs - b} ➔ x = ${x}`,
        });
      }
    } else if (topic === 'ecuaciones2') {
      for (let i = 1; i <= 4; i++) {
        const x1 = randInt(-5, 6);
        let x2 = randInt(-5, 6);
        while (x2 === x1) x2 = randInt(-5, 6);
        const b = -(x1 + x2);
        const c = x1 * x2;
        const bStr = b === 0 ? '' : b === 1 ? '+ x' : b === -1 ? '− x' : b > 0 ? `+ ${b}x` : `− ${Math.abs(b)}x`;
        const cStr = c === 0 ? '' : c > 0 ? `+ ${c}` : `− ${Math.abs(c)}`;
        const discVal = b * b - 4 * c;

        list.push({
          id: i,
          statement: `x^{2} ${bStr} ${cStr} = 0`,
          solution: `x₁ = ${x1} , x₂ = ${x2}`,
          steps: `Δ = (${b})² − 4·1·(${c}) = ${discVal} ➔ x = \\frac{${-b} ± \\sqrt{${discVal}}}{2} ➔ x₁ = ${x1}, x₂ = ${x2}`,
        });
      }
    } else if (topic === 'sistemas') {
      for (let i = 1; i <= 4; i++) {
        const x = randInt(-4, 5);
        const y = randInt(-4, 5);
        const c1 = x + y;
        const c2 = 2 * x - y;
        list.push({
          id: i,
          statement: `\\begin{cases} x + y = ${c1} \\\\ 2x − y = ${c2} \\end{cases}`,
          solution: `x = ${x} , y = ${y}`,
          steps: `Por reducción: sumando ambas ecuaciones: 3x = ${c1 + c2} ➔ x = ${x}; sustituyendo: y = ${c1} − (${x}) = ${y}`,
        });
      }
    } else {
      // Potencias
      for (let i = 1; i <= 4; i++) {
        const base = [2, 3, 5, 10][randInt(0, 3)];
        const p1 = randInt(2, 5);
        const p2 = randInt(2, 4);
        const isMul = Math.random() > 0.4;
        if (isMul) {
          list.push({
            id: i,
            statement: `${base}^{${p1}} \\cdot ${base}^{${p2}}`,
            solution: `${base}^{${p1 + p2}} = ${Math.pow(base, p1 + p2).toLocaleString('es-ES')}`,
            steps: `Misma base: se suman los exponentes (${p1} + ${p2} = ${p1 + p2})`,
          });
        } else {
          const maxP = Math.max(p1, p2);
          const minP = Math.min(p1, p2);
          list.push({
            id: i,
            statement: `\\frac{${base}^{${maxP}}}{${base}^{${minP}}}`,
            solution: `${base}^{${maxP - minP}} = ${Math.pow(base, maxP - minP).toLocaleString('es-ES')}`,
            steps: `Misma base en división: se restan los exponentes (${maxP} − ${minP} = ${maxP - minP})`,
          });
        }
      }
    }

    return list;
  };

  const formatMathHtml = (raw: string): string => {
    if (!raw) return '';

    // Manejo de sistemas de ecuaciones con llave
    if (raw.includes('\\begin{cases}')) {
      const match = raw.match(/\\begin\{cases\}\s*(.*?)\s*\\\\\s*(.*?)\s*\\end\{cases\}/);
      if (match) {
        const line1 = formatMathHtml(match[1]);
        const line2 = formatMathHtml(match[2]);
        return `<div class="math-system"><span class="math-brace">{</span><div class="math-system-lines"><div>${line1}</div><div>${line2}</div></div></div>`;
      }
    }

    let s = raw;
    s = s.replace(/\\cdot/g, ' · ');
    s = s.replace(/➔/g, ' &nbsp;➔&nbsp; ');
    s = renderNaturalExpression(s);
    return s;
  };

  const workoutListEl = document.querySelector<HTMLElement>('[data-workout-list]');
  const refreshWorkoutBtn = document.querySelector<HTMLButtonElement>('[data-generate-workout]');
  const printWorkoutBtn = document.querySelector<HTMLButtonElement>('[data-print-workout]');
  const presetPills = document.querySelectorAll<HTMLButtonElement>('[data-workout-topic]');
  let activeTopic = 'fracciones';

  const renderWorkout = () => {
    if (!workoutListEl) return;
    const items = generateWorkoutSeries(activeTopic);

    workoutListEl.innerHTML = items
      .map(
        (it) => `
        <div class="workout-item" data-workout-item="${it.id}">
          <div class="item-head">
            <span class="item-num">#0${it.id}</span>
            <div class="item-stmt math-expr">${formatMathHtml(it.statement)}</div>
          </div>
          <button type="button" class="reveal-btn" data-toggle-sol>
            <span>Ver solución ▾</span>
          </button>
          <div class="item-sol" hidden>
            <div class="sol-val math-expr">${formatMathHtml(it.solution)}</div>
            ${it.steps ? `<div class="sol-steps math-expr">${formatMathHtml(it.steps)}</div>` : ''}
          </div>
        </div>
      `,
      )
      .join('');

    workoutListEl.querySelectorAll<HTMLButtonElement>('[data-toggle-sol]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const parent = btn.closest('.workout-item');
        const solEl = parent?.querySelector<HTMLElement>('.item-sol');
        if (!solEl) return;
        const isHidden = solEl.hidden;
        solEl.hidden = !isHidden;
        btn.classList.toggle('is-revealed', !isHidden);
        btn.innerHTML = !isHidden ? '<span>Ocultar solución ▴</span>' : '<span>Ver solución ▾</span>';
      });
    });
  };

  presetPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeTopic = pill.dataset.workoutTopic || 'fracciones';
      presetPills.forEach((p) => p.classList.toggle('is-active', p === pill));
      renderWorkout();
    });
  });

  refreshWorkoutBtn?.addEventListener('click', renderWorkout);
  printWorkoutBtn?.addEventListener('click', () => window.print());
  renderWorkout();

  // ===========================================================================
  // 2. CATÁLOGO, FILTRADO Y VISOR DE HOJAS DE EJERCICIOS (R2 INTEGRATION)
  // ===========================================================================
  if (gymStore) {
    const { clientWorksheets, GYM_LEVELS, GYM_BRANCHES } = gymStore;

    let activeLevel: string = 'all';
    let activeBranch: string = 'all';
    let searchQuery: string = '';
    let selectedSheet: ClientWorksheet | null = null;

    const archiveEl = document.querySelector<HTMLElement>('[data-gym-archive]');
    const countBadgeEl = document.querySelector<HTMLElement>('[data-gym-count]');
    const viewerEl = document.querySelector<HTMLElement>('[data-study-viewer]');
    const viewerBadgeEl = document.querySelector<HTMLElement>('[data-viewer-badge]');
    const viewerTitleEl = document.querySelector<HTMLElement>('[data-viewer-title]');
    const viewerStageEl = document.querySelector<HTMLElement>('[data-viewer-stage]');

    // Render del visor PDF (o la ficha blueprint R2 cuando aún no se ha subido)
    const renderViewerPane = (sheet: ClientWorksheet): string => {
      if (sheet.available) {
        return `
          <div class="doc-pane">
            <div class="doc-pane-head">
              <span>HOJA DE PROBLEMAS · ${sheet.title}</span>
              <div class="doc-pane-links">
                <a href="${sheet.pdfUrl}" target="_blank" rel="noopener noreferrer">Abrir en pestaña ↗</a>
                <a href="${sheet.pdfUrl}" download class="dl-btn">↓ Descargar PDF</a>
              </div>
            </div>
            <iframe class="pdf-iframe" src="${sheet.pdfUrl}" title="${sheet.title}"></iframe>
          </div>
        `;
      }

      return `
        <div class="doc-pane is-placeholder">
          <div class="doc-pane-head">
            <span>HOJA DE PROBLEMAS</span>
            <span class="r2-status-pill">PENDIENTE DE SUBIR A CLOUDFLARE R2</span>
          </div>
          <div class="r2-blueprint">
            <div class="r2-icon">📄</div>
            <h4>${sheet.title}</h4>
            <p>
              Este espacio cargará automáticamente el visor PDF de ejercicios en cuanto subas
              el archivo a tu bucket de <strong>Cloudflare R2</strong> con la siguiente ruta:
            </p>
            <div class="r2-path-box">
              <code>${sheet.pdfPath}</code>
              <button type="button" class="copy-r2-btn" data-copy-path="${sheet.pdfPath}">COPIAR RUTA</button>
            </div>
            <p class="r2-hint">
              Configura tu dominio público en <code>src/data/selectividad.ts</code> (constante <code>R2_BASE_URL</code>) y cambia <code>available: true</code> en <code>src/data/gym.ts</code>.
            </p>
          </div>
        </div>
      `;
    };

    const renderViewer = () => {
      if (!viewerEl || !viewerStageEl || !viewerBadgeEl || !viewerTitleEl) return;
      if (!selectedSheet) {
        viewerEl.hidden = true;
        return;
      }

      viewerEl.hidden = false;
      const lvl = GYM_LEVELS.find((l) => l.id === selectedSheet?.level);
      const br = GYM_BRANCHES.find((b) => b.id === selectedSheet?.branch);

      viewerBadgeEl.textContent = `${lvl?.short ?? selectedSheet.level} · ${br?.name ?? selectedSheet.branch}`;
      viewerTitleEl.textContent = selectedSheet.title;
      viewerStageEl.innerHTML = renderViewerPane(selectedSheet);

      const dlBtn = document.querySelector<HTMLAnchorElement>('[data-gym-viewer-dl]');
      if (dlBtn && selectedSheet) {
        dlBtn.href = selectedSheet.pdfUrl;
        dlBtn.setAttribute('download', `${selectedSheet.id}.pdf`);
      }

      viewerStageEl.querySelectorAll<HTMLButtonElement>('[data-copy-path]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const path = btn.dataset.copyPath || '';
          try {
            await navigator.clipboard.writeText(path);
            const prev = btn.textContent;
            btn.textContent = '¡COPIADA!';
            window.setTimeout(() => {
              btn.textContent = prev;
            }, 1300);
          } catch {}
        });
      });
    };

    const renderArchive = () => {
      if (!archiveEl) return;

      const q = searchQuery.trim().toLowerCase();
      const filtered = clientWorksheets.filter((sheet) => {
        if (activeLevel !== 'all' && sheet.level !== activeLevel) return false;
        if (activeBranch !== 'all' && sheet.branch !== activeBranch) return false;
        if (q) {
          const haystack = `${sheet.title} ${sheet.description} ${sheet.topic} ${sheet.level}`.toLowerCase();
          if (!haystack.includes(q)) return false;
        }
        return true;
      });

      if (countBadgeEl) {
        countBadgeEl.textContent = `Mostrando ${filtered.length} de ${clientWorksheets.length} hojas`;
      }

      if (filtered.length === 0) {
        archiveEl.innerHTML = `
          <div class="empty-archive">
            <p>No se han encontrado hojas de ejercicios con esos filtros.</p>
            <button type="button" class="reset-filter-btn" data-reset-filters>Restablecer filtros</button>
          </div>
        `;
        archiveEl.querySelector('[data-reset-filters]')?.addEventListener('click', () => {
          activeLevel = 'all';
          activeBranch = 'all';
          searchQuery = '';
          const searchInp = document.querySelector<HTMLInputElement>('[data-gym-search]');
          if (searchInp) searchInp.value = '';
          document.querySelectorAll<HTMLElement>('[data-level-btn]').forEach((b) =>
            b.classList.toggle('is-active', b.dataset.levelBtn === 'all'),
          );
          document.querySelectorAll<HTMLElement>('[data-branch-btn]').forEach((b) =>
            b.classList.toggle('is-active', b.dataset.branchBtn === 'all'),
          );
          renderArchive();
        });
        return;
      }

      // Agrupar por nivel
      const levelsOrder: GymLevelId[] = ['1eso', '2eso', '3eso', '4eso', '1bach', '2bach'];
      const presentLevels = levelsOrder.filter((lvlId) =>
        filtered.some((s) => s.level === lvlId),
      );

      archiveEl.innerHTML = presentLevels
        .map((lvlId) => {
          const lvlInfo = GYM_LEVELS.find((l) => l.id === lvlId);
          const sheetsOfLevel = filtered.filter((s) => s.level === lvlId);

          const cardsHtml = sheetsOfLevel
            .map((sheet) => {
              const brInfo = GYM_BRANCHES.find((b) => b.id === sheet.branch);
              const isSelected = selectedSheet?.id === sheet.id;

              return `
                <article class="sheet-card ${isSelected ? 'is-selected' : ''}" data-sheet-card="${sheet.id}">
                  <div class="sheet-card-top">
                    <span class="sheet-level-tag">${lvlInfo?.short || sheet.level}</span>
                    <span class="sheet-branch-tag" style="--br-color:${brInfo?.color || 'var(--accent)'}">
                      ${brInfo?.symbol || '✱'} ${brInfo?.name || sheet.branch}
                    </span>
                  </div>

                  <span class="sheet-topic-kicker">${sheet.topic}</span>
                  <h3 class="sheet-card-title">${sheet.title}</h3>
                  <p class="sheet-card-desc">${sheet.description}</p>

                  <div class="sheet-card-foot">
                    <button
                      type="button"
                      class="sheet-open-btn"
                      data-open-sheet="${sheet.id}"
                    >
                      <span>📄 Abrir hoja de problemas →</span>
                    </button>
                    ${sheet.available ? '<span class="status-live-tag">PDF Listo</span>' : '<span class="status-r2-tag">R2 Config</span>'}
                  </div>
                </article>
              `;
            })
            .join('');

          return `
            <div class="level-block">
              <div class="level-sidebar">
                <span class="level-kicker">${lvlInfo?.stage || 'NIVEL ACADÉMICO'}</span>
                <h2 class="level-heading">${lvlInfo?.name || lvlId}</h2>
                <span class="level-count">${sheetsOfLevel.length} hojas de problemas</span>
              </div>
              <div class="level-cards-grid">
                ${cardsHtml}
              </div>
            </div>
          `;
        })
        .join('');

      archiveEl.querySelectorAll<HTMLButtonElement>('[data-open-sheet]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.openSheet;
          const found = clientWorksheets.find((s) => s.id === id);
          if (!found) return;
          selectedSheet = found;
          renderViewer();
          renderArchive();
          viewerEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      });
    };

    // Filtros de Nivel
    document.querySelectorAll<HTMLButtonElement>('[data-level-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeLevel = btn.dataset.levelBtn || 'all';
        document.querySelectorAll('[data-level-btn]').forEach((b) =>
          b.classList.toggle('is-active', b === btn),
        );
        // Si la rama seleccionada previamente no tiene ejercicios en este curso, restablecer rama a 'all'
        if (activeLevel !== 'all' && activeBranch !== 'all') {
          const hasBranchInLevel = clientWorksheets.some(
            (s) => s.level === activeLevel && s.branch === activeBranch,
          );
          if (!hasBranchInLevel) {
            activeBranch = 'all';
            document.querySelectorAll<HTMLElement>('[data-branch-btn]').forEach((b) =>
              b.classList.toggle('is-active', b.dataset.branchBtn === 'all'),
            );
          }
        }
        renderArchive();
      });
    });

    // Filtros de Rama Matemática
    document.querySelectorAll<HTMLButtonElement>('[data-branch-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeBranch = btn.dataset.branchBtn || 'all';
        document.querySelectorAll('[data-branch-btn]').forEach((b) =>
          b.classList.toggle('is-active', b === btn),
        );
        renderArchive();
      });
    });

    // Buscador en vivo
    const searchInp = document.querySelector<HTMLInputElement>('[data-gym-search]');
    searchInp?.addEventListener('input', () => {
      searchQuery = searchInp.value;
      renderArchive();
    });

    // Cerrar visor
    document.querySelector('[data-viewer-close]')?.addEventListener('click', () => {
      selectedSheet = null;
      renderViewer();
      renderArchive();
    });

    // Soporte para URL params (?level=3eso, ?branch=algebra)
    const urlParams = new URLSearchParams(window.location.search);
    const paramLvl = urlParams.get('level');
    const paramBr = urlParams.get('branch');
    if (paramLvl) {
      activeLevel = paramLvl;
      document.querySelectorAll<HTMLElement>('[data-level-btn]').forEach((b) => {
        b.classList.toggle('is-active', b.dataset.levelBtn === activeLevel);
      });
    }
    if (paramBr) {
      activeBranch = paramBr;
      document.querySelectorAll<HTMLElement>('[data-branch-btn]').forEach((b) => {
        b.classList.toggle('is-active', b.dataset.branchBtn === activeBranch);
      });
    }

    renderArchive();
  }

  // ===========================================================================
  // 3. CALCULADORA CIENTÍFICA FLOTANTE ARRASTRABLE Y PICTURE-IN-PICTURE
  // ===========================================================================
  const floatingDrawer = document.querySelector<HTMLElement>('[data-floating-calc]');
  const dragHandle = document.querySelector<HTMLElement>('[data-floating-drag-handle]');

  document.querySelectorAll<HTMLElement>('[data-toggle-floating-calc]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!floatingDrawer) return;
      floatingDrawer.hidden = !floatingDrawer.hidden;
    });
  });

  document.querySelector('[data-close-floating-calc]')?.addEventListener('click', () => {
    if (floatingDrawer) floatingDrawer.hidden = true;
  });

  document.querySelectorAll<HTMLElement>('[data-trigger-pip-direct]').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('request-calc-pip'));
    });
  });

  window.addEventListener('calc-pip-opened', () => {
    if (floatingDrawer) floatingDrawer.hidden = true;
  });

  if (floatingDrawer && dragHandle) {
    let isDraggingCalc = false;
    let offsetX = 0;
    let offsetY = 0;

    dragHandle.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      isDraggingCalc = true;
      const rect = floatingDrawer.getBoundingClientRect();
      offsetX = e.clientX - rect.left;
      offsetY = e.clientY - rect.top;
      floatingDrawer.style.right = 'auto';
      floatingDrawer.style.bottom = 'auto';
      floatingDrawer.style.left = `${rect.left}px`;
      floatingDrawer.style.top = `${rect.top}px`;
      dragHandle.setPointerCapture(e.pointerId);
    });

    dragHandle.addEventListener('pointermove', (e) => {
      if (!isDraggingCalc) return;
      const maxX = window.innerWidth - 120;
      const maxY = window.innerHeight - 80;
      const nextLeft = Math.max(8, Math.min(maxX, e.clientX - offsetX));
      const nextTop = Math.max(8, Math.min(maxY, e.clientY - offsetY));
      floatingDrawer.style.left = `${nextLeft}px`;
      floatingDrawer.style.top = `${nextTop}px`;
    });

    const stopCalcDrag = () => {
      isDraggingCalc = false;
    };
    dragHandle.addEventListener('pointerup', stopCalcDrag);
    dragHandle.addEventListener('pointercancel', stopCalcDrag);
  }
</script>

