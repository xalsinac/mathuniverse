---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMark from '../components/LogoMark.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroOrbit from '../components/HeroOrbit.astro';
import ResourceShowcase from '../components/ResourceShowcase.astro';
import ScrollNavigator from '../components/ScrollNavigator.astro';
import { site } from '../config/site';
---

<BaseLayout title={`${site.name} — Matemáticas para explorar`}>
  <SiteHeader
    activePage="home"
    statusText="En construcción"
    ctaHref="#recursos"
    ctaLabel="Explorar Apps"
  />

  <main>
    <section
      class="hero section"
      id="inicio"
      aria-labelledby="hero-title"
      data-scroll-section
      data-section-title="Inicio"
    >
      <div class="hero-content">
        <p class="kicker">Un universo para pensar</p>
        <h1 id="hero-title" class="hero-brand-title">
          <span class="math-word">MATH</span> UNIVERSE
        </h1>
        <p class="hero-subtitle">
          Las matemáticas <em>tienen mundo propio.</em>
        </p>
        <div class="hero-intro">
          <p>
            Proyectos, aplicaciones y recursos interactivos para aprender, enseñar y seguir
            explorando a tu ritmo.
          </p>
          <p class="signature">Soy <strong>Xavier Alsina</strong>, profesor de matemáticas.</p>
          <a class="hero-link" href="#recursos">Explorar el universo <span>↓</span></a>
        </div>
      </div>

      <HeroOrbit />
      <p class="scroll-note">Desplázate para descubrir <span>↓</span></p>
    </section>

    <ResourceShowcase />

    <!-- Sección 02: El Proyecto (Enmarcada con líneas arquitectónicas y cruces .tick) -->
    <section
      class="about section-band"
      id="universo"
      aria-labelledby="about-title"
      data-scroll-section
      data-section-title="Conexiones"
      data-choreo-band
    >
      <span class="section-rule" aria-hidden="true"></span>
      <div class="section-frame">
        <span class="tick tick-half tick-left" aria-hidden="true"></span>
        <span class="tick tick-half tick-right" aria-hidden="true"></span>

        <div class="section-eyebrow">
          <span>
            <span class="eyebrow-num">02</span>
            <span class="eyebrow-sep" aria-hidden="true">/</span>
            El proyecto
          </span>
          <span class="eyebrow-right">Una idea en expansión · Ecosistema abierto</span>
        </div>

        <div class="about-grid section-body">
          <div>
            <p class="kicker">Más que una colección</p>
            <h2 id="about-title">Un lugar para que <em>las ideas conecten.</em></h2>
          </div>
          <div class="about-copy">
            <p>
              <strong><span class="math-word">Math</span> Universe</strong> nace de una convicción sencilla: las matemáticas se entienden mejor
              cuando se pueden mirar desde distintos ángulos.
            </p>
            <p>
              Este es el punto de encuentro de proyectos que irán creciendo con clases,
              herramientas, juegos, problemas y demostraciones. Cada uno con su personalidad; todos
              compartiendo una misma curiosidad.
            </p>
            <span class="quote-mark">∴</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección 03: Principios (Enmarcada con cuadrícula de celdas 1px estilo Principles de ArtCraft) -->
    <section
      class="principles-section section-band"
      id="principios"
      aria-label="Filosofía de Math Universe"
      data-scroll-section
      data-section-title="Principios"
      data-choreo-band
    >
      <span class="section-rule" aria-hidden="true"></span>
      <div class="section-frame">
        <span class="tick tick-half tick-left" aria-hidden="true"></span>
        <span class="tick tick-half tick-right" aria-hidden="true"></span>

        <div class="section-eyebrow">
          <span>
            <span class="eyebrow-num">03</span>
            <span class="eyebrow-sep" aria-hidden="true">/</span>
            Principios
          </span>
          <span class="eyebrow-right">Compartidos por cada recurso</span>
        </div>

        <div class="principles-intro section-body">
          <h2 class="principles-heading">
            Pensado desde la <em>intuición</em>.
          </h2>
          <p class="principles-sub">
            Cada aplicación y recurso de <strong><span class="math-word">Math</span> Universe</strong> se construye bajo tres reglas fundamentales.
          </p>
        </div>

        <div class="principles-grid">
          <div class="principle-cell">
            <div class="principle-top">
              <span class="principle-badge">01</span>
              <span class="principle-tag">Descubrimiento</span>
            </div>
            <h3>Explorar antes de memorizar.</h3>
            <p>Manipular objetos visuales y experimentar con patrones antes de formalizar la regla.</p>
          </div>
          <div class="principle-cell">
            <div class="principle-top">
              <span class="principle-badge">02</span>
              <span class="principle-tag">Autonomía</span>
            </div>
            <h3>Entender para poder crear.</h3>
            <p>Dominar el porqué de cada herramienta para resolver problemas nuevos con criterio propio.</p>
          </div>
          <div class="principle-cell">
            <div class="principle-top">
              <span class="principle-badge">03</span>
              <span class="principle-tag">Asombro</span>
            </div>
            <h3>Hacer de la dificultad un lugar interesante.</h3>
            <p>Convertir los retos abstractos en escenarios donde apetece detenerse a pensar.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Pie de página enmarcado en la misma estructura de líneas -->
  <footer
    class="footer-section section-band"
    data-scroll-section
    data-section-title="Continuará"
    data-choreo-band
  >
    <span class="section-rule" aria-hidden="true"></span>
    <div class="section-frame">
      <span class="tick tick-half tick-left" aria-hidden="true"></span>
      <span class="tick tick-half tick-right" aria-hidden="true"></span>

      <div class="footer-body section-body">
        <div class="footer-main">
          <LogoMark />
          <p>Un universo en construcción para aprender y enseñar matemáticas.</p>
        </div>
        <div class="footer-links">
          <a href="#inicio">Inicio</a>
          <a href="#recursos">Recursos</a>
          <a href="#universo">El proyecto</a>
          <a href="#principios">Principios</a>
          <span>Contacto próximamente</span>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Math Universe · Xavier Alsina</span>
          <span>Hecho para mentes curiosas</span>
        </div>
      </div>
    </div>
  </footer>

  <ScrollNavigator />
</BaseLayout>

<script>
  // Coreografía de trazado de líneas horizontales y cruces (.tick) al entrar cada sección en pantalla
  const bands = [...document.querySelectorAll<HTMLElement>('[data-choreo-band]')];
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-drawn');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -8% 0px' },
    );
    bands.forEach((band) => io.observe(band));
  } else {
    bands.forEach((band) => band.classList.add('is-drawn'));
  }
</script>

<style>
  .hero {
    isolation: isolate;
    min-height: calc(100svh - 3.4rem);
    overflow: hidden;
    overflow-x: clip;
    width: 100%;
    max-width: 100vw;
    box-sizing: border-box;
    position: relative;
  }

  .hero-content {
    align-items: center;
    display: flex;
    flex-direction: column;
    padding: clamp(4.5rem, 8vw, 7rem) 1rem clamp(2rem, 4vw, 3.5rem);
    pointer-events: none;
    position: relative;
    text-align: center;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    z-index: 1;
  }

  .kicker {
    color: var(--accent-ink);
    font: 500 0.7rem var(--mono);
    letter-spacing: 0.14em;
    margin: 0 0 1.35rem;
    text-transform: uppercase;
  }

  .hero h1,
  .about h2,
  .principles-heading {
    font-family: var(--display);
    font-size: clamp(3.4rem, 7.2vw, 7.2rem);
    font-stretch: 120%;
    font-variation-settings: 'wdth' 120;
    font-weight: 720;
    letter-spacing: -0.03em;
    line-height: 0.94;
    margin: 0;
    position: relative;
  }

  .hero-brand-title {
    letter-spacing: 0.02em;
    max-width: none;
    text-transform: uppercase;
  }

  .hero-subtitle {
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(1.65rem, 3.1vw, 2.75rem);
    font-stretch: 112%;
    font-variation-settings: 'wdth' 112;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.12;
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
  }

  .hero-subtitle em {
    color: var(--serif-ink);
    font-family: var(--serif);
    font-stretch: 100%;
    font-variation-settings: 'wdth' 100;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .about h2 {
    font-size: clamp(2.8rem, 5.2vw, 5.4rem);
    max-width: 12ch;
  }

  .principles-heading {
    font-size: clamp(2.6rem, 4.8vw, 4.8rem);
    max-width: 16ch;
  }

  .hero h1 em,
  .about h2 em,
  .principles-heading em {
    color: var(--serif-ink);
    font-family: var(--serif);
    font-stretch: 100%;
    font-variation-settings: 'wdth' 100;
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .hero-intro {
    align-items: center;
    display: flex;
    flex-direction: column;
    margin-left: 0;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    max-width: 26rem;
    text-align: center;
  }

  .hero-intro p {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.5;
  }

  .hero-intro .signature {
    color: var(--muted);
    font-size: 0.93rem;
    margin-top: 1.2rem;
  }

  .signature strong {
    color: var(--ink);
  }

  .math-word {
    color: var(--accent-ink);
  }

  .hero-link {
    align-items: center;
    border-bottom: 1px solid var(--accent-ink);
    color: var(--ink);
    display: flex;
    font: 500 0.7rem var(--mono);
    justify-content: space-between;
    letter-spacing: 0.1em;
    margin-top: 2.8rem;
    padding-bottom: 0.6rem;
    pointer-events: auto;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
    width: 100%;
  }

  .hero-link:hover {
    color: var(--accent-ink);
  }

  .hero-link span {
    color: var(--accent-ink);
    font-size: 1.2rem;
  }

  .scroll-note {
    display: none;
  }

  /* Sección 02: Conexiones */
  .about-grid {
    align-items: start;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    grid-template-columns: 1.05fr 0.95fr;
  }

  .about-copy {
    padding-top: 0.5rem;
    position: relative;
  }

  .about-copy p {
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.35vw, 1.24rem);
    line-height: 1.58;
    margin: 0 0 1.5rem;
  }

  .quote-mark {
    bottom: -2.5rem;
    color: var(--accent-ink);
    font: 4.5rem var(--serif);
    position: absolute;
    right: 0;
  }

  /* Sección 03: Principios con cuadrícula técnica de 1px (grid gap-px bg-line) */
  .principles-intro {
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .principles-sub {
    color: var(--muted);
    font-size: clamp(1.02rem, 1.3vw, 1.18rem);
    line-height: 1.55;
    margin: 1.1rem 0 0;
    max-width: 34rem;
  }

  .principles-grid {
    background: var(--line);
    border-top: 1px solid var(--line);
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .principle-cell {
    background: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 260px;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    transition: background-color 0.25s ease;
  }

  .principle-cell:hover {
    background: var(--bg-raised);
  }

  .principle-top {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-bottom: 2.2rem;
  }

  .principle-badge {
    align-items: center;
    border: 1px solid var(--line-strong);
    color: var(--accent-ink);
    display: inline-flex;
    font: 600 0.72rem/1 var(--mono);
    height: 2.2rem;
    justify-content: center;
    letter-spacing: 0.08em;
    width: 2.2rem;
  }

  .principle-tag {
    color: var(--muted);
    font: 500 0.64rem/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .principle-cell h3 {
    font-family: var(--display);
    font-size: clamp(1.35rem, 1.9vw, 1.85rem);
    font-stretch: 118%;
    font-variation-settings: 'wdth' 118;
    font-weight: 620;
    letter-spacing: -0.03em;
    line-height: 1.06;
    margin: 0 0 0.85rem;
  }

  .principle-cell p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
  }

  /* Footer enmarcado */
  .footer-main {
    align-items: start;
    display: flex;
    justify-content: space-between;
  }

  .footer-main p {
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.45;
    margin: 0;
    max-width: 19rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: clamp(3rem, 6vw, 5rem) 0 2rem;
  }

  .footer-links a,
  .footer-links span,
  .footer-bottom {
    color: var(--muted);
    font: 500 0.66rem var(--mono);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  .footer-bottom {
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    padding-top: 1.4rem;
  }

  :global(.intro-running) .hero-content {
    filter: blur(9px);
    opacity: 0;
    transform: translateY(0.8rem);
  }

  :global(.hero-ready) .hero-content {
    animation: hero-copy-in 0.72s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes hero-copy-in {
    from {
      filter: blur(7px);
      opacity: 0;
      transform: translateY(0.9rem);
    }
    to {
      filter: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .topbar-nav,
    .status {
      display: none;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .principles-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .topbar-cta {
      display: none;
    }

    .hero {
      min-height: 760px;
    }

    .hero-content {
      align-items: flex-start;
      padding-top: 5.2rem;
      text-align: left;
    }

    .hero h1 {
      font-size: clamp(3.4rem, 13.5vw, 5.4rem);
      max-width: 9ch;
    }

    .hero-intro {
      align-items: center;
      margin-left: 0;
      margin-top: 3.5rem;
      max-width: 19rem;
      text-align: center;
    }

    .footer-main {
      display: block;
    }

    .footer-main p {
      margin-top: 1.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.75rem;
      line-height: 1.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
