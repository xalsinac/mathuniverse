---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMark from '../components/LogoMark.astro';
import HeroOrbit from '../components/HeroOrbit.astro';
import ResourceShowcase from '../components/ResourceShowcase.astro';
import ScrollNavigator from '../components/ScrollNavigator.astro';
import { site } from '../config/site';
---
<BaseLayout title={`${site.name} — Matemáticas para explorar`}>
  <main class="page-grid">
    <section class="hero section" id="inicio" aria-labelledby="hero-title" data-scroll-section data-section-title="Inicio">
      <header class="topbar"><LogoMark /><nav aria-label="Navegación principal"><a href="#recursos">Recursos</a><a href="#universo">El proyecto</a></nav><span class="status"><i></i> En construcción</span></header>
      <div class="hero-content"><p class="kicker">Un universo para pensar</p><h1 id="hero-title">Las matemáticas<br/><em>tienen mundo propio.</em></h1><div class="hero-intro"><p>Math Universe reúne proyectos, aplicaciones y recursos para aprender, enseñar y seguir explorando.</p><p class="signature">Soy <strong>Xavier Alsina</strong>, profesor de matemáticas.</p><a class="hero-link" href="#recursos">Explorar el universo <span>↓</span></a></div></div>
      <HeroOrbit /><p class="scroll-note">Desplázate para descubrir <span>↓</span></p>
    </section>
    <ResourceShowcase />
    <section class="about section" id="universo" aria-labelledby="about-title" data-scroll-section data-section-title="Conexiones"><div class="section-label"><span>02 / el proyecto</span><span>Una idea en expansión</span></div><div class="about-grid"><div><p class="kicker">Más que una colección</p><h2 id="about-title">Un lugar para que <em>las ideas conecten.</em></h2></div><div class="about-copy"><p>Math Universe nace de una convicción sencilla: las matemáticas se entienden mejor cuando se pueden mirar desde distintos ángulos.</p><p>Este es el punto de encuentro de proyectos que irán creciendo con clases, herramientas, juegos, problemas y demostraciones. Cada uno con su personalidad; todos compartiendo una misma curiosidad.</p><span class="quote-mark">∴</span></div></div></section>
    <section class="principles section" id="principios" aria-label="Filosofía de Math Universe" data-scroll-section data-section-title="Principios"><div><span>01</span><h3>Explorar antes de memorizar.</h3></div><div><span>02</span><h3>Entender para poder crear.</h3></div><div><span>03</span><h3>Hacer de la dificultad un lugar interesante.</h3></div></section>
  </main>
  <footer class="footer section" data-scroll-section data-section-title="Continuará"><div class="footer-main"><LogoMark /><p>Un universo en construcción para aprender y enseñar matemáticas.</p></div><div class="footer-links"><a href="#recursos">Recursos</a><a href="#universo">El proyecto</a><span>Contacto próximamente</span></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Math Universe</span><span>Hecho para mentes curiosas</span></div></footer>
  <ScrollNavigator />
</BaseLayout>

<style>
  .hero{min-height:0;overflow:hidden;position:relative}.topbar{align-items:center;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr auto 1fr;min-height:4.6rem;position:relative;z-index:2}.topbar nav{display:flex;gap:1.5rem}.topbar a,.status{color:var(--muted);font:500 .66rem var(--mono);letter-spacing:.1em;text-decoration:none;text-transform:uppercase}.topbar a:hover{color:var(--ink)}.status{justify-self:end}.status i{background:#b6ff5c;border-radius:50%;display:inline-block;height:.4rem;margin-right:.45rem;width:.4rem}.hero-content{padding:clamp(5rem,12vw,10rem) 0 7rem;position:relative;z-index:1}.kicker{color:#b6ff5c;font:500 .7rem var(--mono);letter-spacing:.13em;margin:0 0 1.35rem;text-transform:uppercase}.hero h1,.about h2{font-size:clamp(3.8rem,8.7vw,9rem);letter-spacing:-.085em;line-height:.83;margin:0;max-width:10ch;position:relative}.hero h1 em,.about h2 em{color:#bfc0c8;font-family:var(--serif);font-weight:400;letter-spacing:-.06em}.hero-intro{margin-left:clamp(1rem,16vw,16rem);margin-top:clamp(3rem,7vw,6rem);max-width:25rem}.hero-intro p{font-size:clamp(1rem,1.5vw,1.25rem);line-height:1.5}.hero-intro .signature{color:var(--muted);font-size:.93rem;margin-top:1.2rem}.signature strong{color:var(--ink)}.hero-link{align-items:center;border-bottom:1px solid #b6ff5c;color:var(--ink);display:flex;font:500 .7rem var(--mono);justify-content:space-between;letter-spacing:.1em;margin-top:2.8rem;padding-bottom:.6rem;text-decoration:none;text-transform:uppercase;width:100%}.hero-link span{color:#b6ff5c;font-size:1.2rem}.scroll-note{display:none}.about{padding-bottom:clamp(5rem,12vw,12rem);padding-top:clamp(6rem,14vw,15rem)}.section-label{border-bottom:1px solid var(--line);color:var(--muted);display:flex;font:500 .68rem/1 var(--mono);justify-content:space-between;letter-spacing:.12em;padding-bottom:1rem;text-transform:uppercase}.about-grid{display:grid;gap:4rem;grid-template-columns:1fr .72fr;padding-top:clamp(4rem,9vw,9rem)}.about h2{font-size:clamp(3.5rem,6.5vw,7.2rem)}.about-copy{padding-top:1rem;position:relative}.about-copy p{color:#c8c8ce;font-size:clamp(1.05rem,1.4vw,1.26rem);line-height:1.52;margin:0 0 1.5rem}.quote-mark{bottom:-3rem;color:#b6ff5c;font:5rem var(--serif);position:absolute;right:0}.principles{border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr)}.principles>div{min-height:250px;padding:1.4rem;position:relative}.principles>div+div{border-left:1px solid var(--line)}.principles span{color:#b6ff5c;font:.7rem var(--mono)}.principles h3{bottom:1.5rem;font-size:clamp(1.3rem,2vw,2rem);letter-spacing:-.05em;line-height:1;margin:0;max-width:10ch;position:absolute}.footer{border-top:1px solid var(--line);padding-bottom:2rem;padding-top:clamp(3rem,6vw,6rem)}.footer-main{align-items:start;display:flex;justify-content:space-between}.footer-main p{color:var(--muted);font-size:.93rem;line-height:1.4;margin:0;max-width:18rem}.footer-links{display:flex;flex-wrap:wrap;gap:1.3rem;margin:clamp(4rem,9vw,8rem) 0 2rem}.footer-links a,.footer-links span,.footer-bottom{color:var(--muted);font:.65rem var(--mono);letter-spacing:.08em;text-decoration:none;text-transform:uppercase}.footer-links a:hover{color:var(--ink)}.footer-bottom{border-top:1px solid var(--line);display:flex;justify-content:space-between;padding-top:1.3rem}@media(max-width:760px){.topbar{grid-template-columns:1fr auto}.topbar nav{display:none}.hero{min-height:780px}.hero-content{padding-top:5.8rem}.hero h1{font-size:clamp(3.7rem,15vw,5.8rem)}.hero-intro{margin-left:0;margin-top:4rem;max-width:18rem}.scroll-note{display:none}.about-grid{display:block}.about-copy{margin-left:16%;margin-top:3rem}.principles{grid-template-columns:1fr}.principles>div{min-height:160px}.principles>div+div{border-left:0;border-top:1px solid var(--line)}.footer-main{display:block}.footer-main p{margin-top:1.8rem}.footer-bottom{gap:1rem;line-height:1.5}.status{font-size:.55rem}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  /* Dirección del hero: tipografía y galaxia comparten un eje central. */
  .hero { isolation:isolate; }
  .topbar { z-index:4; }
  .hero-content { align-items:center; display:flex; flex-direction:column; padding-bottom:clamp(1.25rem,2vw,2rem); padding-top:clamp(5rem,8vw,7rem); pointer-events:none; text-align:center; }
  .hero-link { pointer-events:auto; }
  .hero h1 { max-width:none; }
  .hero-intro { align-items:center; display:flex; flex-direction:column; margin-left:0; margin-top:clamp(3.5rem,6vw,5.5rem); text-align:center; }
  .hero-link { width:100%; }
  :global(.intro-running) .hero-content { filter:blur(9px); opacity:0; transform:translateY(.8rem); }
  :global(.hero-ready) .hero-content { animation:hero-copy-in .72s cubic-bezier(.16,1,.3,1) both; }
  @keyframes hero-copy-in { from { filter:blur(7px); opacity:0; transform:translateY(.9rem); } to { filter:none; opacity:1; transform:none; } }
  @media(max-width:760px) { .hero-content { align-items:flex-start; text-align:left; } .hero h1 { max-width:8ch; } .hero-intro { align-items:center; margin-top:4rem; text-align:center; } }
</style>
